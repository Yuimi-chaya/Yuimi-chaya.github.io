---
import "../styles/theme.css";
import { Icon } from "astro-icon/components";
import type { BlogPost } from "@/core/content/blog";
import { ClientRouter } from "astro:transitions";
import ThemePreferenceGate from "@/core/themes/ThemePreferenceGate.astro";
import ThemeLongPressMenu from "@/core/themes/ThemeLongPressMenu.astro";
import ConsoleEasterEgg from "@/core/ConsoleEasterEgg.astro";
import PerformanceProfile from "@/core/PerformanceProfile.astro";
import SeoMeta from "@/core/SeoMeta.astro";
import { profileIdentity } from "@/core/data/profile";
import { getCanonicalPath, getThemePath, themes } from "@/core/themes/registry";
import { site } from "@/lib/site";
import KisaraAudioControl from "../components/KisaraAudioControl.astro";
import KisaraChibiStage from "../components/KisaraChibiStage.astro";
import KisaraRouteRelay from "../components/KisaraRouteRelay.astro";
import {
  KISARA_AUDIO_LEGACY_STORAGE_KEY,
  KISARA_AUDIO_STORAGE_KEY,
  KISARA_SECRET_AUDIO_SESSION_KEY,
  KISARA_AUDIO_VOLUME,
  kisaraAudioTracks,
  kisaraSecretAudioTracks
} from "../lib/audio";

interface Props {
  title?: string;
  description?: string;
  honorThemePreference?: boolean;
  redirectThemedNotFound?: boolean;
  isArticlePage?: boolean;
  stylesheets?: string[];
  priorityImages?: string[];
  article?: BlogPost["data"];
}

const {
  title = `${site.title} | Kisara`,
  description = site.description,
  honorThemePreference = true,
  redirectThemedNotFound = false,
  isArticlePage = false,
  stylesheets = [],
  priorityImages = [],
  article
} = Astro.props;
const priorityImageUrls = [...new Set(priorityImages.filter(Boolean))];
const canonicalPath = getCanonicalPath(Astro.url.pathname);
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url);
const isAlternateThemeRoute = Astro.url.pathname.startsWith("/themes/");
const isHome = canonicalPath === "/";
const pageKey = canonicalPath.split("/").filter(Boolean)[0] ?? "home";
const navItems = site.nav.map((item) => {
  const active = item.href === "/" ? isHome : canonicalPath.startsWith(item.href);
  const homeExitRoute = isHome && item.href !== "/";
  const reciprocalGameRoute =
    (pageKey === "games" && item.href === "/projects/") ||
    (pageKey === "projects" && item.href === "/games/");

  return {
    ...item,
    href: getThemePath("kisara", item.href),
    active,
    warmup: import.meta.env.PROD && !active ? (homeExitRoute || reciprocalGameRoute ? "load" : "hover") : undefined
  };
});
const themeOptions = themes.map((theme) => ({
  ...theme,
  href: getThemePath(theme.id, canonicalPath)
}));
const contextThemeLabels: Record<string, string> = {
  "fuyukawa-kagari": "KAGARI",
  blank: "BLANK",
  kisara: "KISARA"
};
const audioConfig = {
  tracks: kisaraAudioTracks,
  secretTracks: kisaraSecretAudioTracks,
  storageKey: KISARA_AUDIO_STORAGE_KEY,
  legacyStorageKey: KISARA_AUDIO_LEGACY_STORAGE_KEY,
  secretSessionKey: KISARA_SECRET_AUDIO_SESSION_KEY,
  volume: KISARA_AUDIO_VOLUME
};
const themedNotFoundRedirectScript = `(() => {
  const themeMatch = window.location.pathname.match(/^\\/themes\\/(blank|kisara|fuyukawa-kagari)(?:\\/|$)/);
  if (!themeMatch) return;
  const themeId = themeMatch[1];
  const notFoundPath = "/themes/" + themeId + "/404/";
  if (window.location.pathname === notFoundPath) return;
  const original = window.location.pathname + window.location.search + window.location.hash;
  window.location.replace(notFoundPath + "?from=" + encodeURIComponent(original));
})();`;
---

<!doctype html>
<html lang="zh-CN" data-theme="kisara">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PerformanceProfile />
    <SeoMeta title={title} description={description} canonical={canonical} isArticlePage={isArticlePage} article={article} />
    <meta name="theme-color" content="#111636" />
    {isAlternateThemeRoute && <meta name="robots" content="noindex,follow" />}
    {
      redirectThemedNotFound && (
        <script is:inline set:html={themedNotFoundRedirectScript}></script>
      )
    }
    <link rel="icon" type="image/x-icon" href="/themes/kisara/favicon.ico?v=heart-only" />
    <link rel="canonical" href={canonical} />
    {priorityImageUrls.map((href) => <link rel="preload" as="image" href={href} fetchpriority="high" />)}
    {stylesheets.map((href) => <link rel="stylesheet" href={href} />)}
    <ThemePreferenceGate currentTheme="kisara" honorPreference={honorThemePreference} />
    <ClientRouter fallback="swap" />
    <ConsoleEasterEgg />
    <script>
      import { initKisaraRouteWarmup } from "../lib/routeWarmup";

      initKisaraRouteWarmup();
    </script>
    <script is:inline>
      (() => {
        if (window.__yuimiKisaraEasterLedger?.version === 1) return;

        const storageKey = "yuimi-kisara-opening-hints-v1";
        const eventName = "yuimi:kisara-opening-hint-achieved";
        const validIds = new Set([
          "chibi-jealousy",
          "chibi-apple",
          "found-self",
          "photo-archive",
          "memory-return",
          "game-shake"
        ]);
        const achieved = new Set();

        try {
          const stored = JSON.parse(sessionStorage.getItem(storageKey) ?? "null");
          const storedIds = Array.isArray(stored)
            ? stored
            : stored?.version === 1 && Array.isArray(stored.achieved)
              ? stored.achieved
              : [];
          storedIds.forEach((id) => {
            if (validIds.has(id)) achieved.add(id);
          });
          if (sessionStorage.getItem("yuimi-kisara-game-shake-easter-v2") === "consumed") {
            achieved.add("game-shake");
          }
        } catch {}

        const persist = () => {
          try {
            sessionStorage.setItem(storageKey, JSON.stringify({
              version: 1,
              achieved: [...achieved]
            }));
          } catch {}
        };

        window.__yuimiKisaraEasterLedger = {
          version: 1,
          has: (id) => achieved.has(id),
          mark: (id) => {
            if (!validIds.has(id) || achieved.has(id)) return false;
            achieved.add(id);
            persist();
            window.dispatchEvent(new CustomEvent(eventName, { detail: { id } }));
            return true;
          },
          values: () => [...achieved]
        };
        persist();
      })();
    </script>
    <script is:inline>
      (() => {
        const version = 1;
        const storageKey = "yuimi-kisara-lovebrain-v1";
        const eventName = "yuimi:kisara-lovebrain-progress";
        const validPages = new Set(["games", "blog", "projects", "about"]);
        const stageIds = new Set(["chibi-jealousy", "chibi-apple"]);
        const requiredPages = ["games", "blog", "projects", "about"];
        if (window.__yuimiKisaraLovebrainProgress?.version === version) return;

        const visited = new Set();
        let spareKeyTriggered = false;
        let stageTriggered = false;
        try {
          const stored = JSON.parse(sessionStorage.getItem(storageKey) ?? "null");
          const storedVisited = Array.isArray(stored?.visited) ? stored.visited : [];
          storedVisited.forEach((page) => {
            if (validPages.has(page)) visited.add(page);
          });
          spareKeyTriggered = stored?.spareKeyTriggered === true;
          stageTriggered = stored?.stageTriggered === true;
        } catch {}

        const legacyLedger = window.__yuimiKisaraEasterLedger;
        if (legacyLedger?.has?.("photo-archive")) spareKeyTriggered = true;
        if (legacyLedger?.has?.("chibi-jealousy") || legacyLedger?.has?.("chibi-apple")) {
          stageTriggered = true;
        }

        const isEligible = () => requiredPages.every((page) => visited.has(page))
          && spareKeyTriggered
          && stageTriggered;
        const snapshot = () => ({
          version,
          key: storageKey,
          visited: [...visited],
          spareKeyTriggered,
          stageTriggered,
          eligible: isEligible()
        });
        const persist = () => {
          try {
            sessionStorage.setItem(storageKey, JSON.stringify({
              version,
              visited: [...visited],
              spareKeyTriggered,
              stageTriggered
            }));
          } catch {}
        };
        const publish = (reason, detail = {}) => {
          window.dispatchEvent(new CustomEvent(eventName, {
            detail: { reason, ...detail, ...snapshot() }
          }));
        };
        const markVisit = (page) => {
          if (!validPages.has(page) || visited.has(page)) return false;
          visited.add(page);
          persist();
          publish("visit", { pageKey: page });
          return true;
        };
        const markSpareKey = () => {
          if (spareKeyTriggered) return false;
          spareKeyTriggered = true;
          persist();
          publish("spare-key");
          return true;
        };
        const markStage = (id) => {
          if (!stageIds.has(id) || stageTriggered) return false;
          stageTriggered = true;
          persist();
          publish("stage", { stageId: id });
          return true;
        };
        const recordCurrentPage = () => {
          const page = document.body?.dataset.kisaraPage;
          if (page) markVisit(page);
        };

        window.__yuimiKisaraLovebrainProgress = {
          version,
          key: storageKey,
          snapshot,
          isEligible,
          markVisit,
          markSpareKey,
          markStage
        };
        persist();
        window.addEventListener("yuimi:kisara-opening-hint-achieved", (event) => {
          const id = event instanceof CustomEvent ? event.detail?.id : "";
          if (id === "photo-archive") markSpareKey();
          else if (stageIds.has(id)) markStage(id);
        });
        document.addEventListener("astro:page-load", recordCurrentPage);
      })();
    </script>
    <script is:inline define:vars={{ isHome }}>
      (() => {
        window.__yuimiKisaraHomeBootController?.dispose?.();
        const html = document.documentElement;
        let timer = 0;

        const clearTimer = () => {
          if (timer) window.clearTimeout(timer);
          timer = 0;
        };

        const isHomeDocument = (documentLike) => Boolean(
          documentLike?.body?.classList.contains("kisara-home-page")
        );

        const clear = () => {
          clearTimer();
          html.removeAttribute("data-kisara-home-boot");
          html.removeAttribute("data-kisara-home-ready");
        };

        const arm = () => {
          clearTimer();
          html.setAttribute("data-kisara-home-boot", "pending");
          html.removeAttribute("data-kisara-home-ready");
          timer = window.setTimeout(() => {
            timer = 0;
            if (!html.hasAttribute("data-kisara-home-ready")) {
              html.removeAttribute("data-kisara-home-boot");
            }
          }, 4500);
        };

        const markReady = () => {
          if (!isHomeDocument(document)) return;
          clearTimer();
          html.setAttribute("data-kisara-home-ready", "true");
          html.removeAttribute("data-kisara-home-boot");
        };

        const handleBeforeSwap = (event) => {
          if (isHomeDocument(event.newDocument)) arm();
          else clear();
        };
        const handleAfterSwap = () => {
          if (isHomeDocument(document)) arm();
          else clear();
        };

        document.addEventListener("astro:before-swap", handleBeforeSwap);
        document.addEventListener("astro:after-swap", handleAfterSwap);
        window.__yuimiKisaraHomeBootController = {
          arm,
          clear,
          markReady,
          dispose: () => {
            clearTimer();
            document.removeEventListener("astro:before-swap", handleBeforeSwap);
            document.removeEventListener("astro:after-swap", handleAfterSwap);
          }
        };

        if (isHome) arm();
        else clear();
      })();
    </script>
    <script is:inline define:vars={{ audioConfig, isHome }}>
      (() => {
        if (window.__yuimiKisaraAudioBootstrap?.audio instanceof HTMLAudioElement) return;

        const bootstrap = {
          audio: null,
          tracks: audioConfig.tracks,
          trackId: audioConfig.tracks[0]?.id ?? "",
          enabled: true,
          persistedResumeIntent: false,
          restoredFromStorage: false,
          restoreTime: 0,
          playPromise: null,
          blocked: false,
          settled: false,
          claimed: false
        };
        window.__yuimiKisaraAudioBootstrap = bootstrap;
        if (!Array.isArray(audioConfig.tracks) || audioConfig.tracks.length === 0) return;

        let storedState = null;
        try {
          const stored = JSON.parse(localStorage.getItem(audioConfig.storageKey) ?? "null");
          if (stored && typeof stored === "object") {
            storedState = stored;
            bootstrap.restoredFromStorage = true;
          }
        } catch {}

        if (!storedState) {
          try {
            const legacy = JSON.parse(sessionStorage.getItem(audioConfig.legacyStorageKey) ?? "null");
            if (legacy && typeof legacy === "object") {
              storedState = legacy;
              bootstrap.restoredFromStorage = true;
            }
          } catch {}
        }

        if (typeof storedState?.enabled === "boolean") {
          bootstrap.enabled = storedState.enabled;
          bootstrap.persistedResumeIntent = storedState.enabled;
        }
        if (Number.isFinite(storedState?.currentTime)) {
          bootstrap.restoreTime = Math.max(0, storedState.currentTime);
        }

        let storedSecretSession = null;
        try {
          const stored = JSON.parse(sessionStorage.getItem(audioConfig.secretSessionKey) ?? "null");
          if (stored && typeof stored === "object") {
            const persistentSecretIds = new Set(
              audioConfig.secretTracks
                .filter((track) => track.persistAcrossReload !== false)
                .map((track) => track.id)
            );
            const legacySecretId = audioConfig.secretTracks[0]?.id ?? "";
            const storedUnlockedIds = Array.isArray(stored.unlockedIds)
              ? stored.unlockedIds
              : stored.unlocked && legacySecretId
                ? [legacySecretId]
                : [];
            const unlockedIds = storedUnlockedIds.filter((id) => persistentSecretIds.has(id));
            const activeTrackId = unlockedIds.includes(stored.activeTrackId) ? stored.activeTrackId : "";
            if (unlockedIds.length > 0) {
              storedSecretSession = {
                ...stored,
                unlockedIds,
                unlocked: true,
                active: Boolean(stored.active && activeTrackId),
                activeTrackId,
                playbackMode: activeTrackId && stored.playbackMode === "interrupt" ? "interrupt" : "playlist",
                secretTime: activeTrackId ? Math.max(0, Number(stored.secretTime) || 0) : 0
              };
              sessionStorage.setItem(audioConfig.secretSessionKey, JSON.stringify(storedSecretSession));
            } else {
              sessionStorage.removeItem(audioConfig.secretSessionKey);
            }
          }
        } catch {}
        if (storedSecretSession) window.__yuimiKisaraSecretAudioSession = storedSecretSession;

        const unlockedSecretIds = new Set(
          Array.isArray(storedSecretSession?.unlockedIds) ? storedSecretSession.unlockedIds : []
        );
        const unlockedSecretTracks = audioConfig.secretTracks.filter((candidate) => unlockedSecretIds.has(candidate.id));
        bootstrap.tracks = [...audioConfig.tracks, ...unlockedSecretTracks];

        const storedTrackId = typeof storedState?.trackId === "string" ? storedState.trackId : "";
        let track = audioConfig.tracks.find((candidate) => candidate.id === storedTrackId)
          ?? audioConfig.tracks[0];
        const activeSecretTrack = storedSecretSession?.active
          ? unlockedSecretTracks.find((candidate) => candidate.id === storedSecretSession.activeTrackId)
          : null;
        if (activeSecretTrack) {
          track = activeSecretTrack;
          bootstrap.enabled = storedSecretSession.secretEnabled !== false;
          bootstrap.persistedResumeIntent = storedSecretSession.normalEnabled !== false;
          bootstrap.restoreTime = Math.max(0, Number(storedSecretSession.secretTime) || 0);
          bootstrap.restoredFromStorage = true;
        }
        bootstrap.trackId = track.id;

        try {
          const audio = new Audio();
          audio.dataset.kisaraThemeAudio = "";
          audio.dataset.kisaraAudioBootstrap = "head";
          audio.preload = isHome ? "none" : "auto";
          audio.playsInline = true;
          audio.setAttribute("playsinline", "");
          audio.volume = audioConfig.volume;
          bootstrap.audio = audio;
          let audioStarted = false;

          const restorePosition = () => {
            const time = bootstrap.restoreTime;
            if (!(time > 0)) return;
            try {
              if (Number.isFinite(audio.duration) && audio.duration > 0) {
                audio.currentTime = time >= audio.duration - 0.5
                  ? 0
                  : Math.min(time, audio.duration - 0.25);
              } else {
                audio.currentTime = time;
              }
            } catch {}
          };

          audio.addEventListener("loadedmetadata", restorePosition, { once: true });
          const startAudio = () => {
            if (audioStarted) return bootstrap.playPromise ?? Promise.resolve(!audio.paused);
            audioStarted = true;
            audio.preload = "auto";
            audio.src = track.src;
            audio.load();

            if (!bootstrap.enabled) {
              bootstrap.settled = true;
              return Promise.resolve(false);
            }

            return Promise.resolve(audio.play())
              .then(() => {
                bootstrap.blocked = false;
                return true;
              })
              .catch(() => {
                bootstrap.blocked = !audio.error;
                return false;
              })
              .finally(() => {
                bootstrap.settled = true;
              });
          };

          bootstrap.playPromise = isHome && document.readyState === "loading"
            ? new Promise((resolve) => {
                document.addEventListener("DOMContentLoaded", () => resolve(startAudio()), { once: true });
              })
            : startAudio();
        } catch {
          bootstrap.settled = true;
        }
      })();
    </script>
    <title>{title}</title>
  </head>
  <body
    class:list={[isHome ? "kisara-home-page" : "kisara-inner-page"]}
    data-kisara-page={pageKey}
    data-yuimi-selection-lock={isArticlePage ? undefined : "true"}
    data-yuimi-article-page={isArticlePage ? "true" : undefined}
    data-pagefind-ignore={isAlternateThemeRoute ? true : undefined}
  >
    <a class="kisara-skip-link" href="#kisara-main">跳到正文</a>
    <header class:list={["kisara-header", isHome ? "is-home-header" : "is-inner-header"]} transition:name="kisara-header">
      <a class="kisara-brand" href={getThemePath("kisara", "/")} aria-label="Kisara 主题首页">
        <span class="kisara-brand-mark" aria-hidden="true"></span>
        <span><strong>YUIMI LAB</strong><small>KISARA / 03</small></span>
      </a>
      <nav class="kisara-nav" aria-label="Kisara theme navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? "page" : undefined}
            data-astro-prefetch={item.active ? undefined : item.warmup === "load" ? "false" : item.warmup}
            data-kisara-route-warmup={item.warmup === "load" ? "load" : undefined}
          >
            <Icon name={item.icon} aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
      <button class="kisara-theme-button" type="button" data-kisara-theme-button aria-label="选择主题" title="选择主题" aria-expanded="false">
        <Icon name="tabler:palette" aria-hidden="true" />
      </button>
    </header>

    <div class="kisara-theme-panel" data-kisara-theme-panel hidden>
      <div class="kisara-panel-heading">
        <span>SELECT THEME</span>
        <button type="button" data-kisara-panel-close aria-label="关闭主题选择器" title="关闭">
          <Icon name="tabler:x" aria-hidden="true" />
        </button>
      </div>
      {themeOptions.map((theme) => (
        <button type="button" data-theme-select={theme.id} aria-pressed={theme.id === "kisara" ? "true" : "false"}>
          <i aria-hidden="true"></i>
          {theme.label}
        </button>
      ))}
    </div>

    <KisaraAudioControl />
    <KisaraRouteRelay />

    <main id="kisara-main" class="kisara-main">
      <slot />
    </main>

    <footer class="kisara-footer">
      <KisaraChibiStage />
      <div class="kisara-footer-wave" aria-hidden="true"><span></span><i></i><i></i><i></i><i></i><i></i><span></span></div>
      <div class="kisara-footer-meta">
        <span class="kisara-footer-signal"><i aria-hidden="true"></i>CONTRACT CHANNEL 03 / ONLINE</span>
        <div>
          <a href={profileIdentity.github} target="_blank" rel="noreferrer"><Icon name="tabler:brand-github" aria-hidden="true" />GITHUB</a>
          <a href={profileIdentity.bilibili} target="_blank" rel="noreferrer"><Icon name="tabler:brand-bilibili" aria-hidden="true" />BILIBILI</a>
        </div>
        <span>© 2026 喝益胃 / YUIMI LAB</span>
      </div>
    </footer>

    <div
      class="kisara-scrollbar is-idle"
      data-kisara-scrollbar
      transition:name="kisara-scrollbar"
      role="progressbar"
      aria-label="页面滚动进度"
      aria-controls="kisara-main"
      aria-orientation="vertical"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <span class="kisara-scrollbar-progress" aria-hidden="true"></span>
      <span class="kisara-scrollbar-thumb" data-kisara-scrollbar-thumb aria-hidden="true"><i></i></span>
    </div>

    <nav class="kisara-context-menu" data-kisara-context-menu hidden aria-label="Kisara 主题快捷菜单">
      <header class="kisara-context-head">
        <span class="kisara-context-emblem" aria-hidden="true"><Icon name="tabler:heart" /></span>
        <span class="kisara-context-identity">
          <strong>KISARA</strong>
          <small>QUICK ACCESS</small>
        </span>
        <button class="kisara-context-close" type="button" data-kisara-action="close" aria-label="关闭快捷菜单" title="关闭">
          <Icon name="tabler:x" aria-hidden="true" />
        </button>
      </header>

      <div class="kisara-context-command-strip" aria-label="浏览器操作">
        <button type="button" data-kisara-action="back" aria-label="后退" title="后退">
          <Icon name="tabler:arrow-left" aria-hidden="true" /><span>后退</span>
        </button>
        <button type="button" data-kisara-action="forward" aria-label="前进" title="前进">
          <Icon name="tabler:arrow-right" aria-hidden="true" /><span>前进</span>
        </button>
        <button type="button" data-kisara-action="refresh" aria-label="刷新" title="刷新">
          <Icon name="tabler:refresh" aria-hidden="true" /><span>刷新</span>
        </button>
        <button type="button" data-kisara-action="top" aria-label="回到顶部" title="回到顶部">
          <Icon name="tabler:arrow-up" aria-hidden="true" /><span>顶部</span>
        </button>
      </div>

      <div class="kisara-context-page-actions" aria-label="页面操作">
        <button type="button" data-kisara-action="home">
          <Icon name="tabler:home" aria-hidden="true" /><span>主题首页</span>
        </button>
        <button type="button" data-kisara-action="copy" data-kisara-default-label="复制链接">
          <Icon name="tabler:link" aria-hidden="true" /><span>复制链接</span>
        </button>
      </div>

      <div class="kisara-context-theme-switch">
        <span>THEME</span>
        <div aria-label="切换主题">
          {themeOptions.map((theme) => (
            <button
              type="button"
              data-theme-select={theme.id}
              aria-pressed={theme.id === "kisara" ? "true" : "false"}
              aria-label={`切换到 ${theme.label} 主题`}
              title={theme.label}
            >
              <i aria-hidden="true"></i>
              <span>{contextThemeLabels[theme.id] ?? theme.label}</span>
            </button>
          ))}
        </div>
      </div>

      <span class="kisara-context-live" data-kisara-context-status aria-live="polite"><span></span></span>
    </nav>

    <ThemeLongPressMenu />

    <script>
      import "../lib/layoutRuntime.js";
    </script>
  </body>
</html>
