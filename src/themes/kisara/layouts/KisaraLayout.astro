---
import "../styles/theme.css";
import { Icon } from "astro-icon/components";
import ThemePreferenceGate from "@/core/themes/ThemePreferenceGate.astro";
import { getCanonicalPath, getThemePath, themes } from "@/core/themes/registry";
import { site } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.title} | Kisara`, description = site.description } = Astro.props;
const canonicalPath = getCanonicalPath(Astro.url.pathname);
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url);
const isHome = canonicalPath === "/";
const pageKey = canonicalPath.split("/").filter(Boolean)[0] ?? "home";
const navItems = site.nav.map((item) => ({
  ...item,
  href: getThemePath("kisara", item.href),
  active: item.href === "/" ? isHome : canonicalPath.startsWith(item.href)
}));
const themeOptions = themes.map((theme) => ({
  ...theme,
  href: getThemePath(theme.id, canonicalPath)
}));
---

<!doctype html>
<html lang="zh-CN" data-theme="kisara">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111636" />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={canonical} />
    <ThemePreferenceGate currentTheme="kisara" />
    <title>{title}</title>
  </head>
  <body class:list={[isHome ? "kisara-home-page" : "kisara-inner-page"]} data-kisara-page={pageKey} data-pagefind-ignore>
    <a class="kisara-skip-link" href="#kisara-main">跳到正文</a>
    <header class:list={["kisara-header", isHome ? "is-home-header" : "is-inner-header"]}>
      <a class="kisara-brand" href={getThemePath("kisara", "/")} aria-label="Kisara 主题首页">
        <span class="kisara-brand-mark" aria-hidden="true"></span>
        <span><strong>YUIMI LAB</strong><small>KISARA / 03</small></span>
      </a>
      <nav class="kisara-nav" aria-label="Kisara theme navigation">
        {navItems.map((item) => (
          <a href={item.href} aria-current={item.active ? "page" : undefined}>
            <Icon name={item.icon} aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
      <button class="kisara-theme-button" type="button" data-kisara-theme-button aria-label="选择主题" title="选择主题" aria-expanded="false">
        <Icon name="tabler:palette" aria-hidden="true" />
      </button>
    </header>

    <div class="kisara-theme-panel" data-kisara-theme-panel hidden>
      <div class="kisara-panel-heading">
        <span>SELECT THEME</span>
        <button type="button" data-kisara-panel-close aria-label="关闭主题选择器" title="关闭">
          <Icon name="tabler:x" aria-hidden="true" />
        </button>
      </div>
      {themeOptions.map((theme) => (
        <button type="button" data-theme-select={theme.id} aria-pressed={theme.id === "kisara" ? "true" : "false"}>
          <i aria-hidden="true"></i>
          {theme.label}
        </button>
      ))}
    </div>

    <main id="kisara-main" class="kisara-main">
      <slot />
    </main>

    <footer class="kisara-footer">
      <span class="kisara-footer-signal"><i aria-hidden="true"></i>CONTRACT CHANNEL 03 / ONLINE</span>
      <nav aria-label="Kisara footer navigation">
        {navItems.slice(1).map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <span>© 2026 喝益胃 / YUIMI LAB</span>
    </footer>

    <div
      class="kisara-scrollbar is-idle"
      data-kisara-scrollbar
      role="scrollbar"
      aria-label="页面滚动进度"
      aria-controls="kisara-main"
      aria-orientation="vertical"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      tabindex="0"
    >
      <span class="kisara-scrollbar-progress" aria-hidden="true"></span>
      <span class="kisara-scrollbar-thumb" data-kisara-scrollbar-thumb aria-hidden="true"><i></i></span>
    </div>

    <nav class="kisara-context-menu" data-kisara-context-menu hidden aria-label="Kisara 主题快捷菜单">
      <span>THEME CHANNEL</span>
      {themeOptions.map((theme) => (
        <button type="button" data-theme-select={theme.id} aria-pressed={theme.id === "kisara" ? "true" : "false"}>
          <i aria-hidden="true"></i>
          {theme.label}
        </button>
      ))}
      <hr />
      <button type="button" data-kisara-action="top"><Icon name="tabler:arrow-up" aria-hidden="true" /><span>回到顶部</span></button>
      <button type="button" data-kisara-action="home"><Icon name="tabler:home" aria-hidden="true" /><span>Kisara 首页</span></button>
    </nav>

    <script is:inline>
      (() => {
        const panel = document.querySelector("[data-kisara-theme-panel]");
        const panelButton = document.querySelector("[data-kisara-theme-button]");
        const panelClose = document.querySelector("[data-kisara-panel-close]");
        const menu = document.querySelector("[data-kisara-context-menu]");
        const scrollbar = document.querySelector("[data-kisara-scrollbar]");
        const scrollbarThumb = scrollbar?.querySelector("[data-kisara-scrollbar-thumb]");
        let returnFocus = null;
        let scrollbarFrame = 0;
        let scrollbarDragPointer = null;
        let scrollbarDragOffset = 0;

        const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

        const getScrollbarMetrics = () => {
          if (!(scrollbar instanceof HTMLElement)) return null;
          const root = document.scrollingElement ?? document.documentElement;
          const trackRect = scrollbar.getBoundingClientRect();
          const viewportHeight = window.innerHeight;
          const scrollHeight = Math.max(root.scrollHeight, document.body.scrollHeight);
          const scrollRange = Math.max(0, scrollHeight - viewportHeight);
          const minimumThumbSize = window.innerWidth <= 600 ? 34 : 46;
          const thumbSize = clamp(trackRect.height * (viewportHeight / Math.max(scrollHeight, 1)), minimumThumbSize, 82);
          const thumbTravel = Math.max(0, trackRect.height - thumbSize);
          return { root, trackRect, scrollRange, thumbSize, thumbTravel };
        };

        const updateScrollbar = () => {
          scrollbarFrame = 0;
          if (!(scrollbar instanceof HTMLElement)) return;
          const metrics = getScrollbarMetrics();
          if (!metrics) return;
          const progress = metrics.scrollRange > 0 ? clamp(window.scrollY / metrics.scrollRange, 0, 1) : 0;
          scrollbar.classList.toggle("is-idle", metrics.scrollRange <= 1 || metrics.trackRect.height <= 0);
          scrollbar.style.setProperty("--kisara-scroll-progress", String(progress));
          scrollbar.style.setProperty("--kisara-scroll-thumb-size", `${metrics.thumbSize}px`);
          scrollbar.style.setProperty("--kisara-scroll-thumb-y", `${metrics.thumbTravel * progress}px`);
          scrollbar.setAttribute("aria-valuenow", String(Math.round(progress * 100)));
        };

        const scheduleScrollbarUpdate = () => {
          if (scrollbarFrame) return;
          scrollbarFrame = requestAnimationFrame(updateScrollbar);
        };

        const scrollFromPointer = (clientY) => {
          const metrics = getScrollbarMetrics();
          if (!metrics || metrics.scrollRange <= 0) return;
          const thumbTop = clamp(clientY - metrics.trackRect.top - scrollbarDragOffset, 0, metrics.thumbTravel);
          const progress = metrics.thumbTravel > 0 ? thumbTop / metrics.thumbTravel : 0;
          window.scrollTo({ top: progress * metrics.scrollRange, behavior: "auto" });
        };

        document.querySelectorAll("img, video").forEach((asset) => asset.setAttribute("draggable", "false"));

        document.addEventListener("dragstart", (event) => {
          const target = event.target instanceof Element ? event.target : null;
          if (target?.closest("img, picture, canvas, video, svg, .kisara-title, .kisara-gate-visual")) event.preventDefault();
        }, true);

        document.addEventListener("selectstart", (event) => {
          const target = event.target instanceof Element ? event.target : null;
          if (target?.closest(".kisara-gate, img, picture, canvas, video, svg")) event.preventDefault();
        }, true);

        scrollbar?.addEventListener("pointerdown", (event) => {
          if (!(event instanceof PointerEvent) || event.button !== 0 || !(scrollbar instanceof HTMLElement)) return;
          const metrics = getScrollbarMetrics();
          if (!metrics || metrics.scrollRange <= 0) return;
          const pressedThumb = event.target instanceof Element && event.target.closest("[data-kisara-scrollbar-thumb]");
          const thumbRect = scrollbarThumb?.getBoundingClientRect();
          scrollbarDragOffset = pressedThumb && thumbRect ? event.clientY - thumbRect.top : metrics.thumbSize / 2;
          scrollbarDragPointer = event.pointerId;
          scrollbar.classList.add("is-dragging");
          scrollbar.setPointerCapture(event.pointerId);
          scrollFromPointer(event.clientY);
          event.preventDefault();
        });

        scrollbar?.addEventListener("pointermove", (event) => {
          if (!(event instanceof PointerEvent) || event.pointerId !== scrollbarDragPointer) return;
          scrollFromPointer(event.clientY);
          event.preventDefault();
        });

        const endScrollbarDrag = (event) => {
          if (!(event instanceof PointerEvent) || event.pointerId !== scrollbarDragPointer || !(scrollbar instanceof HTMLElement)) return;
          if (scrollbar.hasPointerCapture(event.pointerId)) scrollbar.releasePointerCapture(event.pointerId);
          scrollbarDragPointer = null;
          scrollbar.classList.remove("is-dragging");
        };

        scrollbar?.addEventListener("pointerup", endScrollbarDrag);
        scrollbar?.addEventListener("pointercancel", endScrollbarDrag);

        scrollbar?.addEventListener("keydown", (event) => {
          if (!(event instanceof KeyboardEvent)) return;
          const metrics = getScrollbarMetrics();
          if (!metrics || metrics.scrollRange <= 0) return;
          const keyTargets = {
            ArrowUp: window.scrollY - 52,
            ArrowDown: window.scrollY + 52,
            PageUp: window.scrollY - window.innerHeight * 0.82,
            PageDown: window.scrollY + window.innerHeight * 0.82,
            Home: 0,
            End: metrics.scrollRange
          };
          if (!(event.key in keyTargets)) return;
          window.scrollTo({ top: clamp(keyTargets[event.key], 0, metrics.scrollRange), behavior: "smooth" });
          event.preventDefault();
        });

        window.addEventListener("scroll", scheduleScrollbarUpdate, { passive: true });
        window.addEventListener("resize", scheduleScrollbarUpdate, { passive: true });
        window.addEventListener("pageshow", scheduleScrollbarUpdate);
        new ResizeObserver(scheduleScrollbarUpdate).observe(document.body);
        scheduleScrollbarUpdate();

        const closePanel = () => {
          if (panel) panel.hidden = true;
          panelButton?.setAttribute("aria-expanded", "false");
        };

        const closeMenu = () => {
          if (!menu || menu.hidden) return;
          const restore = menu.contains(document.activeElement);
          menu.hidden = true;
          if (restore && returnFocus instanceof HTMLElement) returnFocus.focus({ preventScroll: true });
        };

        const showMenu = (x, y, focusFirst = false) => {
          if (!menu) return;
          returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : panelButton;
          menu.hidden = false;
          menu.style.left = "0px";
          menu.style.top = "0px";
          const rect = menu.getBoundingClientRect();
          menu.style.left = `${Math.max(12, Math.min(x, window.innerWidth - rect.width - 12))}px`;
          menu.style.top = `${Math.max(12, Math.min(y, window.innerHeight - rect.height - 12))}px`;
          if (focusFirst) menu.querySelector("button")?.focus({ preventScroll: true });
        };

        panelButton?.addEventListener("click", () => {
          if (!panel) return;
          const opening = panel.hidden;
          panel.hidden = !opening;
          panelButton.setAttribute("aria-expanded", String(opening));
        });
        panelClose?.addEventListener("click", closePanel);

        window.addEventListener("contextmenu", (event) => {
          event.preventDefault();
          closePanel();
          showMenu(event.clientX, event.clientY);
        });

        window.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            closePanel();
            closeMenu();
          }
          if (event.key === "ContextMenu" || (event.key === "F10" && event.shiftKey)) {
            event.preventDefault();
            const rect = document.activeElement?.getBoundingClientRect?.();
            showMenu(rect ? rect.left + 24 : window.innerWidth / 2, rect ? rect.top + 24 : window.innerHeight / 2, true);
          }
        });

        document.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target : null;
          const themeButton = target?.closest("[data-theme-select]");
          if (themeButton) {
            closePanel();
            closeMenu();
            window.__yuimiTheme?.select(themeButton.dataset.themeSelect);
            return;
          }

          const action = target?.closest("[data-kisara-action]")?.dataset.kisaraAction;
          if (action === "top") window.scrollTo({ top: 0, behavior: "smooth" });
          if (action === "home") window.location.href = "/themes/kisara/";
          if (action) closeMenu();

          if (!target?.closest("[data-kisara-theme-panel]") && !target?.closest("[data-kisara-theme-button]")) closePanel();
          if (!target?.closest("[data-kisara-context-menu]")) closeMenu();
        });
      })();
    </script>
  </body>
</html>
