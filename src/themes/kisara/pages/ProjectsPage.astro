---
import KisaraLayout from "../layouts/KisaraLayout.astro";
import projectsStylesheet from "../styles/projects.css?url";
import { Icon } from "astro-icon/components";
import { projectEntries, projectTechLines } from "@/core/data/projects";

const covers = [
  "/themes/kisara/assets/works-index/work-01.webp",
  "/themes/kisara/assets/works-index/work-02.webp",
  "/themes/kisara/assets/works-index/work-03.webp",
  "/themes/kisara/assets/works-index/work-04.webp"
];
const coverHeights = [1051, 874, 1051, 1051];

const lineLabels = Object.fromEntries(projectTechLines.map((line) => [line.key, line.label]));
const projects = projectEntries.map((project, index) => ({
  ...project,
  cover: covers[index % covers.length],
  coverHeight: coverHeights[index % covers.length],
  index: String(index + 1).padStart(2, "0")
}));
const featured = projects[0];
const archive = projects;
const distinctLanguages = new Set(projects.map((project) => project.language)).size;
---

<KisaraLayout
  title="Works | Kisara"
  description="Yuimi Lab 的项目档案：博客、AstrBot 插件、Codex 工具与文档。"
  stylesheets={[projectsStylesheet]}
  priorityImages={["/themes/kisara/assets/works-opening-first.webp"]}
  showFooter={false}
>
  <div class="kisara-index" data-kisara-works-index data-works-album aria-labelledby="kisara-works-title">
    <header class="kisara-index-hero" id="kisara-works-title" data-works-intro data-video-state="idle">
      <div class="kisara-index-film" aria-hidden="true">
        <img
          class="kisara-index-film-poster"
          src="/themes/kisara/assets/works-opening-first.webp"
          alt=""
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <video
          data-works-intro-video
          data-src="/themes/kisara/assets/works-opening.mp4"
          poster="/themes/kisara/assets/works-opening-first.webp"
          width="1920"
          height="1080"
          preload="none"
          muted
          playsinline
          disablepictureinpicture
        ></video>
        <img
          class="kisara-index-film-still"
          src="/themes/kisara/assets/works-opening-last.webp"
          alt=""
          width="1920"
          height="1080"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="kisara-index-hero-copy">
        <p class="kisara-index-kicker"><span>WORKS / INDEX</span><i aria-hidden="true"></i>Yuimi Lab · 2026</p>
        <h1 aria-label="Works, built in layers.">
          <span>WORKS</span>
          <em>built in <b>layers.</b></em>
        </h1>
        <p class="kisara-index-lede">
          博客、机器人插件、桌面工具，和那些终于被写下来的方法。
        </p>
        <div class="kisara-index-actions">
          <a href="#kisara-archive" class="kisara-index-primary">
            <Icon name="tabler:arrow-down" aria-hidden="true" />
            翻到档案
          </a>
          <a href="https://github.com/Yuimi-chaya" target="_blank" rel="noopener noreferrer" class="kisara-index-secondary">
            <Icon name="simple-icons:github" aria-hidden="true" />
            Yuimi-chaya
          </a>
          <button type="button" data-works-intro-replay aria-label="重播首屏动画" title="重播首屏动画" hidden>
            <Icon name="tabler:refresh" aria-hidden="true" />
          </button>
        </div>
      </div>

      <dl class="kisara-index-stats" aria-label="档案概览">
        <div><dt>PROJECTS</dt><dd>{String(projects.length).padStart(2, "0")}</dd></div>
        <div><dt>LANGUAGES</dt><dd>{String(distinctLanguages).padStart(2, "0")}</dd></div>
        <div><dt>THEMES</dt><dd>03</dd></div>
        <div><dt>STATUS</dt><dd>LIVE</dd></div>
      </dl>
    </header>

    <nav class="kisara-index-filters" aria-label="按方向筛选项目">
      <span class="kisara-index-filters-label">FILTER BY LINE</span>
      <div role="group" aria-label="项目方向">
        <button type="button" data-works-filter="all" aria-pressed="true" class="is-active">
          全部<span>ALL</span>
        </button>
        {projectTechLines.map((line) => (
          <button type="button" data-works-filter={line.key} aria-pressed="false">
            {line.label.split(" / ")[0]}<span>{line.key.toUpperCase()}</span>
          </button>
        ))}
      </div>
      <output class="kisara-index-count" aria-live="polite" aria-atomic="true">
        <strong data-works-count>{String(projects.length).padStart(2, "0")}</strong>
        <span>FILES MATCHED</span>
      </output>
    </nav>

    <section class="kisara-index-archive" id="kisara-archive" aria-labelledby="kisara-archive-title">
      <header class="kisara-index-section-head">
        <p><span>01</span> ARCHIVE</p>
        <h2 id="kisara-archive-title">项目档案</h2>
        <p>从博客主题到对话回合，从桌面工具到经验文档。</p>
      </header>

      <div class="kisara-index-grid" role="list" aria-label="项目档案">
        {archive.map((project) => (
          <article
            class="kisara-index-card"
            role="listitem"
            data-project-id={project.id}
            data-project-line={project.line}
          >
            <div class="kisara-index-card-art" aria-hidden="true">
              <img src={project.cover} alt="" width="720" height={project.coverHeight} loading="lazy" decoding="async" />
              <span>{project.index}</span>
            </div>
            <div class="kisara-index-card-body">
              <p class="kisara-index-card-line">
                <span>{lineLabels[project.line]}</span>
                <time>{project.year}</time>
              </p>
              <h3>{project.title}</h3>
              <p class="kisara-index-card-summary">{project.summary}</p>
              <ul class="kisara-index-card-tags">
                {project.details.map((detail) => <li>{detail}</li>)}
              </ul>
              <div class="kisara-index-card-meta">
                <span><i aria-hidden="true"></i>{project.language}</span>
                <span>{project.stars} stars</span>
                <span>{project.status}</span>
              </div>
              <a class="kisara-index-card-link" href={project.href} target="_blank" rel="noopener noreferrer">
                <Icon name="simple-icons:github" aria-hidden="true" />
                <span>{project.repo}</span>
                <Icon name="tabler:external-link" aria-hidden="true" />
              </a>
              <details class="kisara-index-card-reveal" name="kisara-project-notes">
                <summary>
                  项目手记
                  <Icon name="tabler:chevron-down" aria-hidden="true" />
                </summary>
                <div>
                  <p>{project.note}</p>
                  <p class="kisara-index-card-role">{project.role}</p>
                </div>
              </details>
            </div>
          </article>
        ))}
      </div>

      <nav class="kisara-index-pagination" data-works-pagination aria-label="项目分页" hidden>
        <button type="button" data-works-page="prev" aria-label="上一页项目" disabled><Icon name="tabler:arrow-left" aria-hidden="true" /></button>
        <output data-works-range aria-live="polite" aria-atomic="true"></output>
        <button type="button" data-works-page="next" aria-label="下一页项目"><Icon name="tabler:arrow-right" aria-hidden="true" /></button>
      </nav>

      <div class="kisara-index-empty" data-works-empty hidden>
        <Icon name="tabler:archive" aria-hidden="true" />
        <p>这条线上暂时没有档案。</p>
        <button type="button" data-works-filter="all">回到全部</button>
      </div>
    </section>

    <aside class="kisara-index-feature" aria-labelledby="kisara-feature-title">
      <div>
        <p class="kisara-index-kicker"><span>FEATURED FILE</span><i aria-hidden="true"></i>{featured.repo}</p>
        <h2 id="kisara-feature-title">{featured.title}</h2>
      </div>
      <div class="kisara-index-feature-links">
        <a href={featured.href} target="_blank" rel="noopener noreferrer">
          <Icon name="simple-icons:github" aria-hidden="true" />Repository
        </a>
        {featured.demo && (
          <a href={featured.demo} target="_blank" rel="noopener noreferrer">
            <Icon name="tabler:link" aria-hidden="true" />Live site
          </a>
        )}
      </div>
    </aside>
  </div>

  <script>
    let generation = 0;
    document.addEventListener("astro:page-load", () => {
      const entry = ++generation;
      const root = document.querySelector<HTMLElement>("[data-kisara-works-index]");
      if (!root) return;
      Promise.all([import("../lib/worksIndex.js"), import("../lib/worksHero")]).then(([{ bindWorksIndex }, { bindWorksHero }]) => {
        if (!root.isConnected || entry !== generation) return;
        window.__yuimiKisaraInnerCleanup?.();
        const releaseIndex = bindWorksIndex(root);
        const releaseHero = bindWorksHero(root);
        const cleanup = () => {
          releaseIndex();
          releaseHero();
          document.removeEventListener("astro:before-swap", cleanup);
          if (window.__yuimiKisaraInnerCleanup === cleanup) window.__yuimiKisaraInnerCleanup = null;
        };
        window.__yuimiKisaraInnerCleanup = cleanup;
        document.addEventListener("astro:before-swap", cleanup, { once: true });
      }).catch((error) => {
        if (!root.isConnected) return;
        console.error("Kisara Works index failed to load", error);
      });
    });
  </script>
</KisaraLayout>
