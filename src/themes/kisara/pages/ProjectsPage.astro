---
import KisaraLayout from "../layouts/KisaraLayout.astro";
import { projectEntries } from "@/core/data/projects";
---

<KisaraLayout title="Projects | Kisara" description="Yuimi Lab 的项目与实验记录。">
  <section class="kisara-page-lead">
    <p class="kisara-section-index">LABORATORY INDEX</p>
    <h1>Projects</h1>
    <p>正在运转、正在学习，也正在等待下一次灵感接入的项目线。</p>
  </section>
  <div class="kisara-record-list">
    {projectEntries.map((project, index) => (
      <article>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <div><small>{project.type} / {project.status}</small><h2>{project.title}</h2><p>{project.summary}</p></div>
      </article>
    ))}
  </div>
</KisaraLayout>
