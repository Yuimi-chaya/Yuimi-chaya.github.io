---
import KisaraLayout from "../layouts/KisaraLayout.astro";
import blogStylesheet from "../styles/blog.css?url";
import { Icon } from "astro-icon/components";
import { getPublishedPosts } from "@/core/content/blog";
import { getCoverSources, hasTransparentCover } from "@/core/content/coverSources";
import { getThemePath } from "@/core/themes/registry";
import { categoryLabel } from "@/lib/site";
import { getKisaraCoverPresentation } from "../lib/coverPresentation";
import { blogLettering } from "../data/blogLettering";

const posts = await getPublishedPosts();
const categories = Array.from(new Set(posts.map((post) => post.data.category)));
const dateFormatter = new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
const timelineDateFormatter = new Intl.DateTimeFormat("zh-CN", { month: "2-digit", day: "2-digit" });
const latestPostDate = posts[0]
  ? dateFormatter.format(posts[0].data.updatedDate ?? posts[0].data.pubDate)
  : "--";
const timelineYears = posts.reduce((groups, post) => {
  const year = (post.data.updatedDate ?? post.data.pubDate).getFullYear();
  let group = groups.find((item) => item.year === year);
  if (!group) {
    group = { year, posts: [] as typeof posts };
    groups.push(group);
  }
  group.posts.push(post);
  return groups;
}, [] as Array<{ year: number; posts: typeof posts }>);

const coverPresentation = await getKisaraCoverPresentation(posts);
const archiveCoverSizes = "(max-width: 760px) 112px, (max-width: 1100px) 45vw, 380px";
---

<KisaraLayout title="Blog | Kisara" description="Yuimi Lab 的文章记录。" stylesheets={[blogStylesheet]}>
  <div class="kisara-blog-stage-track" data-blog-stage-track>
  <div class="kisara-blog-stage" data-blog-stage>
  <section class="kisara-blog-hero" data-kisara-blog-hero data-intro-state="idle" data-cast-focus="all" aria-labelledby="kisara-blog-hero-title">
    <div class="kisara-blog-scene" aria-hidden="true">
      <img
        class="kisara-blog-scene-bg"
        src="/themes/kisara/assets/blog/engage-kiss-scene.webp"
        alt=""
        width="1440"
        height="975"
        decoding="async"
        fetchpriority="high"
      />
      <div class="kisara-blog-character-stage">
        <div class="kisara-blog-cast-slot is-sharon"><img class="kisara-blog-character" data-blog-character="sharon" src="/themes/kisara/assets/blog/sharon-back-art-v2.webp" alt="" width="1440" height="975" decoding="async" fetchpriority="low" /></div>
        <div class="kisara-blog-cast-slot is-ayano"><img class="kisara-blog-character" data-blog-character="ayano" src="/themes/kisara/assets/blog/ayano-middle-art-v2.webp" alt="" width="1440" height="975" decoding="async" fetchpriority="low" /></div>
        <div class="kisara-blog-cast-slot is-shu"><img class="kisara-blog-character" data-blog-character="shu" src="/themes/kisara/assets/blog/shu-middle-art-v2.webp" alt="" width="1440" height="975" decoding="async" fetchpriority="auto" /></div>
        <div class="kisara-blog-cast-slot is-kisara"><img class="kisara-blog-character" data-blog-character="kisara" src="/themes/kisara/assets/blog/kisara-front-blade-v6.webp" alt="" width="1440" height="975" decoding="async" fetchpriority="high" /></div>
      </div>
      <div class="kisara-blog-scene-veil"></div>
    </div>

    <div class="kisara-blog-hero-copy">
      <h1 id="kisara-blog-hero-title" aria-label="Every signal leaves a trace.">
        <span class="kisara-blog-trace-signal" data-trace-line>Every signal</span>
        <svg class="kisara-blog-trace-script" viewBox="0 12 626 94" role="presentation" aria-hidden="true">
          {blogLettering.map((letter, index) => (
            <g transform={`translate(${letter.x} 94) scale(.046875 -.046875)`}>
              <defs>
                <mask id={`blog-pen-${index}`} maskUnits="userSpaceOnUse" x="-200" y="-300" width="1700" height="2100">
                  {letter.strokes.map((stroke) => <path data-blog-pen data-pen-order={stroke.order} d={stroke.d} pathLength="1" />)}
                </mask>
              </defs>
              <use class="kisara-blog-trace-glyph" href={`/themes/kisara/assets/blog/trace-glyphs.svg#${letter.character === "." ? "dot" : letter.character}`} mask={`url(#blog-pen-${index})`} fill="currentColor" />
            </g>
          ))}
        </svg>
      </h1>
    </div>

    <div class="kisara-blog-cast-note" data-blog-cast-note data-cast-note-for="all" aria-live="polite">
      <small data-blog-cast-label></small>
      <strong data-blog-cast-copy></strong>
    </div>

    <a class="kisara-blog-enter" href="#kisara-blog-archive">
      <span><small>{String(categories.length).padStart(2, "0")} CHANNELS</small><strong>OPEN THE ARCHIVE</strong></span>
      <Icon name="tabler:chevron-down" aria-hidden="true" />
    </a>

  </section>

  <section id="kisara-blog-archive" class="kisara-blog-archive" data-kisara-archive aria-label="文章归档">
    <header class="kisara-blog-archive-heading">
      <div class="kisara-blog-archive-intro">
        <p>THE ARCHIVE / {String(posts.length).padStart(2, "0")}</p>
        <h2>文章<em>归档。</em></h2>
      </div>
      <div class="kisara-blog-archive-status">
        <span>LAST SYNC</span>
        <strong>{latestPostDate}</strong>
      </div>
    </header>

    <div class="kisara-blog-view-switch" role="tablist" aria-label="博客归档视图">
      <button id="kisara-blog-view-stream" type="button" role="tab" aria-selected="true" aria-controls="kisara-blog-panel-stream" data-kisara-view="stream">
        <Icon name="tabler:book-2" aria-hidden="true" />
        <span><strong>文章</strong><small>ARTICLE INDEX</small></span>
      </button>
      <button id="kisara-blog-view-timeline" type="button" role="tab" aria-selected="false" aria-controls="kisara-blog-panel-timeline" tabindex="-1" data-kisara-view="timeline">
        <Icon name="tabler:activity-heartbeat" aria-hidden="true" />
        <span><strong>时间轴</strong><small>CHRONOLOGY</small></span>
      </button>
    </div>

    <div class="kisara-blog-toolbar">
      <label>
        <Icon name="tabler:search" aria-hidden="true" />
        <input type="search" data-kisara-archive-search placeholder="SEARCH TITLE / TAG / SIGNAL" autocomplete="off" />
      </label>
      <div class="kisara-blog-filters" aria-label="文章频道筛选">
        <button type="button" data-kisara-filter="all" aria-pressed="true">ALL</button>
        {categories.map((category) => <button type="button" data-kisara-filter={category} aria-pressed="false">{categoryLabel[category]}</button>)}
      </div>
      <output data-kisara-result-count>{posts.length} SIGNALS</output>
    </div>

    <div id="kisara-blog-panel-stream" class="kisara-blog-view-panel" role="tabpanel" aria-labelledby="kisara-blog-view-stream" data-kisara-view-panel="stream">
    <div class="kisara-blog-stream" data-kisara-archive-list>
      {posts.map((post, index) => {
        const cover = coverPresentation.get(post.id);
        return (
        <a
          class="kisara-blog-record"
          href={getThemePath("kisara", `/blog/${post.id}/`)}
          data-kisara-record
          data-post-id={post.id}
          data-category={post.data.category}
          data-search={[post.data.title, post.data.description, ...post.data.tags].join(" ").toLowerCase()}
          style={`--archive-order: ${index}; --archive-cover-position: ${cover?.position ?? "50% 32%"};`}
        >
          <figure data-cover-fit={cover?.fit ?? "portrait"}>
            {hasTransparentCover(post.data.cover) && (
              <img class="kisara-blog-cover-ambient" src={post.data.cover}
                {...getCoverSources(post.data.cover, archiveCoverSizes)}
                alt="" loading="lazy" decoding="async" fetchpriority="low" />
            )}
            {post.data.cover ? (
              <img
                src={post.data.cover}
                {...getCoverSources(post.data.cover, archiveCoverSizes)}
                alt=""
                width={cover?.width ?? 700}
                height={cover?.height ?? 990}
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            ) : (
              <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            )}
            <figcaption><span>{String(index + 1).padStart(2, "0")}</span><small>{cover?.fit === "crop" ? "CROPPED LOG" : "PORTRAIT LOG"}</small></figcaption>
          </figure>
          <div class="kisara-blog-record-body">
            <div class="kisara-blog-record-meta">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <small>{categoryLabel[post.data.category]}</small>
              <time datetime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}>{dateFormatter.format(post.data.updatedDate ?? post.data.pubDate)}</time>
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="kisara-blog-record-tags">{post.data.tags.slice(0, 4).map((tag) => <em>#{tag}</em>)}</div>
            <span class="kisara-blog-record-action">READ TRANSMISSION <i aria-hidden="true">↗</i></span>
          </div>
        </a>
        );
      })}
    </div>
    </div>

    <div id="kisara-blog-panel-timeline" class="kisara-blog-view-panel" role="tabpanel" aria-labelledby="kisara-blog-view-timeline" data-kisara-view-panel="timeline" hidden>
      <div class="kisara-blog-timeline" data-kisara-timeline>
        {timelineYears.map((group) => (
          <section class="kisara-blog-timeline-year" data-kisara-timeline-year>
            <header>
              <span>{group.year}</span>
              <small>{String(group.posts.length).padStart(2, "0")} LOGS</small>
            </header>
            <div class="kisara-blog-timeline-track">
              {group.posts.map((post, index) => {
                const cover = coverPresentation.get(post.id);
                const postDate = post.data.updatedDate ?? post.data.pubDate;
                const [month, day] = timelineDateFormatter.format(postDate).split("/");
                return (
                  <a
                    class="kisara-blog-timeline-record"
                    href={getThemePath("kisara", `/blog/${post.id}/`)}
                    data-kisara-record
                    data-post-id={post.id}
                    data-category={post.data.category}
                    data-search={[post.data.title, post.data.description, ...post.data.tags].join(" ").toLowerCase()}
                    style={`--timeline-order: ${index}; --timeline-cover-position: ${cover?.position ?? "50% 32%"};`}
                  >
                    <time datetime={postDate.toISOString()}>
                      <strong>{month}.{day}</strong>
                      <span>{categoryLabel[post.data.category]}</span>
                    </time>
                    <i class="kisara-blog-timeline-node" aria-hidden="true"></i>
                    <div class="kisara-blog-timeline-copy">
                      <div>
                        <p>{post.data.description}</p>
                        <h3>{post.data.title}</h3>
                        <div>{post.data.tags.slice(0, 4).map((tag) => <em>#{tag}</em>)}</div>
                      </div>
                      {post.data.cover && (
                        <figure>
                          <img src={post.data.cover} {...getCoverSources(post.data.cover, "74px")} alt="" width={cover?.width ?? 700} height={cover?.height ?? 990} loading="lazy" fetchpriority="low" decoding="async" />
                        </figure>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
    <p class="kisara-blog-empty" data-kisara-empty hidden>NO MATCHED SIGNAL / 换一个关键词试试。</p>
  </section>
  </div>
  </div>

  <script>
    document.addEventListener("astro:page-load", () => {
      const root = document.querySelector<HTMLElement>("[data-kisara-blog-hero]");
      if (!root) return;
      import("../lib/blogPage.js").then(({ bindBlogPage }) => {
        if (root.isConnected) bindBlogPage();
      }).catch(error => {
        if (!root.isConnected) return;
        window.__yuimiKisaraInnerCleanup?.();
        root.dataset.introState = "complete";
        console.error("Kisara blog interaction failed to load", error);
      });
    });
  </script>
</KisaraLayout>
