          energyCanvas.height = pixelHeight;
          energyContext.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
        }
        energyCanvasWidth = width;
        energyCanvasHeight = height;
      };

      const refreshGateEffectLayout = (force = false) => {
        if (!force && meterLayout.width > 0 && titleLayout.width > 0) return;
        const width = Math.max(1, gate.clientWidth);
        const height = Math.max(1, gate.clientHeight);
        meterLayout = {
          width: meterShell?.clientWidth || Math.min(620, width * 0.78),
          height: meterShell?.clientHeight || 68,
          left: meterShell?.offsetLeft ?? (width - Math.min(620, width * 0.78)) / 2,
          top: meterShell?.offsetTop ?? height * 0.58
        };
        const titleRect = title?.getBoundingClientRect();
        titleLayout = {
          width: titleRect?.width || Math.min(width * 0.82, 880),
          height: titleRect?.height || Math.min(height * 0.24, 190),
          left: titleRect ? titleRect.left - rect.left : width * 0.09,
          top: titleRect ? titleRect.top - rect.top : height * 0.28
        };
      };

      const trimParticlePool = (particles, limit, seedOffset) => {
        while (particles.length > limit) {
          const index = Math.floor(
            randomSeed(particles.length * 1.371 + limit * 0.719 + seedOffset) * particles.length
          );
          particles[index] = particles[particles.length - 1];
          particles.pop();
        }
      };

      const updateRenderQuality = (timestamp, renderCost) => {
        if (!Number.isFinite(renderCost) || renderCost <= 0) return;
        renderCostEma = renderCostEma > 0
          ? renderCostEma * 0.92 + renderCost * 0.08
          : renderCost;
        if (timestamp - lastQualityAdjustment < 1200) return;
        lastQualityAdjustment = timestamp;
        const mobile = gate.clientWidth < 640;
        const highCost = mobile ? 13.5 : 16.5;
        const lowCost = mobile ? 7.4 : 9.2;
        if (renderCostEma > highCost && renderQuality > renderQualityFloor) {
          renderQuality = Math.max(renderQualityFloor, renderQuality - 0.08);
          const width = gate.clientWidth;
          trimParticlePool(
            wakeParticles,
            Math.floor((width < 640 ? 175 : 280) * (0.8 + renderQuality * 0.2)),
            11
          );
          trimParticlePool(
            orbitParticles,
            Math.floor((width < 640 ? 82 : 160) * renderQuality),
            23
          );
          trimParticlePool(
            burstParticles,
            Math.floor((width < 640 ? 120 : 220) * renderQuality),
            37
          );
          trimParticlePool(
            rainParticles,
            Math.floor((width < 640 ? 88 : 152) * renderQuality),
            53
          );
        } else if (renderCostEma < lowCost && renderQuality < renderQualityCeiling) {
          renderQuality = Math.min(renderQualityCeiling, renderQuality + 0.035);
        }
      };


      const clearTitleAbyssCanvas = (resetPointer = false) => {
        if (titleAbyssCanvas && titleAbyssContext) {
          titleAbyssContext.setTransform(1, 0, 0, 1, 0, 0);
