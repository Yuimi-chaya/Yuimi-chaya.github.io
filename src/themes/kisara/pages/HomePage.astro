          }
        }
        context.restore();
      };
      const nextParticleRandom = () => randomSeed((particleSerial += 1) * 1.61803398875 + 0.37);

      const postReleaseSources = [
        { x: 0.4845, y: 0.338, kind: "eye", angle: -0.16, strength: 1 },
        { x: 0.5585, y: 0.336, kind: "eye", angle: 0.08, strength: 0.96 },
