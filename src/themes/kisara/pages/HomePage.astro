      };

      const resetGateState = () => {
        if (animationFrame) window.cancelAnimationFrame(animationFrame);
        if (energyFrame) window.cancelAnimationFrame(energyFrame);
        if (energyTimer) window.clearTimeout(energyTimer);
        animationFrame = 0;
        energyFrame = 0;
        energyTimer = 0;
        energyLoopActive = false;
        lastFrameTime = 0;
        targetProgress = 0;
        progress = 0;
        velocity = 0;
        targetBurstProgress = 0;
        burstProgress = 0;
        burstVelocity = 0;
        releaseMode = "manual";
        releaseTimeline = 0;
        releaseDuration = releaseCompletedInTab
          ? releaseReplayAutoplayDuration
          : releaseFirstAutoplayDuration;
        releaseLastTimestamp = 0;
        releasePlaybackRate = 1;
        releaseBoost = 0;
        releaseVisualPressure = 0;
        releaseRewindFromTimeline = 0;
        releaseRewindStartedAt = 0;
        releaseRewindDuration = 0;
        releaseRewindVeil = 0;
        warningPresentationActive = false;
        crossPresentationActive = false;
        gate.classList.remove("is-warning-prewarm");
        chargeIntroProgress = 0;
        chargeIntroActive = false;
        chargeIntroComplete = false;
        chargeIntroStartedAt = 0;
        chargeIntroFrom = 0;
        chargeIntroTarget = 0;
        chargeIntroTransitionDuration = 0;
        chargeIntroReversing = false;
        energyProgress = 0;
        poseTimestamp = 0;
        poseClock = 0;
        poseAtRest = true;
        chargeInstability = 0;
        motionPhases = makeMotionPhases();
        screenParticleTimestamp = 0;
        lastEnergyPaintTimestamp = 0;
        renderQuality = Math.max(renderQuality, 0.88);
        renderCostEma = 0;
        lastQualityAdjustment = 0;
        singularityFieldLastPaintTimestamp = 0;
        energyFlowTimestamp = 0;
        beamHeadTimestamp = 0;
        beamHeadX = 0;
        beamHeadY = 0;
        beamHeadVelocityX = 0;
        beamHeadVelocityY = 0;
        beamMotionEnergy = 0;
        particleSerial = 0;
        wakeEmissionBudget = 0;
        orbitEmissionBudget = 0;
        rainEmissionBudget = 0;
        burstWaveMask = 0;
        wakePrimed = false;
        wakeParticles.length = 0;
        orbitParticles.length = 0;
        burstParticles.length = 0;
        rainParticles.length = 0;
