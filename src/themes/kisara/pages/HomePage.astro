          orientationBaseX += axes.x;
          orientationBaseY += axes.y;
          orientationCalibrationCount += 1;
          if (orientationCalibrationCount === 8) {
            orientationBaseX /= orientationCalibrationCount;
            orientationBaseY /= orientationCalibrationCount;
          }
          return;
        }
        const targetX = mapOrientationDelta(axes.x - orientationBaseX) * postReleaseMaxX * 0.86;
        const targetY = mapOrientationDelta(axes.y - orientationBaseY) * postReleaseMaxY * 0.72;
        orientationFilteredX += (targetX - orientationFilteredX) * 0.18;
        orientationFilteredY += (targetY - orientationFilteredY) * 0.16;
        postReleaseTargetX = clamp(orientationFilteredX, -postReleaseMaxX, postReleaseMaxX);
        postReleaseTargetY = clamp(orientationFilteredY, -postReleaseMaxY, postReleaseMaxY);
        postReleaseJourney = null;
        postReleasePointerAccumulator = 0;
        startPostReleaseAnimation();
      };

      const setOrientationEnabled = (enabled) => {
        orientationEnabled = Boolean(enabled && orientationSupported);
        postReleaseJourney = null;
        postReleasePointerAccumulator = 0;
        resetOrientationCalibration();
        updateMotionToggle();
        if (orientationEnabled) startPostReleaseAnimation();
      };

      const requestOrientationAccess = async () => {
        if (!orientationSupported) return;
        if (orientationEnabled) {
          orientationUserDisabled = true;
          setOrientationEnabled(false);
          return;
        }
        if (orientationPermissionRequired) {
          try {
            const permission = await orientationEvent.requestPermission();
            if (permission !== "granted") {
              updateMotionToggle();
              return;
            }
          } catch {
            updateMotionToggle();
            return;
          }
        }
        orientationUserDisabled = false;
        setOrientationEnabled(true);
      };

      window.addEventListener("deviceorientation", handleDeviceOrientation, { passive: true, signal });
      window.addEventListener("orientationchange", resetOrientationCalibration, { passive: true, signal });
      screen.orientation?.addEventListener("change", resetOrientationCalibration, { passive: true, signal });
      motionToggle?.addEventListener("click", requestOrientationAccess, { signal });
      updateMotionToggle();

      const getPostReleaseFlowAngle = (unit) => {
        const position = clamp(unit, 0, 1) * (postReleaseFlowSegmentCount - 1);
        const index = Math.min(postReleaseFlowSegmentCount - 2, Math.floor(position));
        const blend = position - index;
        const angle = postReleaseFlowAngles[index];
        return angle + shortestAngleDelta(angle, postReleaseFlowAngles[index + 1]) * blend;
      };

      const updatePostReleaseFlow = (frameSeconds) => {
        const targetAngle = Math.atan2(-0.42, -(postReleaseDirection || 1));
        let chainTension = 0;
        for (let index = 0; index < postReleaseFlowSegmentCount; index += 1) {
          const leaderAngle = index === 0 ? targetAngle : postReleaseFlowAngles[index - 1];
          const angleDelta = shortestAngleDelta(postReleaseFlowAngles[index], leaderAngle);
          const stiffness = index === 0 ? 34 : 48 - index * 2.15;
          const damping = index === 0 ? 8.2 : 8.8 + index * 0.34;
          postReleaseFlowAngularVelocities[index] += angleDelta * stiffness * frameSeconds;
          postReleaseFlowAngularVelocities[index] *= Math.exp(-damping * frameSeconds);
          postReleaseFlowAngularVelocities[index] = clamp(
            postReleaseFlowAngularVelocities[index],
            index === 0 ? -5.4 : -4.8,
            index === 0 ? 5.4 : 4.8
          );
          postReleaseFlowAngles[index] += postReleaseFlowAngularVelocities[index] * frameSeconds;
          chainTension = Math.max(chainTension, Math.abs(angleDelta));
        }
        postReleaseFlowWhip = Math.max(
          postReleaseFlowWhip * Math.exp(-frameSeconds * 2.35),
          clamp(chainTension / 1.12, 0, 1)
        );
      };

      const clearPostReleaseCanvas = () => {
        if (!postReleaseCanvas || !postReleaseContext) return;
        postReleaseContext.setTransform(1, 0, 0, 1, 0, 0);
        postReleaseContext.clearRect(0, 0, postReleaseCanvas.width, postReleaseCanvas.height);
        postReleaseContext.setTransform(postReleasePixelRatio, 0, 0, postReleasePixelRatio, 0, 0);
      };

      const clearTitleChains = () => {
        const layers = [
          [chainBackCanvas, chainBackContext],
          [chainFrontCanvas, chainFrontContext]
        ];
        for (const [canvas, context] of layers) {
          if (!canvas || !context) continue;
          context.setTransform(1, 0, 0, 1, 0, 0);
          context.clearRect(0, 0, canvas.width, canvas.height);
          context.setTransform(chainPixelRatio, 0, 0, chainPixelRatio, 0, 0);
          canvas.style.opacity = "0";
        }
      };

      const rebuildTitleChainLayout = () => {
        if (!chainBackContext || !title || chainTitleBox.width <= 1) return;
        const text = "Kisara";
        const style = window.getComputedStyle(title);
        const fontSize = Math.max(1, Number.parseFloat(style.fontSize));
        chainBackContext.save();
        chainBackContext.font = `${style.fontWeight} ${fontSize}px ${style.fontFamily}`;
        chainBackContext.textBaseline = "alphabetic";
        const textMetrics = chainBackContext.measureText(text);
        const measuredWidth = Math.max(1, textMetrics.width);
        const widthScale = chainTitleBox.width / measuredWidth;
        const centerX = chainTitleBox.left + chainTitleBox.width * 0.5;
        const textLeft = centerX - measuredWidth * widthScale * 0.5;
        const measuredAscent = Number.isFinite(textMetrics.actualBoundingBoxAscent)
          && textMetrics.actualBoundingBoxAscent > 0
          ? textMetrics.actualBoundingBoxAscent
          : fontSize * 0.72;
        const measuredDescent = Number.isFinite(textMetrics.actualBoundingBoxDescent)
          && textMetrics.actualBoundingBoxDescent >= 0
          ? textMetrics.actualBoundingBoxDescent
          : fontSize * 0.06;
        const top = chainTitleBox.top + chainTitleBox.height * 0.08;
        const bottom = chainTitleBox.top + chainTitleBox.height * 0.92;
        const heightScale = (bottom - top) / Math.max(1, measuredAscent + measuredDescent);
        const baseline = top + measuredAscent * heightScale;
        const gaps = [];
        const glyphBounds = [];
        let prefixWidth = 0;
        for (let index = 0; index < text.length; index += 1) {
          const nextPrefixWidth = chainBackContext.measureText(text.slice(0, index + 1)).width;
          const glyphMetrics = chainBackContext.measureText(text[index]);
          const glyphAscent = Number.isFinite(glyphMetrics.actualBoundingBoxAscent)
            && glyphMetrics.actualBoundingBoxAscent > 0
            ? glyphMetrics.actualBoundingBoxAscent
            : measuredAscent;
          const glyphDescent = Number.isFinite(glyphMetrics.actualBoundingBoxDescent)
            && glyphMetrics.actualBoundingBoxDescent >= 0
            ? glyphMetrics.actualBoundingBoxDescent
            : measuredDescent;
          glyphBounds.push({
            left: textLeft + prefixWidth * widthScale,
            right: textLeft + nextPrefixWidth * widthScale,
            top: baseline - glyphAscent * heightScale,
            bottom: baseline + glyphDescent * heightScale
          });
          if (index < text.length - 1) {
            gaps.push(textLeft + nextPrefixWidth * widthScale);
          }
          prefixWidth = nextPrefixWidth;
        }
        chainBackContext.restore();
        const anchorBounds = Array.from({ length: text.length + 1 }, (_, index) => {
          if (index === 0) {
            return { top: glyphBounds[0].top, bottom: glyphBounds[0].bottom };
          }
          if (index === text.length) {
            const glyph = glyphBounds[glyphBounds.length - 1];
            return { top: glyph.top, bottom: glyph.bottom };
          }
          const leftGlyph = glyphBounds[index - 1];
          const rightGlyph = glyphBounds[index];
          return {
            top: (leftGlyph.top + rightGlyph.top) * 0.5,
            bottom: (leftGlyph.bottom + rightGlyph.bottom) * 0.5
          };
        });
        chainGlyphLayout = {
          textLeft,
          textRight: textLeft + measuredWidth * widthScale,
          top,
          bottom,
          centerX,
          centerY: chainTitleBox.top + chainTitleBox.height * 0.52,
          gaps,
          anchorBounds
        };
      };

      const resizeTitleChains = (force = false) => {
        if (
          !chainBackCanvas
          || !chainBackContext
          || !chainFrontCanvas
          || !chainFrontContext
          || !title
        ) return;
        const canvasRect = chainBackCanvas.getBoundingClientRect();
        const titleRect = title.getBoundingClientRect();
        const width = Math.max(1, canvasRect.width);
        const height = Math.max(1, canvasRect.height);
        const deviceScale = Math.min(window.devicePixelRatio || 1, width < 640 ? 1.12 : 1.28);
        const pixelRatio = Math.min(deviceScale, 1660 / width, 560 / height);
        const pixelWidth = Math.max(1, Math.round(width * pixelRatio));
        const pixelHeight = Math.max(1, Math.round(height * pixelRatio));
        const changed = force
          || Math.abs(chainCanvasWidth - width) > 0.5
          || Math.abs(chainCanvasHeight - height) > 0.5
          || Math.abs(chainPixelRatio - pixelRatio) > 0.01
          || chainBackCanvas.width !== pixelWidth
          || chainBackCanvas.height !== pixelHeight
          || chainFrontCanvas.width !== pixelWidth
          || chainFrontCanvas.height !== pixelHeight;
        chainTitleBox = {
          left: titleRect.left - canvasRect.left,
          top: titleRect.top - canvasRect.top,
          width: titleRect.width,
          height: titleRect.height
        };
        if (changed) {
          chainBackCanvas.width = pixelWidth;
          chainBackCanvas.height = pixelHeight;
          chainFrontCanvas.width = pixelWidth;
          chainFrontCanvas.height = pixelHeight;
          chainCanvasWidth = width;
          chainCanvasHeight = height;
          chainPixelRatio = pixelRatio;
          chainLinkUnitCache.clear();
          chainLinkSpriteCache.clear();
          clearTitleChains();
        }
        rebuildTitleChainLayout();
      };

      const clearTitleDataCanvas = () => {
        if (!titleDataCanvas || !titleDataContext) return;
        titleDataContext.setTransform(1, 0, 0, 1, 0, 0);
        titleDataContext.clearRect(0, 0, titleDataCanvas.width, titleDataCanvas.height);
        titleDataContext.setTransform(titleDataPixelRatio, 0, 0, titleDataPixelRatio, 0, 0);
        titleDataCanvas.style.opacity = "0";
      };

      const rebuildTitleEffectMask = () => {
        if (
          !titleDataMaskContext
          || !title
          || titleDataMaskCanvas.width <= 1
          || titleDataMaskCanvas.height <= 1
        ) return;

        const width = titleDataMaskCanvas.width;
        const height = titleDataMaskCanvas.height;
        const style = window.getComputedStyle(title);
        const fontSize = Math.max(1, Number.parseFloat(style.fontSize) * titleDataPixelRatio);
        titleDataMaskContext.setTransform(1, 0, 0, 1, 0, 0);
        titleDataMaskContext.clearRect(0, 0, width, height);
        titleDataMaskContext.save();
        titleDataMaskContext.font = `${style.fontWeight} ${fontSize}px ${style.fontFamily}`;
        titleDataMaskContext.textAlign = "center";
        titleDataMaskContext.textBaseline = "alphabetic";
        titleDataMaskContext.lineJoin = "round";
        const metrics = titleDataMaskContext.measureText("Kisara");
        const baseline = height * 0.5
          + ((metrics.actualBoundingBoxAscent || fontSize * 0.72)
            - (metrics.actualBoundingBoxDescent || fontSize * 0.16)) * 0.5;
        titleDataMaskContext.fillStyle = "#ffffff";
        titleDataMaskContext.strokeStyle = "#ffffff";
        titleDataMaskContext.lineWidth = Math.max(1, 2.4 * titleDataPixelRatio);
        titleDataMaskContext.strokeText("Kisara", width * 0.5, baseline);
        titleDataMaskContext.fillText("Kisara", width * 0.5, baseline);
        titleDataMaskContext.restore();
      };

      const resizeTitleDataCanvas = (force = false) => {
        if (!titleDataCanvas || !titleDataContext || !titleDataMaskContext) return;
        const rect = titleDataCanvas.getBoundingClientRect();
        const width = Math.max(1, rect.width);
        const height = Math.max(1, rect.height);
        const deviceScale = Math.min(window.devicePixelRatio || 1, width < 640 ? 1.16 : 1.32);
        const pixelRatio = Math.min(deviceScale, 1536 / width, 460 / height);
        const pixelWidth = Math.max(1, Math.round(width * pixelRatio));
        const pixelHeight = Math.max(1, Math.round(height * pixelRatio));
        const changed = force
          || Math.abs(titleDataCanvasWidth - width) > 0.5
          || Math.abs(titleDataCanvasHeight - height) > 0.5
          || Math.abs(titleDataPixelRatio - pixelRatio) > 0.01
          || titleDataCanvas.width !== pixelWidth
          || titleDataCanvas.height !== pixelHeight;
        if (!changed) return;
        titleDataCanvas.width = pixelWidth;
        titleDataCanvas.height = pixelHeight;
        titleDataMaskCanvas.width = pixelWidth;
        titleDataMaskCanvas.height = pixelHeight;
        titleDataCanvasWidth = width;
        titleDataCanvasHeight = height;
        titleDataPixelRatio = pixelRatio;
        clearTitleDataCanvas();
        rebuildTitleEffectMask();
      };

      const refreshPostReleaseLayout = () => {
        const width = Math.max(1, gate.clientWidth);
        const height = Math.max(1, gate.clientHeight);
        const layerWidth = Math.max(width, fightBackground?.offsetWidth || width + 48);
        const layerHeight = Math.max(height, fightBackground?.offsetHeight || height + 48);
        const layerLeft = fightBackground?.offsetLeft ?? (width - layerWidth) * 0.5;
        const layerTop = fightBackground?.offsetTop ?? (height - layerHeight) * 0.5;
        const imageScale = Math.max(
          layerWidth / Math.max(1, fightImageWidth),
          layerHeight / Math.max(1, fightImageHeight)
        );
        const renderedWidth = fightImageWidth * imageScale;
        const renderedHeight = fightImageHeight * imageScale;
        const horizontalBleed = Math.max(0, (layerWidth - width) * 0.5);
        const verticalBleed = Math.max(0, (layerHeight - height) * 0.5);
        postReleaseMaxX = Math.min(width < 640 ? 8 : 14, Math.max(0, horizontalBleed - 6));
        postReleaseMaxY = Math.min(width < 640 ? 2.5 : 4, Math.max(0, verticalBleed - 7));
        postReleaseTargetX = clamp(postReleaseTargetX, -postReleaseMaxX, postReleaseMaxX);
        postReleaseX = clamp(postReleaseX, -postReleaseMaxX, postReleaseMaxX);
        postReleaseTargetY = clamp(postReleaseTargetY, -postReleaseMaxY, postReleaseMaxY);
        postReleaseY = clamp(postReleaseY, -postReleaseMaxY, postReleaseMaxY);
        postReleaseLayout = {
          layerLeft,
          layerTop,
          layerWidth,
          layerHeight,
          imageScale,
          imageLeft: layerLeft + (layerWidth - renderedWidth) * 0.5,
          imageTop: layerTop + (layerHeight - renderedHeight) * 0.5
        };
      };

      const resizePostReleaseCanvas = (force = false) => {
        if (!postReleaseCanvas || !postReleaseContext) return;
        const width = Math.max(1, Math.round(gate.clientWidth));
        const height = Math.max(1, Math.round(gate.clientHeight));
        const pixelRatio = Math.min(window.devicePixelRatio || 1, width < 640 ? 1.18 : 1.45);
        const pixelWidth = Math.max(1, Math.round(width * pixelRatio));
        const pixelHeight = Math.max(1, Math.round(height * pixelRatio));
        if (
          force
          || postReleaseCanvasWidth !== width
          || postReleaseCanvasHeight !== height
          || Math.abs(postReleasePixelRatio - pixelRatio) > 0.01
        ) {
          postReleaseCanvas.width = pixelWidth;
          postReleaseCanvas.height = pixelHeight;
          postReleaseCanvasWidth = width;
          postReleaseCanvasHeight = height;
          postReleasePixelRatio = pixelRatio;
          clearPostReleaseCanvas();
        }
        refreshPostReleaseLayout();
      };

      const mapPostReleaseSource = (source) => ({
        x: postReleaseLayout.imageLeft
          + source.x * fightImageWidth * postReleaseLayout.imageScale
          + postReleaseX,
        y: postReleaseLayout.imageTop
          + source.y * fightImageHeight * postReleaseLayout.imageScale
          + postReleaseY,
        scale: postReleaseLayout.imageScale
      });

      const drawPostReleaseBloom = (context, x, y, radiusX, radiusY, rotation, alpha) => {
        context.save();
        context.translate(x, y);
        context.rotate(rotation);
        context.scale(Math.max(0.001, radiusX), Math.max(0.001, radiusY));
        const gradient = context.createRadialGradient(0, 0, 0, 0, 0, 1);
        gradient.addColorStop(0, `rgba(255, 255, 255, ${0.9 * alpha})`);
        gradient.addColorStop(0.16, `rgba(255, 221, 236, ${0.78 * alpha})`);
        gradient.addColorStop(0.42, `rgba(255, 83, 151, ${0.38 * alpha})`);
        gradient.addColorStop(1, "rgba(255, 31, 118, 0)");
        context.fillStyle = gradient;
        context.beginPath();
        context.arc(0, 0, 1, 0, fullTurn);
        context.fill();
        context.restore();
      };

      const drawPostReleaseTrail = (context, source, point, speed, alpha) => {
        const trailLength = source.kind === "blade"
          ? 24 + Math.min(56, speed * 0.32) + postReleaseFlowWhip * 18
          : 10 + Math.min(34, speed * 0.22) + postReleaseFlowWhip * 10;
        const segmentCount = source.kind === "blade" ? 8 : 6;
        const segmentLength = trailLength / segmentCount;
        let tailX = point.x;
        let tailY = point.y;
        for (let segment = 0; segment < segmentCount; segment += 1) {
          const angle = getPostReleaseFlowAngle((segment + 0.5) / segmentCount);
          tailX += Math.cos(angle) * segmentLength;
          tailY += Math.sin(angle) * segmentLength;
        }
        const gradient = context.createLinearGradient(
          tailX,
          tailY,
          point.x,
          point.y
        );
        gradient.addColorStop(0, "rgba(255, 52, 139, 0)");
        gradient.addColorStop(0.48, `rgba(255, 83, 157, ${0.18 * alpha})`);
        gradient.addColorStop(0.84, `rgba(255, 203, 231, ${0.62 * alpha})`);
        gradient.addColorStop(1, `rgba(255, 255, 255, ${0.9 * alpha})`);
        context.save();
        context.strokeStyle = gradient;
        context.lineCap = "round";
        context.lineWidth = source.kind === "blade"
          ? Math.max(1.2, point.scale * 2.3)
          : Math.max(0.8, point.scale * 1.35);
        context.beginPath();
        context.moveTo(point.x, point.y);
        let x = point.x;
        let y = point.y;
        for (let segment = 0; segment < segmentCount; segment += 1) {
          const angle = getPostReleaseFlowAngle((segment + 0.5) / segmentCount);
          x += Math.cos(angle) * segmentLength;
          y += Math.sin(angle) * segmentLength;
          context.lineTo(x, y);
        }
        context.stroke();
        context.restore();
      };

      const postReleaseEyeFlameLobes = [
        { length: 1, width: 1, offset: 0, phase: 0, alpha: 0.58 },
        { length: 0.72, width: 0.72, offset: -3.2, phase: 1.8, alpha: 0.42 },
        { length: 0.56, width: 0.58, offset: 3.5, phase: 3.6, alpha: 0.34 }
      ];

      const getPostReleaseEyeFlameTip = (source, point, speed, time, lobeIndex = 0) => {
        const glowScale = clamp(point.scale, 0.58, 1.35);
        const motionStretch = Math.min(22, speed * 0.16) + postReleaseFlowWhip * 12;
        const outerLength = (25 + motionStretch) * glowScale * 1.28;
        const phase = time * 2.15 + source.x * 31 + source.y * 17;
        const rootAngle = getPostReleaseFlowAngle(0.04) + source.angle * 0.025;
        const rawMiddleAngle = getPostReleaseFlowAngle(0.46) + source.angle * 0.018;
        const rawTipAngle = getPostReleaseFlowAngle(0.92) + source.angle * 0.012;
        const upwardAngle = -Math.PI / 2;
        const middleAngle = rawMiddleAngle
          + shortestAngleDelta(rawMiddleAngle, upwardAngle) * 0.13;
        const tipAngle = rawTipAngle
          + shortestAngleDelta(rawTipAngle, upwardAngle) * 0.28;
        const rootX = Math.cos(rootAngle);
        const rootY = Math.sin(rootAngle);
        const middleX = Math.cos(middleAngle);
        const middleY = Math.sin(middleAngle);
        const tipX = Math.cos(tipAngle);
        const tipY = Math.sin(tipAngle);
        const tipNormalX = -tipY;
        const tipNormalY = tipX;
        const lobe = postReleaseEyeFlameLobes[
          clamp(Math.round(lobeIndex), 0, postReleaseEyeFlameLobes.length - 1)
        ];
        const flutter = Math.sin(phase * 1.7 + lobe.phase)
          * (2.4 + lobe.length * 2.1)
          * glowScale;
        const length = outerLength
          * lobe.length
          * (0.92 + Math.sin(phase + lobe.phase) * 0.08);
        const sideOffset = (lobe.offset + flutter * 0.28) * glowScale;
        const x = point.x
          + rootX * length * 0.2
          + middleX * length * 0.34
          + tipX * length * 0.46
          + tipNormalX * (sideOffset + flutter);
        const y = point.y
          + rootY * length * 0.2
          + middleY * length * 0.34
          + tipY * length * 0.46
          + tipNormalY * (sideOffset + flutter);
        return {
          x,
          y,
          angle: Math.atan2(y - point.y, x - point.x),
          scale: glowScale
        };
      };

      const drawPostReleaseEyeFlame = (context, source, point, speed, time, alpha) => {
        const glowScale = clamp(point.scale, 0.58, 1.35);
        const motionStretch = Math.min(22, speed * 0.16) + postReleaseFlowWhip * 12;
        const baseLength = (25 + motionStretch) * glowScale;
        const outerLength = baseLength * 1.28;
        const phase = time * 2.15 + source.x * 31 + source.y * 17;
        const rootAngle = getPostReleaseFlowAngle(0.04) + source.angle * 0.025;
        const rawMiddleAngle = getPostReleaseFlowAngle(0.46) + source.angle * 0.018;
        const rawTipAngle = getPostReleaseFlowAngle(0.92) + source.angle * 0.012;
        const upwardAngle = -Math.PI / 2;
        const middleAngle = rawMiddleAngle
          + shortestAngleDelta(rawMiddleAngle, upwardAngle) * 0.13;
        const tipAngle = rawTipAngle
          + shortestAngleDelta(rawTipAngle, upwardAngle) * 0.28;
        const rootX = Math.cos(rootAngle);
        const rootY = Math.sin(rootAngle);
        const middleX = Math.cos(middleAngle);
        const middleY = Math.sin(middleAngle);
        const tipX = Math.cos(tipAngle);
        const tipY = Math.sin(tipAngle);
        const rootNormalX = -rootY;
        const rootNormalY = rootX;
        const middleNormalX = -middleY;
        const middleNormalY = middleX;
        const tipNormalX = -tipY;
        const tipNormalY = tipX;
        context.save();
        context.lineCap = "round";
        context.lineJoin = "round";
        for (const lobe of postReleaseEyeFlameLobes) {
          const flutter = Math.sin(phase * 1.7 + lobe.phase) * (2.4 + lobe.length * 2.1) * glowScale;
          const length = outerLength * lobe.length * (0.92 + Math.sin(phase + lobe.phase) * 0.08);
          const width = (3.7 + Math.min(2.8, speed * 0.024)) * glowScale * lobe.width;
          const sideOffset = (lobe.offset + flutter * 0.28) * glowScale;
          const tailX = point.x
            + rootX * length * 0.2
            + middleX * length * 0.34
            + tipX * length * 0.46
            + tipNormalX * (sideOffset + flutter);
          const tailY = point.y
            + rootY * length * 0.2
            + middleY * length * 0.34
            + tipY * length * 0.46
            + tipNormalY * (sideOffset + flutter);
          const gradient = context.createLinearGradient(tailX, tailY, point.x, point.y);
          gradient.addColorStop(0, "rgba(255, 33, 120, 0)");
          gradient.addColorStop(0.28, `rgba(255, 38, 125, ${alpha * lobe.alpha * 0.42})`);
          gradient.addColorStop(0.68, `rgba(255, 91, 158, ${alpha * lobe.alpha * 0.9})`);
          gradient.addColorStop(1, `rgba(255, 241, 250, ${alpha * lobe.alpha})`);

          context.fillStyle = gradient;
          context.shadowColor = `rgba(255, 35, 124, ${alpha * 0.56})`;
          context.shadowBlur = 10 * glowScale;
          context.beginPath();
          context.moveTo(
            point.x + rootNormalX * width,
            point.y + rootNormalY * width
          );
          context.bezierCurveTo(
            point.x + rootX * length * 0.24 + rootNormalX * (width * 1.5 + sideOffset * 0.2),
            point.y + rootY * length * 0.24 + rootNormalY * (width * 1.5 + sideOffset * 0.2),
            point.x
              + rootX * length * 0.2
              + middleX * length * 0.46
              + middleNormalX * (width * 0.44 + sideOffset),
            point.y
              + rootY * length * 0.2
              + middleY * length * 0.46
              + middleNormalY * (width * 0.44 + sideOffset),
            tailX,
            tailY
          );
          context.bezierCurveTo(
            point.x
              + rootX * length * 0.18
              + middleX * length * 0.42
              + middleNormalX * (-width * 0.42 + sideOffset),
            point.y
              + rootY * length * 0.18
              + middleY * length * 0.42
              + middleNormalY * (-width * 0.42 + sideOffset),
            point.x + rootX * length * 0.18 - rootNormalX * width,
            point.y + rootY * length * 0.18 - rootNormalY * width,
            point.x - rootNormalX * width * 0.72,
            point.y - rootNormalY * width * 0.72
          );
          context.closePath();
          context.fill();
        }

        const coreLength = baseLength * 0.82;
        const coreTailX = point.x
          + rootX * coreLength * 0.22
          + middleX * coreLength * 0.34
          + tipX * coreLength * 0.44;
        const coreTailY = point.y
          + rootY * coreLength * 0.22
          + middleY * coreLength * 0.34
          + tipY * coreLength * 0.44
          + tipNormalY * Math.sin(phase * 1.6) * 2.6 * glowScale;
        const coreGradient = context.createLinearGradient(coreTailX, coreTailY, point.x, point.y);
        coreGradient.addColorStop(0, "rgba(255, 80, 151, 0)");
        coreGradient.addColorStop(0.58, `rgba(255, 119, 180, ${alpha * 0.48})`);
        coreGradient.addColorStop(1, `rgba(255, 255, 255, ${alpha * 0.92})`);
        context.shadowBlur = 7 * glowScale;
        context.strokeStyle = coreGradient;
        context.lineWidth = Math.max(0.8, 1.45 * glowScale);
        context.beginPath();
        context.moveTo(coreTailX, coreTailY);
        context.bezierCurveTo(
          point.x
            + rootX * coreLength * 0.18
            + middleX * coreLength * 0.5
            + middleNormalX * Math.sin(phase) * 2.4 * glowScale,
          point.y
            + rootY * coreLength * 0.18
            + middleY * coreLength * 0.5
            + middleNormalY * Math.sin(phase) * 2.4 * glowScale,
          point.x + rootX * coreLength * 0.2,
          point.y + rootY * coreLength * 0.2,
          point.x,
          point.y
        );
        context.stroke();
        context.restore();
      };

      const drawPostReleaseHighlights = (context, timestamp, intro) => {
        const time = timestamp / 1000;
        const speed = Math.abs(postReleaseVelocityX);
        context.save();
        context.globalCompositeOperation = "lighter";
        for (let index = 0; index < postReleaseSources.length; index += 1) {
          const source = postReleaseSources[index];
          const point = mapPostReleaseSource(source);
          if (
            point.x < -90
            || point.x > postReleaseCanvasWidth + 90
            || point.y < -90
            || point.y > postReleaseCanvasHeight + 90
          ) continue;
          const pulse = 0.88 + Math.sin(time * (3.4 + index * 0.28) + index * 1.7) * 0.12;
          const movementLift = clamp(speed / 120, 0, 1) * 0.24 + postReleaseFlowWhip * 0.12;
          const alpha = intro * source.strength * (pulse + movementLift);
          if (source.kind === "eye") {
            const glowScale = clamp(point.scale, 0.58, 1.35);
            const firePulse = 0.92
              + Math.sin(time * 4.6 + index * 1.3) * 0.13
              + Math.sin(time * 8.7 + index * 0.8) * 0.05;
            const fireRise = (1 + Math.sin(time * 3.8 + index * 1.7)) * 1.35 * glowScale;
            drawPostReleaseEyeFlame(
              context,
              source,
              point,
              speed,
              time,
              alpha * 0.94
            );
            drawPostReleaseBloom(
              context,
              point.x,
              point.y,
              23 * glowScale * firePulse,
              16 * glowScale * firePulse,
              source.angle,
              alpha * 0.62
            );
            drawPostReleaseBloom(
              context,
              point.x - 0.6 * glowScale,
              point.y - 1.8 * glowScale - fireRise * 0.28,
              5.5 * glowScale * firePulse,
              9.6 * glowScale * firePulse,
              source.angle,
              alpha
            );
            context.save();
            context.translate(point.x, point.y);
            context.rotate(source.angle);
            const tongueHeight = (10.5 + fireRise * 0.72) * glowScale * firePulse;
            const tongueGradient = context.createLinearGradient(0, 4 * glowScale, 0, -tongueHeight);
            tongueGradient.addColorStop(0, `rgba(255, 249, 253, ${0.98 * alpha})`);
            tongueGradient.addColorStop(0.34, `rgba(255, 126, 179, ${0.9 * alpha})`);
            tongueGradient.addColorStop(0.72, `rgba(255, 43, 128, ${0.62 * alpha})`);
            tongueGradient.addColorStop(1, "rgba(255, 35, 124, 0)");
            context.fillStyle = tongueGradient;
            context.shadowColor = `rgba(255, 47, 132, ${0.76 * alpha})`;
            context.shadowBlur = 7.5 * glowScale;
            context.beginPath();
            context.moveTo(-3.15 * glowScale, 3.2 * glowScale);
            context.bezierCurveTo(
              -4.5 * glowScale,
              -1.4 * glowScale,
              -2.2 * glowScale,
              -tongueHeight * 0.72,
              0.25 * glowScale,
              -tongueHeight
            );
            context.bezierCurveTo(
              2.8 * glowScale,
              -tongueHeight * 0.66,
              4.4 * glowScale,
              -1.1 * glowScale,
              3 * glowScale,
              3.2 * glowScale
            );
            context.closePath();
            context.fill();
            context.shadowBlur = 4 * glowScale;
            context.fillStyle = `rgba(255, 255, 255, ${0.96 * alpha})`;
            context.beginPath();
            context.ellipse(
              -0.7 * glowScale,
              -2.5 * glowScale - fireRise * 0.22,
              1.7 * glowScale * firePulse,
              3.1 * glowScale * firePulse,
              0,
              0,
              fullTurn
            );
            context.fill();
            context.restore();
          } else {
            const glowScale = clamp(point.scale, 0.62, 1.4);
            drawPostReleaseBloom(
              context,
              point.x,
              point.y,
              31 * glowScale,
              10.5 * glowScale,
              source.angle,
              alpha * 0.58
            );
            context.save();
            context.translate(point.x, point.y);
            context.rotate(source.angle);
            context.shadowColor = `rgba(255, 54, 145, ${0.72 * alpha})`;
            context.shadowBlur = 12 * glowScale;
            const bladeGradient = context.createLinearGradient(-38 * glowScale, 0, 42 * glowScale, 0);
            bladeGradient.addColorStop(0, "rgba(255, 76, 158, 0)");
            bladeGradient.addColorStop(0.3, `rgba(255, 72, 153, ${0.36 * alpha})`);
            bladeGradient.addColorStop(0.7, `rgba(255, 216, 238, ${0.9 * alpha})`);
            bladeGradient.addColorStop(1, "rgba(255, 255, 255, 0)");
            context.strokeStyle = bladeGradient;
            context.lineCap = "round";
            context.lineWidth = Math.max(1.6, 4.2 * glowScale);
            context.beginPath();
            context.moveTo(-38 * glowScale, 0);
            context.quadraticCurveTo(0, -2.2 * glowScale, 42 * glowScale, 0.7 * glowScale);
            context.stroke();
            context.shadowBlur = 5 * glowScale;
            context.strokeStyle = `rgba(255, 249, 253, ${0.92 * alpha})`;
            context.lineWidth = Math.max(0.65, 1.05 * glowScale);
            context.beginPath();
            context.moveTo(-8 * glowScale, -0.2 * glowScale);
            context.quadraticCurveTo(10 * glowScale, -1.1 * glowScale, 31 * glowScale, 0.2 * glowScale);
            context.stroke();
            context.strokeStyle = `rgba(255, 174, 211, ${0.7 * alpha})`;
            context.lineWidth = Math.max(0.55, 0.82 * glowScale);
            context.beginPath();
            context.moveTo(18 * glowScale, -6 * glowScale);
            context.lineTo(18 * glowScale, 6 * glowScale);
            context.stroke();
            context.restore();
            drawPostReleaseTrail(context, source, point, speed, alpha * 0.92);
          }
        }
        context.restore();
      };

      const spawnPostReleaseParticle = (source, point, speed, ambient = false, time = 0) => {
        if (postReleaseParticles.length >= (postReleaseCanvasWidth < 640 ? 136 : 224)) return;
        const randomA = nextPostReleaseRandom();
        const randomB = nextPostReleaseRandom();
        const randomC = nextPostReleaseRandom();
        const power = ambient
          ? 48 + randomB * 46
          : 76 + Math.min(180, speed * 0.82) + randomB * 62;
        const flowOffset = (randomC - 0.5) * (ambient ? 0.2 : 0.14);
        let launchAngle = getPostReleaseFlowAngle(0.025 + randomA * 0.045) + flowOffset;
        const launchPower = power * (0.9 + randomA * 0.3);
        let x = point.x + (randomA - 0.5) * (source.kind === "blade" ? 9 : 4);
        let y = point.y + (randomB - 0.5) * (source.kind === "blade" ? 6 : 4);
        if (source.kind === "eye") {
          const lobeIndex = randomA < 0.58 ? 0 : randomA < 0.84 ? 1 : 2;
          const flameTip = getPostReleaseEyeFlameTip(source, point, speed, time, lobeIndex);
          const tipFlowAngle = getPostReleaseFlowAngle(0.82 + randomB * 0.16);
          launchAngle = flameTip.angle
            + shortestAngleDelta(flameTip.angle, tipFlowAngle) * 0.68
            + flowOffset;
          const normalX = -Math.sin(launchAngle);
          const normalY = Math.cos(launchAngle);
          const tipSpread = (randomC - 0.5) * 2.8 * flameTip.scale;
          x = flameTip.x + normalX * tipSpread;
          y = flameTip.y + normalY * tipSpread;
        }
        const velocityX = Math.cos(launchAngle) * launchPower;
        const velocityY = Math.sin(launchAngle) * launchPower;
        const history = 0.016 + randomA * 0.022;
        postReleaseParticles.push({
          x,
          y,
          previousX: x - velocityX * history,
          previousY: y - velocityY * history,
          velocityX,
          velocityY,
          age: 0,
          life: ambient ? 1.08 + randomC * 0.82 : 0.86 + randomC * 0.9,
          size: (source.kind === "blade" ? 1.18 : 1.02) + randomB * 1.72,
          hue: source.kind === "blade" ? 338 + randomA * 12 : 326 + randomA * 18,
          curl: 12 + randomA * 22,
          lift: 26 + randomB * 24,
          phase: randomC * fullTurn,
          flowOffset,
          flowLag: source.kind === "eye" ? 0.72 + randomA * 0.16 : randomA * 0.075,
          flowCoupling: 0.84 + randomB * 0.3,
          sourceKind: source.kind,
          ambient
        });
      };

      const updatePostReleaseParticles = (context, frameSeconds, speed, intro, timestamp) => {
        const time = timestamp / 1000;
        if (precisePointer && (speed > 0.7 || postReleaseFlowWhip > 0.025)) {
          postReleaseEmissionBudget += frameSeconds * (
            34
            + Math.min(70, speed * 0.52)
            + postReleaseFlowWhip * 48
          );
        }
        postReleaseAmbientBudget += frameSeconds * (postReleaseCanvasWidth < 640 ? 26 : 42) * intro;
        while (postReleaseEmissionBudget >= 1) {
          postReleaseEmissionBudget -= 1;
          const source = postReleaseSources[
            postReleaseSourceOrder[postReleaseSourceIndex % postReleaseSourceOrder.length]
          ];
          postReleaseSourceIndex += 1;
          spawnPostReleaseParticle(source, mapPostReleaseSource(source), speed, false, time);
        }
        while (postReleaseAmbientBudget >= 1) {
          postReleaseAmbientBudget -= 1;
          const source = postReleaseSources[
            postReleaseSourceOrder[postReleaseSourceIndex % postReleaseSourceOrder.length]
          ];
          postReleaseSourceIndex += 1;
          spawnPostReleaseParticle(source, mapPostReleaseSource(source), speed, true, time);
        }

        context.save();
        context.globalCompositeOperation = "lighter";
        for (let index = postReleaseParticles.length - 1; index >= 0; index -= 1) {
          const particle = postReleaseParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life) {
            postReleaseParticles[index] = postReleaseParticles[postReleaseParticles.length - 1];
            postReleaseParticles.pop();
            continue;
          }
          const eyeParticle = particle.sourceKind === "eye";
          particle.previousX = particle.x;
          particle.previousY = particle.y;
          const drag = Math.exp(-(particle.ambient ? 0.68 : 0.92) * frameSeconds);
          particle.velocityX *= drag;
          particle.velocityY *= drag;
          particle.velocityX += Math.cos(particle.phase + particle.age * 4.2)
            * particle.curl * frameSeconds * 0.24;
          particle.velocityY += Math.sin(particle.phase + particle.age * 4.8)
            * particle.curl * frameSeconds * 0.62;
          particle.velocityY -= particle.lift
            * frameSeconds
            * (0.82 + Math.min(0.9, particle.age * 0.72))
            * (eyeParticle ? 1.14 : 1);
          const lifeProgress = particle.age / particle.life;
          const currentSpeed = Math.max(1, Math.hypot(particle.velocityX, particle.velocityY));
          const currentAngle = Math.atan2(particle.velocityY, particle.velocityX);
          const guideUnit = clamp(lifeProgress * 0.88 + particle.flowLag, 0, 1);
          const baseTargetAngle = getPostReleaseFlowAngle(guideUnit)
            + particle.flowOffset * (1 - guideUnit * 0.48);
          const upwardArc = eyeParticle
            ? smoothstep(clamp((lifeProgress - 0.06) / 0.82, 0, 1)) * 0.4
            : 0;
          const targetAngle = baseTargetAngle
            + shortestAngleDelta(baseTargetAngle, -Math.PI / 2) * upwardArc;
          const turnRate = (particle.ambient ? 3.8 : 5.15)
            * particle.flowCoupling
            * (1 + postReleaseFlowWhip * 0.82)
            * (1 - lifeProgress * 0.2);
          const turn = clamp(
            shortestAngleDelta(currentAngle, targetAngle),
            -turnRate * frameSeconds,
            turnRate * frameSeconds
          );
          const steeredAngle = currentAngle + turn;
          particle.velocityX = Math.cos(steeredAngle) * currentSpeed;
          particle.velocityY = Math.sin(steeredAngle) * currentSpeed;
          particle.x += particle.velocityX * frameSeconds;
          particle.y += particle.velocityY * frameSeconds;
          const fadeIn = smoothstep(clamp(particle.age / (eyeParticle ? 0.045 : 0.09), 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeProgress - 0.58) / 0.42, 0, 1));
          const flicker = 0.76 + Math.sin(particle.phase + particle.age * 9.4) * 0.24;
          const alpha = fadeIn * fadeOut * flicker * intro;
          const trailLength = clamp(Math.hypot(particle.velocityX, particle.velocityY) * 0.058, 5, 23);
          const magnitude = Math.max(1, Math.hypot(particle.velocityX, particle.velocityY));
          const tailX = particle.x - particle.velocityX / magnitude * trailLength;
          const tailY = particle.y - particle.velocityY / magnitude * trailLength;
          const gradient = context.createLinearGradient(tailX, tailY, particle.x, particle.y);
          gradient.addColorStop(0, `hsla(${particle.hue}, 100%, 68%, 0)`);
          gradient.addColorStop(0.58, `hsla(${particle.hue}, 100%, 72%, ${0.48 * alpha})`);
          gradient.addColorStop(1, `rgba(255, 246, 252, ${0.96 * alpha})`);
          context.strokeStyle = gradient;
          context.lineWidth = Math.max(0.62, particle.size * (1.08 - lifeProgress * 0.42));
          context.lineCap = "round";
          context.beginPath();
          context.moveTo(tailX, tailY);
          context.lineTo(particle.x, particle.y);
          context.stroke();
          context.fillStyle = `rgba(255, 223, 239, ${0.82 * alpha})`;
          context.beginPath();
          context.arc(particle.x, particle.y, Math.max(0.45, particle.size * 0.46), 0, fullTurn);
          context.fill();
        }
        context.restore();
      };

      const updatePostReleaseDataStream = (timestamp, frameSeconds, intro) => {
        if (!postReleaseDataInitialized) {
          postReleaseDataOpacity = 0;
          postReleaseDataPressure = 0;
          return;
        }
        let activeDirection = postReleaseDirection || 1;
        let journeyEnergy = 0;
        if (postReleaseJourney) {
          activeDirection = postReleaseJourney.direction;
          const progress = clamp(
            (timestamp - postReleaseJourney.startedAt) / postReleaseJourney.duration,
            0,
            1
          );
          const eased = smoothstep(smoothstep(progress));
          postReleaseDataPosition = postReleaseJourney.startPosition
            + (postReleaseJourney.endPosition - postReleaseJourney.startPosition) * eased;
          journeyEnergy = Math.pow(Math.sin(progress * Math.PI), 0.72);
          if (progress >= 0.999) {
            postReleaseDataPosition = postReleaseJourney.endPosition;
            postReleaseJourney = null;
          }
        }
        const moving = Boolean(postReleaseJourney);
        const motionEnergy = clamp(
          Math.abs(postReleaseVelocityX) / 150 + postReleaseFlowWhip * 0.52,
          0,
          1
        );
        const pressureTarget = Math.max(
          journeyEnergy,
          motionEnergy * 0.58,
          postReleaseFlowWhip * 0.68
        );
        postReleaseDataPressure += (pressureTarget - postReleaseDataPressure)
          * (1 - Math.exp(-frameSeconds * (pressureTarget > postReleaseDataPressure ? 10.5 : 3.8)));
        const targetOpacity = 0.5 + motionEnergy * 0.16 + postReleaseDataPressure * 0.18;
        postReleaseDataOpacity += (targetOpacity - postReleaseDataOpacity)
          * (1 - Math.exp(-frameSeconds * (moving ? 7.2 : 3.6)));
        postReleaseDataPhase += frameSeconds
          * (0.72 + motionEnergy * 1.85 + postReleaseDataPressure * 1.35)
          * (activeDirection > 0 ? -1 : 1);
        if (Math.abs(postReleaseDataPhase) > 2048) postReleaseDataPhase %= 2048;
      };

      const drawTitleLiquidRefraction = (timestamp, intro) => {
        if (!titleDataCanvas || !titleDataContext) return;
        if (!postReleaseDataInitialized || postReleaseDataOpacity * intro <= 0.003) {
          if (titleDataCanvas.style.opacity !== "0") clearTitleDataCanvas();
          return;
        }
        if (titleDataCanvasWidth <= 1 || titleDataCanvasHeight <= 1) {
          resizeTitleDataCanvas();
        }
        if (titleDataCanvasWidth <= 1 || titleDataCanvasHeight <= 1) return;

        titleDataContext.setTransform(1, 0, 0, 1, 0, 0);
        titleDataContext.clearRect(0, 0, titleDataCanvas.width, titleDataCanvas.height);
        titleDataContext.setTransform(titleDataPixelRatio, 0, 0, titleDataPixelRatio, 0, 0);
        titleDataContext.save();
        titleDataContext.globalCompositeOperation = "source-over";

        const width = titleDataCanvasWidth;
        const height = titleDataCanvasHeight;
        const direction = postReleaseJourney?.direction || postReleaseDirection || 1;
        const flowDirection = direction > 0 ? -1 : 1;
        const position = postReleaseDataPosition;
        const phase = postReleaseDataPhase;
        const pressure = clamp(postReleaseDataPressure, 0, 1);
        const time = timestamp / 1000;
        const frontX = width * position / 100;
        const bandWidth = width * (0.105 + pressure * 0.065);
        const liquidOpacity = postReleaseDataOpacity * intro;
        const titleRect = titleDataCanvas.getBoundingClientRect();
        const gateRect = gate.getBoundingClientRect();
        const canvasLeftInGate = titleRect.left - gateRect.left;
        const canvasTopInGate = titleRect.top - gateRect.top;

        const roseBase = titleDataContext.createLinearGradient(0, height * 0.14, 0, height * 0.9);
        roseBase.addColorStop(0, "rgba(255, 218, 231, 0.56)");
        roseBase.addColorStop(0.26, "rgba(255, 98, 144, 0.48)");
        roseBase.addColorStop(0.68, "rgba(213, 28, 83, 0.42)");
        roseBase.addColorStop(1, "rgba(79, 18, 66, 0.5)");
        titleDataContext.globalAlpha = 0.52 + pressure * 0.1;
        titleDataContext.fillStyle = roseBase;
        titleDataContext.fillRect(0, 0, width, height);

        if (
          fightArtwork
          && fightArtwork.complete
          && fightArtwork.naturalWidth > 1
          && postReleaseLayout.imageScale > 0
        ) {
          const imageScale = postReleaseLayout.imageScale;
          const stripHeight = width < 520 ? 2.7 : 3.6;
          const stripOverlap = width < 520 ? 1.7 : 2.2;
          const sourceWidth = Math.min(fightImageWidth, width / imageScale);
          const alignedSourceHeight = Math.min(fightImageHeight, height / imageScale);
          const sourceHeight = Math.max(1, (stripHeight + stripOverlap) / imageScale);
          const maxSourceX = Math.max(0, fightImageWidth - sourceWidth);
          const maxAlignedSourceY = Math.max(0, fightImageHeight - alignedSourceHeight);
          const maxSourceY = Math.max(0, fightImageHeight - sourceHeight);
          const oppositeShift = postReleaseX * 2.15;
          const alignedSourceX = clamp(
            (
              canvasLeftInGate
              - postReleaseLayout.imageLeft
              - postReleaseX
              + oppositeShift
            ) / imageScale,
            0,
            maxSourceX
          );
          const alignedSourceY = clamp(
            (canvasTopInGate - postReleaseLayout.imageTop - postReleaseY) / imageScale,
            0,
            maxAlignedSourceY
          );
          titleDataContext.save();
          titleDataContext.globalAlpha = 0.17 + pressure * 0.055;
          titleDataContext.filter = `saturate(${(1.12 + pressure * 0.12).toFixed(3)}) contrast(1.05) brightness(1.06)`;
          titleDataContext.drawImage(
            fightArtwork,
            alignedSourceX,
            alignedSourceY,
            sourceWidth,
            alignedSourceHeight,
            0,
            0,
            width,
            height
          );
          titleDataContext.restore();

          titleDataContext.save();
          titleDataContext.globalCompositeOperation = "screen";
          titleDataContext.globalAlpha = 0.12 + pressure * 0.11;
          titleDataContext.filter = `blur(0.24px) saturate(${(1.22 + pressure * 0.2).toFixed(3)}) contrast(1.07) brightness(1.08)`;
          for (let y = -stripHeight; y < height + stripHeight; y += stripHeight) {
            const normalizedY = y / Math.max(1, height);
            const rowWave = Math.sin(normalizedY * 9.4 + phase * 2.15) * (1.8 + pressure * 3.6)
              + Math.sin(normalizedY * 17.2 - phase * 1.36) * (0.75 + pressure * 1.35);
            const pressureBend = Math.sin((normalizedY - 0.5) * Math.PI)
              * flowDirection
              * pressure
              * 4.8;
            const sourceX = clamp(
              (
                canvasLeftInGate
                - postReleaseLayout.imageLeft
                - postReleaseX
                + oppositeShift
                + rowWave
                + pressureBend
              ) / imageScale,
              0,
              maxSourceX
            );
            const sourceY = clamp(
              (canvasTopInGate + y - postReleaseLayout.imageTop - postReleaseY) / imageScale,
              0,
              maxSourceY
            );
            titleDataContext.drawImage(
              fightArtwork,
              sourceX,
              sourceY,
              sourceWidth,
              sourceHeight,
              0,
              y,
              width,
              stripHeight + stripOverlap
            );
          }
          titleDataContext.restore();
        }

        titleDataContext.save();
        titleDataContext.globalCompositeOperation = "screen";
        titleDataContext.translate(frontX, height * 0.5);
        titleDataContext.rotate(flowDirection * 0.105);
        const pressureGradient = titleDataContext.createLinearGradient(-bandWidth, 0, bandWidth, 0);
        pressureGradient.addColorStop(0, "rgba(255, 76, 143, 0)");
        pressureGradient.addColorStop(0.28, `rgba(255, 81, 145, ${0.12 + pressure * 0.18})`);
        pressureGradient.addColorStop(0.48, `rgba(255, 235, 246, ${0.2 + pressure * 0.52})`);
        pressureGradient.addColorStop(0.56, `rgba(179, 213, 255, ${0.08 + pressure * 0.28})`);
        pressureGradient.addColorStop(1, "rgba(128, 174, 255, 0)");
        titleDataContext.fillStyle = pressureGradient;
        titleDataContext.shadowColor = "rgba(255, 89, 151, 0.8)";
        titleDataContext.shadowBlur = 8 + pressure * 18;
        titleDataContext.fillRect(-bandWidth, -height, bandWidth * 2, height * 2);
        titleDataContext.restore();

        const veinCount = width < 520 ? 4 : 6;
        titleDataContext.save();
        titleDataContext.globalCompositeOperation = "screen";
        titleDataContext.lineCap = "round";
        titleDataContext.lineJoin = "round";
        for (let vein = 0; vein < veinCount; vein += 1) {
          const points = [];
          const pointCount = width < 520 ? 8 : 11;
          const baseY = height * (0.28 + vein / Math.max(1, veinCount - 1) * 0.44);
          const seed = randomSeed(vein * 19.37 + 4.1);
          for (let pointIndex = 0; pointIndex <= pointCount; pointIndex += 1) {
            const unit = pointIndex / pointCount;
            const x = -width * 0.04 + unit * width * 1.08;
            const frontInfluence = Math.exp(-Math.pow((x - frontX) / Math.max(18, bandWidth), 2));
            const wave = Math.sin(
              unit * fullTurn * (1.08 + seed * 0.32)
              + phase * (1.2 + seed * 0.48)
              + vein * 1.27
            ) * (2.3 + seed * 2.4 + pressure * 2.2);
            const secondaryWave = Math.sin(
              unit * fullTurn * 2.4
              - phase * 0.68
              + seed * 7.2
            ) * (0.6 + pressure * 0.8);
            points.push({
              x,
              y: baseY
                + wave
                + secondaryWave
                - frontInfluence * pressure * height * (0.012 + seed * 0.018)
            });
          }
          const veinPath = createSmoothCanvasPath(points);
          const blueVein = vein % 3 === 1;
          titleDataContext.globalAlpha = (0.09 + pressure * 0.14) * (0.72 + seed * 0.28);
          titleDataContext.strokeStyle = blueVein
            ? "rgba(151, 201, 255, 0.86)"
            : "rgba(255, 87, 148, 0.88)";
          titleDataContext.lineWidth = 2 + pressure * 1.4;
          titleDataContext.shadowColor = titleDataContext.strokeStyle;
          titleDataContext.shadowBlur = 7 + pressure * 11;
          titleDataContext.stroke(veinPath);
          titleDataContext.globalAlpha = 0.2 + pressure * 0.26;
          titleDataContext.strokeStyle = blueVein
            ? "rgba(226, 243, 255, 0.94)"
            : "rgba(255, 238, 246, 0.96)";
          titleDataContext.lineWidth = 0.58 + pressure * 0.32;
          titleDataContext.shadowBlur = 2 + pressure * 4;
          titleDataContext.stroke(veinPath);
        }
        titleDataContext.restore();

        titleDataContext.setTransform(1, 0, 0, 1, 0, 0);
        titleDataContext.globalAlpha = 1;
        titleDataContext.globalCompositeOperation = "destination-in";
        titleDataContext.drawImage(titleDataMaskCanvas, 0, 0);
        titleDataContext.globalCompositeOperation = "source-over";
        titleDataContext.setTransform(titleDataPixelRatio, 0, 0, titleDataPixelRatio, 0, 0);

        const edgeEnergy = clamp(pressure * 0.86 + postReleaseFlowWhip * 0.42, 0, 1);
        if (edgeEnergy > 0.012) {
          titleDataContext.save();
          titleDataContext.globalCompositeOperation = "screen";
          titleDataContext.lineCap = "round";
          for (let thread = 0; thread < 4; thread += 1) {
            const seed = randomSeed(thread * 31.41 + 9.7);
            const threadY = height * (0.32 + thread * 0.12)
              + Math.sin(time * (1.3 + seed * 0.7) + thread * 1.8) * (2 + pressure * 4);
            const length = width * (0.065 + seed * 0.045) * (0.72 + edgeEnergy * 0.48);
            const startX = frontX - flowDirection * bandWidth * (0.04 + thread * 0.025);
            const endX = startX + flowDirection * length;
            const lift = height * (0.035 + seed * 0.035) * (0.7 + edgeEnergy * 0.6);
            const controlA = {
              x: startX + flowDirection * length * 0.34,
              y: threadY - lift * (0.4 + seed * 0.45)
            };
            const controlB = {
              x: startX + flowDirection * length * 0.72,
              y: threadY - lift
            };
            const endY = threadY - lift * (0.62 + seed * 0.42);
            const threadPath = new Path2D();
            threadPath.moveTo(startX, threadY);
            threadPath.bezierCurveTo(
              controlA.x,
              controlA.y,
              controlB.x,
              controlB.y,
              endX,
              endY
            );
            const threadAlpha = edgeEnergy * (0.16 + seed * 0.18) * intro;
            titleDataContext.globalAlpha = threadAlpha;
            titleDataContext.strokeStyle = thread % 2 === 0
              ? "rgba(255, 71, 143, 0.9)"
              : "rgba(176, 213, 255, 0.86)";
            titleDataContext.lineWidth = 1.9 + seed * 1.1;
            titleDataContext.shadowColor = titleDataContext.strokeStyle;
            titleDataContext.shadowBlur = 7 + edgeEnergy * 10;
            titleDataContext.stroke(threadPath);
            titleDataContext.globalAlpha = threadAlpha * 1.7;
            titleDataContext.strokeStyle = "rgba(255, 244, 249, 0.92)";
            titleDataContext.lineWidth = 0.46 + seed * 0.34;
            titleDataContext.shadowBlur = 2 + edgeEnergy * 4;
            titleDataContext.stroke(threadPath);

            for (let spark = 0; spark < 3; spark += 1) {
              const sparkProgress = ((time * (0.34 + seed * 0.12) + spark / 3 + seed) % 1 + 1) % 1;
              const sparkPoint = pointOnCubicCurve(
                { x: startX, y: threadY },
                controlA,
                controlB,
                { x: endX, y: endY },
                sparkProgress
              );
              titleDataContext.globalAlpha = threadAlpha * (1 - sparkProgress) * 1.8;
              titleDataContext.fillStyle = spark % 2 === 0 ? "#fff4f8" : "#c8e0ff";
              titleDataContext.beginPath();
              titleDataContext.arc(
                sparkPoint.x,
                sparkPoint.y,
                0.55 + edgeEnergy * 0.7,
                0,
                fullTurn
              );
              titleDataContext.fill();
            }
          }
          titleDataContext.restore();
        }

        titleDataContext.restore();
        titleDataCanvas.style.opacity = liquidOpacity.toFixed(3);
      };

      const drawPostReleaseTitleLens = (timestamp) => {
        if (!titleLensCanvas) return;
        const direction = postReleaseDirection > 0 ? -1 : 1;
        const parallax = postReleaseMaxX > 0
          ? clamp(postReleaseX / postReleaseMaxX, -1, 1)
          : 0;
        drawTitleLens(timestamp, {
          centerX: titleLensCanvas.clientWidth * 0.5,
          centerY: titleLensCanvas.clientHeight * 0.5,
          opacity: 1,
          strength: 0,
          gravity: 0,
          collapse: 0,
          crush: 0,
          shockStrength: 0,
          shockRadius: 0,
          shockWidth: 12,
          coreRadius: 1,
          lensRadius: 1,
          release: 0,
          dissolve: 0,
          sourceOpacity: 0,
          finalFlow: 1,
          liquidPhase: postReleaseDataPhase,
          liquidPressure: clamp(
            0.2 + postReleaseDataPressure * 0.92 + postReleaseFlowWhip * 0.24,
            0.2,
            1.3
          ),
          flowDirection: direction,
          flowFront: clamp(postReleaseDataPosition / 100, 0.06, 0.94),
          parallax,
          time: timestamp / 1000
        });
      };

      const drawPostRelease = (timestamp) => {
        postReleaseFrame = 0;
        if (disposed || !gate.isConnected) return;
        if (
          !postReleaseActive
          || pageMode !== "gate"
          || document.visibilityState !== "visible"
          || !postReleaseContext
        ) return;
        const motionPending = Math.abs(postReleaseTargetX - postReleaseX) > 0.03
          || Math.abs(postReleaseTargetY - postReleaseY) > 0.03
          || Boolean(postReleaseJourney)
          || postReleaseFlowWhip > 0.018;
        const minimumFrameInterval = motionPending ? 1000 / 60 : 1000 / 30;
        if (
          postReleaseLastTimestamp
          && timestamp - postReleaseLastTimestamp < minimumFrameInterval * 0.9
        ) {
          postReleaseFrame = window.requestAnimationFrame(drawPostRelease);
          return;
        }
        if (postReleaseCanvasWidth <= 1 || postReleaseCanvasHeight <= 1) resizePostReleaseCanvas();
        const frameSeconds = postReleaseLastTimestamp
          ? clamp((timestamp - postReleaseLastTimestamp) / 1000, 0.008, 0.045)
          : 1 / 60;
        postReleaseLastTimestamp = timestamp;
        const previousX = postReleaseX;
        const response = 1 - Math.exp(-frameSeconds * 3.35);
        postReleaseX += (postReleaseTargetX - postReleaseX) * response;
        postReleaseY += (postReleaseTargetY - postReleaseY) * (1 - Math.exp(-frameSeconds * 5.4));
        postReleaseVelocityX = (postReleaseX - previousX) / Math.max(0.001, frameSeconds);
        updatePostReleaseFlow(frameSeconds);
        const intro = reducedMotion
          ? 1
          : smoothstep(clamp((timestamp - postReleaseStartedAt) / 880, 0, 1));
        gate.style.setProperty("--kisara-post-parallax-x", `${postReleaseX.toFixed(3)}px`);
        gate.style.setProperty("--kisara-post-parallax-y", `${postReleaseY.toFixed(3)}px`);
        gate.style.setProperty("--kisara-post-release-opacity", intro.toFixed(3));
        updatePostReleaseDataStream(timestamp, frameSeconds, intro);
        drawPostReleaseTitleLens(timestamp);
        clearPostReleaseCanvas();
        drawPostReleaseHighlights(postReleaseContext, timestamp, intro);
        updatePostReleaseParticles(
          postReleaseContext,
          frameSeconds,
          Math.abs(postReleaseVelocityX),
          intro,
          timestamp
        );
        if (!reducedMotion) postReleaseFrame = window.requestAnimationFrame(drawPostRelease);
      };

      const startPostReleaseAnimation = () => {
        if (
          postReleaseFrame
          || !postReleaseActive
          || pageMode !== "gate"
          || document.visibilityState !== "visible"
          || !postReleaseContext
        ) return;
        postReleaseLastTimestamp = 0;
        if (reducedMotion) {
          drawPostRelease(performance.now());
          return;
        }
        postReleaseFrame = window.requestAnimationFrame(drawPostRelease);
      };

      const stopPostReleaseAnimation = (reset = false) => {
        if (postReleaseFrame) window.cancelAnimationFrame(postReleaseFrame);
        postReleaseFrame = 0;
        postReleaseLastTimestamp = 0;
        if (!reset) return;
        postReleaseX = 0;
        postReleaseY = 0;
        postReleaseTargetX = 0;
        postReleaseTargetY = 0;
        postReleaseVelocityX = 0;
        postReleasePointerX = null;
        postReleasePointerAccumulator = 0;
        postReleaseDirection = 1;
        postReleaseDirectionChangedAt = 0;
        postReleaseFlowAngles.fill(postReleaseInitialFlowAngle);
        postReleaseFlowAngularVelocities.fill(0);
        postReleaseFlowWhip = 0;
        postReleaseJourney = null;
        postReleaseDataInitialized = false;
        postReleaseDataPosition = 50;
        postReleaseDataOpacity = 0;
        postReleaseDataPhase = 0;
        postReleaseDataPressure = 0;
        postReleaseEmissionBudget = 0;
        postReleaseAmbientBudget = 0;
        postReleaseSourceIndex = 0;
        postReleaseParticleSerial = 0;
        postReleaseParticles.length = 0;
        gate.style.setProperty("--kisara-post-parallax-x", "0px");
        gate.style.setProperty("--kisara-post-parallax-y", "0px");
        gate.style.setProperty("--kisara-post-release-opacity", "0");
        clearTitleDataCanvas();
        titleLensRenderer?.clear();
        lastTitleLensPaintTimestamp = 0;
        gate.style.setProperty("--kisara-title-source-opacity", "1");
        clearPostReleaseCanvas();
      };

      const setPostReleaseActive = (active) => {
        if (postReleaseActive === active) return;
        postReleaseActive = active;
        gate.classList.toggle("is-post-release", active);
        if (!active) {
          setOrientationEnabled(false);
          updateMotionToggle();
          stopPostReleaseAnimation(true);
          return;
        }
        resizePostReleaseCanvas(true);
        clearTitleDataCanvas();
        postReleaseDataInitialized = true;
        postReleaseDataPosition = 50;
        postReleaseDataOpacity = 0;
        postReleaseDataPressure = 0;
        postReleaseStartedAt = performance.now();
        if (titleLensRenderer) gate.style.setProperty("--kisara-title-source-opacity", "0");
        updateMotionToggle();
        if (orientationSupported && !orientationPermissionRequired && !orientationUserDisabled) {
          setOrientationEnabled(true);
        }
        startPostReleaseAnimation();
      };

      const beginPostReleaseJourney = (direction, timestamp) => {
        if (!postReleaseActive || !precisePointer || reducedMotion || direction === 0) return;
        const destination = direction * postReleaseMaxX;
        if (
          direction === postReleaseDirection
          && Math.abs(postReleaseTargetX - destination) < 0.01
        ) return;
        if (
          direction !== postReleaseDirection
          && timestamp - postReleaseDirectionChangedAt < 110
        ) return;
        const directionChanged = direction !== postReleaseDirection;
        postReleaseDirection = direction;
        postReleaseDirectionChangedAt = timestamp;
        if (directionChanged) {
          const targetFlowAngle = Math.atan2(-0.42, -direction);
          const turnImpulse = shortestAngleDelta(postReleaseFlowAngles[0], targetFlowAngle);
          postReleaseFlowAngularVelocities[0] += clamp(turnImpulse * 0.58, -1.55, 1.55);
          postReleaseFlowWhip = 1;
          postReleaseEmissionBudget = Math.min(postReleaseEmissionBudget, 0.75);
        }
        postReleaseTargetX = destination;
        const startPosition = postReleaseDataInitialized
          ? postReleaseDataPosition
          : direction > 0
            ? 85
            : 15;
        const endPosition = direction > 0 ? 15 : 85;
        postReleaseDataInitialized = true;
        postReleaseDataPosition = startPosition;
        postReleaseDataPressure = Math.max(postReleaseDataPressure, 0.24);
        postReleaseJourney = {
          direction,
          startX: postReleaseX,
          endX: destination,
          startPosition,
          endPosition,
          startedAt: timestamp,
          duration: Math.max(880, 900 + Math.abs(endPosition - startPosition) * 5)
        };
        startPostReleaseAnimation();
      };

      const handlePostReleasePointer = (event) => {
        if (
          !postReleaseActive
          || pageMode !== "gate"
          || !precisePointer
          || reducedMotion
          || window.scrollY > 2
        ) return;
        const gateRect = gate.getBoundingClientRect();
        if (
          event.clientX < gateRect.left
          || event.clientX > gateRect.right
          || event.clientY < gateRect.top
          || event.clientY > gateRect.bottom
        ) return;
        postReleaseTargetY = clamp(
          ((event.clientY - gateRect.top) / Math.max(1, gateRect.height) - 0.5) * 2 * postReleaseMaxY,
          -postReleaseMaxY,
          postReleaseMaxY
        );
        if (postReleasePointerX === null) {
          postReleasePointerX = event.clientX;
          return;
        }
        const deltaX = event.clientX - postReleasePointerX;
        postReleasePointerX = event.clientX;
        if (Math.abs(deltaX) < 0.15) return;
        if (
          postReleasePointerAccumulator !== 0
          && Math.sign(postReleasePointerAccumulator) !== Math.sign(deltaX)
        ) postReleasePointerAccumulator *= 0.32;
        postReleasePointerAccumulator = clamp(postReleasePointerAccumulator + deltaX, -24, 24);
        if (Math.abs(postReleasePointerAccumulator) < 7) return;
        const direction = Math.sign(postReleasePointerAccumulator);
        postReleasePointerAccumulator = 0;
        beginPostReleaseJourney(direction, event.timeStamp || performance.now());
      };

      const fightSource = postReleaseCanvas?.dataset.fightSrc;
      if (fightSource) {
        const fightImage = new Image();
        fightImage.decoding = "async";
        fightImage.addEventListener("load", () => {
          fightArtwork = fightImage;
          fightImageWidth = Math.max(1, fightImage.naturalWidth || fightImageWidth);
          fightImageHeight = Math.max(1, fightImage.naturalHeight || fightImageHeight);
          refreshPostReleaseLayout();
          if (postReleaseActive) startPostReleaseAnimation();
        }, { once: true, signal });
        fightImage.src = fightSource;
      }

      const createSpaceLensRenderer = async () => {
        if (!spaceLensCanvas || reducedMotion) return null;
        const baseSource = spaceLensCanvas.dataset.baseSrc
          || spaceLensCanvas.dataset.preReleaseSrc
          || spaceLensCanvas.dataset.fightSrc;
        const preReleaseSource = spaceLensCanvas.dataset.preReleaseSrc
          || spaceLensCanvas.dataset.baseSrc
          || spaceLensCanvas.dataset.fightSrc;
        const fightSource = spaceLensCanvas.dataset.fightSrc
          || spaceLensCanvas.dataset.preReleaseSrc
          || spaceLensCanvas.dataset.baseSrc;
        if (!baseSource || !preReleaseSource || !fightSource) return null;

        const gl = spaceLensCanvas.getContext("webgl2", {
          alpha: true,
          antialias: false,
          depth: false,
          stencil: false,
          premultipliedAlpha: true,
          preserveDrawingBuffer: false,
          powerPreference: "high-performance"
        });
        if (!gl) return null;

        const vertexSource = `#version 300 es
          precision highp float;
          const vec2 POSITIONS[3] = vec2[3](
            vec2(-1.0, -1.0),
            vec2(3.0, -1.0),
            vec2(-1.0, 3.0)
          );
          out vec2 vUv;
          void main() {
            vec2 position = POSITIONS[gl_VertexID];
            vUv = position * 0.5 + 0.5;
            gl_Position = vec4(position, 0.0, 1.0);
          }
        `;
        const fragmentSource = `#version 300 es
          precision highp float;
          in vec2 vUv;
          out vec4 outputColor;

          uniform sampler2D uBaseTexture;
          uniform sampler2D uPreReleaseTexture;
          uniform sampler2D uFightTexture;
          uniform vec2 uResolution;
          uniform vec2 uBaseSize;
          uniform vec2 uPreReleaseSize;
          uniform vec2 uFightSize;
          uniform vec2 uCenter;
          uniform float uReveal;
          uniform float uOpacity;
          uniform float uGravity;
          uniform float uCollapse;
          uniform float uCrush;
          uniform float uShockStrength;
          uniform float uShockRadius;
          uniform float uShockWidth;
          uniform float uCoreRadius;
          uniform float uLensRadius;
          uniform float uReconstruction;
          uniform float uReconstructionOpacity;
          uniform float uTime;

          vec2 coverUv(vec2 uv, vec2 imageSize, float scale) {
            float viewportAspect = uResolution.x / max(1.0, uResolution.y);
            float imageAspect = imageSize.x / max(1.0, imageSize.y);
            vec2 mapped = uv;
            if (imageAspect > viewportAspect) {
              float visibleWidth = viewportAspect / imageAspect;
              mapped.x = (mapped.x - 0.5) * visibleWidth + 0.5;
            } else {
              float visibleHeight = imageAspect / viewportAspect;
              mapped.y = (mapped.y - 0.5) * visibleHeight + 0.5;
            }
            mapped = (mapped - 0.5) / scale + 0.5;
            return clamp(mapped, vec2(0.001), vec2(0.999));
          }

          vec3 adjustSceneColor(vec3 color, float saturation, float brightness) {
            float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));
            return mix(vec3(luminance), color, saturation) * brightness;
          }

          float hash21(vec2 point) {
            point = fract(point * vec2(123.34, 456.21));
            point += dot(point, point + 45.32);
            return fract(point.x * point.y);
          }

          vec3 sampleScene(vec2 uv) {
            vec2 baseUv = coverUv(uv, uBaseSize, 1.045);
            vec2 preReleaseUv = coverUv(uv, uPreReleaseSize, 1.0);
            vec3 baseColor = texture(uBaseTexture, baseUv).rgb;
            vec3 preReleaseColor = texture(uPreReleaseTexture, preReleaseUv).rgb;
            baseColor = adjustSceneColor(baseColor, 1.0 - uReveal * 0.26, 1.0 - uReveal * 0.14);
            preReleaseColor = adjustSceneColor(
              preReleaseColor,
              0.88 + uReveal * 0.18,
              0.9 + uReveal * 0.1
            );
            return mix(baseColor, preReleaseColor, smoothstep(0.0, 1.0, uReveal));
          }

          vec3 sampleRestoredFight(vec2 uv) {
            vec2 fightUv = coverUv(uv, uFightSize, 1.0);
            return texture(uFightTexture, fightUv).rgb;
          }

          void main() {
            float aspect = uResolution.x / max(1.0, uResolution.y);
            vec2 point = vUv - uCenter;
            point.x *= aspect;
            float radius = length(point);
            vec2 direction = point / max(radius, 0.0001);
            float core = max(uCoreRadius, 0.004);
            float gravityStrength = clamp(
              uGravity * (0.68 + uCollapse * 0.2 + uCrush * 0.12),
              0.0,
              1.12
            );
            float massRadius = max(
              core,
              0.044 + uCollapse * 0.009 + uCrush * 0.01
            );
            float lensReach = min(max(uLensRadius, massRadius * 4.0), 0.94);
            float outsideCore = smoothstep(core * 0.98, core * 1.22, radius);
            float radialUnit = clamp(
              (radius - core) / max(lensReach - core, 0.001),
              0.0,
              1.0
            );
            float distortionMask = outsideCore
              * smoothstep(0.0, 0.075, radialUnit)
              * (1.0 - smoothstep(0.82, 1.0, radialUnit));
            float gravityResponse = 1.0 - exp(-max(gravityStrength, 0.0) * 1.05);
            float distortionField = distortionMask
              * (0.78 + gravityResponse * 0.4 + uCollapse * 0.2 + uCrush * 0.24);

            float einsteinRadius = massRadius * (
              1.0
              + gravityStrength * 0.34
              + uCollapse * 0.1
              + uCrush * 0.08
            );

            float criticalRadius = einsteinRadius * sqrt(max(gravityStrength, 0.02));
            float ringWidth = max(massRadius * 0.2, 0.007);
            float causticDistance = (radius - criticalRadius) / ringWidth;
            float caustic = exp(-causticDistance * causticDistance)
              * distortionField
              * gravityStrength;

            float waveWidth = max(uShockWidth, 0.006);
            float waveCoordinate = (radius - uShockRadius) / waveWidth;
            float waveEnvelope = exp(-waveCoordinate * waveCoordinate);
            float waveDisplacement = -waveCoordinate
              * waveEnvelope
              * uShockStrength
              * (0.009 + waveWidth * 0.065)
              * distortionMask;
            float fieldBreath = sin(
              (radius - core) / max(lensReach - core, 0.01) * 9.0 - uTime * 0.56
            ) * distortionField * uCollapse * 0.0032;
            float cos2Angle = direction.x * direction.x - direction.y * direction.y;
            float cos3Angle = direction.x
              * (direction.x * direction.x - 3.0 * direction.y * direction.y);
            float radialPull = clamp(
              gravityResponse * (0.34 + uCollapse * 0.18 + uCrush * 0.12),
              0.0,
              0.68
            ) * (1.0 + cos2Angle * 0.12 + cos3Angle * 0.06);
            float mappedRadialUnit = radialUnit
              + radialPull * radialUnit * (1.0 - radialUnit);
            float shellCoordinate = (radialUnit - 0.32) / 0.16;
            mappedRadialUnit += gravityResponse
              * (0.012 + uCrush * 0.008)
              * shellCoordinate
              * exp(-shellCoordinate * shellCoordinate);
            float mappedRadius = core
              + (lensReach - core) * clamp(mappedRadialUnit, 0.0, 1.0);
            mappedRadius += waveDisplacement + fieldBreath;
            mappedRadius = mix(radius, mappedRadius, distortionMask);

            vec2 screenDirection = vec2(direction.x / aspect, direction.y);
            screenDirection /= max(length(screenDirection), 0.0001);
            vec2 screenTangent = vec2(-screenDirection.y, screenDirection.x);
            float transverseFlow = sin(
              radius * 21.0 - uTime * 0.8 + cos2Angle * 2.8
            ) + 0.45 * sin(
              radius * 11.0 + uTime * 0.37 + cos3Angle * 2.4
            );
            float flowStrength = distortionMask
              * gravityResponse
              * (0.0018 + uCollapse * 0.0035 + uCrush * 0.002);
            vec2 fieldDisplacement = screenTangent * transverseFlow * flowStrength;

            float edgeFade = smoothstep(0.0, 0.11, vUv.x)
              * smoothstep(0.0, 0.11, vUv.y)
              * smoothstep(0.0, 0.11, 1.0 - vUv.x)
              * smoothstep(0.0, 0.11, 1.0 - vUv.y);
            vec2 lensedPoint = direction * mappedRadius;
            vec2 displacedPoint = mix(point, lensedPoint, edgeFade);
            vec2 displacedCandidate = uCenter + vec2(displacedPoint.x / aspect, displacedPoint.y);
            displacedCandidate += fieldDisplacement * edgeFade;
            displacedCandidate = clamp(displacedCandidate, vec2(0.002), vec2(0.998));
            float finalField = clamp(
              distortionField * edgeFade,
              0.0,
              1.0
            );
            float distortionBlend = smoothstep(0.035, 0.88, finalField);
            vec2 finalUv = mix(vUv, displacedCandidate, distortionBlend);
            vec3 color = sampleScene(finalUv);
            float refractionSheen = sin(
              radius * 21.0
              + direction.x * 1.8
              + direction.y * 1.25
              - uTime * 1.28
            )
              * distortionBlend
              * gravityStrength
              * (0.012 + uCollapse * 0.022 + uCrush * 0.026);
            color *= 1.0
              + caustic * distortionBlend * 0.065
              + waveEnvelope * uShockStrength * distortionBlend * 0.028
              + refractionSheen
              + abs(transverseFlow) * flowStrength * 0.9;

            float horizon = 1.0 - smoothstep(core * 0.98, core * 1.04, radius);
            color = mix(color, vec3(0.0), horizon * distortionBlend);
            float sceneAlpha = clamp(uOpacity, 0.0, 1.0);

            vec2 pixel = vUv * uResolution;
            vec2 dataCell = floor(pixel / 9.0);
            vec2 dataCellCenter = (dataCell + 0.5) * 9.0 / uResolution;
            vec2 dataPoint = dataCellCenter - uCenter;
            dataPoint.x *= aspect;
            float dataRadius = length(dataPoint);
            float farthestRadius = max(
              max(
                length(vec2(uCenter.x * aspect, uCenter.y)),
                length(vec2((1.0 - uCenter.x) * aspect, uCenter.y))
              ),
              max(
                length(vec2(uCenter.x * aspect, 1.0 - uCenter.y)),
                length(vec2((1.0 - uCenter.x) * aspect, 1.0 - uCenter.y))
              )
            );
            float reconstructionEase = 1.0 - pow(
              1.0 - clamp(uReconstruction, 0.0, 1.0),
              2.35
            );
            float reconstructionFront = reconstructionEase * farthestRadius;
            float reconstructionBand = max(0.055, farthestRadius * 0.085);
            float radialProgress = clamp(
              (reconstructionFront - dataRadius) / reconstructionBand + 0.5,
              0.0,
              1.0
            );
            float dataNoise = mix(
              hash21(dataCell),
              0.5 + 0.5 * sin(dataCell.x * 0.31 - dataCell.y * 0.47 + uTime * 4.2),
              0.42
            );
            float dataMask = smoothstep(
              dataNoise - 0.16,
              dataNoise + 0.16,
              radialProgress
            );
            float dataSettle = smoothstep(
              dataNoise + 0.04,
              dataNoise + 0.62,
              radialProgress
            );
            float dataFront = exp(-pow(
              (radialProgress - dataNoise) / 0.17,
              2.0
            ));
            vec2 localCell = fract(pixel / 9.0);
            float cellEdgeDistance = min(
              min(localCell.x, 1.0 - localCell.x),
              min(localCell.y, 1.0 - localCell.y)
            );
            float cellEdge = 1.0 - smoothstep(0.035, 0.14, cellEdgeDistance);
            vec3 blockColor = sampleRestoredFight(dataCellCenter);
            vec3 cleanColor = sampleRestoredFight(vUv);
            vec3 reconstructedColor = mix(blockColor, cleanColor, dataSettle);
            reconstructedColor += vec3(0.26, 0.035, 0.12)
              * dataFront
              * (0.38 + cellEdge * 0.62);
            reconstructedColor += vec3(0.075, 0.13, 0.28)
              * dataFront
              * cellEdge
              * (0.28 + 0.22 * sin(dataCell.x + dataCell.y));
            float reconstructionMix = dataMask * clamp(uReconstructionOpacity, 0.0, 1.0);
            color = mix(color, reconstructedColor, reconstructionMix);
            float reconstructionAlpha = reconstructionMix
              * (0.72 + dataFront * 0.28);
            float alpha = max(sceneAlpha, reconstructionAlpha);
            outputColor = vec4(color * alpha, alpha);
          }
        `;

        const compileShader = (type, source) => {
          const shader = gl.createShader(type);
          if (!shader) return null;
          gl.shaderSource(shader, source);
          gl.compileShader(shader);
          if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
