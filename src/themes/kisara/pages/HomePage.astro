---
import KisaraLayout from "../layouts/KisaraLayout.astro";
import KisaraFoundSelfEasterEgg from "../components/KisaraFoundSelfEasterEgg.astro";
import KisaraLovebrainEasterEgg from "../components/KisaraLovebrainEasterEgg.astro";
import KisaraFridgeScene from "../components/KisaraFridgeScene.astro";
import KisaraHomeEventVideo from "../components/KisaraHomeEventVideo.astro";
import KisaraLatestNotes from "../components/KisaraLatestNotes.astro";
import KisaraOpeningMemoryScene from "../components/KisaraOpeningMemoryScene.astro";
import homeStylesheet from "../styles/home.css?url";
import homeEventVideoStylesheet from "../styles/home-event-video.css?url";
import homeComicStylesheet from "../styles/home-comic.css?url";
import { Icon } from "astro-icon/components";
import { existsSync } from "node:fs";
import { resolve } from "node:path";

const backgroundExtensions = ["webp", "png", "jpg", "jpeg"];
const findThemeAsset = (baseName: string) => {
  const extension = backgroundExtensions.find((candidate) =>
    existsSync(resolve(`public/themes/kisara/assets/${baseName}.${candidate}`))
  );
  return extension ? `/themes/kisara/assets/${baseName}.${extension}` : null;
};
const activeBackgroundUrl = findThemeAsset("gate-background");
const activeFightUrl = findThemeAsset("fight");
const memoryScenes = [
  {
    id: "rescue",
    image: "/themes/kisara/assets/memory-rescue.webp",
    position: "center 50%",
    saturation: 0.88,
    brightness: 1.03
  },
  {
    id: "attack",
    image: "/themes/kisara/assets/memory-attack.webp",
    position: "center 42%",
    saturation: 0.96,
    brightness: 1.04
  },
  {
    id: "clash",
    image: "/themes/kisara/assets/memory-clash.webp",
    position: "center 50%",
    saturation: 1.08,
    brightness: 1.08
  },
  {
    id: "embrace",
    image: "/themes/kisara/assets/memory-embrace.webp",
    position: "center 50%",
    saturation: 0.9,
    brightness: 1.03
  },
  {
    id: "kiss",
    image: "/themes/kisara/assets/memory-kiss.webp",
    position: "center 50%",
    saturation: 0.88,
    brightness: 1.06
  }
] as const;
const transformationScenes = [
  {
    id: "smoke-wide",
    image: "/themes/kisara/assets/transformation-smoke-wide.webp",
    position: "center 50%",
    saturation: 0.96,
    brightness: 1.02
  },
  {
    id: "detail",
    image: "/themes/kisara/assets/transformation-detail.webp",
    position: "center 48%",
    saturation: 1.02,
    brightness: 0.98
  }
] as const;
const gateSceneManifest = [
  ...memoryScenes.map((scene, index) => ({
    ...scene,
    id: `memory-${scene.id}`,
    kind: "memory",
    index,
    order: index
  })),
  ...transformationScenes.map((scene, index) => ({
    ...scene,
    id: `transformation-${scene.id}`,
    kind: "transformation",
    index,
    order: memoryScenes.length + index
  }))
] as const;
const ambientParticles = [
  { x: 7, y: 21, driftX: 88, driftY: -54, size: 3.2, duration: 18.4, delay: -4.8, opacity: 0.46, hue: 338 },
  { x: 15, y: 73, driftX: 64, driftY: -92, size: 2.1, duration: 21.7, delay: -13.2, opacity: 0.34, hue: 346 },
  { x: 24, y: 39, driftX: -42, driftY: -68, size: 4.1, duration: 24.2, delay: -8.7, opacity: 0.38, hue: 329 },
  { x: 32, y: 84, driftX: 76, driftY: -74, size: 2.7, duration: 19.6, delay: -16.4, opacity: 0.42, hue: 341 },
  { x: 41, y: 16, driftX: 45, driftY: 62, size: 2.4, duration: 22.8, delay: -10.1, opacity: 0.31, hue: 350 },
  { x: 49, y: 66, driftX: -58, driftY: -86, size: 3.6, duration: 25.1, delay: -2.6, opacity: 0.4, hue: 334 },
  { x: 57, y: 28, driftX: 73, driftY: -48, size: 2.2, duration: 20.3, delay: -15.5, opacity: 0.36, hue: 344 },
  { x: 64, y: 79, driftX: -66, driftY: -96, size: 3.1, duration: 23.7, delay: -7.4, opacity: 0.44, hue: 327 },
  { x: 72, y: 46, driftX: 51, driftY: 58, size: 2.5, duration: 17.9, delay: -11.6, opacity: 0.33, hue: 348 },
  { x: 79, y: 17, driftX: -84, driftY: 72, size: 3.8, duration: 26.2, delay: -19.3, opacity: 0.39, hue: 336 },
  { x: 86, y: 69, driftX: -52, driftY: -82, size: 2.2, duration: 19.1, delay: -5.9, opacity: 0.37, hue: 343 },
  { x: 93, y: 35, driftX: -77, driftY: -61, size: 3.4, duration: 22.4, delay: -14.1, opacity: 0.43, hue: 331 },
  { x: 37, y: 53, driftX: 95, driftY: -42, size: 1.9, duration: 16.8, delay: -9.2, opacity: 0.3, hue: 352 },
  { x: 68, y: 91, driftX: -91, driftY: -70, size: 2.8, duration: 24.9, delay: -17.8, opacity: 0.35, hue: 339 }
] as const;
const gateStyle = [
  "--kisara-fill: 0%",
  "--kisara-burst-progress: 0%",
  `--kisara-gate-background-image: ${activeBackgroundUrl ? `url("${activeBackgroundUrl}")` : "none"}`,
  `--kisara-fight-background-image: ${activeFightUrl ? `url("${activeFightUrl}")` : "none"}`
].join("; ");
---

<KisaraLayout
  title="Kisara | Yuimi Lab"
  description="Yuimi Lab 的 Kisara 视觉交互主题。"
  stylesheets={[homeStylesheet, homeEventVideoStylesheet, homeComicStylesheet]}
  priorityImages={activeBackgroundUrl ? [activeBackgroundUrl] : []}
>
  <script is:inline data-astro-rerun define:vars={{ criticalGateImage: activeBackgroundUrl ?? "" }}>
    (() => {
      window.__yuimiKisaraGateMediaCleanup?.();

      const root = document.documentElement;
      const source = criticalGateImage;
      let disposed = false;
      let settled = false;
      let fallbackTimer = 0;
      let revealFrame = 0;
      let revealPaintFrame = 0;

      root.dataset.kisaraGateMedia = source ? "pending" : "ready";

      const finish = (state) => {
        if (disposed || settled) return;
        settled = true;
        if (fallbackTimer) window.clearTimeout(fallbackTimer);
        fallbackTimer = 0;
        revealFrame = window.requestAnimationFrame(() => {
          revealFrame = 0;
          revealPaintFrame = window.requestAnimationFrame(() => {
            revealPaintFrame = 0;
            if (disposed) return;
            root.dataset.kisaraGateMedia = state;
          });
        });
      };

      const cleanup = () => {
        disposed = true;
        if (fallbackTimer) window.clearTimeout(fallbackTimer);
        if (revealFrame) window.cancelAnimationFrame(revealFrame);
        if (revealPaintFrame) window.cancelAnimationFrame(revealPaintFrame);
        fallbackTimer = 0;
        revealFrame = 0;
        revealPaintFrame = 0;
        root.removeAttribute("data-kisara-gate-media");
        if (window.__yuimiKisaraGateMediaCleanup === cleanup) {
          window.__yuimiKisaraGateMediaCleanup = null;
        }
      };

      window.__yuimiKisaraGateMediaCleanup = cleanup;
      document.addEventListener("astro:before-swap", cleanup, { once: true });

      if (!source) {
        finish("ready");
        return;
      }

      const image = new Image();
      image.decoding = "async";
      image.fetchPriority = "high";
      image.src = source;

      const loaded = image.complete
        ? Promise.resolve()
        : new Promise((resolve, reject) => {
            image.addEventListener("load", resolve, { once: true });
            image.addEventListener("error", reject, { once: true });
          });

      loaded.then(async () => {
        try {
          if (image.naturalWidth > 0 && typeof image.decode === "function") {
            await image.decode();
          }
        } catch {
          // A loaded image can still paint when decode() is interrupted by navigation.
        }
        finish(image.naturalWidth > 0 ? "ready" : "failed");
      }).catch(() => finish("failed"));

      fallbackTimer = window.setTimeout(() => {
        finish(image.complete && image.naturalWidth > 0 ? "ready" : "failed");
      }, 8000);
    })();
  </script>
  <script is:inline data-astro-rerun>
    (() => {
      const ticketKey = "yuimi-kisara-found-self-ticket-v1";
      let ticket = null;
      try {
        ticket = JSON.parse(sessionStorage.getItem(ticketKey) ?? "null");
        sessionStorage.removeItem(ticketKey);
      } catch {}
      const requested = ticket?.source === "me-games"
        && Number.isFinite(ticket?.createdAt)
        && Date.now() - ticket.createdAt < 30_000;
      if (requested) document.documentElement.dataset.kisaraFoundSelfEntry = "pending";
      else delete document.documentElement.dataset.kisaraFoundSelfEntry;
    })();
  </script>

  <section class="kisara-gate" data-kisara-gate style={gateStyle}>
    <script type="application/json" data-kisara-scene-manifest set:html={JSON.stringify(gateSceneManifest)}></script>
    <div class="kisara-gate-visual-shell" aria-hidden="true">
      <div class="kisara-gate-visual-camera">
        <div class="kisara-gate-bridge-underlay"></div>
        <div class="kisara-gate-bridge-current">
          <div class="kisara-gate-visual">
            <div class="kisara-gate-background kisara-gate-background-base"></div>
            <div class="kisara-gate-background kisara-gate-scene-slot" data-kisara-scene-slot="0"></div>
            <div class="kisara-gate-background kisara-gate-scene-slot" data-kisara-scene-slot="1"></div>
            <div class="kisara-gate-background kisara-gate-background-fight"></div>
            <div class="kisara-memory-flare"></div>
            <div class="kisara-gate-background kisara-gate-background-fight-wash"></div>
            <div class="kisara-gate-atmosphere"></div>
          </div>
          <canvas
            class="kisara-space-lens-canvas"
            data-kisara-space-lens
            data-fight-src={activeFightUrl ?? ""}
            width="1280"
            height="900"
          ></canvas>
          <canvas
            class="kisara-post-release-canvas"
            data-kisara-post-release-canvas
            data-fight-src={activeFightUrl ?? ""}
            width="1280"
            height="900"
          ></canvas>
        </div>
      </div>
    </div>
    <KisaraFoundSelfEasterEgg />
    <KisaraLovebrainEasterEgg />
    <div class="kisara-ambient-particles" aria-hidden="true">
      {ambientParticles.map((particle) => (
        <i
          style={[
            `--kisara-particle-x: ${particle.x}%`,
            `--kisara-particle-y: ${particle.y}%`,
            `--kisara-particle-drift-x: ${particle.driftX}px`,
            `--kisara-particle-drift-y: ${particle.driftY}px`,
            `--kisara-particle-size: ${particle.size}px`,
            `--kisara-particle-duration: ${particle.duration}s`,
            `--kisara-particle-delay: ${particle.delay}s`,
            `--kisara-particle-opacity: ${particle.opacity}`,
            `--kisara-particle-hue: ${particle.hue}`
          ].join("; ")}
        ></i>
      ))}
    </div>
    <div class="kisara-title-stage">
      <span class="kisara-title-reset-underlay kisara-title-base" aria-hidden="true">Kisara</span>
      <h1 class="kisara-title" aria-label="Kisara">
        <canvas
          class="kisara-title-chain-canvas kisara-title-chain-canvas-back"
          data-kisara-chain-back
          width="1400"
          height="420"
          aria-hidden="true"
        ></canvas>
        <canvas
          class="kisara-title-abyss-canvas"
          data-kisara-title-abyss
          width="1200"
          height="320"
          aria-hidden="true"
        ></canvas>
        <span class="kisara-title-base" aria-hidden="true">Kisara</span>
        <span class="kisara-title-tide" aria-hidden="true">Kisara</span>
        <canvas
          class="kisara-title-chain-canvas kisara-title-chain-canvas-front"
          data-kisara-chain-front
          width="1400"
          height="420"
          aria-hidden="true"
        ></canvas>
        <span class="kisara-title-enchant" aria-hidden="true">Kisara</span>
        <canvas
          class="kisara-title-data-canvas"
          data-kisara-title-data
          width="1200"
          height="320"
          aria-hidden="true"
        ></canvas>
        <canvas
          class="kisara-title-lens-canvas"
          data-kisara-title-lens
          width="1200"
          height="260"
          aria-hidden="true"
        ></canvas>
      </h1>
    </div>
    <div class="kisara-contract-meter" aria-hidden="true">
      <canvas class="kisara-energy-canvas" data-kisara-energy width="640" height="64"></canvas>
    </div>
    <p class="kisara-contract-state" data-kisara-state>SEAL CHAINS / DORMANT</p>
    <p class="kisara-scroll-cue" data-kisara-cue>Yuimi-chaya/GPT in Codex</p>
    <button class="kisara-motion-toggle" type="button" data-kisara-motion-toggle hidden aria-pressed="false">
      <Icon name="tabler:activity-heartbeat" aria-hidden="true" />
      <span>体感视差</span>
    </button>
    <button
      class="kisara-gate-auto"
      type="button"
      data-kisara-auto
      data-state="idle"
      aria-label="自动播放首屏演出"
    >
      <span class="kisara-gate-auto-mark" aria-hidden="true"></span>
      <span data-kisara-auto-label>AUTO</span>
    </button>
    <a class="kisara-gate-skip" href="#kisara-opening" data-kisara-skip>SKIP</a>
  </section>

  <section
    id="kisara-opening"
    class="kisara-opening kisara-comic-section"
    data-kisara-home-stop="001"
    aria-labelledby="kisara-opening-title"
  >
    <KisaraOpeningMemoryScene />
  </section>

  <KisaraFridgeScene />

  <div class="kisara-home-transition is-fridge-to-event" aria-hidden="true"><span></span><i></i><i></i></div>

  <KisaraHomeEventVideo />

  <div class="kisara-home-transition is-event-to-latest" aria-hidden="true"><span></span><i></i><i></i></div>

  <KisaraLatestNotes />

  <div class="kisara-home-transition is-latest-to-footer" aria-hidden="true"><span></span><i></i><i></i></div>

  <script>
    import { createComicTransition } from "../lib/comicTransition";
    import { chainLinkPitch, createTitleChainMaterial } from "../lib/titleChainMaterial";
    import {
      gateRelease, mapReleaseAutoplayProgress, getReconstructionProgress,
      getTransformationFrame, getGateSceneHandoff, getReconstructionRadii
    } from "../lib/gateRelease";
    import { createGateReconstructionRenderer } from "../lib/gateReconstruction";
    const releaseStaleKisaraHomeRuntime = (candidate) => {
      if (!(candidate instanceof HTMLElement) || candidate.dataset.bound !== "true") return false;
      const candidateAutoControl = candidate.querySelector("[data-kisara-auto]");
      if (
        !(candidateAutoControl instanceof HTMLElement)
        || candidateAutoControl.dataset.kisaraRuntimeBound === "true"
      ) return false;
      window.__yuimiKisaraHomeCleanup?.();
      candidate.removeAttribute("data-bound");
      candidate.removeAttribute("data-binding");
      return true;
    };

    const scheduleKisaraHome = () => {
      window.__yuimiKisaraHomeSchedule = scheduleKisaraHome;
      window.clearTimeout(window.__yuimiKisaraHomeInitTimer);
      const scheduledGate = document.querySelector("[data-kisara-gate]");
      if (!(scheduledGate instanceof HTMLElement)) return;
      if (scheduledGate.dataset.bound === "true") {
        if (!releaseStaleKisaraHomeRuntime(scheduledGate)) {
          window.__yuimiKisaraHomeBootController?.markReady?.();
          return;
        }
      }
      if (scheduledGate.dataset.binding === "true") return;
      window.__yuimiKisaraHomeInitTimer = window.setTimeout(() => {
        window.__yuimiKisaraHomeInitTimer = 0;
        const pendingGate = document.querySelector("[data-kisara-gate]");
        if (!(pendingGate instanceof HTMLElement)) return;
        if (pendingGate.dataset.bound === "true") {
          if (!releaseStaleKisaraHomeRuntime(pendingGate)) {
            window.__yuimiKisaraHomeBootController?.markReady?.();
            return;
          }
        }
        if (pendingGate.dataset.binding === "true") return;
        window.__yuimiKisaraHomeCleanup?.();
      try {
        (() => {
      const gate = document.querySelector("[data-kisara-gate]");
      if (!gate) return;
      const foundSelfEntryRequested = document.documentElement.dataset.kisaraFoundSelfEntry === "pending";
      if (gate.dataset.bound === "true") {
        if (!releaseStaleKisaraHomeRuntime(gate)) {
          window.__yuimiKisaraHomeBootController?.markReady?.();
          return;
        }
      }
      if (gate.dataset.binding === "true") return;
      gate.dataset.binding = "true";
      const lifecycle = new AbortController();
      const signal = lifecycle.signal;
      let disposed = false;
      const runtimeStyleCache = new WeakMap<Element, Map<string, string>>();
      const setRuntimeStyle = (
        element: Element | null | undefined,
        property: string,
        value: string
      ) => {
        if (!(element instanceof HTMLElement)) return;
        let values = runtimeStyleCache.get(element);
        if (!values) {
          values = new Map();
          runtimeStyleCache.set(element, values);
        }
        if (values.get(property) === value) return;
        values.set(property, value);
        element.style.setProperty(property, value);
      };

      const performanceProfile = document.documentElement.dataset.yuimiPerformance ?? "full";
      const mobilePerformance = performanceProfile !== "full";
      const litePerformance = performanceProfile === "lite";
      const mobileFrameInterval = litePerformance
        ? 1000 / 24
        : mobilePerformance
          ? 1000 / 30
          : 0;
      const mobileCanvasRatio = litePerformance ? 0.9 : 1;
      const quantizeRuntimeValue = (value, mobileStep, liteStep = mobileStep) => {
        const step = litePerformance
          ? liteStep
          : mobilePerformance
            ? mobileStep
            : 0;
        return step > 0 ? Math.round(value / step) * step : value;
      };
      const energyCanvas = gate.querySelector("[data-kisara-energy]");
      const energyContext = energyCanvas?.getContext("2d");
      const spaceLensCanvas = gate.querySelector("[data-kisara-space-lens]");
      const titleLensCanvas = gate.querySelector("[data-kisara-title-lens]");
      const titleAbyssCanvas = gate.querySelector("[data-kisara-title-abyss]");
      const titleAbyssContext = titleAbyssCanvas?.getContext("2d", { alpha: true });
      if (mobilePerformance) {
        gate.querySelectorAll(".kisara-title-chain-canvas").forEach((canvas) => canvas.remove());
      }
      const chainBackCanvas = mobilePerformance
        ? null
        : gate.querySelector("[data-kisara-chain-back]");
      const chainBackContext = chainBackCanvas?.getContext("2d", { alpha: true });
      const chainFrontCanvas = mobilePerformance
        ? null
        : gate.querySelector("[data-kisara-chain-front]");
      const chainFrontContext = chainFrontCanvas?.getContext("2d", { alpha: true });
      const titleDataCanvas = gate.querySelector("[data-kisara-title-data]");
      const titleDataContext = titleDataCanvas?.getContext("2d", { alpha: true });
      const postReleaseCanvas = gate.querySelector("[data-kisara-post-release-canvas]");
      const postReleaseContext = postReleaseCanvas?.getContext("2d", { alpha: true });
      const gateVisualShell = gate.querySelector(".kisara-gate-visual-shell");
      const gateVisual = gate.querySelector(".kisara-gate-visual");
      const baseBackground = gate.querySelector(".kisara-gate-background-base");
      const fightBackground = gate.querySelector(".kisara-gate-background-fight");
      const fightWashBackground = gate.querySelector(".kisara-gate-background-fight-wash");
      const memoryFlare = gate.querySelector(".kisara-memory-flare");
      const sceneManifestElement = gate.querySelector("[data-kisara-scene-manifest]");
      let sceneManifest = [];
      try {
        const parsedManifest = JSON.parse(sceneManifestElement?.textContent ?? "[]");
        sceneManifest = Array.isArray(parsedManifest) ? parsedManifest : [];
      } catch {
        sceneManifest = [];
      }
      const memorySceneRecords = sceneManifest.filter((scene) => scene?.kind === "memory");
      const transformationSceneRecords = sceneManifest.filter(
        (scene) => scene?.kind === "transformation"
      );
      const sceneSlotRecords = Array.from(
        gate.querySelectorAll("[data-kisara-scene-slot]")
      ).map((element, index) => ({
        element,
        index,
        sceneId: "",
        rendered: Object.create(null)
      }));
      let sceneDecodeGeneration = 0;
      const sceneImageWarmers = new Map(sceneManifest.map((scene, index) => {
        const image = new Image();
        image.decoding = "async";
        image.fetchPriority = index < 2 ? "high" : "low";
        return [scene.id, {
          image,
          source: scene.image,
          status: "idle",
          promise: null
        }];
      }));
      const warmSceneImage = (scene) => {
        const record = scene?.id ? sceneImageWarmers.get(scene.id) : null;
        if (!record || record.status === "ready" || record.status === "failed") {
          return record?.promise ?? Promise.resolve();
        }
        if (record.status === "decoding") return record.promise;

        const generation = sceneDecodeGeneration;
        record.status = "decoding";
        if (!record.image.src) record.image.src = record.source;
        record.promise = Promise.resolve(
          typeof record.image.decode === "function" ? record.image.decode() : undefined
        ).then(() => {
          if (disposed || generation !== sceneDecodeGeneration) return;
          record.status = "ready";
          gate.dispatchEvent(new CustomEvent("kisara:scene-ready"));
        }).catch(() => {
          if (disposed || generation !== sceneDecodeGeneration) return;
          record.status = record.image.complete && record.image.naturalWidth > 0
            ? "ready"
            : "failed";
          gate.dispatchEvent(new CustomEvent("kisara:scene-ready"));
        });
        return record.promise;
      };
      const isSceneImageReady = (scene) => {
        const record = scene?.id ? sceneImageWarmers.get(scene.id) : null;
        if (!record || record.status === "failed") return true;
        if (
          record.status === "ready"
          || (record.image.complete && record.image.naturalWidth > 0)
        ) {
          record.status = "ready";
          return true;
        }
        warmSceneImage(scene);
        return false;
      };
      const warmSceneImagesForProgress = (fill, intro) => {
        if (fill >= 0.08) warmSceneImage(memorySceneRecords[2]);
        if (fill >= 0.25) warmSceneImage(memorySceneRecords[3]);
        if (fill >= 0.42) warmSceneImage(memorySceneRecords[4]);
        if (fill >= 0.55 || intro > 0.001) warmSceneImage(transformationSceneRecords[0]);
        if (fill >= 0.7 || intro >= 0.18) warmSceneImage(transformationSceneRecords[1]);
      };
      if (!foundSelfEntryRequested) memorySceneRecords.slice(0, 2).forEach(warmSceneImage);
      let sceneSlotOverflowWarned = false;
      const meterShell = gate.querySelector(".kisara-contract-meter");
      const title = gate.querySelector(".kisara-title");
      const opening = document.querySelector("#kisara-opening");
      const state = gate.querySelector("[data-kisara-state]");
      const cue = gate.querySelector("[data-kisara-cue]");
      const motionToggle = gate.querySelector("[data-kisara-motion-toggle]");
      const autoPlay = gate.querySelector("[data-kisara-auto]");
      const autoPlayLabel = autoPlay?.querySelector("[data-kisara-auto-label]");
      const skip = gate.querySelector("[data-kisara-skip]");
      const foundSelfOverlay = gate.querySelector("[data-kisara-found-self]");
      const foundSelfVideo = gate.querySelector("[data-kisara-found-self-video]");
      const foundSelfStatus = gate.querySelector("[data-kisara-found-self-status]");
      const foundSelfSkip = gate.querySelector("[data-kisara-found-self-skip]");
      const foundSelfAnnouncer = gate.querySelector("[data-kisara-found-self-announcer]");
      const fridgeScene = document.querySelector("kisara-fridge-scene");
      const eventScene = document.querySelector("kisara-home-event-video");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const comicTransition = createComicTransition(signal, reducedMotion);
      const openingMemoryScene = document.querySelector("kisara-opening-memory-scene");
      const resetOpeningMemoryPresentation = () => {
        const resettableScene = openingMemoryScene as (
          HTMLElement & { resetPresentation?: () => void }
        ) | null;
        resettableScene?.resetPresentation?.();
      };
      const refreshOpeningMemoryPresentation = () => {
        const refreshableScene = openingMemoryScene as (
          HTMLElement & { refreshPresentationAfterVisibility?: () => void }
