        energyFrame = 0;
        scrollFrame = 0;
        gateReturnResetFrame = 0;
        layoutResizeFrame = 0;
        restoredHomeSectionAlignmentFrame = 0;
        energyTimer = 0;
        restoreSyncTimer = 0;
        openingBridgeRecoveryFrame = 0;
        openingBridgeHandoffFrame = 0;
        openingTitleBridgeHandoffFrame = 0;
        openingTitleBridgeActive = false;
        openingBridgeResumeLive = false;
        homeSectionWheelTimer = 0;
        homeGateReturnTimer = 0;
        opening?.classList.remove("is-gate-return-armed");
        gate.classList.remove(
          "is-opening-bridge-dissolving",
          "is-opening-bridge-handoff",
          "is-opening-title-bridge-dissolving",
          "is-opening-title-bridge-handoff"
        );
        resetOpeningTitleBridgePresentation();
        releaseWarmupHandle = 0;
        releaseWarmupScheduled = false;
        releaseWarmupForceRequested = false;
        energyLoopActive = false;
        clearTitleAbyssCanvas(true);
        setOrientationEnabled(false);
        stopPostReleaseAnimation();
        layoutResizeObserver?.disconnect();
