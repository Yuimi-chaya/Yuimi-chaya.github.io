        context.rotate(headAngle);
        const headGradient = context.createRadialGradient(
          headRadius * 0.18,
          0,
          0,
          0,
          0,
          headRadius * 1.65
        );
        headGradient.addColorStop(0, "rgba(255,255,255,1)");
        headGradient.addColorStop(0.28, "rgba(255,235,244,0.96)");
        headGradient.addColorStop(0.64, "rgba(255,76,132,0.42)");
        headGradient.addColorStop(1, "rgba(255,76,132,0)");
        context.globalAlpha = opacity * intensity;
        context.fillStyle = headGradient;
        context.shadowColor = "rgba(255, 235, 245, 0.92)";
        context.shadowBlur = 16 + impactPulse * 28;
        context.beginPath();
        context.ellipse(0, 0, headRadius * 1.38, headRadius * 0.92, 0, 0, fullTurn);
        context.fill();
        context.restore();

        if (geometry.impact > 0.001) {
          const ringReach = 28 + geometry.impact * Math.min(190, viewportWidth * 0.16);
          const impactFade = 1 - phaseProgress(geometry.impact, 0.72, 1);
