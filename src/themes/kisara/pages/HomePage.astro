          gradient.addColorStop(0.24, "#ff8ca5");
          gradient.addColorStop(0.58, "#ff315e");
          gradient.addColorStop(1, "#c81343");
          sourceContext.shadowColor = "rgba(255, 45, 96, 0.34)";
          sourceContext.shadowBlur = Math.max(4, 10 * renderScale);
          sourceContext.strokeStyle = "rgba(255, 235, 242, 0.82)";
          sourceContext.lineWidth = Math.max(1.2, 1.8 * renderScale);
          sourceContext.strokeText("Kisara", pixelWidth * 0.5, baseline);
          sourceContext.fillStyle = gradient;
          sourceContext.fillText("Kisara", pixelWidth * 0.5, baseline);
          sourceContext.restore();

          gl.viewport(0, 0, pixelWidth, pixelHeight);
          gl.bindTexture(gl.TEXTURE_2D, titleTexture);
          gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
          gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, true);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
          gl.texImage2D(
            gl.TEXTURE_2D,
            0,
            gl.RGBA,
            gl.RGBA,
            gl.UNSIGNED_BYTE,
            sourceCanvas
          );
        };
        const requestResize = () => {
          sizeDirty = true;
          resize();
        };

        const clear = () => {
          titleLensCanvas.style.opacity = "0";
          titleLensCanvas.dataset.active = "false";
          gl.clearColor(0, 0, 0, 0);
          gl.clear(gl.COLOR_BUFFER_BIT);
        };

        const draw = (parameters) => {
          if (gl.isContextLost()) {
            titleLensCanvas.style.opacity = "0";
            titleLensCanvas.dataset.state = "lost";
            gate.style.setProperty("--kisara-title-source-opacity", "1");
            return;
          }
          resize();
          const scaleX = titleLensCanvas.width / Math.max(1, cssWidth);
          const scaleY = titleLensCanvas.height / Math.max(1, cssHeight);
          gl.clearColor(0, 0, 0, 0);
          gl.clear(gl.COLOR_BUFFER_BIT);
          gl.useProgram(program);
          gl.bindVertexArray(vertexArray);
          gl.activeTexture(gl.TEXTURE0);
          gl.bindTexture(gl.TEXTURE_2D, titleTexture);
          gl.uniform1i(uniforms.titleTexture, 0);
          gl.uniform2f(uniforms.resolution, titleLensCanvas.width, titleLensCanvas.height);
          gl.uniform2f(
            uniforms.center,
            parameters.centerX * scaleX,
            (cssHeight - parameters.centerY) * scaleY
          );
          gl.uniform1f(uniforms.opacity, parameters.opacity);
          gl.uniform1f(uniforms.strength, parameters.strength);
          gl.uniform1f(uniforms.gravity, parameters.gravity);
          gl.uniform1f(uniforms.collapse, parameters.collapse);
          gl.uniform1f(uniforms.crush, parameters.crush);
          gl.uniform1f(uniforms.shockStrength, parameters.shockStrength);
          gl.uniform1f(uniforms.shockRadius, parameters.shockRadius * renderScale);
          gl.uniform1f(uniforms.shockWidth, parameters.shockWidth * renderScale);
          gl.uniform1f(uniforms.coreRadius, parameters.coreRadius * renderScale);
          gl.uniform1f(uniforms.lensRadius, parameters.lensRadius * renderScale);
          gl.uniform1f(uniforms.release, parameters.release);
          gl.uniform1f(uniforms.dissolve, parameters.dissolve);
          gl.uniform1f(uniforms.time, parameters.time);
          gl.uniform1f(uniforms.finalFlow, parameters.finalFlow ?? 0);
          gl.uniform1f(uniforms.liquidPhase, parameters.liquidPhase ?? 0);
          gl.uniform1f(uniforms.liquidPressure, parameters.liquidPressure ?? 0);
          gl.uniform1f(uniforms.flowDirection, parameters.flowDirection ?? 1);
          gl.uniform1f(uniforms.flowFront, parameters.flowFront ?? 0.5);
          gl.uniform1f(uniforms.parallax, parameters.parallax ?? 0);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          titleLensCanvas.style.opacity = "1";
          titleLensCanvas.dataset.active = "true";
        };

        const warm = (force = false) => {
          if (warmed && !force) return;
          warmed = true;
          draw({
            centerX: cssWidth * 0.5,
            centerY: cssHeight * 0.5,
            opacity: 0,
            strength: 0,
            gravity: 0,
            collapse: 0,
            crush: 0,
            shockStrength: 0,
            shockRadius: 1,
            shockWidth: 1,
            coreRadius: 1,
            lensRadius: 1,
            release: 0,
            dissolve: 0,
            time: 0,
            finalFlow: 0,
            liquidPhase: 0,
            liquidPressure: 0,
            flowDirection: 1,
            flowFront: 0.5,
            parallax: 0
          });
          gl.flush();
          clear();
        };

        const destroy = () => {
          gl.deleteTexture(titleTexture);
          gl.deleteVertexArray(vertexArray);
          gl.deleteProgram(program);
          clear();
        };

        resize(true);
        clear();
        return {
          clear,
          destroy,
          draw,
          warm,
          refresh: () => {
            sizeDirty = true;
            resize(true);
          },
          resize: requestResize
        };
      };

      let warningWarmupScheduled = false;
      let warningWarmupHandle = 0;
      let warningWarmupUsesIdleCallback = false;
      let warningWarmupReleaseFrame = 0;
      let warningLensWarmupFrame = 0;
      let warningWarmupLastAt = -Infinity;
      let warningWarmupForceRequested = false;
      const runWarningWarmup = () => {
        warningWarmupHandle = 0;
        warningWarmupScheduled = false;
        const force = warningWarmupForceRequested;
        warningWarmupForceRequested = false;
        if (disposed || !gate.isConnected) return;
        if (reducedMotion || pageMode !== "gate" || document.visibilityState !== "visible") return;
        if (warningPresentationActive || burstProgress >= crossStart - 0.03) return;
        const timestamp = performance.now();
        if (!force && timestamp - warningWarmupLastAt < 3200) return;
        warningWarmupLastAt = timestamp;

        ensureSingularityFieldBuffer(gate.clientWidth < 640 ? 80 : 108);
        spaceLensRenderer?.warm?.(true);
        if (warningLensWarmupFrame) window.cancelAnimationFrame(warningLensWarmupFrame);
        warningLensWarmupFrame = window.requestAnimationFrame(() => {
          warningLensWarmupFrame = 0;
          if (!disposed && pageMode === "gate") titleLensRenderer?.warm?.(true);
        });

        if (warningWarmupReleaseFrame) {
          window.cancelAnimationFrame(warningWarmupReleaseFrame);
          warningWarmupReleaseFrame = 0;
        }
        gate.classList.add("is-warning-prewarm");
        gate.getBoundingClientRect();
        warningWarmupReleaseFrame = window.requestAnimationFrame(() => {
          if (disposed) return;
          warningWarmupReleaseFrame = window.requestAnimationFrame(() => {
            warningWarmupReleaseFrame = 0;
            if (!disposed) gate.classList.remove("is-warning-prewarm");
          });
        });
      };
      const scheduleWarningWarmup = (force = false) => {
        if (force) warningWarmupForceRequested = true;
        if (disposed || reducedMotion || pageMode !== "gate") return;
        if (warningWarmupScheduled) return;
        if (!force && performance.now() - warningWarmupLastAt < 3200) return;
        warningWarmupScheduled = true;
        if ("requestIdleCallback" in window) {
          warningWarmupUsesIdleCallback = true;
          warningWarmupHandle = window.requestIdleCallback(runWarningWarmup, { timeout: force ? 240 : 900 });
        } else {
          warningWarmupUsesIdleCallback = false;
          warningWarmupHandle = window.setTimeout(runWarningWarmup, force ? 32 : 180);
        }
      };

      const startSpaceLens = () => {
        if (disposed || !spaceLensCanvas || reducedMotion) return;
        const generation = ++spaceLensInitGeneration;
        spaceLensCanvas.dataset.state = "loading";
        createSpaceLensRenderer().then((renderer) => {
          if (disposed || generation !== spaceLensInitGeneration) {
            renderer?.destroy();
            return;
          }
          spaceLensRenderer = renderer;
          spaceLensCanvas.dataset.state = renderer ? "ready" : "fallback";
          scheduleWarningWarmup();
        });
      };

      spaceLensCanvas?.addEventListener("webglcontextlost", (event) => {
        event.preventDefault();
        spaceLensInitGeneration += 1;
        spaceLensRenderer = null;
        spaceLensCanvas.style.opacity = "0";
        spaceLensCanvas.dataset.state = "lost";
      }, { passive: false, signal });
      spaceLensCanvas?.addEventListener("webglcontextrestored", () => {
        startSpaceLens();
      }, { passive: true, signal });
      startSpaceLens();

      const startTitleLens = () => {
        if (disposed || !titleLensCanvas || reducedMotion) return;
        const generation = ++titleLensInitGeneration;
        titleLensCanvas.dataset.state = "loading";
        const renderer = createTitleLensRenderer();
        if (generation !== titleLensInitGeneration) {
          renderer?.destroy();
          return;
        }
        titleLensRenderer = renderer;
        titleLensCanvas.dataset.state = renderer ? "ready" : "fallback";
        scheduleWarningWarmup();
      };

      titleLensCanvas?.addEventListener("webglcontextlost", (event) => {
        event.preventDefault();
        titleLensInitGeneration += 1;
        titleLensRenderer = null;
        titleLensCanvas.style.opacity = "0";
        titleLensCanvas.dataset.state = "lost";
        gate.style.setProperty("--kisara-title-source-opacity", "1");
      }, { passive: false, signal });
      titleLensCanvas?.addEventListener("webglcontextrestored", () => {
        startTitleLens();
      }, { passive: true, signal });
      startTitleLens();
      document.fonts?.ready.then(() => {
        if (disposed) return;
        titleLensRenderer?.refresh();
        resizeTitleChains(true);
        resizeTitleDataCanvas(true);
      });

      const drawSpaceLens = (timestamp, parameters) => {
        if (!spaceLensRenderer || !spaceLensCanvas) return;
        const activeOpacity = Math.max(
          parameters.opacity,
          parameters.reconstructionOpacity ?? 0
        );
        if (activeOpacity <= 0.001 || pageMode !== "gate" || document.visibilityState !== "visible") {
          if (spaceLensCanvas.dataset.active === "true") spaceLensRenderer.clear();
          lastSpaceLensPaintTimestamp = 0;
          return;
        }
        const minimumInterval = gate.clientWidth < 640 ? 1000 / 30 : 1000 / 60;
        if (
          lastSpaceLensPaintTimestamp > 0
          && timestamp - lastSpaceLensPaintTimestamp < minimumInterval
        ) return;
        lastSpaceLensPaintTimestamp = timestamp;
        spaceLensRenderer.draw(parameters);
      };

      const drawTitleLens = (timestamp, parameters) => {
        if (!titleLensRenderer || !titleLensCanvas) {
          gate.style.setProperty("--kisara-title-source-opacity", "1");
          return;
        }
        const sourceOpacity = clamp(
          parameters.sourceOpacity ?? (1 - parameters.opacity),
          0,
          1
        );
        if (parameters.opacity <= 0.001 || pageMode !== "gate" || document.visibilityState !== "visible") {
          if (titleLensCanvas.dataset.active === "true") titleLensRenderer.clear();
          gate.style.setProperty("--kisara-title-source-opacity", sourceOpacity.toFixed(4));
          lastTitleLensPaintTimestamp = 0;
          return;
        }
        const minimumInterval = gate.clientWidth < 640 ? 1000 / 30 : 1000 / 60;
        if (
          lastTitleLensPaintTimestamp > 0
          && timestamp - lastTitleLensPaintTimestamp < minimumInterval
        ) return;
        lastTitleLensPaintTimestamp = timestamp;
        titleLensRenderer.draw(parameters);
        gate.style.setProperty(
          "--kisara-title-source-opacity",
          sourceOpacity.toFixed(4)
        );
      };

      const glitchAlphabet = "0123456789XZ!?/#@$%&<>";
      const makeGlitchState = (timestamp, burst, released) => {
        const tick = Math.floor(timestamp / 72);
        const patterns = released
          ? ["SIGNAL RELEASED", "CORE WITHOUT LIMIT", "CHANNEL UNBOUND", "OUTPUT OVERRUN"]
          : ["SYSTEM UNSTABLE", "KISARA OVERFLOW", "CONTRACT BREACH", "RED TIDE RISING"];
        const pattern = patterns[Math.floor(randomSeed(tick + 8401) * patterns.length)];
        const corrupted = pattern.split("").map((character, index) => {
          if (character === " " || randomSeed(tick * 31 + index + 8417) < 0.62) return character;
          const glyphIndex = Math.floor(randomSeed(tick * 47 + index + 8461) * glitchAlphabet.length);
          return glitchAlphabet[glyphIndex];
        }).join("");
        const code = Math.floor(randomSeed(tick + 8521) * 0xffffff).toString(16).toUpperCase().padStart(6, "0");
        const noise = Array.from({ length: 4 }, (_, index) => {
          const glyphIndex = Math.floor(randomSeed(tick * 59 + index + 8591) * glitchAlphabet.length);
          return glitchAlphabet[glyphIndex];
        }).join("");
        const phase = burst > 0.72 ? "// BREAK" : "// OVRFLW";
        return `${corrupted} ${phase} ${code} ${noise}`;
      };

      const resizeEnergyCanvas = (force = false) => {
        if (!energyCanvas || !energyContext) return;
        if (!force && energyCanvasWidth > 0 && energyCanvasHeight > 0) return;
        const rect = energyCanvas.getBoundingClientRect();
        const width = Math.max(1, Math.round(rect.width));
        const height = Math.max(1, Math.round(rect.height));
        const devicePixelRatio = Math.min(window.devicePixelRatio || 1, 2);
        const pixelWidth = Math.max(1, Math.round(width * devicePixelRatio));
        const pixelHeight = Math.max(1, Math.round(height * devicePixelRatio));
        if (energyCanvas.width !== pixelWidth || energyCanvas.height !== pixelHeight) {
          energyCanvas.width = pixelWidth;
          energyCanvas.height = pixelHeight;
          energyContext.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
        }
        energyCanvasWidth = width;
        energyCanvasHeight = height;
      };

      const resizeBurstCanvas = (force = false) => {
        if (!burstCanvas || !burstContext) return;
        if (!force && burstCanvasWidth > 0 && burstCanvasHeight > 0) return;
        const rect = burstCanvas.getBoundingClientRect();
        const width = Math.max(1, Math.round(rect.width));
        const height = Math.max(1, Math.round(rect.height));
        const ratioCap = width < 640 ? 1.16 : 1.38;
        const devicePixelRatio = Math.min(window.devicePixelRatio || 1, ratioCap);
        const pixelWidth = Math.max(1, Math.round(width * devicePixelRatio));
        const pixelHeight = Math.max(1, Math.round(height * devicePixelRatio));
        if (burstCanvas.width !== pixelWidth || burstCanvas.height !== pixelHeight) {
          burstCanvas.width = pixelWidth;
          burstCanvas.height = pixelHeight;
          burstContext.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
        }
        burstCanvasWidth = width;
        burstCanvasHeight = height;
        meterLayout = {
          width: meterShell?.clientWidth || Math.min(620, width * 0.78),
          height: meterShell?.clientHeight || 68,
          left: meterShell?.offsetLeft ?? (width - Math.min(620, width * 0.78)) / 2,
          top: meterShell?.offsetTop ?? height * 0.58
        };
        titleLayout = {
          width: title?.offsetWidth || Math.min(width * 0.82, 880),
          height: title?.offsetHeight || Math.min(height * 0.24, 190),
          left: title?.offsetLeft ?? width * 0.09,
          top: title?.offsetTop ?? height * 0.28
        };
      };

      const trimParticlePool = (particles, limit, seedOffset) => {
        while (particles.length > limit) {
          const index = Math.floor(
            randomSeed(particles.length * 1.371 + limit * 0.719 + seedOffset) * particles.length
          );
          particles[index] = particles[particles.length - 1];
          particles.pop();
        }
      };

      const updateRenderQuality = (timestamp, renderCost) => {
        if (!Number.isFinite(renderCost) || renderCost <= 0) return;
        renderCostEma = renderCostEma > 0
          ? renderCostEma * 0.92 + renderCost * 0.08
          : renderCost;
        if (timestamp - lastQualityAdjustment < 1200) return;
        lastQualityAdjustment = timestamp;
        const mobile = burstCanvasWidth > 0 ? burstCanvasWidth < 640 : window.innerWidth < 640;
        const highCost = mobile ? 13.5 : 16.5;
        const lowCost = mobile ? 7.4 : 9.2;
        if (renderCostEma > highCost && renderQuality > 0.7) {
          renderQuality = Math.max(0.7, renderQuality - 0.08);
          const width = burstCanvasWidth || window.innerWidth;
          trimParticlePool(
            wakeParticles,
            Math.floor((width < 640 ? 175 : 280) * (0.8 + renderQuality * 0.2)),
            11
          );
          trimParticlePool(
            orbitParticles,
            Math.floor((width < 640 ? 82 : 160) * renderQuality),
            23
          );
          trimParticlePool(
            burstParticles,
            Math.floor((width < 640 ? 120 : 220) * renderQuality),
            37
          );
          trimParticlePool(
            rainParticles,
            Math.floor((width < 640 ? 88 : 152) * renderQuality),
            53
          );
        } else if (renderCostEma < lowCost && renderQuality < 1) {
          renderQuality = Math.min(1, renderQuality + 0.035);
        }
      };

      const paintSingularityField = (context, timestamp, parameters) => {
        if (
          !singularityFieldContext
          || parameters.activity <= 0.001
          || parameters.opacity <= 0.001
        ) return false;

        const quality = clamp(parameters.quality, 0.7, 1);
        const activity = clamp(parameters.activity, 0, 1.35);
        const opacity = clamp(parameters.opacity, 0, 1);
        const compression = clamp(parameters.compression, 0, 1);
        const gravity = clamp(parameters.gravity, 0, 1);
        const radius = Math.max(5, parameters.radius);
        const time = timestamp / 1000;
        const fieldTargetSize = parameters.mobile
          ? (quality < 0.8 ? 68 : 80)
          : (quality < 0.8 ? 88 : 108);

        ensureSingularityFieldBuffer(fieldTargetSize);

        const minimumInterval = parameters.mobile
          ? 1000 / 30
          : quality < 0.8
            ? 1000 / 36
            : 1000 / 45;
        const paintGap = singularityFieldLastPaintTimestamp > 0
          ? timestamp - singularityFieldLastPaintTimestamp
          : Number.POSITIVE_INFINITY;
        const electricPulse = 0.5
          + Math.sin(time * (4.7 + activity * 2.4)) * 0.23
          + Math.sin(time * 10.9 + 1.7) * 0.11;

        if (paintGap >= minimumInterval && singularityFieldImageData) {
          singularityFieldLastPaintTimestamp = timestamp;
          const fieldSize = singularityFieldCanvas.width;
          const pixels = singularityFieldImageData.data;
          const inverseHalfSize = 2 / fieldSize;
          const fieldTime = time * (0.92 + activity * 0.18);
          let offset = 0;

          for (let y = 0; y < fieldSize; y += 1) {
            const normalizedY = (y + 0.5) * inverseHalfSize - 1;
            for (let x = 0; x < fieldSize; x += 1) {
              const normalizedX = (x + 0.5) * inverseHalfSize - 1;
              const fieldX = normalizedX;
              const fieldY = normalizedY;
              const angle = Math.atan2(fieldY, fieldX);
              const baseRadius = Math.hypot(fieldX, fieldY);
              const boundaryBreath = 0.5
                + Math.sin(fieldTime * 0.74) * 0.28
                + Math.sin(fieldTime * 1.31 + 1.2) * 0.12;
              const boundary = 0.95
                + Math.sin(angle * 2.17 + 0.82) * 0.034 * (0.82 + boundaryBreath * 0.18)
                + Math.sin(angle * 5.03 - 1.34) * 0.021 * (0.88 + boundaryBreath * 0.12)
                + Math.cos(angle * 8.11 + 0.37) * 0.011;
              const fieldRadius = baseRadius / Math.max(0.74, boundary);
              const outerMask = 1 - smoothstep(clamp((fieldRadius - 0.7) / 0.33, 0, 1));
              const throatRadius = 0.135
                + (1 - compression) * 0.032
                + Math.sin(angle * 2.73 + 1.88) * 0.008 * (0.8 + boundaryBreath * 0.2)
                + Math.sin(angle * 6.13 - 0.54) * 0.004;
              const innerMask = smoothstep(clamp((fieldRadius - throatRadius) / 0.19, 0, 1));
              const fieldMask = outerMask * innerMask;

              if (fieldMask <= 0.0005) {
                pixels[offset] = 0;
                pixels[offset + 1] = 0;
                pixels[offset + 2] = 0;
                pixels[offset + 3] = 0;
                offset += 4;
                continue;
              }

              const warpX = fieldX
                + Math.sin(fieldY * 5.2 + fieldTime * 0.82) * 0.11
                + Math.sin((fieldX + fieldY) * 3.7 - fieldTime * 0.43) * 0.046;
              const warpY = fieldY
                + Math.cos(fieldX * 4.8 - fieldTime * 0.74) * 0.1
                + Math.cos((fieldX - fieldY) * 3.35 + fieldTime * 0.51) * 0.044;
              const currentA = Math.sin(
                warpX * (8.1 + gravity * 1.2)
                + warpY * 3.2
                - fieldTime * (1.54 + gravity * 0.34)
                + Math.sin(warpY * 4.7 + fieldTime * 0.39) * 0.78
              );
              const currentB = Math.sin(
                warpY * 8.9
                - warpX * 2.85
                + fieldTime * 1.27
                + Math.cos(warpX * 5.1 - fieldTime * 0.36) * 0.72
              );
              const crossCurrent = Math.cos(
                (warpX + warpY) * 6.15
                - fieldTime * 0.93
                + Math.sin((warpX - warpY) * 4.4 + fieldTime * 0.31) * 0.64
              );
              const ridgeA = Math.pow(
                Math.max(0, 1 - Math.abs(currentA * 0.68 + currentB * 0.32 - 0.06) / 0.37),
                3.55
              );
              const ridgeB = Math.pow(
                Math.max(0, 1 - Math.abs(currentB * 0.58 - crossCurrent * 0.42 + 0.11) / 0.35),
                3.65
              );
              const mist = (
                0.5
                + Math.sin(warpX * 4.5 + warpY * 3.8 - fieldTime * 0.78) * 0.5
              ) * (0.11 + gravity * 0.045);
              const electric = Math.max(ridgeA, ridgeB * 0.9);
              const brightness = clamp(
                (electric * 0.92 + mist)
                * fieldMask
                * (0.72 + electricPulse * 0.22)
                * (1 - compression * 0.24),
                0,
                1
              );
              const hue = 0.5
                + Math.sin(warpX * 3.35 - warpY * 2.65 + fieldTime * 0.41 + crossCurrent * 0.72) * 0.5;
              const whiteHeat = Math.pow(electric, 4) * (0.28 + gravity * 0.26);

              pixels[offset] = Math.round(136 + hue * 103 + whiteHeat * 20);
              pixels[offset + 1] = Math.round(45 + electric * 96 + whiteHeat * 72);
              pixels[offset + 2] = Math.round(196 + (1 - hue) * 54 + whiteHeat * 5);
              pixels[offset + 3] = Math.round(255 * brightness * activity * 0.78);
              offset += 4;
            }
          }

          singularityFieldContext.setTransform(1, 0, 0, 1, 0, 0);
          singularityFieldContext.globalCompositeOperation = "source-over";
          singularityFieldContext.globalAlpha = 1;
          singularityFieldContext.putImageData(singularityFieldImageData, 0, 0);
        }

        const fieldWidth = radius * (3.88 + gravity * 0.34);
        const fieldHeight = radius * (3.56 + gravity * 0.3);
        context.save();
        context.globalCompositeOperation = "lighter";
        context.globalAlpha = opacity * activity * (0.82 + electricPulse * 0.18);
        context.imageSmoothingEnabled = true;
        context.drawImage(
          singularityFieldCanvas,
          -fieldWidth * 0.5,
          -fieldHeight * 0.5,
          fieldWidth,
          fieldHeight
        );
        context.restore();

        const streamCount = parameters.mobile ? 2 : 3;
        context.save();
        context.globalCompositeOperation = "lighter";
        context.lineCap = "round";
        context.lineJoin = "round";
        for (let stream = 0; stream < streamCount; stream += 1) {
          const seed = randomSeed(stream + 19421);
          const anchorAngle = seed * fullTurn + (stream - 1) * 0.43;
          for (let fragment = 0; fragment < 2; fragment += 1) {
            const travel = (time * (0.11 + seed * 0.045) + seed + fragment * 0.43) % 1;
            const startUnit = Math.max(0, travel - 0.075);
            const endUnit = Math.min(1, travel + 0.075);
            if (endUnit - startUnit < 0.035) continue;
            const points = [];
            const segments = 5;
            for (let segment = 0; segment <= segments; segment += 1) {
              const unit = startUnit + (endUnit - startUnit) * (segment / segments);
              const distance = radius * (
                1.72 - unit * (1.34 + seed * 0.12)
              ) * (1 - compression * (0.24 + unit * 0.38));
              const localBend = (seed - 0.5) * 0.34 * (1 - unit)
                + Math.sin(unit * 8.2 + time * (0.72 + seed * 0.24) + stream) * 0.035;
              const angle = anchorAngle + localBend;
              points.push({
                x: Math.cos(angle) * distance,
                y: Math.sin(angle) * distance * (0.9 + seed * 0.08)
              });
            }
            const path = createSmoothCanvasPath(points);
            const pulse = Math.sin(clamp((travel - startUnit) / Math.max(0.001, endUnit - startUnit), 0, 1) * Math.PI);
            context.globalAlpha = opacity
              * activity
              * (0.055 + pulse * 0.075)
              * (1 - compression * 0.58);
            context.strokeStyle = stream === 0
              ? "rgba(181, 211, 255, 0.72)"
              : "rgba(255, 91, 153, 0.76)";
            context.lineWidth = 1.05 + gravity * 0.72;
            context.shadowColor = context.strokeStyle;
            context.shadowBlur = (4 + gravity * 5) * parameters.shadowQuality;
            context.stroke(path);
          }
        }
        context.restore();

        const collapseScale = 1 - compression * 0.58;
        const driftX = Math.sin(time * 0.43) * radius * 0.007 * (1 - compression);
        const driftY = Math.sin(time * 0.37 + 1.74) * radius * 0.006 * (1 - compression);
        const buildVoidPath = (scale, phaseOffset, roughness = 1, aspect = 0.96) => {
          const points = [];
          const pointCount = parameters.mobile ? 18 : 24;
          const radiusX = radius * scale * collapseScale;
          const radiusY = radius * scale * aspect * collapseScale;
          const contourBreath = 0.78
            + Math.sin(time * 0.66 + phaseOffset) * 0.12
            + Math.sin(time * 1.17 + phaseOffset * 0.43) * 0.06;
          for (let index = 0; index < pointCount; index += 1) {
            const angle = index / pointCount * fullTurn;
            const wobble = 1
              + Math.sin(angle * 2.13 + phaseOffset)
                * (0.028 + gravity * 0.008) * roughness * contourBreath
              + Math.sin(angle * 5.07 - phaseOffset * 1.31)
                * 0.016 * roughness
              + Math.cos(angle * 8.17 + phaseOffset * 0.67)
                * 0.008 * roughness;
            points.push({
              x: driftX * (1 - scale * 0.32) + Math.cos(angle) * radiusX * wobble,
              y: driftY * (1 - scale * 0.28) + Math.sin(angle) * radiusY * wobble
            });
          }
          return createClosedCanvasPath(points);
        };

        context.save();
        context.globalCompositeOperation = "source-over";
        const absorptionVeilRadius = radius * 1.46 * collapseScale;
        const absorptionVeil = context.createRadialGradient(
          driftX * 0.42,
          driftY * 0.42,
          0,
          0,
          0,
          absorptionVeilRadius
        );
        absorptionVeil.addColorStop(0, "rgba(0,0,4,0.82)");
        absorptionVeil.addColorStop(0.48, "rgba(3,1,10,0.46)");
        absorptionVeil.addColorStop(0.8, "rgba(11,3,22,0.16)");
        absorptionVeil.addColorStop(1, "rgba(8,2,18,0)");
        context.globalAlpha = opacity * (0.44 + gravity * 0.13 + compression * 0.08);
        context.fillStyle = absorptionVeil;
        context.fill(buildVoidPath(1.42, 0.84, 1.52));

        const cloudCount = parameters.mobile ? 7 : 10;
        for (let cloud = 0; cloud < cloudCount; cloud += 1) {
          const seed = randomSeed(cloud + 19747);
          const cloudAngle = seed * fullTurn + (cloud % 3 - 1) * 0.18;
          const inwardPulse = 0.5 + Math.sin(time * (0.38 + seed * 0.24) + seed * 13.7) * 0.5;
          const cloudDistance = radius
            * (0.035 + seed * 0.19)
            * (0.76 + inwardPulse * 0.24)
            * (1 - compression * 0.76);
          const cloudX = driftX + Math.cos(cloudAngle) * cloudDistance;
          const cloudY = driftY + Math.sin(cloudAngle) * cloudDistance * 0.9;
          const cloudRadius = radius * collapseScale * (0.38 + seed * 0.46);
          const cloudFlatten = 0.74 + randomSeed(cloud + 19789) * 0.2;
          context.save();
          context.translate(cloudX, cloudY);
          context.rotate(cloudAngle * 0.16 + Math.sin(time * 0.31 + cloud) * 0.035);
          context.scale(1, cloudFlatten);
          const cloudGradient = context.createRadialGradient(0, 0, 0, 0, 0, cloudRadius);
          cloudGradient.addColorStop(0, "rgba(0,0,3,0.88)");
          cloudGradient.addColorStop(0.42, "rgba(1,0,6,0.62)");
          cloudGradient.addColorStop(0.74, "rgba(7,2,16,0.2)");
          cloudGradient.addColorStop(1, "rgba(9,3,18,0)");
          context.globalAlpha = opacity * (0.23 + seed * 0.17 + compression * 0.055);
          context.fillStyle = cloudGradient;
          context.fillRect(-cloudRadius, -cloudRadius, cloudRadius * 2, cloudRadius * 2);
          context.restore();
        }

        context.save();
        context.globalCompositeOperation = "source-over";
        const voidLayers = [
          {
            scale: 0.39,
            phase: 0.84,
            roughness: 1.55,
            aspect: 0.97,
            alpha: 0.16,
            fill: "rgba(7,2,18,0.9)",
            blur: radius * 0.12,
            offsetX: -0.038,
            offsetY: 0.016
          },
          {
            scale: 0.31,
            phase: 1.92,
            roughness: 2.2,
            aspect: 0.94,
            alpha: 0.4,
            fill: "rgba(2,0,8,0.96)",
            blur: radius * 0.075,
            offsetX: 0.028,
            offsetY: -0.021
          },
          {
            scale: 0.235,
            phase: 3.67,
            roughness: 3.25,
            aspect: 0.9,
            alpha: 0.68,
            fill: "rgba(0,0,2,0.99)",
            blur: radius * 0.026,
            offsetX: -0.014,
            offsetY: 0.025
          },
          {
            scale: 0.082,
            phase: 5.18,
            roughness: 4.6,
            aspect: 0.86,
            alpha: 0.94,
            fill: "rgba(0,0,0,0.998)",
            blur: 0,
            offsetX: 0.022,
            offsetY: -0.012
          }
        ];
        for (const layer of voidLayers) {
          context.save();
          context.translate(radius * layer.offsetX, radius * layer.offsetY);
          context.globalAlpha = opacity
            * layer.alpha
            * (0.92 + compression * 0.08);
          context.fillStyle = layer.fill;
          context.shadowColor = layer.fill;
          context.shadowBlur = layer.blur * parameters.shadowQuality;
          context.fill(buildVoidPath(
            layer.scale,
            layer.phase,
            layer.roughness,
            layer.aspect
          ));
          context.restore();
        }
        context.shadowBlur = 0;
        context.restore();
        context.restore();

        context.save();
        context.globalCompositeOperation = "lighter";
        context.lineCap = "round";
        for (let arc = 0; arc < 2; arc += 1) {
          const seed = randomSeed(arc + 19681);
          const start = seed * fullTurn + arc * 0.71;
          const span = 0.24 + seed * 0.22;
          const points = [];
          const segments = 6;
          for (let segment = 0; segment <= segments; segment += 1) {
            const unit = segment / segments;
            const angle = start + span * unit;
            const edgeRadius = radius * collapseScale * (
              0.96
              + Math.sin(angle * 4.7 + arc * 1.8) * 0.028
              + Math.sin(time * (0.86 + seed * 0.34) + unit * Math.PI) * 0.012
            );
            points.push({
              x: driftX + Math.cos(angle) * edgeRadius,
              y: driftY + Math.sin(angle) * edgeRadius * 0.95
            });
          }
          const edgePath = createSmoothCanvasPath(points);
          const flicker = Math.pow(
            0.5 + Math.sin(time * (1.7 + seed * 0.8) + seed * 19.4) * 0.5,
            2.2
          );
          context.globalAlpha = opacity
            * (0.035 + gravity * 0.055)
            * (0.34 + flicker * 0.66)
            * (1 - compression * 0.48);
          context.strokeStyle = arc % 2 === 0
            ? "rgba(255, 112, 165, 0.86)"
            : "rgba(182, 211, 255, 0.78)";
          context.lineWidth = 0.5 + gravity * 0.42;
          context.shadowColor = context.strokeStyle;
          context.shadowBlur = (3 + gravity * 5) * parameters.shadowQuality;
          context.stroke(edgePath);
        }
        context.restore();
        return true;
      };

      const drawScreenEnergy = (timestamp) => {
        if (!burstCanvas || !burstContext) return;
        if (burstCanvasWidth <= 0 || burstCanvasHeight <= 0) resizeBurstCanvas();
        const width = burstCanvasWidth;
        const height = burstCanvasHeight;
        const context = burstContext;
        context.clearRect(0, 0, width, height);
        if (width <= 1 || height <= 1) return;

        const frameSeconds = screenParticleTimestamp
          ? clamp((timestamp - screenParticleTimestamp) / 1000, 0.008, 0.05)
          : 1 / 60;
        screenParticleTimestamp = timestamp;
        const time = timestamp / 1000;
        const fill = Math.max(energyProgress, 0.012);
        const burst = clamp(burstProgress, 0, 1);
        const intensity = 0.12 + fill * 0.88;
        const densityScale = (width < 640 ? 0.62 : width < 960 ? 0.82 : 1) * renderQuality;
        const shadowQuality = renderQuality;
        const meterWidth = meterLayout.width || Math.min(620, width * 0.78);
        const meterHeight = meterLayout.height || 68;
        const meterLeft = meterLayout.left || (width - meterWidth) / 2;
        const meterTop = meterLayout.top || height * 0.58;
        const localFrontRadius = 5 + fill * 22;
        const localFrontX = clamp(
          meterWidth * fill,
          3,
          Math.max(3, meterWidth - localFrontRadius * 2.2)
        );
        const angleRadians = beamPose.angle * Math.PI / 180;
        const headOffset = (localFrontX - meterWidth * 0.5) * beamPose.scaleX;
        const chargeFlight = getChargeFlightGeometry(chargeIntroProgress, width, height);
        const rigidOriginX = clamp(
          meterLeft + meterWidth * 0.5 + beamPose.anchorX + Math.cos(angleRadians) * headOffset,
          width * 0.04,
          width * 0.96
        );
        const rigidOriginY = clamp(
          meterTop + meterHeight * 0.5 + beamPose.anchorY + beamPose.lift + Math.sin(angleRadians) * headOffset,
          height * 0.08,
          height * 0.92
        );
        const flightBlend = phaseProgress(chargeIntroProgress, 0.14, 0.22);
        const stableOriginX = rigidOriginX + (chargeFlight.head.x - rigidOriginX) * flightBlend;
        const stableOriginY = rigidOriginY + (chargeFlight.head.y - rigidOriginY) * flightBlend;
        const originX = clamp(stableOriginX + beamPose.shakeX * 0.36, width * 0.04, width * 0.96);
        const originY = clamp(stableOriginY + beamPose.shakeY * 0.36, height * 0.08, height * 0.92);
        const headFrameSeconds = beamHeadTimestamp
          ? clamp((timestamp - beamHeadTimestamp) / 1000, 0.008, 0.05)
          : frameSeconds;
        if (!beamHeadTimestamp || fill <= 0.018) {
          beamHeadX = stableOriginX;
          beamHeadY = stableOriginY;
          beamHeadVelocityX = 0;
          beamHeadVelocityY = 0;
          beamMotionEnergy = 0;
        } else {
          let rawVelocityX = (stableOriginX - beamHeadX) / headFrameSeconds;
          let rawVelocityY = (stableOriginY - beamHeadY) / headFrameSeconds;
          const rawSpeed = Math.hypot(rawVelocityX, rawVelocityY);
          if (rawSpeed > 980) {
            const speedScale = 980 / rawSpeed;
            rawVelocityX *= speedScale;
            rawVelocityY *= speedScale;
          }
          const velocityResponse = 1 - Math.exp(-headFrameSeconds * 10.5);
          beamHeadVelocityX += (rawVelocityX - beamHeadVelocityX) * velocityResponse;
          beamHeadVelocityY += (rawVelocityY - beamHeadVelocityY) * velocityResponse;
          const motionTarget = clamp(Math.hypot(beamHeadVelocityX, beamHeadVelocityY) / 620, 0, 1);
          const motionResponse = 1 - Math.exp(-headFrameSeconds * (motionTarget < beamMotionEnergy ? 8.5 : 5.8));
          beamMotionEnergy += (motionTarget - beamMotionEnergy) * motionResponse;
          beamHeadX = stableOriginX;
          beamHeadY = stableOriginY;
        }
        beamHeadTimestamp = timestamp;
        const maxRadius = Math.hypot(width, height) * 1.18;
        const dissolve = phaseProgress(burst, 0.015, 0.14);
        const releaseBuild = phaseProgress(burst, crossEnd, reformEnd);
        const releasePressure = phaseProgress(burst, 0.855, shockwaveStart);
        const shockwaveLinear = clamp((burst - shockwaveStart) / (detonationStart - shockwaveStart), 0, 1);
        const shockwave = smoothstep(shockwaveLinear);
        const detonationLinear = clamp((burst - detonationStart) / (detonationEnd - detonationStart), 0, 1);
        const detonation = smoothstep(detonationLinear);
        const rainBuild = phaseProgress(burst, rainStart, rainPeak);
        const rainStop = phaseProgress(burst, rainPeak, 1);
        const wakeOpacity = clamp(1 - dissolve, 0, 1);
        const afterglow = phaseProgress(burst, detonationStart, detonationEnd)
          * (1 - phaseProgress(burst, rainPeak, 1));
        const aftermath = phaseProgress(burst, detonationStart + 0.006, detonationEnd)
          * (1 - phaseProgress(burst, rainPeak, 1));
        const handoffLinear = clamp(
          (burst - blackHoleIngressStart) / (blackHoleCoreEnd - blackHoleIngressStart),
          0,
          1
        );
        const handoffCompression = 1 - Math.pow(1 - handoffLinear, 2.4);
        const handoffPulse = Math.pow(Math.sin(handoffLinear * Math.PI), 1.3);
        const blackHoleCoreBuild = smoothstep(handoffLinear);
        const blackHoleDiskLinear = clamp(
          (burst - blackHoleDiskStart) / (blackHoleDiskEnd - blackHoleDiskStart),
          0,
          1
        );
        const blackHoleDiskBuild = smoothstep(blackHoleDiskLinear);
        const blackHoleDiskThrow = 1 - Math.pow(1 - blackHoleDiskLinear, 3.1);
        const blackHoleDiskOvershoot = Math.sin(blackHoleDiskLinear * Math.PI)
          * (1 - blackHoleDiskLinear * 0.24)
          * 0.12;
        const blackHoleDiskFlashPulse = Math.pow(
          Math.sin(blackHoleDiskLinear * Math.PI),
          1.28
        );
        const blackHoleDiskSpread = clamp(
          0.12 + blackHoleDiskThrow * 0.88 + blackHoleDiskOvershoot,
          0.12,
          1.1
        );
        const blackHoleDiskThickness = 0.28 + blackHoleDiskBuild * 0.72;
        const blackHoleOrbitBuild = phaseProgress(
          burst,
          blackHoleOrbitStart,
          blackHoleOrbitEnd
        );
        const blackHoleFieldBuild = phaseProgress(
          burst,
          blackHoleFieldStart,
          blackHoleFieldEnd
        );
        const gravityLock = phaseProgress(burst, collapseStart - 0.005, collapseEnd);
        const collapse = phaseProgress(burst, collapseStart, collapseEnd);
        const collapseDepth = Math.pow(collapse, 1.48);
        const terminalCrush = phaseProgress(collapse, 0.62, 1);
        const crushCompression = Math.pow(terminalCrush, 1.85);
        const blackHoleFade = 1 - phaseProgress(
          detonationLinear,
          0.18,
          0.92
        );
        const blackHoleDiskFlash = blackHoleDiskFlashPulse * blackHoleFade;
        const blackHoleCoreOpacity = blackHoleCoreBuild * blackHoleFade;
        const blackHoleDiskOpacity = blackHoleDiskBuild * blackHoleFade;
        const blackHoleOrbitOpacity = blackHoleOrbitBuild * blackHoleFade;
        const blackHoleFieldOpacity = blackHoleFieldBuild * blackHoleFade;
        const blackHoleOpacity = Math.max(
          blackHoleCoreOpacity,
          blackHoleDiskOpacity,
          blackHoleFieldOpacity
        );
        const blackHoleAngle = -0.16 - collapseDepth * 0.16;

        context.save();
        context.globalCompositeOperation = "lighter";

        if (wakeOpacity > 0.001) {
          const ambientCount = Math.floor((10 + fill * 34) * densityScale);
          for (let index = 0; index < ambientCount; index += 1) {
            const seedX = randomSeed(index + 1201);
            const seedY = randomSeed(index + 1801);
            const speed = 0.18 + seedX * (0.28 + fill * 0.56);
            let x = (seedX * width + Math.sin(time * speed + index) * (5 + fill * 17) + width) % width;
            let y = (seedY * height + Math.cos(time * (speed + 0.17) + index) * (4 + fill * 13) + height) % height;
            const size = 0.42 + seedY * (0.6 + fill * 1.25);
            const gravityX = originX - x;
            const gravityY = originY - y;
            const gravityDistance = Math.max(1, Math.hypot(gravityX, gravityY));
            const gravityFalloff = 1 - clamp(gravityDistance / maxRadius, 0, 1);
            const screenPull = gravityLock * gravityFalloff
              * (0.018 + collapseDepth * 0.12 + crushCompression * 0.075 + shockwave * 0.018);
            x += gravityX * screenPull;
            y += gravityY * screenPull;
            context.globalAlpha = (0.018 + seedX * 0.085) * intensity * wakeOpacity;
            context.fillStyle = fill > 0.56 && index % 3 !== 0 ? "#ff9caf" : "#c5d8ff";
            if (gravityLock > 0.025) {
              const inverseDistance = 1 / gravityDistance;
              const streakLength = gravityLock * gravityFalloff * (3 + seedX * 16);
              context.globalAlpha *= 0.72 + gravityLock * 0.48;
              context.strokeStyle = context.fillStyle;
              context.lineWidth = 0.45 + size * 0.38;
              context.lineCap = "round";
              context.beginPath();
              context.moveTo(x - gravityX * inverseDistance * streakLength, y - gravityY * inverseDistance * streakLength);
              context.lineTo(x, y);
              context.stroke();
            }
            context.beginPath();
            context.arc(x, y, size, 0, Math.PI * 2);
            context.fill();
          }
        }

        if (renderLegacyChargeBeam) {
          const chargeFlightOpacity = phaseProgress(
            chargeIntroProgress,
            chargeHandoffStart,
            chargeHandoffEnd
          )
            * (1 - phaseProgress(chargeIntroProgress, 0.86, 1));
          drawChargeFlightBeam(
            context,
            timestamp,
            chargeFlight,
            chargeFlightOpacity,
            intensity,
            width
          );
        }

        if (fill <= 0.018) wakePrimed = false;
        if (!renderLegacyChargeBeam) {
          wakePrimed = false;
          wakeEmissionBudget = 0;
          if (wakeParticles.length) wakeParticles.length = 0;
        }
        const wakeLimit = Math.floor((width < 640 ? 175 : 280) * (0.8 + renderQuality * 0.2));
        const forwardX = Math.cos(angleRadians);
        const forwardY = Math.sin(angleRadians);
        const normalX = -forwardY;
        const normalY = forwardX;
        const spawnWakeParticle = (launchBoost = 1, primed = false) => {
          const sideNoise = nextParticleRandom() + nextParticleRandom() - 1;
          const sideDirection = sideNoise >= 0 ? 1 : -1;
          const inheritedMotion = 0.64 + nextParticleRandom() * 0.24;
          const slipSpeed = (24 + fill * 72 + nextParticleRandom() * 46) * launchBoost;
          const sideSpeed = sideNoise * (10 + fill * 42)
            * (0.52 + nextParticleRandom() * 0.76)
            * Math.sqrt(launchBoost);
          const exhaustAcceleration = (92 + fill * 238 + nextParticleRandom() * 118) * launchBoost;
          const lateralAcceleration = sideDirection * (22 + fill * 92)
            * (0.42 + Math.abs(sideNoise) * 0.9 + nextParticleRandom() * 0.32);
          let velocityX = beamHeadVelocityX * inheritedMotion - forwardX * slipSpeed + normalX * sideSpeed;
          let velocityY = beamHeadVelocityY * inheritedMotion - forwardY * slipSpeed + normalY * sideSpeed;
          const startGap = 2 + localFrontRadius * 0.3;
          const sideOffset = sideNoise * localFrontRadius * (0.08 + nextParticleRandom() * 0.2);
          const startX = originX - forwardX * startGap + normalX * sideOffset;
          const startY = originY - forwardY * startGap + normalY * sideOffset;
          const warmup = primed ? nextParticleRandom() * (0.08 + fill * 0.22) : 0;
          const warmupExhaust = exhaustAcceleration * warmup;
          const warmupLateral = lateralAcceleration * warmup;
          const x = startX + velocityX * warmup
            - forwardX * warmupExhaust * warmup * 0.5
            + normalX * warmupLateral * warmup * 0.5;
          const y = startY + velocityY * warmup
            - forwardY * warmupExhaust * warmup * 0.5
            + normalY * warmupLateral * warmup * 0.5;
          velocityX += -forwardX * warmupExhaust + normalX * warmupLateral;
          velocityY += -forwardY * warmupExhaust + normalY * warmupLateral;
          const historySeconds = Math.min(frameSeconds, 0.022) * (1.1 + nextParticleRandom() * 0.8);
          wakeParticles.push({
            x,
            y,
            previousX: x - velocityX * historySeconds,
            previousY: y - velocityY * historySeconds,
            velocityX,
            velocityY,
            age: warmup,
            jetLife: 0.58 + nextParticleRandom() * 0.66,
            coastLife: 1.45 + nextParticleRandom() * 1.65,
            life: 7.8 + nextParticleRandom() * 5.6,
            size: 0.58 + nextParticleRandom() * (1 + fill * 1.48),
            phase: nextParticleRandom() * Math.PI * 2,
            curl: (nextParticleRandom() - 0.5) * 2,
            forwardX,
            forwardY,
            normalX,
            normalY,
            exhaustAcceleration,
            lateralAcceleration,
            tint: Math.floor(nextParticleRandom() * 5)
          });
        };

        if (
          renderLegacyChargeBeam
          && !reducedMotion
          && wakeOpacity > 0.02
          && fill > 0.025
          && burst < 0.02
        ) {
          if (!wakePrimed) {
            wakePrimed = true;
            const primeCount = width < 640 ? 18 : width < 960 ? 24 : 30;
            for (let index = 0; index < primeCount && wakeParticles.length < wakeLimit; index += 1) {
              spawnWakeParticle(1.04 + nextParticleRandom() * 0.24, true);
            }
          }
          wakeEmissionBudget += frameSeconds * (14 + fill * 48 + beamMotionEnergy * 44) * densityScale;
          while (wakeEmissionBudget >= 1 && wakeParticles.length < wakeLimit) {
            wakeEmissionBudget -= 1;
            spawnWakeParticle(1 + fill * 0.12 + beamMotionEnergy * 0.12);
          }
        } else {
          wakeEmissionBudget = Math.min(wakeEmissionBudget, 0.95);
        }

        if ((!renderLegacyChargeBeam || wakeOpacity <= 0.001) && wakeParticles.length) {
          wakeParticles.length = 0;
        }

        for (let index = wakeParticles.length - 1; index >= 0; index -= 1) {
          const particle = wakeParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life) {
            wakeParticles[index] = wakeParticles[wakeParticles.length - 1];
            wakeParticles.pop();
            continue;
          }

          particle.previousX = particle.x;
          particle.previousY = particle.y;
          const inJet = particle.age < particle.jetLife;
          const inCoast = particle.age < particle.jetLife + particle.coastLife;
          const jetProgress = clamp(particle.age / particle.jetLife, 0, 1);
          const drag = Math.exp(-frameSeconds * (inJet ? 0.46 : inCoast ? 0.14 : 0.08));
          particle.velocityX *= drag;
          particle.velocityY *= drag;
          if (inJet) {
            const exhaustForce = particle.exhaustAcceleration * (0.52 + (1 - jetProgress) * 0.48);
            const separationForce = particle.lateralAcceleration * (0.24 + jetProgress * 0.76);
            particle.velocityX += (-particle.forwardX * exhaustForce + particle.normalX * separationForce) * frameSeconds;
            particle.velocityY += (-particle.forwardY * exhaustForce + particle.normalY * separationForce) * frameSeconds;
          }
          const particleSpeed = Math.max(1, Math.hypot(particle.velocityX, particle.velocityY));
          const curveX = -particle.velocityY / particleSpeed;
          const curveY = particle.velocityX / particleSpeed;
          if (inCoast) {
            const curveStrength = particle.curl * (inJet ? 2.6 : 3.6) * (0.45 + particle.size * 0.24);
            particle.velocityX += curveX * curveStrength * frameSeconds;
            particle.velocityY += curveY * curveStrength * frameSeconds;
          } else {
            const driftAge = particle.age - particle.jetLife;
            particle.velocityX += Math.sin(particle.phase + driftAge * (0.54 + particle.size * 0.08))
              * frameSeconds * (3.2 + particle.size * 1.4);
            particle.velocityY += Math.cos(particle.phase * 0.73 + driftAge * 0.46)
              * frameSeconds * (2.1 + particle.size * 0.9);
            particle.velocityY -= frameSeconds * (0.52 + particle.size * 0.18);
          }
          particle.x += particle.velocityX * frameSeconds;
          particle.y += particle.velocityY * frameSeconds;

          if (!inJet && !inCoast) {
            if (particle.x < 10 && particle.velocityX < 0) particle.velocityX *= -0.46;
            if (particle.x > width - 10 && particle.velocityX > 0) particle.velocityX *= -0.46;
            if (particle.y < 10 && particle.velocityY < 0) particle.velocityY *= -0.42;
            if (particle.y > height - 10 && particle.velocityY > 0) particle.velocityY *= -0.42;
            particle.x = clamp(particle.x, -20, width + 20);
            particle.y = clamp(particle.y, -20, height + 20);
          }

          const lifeRatio = particle.age / particle.life;
          const fadeIn = smoothstep(clamp(particle.age / 0.14, 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeRatio - 0.74) / 0.26, 0, 1));
          const alpha = fadeIn * fadeOut * (inJet ? 0.68 : inCoast ? 0.54 : 0.42)
            * intensity * wakeOpacity;
          if (alpha <= 0.004) continue;

          context.globalAlpha = alpha;
          context.strokeStyle = particle.tint === 0
            ? "#ffffff"
            : particle.tint < 3
              ? "#ff9bb1"
              : "#bfd6ff";
          context.fillStyle = context.strokeStyle;
          context.lineCap = "round";
          if (inJet || inCoast) {
            const coastFade = inJet ? 1 : 1 - clamp((particle.age - particle.jetLife) / particle.coastLife, 0, 1) * 0.34;
            const trailScale = inJet ? 1.9 + beamMotionEnergy * 0.8 : 1.3;
            const motionX = particle.x - particle.previousX;
            const motionY = particle.y - particle.previousY;
            context.globalAlpha = alpha * coastFade;
            context.lineWidth = particle.size * (inJet ? 0.78 : 0.62);
            context.beginPath();
            context.moveTo(
              particle.previousX - motionX * (trailScale - 1),
              particle.previousY - motionY * (trailScale - 1)
            );
            context.lineTo(particle.x, particle.y);
            context.stroke();
          } else {
            const pulse = 0.76 + Math.sin(time * 1.2 + particle.phase) * 0.24;
            context.globalAlpha = alpha * pulse;
            context.beginPath();
            context.arc(particle.x, particle.y, particle.size * (0.46 + pulse * 0.22), 0, Math.PI * 2);
            context.fill();
          }
        }

        const viewportScale = Math.min(width, height);
        const baseCoreRadius = clamp(viewportScale * 0.09, 28, 82);
        const coreRadius = baseCoreRadius
          * (0.32 + blackHoleCoreBuild * 0.72 + handoffPulse * 0.08)
          * (1 - collapseDepth * 0.58)
          * (1 - crushCompression * 0.48)
          * (1 + shockwave * 0.05);
        const diskRadius = coreRadius
          * (3.12 + blackHoleDiskBuild * 0.62)
          * (1 - collapseDepth * 0.18)
          * (1 - crushCompression * 0.16)
          * (1 + shockwave * 0.11);
        const diskFlatten = Math.max(
          0.105,
          (0.27 + blackHoleDiskBuild * 0.055) * (1 - collapseDepth * 0.48 - crushCompression * 0.12)
        );
        const renderedDiskRadiusX = diskRadius * blackHoleDiskSpread;
        const renderedDiskRadiusY = diskRadius * diskFlatten * blackHoleDiskThickness;

        const orbitLimit = Math.floor((width < 640 ? 82 : 160) * renderQuality);
        const orbitDrive = blackHoleOrbitOpacity * (1 - detonationLinear) * (1 - crushCompression * 0.78);
        if (!reducedMotion && releaseMode !== "rewinding" && orbitDrive > 0.01) {
          orbitEmissionBudget += frameSeconds
            * (18 + gravityLock * 86 + releaseVisualPressure * 46)
            * densityScale;
          while (orbitEmissionBudget >= 1 && orbitParticles.length < orbitLimit) {
            orbitEmissionBudget -= 1;
            orbitParticles.push({
              angle: nextParticleRandom() * Math.PI * 2,
              radius: diskRadius * (1.05 + nextParticleRandom() * 1.55),
              angularVelocity: (0.16 + nextParticleRandom() * 0.34) * (nextParticleRandom() > 0.16 ? 1 : -1),
              radialSpeed: 10 + nextParticleRandom() * 18,
              lane: 0.74 + nextParticleRandom() * 0.34,
              age: 0,
              life: 4.8 + nextParticleRandom() * 5.4,
              size: 0.45 + nextParticleRandom() * 1.35,
              escape: nextParticleRandom() < 0.18,
              tint: Math.floor(nextParticleRandom() * 6)
            });
          }
        } else {
          orbitEmissionBudget = Math.min(orbitEmissionBudget, 0.95);
        }

        const projectOrbit = (angle, radius, lane) => {
          const localX = Math.cos(angle) * radius;
          const localY = Math.sin(angle) * radius * diskFlatten * lane;
          return {
            x: originX + localX * Math.cos(blackHoleAngle) - localY * Math.sin(blackHoleAngle),
            y: originY + localX * Math.sin(blackHoleAngle) + localY * Math.cos(blackHoleAngle)
          };
        };

        for (let index = orbitParticles.length - 1; index >= 0; index -= 1) {
          const particle = orbitParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life || blackHoleOpacity <= 0.001) {
            orbitParticles[index] = orbitParticles[orbitParticles.length - 1];
            orbitParticles.pop();
            continue;
          }
          const previousAngle = particle.angle;
          const previousRadius = particle.radius;
          const orbitAcceleration = 1 + gravityLock * 0.9 + collapseDepth * 0.8 + crushCompression * 1.4;
          particle.angle += particle.angularVelocity * frameSeconds * orbitAcceleration
            * Math.pow(diskRadius / Math.max(coreRadius, particle.radius), 0.46);
          particle.radius -= (
            particle.radialSpeed
            + gravityLock * (11 + particle.size * 7)
            + collapseDepth * (32 + particle.size * 12)
            + crushCompression * (115 + particle.size * 42)
          ) * frameSeconds;

          if (particle.radius <= coreRadius * 1.12) {
            if (
              particle.escape
              && gravityLock > 0.54
              && detonationLinear <= 0.001
              && burstParticles.length < (width < 640 ? 110 : 210)
            ) {
              const escapePoint = projectOrbit(particle.angle, coreRadius * 1.18, particle.lane);
              const tangentAngle = particle.angle + (particle.angularVelocity > 0 ? Math.PI / 2 : -Math.PI / 2) + blackHoleAngle;
              const escapeSpeed = 150 + gravityLock * 260 + nextParticleRandom() * 120;
              burstParticles.push({
                x: escapePoint.x,
                y: escapePoint.y,
                previousX: escapePoint.x,
                previousY: escapePoint.y,
                velocityX: Math.cos(tangentAngle) * escapeSpeed + Math.cos(blackHoleAngle) * escapeSpeed * 0.18,
                velocityY: Math.sin(tangentAngle) * escapeSpeed + Math.sin(blackHoleAngle) * escapeSpeed * 0.18,
                age: 0,
                life: 2.8 + nextParticleRandom() * 3.6,
                size: particle.size * (0.9 + nextParticleRandom() * 0.8),
                drag: 0.3 + nextParticleRandom() * 0.42,
                gravity: 4 + nextParticleRandom() * 14,
                phase: nextParticleRandom() * Math.PI * 2,
                tint: particle.tint,
                shape: nextParticleRandom()
              });
              orbitParticles[index] = orbitParticles[orbitParticles.length - 1];
              orbitParticles.pop();
              continue;
            }
            if (burst < detonationStart && blackHoleOpacity > 0.2 && terminalCrush < 0.72) {
              particle.radius = diskRadius * (1.6 + nextParticleRandom() * 0.92);
              particle.angle += Math.PI * (0.42 + nextParticleRandom() * 0.34);
            } else {
              orbitParticles[index] = orbitParticles[orbitParticles.length - 1];
              orbitParticles.pop();
              continue;
            }
          }

          const previousPoint = projectOrbit(previousAngle, previousRadius, particle.lane);
          const point = projectOrbit(particle.angle, particle.radius, particle.lane);
          particle.previousRenderX = previousPoint.x;
          particle.previousRenderY = previousPoint.y;
          particle.renderX = point.x;
          particle.renderY = point.y;
          particle.depth = Math.sin(particle.angle);
        }

        const drawOrbitParticle = (particle) => {
          const lifeRatio = particle.age / particle.life;
          const fadeIn = smoothstep(clamp(particle.age / 0.14, 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeRatio - 0.72) / 0.28, 0, 1));
          const coreProximity = clamp((particle.radius - coreRadius) / Math.max(1, diskRadius * 1.55), 0, 1);
          context.globalAlpha = fadeIn * fadeOut * blackHoleOrbitOpacity * (0.28 + (1 - coreProximity) * 0.56);
          context.strokeStyle = particle.tint === 0
            ? "#ffffff"
            : particle.tint < 4
              ? "#ff89a9"
              : "#b9d4ff";
          context.fillStyle = context.strokeStyle;
          context.lineWidth = particle.size * (0.58 + gravityLock * 0.38);
          context.lineCap = "round";
          context.beginPath();
          context.moveTo(particle.previousRenderX, particle.previousRenderY);
          context.lineTo(particle.renderX, particle.renderY);
          context.stroke();
          if (particle.size > 1.12) {
            context.globalAlpha *= 0.48;
            context.beginPath();
            context.arc(particle.renderX, particle.renderY, particle.size * 0.4, 0, Math.PI * 2);
            context.fill();
          }
        };

        if (blackHoleOpacity > 0.001) {
          if (handoffPulse > 0.001) {
            context.save();
            context.globalCompositeOperation = "lighter";
            const implosionRadius = baseCoreRadius * (1.72 - handoffCompression * 1.2);
            const implosionGlowRadius = baseCoreRadius * (0.56 + handoffPulse * 0.32);
            const implosionGlow = context.createRadialGradient(
              originX,
              originY,
              0,
              originX,
              originY,
              implosionGlowRadius
            );
            implosionGlow.addColorStop(0, "rgba(255,255,255,0.98)");
            implosionGlow.addColorStop(0.18, "rgba(255,225,236,0.88)");
            implosionGlow.addColorStop(0.5, "rgba(255,65,127,0.38)");
            implosionGlow.addColorStop(1, "rgba(255,65,127,0)");
            context.globalAlpha = handoffPulse * blackHoleFade * 0.86;
            context.fillStyle = implosionGlow;
            context.fillRect(
              originX - implosionGlowRadius,
              originY - implosionGlowRadius,
              implosionGlowRadius * 2,
              implosionGlowRadius * 2
            );

            context.strokeStyle = "rgba(255,226,237,0.92)";
            context.lineWidth = 0.8 + handoffPulse * 2.4;
            context.shadowColor = "rgba(255,65,127,0.96)";
            context.shadowBlur = (7 + handoffPulse * 15) * shadowQuality;
            context.globalAlpha = handoffPulse * blackHoleFade * 0.68;
            context.beginPath();
            context.ellipse(
              originX,
              originY,
              implosionRadius,
              implosionRadius * (0.62 + handoffCompression * 0.12),
              blackHoleAngle,
              0,
              Math.PI * 2
            );
            context.stroke();

            for (let shard = 0; shard < 8; shard += 1) {
              const seed = randomSeed(shard + 24811);
              const angle = seed * Math.PI * 2 + blackHoleAngle;
              const outerRadius = baseCoreRadius
                * (1.45 + seed * 0.82)
                * (1 - handoffCompression * 0.68);
              const innerRadius = baseCoreRadius * (0.1 + seed * 0.12);
              const startX = originX + Math.cos(angle) * outerRadius;
              const startY = originY + Math.sin(angle) * outerRadius * 0.7;
              const endX = originX + Math.cos(angle) * innerRadius;
              const endY = originY + Math.sin(angle) * innerRadius * 0.7;
              const shardGradient = context.createLinearGradient(startX, startY, endX, endY);
              shardGradient.addColorStop(
                0,
                shard % 3 === 0 ? "rgba(174,205,255,0)" : "rgba(255,92,146,0)"
              );
              shardGradient.addColorStop(
                0.58,
                shard % 3 === 0
                  ? "rgba(190,216,255,0.44)"
                  : "rgba(255,105,153,0.46)"
              );
              shardGradient.addColorStop(1, "rgba(255,248,251,0.94)");
              context.globalAlpha = handoffPulse * blackHoleFade * (0.22 + seed * 0.34);
              context.strokeStyle = shardGradient;
              context.lineWidth = 0.55 + seed * 1.05;
              context.beginPath();
              context.moveTo(startX, startY);
              context.quadraticCurveTo(
                originX + Math.cos(angle + (seed - 0.5) * 0.22) * outerRadius * 0.38,
                originY + Math.sin(angle + (seed - 0.5) * 0.22) * outerRadius * 0.25,
                endX,
                endY
              );
              context.stroke();
            }
            context.restore();
          }

          context.save();
          context.globalCompositeOperation = "source-over";
          const gravityShade = context.createRadialGradient(
            originX,
            originY,
            coreRadius * 0.4,
            originX,
            originY,
            maxRadius * 0.72
          );
          gravityShade.addColorStop(0, "rgba(1, 1, 8, 0.18)");
          gravityShade.addColorStop(0.22, "rgba(7, 3, 17, 0.12)");
          gravityShade.addColorStop(0.58, "rgba(20, 5, 26, 0.045)");
          gravityShade.addColorStop(1, "rgba(3, 4, 13, 0)");
          context.globalAlpha = blackHoleFieldOpacity * (0.34 + collapse * 0.36);
          context.fillStyle = gravityShade;
          context.fillRect(0, 0, width, height);
          context.restore();

          if (collapse > 0.001 && detonationLinear <= 0.001) {
            context.save();
            context.globalCompositeOperation = "lighter";
            context.lineCap = "round";
            for (let ring = 0; ring < 5; ring += 1) {
              const delayed = phaseProgress(collapse, ring * 0.055, 1);
              if (delayed <= 0.001) continue;
              const ringPlunge = Math.pow(delayed, 1.38);
              const ringRadius = diskRadius * (3.05 - ring * 0.34) * (1 - ringPlunge * 0.9);
              const ringPulse = Math.pow(Math.sin(delayed * Math.PI), 0.68);
              context.globalAlpha = blackHoleOpacity * ringPulse * (0.12 + ring * 0.028 + crushCompression * 0.16);
              context.strokeStyle = ring === 2 ? "rgba(255,248,251,0.94)" : "rgba(255,103,148,0.8)";
              context.lineWidth = 0.7 + delayed * (3.6 - ring * 0.42) + crushCompression * 1.4;
              context.shadowColor = ring === 2 ? "rgba(255,255,255,0.9)" : "rgba(255,55,120,0.9)";
              context.shadowBlur = (7 + delayed * 17 + crushCompression * 12) * shadowQuality;
              context.beginPath();
              context.ellipse(
                originX,
                originY,
                ringRadius,
                ringRadius * (0.48 + ring * 0.035),
                blackHoleAngle,
                0,
                Math.PI * 2
              );
              context.stroke();
            }

            const inwardCount = Math.max(16, Math.floor((width < 640 ? 22 : 34) * renderQuality));
            for (let index = 0; index < inwardCount; index += 1) {
              const seed = randomSeed(index + 13701);
              const delayed = phaseProgress(collapse, seed * 0.16, 1);
              if (delayed <= 0.001) continue;
              const angle = seed * Math.PI * 2 + blackHoleAngle + Math.sin(seed * 17.3) * 0.22;
              const outerRadius = Math.max(baseCoreRadius * 4.2, diskRadius * (2.5 + seed * 3.2));
              const innerRadius = coreRadius * (0.3 + seed * 0.36);
              const plunge = clamp(
                Math.pow(delayed, 1.34) + Math.pow(phaseProgress(delayed, 0.58, 1), 2.2) * 0.32,
                0,
                1
              );
              const currentRadius = outerRadius + (innerRadius - outerRadius) * plunge;
              const streakLength = 22 + delayed * (72 + seed * 104) + crushCompression * 46;
              const tangent = angle + Math.PI / 2;
              const curl = (seed - 0.5) * Math.max(diskRadius, baseCoreRadius * 1.4) * 0.28 * delayed
                * (1 - crushCompression * 0.72);
              const endX = originX + Math.cos(angle) * currentRadius + Math.cos(tangent) * curl;
              const endY = originY + Math.sin(angle) * currentRadius * 0.62 + Math.sin(tangent) * curl * 0.62;
              const startX = originX + Math.cos(angle) * (currentRadius + streakLength);
              const startY = originY + Math.sin(angle) * (currentRadius + streakLength) * 0.62;
              const gradient = context.createLinearGradient(startX, startY, endX, endY);
              gradient.addColorStop(0, "rgba(144,181,255,0)");
              gradient.addColorStop(0.55, index % 3 === 0 ? "rgba(195,217,255,0.34)" : "rgba(255,105,151,0.28)");
              gradient.addColorStop(1, index % 4 === 0 ? "rgba(255,255,255,0.9)" : "rgba(255,115,157,0.72)");
              context.globalAlpha = blackHoleOpacity * delayed * (0.16 + seed * 0.26 + crushCompression * 0.16);
              context.strokeStyle = gradient;
              context.lineWidth = 0.5 + delayed * (0.9 + seed * 1.2) + crushCompression * 0.55;
              context.shadowBlur = (3 + delayed * 7 + crushCompression * 5) * shadowQuality;
              context.beginPath();
              context.moveTo(startX, startY);
              context.quadraticCurveTo(
                originX + Math.cos(angle + (seed - 0.5) * 0.35) * (currentRadius + streakLength * 0.38),
                originY + Math.sin(angle + (seed - 0.5) * 0.35) * (currentRadius + streakLength * 0.38) * 0.62,
                endX,
                endY
              );
              context.stroke();
            }

            const compressionGlowRadius = Math.max(
              5,
              coreRadius * (0.72 + (1 - collapseDepth) * 2.65)
            );
            const compressionGlow = context.createRadialGradient(
              originX,
              originY,
              0,
              originX,
              originY,
              compressionGlowRadius
            );
            compressionGlow.addColorStop(0, "rgba(255,255,255,0.98)");
            compressionGlow.addColorStop(0.16, "rgba(255,214,230,0.86)");
            compressionGlow.addColorStop(0.48, "rgba(255,68,128,0.32)");
            compressionGlow.addColorStop(1, "rgba(255,68,128,0)");
            context.globalAlpha = blackHoleOpacity * Math.pow(collapse, 2.05) * (0.72 + crushCompression * 0.26);
            context.fillStyle = compressionGlow;
            context.fillRect(
              originX - compressionGlowRadius,
              originY - compressionGlowRadius,
              compressionGlowRadius * 2,
              compressionGlowRadius * 2
            );

            if (crushCompression > 0.001) {
              const singularityRadius = Math.max(3.5, baseCoreRadius * (0.31 - crushCompression * 0.19));
              const singularity = context.createRadialGradient(
                originX,
                originY,
                0,
                originX,
                originY,
                singularityRadius
              );
              singularity.addColorStop(0, "rgba(255,255,255,1)");
              singularity.addColorStop(0.18, "rgba(255,239,247,0.98)");
              singularity.addColorStop(0.52, "rgba(255,71,132,0.72)");
              singularity.addColorStop(1, "rgba(255,40,111,0)");
              context.globalAlpha = blackHoleOpacity * Math.pow(crushCompression, 2.6);
              context.fillStyle = singularity;
              context.shadowColor = "rgba(255,75,135,0.96)";
              context.shadowBlur = (12 + crushCompression * 24) * shadowQuality;
              context.beginPath();
              context.arc(originX, originY, singularityRadius, 0, Math.PI * 2);
              context.fill();
            }
            context.restore();
          }

          context.save();
          context.globalCompositeOperation = "lighter";
          context.shadowBlur = 0;
          for (let lens = 0; lens < 3; lens += 1) {
            const lensPhase = (time * (0.1 + lens * 0.025) + lens * 0.31) % 1;
            const lensRadius = coreRadius * (1.8 + lens * 1.15)
              + lensPhase * maxRadius * (0.2 + gravityLock * 0.18);
            const lensFade = (1 - lensPhase) * blackHoleDiskOpacity * (0.075 + gravityLock * 0.08);
            context.globalAlpha = lensFade;
            context.strokeStyle = lens % 2 === 0 ? "rgba(255, 111, 151, 0.72)" : "rgba(156, 190, 255, 0.64)";
            context.lineWidth = 0.7 + gravityLock * 1.15;
            context.beginPath();
            context.ellipse(
              originX,
              originY,
              lensRadius,
              lensRadius * (0.52 + lens * 0.035),
              blackHoleAngle,
              0,
              Math.PI * 2
            );
            context.stroke();
          }
          context.restore();

          context.save();
          context.globalCompositeOperation = "lighter";
          for (const particle of orbitParticles) {
            if (particle.depth < 0 && particle.renderX !== undefined) drawOrbitParticle(particle);
          }

          context.translate(originX, originY);
          context.rotate(blackHoleAngle);
          const diskGradient = context.createLinearGradient(
            -renderedDiskRadiusX,
            0,
            renderedDiskRadiusX,
            0
          );
          diskGradient.addColorStop(0, "rgba(111, 157, 255, 0)");
          diskGradient.addColorStop(0.18, "rgba(143, 184, 255, 0.42)");
          diskGradient.addColorStop(0.46, "rgba(255, 89, 137, 0.86)");
          diskGradient.addColorStop(0.58, "rgba(255, 242, 248, 0.98)");
          diskGradient.addColorStop(0.78, "rgba(255, 107, 149, 0.62)");
          diskGradient.addColorStop(1, "rgba(255, 107, 149, 0)");

          if (blackHoleDiskFlash > 0.001) {
            const ignitionGradient = context.createLinearGradient(
              -renderedDiskRadiusX * 1.12,
              0,
              renderedDiskRadiusX * 1.12,
              0
            );
            ignitionGradient.addColorStop(0, "rgba(135,180,255,0)");
            ignitionGradient.addColorStop(0.24, "rgba(170,207,255,0.46)");
            ignitionGradient.addColorStop(0.48, "rgba(255,244,248,0.98)");
            ignitionGradient.addColorStop(0.62, "rgba(255,151,184,0.88)");
            ignitionGradient.addColorStop(1, "rgba(255,73,134,0)");
            context.globalAlpha = blackHoleDiskFlash * 0.92;
            context.strokeStyle = ignitionGradient;
            context.lineWidth = 1.4 + blackHoleDiskFlash * 4.8;
            context.shadowColor = "rgba(255,82,139,0.98)";
            context.shadowBlur = (13 + blackHoleDiskFlash * 24) * shadowQuality;
            context.beginPath();
            context.ellipse(
              0,
              0,
              renderedDiskRadiusX * 1.07,
              Math.max(coreRadius * 0.06, renderedDiskRadiusY * 0.3),
              0,
              0,
              Math.PI * 2
            );
            context.stroke();

            context.globalAlpha = blackHoleDiskFlash * 0.42;
            context.lineWidth = 0.7 + blackHoleDiskFlash * 1.6;
            context.shadowBlur = (5 + blackHoleDiskFlash * 12) * shadowQuality;
            context.beginPath();
            context.moveTo(-renderedDiskRadiusX * 1.16, 0);
            context.bezierCurveTo(
              -renderedDiskRadiusX * 0.42,
              -renderedDiskRadiusY * 0.22,
              renderedDiskRadiusX * 0.38,
              renderedDiskRadiusY * 0.18,
              renderedDiskRadiusX * 1.18,
              0
            );
            context.stroke();
          }

          for (let band = 0; band < 4; band += 1) {
            context.globalAlpha = blackHoleDiskOpacity
              * (0.14 + band * 0.038)
              * (0.78 + gravityLock * 0.54);
            context.strokeStyle = diskGradient;
            context.lineWidth = 1.7 + (4 - band) * (1.7 + gravityLock * 0.82);
            context.shadowColor = band < 2 ? "rgba(140, 181, 255, 0.72)" : "rgba(255, 77, 126, 0.9)";
            context.shadowBlur = (7 + (4 - band) * 3 + gravityLock * 12) * shadowQuality;
            context.beginPath();
            context.ellipse(
              0,
              0,
              renderedDiskRadiusX * (0.92 + band * 0.035),
              renderedDiskRadiusY * (0.84 + band * 0.055),
              0,
              Math.PI,
              Math.PI * 2
            );
            context.stroke();
          }

          context.globalAlpha = blackHoleDiskOpacity * (0.17 + gravityLock * 0.16);
          context.strokeStyle = diskGradient;
          context.lineWidth = coreRadius * (0.16 + gravityLock * 0.055);
          context.shadowColor = "rgba(255, 77, 128, 0.88)";
          context.shadowBlur = (22 + gravityLock * 22) * shadowQuality;
          context.beginPath();
          context.ellipse(
            0,
            0,
            renderedDiskRadiusX * 1.02,
            renderedDiskRadiusY * 0.96,
            0,
            0,
            Math.PI * 2
          );
          context.stroke();

          const halo = context.createRadialGradient(
            0,
            0,
            coreRadius * 0.7,
            0,
            0,
            Math.max(coreRadius, renderedDiskRadiusX * 1.08)
          );
          halo.addColorStop(0, "rgba(255, 92, 137, 0.14)");
          halo.addColorStop(0.42, "rgba(255, 82, 131, 0.07)");
          halo.addColorStop(0.76, "rgba(139, 176, 255, 0.035)");
          halo.addColorStop(1, "rgba(139, 176, 255, 0)");
          context.globalAlpha = blackHoleDiskOpacity * (0.72 + gravityLock * 0.34);
          context.fillStyle = halo;
          context.fillRect(
            -renderedDiskRadiusX * 1.12,
            -Math.max(coreRadius, renderedDiskRadiusY * 2.2),
            renderedDiskRadiusX * 2.24,
            Math.max(coreRadius * 2, renderedDiskRadiusY * 4.4)
          );

          const lightningActivity = clamp(
            blackHoleCoreBuild * (0.42 + gravityLock * 0.7) + collapseDepth * 0.12,
            0,
            1.28
          );
          const lightningRadius = Math.max(
            5,
            coreRadius * (1.02 + blackHoleCoreBuild * 0.08 + gravityLock * 0.08)
          );
          paintSingularityField(context, timestamp, {
            mobile: width < 640,
            quality: renderQuality,
            activity: lightningActivity,
            opacity: blackHoleCoreOpacity,
            radius: lightningRadius,
            gravity: gravityLock,
            shadowQuality,
            compression: clamp(collapseDepth * 0.36 + crushCompression * 0.82, 0, 1)
          });

          context.globalCompositeOperation = "lighter";
          for (let band = 0; band < 3; band += 1) {
            context.globalAlpha = blackHoleDiskOpacity
              * (0.34 + band * 0.082)
              * (0.8 + gravityLock * 0.46);
            context.strokeStyle = diskGradient;
            context.lineWidth = 2 + (3 - band) * (2.15 + gravityLock * 0.96);
            context.shadowColor = "rgba(255, 74, 125, 0.9)";
            context.shadowBlur = (8 + (3 - band) * 3 + gravityLock * 14) * shadowQuality;
            context.beginPath();
            context.ellipse(
              0,
              0,
              renderedDiskRadiusX * (0.9 + band * 0.042),
              renderedDiskRadiusY * (0.82 + band * 0.06),
              0,
              0,
              Math.PI
            );
            context.stroke();
          }

          const lensingHeight = coreRadius * (1.92 + gravityLock * 0.52);
          for (let sideIndex = 0; sideIndex < 2; sideIndex += 1) {
            const side = sideIndex === 0 ? -1 : 1;
            context.globalAlpha = blackHoleDiskOpacity * (0.3 + gravityLock * 0.34);
            context.strokeStyle = side < 0 ? "rgba(184, 211, 255, 0.78)" : "rgba(255, 170, 195, 0.82)";
            context.lineWidth = 1.3 + gravityLock * 1.35;
            context.shadowColor = context.strokeStyle;
            context.shadowBlur = (8 + gravityLock * 11) * shadowQuality;
            context.beginPath();
            context.moveTo(-renderedDiskRadiusX * 0.66, side * coreRadius * 0.12);
            context.bezierCurveTo(
              -coreRadius * 1.18,
              side * lensingHeight,
              coreRadius * 1.18,
              side * lensingHeight,
              renderedDiskRadiusX * 0.66,
              side * coreRadius * 0.08
            );
            context.stroke();
          }

          for (let highlight = 0; highlight < 4; highlight += 1) {
            const seed = randomSeed(highlight + 7301);
            const phase = time * (0.42 + seed * 0.5) + seed * Math.PI * 2;
            const span = 0.18 + seed * 0.42;
            context.globalAlpha = blackHoleDiskOpacity
              * (0.12 + gravityLock * 0.18)
              * (0.46 + seed * 0.54);
            context.strokeStyle = highlight % 3 === 0 ? "#ffffff" : highlight % 2 === 0 ? "#ff8fab" : "#bed7ff";
            context.lineWidth = 0.55 + seed * 1.15;
            context.shadowBlur = (3 + gravityLock * 7) * shadowQuality;
            context.beginPath();
            context.ellipse(
              0,
              0,
              renderedDiskRadiusX * (0.96 + seed * 0.16),
              renderedDiskRadiusY,
              0,
              phase,
              phase + span
            );
            context.stroke();
          }

          context.restore();

          context.save();
          context.globalCompositeOperation = "lighter";
          for (const particle of orbitParticles) {
            if (particle.depth >= 0 && particle.renderX !== undefined) drawOrbitParticle(particle);
          }
          context.restore();
        }

        const burstLimit = Math.floor((width < 640 ? 120 : 220) * renderQuality);
        const spawnBurstWave = (waveIndex) => {
          const waveCounts = [48, 64, 76];
          const count = Math.floor(waveCounts[waveIndex] * densityScale);
          for (let index = 0; index < count && burstParticles.length < burstLimit; index += 1) {
            const angle = nextParticleRandom() * Math.PI * 2;
            const spawnRadius = coreRadius * (0.82 + nextParticleRandom() * 0.92);
            const localX = Math.cos(angle) * spawnRadius;
            const localY = Math.sin(angle) * spawnRadius * diskFlatten;
            const spawnX = originX + localX * Math.cos(blackHoleAngle) - localY * Math.sin(blackHoleAngle);
            const spawnY = originY + localX * Math.sin(blackHoleAngle) + localY * Math.cos(blackHoleAngle);
            const lobeSign = nextParticleRandom() > 0.5 ? 1 : -1;
            const spreadNoise = nextParticleRandom() + nextParticleRandom() - 1;
            const axisAngle = blackHoleAngle + (lobeSign < 0 ? Math.PI : 0);
            const directionAngle = axisAngle + spreadNoise * (waveIndex === 0 ? 0.3 : 0.68);
            const directionX = Math.cos(directionAngle);
            const directionY = Math.sin(directionAngle);
            const swirlDirection = nextParticleRandom() > 0.5 ? 1 : -1;
            const swirlX = -directionY * swirlDirection;
            const swirlY = directionX * swirlDirection;
            const speed = (waveIndex === 0 ? 248 : 174)
              + nextParticleRandom() * (waveIndex === 0 ? 330 : 260);
            const swirlWeight = (waveIndex === 0 ? 0.1 : 0.2) + nextParticleRandom() * 0.12;
            const velocityX = directionX * speed + swirlX * speed * swirlWeight;
            const velocityY = directionY * speed + swirlY * speed * swirlWeight;
            const historyTime = 0.012 + nextParticleRandom() * 0.022;
            burstParticles.push({
              x: spawnX,
              y: spawnY,
              previousX: spawnX - velocityX * historyTime,
              previousY: spawnY - velocityY * historyTime,
              velocityX,
              velocityY,
              age: 0,
              life: 3.15 + nextParticleRandom() * 3.25 + waveIndex * 0.34,
              size: 0.58 + nextParticleRandom() * (1.52 + waveIndex * 0.34),
              drag: 0.38 + nextParticleRandom() * 0.44,
              gravity: 2 + nextParticleRandom() * 12,
              phase: nextParticleRandom() * Math.PI * 2,
              tint: Math.floor(nextParticleRandom() * 6),
              shape: nextParticleRandom(),
              spark: nextParticleRandom() < 0.18
            });
          }
        };

        if (!reducedMotion && shockwaveLinear > 0.001 && shockwaveLinear < 0.9995) {
          context.save();
          context.globalCompositeOperation = "lighter";
          context.lineCap = "round";
          const fragmentPulse = Math.pow(Math.sin(shockwaveLinear * Math.PI), 0.78);
          for (let ring = 0; ring < 2; ring += 1) {
            const delayed = clamp((shockwaveLinear - ring * 0.09) / (1 - ring * 0.09), 0, 1);
            if (delayed <= 0.001) continue;
            const ringEase = 1 - Math.pow(1 - delayed, 3.4);
            const ringRadius = coreRadius * 1.2 + ringEase * maxRadius * (1.02 + ring * 0.08);
            const ringFade = Math.pow(Math.sin(delayed * Math.PI), 0.9);
            const fragmentCount = ring === 0 ? 4 : 3;
            for (let fragment = 0; fragment < fragmentCount; fragment += 1) {
              const seed = randomSeed(8401 + ring * 37 + fragment * 11);
              const startAngle = fragment / fragmentCount * Math.PI * 2
                + (seed - 0.5) * 0.42
                + delayed * (ring === 0 ? 0.16 : -0.12);
              const span = 0.24 + seed * 0.34;
              context.globalAlpha = fragmentPulse
                * ringFade
                * (0.16 - ring * 0.035)
                * (0.76 + seed * 0.3);
              context.strokeStyle = fragment % 3 === 0
                ? "rgba(255,248,251,0.9)"
                : ring === 0
                  ? "rgba(255,126,164,0.64)"
                  : "rgba(171,201,255,0.58)";
              context.lineWidth = 0.75 + (1 - delayed) * (1.9 - ring * 0.35) + seed * 0.55;
              context.shadowColor = ring === 0 ? "rgba(255,73,130,0.64)" : "rgba(137,179,255,0.54)";
              context.shadowBlur = (4 + (1 - delayed) * 8) * shadowQuality;
              context.beginPath();
              context.ellipse(
                originX,
                originY,
                ringRadius,
                ringRadius * (0.72 + ring * 0.06),
                blackHoleAngle,
                startAngle,
                startAngle + span
              );
              context.stroke();
            }
          }
          context.restore();
        }

        if (!reducedMotion && releaseMode !== "rewinding") {
          const waveThresholds = [0.06, 0.34, 0.66];
          for (let waveIndex = 0; waveIndex < waveThresholds.length; waveIndex += 1) {
            const waveBit = 1 << waveIndex;
            if (detonationLinear >= waveThresholds[waveIndex] && (burstWaveMask & waveBit) === 0) {
              burstWaveMask |= waveBit;
              spawnBurstWave(waveIndex);
            }
          }
        }

        if (detonationLinear > 0.001 && detonationLinear < 0.9995) {
          const inversionFlash = Math.exp(-Math.pow((detonationLinear - 0.12) / 0.075, 2));
          const ruptureFlash = Math.exp(-Math.pow((detonationLinear - 0.38) / 0.16, 2)) * 0.72;
          const flashStrength = clamp(inversionFlash + ruptureFlash, 0, 1.24);
          const jetRise = phaseProgress(detonationLinear, 0.03, 0.28);
          const jetFall = 1 - phaseProgress(detonationLinear, 0.72, 1);
          const jetStrength = jetRise * jetFall;
          const shockEase = 1 - Math.pow(1 - detonationLinear, 3.2);

          if (flashStrength > 0.002) {
            const flash = context.createRadialGradient(originX, originY, 0, originX, originY, maxRadius * 0.88);
            flash.addColorStop(0, "rgba(255, 255, 255, 0.96)");
            flash.addColorStop(0.07, "rgba(255, 240, 247, 0.82)");
            flash.addColorStop(0.24, "rgba(255, 91, 139, 0.34)");
            flash.addColorStop(0.54, "rgba(160, 101, 255, 0.09)");
            flash.addColorStop(1, "rgba(255, 72, 112, 0)");
            context.globalAlpha = flashStrength * 0.92;
            context.fillStyle = flash;
            context.fillRect(0, 0, width, height);
          }

          if (jetStrength > 0.001) {
            context.save();
            context.translate(originX, originY);
            context.rotate(blackHoleAngle + Math.PI / 2);
            const jetLength = maxRadius * (0.24 + jetStrength * 0.72);
            const jetWidth = coreRadius * (0.1 + jetStrength * 0.62);
            const traceJet = (direction, widthScale = 1, lengthScale = 1, bendScale = 1) => {
              const activeLength = jetLength * lengthScale;
              const activeWidth = jetWidth * widthScale;
              const jetBend = Math.sin(time * (8.2 + jetStrength * 8.6) + direction * 0.9)
                * activeWidth * 0.62 * bendScale;
              context.beginPath();
              context.moveTo(direction * coreRadius * 0.36, -activeWidth * 0.2);
              context.bezierCurveTo(
                direction * activeLength * 0.18,
                -activeWidth + jetBend * 0.1,
                direction * activeLength * 0.7,
                -activeWidth * 0.28 + jetBend * 0.72,
                direction * activeLength,
                jetBend
              );
              context.bezierCurveTo(
                direction * activeLength * 0.7,
                activeWidth * 0.28 + jetBend * 0.72,
                direction * activeLength * 0.18,
                activeWidth + jetBend * 0.1,
                direction * coreRadius * 0.36,
                activeWidth * 0.2
              );
              context.closePath();
            };

            for (const direction of [-1, 1]) {
              const jetGradient = context.createLinearGradient(0, 0, direction * jetLength, 0);
              jetGradient.addColorStop(0, "rgba(255,255,255,0.98)");
              jetGradient.addColorStop(0.08, "rgba(255,216,231,0.92)");
              jetGradient.addColorStop(0.36, "rgba(255,76,130,0.56)");
              jetGradient.addColorStop(0.72, "rgba(153,126,255,0.16)");
              jetGradient.addColorStop(1, "rgba(126,157,255,0)");
              traceJet(direction);
              context.globalAlpha = jetStrength * 0.2;
              context.fillStyle = jetGradient;
              context.shadowColor = "rgba(255, 71, 130, 0.94)";
              context.shadowBlur = (34 + jetStrength * 46) * shadowQuality;
              context.fill();
              traceJet(direction);
              context.globalAlpha = jetStrength * 0.62;
              context.shadowBlur = (8 + jetStrength * 14) * shadowQuality;
              context.fill();
              traceJet(direction, 0.3, 0.94, 0.58);
              context.globalAlpha = jetStrength * 0.86;
              context.fillStyle = "rgba(255, 244, 249, 0.88)";
              context.shadowColor = "rgba(255, 188, 213, 0.98)";
              context.shadowBlur = (7 + jetStrength * 12) * shadowQuality;
              context.fill();
            }
            context.restore();
          }

          context.lineCap = "round";
          for (let ring = 0; ring < 3; ring += 1) {
            const delayed = clamp((detonationLinear - ring * 0.14) / (1 - ring * 0.14), 0, 1);
            if (delayed <= 0) continue;
            const ringEase = 1 - Math.pow(1 - delayed, 3);
            const ringRadius = ringEase * maxRadius * (0.62 + ring * 0.12);
            const ringAlpha = Math.pow(Math.sin(delayed * Math.PI), 1.42) * (0.3 - ring * 0.054);
            const fragmentCount = ring === 0 ? 4 : 3;
            for (let fragment = 0; fragment < fragmentCount; fragment += 1) {
              const seed = randomSeed(11603 + ring * 31 + fragment * 13);
              const startAngle = fragment / fragmentCount * Math.PI * 2
                + (seed - 0.5) * 0.52
                + delayed * (ring % 2 === 0 ? 0.2 : -0.16);
              const span = 0.2 + seed * 0.3;
              context.globalAlpha = ringAlpha * (0.46 + seed * 0.34);
              context.strokeStyle = fragment % 3 === 0
                ? "rgba(255,244,249,0.82)"
                : ring % 2 === 0
                  ? "rgba(255,119,157,0.58)"
                  : "rgba(177,204,255,0.54)";
              context.lineWidth = 0.65 + (1 - delayed) * (1.8 - ring * 0.18) + seed * 0.38;
              context.shadowColor = ring % 2 === 0 ? "rgba(255,92,139,0.62)" : "rgba(157,192,255,0.52)";
              context.shadowBlur = (4 + (1 - delayed) * 7) * shadowQuality;
              context.beginPath();
              context.ellipse(
                originX,
                originY,
                ringRadius,
                ringRadius * (0.54 + ring * 0.045),
                blackHoleAngle,
                startAngle,
                startAngle + span
              );
              context.stroke();
            }
          }

          const rushStrength = Math.pow(Math.sin(clamp(detonationLinear / 0.84, 0, 1) * Math.PI), 1.15);
          if (rushStrength > 0.001) {
            const rushCount = Math.floor((12 + rushStrength * 22) * renderQuality);
            for (let index = 0; index < rushCount; index += 1) {
              const seed = randomSeed(index + 9301);
              const angle = seed * Math.PI * 2 + blackHoleAngle + detonationLinear * (0.8 + seed * 1.4);
              const startRadius = coreRadius * (1.1 + seed * 1.7);
              const streakLength = 34 + rushStrength * (110 + seed * 240);
              const startX = originX + Math.cos(angle) * startRadius;
              const startY = originY + Math.sin(angle) * startRadius * 0.66;
              const curveAngle = angle + (seed > 0.5 ? 0.28 : -0.28);
              const endX = originX + Math.cos(curveAngle) * (startRadius + streakLength);
              const endY = originY + Math.sin(curveAngle) * (startRadius + streakLength) * 0.72;
              const streakGradient = context.createLinearGradient(startX, startY, endX, endY);
              streakGradient.addColorStop(0, index % 4 === 0 ? "rgba(255,255,255,0.86)" : "rgba(255,122,157,0.66)");
              streakGradient.addColorStop(0.42, index % 3 === 0 ? "rgba(255,95,143,0.38)" : "rgba(173,194,255,0.26)");
              streakGradient.addColorStop(1, "rgba(140,178,255,0)");
              context.globalAlpha = rushStrength * (0.04 + seed * 0.18);
              context.strokeStyle = streakGradient;
              context.lineWidth = 0.55 + seed * 1.7;
              context.shadowColor = index % 3 === 0 ? "rgba(255,79,130,0.8)" : "rgba(154,188,255,0.62)";
              context.shadowBlur = (3 + rushStrength * 8) * shadowQuality;
              context.beginPath();
              context.moveTo(startX, startY);
              context.quadraticCurveTo(
                originX + Math.cos(angle + (seed - 0.5) * 0.9) * (startRadius + streakLength * 0.48),
                originY + Math.sin(angle + (seed - 0.5) * 0.9) * (startRadius + streakLength * 0.48) * 0.66,
                endX,
                endY
              );
              context.stroke();
            }
          }

          for (let arcIndex = 0; arcIndex < 8; arcIndex += 1) {
            const seed = randomSeed(arcIndex + 10101);
            const delayed = clamp((detonationLinear - seed * 0.28) / (1 - seed * 0.28), 0, 1);
            if (delayed <= 0) continue;
            const radius = (1 - Math.pow(1 - delayed, 2.7)) * maxRadius * (0.18 + seed * 0.42);
            const startAngle = seed * Math.PI * 2 + detonationLinear * (0.8 + seed * 1.3) + blackHoleAngle;
            const span = 0.22 + seed * 0.9;
            context.globalAlpha = Math.pow(Math.sin(delayed * Math.PI), 1.32) * (0.055 + seed * 0.14);
            context.strokeStyle = arcIndex % 3 === 0 ? "#ffffff" : arcIndex % 2 === 0 ? "#ff9db3" : "#bfd6ff";
            context.lineWidth = 0.65 + (1 - delayed) * (2.2 + seed * 2.8);
            context.shadowColor = context.strokeStyle;
            context.shadowBlur = (4 + (1 - delayed) * 8) * shadowQuality;
            context.beginPath();
            context.ellipse(
              originX,
              originY,
              radius,
              radius * 0.62,
              blackHoleAngle,
              startAngle,
              startAngle + span
            );
            context.stroke();
          }

          const blastCoreRadius = coreRadius * 0.72 + shockEase * Math.min(width, height) * 0.24;
          const blastCore = context.createRadialGradient(originX, originY, 0, originX, originY, blastCoreRadius);
          blastCore.addColorStop(0, "rgba(255,255,255,0.96)");
          blastCore.addColorStop(0.12, "rgba(255,226,237,0.84)");
          blastCore.addColorStop(0.34, "rgba(255,80,134,0.42)");
          blastCore.addColorStop(0.66, "rgba(164,111,255,0.12)");
          blastCore.addColorStop(1, "rgba(255,74,116,0)");
          context.globalAlpha = Math.pow(1 - detonationLinear, 0.72) * 0.82 + afterglow * 0.24;
          context.fillStyle = blastCore;
          context.fillRect(
            originX - blastCoreRadius,
            originY - blastCoreRadius,
            blastCoreRadius * 2,
            blastCoreRadius * 2
          );
        }

        context.shadowBlur = 0;
        context.shadowColor = "transparent";
        for (let index = burstParticles.length - 1; index >= 0; index -= 1) {
          const particle = burstParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life) {
            burstParticles[index] = burstParticles[burstParticles.length - 1];
            burstParticles.pop();
            continue;
          }
          particle.previousX = particle.x;
          particle.previousY = particle.y;
          const lifeRatio = particle.age / particle.life;
          const drag = Math.exp(-frameSeconds * particle.drag);
          particle.velocityX *= drag;
          particle.velocityY *= drag;
          particle.velocityX += Math.sin(particle.phase + particle.age * 1.5) * frameSeconds * 1.6;
          particle.velocityY += particle.gravity * frameSeconds * (0.16 + lifeRatio * 0.84);
          particle.x += particle.velocityX * frameSeconds;
          particle.y += particle.velocityY * frameSeconds;

          if (
            particle.x < -180
            || particle.x > width + 180
            || particle.y < -180
            || particle.y > height + 220
          ) {
            burstParticles[index] = burstParticles[burstParticles.length - 1];
            burstParticles.pop();
            continue;
          }

          const fadeIn = smoothstep(clamp(particle.age / 0.055, 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeRatio - 0.46) / 0.54, 0, 1));
          const alpha = fadeIn * fadeOut * (0.28 + particle.size * 0.18);
          context.globalAlpha = alpha;
          context.strokeStyle = particle.tint === 0
            ? "#ffffff"
            : particle.tint < 4
              ? "#ff91aa"
              : "#c5d9ff";
          context.fillStyle = context.strokeStyle;
          context.lineCap = "round";
          const trailTime = 0.026 + (1 - lifeRatio) * 0.058;
          const trailX = particle.x - particle.velocityX * trailTime;
          const trailY = particle.y - particle.velocityY * trailTime;
          if (particle.shape > 0.82) {
            const angle = Math.atan2(particle.velocityY, particle.velocityX);
            const shardLength = 4 + particle.size * (3.2 + (1 - lifeRatio) * 4.6);
            const shardWidth = 0.7 + particle.size * 0.72;
            context.globalAlpha = alpha * 0.78;
            context.beginPath();
            context.moveTo(particle.x, particle.y);
            context.lineTo(
              particle.x - Math.cos(angle) * shardLength + Math.cos(angle + Math.PI / 2) * shardWidth,
              particle.y - Math.sin(angle) * shardLength + Math.sin(angle + Math.PI / 2) * shardWidth
            );
            context.lineTo(
              trailX - Math.cos(angle + Math.PI / 2) * shardWidth * 0.45,
              trailY - Math.sin(angle + Math.PI / 2) * shardWidth * 0.45
            );
            context.closePath();
            context.fill();
          } else {
            context.lineWidth = particle.size;
            context.beginPath();
            context.moveTo(particle.x, particle.y);
            context.lineTo(trailX, trailY);
            context.stroke();
          }
          if (particle.spark && lifeRatio > 0.1 && lifeRatio < 0.72) {
            context.globalAlpha = alpha * 0.44;
            const sparkSize = Math.max(0.7, particle.size * 0.52);
            context.fillRect(particle.x - sparkSize * 0.5, particle.y - sparkSize * 0.5, sparkSize, sparkSize);
          }
        }

        const rainLimit = Math.floor((width < 640 ? 88 : 152) * renderQuality);
        const rainDrive = rainBuild * (1 - rainStop);
        if (!reducedMotion && releaseMode !== "rewinding" && rainDrive > 0.001) {
          rainEmissionBudget += frameSeconds
            * (10 + rainDrive * 76 + releaseVisualPressure * 32)
            * densityScale;
          while (rainEmissionBudget >= 1 && rainParticles.length < rainLimit) {
            rainEmissionBudget -= 1;
            const angle = nextParticleRandom() * Math.PI * 2;
            const radius = nextParticleRandom() * Math.min(width, height) * (0.08 + rainBuild * 0.24);
            const outwardSpeed = 20 + nextParticleRandom() * (54 + rainBuild * 68);
            rainParticles.push({
              x: originX + Math.cos(angle) * radius,
              y: originY + Math.sin(angle) * radius * 0.72,
              previousX: originX,
              previousY: originY,
              velocityX: Math.cos(angle) * outwardSpeed + (nextParticleRandom() - 0.5) * 46,
              velocityY: Math.sin(angle) * outwardSpeed * 0.62 - 34 - nextParticleRandom() * 96,
              age: 0,
              life: 3.4 + nextParticleRandom() * 2.8,
              gravity: 18 + nextParticleRandom() * 34,
              size: 0.48 + nextParticleRandom() * 1.36,
              phase: nextParticleRandom() * Math.PI * 2,
              tint: Math.floor(nextParticleRandom() * 7)
            });
          }
        } else {
          rainEmissionBudget = Math.min(rainEmissionBudget, 0.95);
        }

        context.shadowBlur = 0;
        context.shadowColor = "transparent";
        for (let index = rainParticles.length - 1; index >= 0; index -= 1) {
          const particle = rainParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life) {
            rainParticles[index] = rainParticles[rainParticles.length - 1];
            rainParticles.pop();
            continue;
          }
          particle.previousX = particle.x;
          particle.previousY = particle.y;
          const lifeRatio = particle.age / particle.life;
          particle.velocityX *= Math.exp(-frameSeconds * 0.34);
          particle.velocityX += Math.sin(particle.phase + particle.age * 1.1) * frameSeconds * 5.2;
          particle.velocityY += particle.gravity * frameSeconds;
          particle.x += particle.velocityX * frameSeconds;
          particle.y += particle.velocityY * frameSeconds;
          if (particle.y > height + 90 || particle.x < -90 || particle.x > width + 90) {
            rainParticles[index] = rainParticles[rainParticles.length - 1];
            rainParticles.pop();
            continue;
          }

          const fadeIn = smoothstep(clamp(particle.age / 0.12, 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeRatio - 0.56) / 0.44, 0, 1));
          const alpha = fadeIn * fadeOut * (0.26 + particle.size * 0.19);
          context.globalAlpha = alpha;
          context.strokeStyle = particle.tint === 0
            ? "#ffffff"
            : particle.tint < 4
              ? "#ff9caf"
              : "#c9dcff";
          context.lineWidth = 0.45 + particle.size * 0.56;
          context.lineCap = "round";
          context.beginPath();
          context.moveTo(particle.previousX, particle.previousY);
          context.lineTo(
            particle.x - particle.velocityX * frameSeconds * 0.18,
            particle.y - Math.max(2, particle.velocityY * frameSeconds * (0.38 + lifeRatio * 0.42))
          );
          context.stroke();
          if (lifeRatio > 0.28) {
            context.globalAlpha = alpha * 0.32;
            context.fillStyle = context.strokeStyle;
            context.beginPath();
            context.arc(particle.x, particle.y, particle.size * 0.34, 0, Math.PI * 2);
            context.fill();
          }
        }

        if (aftermath > 0.001) {
          context.save();
          context.globalCompositeOperation = "lighter";
          context.lineCap = "round";
          for (let echo = 0; echo < 3; echo += 1) {
            const echoProgress = phaseProgress(
              burst,
              detonationStart + 0.004 + echo * 0.008,
              1
            );
            if (echoProgress <= 0.001 || echoProgress >= 0.9995) continue;
            const echoEase = 1 - Math.pow(1 - echoProgress, 2.7);
            const echoRadius = coreRadius * (0.8 + echo * 0.28)
              + echoEase * maxRadius * (0.48 + echo * 0.17);
            const echoAlpha = Math.pow(Math.sin(echoProgress * Math.PI), 1.1)
              * aftermath
              * (0.22 - echo * 0.045);
            context.globalAlpha = echoAlpha;
            context.strokeStyle = echo === 1
              ? "rgba(190, 211, 255, 0.78)"
              : "rgba(255, 164, 190, 0.82)";
            context.lineWidth = 0.7 + (1 - echoProgress) * (4.8 - echo * 0.8);
