        }, undefined, "return", "lovebrain");
        if (!started) completeGateReturn();
      };

      const isHomeSectionSnapEnabled = () => homeSectionSnapMedia.matches
        && pageMode === "next"
        && homeSectionStops.length >= 5
        && !document.documentElement.classList.contains("kisara-event-modal-open");

      const getHomeSectionTop = (element) => {
        if (element === opening) return getNextPageTop();
        const rect = element.getBoundingClientRect();
        const top = rect.top + window.scrollY;
        const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
        return clamp(Math.round(top), 0, maxScroll);
      };

      const getHomeSectionStopRecords = () => homeSectionStops.map((element, index) => ({
        element,
        index,
        top: getHomeSectionTop(element)
      }));

      const settleHomeSectionStop = (stop) => {
        const destination = getHomeSectionTop(stop.element);
        lastObservedScrollY = destination;
        setScrollPosition(destination, true);
        lastObservedScrollY = window.scrollY;
        return destination;
      };

      const findRestoredHomeSectionStop = () => {
        const stops = getHomeSectionStopRecords();
        if (stops.length === 0) return null;

        const rawHash = window.location.hash.slice(1);
        if (rawHash) {
          let targetId = rawHash;
          try {
            targetId = decodeURIComponent(rawHash);
          } catch {}
          const hashTarget = document.getElementById(targetId);
          const hashStop = hashTarget
            ? stops.find((stop) => stop.element === hashTarget || stop.element.contains(hashTarget))
            : null;
          if (hashStop) return hashStop;
        }

        const current = window.scrollY;
        return stops.reduce((nearest, stop) => (
          Math.abs(stop.top - current) < Math.abs(nearest.top - current) ? stop : nearest
        ));
      };

      const alignRestoredHomeSection = () => {
        restoredHomeSectionAlignmentFrame = 0;
        if (!restoredHomeSectionAlignmentPending) return false;
        if (disposed || scrollFrame || scrollTransitionDirection !== "idle") return false;
        if (window.scrollY <= 2 || !isHomeSectionSnapEnabled()) {
          restoredHomeSectionAlignmentPending = false;
          return false;
        }

        const stop = findRestoredHomeSectionStop();
        restoredHomeSectionAlignmentPending = false;
        if (!stop) return false;
        settleHomeSectionStop(stop);
        if (stop.element === opening) {
          openingBridgeRecoveryPending = true;
          activateFreshOpeningBridge();
        } else if (openingBridgePortalActive) {
          if (gateVisualResetPending) finalizeGateResetForNextPage();
          else deactivateOpeningBridgePortal();
        }
        return true;
      };

      const scheduleRestoredHomeSectionAlignment = () => {
        if (!restoredHomeSectionAlignmentPending || restoredHomeSectionAlignmentFrame) return;
        restoredHomeSectionAlignmentFrame = window.requestAnimationFrame(() => {
          restoredHomeSectionAlignmentFrame = window.requestAnimationFrame(alignRestoredHomeSection);
        });
      };

      const findHomeSectionTarget = (delta) => {
        const current = window.scrollY;
        const tolerance = clamp(window.innerHeight * 0.08, 44, 88);
        const stops = getHomeSectionStopRecords();
        if (delta > 0) {
          return stops.find((stop) => stop.top > current + tolerance) ?? null;
        }
        for (let index = stops.length - 1; index >= 0; index -= 1) {
          if (stops[index].top < current - tolerance) return stops[index];
        }
        return null;
      };

      const smoothScrollToHomeSection = (stop) => {
        clearHomeGateReturnArm();
        homeSectionWheelAccumulator = 0;
        if (stop.element === opening && isOpeningStopCurrent()) return true;
        if (stop.element === opening || isOpeningStopCurrent()) {
          const target = stop.element === opening ? "opening"
            : stop.element.dataset.kisaraHomeStop === "002" ? "fridge" : "document";
          return runComicHandoff(target, () => {
            settleHomeSectionStop(stop);
            pageMode = "next";
            if (gateVisualResetPending) finalizeGateResetForNextPage();
          });
        }
        const destination = getHomeSectionTop(stop.element);
        const direction = destination >= window.scrollY ? "section-forward" : "section-return";
        const restoresOpeningBridge = stop.element === opening
          && direction === "section-return";
        if (restoresOpeningBridge) {
          if (openingBridgeRecoveryPending) restoreOpeningBridgePresentation();
          activateFreshOpeningBridge();
        }
        const started = smoothScrollTo(destination, () => {
          settleHomeSectionStop(stop);
          if (stop.element === opening && openingBridgeRecoveryPending) {
            activateFreshOpeningBridge();
          }
          if (stop.element !== opening && openingBridgePortalActive) {
            if (gateVisualResetPending) finalizeGateResetForNextPage();
            else deactivateOpeningBridgePortal();
          }
          homeSectionInputGuardUntil = Math.max(
            performance.now() + 90,
            homeSectionWheelLastTimestamp + 180
          );
        }, undefined, direction, "section");
        if (!started) {
          if (restoresOpeningBridge) deactivateOpeningBridgePortal();
          return false;
        }
        return true;
      };

      const resetHomeSectionWheelGesture = () => {
        homeSectionWheelAccumulator = 0;
        homeSectionWheelLastTimestamp = 0;
        homeSectionWheelTimer = 0;
      };

      const readHomeSectionWheelDirection = (delta) => {
        const timestamp = performance.now();
        if (timestamp - homeSectionWheelLastTimestamp > 170) {
          homeSectionWheelAccumulator = 0;
          homeSectionWheelGestureSerial += 1;
        }
        homeSectionWheelLastTimestamp = timestamp;
        if (homeSectionWheelTimer) window.clearTimeout(homeSectionWheelTimer);
        homeSectionWheelTimer = window.setTimeout(resetHomeSectionWheelGesture, 170);

        if (
          homeSectionWheelAccumulator !== 0
          && Math.sign(homeSectionWheelAccumulator) !== Math.sign(delta)
        ) {
          homeSectionWheelAccumulator = 0;
        }
        homeSectionWheelAccumulator += clamp(delta, -180, 180);
        const threshold = clamp(window.innerHeight * 0.09, 58, 82);
        if (Math.abs(homeSectionWheelAccumulator) < threshold) return null;

        const direction = Math.sign(homeSectionWheelAccumulator);
        homeSectionWheelAccumulator = 0;
        return { direction, gestureSerial: homeSectionWheelGestureSerial };
      };

      const holdHomeSectionWheelGesture = () => {
        homeSectionWheelAccumulator = 0;
        homeSectionWheelLastTimestamp = performance.now();
        if (homeSectionWheelTimer) window.clearTimeout(homeSectionWheelTimer);
        homeSectionWheelTimer = window.setTimeout(resetHomeSectionWheelGesture, 170);
      };

      const handleHomeSectionInput = (delta, event, inputType) => {
        if (!isHomeSectionSnapEnabled() || inputType === "touch") return false;
        if (
          event.target instanceof Element
          && event.target.closest("dialog[open], [data-kisara-context-menu]")
        ) return false;

        event.preventDefault();
        if (performance.now() < homeSectionInputGuardUntil) {
          if (inputType === "wheel") {
            holdHomeSectionWheelGesture();
            homeSectionInputGuardUntil = performance.now() + 170;
          }
          return true;
        }
        const intent = inputType === "wheel"
          ? readHomeSectionWheelDirection(delta)
          : { direction: Math.sign(delta), gestureSerial: -1 };
        if (!intent?.direction) return true;
        const { direction, gestureSerial } = intent;

        const target = findHomeSectionTarget(direction);
        if (target) {
          smoothScrollToHomeSection(target);
          return true;
        }

        if (direction < 0) {
          if (homeGateReturnArmed) {
            if (inputType === "wheel" && gestureSerial === homeGateReturnGestureSerial) return true;
            clearHomeGateReturnArm();
            returnToGate();
          } else {
            armHomeGateReturn(gestureSerial);
          }
          return true;
        }

        clearHomeGateReturnArm();
        return true;
      };

      const shapeGateWheelDelta = (delta, timestamp) => {
        const magnitude = Math.abs(delta);
        if (magnitude < 32) {
          gateWheelDirection = 0;
          gateWheelMomentum = 0;
          gateWheelLastTimestamp = timestamp;
          return delta * 1.04;
        }

        const direction = Math.sign(delta);
        const elapsed = gateWheelLastTimestamp > 0
          ? timestamp - gateWheelLastTimestamp
          : Number.POSITIVE_INFINITY;
        const continuesGesture = direction === gateWheelDirection
          && elapsed <= gateWheelGestureWindow;
        if (continuesGesture) {
          const cadence = clamp(1 - elapsed / gateWheelGestureWindow, 0, 1);
          const impulse = clamp(magnitude / 180, 0, 1);
          gateWheelMomentum = clamp(
            gateWheelMomentum * 0.72 + cadence * 0.42 + impulse * 0.12,
            0,
            1
          );
        } else {
          gateWheelMomentum = 0.14;
        }
        gateWheelDirection = direction;
        gateWheelLastTimestamp = timestamp;

        const sustainedGain = smoothstep(gateWheelMomentum) * gateWheelSustainedGain;
        return delta * (gateWheelBaseGain + sustainedGain);
      };

      const addProgress = (delta) => {
        if (["forward", "rewinding", "complete"].includes(releaseMode)) return;
        const boundedDelta = clamp(delta, -280, 280);
        if (boundedDelta > 0) scheduleReleaseWarmup(true);
        const fillComplete = targetProgress >= 0.9995 && progress >= 0.995;
        const timestamp = performance.now();
        if (chargeIntroActive) {
          if (delta < 0) {
            targetProgress = clamp(
              targetProgress + boundedDelta / fillDistance * 0.22,
              0,
              0.988
            );
            velocity += boundedDelta / fillDistance * 0.012;
            transitionChargeIntro(0, timestamp);
          } else if (chargeIntroReversing) {
            targetProgress = 1;
            transitionChargeIntro(1, timestamp);
          }
          startAnimation();
          return;
        }
        if (delta < 0 && chargeIntroComplete) {
          targetProgress = Math.min(targetProgress, 0.988);
          velocity += boundedDelta / fillDistance * 0.012;
          transitionChargeIntro(0, timestamp);
          startAnimation();
          return;
        }
        if (delta > 0 && fillComplete && !chargeIntroComplete) {
          startChargeIntro(timestamp);
          startAnimation();
          return;
        }
        if (delta > 0 && fillComplete && chargeIntroComplete) {
          startReleaseAutoplay(timestamp);
        } else {
          targetProgress = clamp(targetProgress + boundedDelta / fillDistance, 0, 1);
          velocity += boundedDelta / fillDistance * 0.03;
          if (delta > 0 && targetProgress >= 0.9995 && !chargeIntroComplete) {
            startChargeIntro(timestamp);
          }
        }
        startAnimation();
      };

      const isFillComplete = () => targetProgress >= 0.9995
        && progress >= 0.999
        && Math.abs(velocity) < 0.001;

      const isComplete = () => isFillComplete()
        && targetBurstProgress >= 0.9995
        && burstProgress >= 0.999
        && Math.abs(burstVelocity) < 0.001
        && releaseMode === "complete";

      const shouldCaptureGate = (delta) => {
        if (window.scrollY > 2 || delta === 0) return false;
        if (chargeIntroActive || ["forward", "rewinding", "paused"].includes(releaseMode)) return true;
        if (delta > 0 && isFillComplete() && !chargeIntroComplete) return true;
        if (delta > 0) return !isComplete();
        return targetBurstProgress > 0.0005
          || burstProgress > 0.0005
          || Math.abs(burstVelocity) > 0.0005
          || targetProgress > 0.0005
          || progress > 0.0005
          || Math.abs(velocity) > 0.0005;
      };

      const normalizeWheel = (event) => {
        if (event.deltaMode === WheelEvent.DOM_DELTA_LINE) return event.deltaY * 16;
        if (event.deltaMode === WheelEvent.DOM_DELTA_PAGE) return event.deltaY * window.innerHeight;
        return event.deltaY;
      };

      const handleDirectionalInput = (delta, event, inputType = "wheel") => {
        if (delta === 0) return;
        if (comicTransition.active) { event.preventDefault(); return; }
        if (lovebrainActive && pageMode === "lovebrain") {
          event.preventDefault();
          return;
        }
        if (foundSelfActive) {
          event.preventDefault();
          if (foundSelfState === "settled" && delta > 0) leaveFoundSelfSequence();
          return;
        }
        if (scrollFrame || scrollTransitionDirection !== "idle") {
          event.preventDefault();
          if (inputType === "wheel" && scrollTransitionDirection.startsWith("section")) {
            holdHomeSectionWheelGesture();
          }
          if (
            pageMode === "snap"
            && scrollTransitionDirection === "forward"
            && delta < 0
          ) {
