          const center = {
            x: point.x + normalX * softWave,
            y: point.y + normalY * softWave,
            normalX,
            normalY,
            tangentX: tangent.x / tangentLength,
            tangentY: tangent.y / tangentLength,
            thickness: thicknessAt(unit),
            unit
          };
          centerSamples.push(center);
          upperPoints.push({
            x: center.x + normalX * center.thickness,
            y: center.y + normalY * center.thickness
          });
          lowerPoints.push({
            x: center.x - normalX * center.thickness,
            y: center.y - normalY * center.thickness
          });
        }

        const headSample = centerSamples[centerSamples.length - 1];
