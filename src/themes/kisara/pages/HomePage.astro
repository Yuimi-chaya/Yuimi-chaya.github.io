          gate,
          meterShell,
          title,
          titleAbyssCanvas,
          chainBackCanvas,
          chainFrontCanvas,
          energyCanvas,
          postReleaseCanvas
        ]) {
          if (target) layoutResizeObserver.observe(target);
        }
      }
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") {
