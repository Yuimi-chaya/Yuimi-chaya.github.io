            float trailDistance = (8.0 + liquidPressure * 26.0)
              * resolutionScale
              * finalFlow;
            vec4 trailNear = texture(
              uTitleTexture,
              clamp(
                (sourcePixel - trailAxis * trailDistance * 0.48) / uResolution,
                vec2(0.001),
                vec2(0.999)
              )
            );
            vec4 trailFar = texture(
              uTitleTexture,
              clamp(
                (sourcePixel - trailAxis * trailDistance) / uResolution,
                vec2(0.001),
                vec2(0.999)
              )
            );
            float brokenTrail = smoothstep(
              0.38,
              0.94,
              0.5 + 0.5 * sin(
                pixel.y * 0.11
                + pixel.x * 0.031
                - uLiquidPhase * 3.4
              )
            );
            float trailAlpha = max(
              trailNear.a * 0.62 + trailFar.a * 0.3 - titleColor.a * 0.34,
              0.0
            )
              * flowInfluence
              * finalFlow
              * (0.08 + liquidPressure * 0.84 + abs(uParallax) * 0.2)
              * (0.3 + brokenTrail * 0.7);
            float alpha = titleColor.a
              * edge
              * dissolveMask
              * clamp(uOpacity, 0.0, 1.0);
            float trailOutputAlpha = trailAlpha * edge * clamp(uOpacity, 0.0, 1.0);
            vec3 trailColor = mix(
              vec3(0.36, 0.62, 1.0),
              vec3(1.0, 0.16, 0.46),
              0.58 + flowDirection * 0.12
            );
            outputColor = vec4(
              titleColor.rgb * edge * uOpacity + trailColor * trailOutputAlpha,
              clamp(alpha + trailOutputAlpha, 0.0, 1.0)
            );
          }
        `;

        const compileShader = (type, source) => {
