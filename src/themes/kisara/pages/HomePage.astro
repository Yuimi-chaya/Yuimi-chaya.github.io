        const residualSlack = 1 - clamp(
          settle * 0.14 + localTakeUp * 0.72 + lock * 0.16,
          0,
          1
        );
        const tensionOffset = tensionWave
          * box.height
          * (0.0014 + residualSlack * 0.0036 + strain * 0.0042)
          * frameMotionResponse;
        x += normalX * tensionOffset;
        y += normalY * tensionOffset;
        return {
          x,
          y,
          tangentX,
          tangentY,
          normalX,
          normalY,
          angle: Math.atan2(tangentY, tangentX),
          plane,
          crossing,
          depth
        };
      };

      const sampleTitleChainTravel = (
        definition,
        path,
        distanceUnit,
        spacing,
        fill,
        intro,
        timestamp
      ) => {
        if (distanceUnit >= 0 && distanceUnit <= 1) {
          return sampleTitleChain(
            definition,
            path,
            spacing.unitAtDistance(distanceUnit),
            fill,
            intro,
            timestamp
          );
        }
        const boundaryUnit = distanceUnit < 0 ? 0 : 1;
        const boundary = sampleTitleChain(
          definition,
          path,
          boundaryUnit,
          fill,
          intro,
          timestamp
        );
        const outsideDistance = Math.abs(distanceUnit - boundaryUnit) * spacing.totalLength;
        const direction = distanceUnit < 0 ? -1 : 1;
        const bend = Math.sin(
          clamp(outsideDistance / Math.max(1, chainTitleBox.height * 2.4), 0, 1) * Math.PI
        )
          * chainTitleBox.height
          * definition.entryBend;
        return {
          ...boundary,
          x: boundary.x
            + boundary.tangentX * direction * outsideDistance
            + boundary.normalX * bend,
          y: boundary.y
            + boundary.tangentY * direction * outsideDistance
            + boundary.normalY * bend,
          plane: "back",
          crossing: false
        };
      };

      const getChainLinkDimensions = (definition) => {
        const mobileGeometry = mobilePerformance || chainTitleBox.width < 420;
        const linkUnit = clamp(
          chainTitleBox.height * (mobileGeometry ? 0.122 : 0.108),
          mobileGeometry ? 9.2 : 8.4,
          mobileGeometry ? 15.8 : 16.8
        ) * definition.linkScale;
        return {
          width: linkUnit * 1.82,
          height: linkUnit * 1.02
        };
      };

      const buildTitleChainLinkUnits = (definition, isMobile) => {
        const cacheKey = [
          definition.id,
          Math.round(chainTitleBox.width),
          Math.round(chainTitleBox.height),
          isMobile ? 1 : 0
        ].join(":");
        const cached = chainLinkUnitCache.get(cacheKey);
        if (cached) return cached;
        const spacingPath = resolveTitleChainPath(definition, 0, 0);
        const sampleCount = definition.type === "frame"
          ? (isMobile ? 110 : 180)
          : (isMobile ? 88 : 140);
        const samples = [];
        let totalLength = 0;
        let previous = sampleTitleChain(definition, spacingPath, 0, 0, 0, 0);
        samples.push({ unit: 0, length: 0 });
        for (let index = 1; index <= sampleCount; index += 1) {
          const unit = index / sampleCount;
          const current = sampleTitleChain(definition, spacingPath, unit, 0, 0, 0);
          totalLength += Math.hypot(current.x - previous.x, current.y - previous.y);
          samples.push({ unit, length: totalLength });
          previous = current;
        }
        if (totalLength <= 0.001) {
          return {
            records: [{ unit: 0, distanceUnit: 0 }],
            totalLength: 1,
            unitAtDistance: () => 0,
            distanceAtUnit: () => 0
          };
        }

        const dimensions = getChainLinkDimensions(definition);
        const desiredCount = Math.round(totalLength / chainLinkPitch(dimensions.width, isMobile));
        const minimum = definition.type === "frame"
          ? (isMobile ? definition.mobileLinks : definition.desktopLinks)
          : (isMobile
              ? definition.mobileLinksPerSegment
              : definition.desktopLinksPerSegment) * spacingPath.segmentCount + 1;
        const maximum = definition.type === "frame"
          ? (isMobile ? 28 : 110)
          : (isMobile ? 22 : 86);
        let linkCount = Math.round(clamp(desiredCount, minimum, maximum));
        if (definition.type === "frame" && linkCount % 2 !== 0) {
          linkCount += linkCount < maximum ? 1 : -1;
        }
        const unitAtLength = (targetLength) => {
          let low = 1;
          let high = samples.length - 1;
          while (low < high) {
            const middle = Math.floor((low + high) * 0.5);
            if (samples[middle].length < targetLength) low = middle + 1;
            else high = middle;
          }
          const upper = samples[low];
          const lower = samples[Math.max(0, low - 1)];
          const span = Math.max(0.0001, upper.length - lower.length);
          const blend = clamp((targetLength - lower.length) / span, 0, 1);
          return lower.unit + (upper.unit - lower.unit) * blend;
        };
        const lengthAtUnit = (targetUnit) => {
          const samplePosition = clamp(targetUnit, 0, 1) * sampleCount;
          const lowerIndex = Math.floor(samplePosition);
          const upperIndex = Math.min(samples.length - 1, lowerIndex + 1);
          const blend = samplePosition - lowerIndex;
          return samples[lowerIndex].length
            + (samples[upperIndex].length - samples[lowerIndex].length) * blend;
        };
        const records = [];
        for (let index = 0; index < linkCount; index += 1) {
          const distanceUnit = definition.type === "frame"
            ? (index + 0.5) / linkCount
            : index / Math.max(1, linkCount - 1);
          records.push({
            distanceUnit,
            unit: unitAtLength(distanceUnit * totalLength)
          });
        }
        if (definition.type === "weave") {
          const sourceTailStep = 1 / Math.max(1, linkCount - 1);
          const sourceTailLinkCount = Math.max(
            2,
            Math.ceil(definition.entryOverscan / sourceTailStep / 2) * 2
          );
          for (let index = 1; index <= sourceTailLinkCount; index += 1) {
            const sourceDistance = sourceTailStep * index;
            records.push({
              distanceUnit: definition.direction > 0
                ? -sourceDistance
                : 1 + sourceDistance,
              unit: definition.direction > 0 ? 0 : 1
            });
          }
          records.sort((left, right) => left.distanceUnit - right.distanceUnit);
        }
        const spacing = {
          records,
          totalLength,
          unitAtDistance: (distanceUnit) => unitAtLength(clamp(distanceUnit, 0, 1) * totalLength),
          distanceAtUnit: (unit) => lengthAtUnit(clamp(unit, 0, 1)) / totalLength
        };
        chainLinkUnitCache.set(cacheKey, spacing);
        if (chainLinkUnitCache.size > 24) {
          chainLinkUnitCache.delete(chainLinkUnitCache.keys().next().value);
        }
        return spacing;
      };

      const drawChainLinkArc = (
        context,
        sample,
        linkIndex,
        definition,
        alpha,
        heat,
        isFront,
        arcPart,
        rotationOffset = 0,
        scale = 1,
        lengthScale = 1
      ) => {
        if (alpha * chainMaterialVisibility <= 0.002) return;
        const edgeOn = linkIndex % 2 === 1;
        const frameDepth = Number.isFinite(sample.depth) ? sample.depth : 0;
        const layerAlpha = alpha * chainMaterialVisibility * (definition.type === "frame"
          ? (isFront
              ? 0.82 + Math.max(0, frameDepth) * 0.18
              : 0.78 + Math.max(0, -frameDepth) * 0.16)
          : (isFront ? 1 : 0.84));
        const variantSeed = randomSeed(
          41011 + definition.id * 701.3 + linkIndex * 43.17
        );
        const dimensions = getChainLinkDimensions(definition);
        const size = scale * (0.99 + variantSeed * 0.02);
        context.save();
        context.globalCompositeOperation = "source-over";
        context.globalAlpha = layerAlpha;
        context.translate(sample.x, sample.y);
        context.rotate(sample.angle + rotationOffset);
        context.scale(size * (edgeOn ? lengthScale : 1), size);
        context.imageSmoothingEnabled = true;
        chainMaterial?.draw(context, dimensions.width * 1.16, edgeOn, arcPart, heat);
        context.restore();
      };

      const drawChainLayer = (context, records, isFront) => {
        if (mobilePerformance || chainTitleBox.width < 420) {
          for (const record of records) {
            drawChainLinkArc(
              context,
              record.sample,
              record.linkIndex,
              record.definition,
              record.alpha,
              record.heat,
              isFront,
              record.arcMode === "full" ? "full" : record.arcMode,
              record.rotationOffset,
              record.scale,
              record.lengthScale
            );
          }
          return;
        }
        const passes = [
          { arcPart: "far", edgeOn: false },
          { arcPart: "far", edgeOn: true },
          { arcPart: "near", edgeOn: false },
          { arcPart: "near", edgeOn: true }
        ];
        for (const pass of passes) {
          for (const record of records) {
            const edgeOn = record.linkIndex % 2 === 1;
            if (edgeOn !== pass.edgeOn) continue;
            if (record.arcMode !== "full" && record.arcMode !== pass.arcPart) continue;
            drawChainLinkArc(
              context,
              record.sample,
              record.linkIndex,
              record.definition,
              record.alpha,
              record.heat,
              isFront,
              pass.arcPart,
              record.rotationOffset,
              record.scale,
              record.lengthScale
            );
          }
        }
      };

      const drawChainLeader = (context, leader) => {
        if (!leader || leader.alpha <= 0.002) return;
        const { definition, sample, alpha, heat } = leader;
        const dimensions = getChainLinkDimensions(definition);
        const forward = definition.direction > 0 ? 1 : -1;
        context.save();
        context.translate(sample.x, sample.y);
        context.rotate(sample.angle + (forward < 0 ? Math.PI : 0));
        context.globalCompositeOperation = "screen";
        context.lineCap = "round";
        const trail = context.createLinearGradient(-dimensions.width * 1.9, 0, -dimensions.width * 0.08, 0);
        trail.addColorStop(0, "rgba(185,195,207,0)");
        trail.addColorStop(0.68, "rgba(255,255,255,0.08)");
        trail.addColorStop(1, "rgba(255,248,252,0.5)");
        context.globalAlpha = alpha * (0.28 + heat * 0.12);
        context.strokeStyle = trail;
        context.lineWidth = 1.05 + Math.abs(velocity) * 15;
        context.beginPath();
        context.moveTo(-dimensions.width * 1.9, 0);
        context.lineTo(-dimensions.width * 0.08, 0);
        context.stroke();
        context.lineWidth = 0.95;
        if (heat < 0.995) {
          context.globalAlpha = alpha * 0.46 * (1 - heat);
          context.strokeStyle = "rgba(193,202,210,0.9)";
          context.beginPath();
          context.moveTo(-dimensions.width * 0.34, 0);
          context.lineTo(-dimensions.width * 0.07, 0);
          context.stroke();
        }
        if (heat > 0.005) {
          context.globalAlpha = alpha * 0.46 * heat;
          context.strokeStyle = "rgba(212,134,144,0.92)";
          context.beginPath();
          context.moveTo(-dimensions.width * 0.34, 0);
          context.lineTo(-dimensions.width * 0.07, 0);
          context.stroke();
        }
        context.restore();
      };

      const resolveBrokenSegmentMotion = (
        definition,
        breakSample,
        side,
        dimensions,
        breakOpen,
        recoil,
        snapPulse = 0
      ) => {
        const polarity = definition.id === 1 ? -1 : 1;
        const gapTravel = dimensions.width
          * (definition.type === "frame" ? 0.36 : 0.42)
          * breakOpen;
        const recoilTravel = chainTitleBox.width
          * (definition.type === "frame" ? 0.016 : 0.014)
          * recoil
          + chainTitleBox.height * 0.018 * snapPulse;
        const normalTravel = chainTitleBox.height
          * (0.012 * recoil + 0.022 * snapPulse);
        return {
          side,
          swingAngle: side
            * polarity
            * (definition.type === "frame" ? 0.075 : 0.095)
            * (recoil + snapPulse * 0.26),
          translateX: breakSample.tangentX * side * (gapTravel + recoilTravel)
            + breakSample.normalX * side * polarity * normalTravel,
          translateY: breakSample.tangentY * side * (gapTravel + recoilTravel)
            + breakSample.normalY * side * polarity * normalTravel
        };
      };

      const applyBrokenSegmentMotion = (sample, breakSample, motion) => {
        const relativeX = sample.x - breakSample.x;
        const relativeY = sample.y - breakSample.y;
        const cosine = Math.cos(motion.swingAngle);
        const sine = Math.sin(motion.swingAngle);
        sample.x = breakSample.x
          + relativeX * cosine
          - relativeY * sine
          + motion.translateX;
        sample.y = breakSample.y
          + relativeX * sine
          + relativeY * cosine
          + motion.translateY;
        sample.angle += motion.swingAngle;
      };

      const drawBrokenChainPiece = (
        context,
        event,
        side,
        visibility,
        rupturePulse
      ) => {
        const {
          definition,
          breakSample,
          heat,
          breakOpen,
          recoil,
          snapPulse,
          releaseFade
        } = event;
        if (breakOpen <= 0.001) return;
        const dimensions = getChainLinkDimensions(definition);
        const motion = resolveBrokenSegmentMotion(
          definition,
          breakSample,
          side,
          dimensions,
          breakOpen,
          recoil,
          snapPulse
        );
        const fragmentProgress = clamp(breakOpen * 0.62 + recoil * 0.38, 0, 1.08);
        const polarity = definition.id === 1 ? -1 : 1;
        const center = {
          x: breakSample.x + breakSample.tangentX * side * dimensions.width * 0.16,
          y: breakSample.y + breakSample.tangentY * side * dimensions.width * 0.16,
          angle: breakSample.angle
        };
        applyBrokenSegmentMotion(center, breakSample, motion);
        center.x += breakSample.tangentX
          * side
          * dimensions.width
          * fragmentProgress
          * (0.42 + snapPulse * 0.24);
        center.y += breakSample.tangentY
          * side
          * dimensions.width
          * fragmentProgress
          * (0.42 + snapPulse * 0.24);
        center.x += breakSample.normalX
          * side
          * polarity
          * dimensions.height
          * (0.22 + fragmentProgress * 0.48);
        center.y += breakSample.normalY
          * side
          * polarity
          * dimensions.height
          * (0.22 + fragmentProgress * 0.48);
        center.angle += side
          * polarity
          * (0.24 + fragmentProgress * 0.78 + snapPulse * 0.18);
        const pieceAlpha = visibility
          * smootherstep(clamp(breakOpen / 0.28, 0, 1))
          * (1 - releaseFade * 0.96);
        if (pieceAlpha <= 0.002) return;

        context.save();
        context.globalCompositeOperation = "source-over";
        drawChainLinkArc(
          context,
          center,
          side < 0 ? 0 : 1,
          definition,
          pieceAlpha,
          heat,
          true,
          side < 0 ? "far" : "near",
          side * fragmentProgress * 0.34,
          0.94 + snapPulse * 0.08,
          1
        );
        context.translate(center.x, center.y);
        context.rotate(center.angle + side * fragmentProgress * 0.34);
        context.globalCompositeOperation = "screen";
        context.globalAlpha = pieceAlpha * Math.max(rupturePulse, snapPulse) * 0.92;
        context.strokeStyle = "rgba(255,244,249,0.98)";
        context.lineWidth = 0.9 + snapPulse * 0.65;
        context.shadowColor = "rgba(255,70,138,0.94)";
        context.shadowBlur = 4 + snapPulse * 5;
        const cutX = -side * dimensions.width * 0.27;
        const cutY = side * dimensions.height * 0.18;
        context.beginPath();
        context.moveTo(cutX - side * 2.8, cutY - 2.5);
        context.lineTo(cutX + side * 3.2, cutY + 2.6);
        context.stroke();
        context.restore();
      };

      const createHeartPath = (centerX, centerY, size, scale = 1) => {
        const path = new Path2D();
        const steps = 52;
        for (let index = 0; index <= steps; index += 1) {
          const angle = index / steps * fullTurn;
          const x = Math.sin(angle) ** 3 * 16;
          const y = -(
            13 * Math.cos(angle)
              - 5 * Math.cos(angle * 2)
              - 2 * Math.cos(angle * 3)
              - Math.cos(angle * 4)
          );
          const pointX = centerX + x / 17 * size * scale;
          const pointY = centerY + y / 17 * size * scale;
          if (index === 0) path.moveTo(pointX, pointY);
          else path.lineTo(pointX, pointY);
        }
        path.closePath();
        return path;
      };

      const drawChainHeartSeal = (timestamp, intro, events, visibility, isMobile) => {
        if (!chainBackContext || !chainFrontContext || events.length === 0) return;
        const build = smootherstep(clamp((intro - 0.49) / 0.16, 0, 1));
        const fracture = smootherstep(clamp((intro - 0.69) / 0.18, 0, 1));
        const fade = 1 - smootherstep(clamp((intro - 0.88) / 0.095, 0, 1));
        const opacity = build * fade * visibility;
        if (opacity <= 0.001) return;

        const centerX = (chainGlyphLayout.centerX || chainTitleBox.left + chainTitleBox.width * 0.5)
          + chainTitleBox.width * 0.012;
        const centerY = (chainGlyphLayout.centerY || chainTitleBox.top + chainTitleBox.height * 0.52)
          + chainTitleBox.height * 0.045;
        const lockPulse = Math.exp(-Math.pow((intro - 0.665) / 0.052, 2));
        const heartbeat = 0.5 + Math.sin(timestamp * 0.018) * 0.5;
        const size = clamp(
          chainTitleBox.height * (isMobile ? 0.205 : 0.19),
          isMobile ? 15 : 17,
          isMobile ? 25 : 32
        ) * (0.82 + build * 0.18 + lockPulse * 0.08);
        const splitDistance = size * fracture * 0.29;
        const splitDrop = size * fracture ** 2 * 0.08;
        const heart = createHeartPath(centerX, centerY, size);
        const tetherOpacity = opacity * (1 - fracture) * 0.68;

        if (tetherOpacity > 0.002) {
          const tetherTargets = [
            { x: centerX - size * 0.56, y: centerY - size * 0.14 },
            { x: centerX + size * 0.56, y: centerY - size * 0.14 },
            { x: centerX, y: centerY + size * 0.72 }
          ];
          for (let index = 0; index < events.length; index += 1) {
            const event = events[index];
            const target = tetherTargets[index % tetherTargets.length];
            const controlX = event.breakSample.x
              + (target.x - event.breakSample.x) * 0.55
              + event.breakSample.normalX * size * (index - 1) * 0.18;
            const controlY = event.breakSample.y
              + (target.y - event.breakSample.y) * 0.42
              + event.breakSample.normalY * size * (index - 1) * 0.18;
            chainBackContext.save();
            chainBackContext.globalCompositeOperation = "source-over";
            chainBackContext.globalAlpha = tetherOpacity * 0.72;
            chainBackContext.strokeStyle = "rgba(29,7,30,0.9)";
            chainBackContext.lineWidth = 3.4;
            chainBackContext.beginPath();
            chainBackContext.moveTo(event.breakSample.x, event.breakSample.y);
            chainBackContext.quadraticCurveTo(controlX, controlY, target.x, target.y);
            chainBackContext.stroke();
            chainBackContext.restore();

            chainFrontContext.save();
            chainFrontContext.globalCompositeOperation = "screen";
            chainFrontContext.globalAlpha = tetherOpacity * (0.62 + event.snapPulse * 0.32);
            chainFrontContext.strokeStyle = index === 1
              ? "rgba(255,239,247,0.96)"
              : "rgba(255,83,142,0.94)";
            chainFrontContext.lineWidth = 0.72 + event.snapPulse * 0.52;
            chainFrontContext.shadowColor = "rgba(255,54,126,0.84)";
            chainFrontContext.shadowBlur = 3 + event.snapPulse * 5;
            chainFrontContext.beginPath();
            chainFrontContext.moveTo(event.breakSample.x, event.breakSample.y);
            chainFrontContext.quadraticCurveTo(controlX, controlY, target.x, target.y);
            chainFrontContext.stroke();
            chainFrontContext.restore();
          }
        }

        const drawHeartHalf = (context, side, drawMaterial) => {
          context.save();
          if (fracture > 0.001) {
            context.beginPath();
            context.rect(
              side < 0 ? centerX - size * 1.7 : centerX,
              centerY - size * 1.7,
              size * 1.7,
              size * 3.4
            );
            context.clip();
            context.translate(centerX, centerY);
            context.rotate(side * fracture * 0.085);
            context.translate(-centerX + side * splitDistance, -centerY + splitDrop);
          }
          drawMaterial();
          context.restore();
        };

        for (const side of fracture > 0.001 ? [-1, 1] : [0]) {
          drawHeartHalf(chainBackContext, side, () => {
            chainBackContext.globalCompositeOperation = "source-over";
            chainBackContext.globalAlpha = opacity * 0.32;
            chainBackContext.fillStyle = "rgba(72,8,48,0.72)";
            chainBackContext.shadowColor = "rgba(255,44,116,0.28)";
            chainBackContext.shadowBlur = 4 + lockPulse * 4;
            chainBackContext.fill(heart);
            chainBackContext.globalAlpha = opacity * 0.72;
            chainBackContext.strokeStyle = "rgba(27,6,29,0.94)";
            chainBackContext.lineWidth = 4.4;
            chainBackContext.stroke(heart);
          });
          drawHeartHalf(chainFrontContext, side, () => {
            chainFrontContext.globalCompositeOperation = "screen";
            chainFrontContext.globalAlpha = opacity * 0.12;
            chainFrontContext.fillStyle = "rgba(255,57,124,0.88)";
            chainFrontContext.shadowColor = "rgba(255,48,118,0.52)";
            chainFrontContext.shadowBlur = 4 + lockPulse * 4;
            chainFrontContext.fill(heart);
            chainFrontContext.globalAlpha = opacity * (0.76 + heartbeat * 0.12);
            chainFrontContext.strokeStyle = "rgba(255,72,137,0.98)";
            chainFrontContext.lineWidth = 2.05 + lockPulse * 0.5;
            chainFrontContext.shadowColor = "rgba(255,50,122,0.88)";
            chainFrontContext.shadowBlur = 5 + lockPulse * 5;
            chainFrontContext.stroke(heart);
            chainFrontContext.globalAlpha = opacity * (0.58 + lockPulse * 0.28);
            chainFrontContext.strokeStyle = "rgba(255,245,250,0.98)";
            chainFrontContext.lineWidth = 0.68 + lockPulse * 0.32;
            chainFrontContext.shadowBlur = 1.6;
            chainFrontContext.stroke(heart);
          });
        }

        if (fracture > 0.015) {
          chainFrontContext.save();
          chainFrontContext.globalCompositeOperation = "screen";
          chainFrontContext.globalAlpha = opacity * Math.sin(fracture * Math.PI) * 0.9;
          chainFrontContext.strokeStyle = "rgba(255,248,251,0.98)";
          chainFrontContext.lineWidth = 0.9 + lockPulse * 0.5;
          chainFrontContext.shadowColor = "rgba(255,57,128,0.92)";
          chainFrontContext.shadowBlur = 5;
          chainFrontContext.beginPath();
          chainFrontContext.moveTo(centerX - size * 0.02, centerY - size * 0.76);
          chainFrontContext.lineTo(centerX + size * 0.12, centerY - size * 0.24);
          chainFrontContext.lineTo(centerX - size * 0.08, centerY + size * 0.12);
          chainFrontContext.lineTo(centerX + size * 0.04, centerY + size * 0.72);
          chainFrontContext.stroke();

          const shardPulse = Math.sin(smootherstep(fracture) * Math.PI);
          for (let shardIndex = 0; shardIndex < (isMobile ? 5 : 7); shardIndex += 1) {
            const seed = randomSeed(41021 + shardIndex * 91.7);
            const angle = -Math.PI * 0.92 + seed * Math.PI * 1.84;
            const travel = size * fracture * (0.52 + seed * 1.08);
            const startX = centerX + Math.cos(angle) * size * 0.38;
            const startY = centerY + Math.sin(angle) * size * 0.3;
            const endX = startX + Math.cos(angle) * travel;
            const endY = startY + Math.sin(angle) * travel * 0.72;
            chainFrontContext.globalAlpha = opacity * shardPulse * (0.38 + seed * 0.48);
            chainFrontContext.strokeStyle = shardIndex % 3 === 0
              ? "rgba(229,239,255,0.96)"
              : "rgba(255,87,145,0.96)";
            chainFrontContext.lineWidth = 0.6 + seed * 0.9;
            chainFrontContext.beginPath();
            chainFrontContext.moveTo(startX, startY);
            chainFrontContext.lineTo(endX, endY);
            chainFrontContext.stroke();
          }
          chainFrontContext.restore();
        }
      };

      const drawChainShatterParticles = (context, records, isMobile) => {
        if (!context || records.length === 0) return;
        const shardCount = isMobile ? 4 : 6;
        context.save();
        context.lineCap = "round";
        context.lineJoin = "round";
        for (const record of records) {
          const born = smootherstep(clamp(record.age / 0.045, 0, 1));
          const fade = 1 - smootherstep(clamp((record.age - 0.58) / 0.42, 0, 1));
          const baseAlpha = record.alpha * born * fade;
          if (baseAlpha <= 0.002) continue;
          const dimensions = getChainLinkDimensions(record.definition);
          const materialHeat = clamp(record.heat, 0, 1);
          const shardBody = `rgb(${Math.round(37 + materialHeat * 22)},${Math.round(41 - materialHeat * 19)},${Math.round(48 - materialHeat * 19)})`;
          const shardRim = `rgb(${Math.round(144 + materialHeat * 42)},${Math.round(153 - materialHeat * 27)},${Math.round(166 - materialHeat * 29)})`;
          const outwardX = record.sample.tangentX * record.side;
          const outwardY = record.sample.tangentY * record.side;
          const sampleCosine = Math.cos(record.sample.angle);
          const sampleSine = Math.sin(record.sample.angle);
          for (let shardIndex = 0; shardIndex < shardCount; shardIndex += 1) {
            const seedA = randomSeed(record.seed * 701.3 + shardIndex * 53.7 + 17.1);
            const seedB = randomSeed(record.seed * 977.9 + shardIndex * 89.3 + 31.7);
            const seedC = randomSeed(record.seed * 1237.1 + shardIndex * 131.9 + 47.3);
            const rimAngle = seedC * fullTurn;
            const localRimX = Math.cos(rimAngle)
              * dimensions.width
              * (0.28 + seedA * 0.08);
            const localRimY = Math.sin(rimAngle)
              * dimensions.height
              * (0.3 + seedB * 0.08);
            const originX = record.sample.x
              + localRimX * sampleCosine
              - localRimY * sampleSine;
            const originY = record.sample.y
              + localRimX * sampleSine
              + localRimY * sampleCosine;
            const localRadialLength = Math.max(0.001, Math.hypot(localRimX, localRimY));
            const localRadialX = localRimX / localRadialLength;
            const localRadialY = localRimY / localRadialLength;
            const radialX = localRadialX * sampleCosine - localRadialY * sampleSine;
            const radialY = localRadialX * sampleSine + localRadialY * sampleCosine;
            let velocityX = radialX * (0.72 + seedA * 0.88)
              + outwardX * (0.34 + seedB * 0.74)
              + record.sample.normalX * (seedC - 0.5) * 1.35;
            let velocityY = radialY * (0.72 + seedA * 0.88)
              + outwardY * (0.34 + seedB * 0.74)
              + record.sample.normalY * (seedC - 0.5) * 1.35;
            const velocityLength = Math.max(0.001, Math.hypot(velocityX, velocityY));
            velocityX /= velocityLength;
            velocityY /= velocityLength;
            const travel = chainTitleBox.height
              * (0.085 + seedA * 0.42)
              * easeOutCubic(record.age);
            const drift = Math.sin(record.age * Math.PI)
              * chainTitleBox.height
              * (seedB - 0.5)
              * 0.075;
            const x = originX
              + velocityX * travel
              + record.sample.normalX * drift;
            const y = originY
              + velocityY * travel
              + record.sample.normalY * drift
              + chainTitleBox.height * record.age ** 2 * (seedC - 0.34) * 0.028;
            const angle = Math.atan2(velocityY, velocityX)
              + (seedC - 0.5) * record.age * 4.8;
            const shardLength = (2.3 + seedB * 5.8) * (1 - record.age * 0.32);
            const shardWidth = (0.85 + seedC * 1.55) * (1 - record.age * 0.24);
            const directionX = Math.cos(angle);
            const directionY = Math.sin(angle);
            const perpendicularX = -directionY;
            const perpendicularY = directionX;
            const halfLength = shardLength * 0.5;
            const halfWidth = shardWidth * 0.5;
            const shardAlpha = baseAlpha * (0.62 + seedA * 0.36);

            context.globalCompositeOperation = "source-over";
            context.globalAlpha = shardAlpha;
            context.fillStyle = shardBody;
            context.beginPath();
            context.moveTo(
              x + directionX * halfLength,
              y + directionY * halfLength
            );
            context.lineTo(
              x - directionX * halfLength + perpendicularX * halfWidth,
              y - directionY * halfLength + perpendicularY * halfWidth
            );
            context.lineTo(
              x - directionX * halfLength - perpendicularX * halfWidth,
              y - directionY * halfLength - perpendicularY * halfWidth
            );
            context.closePath();
            context.fill();

            context.globalAlpha = shardAlpha * 0.92;
            context.strokeStyle = shardRim;
            context.lineWidth = 0.58 + seedC * 0.64;
            context.beginPath();
            context.moveTo(
              x - directionX * halfLength * 0.82,
              y - directionY * halfLength * 0.82
            );
            context.lineTo(
              x + directionX * halfLength,
              y + directionY * halfLength
            );
            context.stroke();

            context.globalCompositeOperation = "screen";
            context.globalAlpha = shardAlpha * (0.38 + seedB * 0.46);
            context.fillStyle = shardIndex % 2 === 0
              ? "rgba(230,219,218,0.94)"
              : "rgba(199,98,115,0.88)";
            context.beginPath();
            context.arc(
              x + directionX * halfLength,
              y + directionY * halfLength,
              0.42 + seedA * 0.78,
              0,
              fullTurn
            );
            context.fill();
          }
        }
        context.restore();
      };

      const createContractHeartPath = (centerX, centerY, size, scale = 1) => {
        const radius = size * scale;
        const path = new Path2D();
        path.moveTo(centerX, centerY + radius * 0.74);
        path.bezierCurveTo(
          centerX - radius * 0.16,
          centerY + radius * 0.58,
          centerX - radius * 0.92,
          centerY + radius * 0.12,
          centerX - radius * 0.92,
          centerY - radius * 0.34
        );
        path.bezierCurveTo(
          centerX - radius * 0.92,
          centerY - radius * 0.73,
          centerX - radius * 0.48,
          centerY - radius * 0.92,
          centerX,
          centerY - radius * 0.47
        );
        path.bezierCurveTo(
          centerX + radius * 0.48,
          centerY - radius * 0.92,
          centerX + radius * 0.92,
          centerY - radius * 0.73,
          centerX + radius * 0.92,
          centerY - radius * 0.34
        );
        path.bezierCurveTo(
          centerX + radius * 0.92,
          centerY + radius * 0.12,
          centerX + radius * 0.16,
          centerY + radius * 0.58,
          centerX,
          centerY + radius * 0.74
        );
        path.closePath();
        return path;
      };

      const drawContractHeartImprint = (timestamp, intro, events, visibility, isMobile) => {
        if (!chainBackContext || !chainFrontContext || events.length === 0) return;
        const build = smootherstep(clamp((intro - 0.23) / 0.105, 0, 1));
        const collapse = smootherstep(clamp((intro - 0.68) / 0.105, 0, 1));
        const fade = 1 - smootherstep(clamp((intro - 0.84) / 0.11, 0, 1));
        const opacity = build * fade * visibility;
        if (opacity <= 0.001) return;

        const centerX = (chainGlyphLayout.centerX || chainTitleBox.left + chainTitleBox.width * 0.5)
          + chainTitleBox.width * 0.012;
        const centerY = (chainGlyphLayout.centerY || chainTitleBox.top + chainTitleBox.height * 0.52)
          + chainTitleBox.height * 0.045;
        const lockPulse = Math.exp(-Math.pow((intro - 0.36) / 0.042, 2));
        const heartbeat = 0.5 + Math.sin(timestamp * 0.016) * 0.5;
        const size = clamp(
          chainTitleBox.height * (isMobile ? 0.205 : 0.19),
          isMobile ? 15 : 17,
          isMobile ? 25 : 32
        );
        const heartScale = (0.76 + build * 0.24 + lockPulse * 0.08)
          * (1 - collapse * 0.56);
        const heart = createContractHeartPath(centerX, centerY, size, heartScale);
        const threadStrength = phaseProgress(intro, 0.19, 0.255)
          * (1 - phaseProgress(intro, 0.39, 0.5));

        if (threadStrength > 0.001) {
          chainFrontContext.save();
          chainFrontContext.globalCompositeOperation = "screen";
          chainFrontContext.lineCap = "round";
          for (let index = 0; index < events.length; index += 1) {
            const event = events[index];
            const bend = (index - 1) * size * 0.28;
            chainFrontContext.globalAlpha = visibility * threadStrength * (0.34 + index * 0.08);
            chainFrontContext.strokeStyle = index === 1
              ? "rgba(255,240,247,0.94)"
              : "rgba(255,75,138,0.9)";
            chainFrontContext.lineWidth = 0.62 + event.snapPulse * 0.36;
            chainFrontContext.beginPath();
            chainFrontContext.moveTo(event.breakSample.x, event.breakSample.y);
            chainFrontContext.quadraticCurveTo(
              (event.breakSample.x + centerX) * 0.5 + event.breakSample.normalX * bend,
              (event.breakSample.y + centerY) * 0.5 + event.breakSample.normalY * bend,
              centerX,
              centerY
            );
            chainFrontContext.stroke();
          }
          chainFrontContext.restore();
        }

        chainBackContext.save();
        chainBackContext.globalCompositeOperation = "source-over";
        chainBackContext.globalAlpha = opacity * (0.3 + lockPulse * 0.08);
        chainBackContext.fillStyle = "rgba(66,7,43,0.8)";
        chainBackContext.shadowColor = "rgba(255,43,115,0.3)";
        chainBackContext.shadowBlur = 4 + lockPulse * 3;
        chainBackContext.fill(heart);
        chainBackContext.globalAlpha = opacity * 0.78;
        chainBackContext.strokeStyle = "rgba(24,5,28,0.96)";
        chainBackContext.lineWidth = 4.2;
        chainBackContext.stroke(heart);
        chainBackContext.restore();

        chainFrontContext.save();
        chainFrontContext.globalCompositeOperation = "screen";
        chainFrontContext.globalAlpha = opacity * (0.24 + lockPulse * 0.16);
        chainFrontContext.fillStyle = "rgba(255,53,121,0.9)";
        chainFrontContext.shadowColor = "rgba(255,47,117,0.56)";
        chainFrontContext.shadowBlur = 4 + lockPulse * 6;
        chainFrontContext.fill(heart);
        chainFrontContext.globalAlpha = opacity * (0.82 + heartbeat * 0.1);
        chainFrontContext.strokeStyle = "rgba(255,72,137,0.99)";
        chainFrontContext.lineWidth = 2.1 + lockPulse * 0.42;
        chainFrontContext.stroke(heart);
        chainFrontContext.globalAlpha = opacity * (0.58 + lockPulse * 0.24);
        chainFrontContext.strokeStyle = "rgba(255,247,251,0.98)";
        chainFrontContext.lineWidth = 0.68 + lockPulse * 0.28;
        chainFrontContext.shadowBlur = 1.4;
        chainFrontContext.stroke(heart);

        if (lockPulse > 0.001) {
          const pulseHeart = createContractHeartPath(
            centerX,
            centerY,
            size,
            heartScale * (1 + lockPulse * 0.34)
          );
          chainFrontContext.globalAlpha = opacity * lockPulse * 0.3;
          chainFrontContext.strokeStyle = "rgba(255,229,241,0.96)";
          chainFrontContext.lineWidth = 0.82;
          chainFrontContext.shadowBlur = 5;
          chainFrontContext.stroke(pulseHeart);
        }
        chainFrontContext.restore();

        const burst = phaseProgress(intro, 0.695, 0.94);
        if (burst <= 0.001) return;
        chainFrontContext.save();
        chainFrontContext.globalCompositeOperation = "screen";
        chainFrontContext.lineCap = "round";
        const particleCount = isMobile ? 10 : 15;
        for (let index = 0; index < particleCount; index += 1) {
          const seedA = randomSeed(52021 + index * 73.7);
          const seedB = randomSeed(62003 + index * 97.1);
          const age = clamp((burst - seedA * 0.13) / (1 - seedA * 0.13), 0, 1);
          if (age <= 0.001 || age >= 0.999) continue;
          const born = smootherstep(clamp(age / 0.12, 0, 1));
          const particleAlpha = visibility * born * (1 - age) ** 1.45;
          const angle = seedB * fullTurn - Math.PI * 0.5;
          const travel = size * (0.44 + seedA * 1.9) * easeOutCubic(age);
          const x = centerX + Math.cos(angle) * travel;
          const y = centerY + Math.sin(angle) * travel * 0.78;
          const length = 0.8 + seedB * 3.2;
          chainFrontContext.globalAlpha = particleAlpha * (0.46 + seedA * 0.5);
          chainFrontContext.strokeStyle = index % 3 === 0
            ? "rgba(226,239,255,0.96)"
            : "rgba(255,81,143,0.96)";
          chainFrontContext.lineWidth = 0.55 + seedA * 0.62;
          chainFrontContext.beginPath();
          chainFrontContext.moveTo(
            x - Math.cos(angle) * length,
            y - Math.sin(angle) * length
          );
          chainFrontContext.lineTo(x, y);
          chainFrontContext.stroke();
        }
        const collapseFlash = Math.sin(collapse * Math.PI);
        if (collapseFlash > 0.001) {
          const flash = chainFrontContext.createRadialGradient(
            centerX,
            centerY,
            0,
            centerX,
            centerY,
            size * (0.5 + collapseFlash * 0.8)
          );
          flash.addColorStop(0, "rgba(255,255,255,0.96)");
          flash.addColorStop(0.18, "rgba(255,205,226,0.78)");
          flash.addColorStop(1, "rgba(255,48,119,0)");
          chainFrontContext.globalAlpha = visibility * collapseFlash * 0.72;
          chainFrontContext.fillStyle = flash;
          chainFrontContext.fillRect(
            centerX - size * 1.4,
            centerY - size * 1.4,
            size * 2.8,
            size * 2.8
          );
        }
        chainFrontContext.restore();
      };

      const drawChainRupture = (timestamp, intro, events, visibility, isMobile) => {
        if (!chainFrontContext || events.length === 0) return;
        const stressPulse = Math.sin(phaseProgress(intro, 0.012, 0.145) * Math.PI);
        const rupturePulse = Math.sin(phaseProgress(intro, 0.1, 0.48) * Math.PI);
        if (Math.max(stressPulse, rupturePulse) <= 0.001) return;
        const context = chainFrontContext;
        context.save();
        context.lineCap = "round";
        for (const event of events) {
          const { breakSample, breakSeed, heat, breakOpen, snapPulse } = event;
          const dimensions = getChainLinkDimensions(event.definition);
          context.save();
          context.globalCompositeOperation = "screen";
          if (stressPulse > 0.001 && breakOpen < 0.98) {
            const stressLength = dimensions.width * (0.4 + stressPulse * 0.42);
            context.globalAlpha = visibility * stressPulse * (1 - breakOpen) * 0.72;
            context.strokeStyle = heat > 0.5
              ? "rgba(255,229,240,0.98)"
              : "rgba(226,238,255,0.96)";
            context.lineWidth = 0.8 + stressPulse * 1.2;
            context.shadowColor = heat > 0.5
              ? "rgba(255,56,128,0.9)"
              : "rgba(126,166,255,0.78)";
            context.shadowBlur = 4 + stressPulse * 8;
            context.beginPath();
            context.moveTo(
              breakSample.x - breakSample.tangentX * stressLength,
              breakSample.y - breakSample.tangentY * stressLength
            );
            context.lineTo(
              breakSample.x + breakSample.tangentX * stressLength,
              breakSample.y + breakSample.tangentY * stressLength
            );
            context.stroke();
          }

          if (snapPulse > 0.002) {
            const coreRadius = dimensions.width * (0.24 + snapPulse * 0.46);
            const core = context.createRadialGradient(
              breakSample.x,
              breakSample.y,
              0,
              breakSample.x,
              breakSample.y,
              coreRadius
            );
            core.addColorStop(0, "rgba(255,255,255,0.98)");
            core.addColorStop(0.16, "rgba(255,221,235,0.88)");
            core.addColorStop(0.46, "rgba(255,62,130,0.38)");
            core.addColorStop(1, "rgba(255,45,119,0)");
            context.globalAlpha = visibility * snapPulse * 0.96;
            context.fillStyle = core;
            context.fillRect(
              breakSample.x - coreRadius,
              breakSample.y - coreRadius,
              coreRadius * 2,
              coreRadius * 2
            );

            context.translate(breakSample.x, breakSample.y);
            context.rotate(breakSample.angle);
            context.globalAlpha = visibility * snapPulse * 0.84;
            context.strokeStyle = heat > 0.5
              ? "rgba(255,230,240,0.98)"
              : "rgba(226,240,255,0.98)";
            context.lineWidth = 0.72 + snapPulse * 0.86;
            context.shadowColor = "rgba(255,58,132,0.9)";
            context.shadowBlur = 4 + snapPulse * 7;
            for (const side of [-1, 1]) {
              context.beginPath();
              context.ellipse(
                side * dimensions.width * 0.07,
                0,
                dimensions.width * (0.36 + snapPulse * 0.72),
                dimensions.height * (0.34 + snapPulse * 0.48),
                0,
                side < 0 ? Math.PI * 0.64 : -Math.PI * 0.36,
                side < 0 ? Math.PI * 1.18 : Math.PI * 0.18
              );
              context.stroke();
            }
            context.rotate(-breakSample.angle);
            context.translate(-breakSample.x, -breakSample.y);
          }

          if (rupturePulse <= 0.001) {
            context.restore();
            continue;
          }
          const sparkCount = isMobile ? 5 : 8;
          for (let sparkIndex = 0; sparkIndex < sparkCount; sparkIndex += 1) {
            const seed = randomSeed(breakSeed * 1000 + sparkIndex * 37.1);
            const direction = sparkIndex % 2 === 0 ? -1 : 1;
            const tangentWeight = (0.52 + seed * 0.82) * direction;
            const normalWeight = (seed - 0.5) * 1.08;
            const length = chainTitleBox.height
              * (0.055 + seed * 0.13)
              * (0.52 + rupturePulse * 0.48);
            const bend = (seed - 0.5) * chainTitleBox.height * 0.045;
            const midX = breakSample.x
              + (breakSample.tangentX * tangentWeight + breakSample.normalX * normalWeight)
                * length
                * 0.52
              + breakSample.normalX * bend;
            const midY = breakSample.y
              + (breakSample.tangentY * tangentWeight + breakSample.normalY * normalWeight)
                * length
                * 0.52
              + breakSample.normalY * bend;
            const endX = breakSample.x
              + (breakSample.tangentX * tangentWeight + breakSample.normalX * normalWeight) * length;
            const endY = breakSample.y
              + (breakSample.tangentY * tangentWeight + breakSample.normalY * normalWeight) * length;
            context.globalAlpha = visibility
              * rupturePulse
              * (0.46 + seed * 0.48)
              * (0.74 + snapPulse * 0.26);
            context.strokeStyle = sparkIndex % 3 === 0
              ? "rgba(255,251,253,0.98)"
              : "rgba(255,94,151,0.94)";
            context.lineWidth = 0.72 + seed * 1.08;
            context.shadowColor = "rgba(255,51,124,0.9)";
            context.shadowBlur = 3 + rupturePulse * 6;
            context.beginPath();
            context.moveTo(
              breakSample.x + breakSample.tangentX * tangentWeight * 2,
              breakSample.y + breakSample.tangentY * tangentWeight * 2
            );
            context.quadraticCurveTo(midX, midY, endX, endY);
            context.stroke();
          }
          context.restore();
        }
        context.restore();
      };

      const drawTitleChains = (timestamp, fill) => {
        if (!chainBackCanvas || !chainBackContext || !chainFrontCanvas || !chainFrontContext) return;
        if (chainCanvasWidth <= 1 || chainCanvasHeight <= 1 || chainTitleBox.width <= 1) {
          resizeTitleChains();
        }
        if (chainCanvasWidth <= 1 || chainCanvasHeight <= 1 || chainTitleBox.width <= 1) return;

        const intro = clamp(chargeIntroProgress, 0, 1);
        const activation = phaseProgress(fill, 0.012, 0.11);
        const introFade = 1 - phaseProgress(intro, 0.955, 1);
        const burstFade = 1 - phaseProgress(burstProgress, 0.004, 0.045);
        const visibility = activation * introFade * burstFade;
        chainMaterialVisibility = chainMaterial?.visibility(timestamp) ?? 0;
        const chainFrameInterval = intro < 0.045 || intro > 0.3 ? 26 : 0;
        if (
          chainFrameInterval > 0
          && chainLastPaintTimestamp > 0
          && timestamp - chainLastPaintTimestamp < chainFrameInterval
          && Math.abs(fill - chainLastPaintFill) < 0.003
          && Math.abs(intro - chainLastPaintIntro) < 0.003
        ) {
          return;
        }
        if (visibility <= 0.001) {
          if (chainFrontCanvas.style.opacity !== "0" || chainBackCanvas.style.opacity !== "0") {
            clearTitleChains();
          }
          return;
        }

        const contexts = [chainBackContext, chainFrontContext];
        const canvases = [chainBackCanvas, chainFrontCanvas];
        for (let layerIndex = 0; layerIndex < contexts.length; layerIndex += 1) {
          const context = contexts[layerIndex];
          const canvas = canvases[layerIndex];
          context.setTransform(1, 0, 0, 1, 0, 0);
          context.clearRect(0, 0, canvas.width, canvas.height);
          context.setTransform(chainPixelRatio, 0, 0, chainPixelRatio, 0, 0);
        }

        const isMobile = mobilePerformance || chainTitleBox.width < 420;
        const releaseFade = phaseProgress(intro, 0.84, 0.985);
        const centerDissolve = phaseProgress(intro, 0.16, 0.5);
        const layerRecords = {
          backFrame: [],
          backWeave: [],
          frontFrame: [],
          frontWeave: []
        };
        const shatterRecords = [];
        const ruptureEvents = [];
        const leaders = [];
        const colorFront = -0.26
          + phaseProgress(fill, 0.1, 1) * 1.16
          + phaseProgress(intro, 0.02, 0.115) * 0.16;
        const resolveChainHeat = (order, seed = 0.5) => {
          const localFront = colorFront + (seed - 0.5) * 0.1;
          return 1 - smootherstep(clamp((order - (localFront - 0.24)) / 0.48, 0, 1));
        };
        const edgeMarginX = Math.max(24, chainCanvasWidth * 0.07);
        const edgeMarginY = Math.max(18, chainCanvasHeight * 0.08);
        const resolveCanvasEdgeFade = (sample) => {
          const left = smootherstep(clamp(sample.x / edgeMarginX, 0, 1));
          const right = smootherstep(clamp((chainCanvasWidth - sample.x) / edgeMarginX, 0, 1));
          const top = smootherstep(clamp(sample.y / edgeMarginY, 0, 1));
          const bottom = smootherstep(clamp((chainCanvasHeight - sample.y) / edgeMarginY, 0, 1));
          return left * right * top * bottom;
        };
        const resolveCenterDissolve = (sample) => {
          if (centerDissolve <= 0.001) return 1;
          const centerX = chainGlyphLayout.centerX || chainTitleBox.left + chainTitleBox.width * 0.5;
          const centerY = chainGlyphLayout.centerY || chainTitleBox.top + chainTitleBox.height * 0.52;
          const distance = Math.hypot(sample.x - centerX, sample.y - centerY);
          const radius = centerDissolve
            * Math.max(chainTitleBox.width * 0.58, chainTitleBox.height * 1.9);
          const feather = Math.max(10, chainTitleBox.height * 0.18);
          return smootherstep(clamp((distance - radius) / feather, 0, 1));
        };

        for (const definition of chainDefinitions) {
          const buildStart = isMobile && definition.type === "weave"
            ? definition.id === 1
              ? 0.22
              : 0.56
            : definition.buildStart;
          const buildEnd = isMobile && definition.type === "weave"
            ? definition.id === 1
              ? 0.82
              : 1
            : definition.buildEnd;
          const build = phaseProgress(fill, buildStart, buildEnd);
          if (build <= 0.001) continue;
          const path = resolveTitleChainPath(definition, fill, intro);
          const spacing = buildTitleChainLinkUnits(definition, isMobile);
          const frameConnectorLengthScale = definition.type === "frame"
            ? clamp(
                (
                  spacing.totalLength
                    / Math.max(1, spacing.records.length)
                    * 2
                    / Math.max(1, getChainLinkDimensions(definition).width)
                ) - 0.58,
                0.62,
                0.82
              )
            : 1;
          const breakDelay = definition.id * 0.055;
          const breakStart = 0.105 + breakDelay;
          const definitionBreakLinear = clamp((intro - breakStart) / 0.05, 0, 1);
          const definitionBreakOpen = easeOutCubic(definitionBreakLinear);
          const definitionSnapLinear = clamp((intro - breakStart) / 0.09, 0, 1);
          const definitionSnapPulse = Math.sin(definitionSnapLinear * Math.PI) ** 0.72;
          const definitionRecoilUnit = clamp(
            (intro - (breakStart + 0.018)) / 0.19,
            0,
            1
          );
          const definitionRecoil = clamp(
            easeOutCubic(definitionRecoilUnit)
              + Math.sin(definitionRecoilUnit * Math.PI)
                * Math.exp(-definitionRecoilUnit * 1.8)
                * 0.16,
            0,
            1.08
          );
          const breakDistanceUnit = spacing.distanceAtUnit(definition.breakT);
          let breakLinkIndex = 0;
          let nearestBreakDistance = Infinity;
          for (let index = 0; index < spacing.records.length; index += 1) {
            const distance = Math.abs(spacing.records[index].distanceUnit - breakDistanceUnit);
            if (distance < nearestBreakDistance) {
              nearestBreakDistance = distance;
              breakLinkIndex = index;
            }
          }
          const travel = definition.type === "weave" ? build : easeOutCubic(build);
          const travelSpan = 1 + definition.entryOverscan;
          const travelOffset = definition.direction > 0
            ? travel * travelSpan - travelSpan
            : travelSpan - travel * travelSpan;
          const sealMotion = resolveSealMotion(fill, intro);
          const scrollDrivenFrameFeed = definition.type === "frame"
            ? smootherstep(phaseProgress(fill, definition.buildEnd, 1)) * 0.46
            : 0;
          const tighteningFrameFeed = (
            sealMotion.takeUp * 0.17
              + sealMotion.lock * 0.055
              + sealMotion.lockKick * 0.018
          ) * (1 - phaseProgress(intro, 0.12, 0.17));
          const frameDistanceFeed = definition.type === "frame"
            ? definition.direction * (
                scrollDrivenFrameFeed + tighteningFrameFeed
              )
            : 0;
          const normalizeFrameDistance = (distanceUnit) => {
            const wrapped = distanceUnit % 1;
            return wrapped < 0 ? wrapped + 1 : wrapped;
          };
          const breakTravelUnit = definition.type === "frame"
            ? normalizeFrameDistance(breakDistanceUnit + frameDistanceFeed)
            : breakDistanceUnit;
          const breakSample = sampleTitleChainTravel(
            definition,
            path,
            breakTravelUnit,
            spacing,
            fill,
            intro,
            timestamp
          );
          const breakSeed = randomSeed(18001 + definition.id * 47.9);
          const breakOrder = definition.direction > 0
            ? breakDistanceUnit
            : 1 - breakDistanceUnit;
          const breakHeat = resolveChainHeat(breakOrder, breakSeed);
          ruptureEvents.push({
            breakSample,
            breakSeed,
            definition,
            heat: breakHeat,
            breakOpen: definitionBreakOpen,
            recoil: definitionRecoil,
            snapPulse: definitionSnapPulse,
            releaseFade
          });
          const leaderUnit = definition.direction > 0
            ? -definition.entryOverscan + travel * travelSpan
            : 1 + definition.entryOverscan - travel * travelSpan;
          const leaderTravelUnit = leaderUnit
            + frameDistanceFeed * phaseProgress(build, 0.84, 0.995);
          const leaderSample = sampleTitleChainTravel(
            definition,
            path,
            leaderTravelUnit,
            spacing,
            fill,
            intro,
            timestamp
          );
          const leaderOrder = definition.direction > 0 ? leaderUnit : 1 - leaderUnit;
          const leaderHeat = resolveChainHeat(leaderOrder, breakSeed * 0.73);
          const leaderAlpha = visibility
            * chainMaterialVisibility
            * phaseProgress(build, 0.06, 0.13)
            * (1 - phaseProgress(build, 0.82, 0.99))
            * (1 - releaseFade)
            * resolveCanvasEdgeFade(leaderSample)
            * resolveCenterDissolve(leaderSample);
          if (leaderAlpha > 0.002) {
            leaders.push({
              definition,
              sample: leaderSample,
              alpha: leaderAlpha,
              heat: leaderHeat
            });
          }
          for (let linkIndex = 0; linkIndex < spacing.records.length; linkIndex += 1) {
            const { unit, distanceUnit } = spacing.records[linkIndex];
            let travelUnit = distanceUnit + travelOffset;
            if (definition.type === "frame") {
              const feedBlend = phaseProgress(build, 0.84, 1);
              travelUnit += frameDistanceFeed * feedBlend;
              if (build >= 0.9995 && Math.abs(travelOffset) <= 0.001) {
                travelUnit = normalizeFrameDistance(travelUnit);
              }
            }
            if (travelUnit < -1.05 || travelUnit > 2.05) continue;
            const sample = sampleTitleChainTravel(
              definition,
              path,
              travelUnit,
              spacing,
              fill,
              intro,
              timestamp
            );
            const outside = Math.max(0, -travelUnit, travelUnit - 1);
            const ingressFade = 1 - smootherstep(clamp((outside - 0.04) / 0.36, 0, 1));
            let alpha = visibility
              * phaseProgress(build, 0.02, 0.07)
              * ingressFade
              * resolveCenterDissolve(sample);
            const order = clamp(
              definition.direction > 0 ? distanceUnit : 1 - distanceUnit,
              0,
              1
            );
            const heatSeed = randomSeed(
              39019 + definition.id * 191.7 + linkIndex * 29.13
            );
            const heat = resolveChainHeat(order, heatSeed);
            let rotationOffset = 0;
            let shatterAge = 0;
            let shatterSide = linkIndex <= breakLinkIndex ? -1 : 1;
            if (definitionBreakOpen > 0.001) {
              const side = shatterSide;
              if (linkIndex === breakLinkIndex) alpha *= Math.max(0, 1 - definitionBreakOpen);
              const sideSpan = Math.max(
                0.08,
                side < 0 ? breakDistanceUnit : 1 - breakDistanceUnit
              );
              const distanceFromBreak = Math.abs(distanceUnit - breakDistanceUnit);
              const shatterOrder = clamp(distanceFromBreak / sideSpan, 0, 1);
              const shatterSeed = randomSeed(
                23003
                  + definition.id * 307.1
                  + linkIndex * 43.7
                  + (side > 0 ? 19.3 : 0)
              );
              const shatterStart = breakStart
                + 0.008
                + shatterOrder * 0.17
                + shatterSeed * 0.014;
              shatterAge = clamp((intro - shatterStart) / 0.52, 0, 1);
              if (shatterAge > 0.001) {
                const particleAlpha = visibility
                  * phaseProgress(build, 0.02, 0.07)
                  * ingressFade
                  * (1 - releaseFade * 0.34)
                  * resolveCanvasEdgeFade(sample)
                  * resolveCenterDissolve(sample);
                if (particleAlpha > 0.002) {
                  shatterRecords.push({
                    sample: { ...sample },
                    side,
                    definition,
                    heat,
                    age: shatterAge,
                    seed: shatterSeed + definition.id * 0.137,
                    alpha: particleAlpha
                  });
                }
                alpha *= 1 - smootherstep(clamp(shatterAge / 0.035, 0, 1));
              }
            }
            alpha *= (1 - releaseFade * 0.96)
              * resolveCanvasEdgeFade(sample)
              * resolveCenterDissolve(sample);
            const record = {
              sample,
              linkIndex,
              definition,
              alpha,
              heat,
              rotationOffset,
              scale: definition.type === "frame"
                ? 0.96 + sample.depth * 0.06
                : 1,
              lengthScale: definition.type === "frame" && linkIndex % 2 === 1
                ? frameConnectorLengthScale
                : 1,
              arcMode: "full"
            };
            if (sample.crossing) {
              const crossingKind = definition.type === "frame" ? "Frame" : "Weave";
              layerRecords[`back${crossingKind}`].push({ ...record, arcMode: "far" });
              layerRecords[`front${crossingKind}`].push({ ...record, arcMode: "near" });
            } else {
              const layer = sample.plane === "front" ? "front" : "back";
              const kind = record.definition.type === "frame" ? "Frame" : "Weave";
              layerRecords[`${layer}${kind}`].push(record);
            }
          }
        }

        drawChainLayer(chainBackContext, layerRecords.backFrame, false);
        drawChainLayer(chainBackContext, layerRecords.backWeave, false);
        drawChainLayer(chainFrontContext, layerRecords.frontWeave, true);
        drawChainLayer(chainFrontContext, layerRecords.frontFrame, true);
        for (const leader of leaders) drawChainLeader(chainFrontContext, leader);
        drawChainShatterParticles(chainFrontContext, shatterRecords, isMobile);
        drawChainRupture(timestamp, intro, ruptureEvents, visibility, isMobile);
        drawContractHeartImprint(timestamp, intro, ruptureEvents, visibility, isMobile);

        chainBackCanvas.style.opacity = Math.min(1, visibility * 0.88).toFixed(3);
        chainFrontCanvas.style.opacity = Math.min(1, visibility).toFixed(3);
        chainLastPaintTimestamp = timestamp;
        chainLastPaintFill = fill;
        chainLastPaintIntro = intro;
      };

      const drawEnergy = (timestamp) => {
        energyFrame = 0;
        if (disposed || lovebrainActive || !gate.isConnected) return;
        if (!energyLoopActive || !energyCanvas || !energyContext) return;
        const releaseSettled = releaseMode === "complete"
          && burstProgress >= 0.999
          && targetBurstProgress >= 0.9995;
        const residualParticleCount = wakeParticles.length
          + orbitParticles.length
          + burstParticles.length
          + rainParticles.length;
        const staticRelease = releaseSettled && residualParticleCount === 0;
        const settledFrameInterval = releaseSettled
          ? staticRelease
            ? litePerformance
              ? 180
              : mobilePerformance
                ? 140
                : 96
            : mobilePerformance
              ? mobileFrameInterval
              : 34
          : 0;
        const minimumFrameInterval = Math.max(mobileFrameInterval, settledFrameInterval);
        if (
          minimumFrameInterval > 0
          && lastEnergyPaintTimestamp > 0
          && timestamp - lastEnergyPaintTimestamp < minimumFrameInterval
        ) {
          queueEnergyFrame(minimumFrameInterval - (timestamp - lastEnergyPaintTimestamp));
          return;
        }
        lastEnergyPaintTimestamp = timestamp;
        if (staticRelease) {
          updateGlitchState(timestamp);
          queueEnergyFrame(minimumFrameInterval);
          return;
        }
        const renderStartedAt = performance.now();
        if (energyCanvasWidth <= 0 || energyCanvasHeight <= 0) resizeEnergyCanvas();
        updateGatePresentation(timestamp);
        drawTitleAbyss(timestamp);
        if (!reducedMotion && progress > 0.7 && chargeIntroProgress < 0.999) {
          syncMemorySequence(clamp(progress, 0, 1));
        }
        updateGlitchState(timestamp);
        const width = energyCanvasWidth;
        const height = energyCanvasHeight;
        energyContext.clearRect(0, 0, width, height);
        if (!mobilePerformance) drawTitleChains(timestamp, energyProgress);
        if (!renderLegacyChargeBeam) {
          updateRenderQuality(timestamp, performance.now() - renderStartedAt);
          queueEnergyFrame();
          return;
        }
        if (width <= 1 || height <= 1) {
          updateRenderQuality(timestamp, performance.now() - renderStartedAt);
          queueEnergyFrame();
          return;
        }

        const fill = Math.max(energyProgress, 0.012);
        const flowFrameSeconds = energyFlowTimestamp
          ? clamp((timestamp - energyFlowTimestamp) / 1000, 0.008, 0.05)
          : 1 / 60;
        energyFlowTimestamp = timestamp;
        const flowSpeed = 2.15 + fill * 1.25 + beamMotionEnergy * 0.62;
        energyFlowPhase += flowFrameSeconds * flowSpeed;
        const flowUnit = ((energyFlowPhase / fullTurn) % 1 + 1) % 1;
        const centerY = height / 2;
        const fadeOut = phaseProgress(burstProgress, 0.015, 0.13);
        const detach = phaseProgress(
          chargeIntroProgress,
          chargeHandoffStart,
          chargeHandoffEnd
        );
        const localBeamOpacity = (burstProgress <= 0.001 ? 1 : clamp(1 - fadeOut, 0, 1))
          * (1 - detach);
        const intensity = 0.12 + fill * 0.88;
        const startThickness = 1.05 + fill * 1.7;
        const endThickness = 3.4 + fill * 27;
        const frontRadius = 5.5 + fill * 20;
        const frontX = clamp(width * fill, 3, Math.max(3, width - frontRadius * 2.05));
        const noseLength = Math.min(44, Math.max(7, frontRadius * 1.08 + frontX * 0.028));
        const bodyEndX = Math.max(1, frontX - noseLength);
        const context = energyContext;

        if (localBeamOpacity <= 0.001) {
          updateRenderQuality(timestamp, performance.now() - renderStartedAt);
          queueEnergyFrame();
          return;
        }

        const centerlineAt = (x) => {
          const unit = clamp(x / Math.max(bodyEndX, 1), 0, 1);
          const edgeTaper = Math.sin(unit * Math.PI);
          const primary = Math.sin(unit * fullTurn * 1.22 - energyFlowPhase);
          const secondary = Math.sin(unit * fullTurn * 2.7 + energyFlowPhase + 0.8) * 0.34;
          return centerY + (primary + secondary) * edgeTaper * (1.65 + fill * 5.25);
        };
        const thicknessAt = (x) => {
          const unit = clamp(x / Math.max(bodyEndX, 1), 0, 1);
          const growth = Math.pow(unit, 0.56) * (0.78 + smoothstep(unit) * 0.22);
          const shoulder = Math.exp(-Math.pow((unit - 0.68) / 0.25, 2));
          const tailBloom = smoothstep(clamp(unit / 0.18, 0, 1));
          const body = startThickness * (0.5 + tailBloom * 0.5)
            + (endThickness - startThickness) * growth
            + shoulder * (0.8 + fill * 3.2);
          const breathing = 1 + (
            Math.sin(unit * fullTurn * 2 - energyFlowPhase * 2)
            + Math.sin(unit * fullTurn * 4 + energyFlowPhase) * 0.24
          ) * (0.018 + fill * 0.018);
          return body * breathing;
        };

        const traceBeamEnvelope = () => {
          const segments = Math.max(36, Math.min(96, Math.ceil(bodyEndX / 5.5)));
          const upper = [];
          const lower = [];
          for (let segment = 0; segment <= segments; segment += 1) {
            const x = bodyEndX * segment / segments;
            const localThickness = thicknessAt(x);
            const localCenter = centerlineAt(x);
            upper.push({ x, y: localCenter - localThickness });
            lower.push({ x, y: localCenter + localThickness });
          }
          const noseCenter = centerlineAt(bodyEndX);
          const upperEnd = upper[upper.length - 1];
          const upperPrevious = upper[Math.max(0, upper.length - 2)];
          const lowerEnd = lower[lower.length - 1];
          const lowerPrevious = lower[Math.max(0, lower.length - 2)];
          const upperTangentLength = Math.max(
            0.001,
            Math.hypot(upperEnd.x - upperPrevious.x, upperEnd.y - upperPrevious.y)
          );
          const lowerTangentLength = Math.max(
            0.001,
            Math.hypot(lowerPrevious.x - lowerEnd.x, lowerPrevious.y - lowerEnd.y)
          );
          const upperTangent = {
            x: (upperEnd.x - upperPrevious.x) / upperTangentLength,
            y: (upperEnd.y - upperPrevious.y) / upperTangentLength
          };
          const lowerTangent = {
            x: (lowerPrevious.x - lowerEnd.x) / lowerTangentLength,
            y: (lowerPrevious.y - lowerEnd.y) / lowerTangentLength
          };
          const shoulderReach = Math.min(noseLength * 0.74, frontRadius * 0.92);
          const tipControlY = frontRadius * 0.86;
          const path = new Path2D();
          path.moveTo(upper[0].x, upper[0].y);
          for (let index = 1; index < upper.length; index += 1) {
            path.lineTo(upper[index].x, upper[index].y);
          }
          path.bezierCurveTo(
            upperEnd.x + upperTangent.x * shoulderReach,
            upperEnd.y + upperTangent.y * shoulderReach,
            frontX,
            noseCenter - tipControlY,
            frontX,
            noseCenter
          );
          path.bezierCurveTo(
            frontX,
            noseCenter + tipControlY,
            lowerEnd.x - lowerTangent.x * shoulderReach,
            lowerEnd.y - lowerTangent.y * shoulderReach,
            lowerEnd.x,
            lowerEnd.y
          );
          for (let index = lower.length - 2; index >= 0; index -= 1) {
            path.lineTo(lower[index].x, lower[index].y);
          }
          path.closePath();
          return path;
        };

        context.save();
        context.globalCompositeOperation = "lighter";
        const beamGradient = context.createLinearGradient(0, 0, frontX, 0);
        beamGradient.addColorStop(0, "rgba(100, 150, 255, 0.035)");
        beamGradient.addColorStop(0.1, "rgba(112, 161, 255, 0.1)");
        beamGradient.addColorStop(0.34, "rgba(147, 187, 255, 0.3)");
        beamGradient.addColorStop(0.62, "rgba(255, 108, 150, 0.7)");
        beamGradient.addColorStop(0.84, "rgba(255, 191, 211, 0.94)");
        beamGradient.addColorStop(1, "rgba(255, 255, 255, 0.99)");

        const beamEnvelope = traceBeamEnvelope();
        context.globalAlpha = localBeamOpacity * intensity * 0.16;
        context.fillStyle = beamGradient;
        context.shadowColor = "rgba(255, 83, 127, 0.88)";
        context.shadowBlur = 24 + fill * 22;
        context.fill(beamEnvelope);

        context.globalAlpha = localBeamOpacity * intensity * 0.82;
        context.shadowColor = "rgba(255, 124, 158, 0.92)";
        context.shadowBlur = 7 + fill * 10;
        context.fill(beamEnvelope);

        context.save();
        context.clip(beamEnvelope);
        context.shadowBlur = 0;

        const coreGradient = context.createLinearGradient(0, 0, frontX, 0);
        coreGradient.addColorStop(0, "rgba(170, 204, 255, 0)");
        coreGradient.addColorStop(0.3, "rgba(183, 211, 255, 0.12)");
        coreGradient.addColorStop(0.72, "rgba(255, 191, 211, 0.34)");
        coreGradient.addColorStop(1, "rgba(255, 255, 255, 0.72)");
        context.globalAlpha = localBeamOpacity * intensity * 0.6;
        context.fillStyle = coreGradient;
        context.fillRect(0, 0, frontX, height);

        const helixGradient = context.createLinearGradient(0, 0, frontX, 0);
        helixGradient.addColorStop(0, "rgba(155, 195, 255, 0)");
        helixGradient.addColorStop(0.2, "rgba(169, 205, 255, 0.18)");
        helixGradient.addColorStop(0.66, "rgba(255, 126, 163, 0.76)");
        helixGradient.addColorStop(0.91, "rgba(255, 239, 246, 0.96)");
        helixGradient.addColorStop(1, "rgba(255, 255, 255, 0)");
        const helixShadowGradient = context.createLinearGradient(0, 0, frontX, 0);
        helixShadowGradient.addColorStop(0, "rgba(31, 61, 132, 0)");
        helixShadowGradient.addColorStop(0.22, "rgba(49, 82, 160, 0.34)");
        helixShadowGradient.addColorStop(0.66, "rgba(129, 26, 78, 0.42)");
        helixShadowGradient.addColorStop(0.94, "rgba(185, 43, 96, 0.16)");
        helixShadowGradient.addColorStop(1, "rgba(185, 43, 96, 0)");
        const helixSegments = Math.max(
          38,
          Math.round((width < 420 ? 54 : 72) * (0.78 + renderQuality * 0.22))
        );
        const helixStrands = 3;
        for (let strand = 0; strand < helixStrands; strand += 1) {
          const strandOffset = strand * fullTurn / helixStrands;
          const strandSamples = [];
          for (let segment = 0; segment <= helixSegments; segment += 1) {
              const x = bodyEndX * segment / helixSegments;
              const unit = x / Math.max(bodyEndX, 1);
              const localThickness = thicknessAt(x) * (0.8 + strand * 0.035);
              const spiralPhase = unit * fullTurn * 3 - energyFlowPhase * 2 + strandOffset;
              const counterPhase = unit * fullTurn * 6 + energyFlowPhase + strandOffset * 0.5;
            strandSamples.push({
              x,
              y: centerlineAt(x)
                + Math.sin(spiralPhase) * localThickness * (0.4 + strand * 0.025)
                + Math.sin(counterPhase) * localThickness * 0.05,
              depth: Math.cos(spiralPhase),
              unit
            });
          }
          for (let depthPass = 0; depthPass < 2; depthPass += 1) {
            const frontPass = depthPass === 1;
            context.globalCompositeOperation = frontPass ? "lighter" : "source-over";
            context.strokeStyle = frontPass ? helixGradient : helixShadowGradient;
            context.lineCap = "round";
            const depthBuckets = Array.from({ length: 4 }, () => new Path2D());
            for (let segment = 1; segment < strandSamples.length; segment += 1) {
              const previous = strandSamples[segment - 1];
              const point = strandSamples[segment];
              const midpointUnit = (previous.unit + point.unit) * 0.5;
              const midpointDepth = (previous.depth + point.depth) * 0.5;
              const depthWeight = frontPass
                ? smoothstep(clamp((midpointDepth + 0.34) / 1.34, 0, 1))
                : smoothstep(clamp((0.34 - midpointDepth) / 1.34, 0, 1));
              const edgeFade = smoothstep(clamp(midpointUnit / 0.13, 0, 1))
                * (1 - smoothstep(clamp((midpointUnit - 0.88) / 0.12, 0, 1)));
              const visibility = edgeFade * (0.28 + depthWeight * 0.72);
              if (visibility <= 0.018) continue;
              const bucket = Math.min(depthBuckets.length - 1, Math.floor(visibility * depthBuckets.length));
              depthBuckets[bucket].moveTo(previous.x, previous.y);
              depthBuckets[bucket].lineTo(point.x, point.y);
            }
            const baseAlpha = localBeamOpacity * intensity * (frontPass ? 0.7 : 0.24);
            const baseWidth = frontPass ? 1.05 + fill * 2.15 : 0.62 + fill * 1.02;
            for (let bucket = 0; bucket < depthBuckets.length; bucket += 1) {
              const bucketWeight = (bucket + 0.5) / depthBuckets.length;
              context.globalAlpha = baseAlpha * bucketWeight;
              context.lineWidth = baseWidth * (0.72 + bucketWeight * 0.4);
              context.stroke(depthBuckets[bucket]);
            }
          }
        }
        context.globalCompositeOperation = "lighter";

        const compressionCount = width < 420 ? 3 : 5;
        for (let pulse = 0; pulse < compressionCount; pulse += 1) {
          const travel = (flowUnit + pulse / compressionCount) % 1;
          const wrapFade = smoothstep(clamp(travel / 0.13, 0, 1))
            * (1 - smoothstep(clamp((travel - 0.84) / 0.16, 0, 1)));
          const x = bodyEndX * (0.1 + travel * 0.86);
          const localThickness = thicknessAt(x);
          context.globalAlpha = localBeamOpacity * intensity * wrapFade * (0.14 + beamMotionEnergy * 0.18);
          context.strokeStyle = pulse % 2 === 0 ? "rgba(255, 245, 249, 0.9)" : "rgba(178, 211, 255, 0.82)";
          context.lineWidth = 0.55 + fill * 0.9;
          context.beginPath();
            context.ellipse(
              x,
              centerlineAt(x),
            1.4 + fill * 2.8 + beamMotionEnergy * 2.6,
            localThickness * (0.18 + fill * 0.1),
            0,
            0,
            Math.PI * 2
          );
          context.stroke();
        }

        const fragmentCount = width < 420 ? 12 : 20;
        for (let fragment = 0; fragment < fragmentCount; fragment += 1) {
          const seed = randomSeed(fragment + 11401);
          const speedBand = 1 + fragment % 3;
          const travel = (flowUnit * speedBand + seed * 1.73) % 1;
          const wrapFade = smoothstep(clamp(travel / 0.12, 0, 1))
            * (1 - smoothstep(clamp((travel - 0.82) / 0.18, 0, 1)));
          const x = bodyEndX * (0.06 + travel * 0.9);
          const localThickness = thicknessAt(x) * 0.78;
          const spiralPhase = travel * fullTurn * (3 + fragment % 2)
            - energyFlowPhase * (1 + fragment % 2)
            + seed * fullTurn;
          const depth = 0.5 + Math.cos(spiralPhase) * 0.5;
          const y = centerlineAt(x) + Math.sin(spiralPhase) * localThickness * (0.28 + seed * 0.18);
          const size = (0.72 + fill * 1.5 + beamMotionEnergy * 0.42)
            * (0.62 + seed * 0.72)
            * (0.68 + depth * 0.5);
          context.save();
          context.translate(x, y);
          context.rotate(0.18 + Math.sin(spiralPhase) * 0.52 + seed * 0.38);
          context.globalAlpha = localBeamOpacity * intensity * wrapFade * (0.2 + depth * 0.62);
          context.fillStyle = fragment % 4 === 0
            ? "#ffffff"
            : fragment % 2 === 0
              ? "#ffacc0"
              : "#bfd6ff";
          context.beginPath();
          context.moveTo(size * 1.75, 0);
          context.lineTo(-size * 0.42, size * 0.7);
          context.lineTo(-size * 1.08, 0);
          context.lineTo(-size * 0.42, -size * 0.7);
          context.closePath();
          context.fill();
          context.restore();
        }

        const frontCenterY = centerlineAt(bodyEndX);
        const headCoreX = frontX - frontRadius * 0.48;
        const headGlow = context.createRadialGradient(headCoreX, frontCenterY, 0, headCoreX, frontCenterY, frontRadius * 1.35);
        headGlow.addColorStop(0, "rgba(255, 255, 255, 0.98)");
        headGlow.addColorStop(0.24, "rgba(255, 244, 248, 0.9)");
        headGlow.addColorStop(0.62, "rgba(255, 104, 145, 0.36)");
        headGlow.addColorStop(1, "rgba(255, 86, 128, 0)");
        context.globalAlpha = localBeamOpacity * intensity;
        context.fillStyle = headGlow;
        context.fillRect(headCoreX - frontRadius * 1.35, frontCenterY - frontRadius * 1.35, frontRadius * 2.7, frontRadius * 2.7);
        context.restore();

        const overcharge = phaseProgress(fill, 0.46, 0.74);
        if (overcharge > 0.001) {
          context.save();
          context.globalCompositeOperation = "lighter";
          context.lineCap = "round";
          const orbitSegments = Math.max(
            30,
            Math.round((width < 420 ? 36 : 48) * (0.8 + renderQuality * 0.2))
          );
          for (let strand = 0; strand < 3; strand += 1) {
            const phaseOffset = strand * fullTurn / 3 + energyFlowPhase * (strand % 2 === 0 ? -1 : 1);
            const orbitSamples = [];
            for (let segment = 0; segment <= orbitSegments; segment += 1) {
              const unit = 0.12 + segment / orbitSegments * 0.88;
              const x = bodyEndX * unit;
              const localThickness = thicknessAt(x);
              const orbitPhase = unit * fullTurn * (1.18 + strand * 0.16) + phaseOffset;
              const edgeFade = Math.sin(clamp((unit - 0.1) / 0.9, 0, 1) * Math.PI);
              const orbitRadius = (localThickness * (1.12 + strand * 0.12) + 2.5 + overcharge * 4.8)
                * edgeFade;
              orbitSamples.push({
                x: x + Math.cos(orbitPhase) * (1.8 + overcharge * 3.2),
                y: centerlineAt(x) + Math.sin(orbitPhase) * orbitRadius,
                depth: Math.cos(orbitPhase)
              });
            }
            context.strokeStyle = strand === 1
              ? "rgba(139, 181, 255, 0.92)"
              : "rgba(255, 226, 237, 0.98)";
            context.shadowColor = strand === 1
              ? "rgba(111, 160, 255, 0.82)"
              : "rgba(255, 77, 132, 0.9)";
            for (let pass = 0; pass < 2; pass += 1) {
              const frontPass = pass === 1;
              context.shadowBlur = frontPass ? 6 + overcharge * 9 : 2;
              const depthBuckets = Array.from({ length: 4 }, () => new Path2D());
              for (let segment = 1; segment < orbitSamples.length; segment += 1) {
                const previous = orbitSamples[segment - 1];
                const point = orbitSamples[segment];
                const midpointDepth = (previous.depth + point.depth) * 0.5;
                const depthWeight = frontPass
                  ? smoothstep(clamp((midpointDepth + 0.3) / 1.3, 0, 1))
                  : smoothstep(clamp((0.3 - midpointDepth) / 1.3, 0, 1));
                const visibility = 0.26 + depthWeight * 0.74;
                const bucket = Math.min(depthBuckets.length - 1, Math.floor(visibility * depthBuckets.length));
                depthBuckets[bucket].moveTo(previous.x, previous.y);
                depthBuckets[bucket].lineTo(point.x, point.y);
              }
              const baseAlpha = localBeamOpacity * overcharge * (frontPass ? 0.68 : 0.25);
              const baseWidth = frontPass ? 1.15 + overcharge * 1.75 : 0.7 + overcharge * 0.58;
              for (let bucket = 0; bucket < depthBuckets.length; bucket += 1) {
                const bucketWeight = (bucket + 0.5) / depthBuckets.length;
                context.globalAlpha = baseAlpha * bucketWeight;
                context.lineWidth = baseWidth * (0.74 + bucketWeight * 0.36);
                context.stroke(depthBuckets[bucket]);
              }
            }
          }

          const haloCount = width < 420 ? 2 : 3;
          for (let halo = 0; halo < haloCount; halo += 1) {
            const pulse = 0.5 + Math.sin(energyFlowPhase * (2 + halo) + halo * 2.2) * 0.5;
            const haloX = bodyEndX * (0.58 + halo * 0.12);
            const haloY = centerlineAt(haloX);
            const haloThickness = thicknessAt(haloX);
            context.globalAlpha = localBeamOpacity * overcharge * (0.26 + pulse * 0.22);
            context.strokeStyle = halo % 2 === 0
              ? "rgba(255, 241, 246, 0.96)"
              : "rgba(151, 191, 255, 0.88)";
            context.lineWidth = 0.8 + overcharge * 1.15;
            context.shadowColor = halo % 2 === 0
              ? "rgba(255, 88, 139, 0.92)"
              : "rgba(111, 160, 255, 0.84)";
            context.shadowBlur = 7 + pulse * 8;
            context.beginPath();
            context.ellipse(
              haloX,
              haloY,
              6 + overcharge * (10 + halo * 4),
              haloThickness * (1.12 + overcharge * 0.3),
              -0.12 + halo * 0.1,
              -Math.PI * (0.78 + pulse * 0.08),
              Math.PI * (0.78 + pulse * 0.08)
            );
            context.stroke();
          }
          context.restore();
        }

        const auraGlow = context.createRadialGradient(
          frontX - frontRadius * 0.34,
          frontCenterY,
          frontRadius * 0.12,
          frontX - frontRadius * 0.34,
          frontCenterY,
          frontRadius * 1.7
        );
        auraGlow.addColorStop(0, "rgba(255, 250, 252, 0.34)");
        auraGlow.addColorStop(0.42, "rgba(255, 105, 145, 0.16)");
        auraGlow.addColorStop(1, "rgba(255, 91, 131, 0)");
        context.globalAlpha = localBeamOpacity * intensity * 0.72;
        context.fillStyle = auraGlow;
        context.beginPath();
        context.ellipse(
          frontX - frontRadius * 0.34,
          frontCenterY,
          frontRadius * 1.72,
          frontRadius * 1.28,
          0,
          0,
          Math.PI * 2
        );
        context.fill();

        const impactStrength = clamp(fill * 0.34 + beamMotionEnergy * 0.92, 0, 1.18);
        if (impactStrength > 0.025) {
          context.save();
          context.globalCompositeOperation = "lighter";
          context.translate(frontX - frontRadius * 0.2, frontCenterY);
          for (let ring = 0; ring < 2; ring += 1) {
            const pulse = 0.5 + Math.sin(energyFlowPhase * (3 + ring) + ring * 1.4) * 0.5;
            context.globalAlpha = localBeamOpacity * impactStrength * (0.22 - ring * 0.065) * (0.72 + pulse * 0.28);
            context.strokeStyle = ring === 0 ? "rgba(255, 252, 253, 0.96)" : "rgba(255, 112, 151, 0.76)";
            context.lineWidth = 0.8 + fill * 1.3 + beamMotionEnergy * 1.2;
            context.beginPath();
            context.ellipse(
              0,
              0,
              frontRadius * (0.28 + ring * 0.24 + beamMotionEnergy * 0.18),
              frontRadius * (0.72 + ring * 0.42 + impactStrength * 0.25),
              0,
              -Math.PI * 0.72,
              Math.PI * 0.72
            );
            context.stroke();
          }
          const impactFlare = context.createLinearGradient(-frontRadius * 2.8, 0, frontRadius * 0.9, 0);
          impactFlare.addColorStop(0, "rgba(255, 94, 139, 0)");
          impactFlare.addColorStop(0.72, "rgba(255, 121, 158, 0.12)");
          impactFlare.addColorStop(1, "rgba(255, 255, 255, 0.82)");
          context.globalAlpha = localBeamOpacity * impactStrength * 0.48;
          context.fillStyle = impactFlare;
          context.beginPath();
          context.moveTo(-frontRadius * (2.4 + beamMotionEnergy * 1.4), -frontRadius * 0.08);
          context.lineTo(frontRadius * 0.7, -frontRadius * (0.22 + impactStrength * 0.12));
          context.lineTo(frontRadius * 0.7, frontRadius * (0.22 + impactStrength * 0.12));
          context.lineTo(-frontRadius * (2.4 + beamMotionEnergy * 1.4), frontRadius * 0.08);
          context.closePath();
          context.fill();
          context.restore();
        }

        context.restore();

        updateRenderQuality(timestamp, performance.now() - renderStartedAt);
        queueEnergyFrame();
      };

      const startEnergyAnimation = () => {
        if (!energyContext || lovebrainActive || pageMode !== "gate" || energyLoopActive) return;
        energyLoopActive = true;
        pauseSceneBreathClock();
        if (reducedMotion) {
          drawEnergy(performance.now());
          return;
        }
        if (document.visibilityState === "visible") {
          energyFrame = window.requestAnimationFrame(drawEnergy);
        } else {
          energyLoopActive = false;
        }
      };

      const publishGateRailState = ({
        active,
        progress: nextProgress,
        stage,
        guided = false,
        transitioning = false,
        metadata = {}
      }) => {
        const railProgress = clamp(nextProgress, 0, 1);
        const railPlaybackRate = clamp(Number(metadata.playbackRate) || 1, 0.1, 2);
        const railPressure = clamp(Number(metadata.pressure) || 0, 0, 1);
        const railReleaseMode = typeof metadata.releaseMode === "string"
          ? metadata.releaseMode
          : "manual";
        if (
          Math.abs(railProgress - renderedRailProgress) < 0.0005
          && stage === renderedRailStage
          && active === renderedRailActive
          && guided === renderedRailGuided
          && transitioning === renderedRailTransitioning
          && Math.abs(railPlaybackRate - renderedRailPlaybackRate) < 0.01
          && Math.abs(railPressure - renderedRailPressure) < 0.01
          && railReleaseMode === renderedRailReleaseMode
        ) return;
        renderedRailProgress = railProgress;
        renderedRailStage = stage;
        renderedRailActive = active;
        renderedRailGuided = guided;
        renderedRailTransitioning = transitioning;
        renderedRailPlaybackRate = railPlaybackRate;
        renderedRailPressure = railPressure;
        renderedRailReleaseMode = railReleaseMode;
        gate.dataset.kisaraScrollProgress = railProgress.toFixed(5);
        gate.dataset.kisaraScrollStage = stage;
        gate.dataset.kisaraScrollActive = String(active);
        gate.dataset.kisaraScrollGuided = String(guided);
        gate.dataset.kisaraScrollTransitioning = String(transitioning);
        gate.dataset.kisaraScrollPlaybackRate = railPlaybackRate.toFixed(3);
        gate.dataset.kisaraScrollPressure = railPressure.toFixed(3);
        gate.dataset.kisaraScrollReleaseMode = railReleaseMode;
        window.dispatchEvent(new CustomEvent("kisara:gate-progress", {
          detail: {
            active,
            progress: railProgress,
            stage,
            guided,
            transitioning,
            ...metadata
          }
        }));
      };

      const syncGateProgressRail = (fill, burstComplete, chainStage) => {
        const active = pageMode === "gate";
        const releaseAutomatic = ["forward", "rewinding"].includes(releaseMode);
        const releaseTimelineActive = ["forward", "rewinding", "paused", "complete"].includes(releaseMode);
        const automatic = chargeIntroActive || releaseAutomatic;
        const overallProgress = !chargeIntroComplete
          ? chargeIntroActive
            ? 0.55 + clamp(chargeIntroProgress / gateRelease.introHandoff, 0, 1) * 0.15
            : fill * 0.55
          : releaseMode === "complete"
            ? 1
            : releaseTimelineActive
              ? 0.7 + releaseTimeline * 0.3
              : 0.7;
        const railProgress = clamp(overallProgress, 0, 1);
        const railStage = burstComplete
          ? "complete"
          : chargeIntroActive
            ? chargeIntroProgress < 0.62 ? "rupture" : "enchant"
            : !chargeIntroComplete
              ? chainStage
              : "reconstruction";
        publishGateRailState({
          active,
          progress: railProgress,
          stage: railStage,
          guided: active
            && !chargeIntroActive
            && ["manual", "forward", "paused"].includes(releaseMode),
          metadata: {
            fill,
            intro: chargeIntroProgress,
            burst: burstProgress,
            autoplay: releaseTimeline,
            automatic,
            complete: burstComplete,
            playbackRate: releasePlaybackRate,
            pressure: releaseVisualPressure,
            releaseMode
          }
        });
      };

      const render = () => {
        if (lovebrainActive || pageMode === "lovebrain") return;
        const fill = clamp(progress, 0, 1);
        const percent = Math.round(progress * 100);
        const fillComplete = targetProgress >= 0.9995 && fill >= 0.999 && Math.abs(velocity) < 0.001;
        const burstComplete = fillComplete
          && chargeIntroComplete
          && targetBurstProgress >= 0.9995
          && burstProgress >= 0.999
          && Math.abs(burstVelocity) < 0.001
          && releaseMode === "complete";
        const tideVisible = fill > 0.0005;
        const reveal = smoothstep(clamp((fill - 0.025) / 0.975, 0, 1));
        warmSceneImagesForProgress(Math.max(fill, targetProgress), chargeIntroProgress);
        const memoryState = syncMemorySequence(fill);
        const {
          fightVisible,
          fightSettle,
          fightBlur,
          fightSaturation,
          fightBrightness
        } = memoryState.handoff;
        const baseSceneOpacity = 0.98 - memoryState.baseExit * 0.78;
        const baseSceneBlur = memoryState.baseExit * 10;
        const baseSceneSaturation = 1 - memoryState.baseExit * 0.2;
        const baseSceneBrightness = 1 - memoryState.baseExit * 0.12;
        const boundaryOpacity = fill <= 0.002 || fill >= 0.998
          ? 0
          : Math.min(0.74, 0.38 + Math.sin(fill * Math.PI) * 0.1 + Math.abs(velocity) * 24);
        const boundaryOffset = clamp(velocity * 320, -1.45, 1.45);

        setRuntimeStyle(gate, "--kisara-fill", `${(fill * 100).toFixed(3)}%`);
        setRuntimeStyle(gate, "--kisara-burst-progress", `${(burstProgress * 100).toFixed(3)}%`);
        setRuntimeStyle(gate, "--kisara-tide-opacity", tideVisible ? "1" : "0");
        setRuntimeStyle(gate, "--kisara-boundary-opacity", quantizeRuntimeValue(boundaryOpacity, 0.01, 0.015).toFixed(3));
        setRuntimeStyle(gate, "--kisara-boundary-offset", `${quantizeRuntimeValue(boundaryOffset, 0.05, 0.08).toFixed(3)}%`);
        setRuntimeStyle(gate, "--kisara-bg-blur", `${quantizeRuntimeValue(baseSceneBlur, 0.5, 0.75).toFixed(3)}px`);
        setRuntimeStyle(gate, "--kisara-bg-opacity", quantizeRuntimeValue(baseSceneOpacity, 0.01, 0.015).toFixed(3));
        setRuntimeStyle(gate, "--kisara-bg-saturation", quantizeRuntimeValue(baseSceneSaturation, 0.01, 0.015).toFixed(3));
        setRuntimeStyle(gate, "--kisara-bg-brightness", quantizeRuntimeValue(baseSceneBrightness, 0.01, 0.015).toFixed(3));
        setRuntimeStyle(gate, "--kisara-fight-opacity", quantizeRuntimeValue(fightVisible * 0.985, 0.01, 0.015).toFixed(3));
        setRuntimeStyle(gate, "--kisara-fight-blur", `${quantizeRuntimeValue(fightBlur, 0.5, 0.75).toFixed(3)}px`);
        setRuntimeStyle(
          gate,
          "--kisara-fight-scale",
          quantizeRuntimeValue(1.012 - fightSettle * 0.012, 0.0015, 0.002).toFixed(4)
        );
        setRuntimeStyle(
          gate,
          "--kisara-fight-saturation",
          quantizeRuntimeValue(fightSaturation, 0.01, 0.015).toFixed(3)
        );
        setRuntimeStyle(
          gate,
          "--kisara-fight-brightness",
          quantizeRuntimeValue(fightBrightness, 0.01, 0.015).toFixed(3)
        );
        setRuntimeStyle(gate, "--kisara-fight-handoff-x", "0px");
        setRuntimeStyle(gate, "--kisara-fight-handoff-y", "0px");
        energyProgress = fill;
        if (!energyLoopActive || reducedMotion || burstComplete) {
          updateGatePresentation(performance.now(), false);
        }
        startEnergyAnimation();
        const stage = fillComplete
          ? "glitch"
          : fill < 0.2
            ? "awakening"
            : fill < 0.5
              ? "outer-bind"
              : fill < 0.78
                ? "inner-bind"
                : "maximum-tension";
        syncGateProgressRail(fill, burstComplete, stage);
        const glitchTick = fillComplete ? Math.floor(performance.now() / 72) : -1;
        if (state && (percent !== renderedPercent || stage !== renderedStage || glitchTick !== renderedGlitchTick)) {
          state.textContent = fillComplete
            ? makeGlitchState(performance.now(), burstProgress, burstComplete)
            : stage === "awakening"
              ? "SEAL CHAINS / AWAKENING"
              : stage === "outer-bind"
                ? "OUTER BIND / WRAPPING"
                : stage === "inner-bind"
                  ? "INNER BIND / INTERLOCKING"
                  : "SEAL CORE / MAXIMUM TENSION";
          renderedPercent = percent;
          renderedStage = stage;
          renderedGlitchTick = glitchTick;
        }
        gate.classList.toggle("is-complete", fillComplete);
        gate.classList.toggle("is-enchanting", chargeIntroActive);
        gate.classList.toggle("is-enchanted", chargeIntroComplete && fillComplete);
        gate.classList.toggle("is-bursting", burstProgress > 0.001 && !burstComplete);
        gate.classList.toggle("is-burst-complete", burstComplete);
        gate.classList.toggle("is-released", pageMode === "next");
        gate.classList.toggle("is-receding", velocity < -0.0003);
        gate.classList.toggle(
          "is-rewinding",
          chargeIntroReversing
            || releaseMode === "rewinding"
            || burstVelocity < -0.00025
            || targetBurstProgress < burstProgress - 0.0005
        );
        setPostReleaseActive(burstComplete && pageMode === "gate");
        if (cue) {
          const cueGuided = pageMode === "gate"
            && !chargeIntroActive
            && ["manual", "forward", "paused"].includes(releaseMode);
          cue.classList.toggle("is-guiding", cueGuided);
          cue.classList.toggle("is-enter-ready", burstComplete && pageMode === "gate");
        }
        syncHeroAutoplayControl();
      };

      const transitionChargeIntro = (nextTarget, timestamp) => {
        const target = clamp(nextTarget, 0, 1);
        if (
          pageMode !== "gate"
          || (chargeIntroActive && Math.abs(chargeIntroTarget - target) < 0.0005)
        ) return;
        const distance = Math.abs(target - chargeIntroProgress);
        if (distance < 0.0005) {
          chargeIntroProgress = target;
          chargeIntroActive = false;
          chargeIntroComplete = target >= 0.9995;
          chargeIntroReversing = false;
          return;
        }
        chargeIntroFrom = chargeIntroProgress;
        chargeIntroTarget = target;
        chargeIntroTransitionDuration = Math.max(
          180,
          (target < chargeIntroProgress ? 820 : chargeIntroDuration) * distance
        );
        chargeIntroActive = true;
        chargeIntroComplete = false;
        chargeIntroReversing = target < chargeIntroProgress;
        chargeIntroStartedAt = timestamp;
      };

      const startChargeIntro = (timestamp) => {
        if (chargeIntroComplete || pageMode !== "gate") return;
        scheduleReleaseWarmup(true);
        progress = 1;
        targetProgress = 1;
        velocity = 0;
        energyProgress = 1;
        transitionChargeIntro(1, timestamp);
      };

      const clearReleaseTransientEffects = (timestamp = performance.now()) => {
        wakeEmissionBudget = 0;
        orbitEmissionBudget = 0;
        rainEmissionBudget = 0;
        burstWaveMask = 0;
        wakePrimed = false;
        wakeParticles.length = 0;
        orbitParticles.length = 0;
        burstParticles.length = 0;
        rainParticles.length = 0;
        screenParticleTimestamp = timestamp;
        poseTimestamp = timestamp;
        lastSpaceLensPaintTimestamp = 0;
        lastTitleLensPaintTimestamp = 0;
        spaceLensRenderer?.clear();
        titleLensRenderer?.clear();
      };

      const startReleaseAutoplay = (timestamp, { resume = false } = {}) => {
        if (releaseMode === "forward" || releaseMode === "complete") return;
        releaseMode = "forward";
        releaseDuration = releaseAutoplayDuration;
        releaseLastTimestamp = timestamp;
        releasePlaybackRate = 1;
        releaseBoost = 0;
        releaseVisualPressure = 0;
        releaseRewindVeil = 0;
        releaseRewindStartedAt = 0;
        releaseRewindDuration = 0;
        if (!resume) {
          releaseUsesReconstruction = Boolean(spaceLensRenderer) && releaseWarmupState.spaceLens
            && !releaseWarmupPending.spaceLens;
          if (title) {
            const gateRect = gate.getBoundingClientRect();
            const titleRect = title.getBoundingClientRect();
            reconstructionCenter = {
              x: clamp((titleRect.left + titleRect.width * 0.5 - gateRect.left) / Math.max(1, gateRect.width), 0, 1),
              y: clamp((titleRect.top + titleRect.height * 0.5 - gateRect.top) / Math.max(1, gateRect.height), 0, 1)
            };
          }
          releaseTimeline = 0;
          burstProgress = mapReleaseAutoplayProgress(0);
        }
        targetBurstProgress = 1;
        burstVelocity = 0;
      };

      const startReleaseRewind = (timestamp) => {
        if (releaseMode !== "forward" || releaseTimeline >= releaseRewindCommitAt) return false;
        releaseMode = "rewinding";
        releaseRewindFromTimeline = releaseTimeline;
        releaseRewindStartedAt = timestamp;
        releaseRewindDuration = clamp(320 + releaseTimeline * 520, 320, 560);
        releaseLastTimestamp = timestamp;
        releasePlaybackRate = 1;
        releaseBoost = 0;
        releaseVisualPressure = 0;
        releaseRewindVeil = 0;
        targetBurstProgress = burstProgress;
        burstVelocity = 0;
        clearReleaseTransientEffects(timestamp);
        startAnimation();
        return true;
      };

      const handleReleaseInput = (delta, timestamp) => {
        if (releaseMode === "rewinding") return true;
        if (releaseMode === "paused") {
          if (delta > 0) {
            startReleaseAutoplay(timestamp, { resume: true });
            startAnimation();
            return true;
          }
          releaseMode = "manual";
          releaseTimeline = 0;
          releaseRewindVeil = 0;
          burstProgress = 0;
          targetBurstProgress = 0;
          burstVelocity = 0;
          return false;
        }
        if (releaseMode !== "forward") return false;
        if (delta < 0) {
          if (startReleaseRewind(timestamp)) return true;
          releaseBoost = Math.max(releaseBoost, 0.72);
          releasePlaybackRate = Math.max(releasePlaybackRate, 1.5);
          releaseVisualPressure = Math.max(releaseVisualPressure, 0.72);
        } else {
          const impulse = clamp(delta, 0, 180) / 180;
          releaseBoost = clamp(releaseBoost + impulse * 0.28, 0, 0.8);
          releaseVisualPressure = Math.max(releaseVisualPressure, releaseBoost / 0.8);
        }
        startAnimation();
        return true;
      };

      const syncHeroAutoplayControl = () => {
        if (!(autoPlay instanceof HTMLButtonElement)) return;
        const nextState = heroAutoplayActive
          ? "playing"
          : releaseMode === "complete" && burstProgress >= 0.999
            ? "replay"
            : "idle";
        if (nextState === renderedHeroAutoplayState) return;
        renderedHeroAutoplayState = nextState;
        autoPlay.dataset.state = nextState;
        autoPlay.disabled = nextState === "playing";
        autoPlay.setAttribute("aria-busy", String(nextState === "playing"));
        autoPlay.setAttribute(
          "aria-label",
          nextState === "playing"
            ? "首屏演出正在自动播放"
            : nextState === "replay"
              ? "重新自动播放首屏演出"
              : "自动播放首屏演出"
        );
        if (autoPlayLabel) {
          autoPlayLabel.textContent = nextState === "playing"
            ? "RUNNING"
            : nextState === "replay"
              ? "REPLAY"
              : "AUTO";
        }
      };

      const stopHeroAutoplay = () => {
        heroAutoplayActive = false;
        heroAutoplayLastTimestamp = 0;
        syncHeroAutoplayControl();
      };

      const advanceHeroAutoplay = (timestamp) => {
        if (!heroAutoplayActive) return;
        if (lovebrainActive) {
          stopHeroAutoplay();
          return;
        }
        if (pageMode !== "gate") {
          stopHeroAutoplay();
          return;
        }
        const deltaTime = heroAutoplayLastTimestamp
          ? clamp(timestamp - heroAutoplayLastTimestamp, 0, 50)
          : 16.667;
        heroAutoplayLastTimestamp = timestamp;

        if (releaseMode === "complete") {
          stopHeroAutoplay();
          return;
        }
        if (releaseMode === "forward" || releaseMode === "rewinding") return;
        if (releaseMode === "paused") {
          startReleaseAutoplay(timestamp, { resume: true });
          return;
        }
        if (chargeIntroActive) return;
        if (!chargeIntroComplete) {
          targetProgress = clamp(
            targetProgress + deltaTime / heroAutoplayFillDuration,
            0,
            1
          );
          return;
        }
        startReleaseAutoplay(timestamp);
      };

      const startHeroAutoplay = (timestamp = performance.now()) => {
        if (pageMode !== "gate" || heroAutoplayActive) return;
        if (releaseMode === "complete") resetGateState();
        if (reducedMotion) {
          progress = 1;
          targetProgress = 1;
          chargeIntroProgress = 1;
          chargeIntroComplete = true;
          burstProgress = 1;
          targetBurstProgress = 1;
          releaseMode = "complete";
          releaseTimeline = 1;
          render();
          return;
        }
        heroAutoplayActive = true;
        heroAutoplayLastTimestamp = 0;
        scheduleReleaseWarmup(true);
        syncHeroAutoplayControl();
        startAnimation();
      };

      const animate = (timestamp) => {
        animationFrame = 0;
        if (disposed || lovebrainActive || pageMode === "lovebrain" || !gate.isConnected) return;
        if (
          mobileFrameInterval > 0
          && lastAnimationPaintTimestamp > 0
          && timestamp - lastAnimationPaintTimestamp < mobileFrameInterval
        ) {
          animationFrame = window.requestAnimationFrame(animate);
          return;
        }
        lastAnimationPaintTimestamp = timestamp;
        const frameRatio = lastFrameTime
          ? clamp((timestamp - lastFrameTime) / 16.667, 0.5, 3)
          : 1;
        lastFrameTime = timestamp;
        advanceHeroAutoplay(timestamp);
        const spring = (targetProgress - progress) * springStrength * frameRatio;
        velocity = (velocity + spring) * Math.pow(damping, frameRatio);
        progress = clamp(progress + velocity * frameRatio, 0, 1);
        const fillReadyForIntro = targetProgress >= 0.9995 && progress >= 0.995;
        if (fillReadyForIntro && !chargeIntroActive && !chargeIntroComplete) {
          startChargeIntro(timestamp);
        }
        if (chargeIntroActive) {
          const transitionProgress = clamp(
            (timestamp - chargeIntroStartedAt) / Math.max(1, chargeIntroTransitionDuration),
            0,
            1
          );
          const transitionEase = smootherstep(transitionProgress);
          chargeIntroProgress = chargeIntroFrom
            + (chargeIntroTarget - chargeIntroFrom) * transitionEase;
          if (transitionProgress >= 1 || (!chargeIntroReversing && chargeIntroProgress >= gateRelease.introHandoff)) {
            chargeIntroProgress = chargeIntroTarget >= 0.9995 ? gateRelease.introHandoff : chargeIntroTarget;
            chargeIntroActive = false;
            chargeIntroComplete = chargeIntroTarget >= 0.9995;
            chargeIntroReversing = false;
            chargeIntroStartedAt = 0;
            chargeIntroTransitionDuration = 0;
          }
        }
        if (releaseMode === "rewinding") {
          const rewindProgress = clamp(
            (timestamp - releaseRewindStartedAt) / Math.max(1, releaseRewindDuration),
            0,
            1
          );
          const rewindEase = smootherstep(rewindProgress);
          releaseTimeline = releaseRewindFromTimeline * (1 - rewindEase);
          releaseRewindVeil = Math.sin(rewindProgress * Math.PI);
          releaseVisualPressure += (0 - releaseVisualPressure)
            * (1 - Math.exp(-frameRatio * 0.22));
          burstProgress = mapReleaseAutoplayProgress(releaseTimeline);
          targetBurstProgress = burstProgress;
          burstVelocity = 0;
          if (rewindProgress >= 1) {
            releaseMode = "paused";
            releaseTimeline = 0;
            releaseRewindVeil = 0;
            releaseRewindStartedAt = 0;
            releaseRewindDuration = 0;
            burstProgress = mapReleaseAutoplayProgress(0);
            targetBurstProgress = burstProgress;
            burstVelocity = 0;
            clearReleaseTransientEffects(timestamp);
          }
        } else if (releaseMode === "forward") {
          const releaseDelta = releaseLastTimestamp
            ? clamp(timestamp - releaseLastTimestamp, 0, 50)
            : 16.667;
          releaseLastTimestamp = timestamp;
          releaseBoost *= Math.exp(-releaseDelta * 0.00155);
          const targetPlaybackRate = 1 + releaseBoost;
          releasePlaybackRate += (targetPlaybackRate - releasePlaybackRate)
            * (1 - Math.exp(-releaseDelta * 0.012));
          releasePlaybackRate = clamp(releasePlaybackRate, 1, 1.8);
          const targetPressure = clamp(
            Math.max(releaseBoost / 0.8, (releasePlaybackRate - 1) / 0.8),
            0,
            1
          );
