---
import KisaraLayout from "../layouts/KisaraLayout.astro";
import { getPublishedPosts } from "@/core/content/blog";
import { getThemePath } from "@/core/themes/registry";
import { existsSync } from "node:fs";
import { resolve } from "node:path";

const posts = (await getPublishedPosts()).slice(0, 3);
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
});

const backgroundExtensions = ["webp", "png", "jpg", "jpeg"];
const findThemeAsset = (baseName: string) => {
  const extension = backgroundExtensions.find((candidate) =>
    existsSync(resolve(`public/themes/kisara/assets/${baseName}.${candidate}`))
  );
  return extension ? `/themes/kisara/assets/${baseName}.${extension}` : null;
};
const activeBackgroundUrl = findThemeAsset("gate-background");
const activeFightUrl = findThemeAsset("fight");
const gateStyle = [
  "--kisara-fill: 0%",
  "--kisara-burst-progress: 0%",
  `--kisara-gate-background-image: ${activeBackgroundUrl ? `url("${activeBackgroundUrl}")` : "none"}`,
  `--kisara-fight-background-image: ${activeFightUrl ? `url("${activeFightUrl}")` : "none"}`
].join("; ");
---

<KisaraLayout title="Kisara | Yuimi Lab" description="Yuimi Lab 的 Kisara 视觉交互主题。">
  <section class="kisara-gate" data-kisara-gate style={gateStyle}>
    <div class="kisara-gate-visual" aria-hidden="true">
      <div class="kisara-gate-background kisara-gate-background-base"></div>
      <div class="kisara-gate-background kisara-gate-background-fight"></div>
      <div class="kisara-gate-atmosphere"></div>
    </div>
    <canvas class="kisara-burst-canvas" data-kisara-burst-canvas width="1280" height="900" aria-hidden="true"></canvas>
    <p class="kisara-gate-index">YUIMI LAB / INTERACTION CHANNEL 03</p>
    <h1 class="kisara-title" aria-label="Kisara">
      <span class="kisara-title-base" aria-hidden="true">Kisara</span>
      <span class="kisara-title-tide" aria-hidden="true">Kisara</span>
      <span class="kisara-title-crest" aria-hidden="true">Kisara</span>
      <span class="kisara-title-gloss" aria-hidden="true">Kisara</span>
      <i class="kisara-title-cross" aria-hidden="true">
        <span class="kisara-cross-ring"></span>
        <span class="kisara-cross-ray kisara-cross-ray-north"></span>
        <span class="kisara-cross-ray kisara-cross-ray-east"></span>
        <span class="kisara-cross-ray kisara-cross-ray-south"></span>
        <span class="kisara-cross-ray kisara-cross-ray-west"></span>
        <span class="kisara-cross-shard kisara-cross-shard-a"></span>
        <span class="kisara-cross-shard kisara-cross-shard-b"></span>
        <span class="kisara-cross-shard kisara-cross-shard-c"></span>
        <span class="kisara-cross-shard kisara-cross-shard-d"></span>
        <span class="kisara-cross-spark kisara-cross-spark-a"></span>
        <span class="kisara-cross-spark kisara-cross-spark-b"></span>
        <span class="kisara-cross-spark kisara-cross-spark-c"></span>
        <span class="kisara-cross-spark kisara-cross-spark-d"></span>
        <span class="kisara-cross-core"></span>
      </i>
    </h1>
    <div class="kisara-contract-meter" aria-hidden="true">
      <canvas class="kisara-energy-canvas" data-kisara-energy width="640" height="64"></canvas>
    </div>
    <p class="kisara-contract-state" data-kisara-state>CONTRACT 000%</p>
    <p class="kisara-scroll-cue" data-kisara-cue>SCROLL / SIGN THE CONTRACT</p>
    <a class="kisara-gate-skip" href="#kisara-opening" data-kisara-skip>SKIP</a>
  </section>

  <section id="kisara-opening" class="kisara-opening" aria-labelledby="kisara-opening-title">
    <div class="kisara-opening-inner">
      <p class="kisara-section-index">AFTER THE SIGNATURE / 001</p>
      <h2 id="kisara-opening-title">The signal continues below.</h2>
      <div class="kisara-opening-grid">
        <p>视觉、交互与技术记录沿着同一条契约线继续展开。</p>
        <nav aria-label="Kisara theme shortcuts">
          <a href={getThemePath("kisara", "/blog/")}><span>01</span>READ THE LOG</a>
          <a href={getThemePath("kisara", "/projects/")}><span>02</span>OPEN THE LAB</a>
          <a href={getThemePath("kisara", "/about/")}><span>03</span>TRACE YUIMI</a>
        </nav>
      </div>
    </div>
  </section>

  <section class="kisara-latest" aria-labelledby="kisara-latest-title">
    <div class="kisara-section-heading">
      <p class="kisara-section-index">RECENT TRANSMISSIONS / 002</p>
      <h2 id="kisara-latest-title">Latest notes</h2>
    </div>
    <div class="kisara-transmission-list">
      {posts.map((post, index) => (
        <a href={getThemePath("kisara", `/blog/${post.id}/`)}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div>
            <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.updatedDate ?? post.data.pubDate)}</time>
            <h3>{post.data.title}</h3>
          </div>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      const gate = document.querySelector("[data-kisara-gate]");
      if (!gate || gate.dataset.bound === "true") return;
      gate.dataset.bound = "true";

      const energyCanvas = gate.querySelector("[data-kisara-energy]");
      const energyContext = energyCanvas?.getContext("2d");
      const burstCanvas = gate.querySelector("[data-kisara-burst-canvas]");
      const burstContext = burstCanvas?.getContext("2d");
      const meterShell = gate.querySelector(".kisara-contract-meter");
      const title = gate.querySelector(".kisara-title");
      const cross = gate.querySelector(".kisara-title-cross");
      const opening = document.querySelector("#kisara-opening");
      const state = gate.querySelector("[data-kisara-state]");
      const cue = gate.querySelector("[data-kisara-cue]");
      const skip = gate.querySelector("[data-kisara-skip]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const restoredBelowGate = window.scrollY > 2;
      const fillDistance = 2100;
      const burstDistance = 2250;
      const springStrength = 0.06;
      const burstSpringStrength = 0.038;
      const damping = 0.76;
      const burstDamping = 0.86;
      const settleDistance = 0.00035;
      const glossFadeEnd = 0.42;
      const crossStart = 0.46;
      const crossBuildEnd = 0.58;
      const crossFlashEnd = 0.72;
      const crossEnd = 0.82;
      const reformEnd = 0.9;
      const detonationStart = 0.91;
      const detonationEnd = 0.968;
      const rainStart = 0.948;
      const rainPeak = 0.986;
      const releaseAutoplayDuration = 8200;
      const clamp = (value, minimum, maximum) => Math.min(maximum, Math.max(minimum, value));
      const startsComplete = reducedMotion && !restoredBelowGate;
      let progress = startsComplete ? 1 : 0;
      let targetProgress = progress;
      let velocity = 0;
      let burstProgress = startsComplete ? 1 : 0;
      let targetBurstProgress = burstProgress;
      let burstVelocity = 0;
      let burstAutoplay = false;
      let burstAutoplayComplete = startsComplete;
      let burstAutoplayStartedAt = 0;
      let animationFrame = 0;
      let lastFrameTime = 0;
      let touchY = null;
      let touchId = null;
      let renderedPercent = -1;
      let renderedStage = "";
      let renderedGlitchTick = -1;
      let energyFrame = 0;
      let energyProgress = 0;
      let energyCanvasWidth = 0;
      let energyCanvasHeight = 0;
      let burstCanvasWidth = 0;
      let burstCanvasHeight = 0;
      let pageMode = restoredBelowGate ? "next" : "gate";
      let scrollFrame = 0;
      let resetTransitionTimer = 0;
      let restoreWindowOpen = true;
      let poseTimestamp = 0;
      let poseClock = 0;
      let poseAtRest = true;
      let chargeInstability = 0;
      let beamPose = {
        shakeX: 0,
        shakeY: 0,
        anchorX: 0,
        anchorY: 0,
        lift: 0,
        scaleX: 1,
        scaleY: 1,
        angle: 0
      };
      let screenParticleTimestamp = 0;
      let particleSerial = 0;
      let wakeEmissionBudget = 0;
      let orbitEmissionBudget = 0;
      let rainEmissionBudget = 0;
      let burstWaveMask = 0;
      const wakeParticles = [];
      const orbitParticles = [];
      const burstParticles = [];
      const rainParticles = [];

      const smoothstep = (value) => value * value * (3 - 2 * value);
      const phaseProgress = (value, start, end) => smoothstep(clamp((value - start) / (end - start), 0, 1));
      const randomSeed = (index) => {
        const value = Math.sin(index * 12.9898 + 78.233) * 43758.5453;
        return value - Math.floor(value);
      };
      const nextParticleRandom = () => randomSeed((particleSerial += 1) * 1.61803398875 + 0.37);
      const glitchAlphabet = "0123456789XZ!?/#@$%&<>";
      const makeGlitchState = (timestamp, burst, released) => {
        const tick = Math.floor(timestamp / 72);
        const patterns = released
          ? ["SIGNAL RELEASED", "CORE WITHOUT LIMIT", "CHANNEL UNBOUND", "OUTPUT OVERRUN"]
          : ["SYSTEM UNSTABLE", "KISARA OVERFLOW", "CONTRACT BREACH", "RED TIDE RISING"];
        const pattern = patterns[Math.floor(randomSeed(tick + 8401) * patterns.length)];
        const corrupted = pattern.split("").map((character, index) => {
          if (character === " " || randomSeed(tick * 31 + index + 8417) < 0.62) return character;
          const glyphIndex = Math.floor(randomSeed(tick * 47 + index + 8461) * glitchAlphabet.length);
          return glitchAlphabet[glyphIndex];
        }).join("");
        const code = Math.floor(randomSeed(tick + 8521) * 0xffffff).toString(16).toUpperCase().padStart(6, "0");
        const noise = Array.from({ length: 4 }, (_, index) => {
          const glyphIndex = Math.floor(randomSeed(tick * 59 + index + 8591) * glitchAlphabet.length);
          return glitchAlphabet[glyphIndex];
        }).join("");
        const phase = burst > 0.72 ? "// BREAK" : "// OVRFLW";
        return `${corrupted} ${phase} ${code} ${noise}`;
      };

      const resizeEnergyCanvas = () => {
        if (!energyCanvas || !energyContext) return;
        const rect = energyCanvas.getBoundingClientRect();
        const width = Math.max(1, Math.round(rect.width));
        const height = Math.max(1, Math.round(rect.height));
        const devicePixelRatio = Math.min(window.devicePixelRatio || 1, 2);
        const pixelWidth = Math.max(1, Math.round(width * devicePixelRatio));
        const pixelHeight = Math.max(1, Math.round(height * devicePixelRatio));
        if (energyCanvas.width !== pixelWidth || energyCanvas.height !== pixelHeight) {
          energyCanvas.width = pixelWidth;
          energyCanvas.height = pixelHeight;
          energyContext.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
        }
        energyCanvasWidth = width;
        energyCanvasHeight = height;
      };

      const resizeBurstCanvas = () => {
        if (!burstCanvas || !burstContext) return;
        const rect = burstCanvas.getBoundingClientRect();
        const width = Math.max(1, Math.round(rect.width));
        const height = Math.max(1, Math.round(rect.height));
        const devicePixelRatio = Math.min(window.devicePixelRatio || 1, 2);
        const pixelWidth = Math.max(1, Math.round(width * devicePixelRatio));
        const pixelHeight = Math.max(1, Math.round(height * devicePixelRatio));
        if (burstCanvas.width !== pixelWidth || burstCanvas.height !== pixelHeight) {
          burstCanvas.width = pixelWidth;
          burstCanvas.height = pixelHeight;
          burstContext.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
        }
        burstCanvasWidth = width;
        burstCanvasHeight = height;
      };

      const drawScreenEnergy = (timestamp) => {
        if (!burstCanvas || !burstContext) return;
        resizeBurstCanvas();
        const width = burstCanvasWidth;
        const height = burstCanvasHeight;
        const context = burstContext;
        context.clearRect(0, 0, width, height);
        if (width <= 1 || height <= 1) return;

        const frameSeconds = screenParticleTimestamp
          ? clamp((timestamp - screenParticleTimestamp) / 1000, 0.008, 0.05)
          : 1 / 60;
        screenParticleTimestamp = timestamp;
        const time = timestamp / 1000;
        const fill = Math.max(energyProgress, 0.012);
        const burst = clamp(burstProgress, 0, 1);
        const intensity = 0.12 + fill * 0.88;
        const densityScale = width < 640 ? 0.62 : width < 960 ? 0.82 : 1;
        const meterWidth = meterShell?.clientWidth || Math.min(620, width * 0.78);
        const meterHeight = meterShell?.clientHeight || 68;
        const meterLeft = meterShell?.offsetLeft ?? (width - meterWidth) / 2;
        const meterTop = meterShell?.offsetTop ?? height * 0.58;
        const localFrontRadius = 5 + fill * 22;
        const localFrontX = clamp(
          meterWidth * fill,
          3,
          Math.max(3, meterWidth - localFrontRadius * 2.2)
        );
        const angleRadians = beamPose.angle * Math.PI / 180;
        const headOffset = (localFrontX - meterWidth * 0.5) * beamPose.scaleX;
        const originX = clamp(
          meterLeft + meterWidth * 0.5 + beamPose.anchorX + beamPose.shakeX + Math.cos(angleRadians) * headOffset,
          width * 0.04,
          width * 0.96
        );
        const originY = clamp(
          meterTop + meterHeight * 0.5 + beamPose.anchorY + beamPose.shakeY + beamPose.lift + Math.sin(angleRadians) * headOffset,
          height * 0.08,
          height * 0.92
        );
        const maxRadius = Math.hypot(width, height) * 1.18;
        const dissolve = phaseProgress(burst, 0.015, 0.14);
        const releaseBuild = phaseProgress(burst, crossEnd, reformEnd);
        const releasePressure = phaseProgress(burst, 0.865, detonationStart);
        const detonationLinear = clamp((burst - detonationStart) / (detonationEnd - detonationStart), 0, 1);
        const detonation = smoothstep(detonationLinear);
        const rainBuild = phaseProgress(burst, rainStart, rainPeak);
        const rainStop = phaseProgress(burst, rainPeak, 1);
        const wakeOpacity = clamp(1 - dissolve, 0, 1);
        const afterglow = phaseProgress(burst, detonationStart, detonationEnd)
          * (1 - phaseProgress(burst, rainPeak, 1));

        context.save();
        context.globalCompositeOperation = "lighter";

        const ambientCount = Math.floor((10 + fill * 34) * densityScale);
        for (let index = 0; index < ambientCount; index += 1) {
          const seedX = randomSeed(index + 1201);
          const seedY = randomSeed(index + 1801);
          const speed = 0.18 + seedX * (0.28 + fill * 0.56);
          const x = (seedX * width + Math.sin(time * speed + index) * (5 + fill * 17) + width) % width;
          const y = (seedY * height + Math.cos(time * (speed + 0.17) + index) * (4 + fill * 13) + height) % height;
          const size = 0.42 + seedY * (0.6 + fill * 1.25);
          context.globalAlpha = (0.018 + seedX * 0.085) * intensity * wakeOpacity;
          context.fillStyle = fill > 0.56 && index % 3 !== 0 ? "#ff9caf" : "#c5d8ff";
          context.beginPath();
          context.arc(x, y, size, 0, Math.PI * 2);
          context.fill();
        }

        const wakeLimit = width < 640 ? 132 : 248;
        if (!reducedMotion && wakeOpacity > 0.02 && fill > 0.025 && burst < 0.02) {
          wakeEmissionBudget += frameSeconds * (6 + fill * 44) * densityScale;
          while (wakeEmissionBudget >= 1 && wakeParticles.length < wakeLimit) {
            wakeEmissionBudget -= 1;
            const side = nextParticleRandom() > 0.5 ? 1 : -1;
            const backSpeed = 46 + fill * 142 + nextParticleRandom() * 52;
            const sideSpeed = side * (12 + fill * 76) * (0.42 + nextParticleRandom() * 0.8);
            const forwardX = Math.cos(angleRadians);
            const forwardY = Math.sin(angleRadians);
            const normalX = -forwardY;
            const normalY = forwardX;
            wakeParticles.push({
              x: originX - forwardX * (2 + localFrontRadius * 0.28),
              y: originY - forwardY * (2 + localFrontRadius * 0.28),
              previousX: originX,
              previousY: originY,
              velocityX: -forwardX * backSpeed + normalX * sideSpeed,
              velocityY: -forwardY * backSpeed + normalY * sideSpeed,
              age: 0,
              jetLife: 0.62 + nextParticleRandom() * 0.68,
              coastLife: 1.3 + nextParticleRandom() * 1.45,
              life: 7.2 + nextParticleRandom() * 5.8,
              size: 0.55 + nextParticleRandom() * (0.9 + fill * 1.35),
              phase: nextParticleRandom() * Math.PI * 2,
              curl: (nextParticleRandom() - 0.5) * 2,
              tint: Math.floor(nextParticleRandom() * 5)
            });
          }
        } else {
          wakeEmissionBudget = Math.min(wakeEmissionBudget, 0.95);
        }

        for (let index = wakeParticles.length - 1; index >= 0; index -= 1) {
          const particle = wakeParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life) {
            wakeParticles.splice(index, 1);
            continue;
          }

          particle.previousX = particle.x;
          particle.previousY = particle.y;
          const inJet = particle.age < particle.jetLife;
          const inCoast = particle.age < particle.jetLife + particle.coastLife;
          const drag = Math.exp(-frameSeconds * (inJet ? 0.72 : inCoast ? 0.16 : 0.08));
          particle.velocityX *= drag;
          particle.velocityY *= drag;
          const particleSpeed = Math.max(1, Math.hypot(particle.velocityX, particle.velocityY));
          const curveX = -particle.velocityY / particleSpeed;
          const curveY = particle.velocityX / particleSpeed;
          if (inJet || inCoast) {
            const curveStrength = particle.curl * (inJet ? 8.4 : 3.8) * (0.45 + particle.size * 0.24);
            particle.velocityX += curveX * curveStrength * frameSeconds;
            particle.velocityY += curveY * curveStrength * frameSeconds;
          } else {
            const driftAge = particle.age - particle.jetLife;
            particle.velocityX += Math.sin(particle.phase + driftAge * (0.54 + particle.size * 0.08))
              * frameSeconds * (3.2 + particle.size * 1.4);
            particle.velocityY += Math.cos(particle.phase * 0.73 + driftAge * 0.46)
              * frameSeconds * (2.1 + particle.size * 0.9);
            particle.velocityY -= frameSeconds * (0.52 + particle.size * 0.18);
          }
          particle.x += particle.velocityX * frameSeconds;
          particle.y += particle.velocityY * frameSeconds;

          if (!inJet && !inCoast) {
            if (particle.x < 10 && particle.velocityX < 0) particle.velocityX *= -0.46;
            if (particle.x > width - 10 && particle.velocityX > 0) particle.velocityX *= -0.46;
            if (particle.y < 10 && particle.velocityY < 0) particle.velocityY *= -0.42;
            if (particle.y > height - 10 && particle.velocityY > 0) particle.velocityY *= -0.42;
            particle.x = clamp(particle.x, -20, width + 20);
            particle.y = clamp(particle.y, -20, height + 20);
          }

          const lifeRatio = particle.age / particle.life;
          const fadeIn = smoothstep(clamp(particle.age / 0.14, 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeRatio - 0.74) / 0.26, 0, 1));
          const alpha = fadeIn * fadeOut * (inJet ? 0.68 : inCoast ? 0.54 : 0.42) * intensity;
          if (alpha <= 0.004) continue;

          context.globalAlpha = alpha;
          context.strokeStyle = particle.tint === 0
            ? "#ffffff"
            : particle.tint < 3
              ? "#ff9bb1"
              : "#bfd6ff";
          context.fillStyle = context.strokeStyle;
          context.lineCap = "round";
          if (inJet || inCoast) {
            const coastFade = inJet ? 1 : 1 - clamp((particle.age - particle.jetLife) / particle.coastLife, 0, 1) * 0.34;
            const trailScale = inJet ? 2.2 : 1.35;
            context.globalAlpha = alpha * coastFade;
            context.lineWidth = particle.size * (inJet ? 0.78 : 0.62);
            context.beginPath();
            context.moveTo(
              particle.x - particle.velocityX * frameSeconds * trailScale,
              particle.y - particle.velocityY * frameSeconds * trailScale
            );
            context.lineTo(particle.x, particle.y);
            context.stroke();
          } else {
            const pulse = 0.76 + Math.sin(time * 1.2 + particle.phase) * 0.24;
            context.globalAlpha = alpha * pulse;
            context.beginPath();
            context.arc(particle.x, particle.y, particle.size * (0.46 + pulse * 0.22), 0, Math.PI * 2);
            context.fill();
          }
        }

        const blackHoleBuild = phaseProgress(burst, crossEnd, 0.872);
        const gravityLock = phaseProgress(burst, 0.855, detonationStart);
        const collapse = phaseProgress(burst, 0.892, detonationStart);
        const blackHoleFade = 1 - phaseProgress(burst, detonationStart + 0.006, detonationEnd);
        const blackHoleOpacity = blackHoleBuild * blackHoleFade;
        const blackHoleAngle = -0.16 + Math.sin(time * 0.43) * 0.025 - collapse * 0.08;
        const viewportScale = Math.min(width, height);
        const baseCoreRadius = clamp(viewportScale * 0.09, 28, 82);
        const coreRadius = baseCoreRadius * (0.86 + blackHoleBuild * 0.18 - collapse * 0.2);
        const diskRadius = coreRadius * (3.12 + blackHoleBuild * 0.62 - collapse * 0.32);
        const diskFlatten = 0.27 + blackHoleBuild * 0.055 - collapse * 0.035;

        const orbitLimit = width < 640 ? 112 : 220;
        const orbitDrive = blackHoleOpacity * (1 - detonationLinear);
        if (!reducedMotion && orbitDrive > 0.01) {
          orbitEmissionBudget += frameSeconds * (18 + gravityLock * 86) * densityScale;
          while (orbitEmissionBudget >= 1 && orbitParticles.length < orbitLimit) {
            orbitEmissionBudget -= 1;
            orbitParticles.push({
              angle: nextParticleRandom() * Math.PI * 2,
              radius: diskRadius * (1.05 + nextParticleRandom() * 1.55),
              angularVelocity: (0.72 + nextParticleRandom() * 1.08) * (nextParticleRandom() > 0.1 ? 1 : -1),
              radialSpeed: 5 + nextParticleRandom() * 13,
              lane: 0.74 + nextParticleRandom() * 0.34,
              age: 0,
              life: 4.8 + nextParticleRandom() * 5.4,
              size: 0.45 + nextParticleRandom() * 1.35,
              escape: nextParticleRandom() < 0.18,
              tint: Math.floor(nextParticleRandom() * 6)
            });
          }
        } else {
          orbitEmissionBudget = Math.min(orbitEmissionBudget, 0.95);
        }

        const projectOrbit = (angle, radius, lane) => {
          const localX = Math.cos(angle) * radius;
          const localY = Math.sin(angle) * radius * diskFlatten * lane;
          return {
            x: originX + localX * Math.cos(blackHoleAngle) - localY * Math.sin(blackHoleAngle),
            y: originY + localX * Math.sin(blackHoleAngle) + localY * Math.cos(blackHoleAngle)
          };
        };

        for (let index = orbitParticles.length - 1; index >= 0; index -= 1) {
          const particle = orbitParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life || blackHoleOpacity <= 0.001) {
            orbitParticles.splice(index, 1);
            continue;
          }
          const previousAngle = particle.angle;
          const previousRadius = particle.radius;
          const orbitAcceleration = 1 + gravityLock * 4.8 + collapse * 2.2;
          particle.angle += particle.angularVelocity * frameSeconds * orbitAcceleration
            * Math.pow(diskRadius / Math.max(coreRadius, particle.radius), 0.46);
          particle.radius -= (particle.radialSpeed + gravityLock * (11 + particle.size * 7)) * frameSeconds;

          if (particle.radius <= coreRadius * 1.12) {
            if (
              particle.escape
              && gravityLock > 0.54
              && detonationLinear <= 0.001
              && burstParticles.length < (width < 640 ? 190 : 360)
            ) {
              const escapePoint = projectOrbit(particle.angle, coreRadius * 1.18, particle.lane);
              const tangentAngle = particle.angle + (particle.angularVelocity > 0 ? Math.PI / 2 : -Math.PI / 2) + blackHoleAngle;
              const escapeSpeed = 150 + gravityLock * 260 + nextParticleRandom() * 120;
              burstParticles.push({
                x: escapePoint.x,
                y: escapePoint.y,
                previousX: escapePoint.x,
                previousY: escapePoint.y,
                velocityX: Math.cos(tangentAngle) * escapeSpeed + Math.cos(blackHoleAngle) * escapeSpeed * 0.18,
                velocityY: Math.sin(tangentAngle) * escapeSpeed + Math.sin(blackHoleAngle) * escapeSpeed * 0.18,
                age: 0,
                life: 2.8 + nextParticleRandom() * 3.6,
                size: particle.size * (0.9 + nextParticleRandom() * 0.8),
                drag: 0.3 + nextParticleRandom() * 0.42,
                gravity: 4 + nextParticleRandom() * 14,
                phase: nextParticleRandom() * Math.PI * 2,
                tint: particle.tint,
                shape: nextParticleRandom()
              });
              orbitParticles.splice(index, 1);
              continue;
            }
            if (burst < detonationStart && blackHoleOpacity > 0.2) {
              particle.radius = diskRadius * (1.6 + nextParticleRandom() * 0.92);
              particle.angle += Math.PI * (0.42 + nextParticleRandom() * 0.34);
            } else {
              orbitParticles.splice(index, 1);
              continue;
            }
          }

          const previousPoint = projectOrbit(previousAngle, previousRadius, particle.lane);
          const point = projectOrbit(particle.angle, particle.radius, particle.lane);
          particle.previousRenderX = previousPoint.x;
          particle.previousRenderY = previousPoint.y;
          particle.renderX = point.x;
          particle.renderY = point.y;
          particle.depth = Math.sin(particle.angle);
        }

        const drawOrbitParticle = (particle) => {
          const lifeRatio = particle.age / particle.life;
          const fadeIn = smoothstep(clamp(particle.age / 0.14, 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeRatio - 0.72) / 0.28, 0, 1));
          const coreProximity = clamp((particle.radius - coreRadius) / Math.max(1, diskRadius * 1.55), 0, 1);
          context.globalAlpha = fadeIn * fadeOut * blackHoleOpacity * (0.28 + (1 - coreProximity) * 0.56);
          context.strokeStyle = particle.tint === 0
            ? "#ffffff"
            : particle.tint < 4
              ? "#ff89a9"
              : "#b9d4ff";
          context.fillStyle = context.strokeStyle;
          context.lineWidth = particle.size * (0.58 + gravityLock * 0.38);
          context.lineCap = "round";
          context.beginPath();
          context.moveTo(particle.previousRenderX, particle.previousRenderY);
          context.lineTo(particle.renderX, particle.renderY);
          context.stroke();
          if (particle.size > 1.12) {
            context.globalAlpha *= 0.48;
            context.beginPath();
            context.arc(particle.renderX, particle.renderY, particle.size * 0.4, 0, Math.PI * 2);
            context.fill();
          }
        };

        if (blackHoleOpacity > 0.001) {
          context.save();
          context.globalCompositeOperation = "source-over";
          const gravityShade = context.createRadialGradient(
            originX,
            originY,
            coreRadius * 0.4,
            originX,
            originY,
            maxRadius * 0.72
          );
          gravityShade.addColorStop(0, "rgba(1, 1, 8, 0.18)");
          gravityShade.addColorStop(0.22, "rgba(7, 3, 17, 0.12)");
          gravityShade.addColorStop(0.58, "rgba(20, 5, 26, 0.045)");
          gravityShade.addColorStop(1, "rgba(3, 4, 13, 0)");
          context.globalAlpha = blackHoleOpacity * (0.34 + collapse * 0.36);
          context.fillStyle = gravityShade;
          context.fillRect(0, 0, width, height);
          context.restore();

          context.save();
          context.globalCompositeOperation = "lighter";
          for (const particle of orbitParticles) {
            if (particle.depth < 0 && particle.renderX !== undefined) drawOrbitParticle(particle);
          }

          context.translate(originX, originY);
          context.rotate(blackHoleAngle);
          const diskGradient = context.createLinearGradient(-diskRadius, 0, diskRadius, 0);
          diskGradient.addColorStop(0, "rgba(111, 157, 255, 0)");
          diskGradient.addColorStop(0.18, "rgba(143, 184, 255, 0.42)");
          diskGradient.addColorStop(0.46, "rgba(255, 89, 137, 0.86)");
          diskGradient.addColorStop(0.58, "rgba(255, 242, 248, 0.98)");
          diskGradient.addColorStop(0.78, "rgba(255, 107, 149, 0.62)");
          diskGradient.addColorStop(1, "rgba(255, 107, 149, 0)");

          for (let band = 0; band < 5; band += 1) {
            context.globalAlpha = blackHoleOpacity * (0.14 + band * 0.038) * (0.78 + gravityLock * 0.54);
            context.strokeStyle = diskGradient;
            context.lineWidth = 1.7 + (4 - band) * (1.7 + gravityLock * 0.82);
            context.shadowColor = band < 2 ? "rgba(140, 181, 255, 0.72)" : "rgba(255, 77, 126, 0.9)";
            context.shadowBlur = 7 + (4 - band) * 3 + gravityLock * 12;
            context.beginPath();
            context.ellipse(
              0,
              0,
              diskRadius * (0.92 + band * 0.035),
              diskRadius * diskFlatten * (0.84 + band * 0.055),
              0,
              Math.PI,
              Math.PI * 2
            );
            context.stroke();
          }

          context.globalAlpha = blackHoleOpacity * (0.17 + gravityLock * 0.16);
          context.strokeStyle = diskGradient;
          context.lineWidth = coreRadius * (0.16 + gravityLock * 0.055);
          context.shadowColor = "rgba(255, 77, 128, 0.88)";
          context.shadowBlur = 22 + gravityLock * 22;
          context.beginPath();
          context.ellipse(0, 0, diskRadius * 1.02, diskRadius * diskFlatten * 0.96, 0, 0, Math.PI * 2);
          context.stroke();

          const halo = context.createRadialGradient(0, 0, coreRadius * 0.7, 0, 0, diskRadius * 1.08);
          halo.addColorStop(0, "rgba(255, 92, 137, 0.14)");
          halo.addColorStop(0.42, "rgba(255, 82, 131, 0.07)");
          halo.addColorStop(0.76, "rgba(139, 176, 255, 0.035)");
          halo.addColorStop(1, "rgba(139, 176, 255, 0)");
          context.globalAlpha = blackHoleOpacity * (0.72 + gravityLock * 0.34);
          context.fillStyle = halo;
          context.fillRect(-diskRadius * 1.12, -diskRadius, diskRadius * 2.24, diskRadius * 2);

          context.globalCompositeOperation = "source-over";
          const eventHorizon = context.createRadialGradient(
            -coreRadius * 0.16,
            -coreRadius * 0.14,
            coreRadius * 0.06,
            0,
            0,
            coreRadius * 1.08
          );
          eventHorizon.addColorStop(0, "rgba(0, 0, 3, 1)");
          eventHorizon.addColorStop(0.66, "rgba(2, 1, 8, 0.99)");
          eventHorizon.addColorStop(0.9, "rgba(18, 3, 24, 0.98)");
          eventHorizon.addColorStop(1, "rgba(61, 8, 42, 0.28)");
          context.globalAlpha = blackHoleOpacity;
          context.fillStyle = eventHorizon;
          context.beginPath();
          context.arc(0, 0, coreRadius * 1.08, 0, Math.PI * 2);
          context.fill();

          context.globalCompositeOperation = "lighter";
          context.globalAlpha = blackHoleOpacity * (0.76 + gravityLock * 0.22);
          context.strokeStyle = "rgba(255, 211, 226, 0.92)";
          context.lineWidth = 1 + gravityLock * 1.4;
          context.shadowColor = "rgba(255, 66, 123, 0.96)";
          context.shadowBlur = 8 + gravityLock * 13;
          context.beginPath();
          context.arc(0, 0, coreRadius * 1.1, 0, Math.PI * 2);
          context.stroke();

          for (let band = 0; band < 4; band += 1) {
            context.globalAlpha = blackHoleOpacity * (0.34 + band * 0.082) * (0.8 + gravityLock * 0.46);
            context.strokeStyle = diskGradient;
            context.lineWidth = 2 + (3 - band) * (2.15 + gravityLock * 0.96);
            context.shadowColor = "rgba(255, 74, 125, 0.9)";
            context.shadowBlur = 8 + (3 - band) * 3 + gravityLock * 14;
            context.beginPath();
            context.ellipse(
              0,
              0,
              diskRadius * (0.9 + band * 0.042),
              diskRadius * diskFlatten * (0.82 + band * 0.06),
              0,
              0,
              Math.PI
            );
            context.stroke();
          }

          const lensingHeight = coreRadius * (1.92 + gravityLock * 0.52);
          for (let sideIndex = 0; sideIndex < 2; sideIndex += 1) {
            const side = sideIndex === 0 ? -1 : 1;
            context.globalAlpha = blackHoleOpacity * (0.3 + gravityLock * 0.34);
            context.strokeStyle = side < 0 ? "rgba(184, 211, 255, 0.78)" : "rgba(255, 170, 195, 0.82)";
            context.lineWidth = 1.3 + gravityLock * 1.35;
            context.shadowColor = context.strokeStyle;
            context.shadowBlur = 8 + gravityLock * 11;
            context.beginPath();
            context.moveTo(-diskRadius * 0.66, side * coreRadius * 0.12);
            context.bezierCurveTo(
              -coreRadius * 1.18,
              side * lensingHeight,
              coreRadius * 1.18,
              side * lensingHeight,
              diskRadius * 0.66,
              side * coreRadius * 0.08
            );
            context.stroke();
          }

          for (let highlight = 0; highlight < 6; highlight += 1) {
            const seed = randomSeed(highlight + 7301);
            const phase = time * (0.42 + seed * 0.5) + seed * Math.PI * 2;
            const span = 0.18 + seed * 0.42;
            context.globalAlpha = blackHoleOpacity * (0.12 + gravityLock * 0.18) * (0.46 + seed * 0.54);
            context.strokeStyle = highlight % 3 === 0 ? "#ffffff" : highlight % 2 === 0 ? "#ff8fab" : "#bed7ff";
            context.lineWidth = 0.55 + seed * 1.15;
            context.shadowBlur = 3 + gravityLock * 7;
            context.beginPath();
            context.ellipse(0, 0, diskRadius * (0.96 + seed * 0.16), diskRadius * diskFlatten, 0, phase, phase + span);
            context.stroke();
          }
          context.restore();

          context.save();
          context.globalCompositeOperation = "lighter";
          for (const particle of orbitParticles) {
            if (particle.depth >= 0 && particle.renderX !== undefined) drawOrbitParticle(particle);
          }
          context.restore();
        }

        const burstLimit = width < 640 ? 190 : 360;
        const spawnBurstWave = (waveIndex) => {
          const count = Math.floor((waveIndex === 0 ? 72 : waveIndex === 1 ? 104 : 138) * densityScale);
          for (let index = 0; index < count && burstParticles.length < burstLimit; index += 1) {
            const angle = nextParticleRandom() * Math.PI * 2;
            const spawnRadius = coreRadius * (0.82 + nextParticleRandom() * 0.92);
            const localX = Math.cos(angle) * spawnRadius;
            const localY = Math.sin(angle) * spawnRadius * diskFlatten;
            const spawnX = originX + localX * Math.cos(blackHoleAngle) - localY * Math.sin(blackHoleAngle);
            const spawnY = originY + localX * Math.sin(blackHoleAngle) + localY * Math.cos(blackHoleAngle);
            const flowSign = nextParticleRandom() > 0.1 ? 1 : -1;
            const localTangentX = -Math.sin(angle) * flowSign;
            const localTangentY = Math.cos(angle) * diskFlatten * flowSign;
            const tangentLength = Math.max(0.001, Math.hypot(localTangentX, localTangentY));
            const tangentX = (localTangentX / tangentLength) * Math.cos(blackHoleAngle)
              - (localTangentY / tangentLength) * Math.sin(blackHoleAngle);
            const tangentY = (localTangentX / tangentLength) * Math.sin(blackHoleAngle)
              + (localTangentY / tangentLength) * Math.cos(blackHoleAngle);
            const radialX = Math.cos(angle + blackHoleAngle);
            const radialY = Math.sin(angle + blackHoleAngle) * 0.76;
            const speed = (waveIndex === 0 ? 170 : waveIndex === 1 ? 125 : 92)
              + nextParticleRandom() * (waveIndex === 0 ? 280 : waveIndex === 1 ? 230 : 180);
            const tangentWeight = waveIndex === 0 ? 0.82 : waveIndex === 1 ? 0.58 : 0.34;
            const radialWeight = waveIndex === 0 ? 0.34 : waveIndex === 1 ? 0.62 : 0.88;
            burstParticles.push({
              x: spawnX,
              y: spawnY,
              previousX: spawnX,
              previousY: spawnY,
              velocityX: tangentX * speed * tangentWeight + radialX * speed * radialWeight,
              velocityY: tangentY * speed * tangentWeight + radialY * speed * radialWeight,
              age: 0,
              life: 3.2 + nextParticleRandom() * 3.8 + waveIndex * 0.38,
              size: 0.58 + nextParticleRandom() * (1.72 + waveIndex * 0.48),
              drag: 0.28 + nextParticleRandom() * 0.5,
              gravity: 4 + nextParticleRandom() * 20,
              phase: nextParticleRandom() * Math.PI * 2,
              tint: Math.floor(nextParticleRandom() * 6),
              shape: nextParticleRandom()
            });
          }
        };

        if (!reducedMotion) {
          const waveThresholds = [0.06, 0.34, 0.66];
          for (let waveIndex = 0; waveIndex < waveThresholds.length; waveIndex += 1) {
            const waveBit = 1 << waveIndex;
            if (detonationLinear >= waveThresholds[waveIndex] && (burstWaveMask & waveBit) === 0) {
              burstWaveMask |= waveBit;
              spawnBurstWave(waveIndex);
            }
          }
        }

        if (detonationLinear > 0.001) {
          const inversionFlash = Math.exp(-Math.pow((detonationLinear - 0.12) / 0.075, 2));
          const ruptureFlash = Math.exp(-Math.pow((detonationLinear - 0.38) / 0.16, 2)) * 0.72;
          const flashStrength = clamp(inversionFlash + ruptureFlash, 0, 1.24);
          const jetRise = phaseProgress(detonationLinear, 0.03, 0.28);
          const jetFall = 1 - phaseProgress(detonationLinear, 0.72, 1);
          const jetStrength = jetRise * jetFall;
          const shockEase = 1 - Math.pow(1 - detonationLinear, 3.2);

          if (flashStrength > 0.002) {
            const flash = context.createRadialGradient(originX, originY, 0, originX, originY, maxRadius * 0.88);
            flash.addColorStop(0, "rgba(255, 255, 255, 0.96)");
            flash.addColorStop(0.07, "rgba(255, 240, 247, 0.82)");
            flash.addColorStop(0.24, "rgba(255, 91, 139, 0.34)");
            flash.addColorStop(0.54, "rgba(160, 101, 255, 0.09)");
            flash.addColorStop(1, "rgba(255, 72, 112, 0)");
            context.globalAlpha = flashStrength * 0.92;
            context.fillStyle = flash;
            context.fillRect(0, 0, width, height);
          }

          if (jetStrength > 0.001) {
            context.save();
            context.translate(originX, originY);
            context.rotate(blackHoleAngle + Math.PI / 2);
            const jetLength = maxRadius * (0.24 + jetStrength * 0.72);
            const jetWidth = coreRadius * (0.1 + jetStrength * 0.62);
            const traceJet = (direction, widthScale = 1, lengthScale = 1, bendScale = 1) => {
              const activeLength = jetLength * lengthScale;
              const activeWidth = jetWidth * widthScale;
              const jetBend = Math.sin(time * (8.2 + jetStrength * 8.6) + direction * 0.9)
                * activeWidth * 0.62 * bendScale;
              context.beginPath();
              context.moveTo(direction * coreRadius * 0.36, -activeWidth * 0.2);
              context.bezierCurveTo(
                direction * activeLength * 0.18,
                -activeWidth + jetBend * 0.1,
                direction * activeLength * 0.7,
                -activeWidth * 0.28 + jetBend * 0.72,
                direction * activeLength,
                jetBend
              );
              context.bezierCurveTo(
                direction * activeLength * 0.7,
                activeWidth * 0.28 + jetBend * 0.72,
                direction * activeLength * 0.18,
                activeWidth + jetBend * 0.1,
                direction * coreRadius * 0.36,
                activeWidth * 0.2
              );
              context.closePath();
            };

            for (const direction of [-1, 1]) {
              const jetGradient = context.createLinearGradient(0, 0, direction * jetLength, 0);
              jetGradient.addColorStop(0, "rgba(255,255,255,0.98)");
              jetGradient.addColorStop(0.08, "rgba(255,216,231,0.92)");
              jetGradient.addColorStop(0.36, "rgba(255,76,130,0.56)");
              jetGradient.addColorStop(0.72, "rgba(153,126,255,0.16)");
              jetGradient.addColorStop(1, "rgba(126,157,255,0)");
              traceJet(direction);
              context.globalAlpha = jetStrength * 0.2;
              context.fillStyle = jetGradient;
              context.shadowColor = "rgba(255, 71, 130, 0.94)";
              context.shadowBlur = 34 + jetStrength * 46;
              context.fill();
              traceJet(direction);
              context.globalAlpha = jetStrength * 0.62;
              context.shadowBlur = 8 + jetStrength * 14;
              context.fill();
              traceJet(direction, 0.3, 0.94, 0.58);
              context.globalAlpha = jetStrength * 0.86;
              context.fillStyle = "rgba(255, 244, 249, 0.88)";
              context.shadowColor = "rgba(255, 188, 213, 0.98)";
              context.shadowBlur = 7 + jetStrength * 12;
              context.fill();
            }
            context.restore();
          }

          for (let ring = 0; ring < 3; ring += 1) {
            const delayed = clamp((detonationLinear - ring * 0.14) / (1 - ring * 0.14), 0, 1);
            if (delayed <= 0) continue;
            const ringEase = 1 - Math.pow(1 - delayed, 3);
            const ringRadius = ringEase * maxRadius * (0.62 + ring * 0.12);
            const ringAlpha = Math.pow(Math.sin(delayed * Math.PI), 1.42) * (0.3 - ring * 0.054);
            context.globalAlpha = ringAlpha;
            context.strokeStyle = ring % 2 === 0 ? "#ffd2dc" : "#c9dcff";
            context.lineWidth = 0.8 + (1 - delayed) * (5.2 - ring * 0.68);
            context.shadowColor = ring % 2 === 0 ? "rgba(255,92,139,0.84)" : "rgba(157,192,255,0.7)";
            context.shadowBlur = 6 + (1 - delayed) * 14;
            context.beginPath();
            context.ellipse(originX, originY, ringRadius, ringRadius * (0.54 + ring * 0.045), blackHoleAngle, 0, Math.PI * 2);
            context.stroke();
          }

          const rushStrength = Math.pow(Math.sin(clamp(detonationLinear / 0.84, 0, 1) * Math.PI), 1.15);
          if (rushStrength > 0.001) {
            const rushCount = 14 + Math.floor(rushStrength * 34);
            for (let index = 0; index < rushCount; index += 1) {
              const seed = randomSeed(index + 9301);
              const angle = seed * Math.PI * 2 + blackHoleAngle + detonationLinear * (0.8 + seed * 1.4);
              const startRadius = coreRadius * (1.1 + seed * 1.7);
              const streakLength = 34 + rushStrength * (110 + seed * 240);
              const startX = originX + Math.cos(angle) * startRadius;
              const startY = originY + Math.sin(angle) * startRadius * 0.66;
              const curveAngle = angle + (seed > 0.5 ? 0.28 : -0.28);
              const endX = originX + Math.cos(curveAngle) * (startRadius + streakLength);
              const endY = originY + Math.sin(curveAngle) * (startRadius + streakLength) * 0.72;
              const streakGradient = context.createLinearGradient(startX, startY, endX, endY);
              streakGradient.addColorStop(0, index % 4 === 0 ? "rgba(255,255,255,0.86)" : "rgba(255,122,157,0.66)");
              streakGradient.addColorStop(0.42, index % 3 === 0 ? "rgba(255,95,143,0.38)" : "rgba(173,194,255,0.26)");
              streakGradient.addColorStop(1, "rgba(140,178,255,0)");
              context.globalAlpha = rushStrength * (0.04 + seed * 0.18);
              context.strokeStyle = streakGradient;
              context.lineWidth = 0.55 + seed * 1.7;
              context.shadowColor = index % 3 === 0 ? "rgba(255,79,130,0.8)" : "rgba(154,188,255,0.62)";
              context.shadowBlur = 3 + rushStrength * 8;
              context.beginPath();
              context.moveTo(startX, startY);
              context.quadraticCurveTo(
                originX + Math.cos(angle + (seed - 0.5) * 0.9) * (startRadius + streakLength * 0.48),
                originY + Math.sin(angle + (seed - 0.5) * 0.9) * (startRadius + streakLength * 0.48) * 0.66,
                endX,
                endY
              );
              context.stroke();
            }
          }

          for (let arcIndex = 0; arcIndex < 12; arcIndex += 1) {
            const seed = randomSeed(arcIndex + 10101);
            const delayed = clamp((detonationLinear - seed * 0.28) / (1 - seed * 0.28), 0, 1);
            if (delayed <= 0) continue;
            const radius = (1 - Math.pow(1 - delayed, 2.7)) * maxRadius * (0.18 + seed * 0.42);
            const startAngle = seed * Math.PI * 2 + detonationLinear * (0.8 + seed * 1.3) + blackHoleAngle;
            const span = 0.22 + seed * 0.9;
            context.globalAlpha = Math.pow(Math.sin(delayed * Math.PI), 1.32) * (0.055 + seed * 0.14);
            context.strokeStyle = arcIndex % 3 === 0 ? "#ffffff" : arcIndex % 2 === 0 ? "#ff9db3" : "#bfd6ff";
            context.lineWidth = 0.65 + (1 - delayed) * (2.2 + seed * 2.8);
            context.shadowColor = context.strokeStyle;
            context.shadowBlur = 4 + (1 - delayed) * 8;
            context.beginPath();
            context.ellipse(
              originX,
              originY,
              radius,
              radius * 0.62,
              blackHoleAngle,
              startAngle,
              startAngle + span
            );
            context.stroke();
          }

          const blastCoreRadius = coreRadius * 0.72 + shockEase * Math.min(width, height) * 0.24;
          const blastCore = context.createRadialGradient(originX, originY, 0, originX, originY, blastCoreRadius);
          blastCore.addColorStop(0, "rgba(255,255,255,0.96)");
          blastCore.addColorStop(0.12, "rgba(255,226,237,0.84)");
          blastCore.addColorStop(0.34, "rgba(255,80,134,0.42)");
          blastCore.addColorStop(0.66, "rgba(164,111,255,0.12)");
          blastCore.addColorStop(1, "rgba(255,74,116,0)");
          context.globalAlpha = Math.pow(1 - detonationLinear, 0.72) * 0.82 + afterglow * 0.24;
          context.fillStyle = blastCore;
          context.fillRect(
            originX - blastCoreRadius,
            originY - blastCoreRadius,
            blastCoreRadius * 2,
            blastCoreRadius * 2
          );
        }

        for (let index = burstParticles.length - 1; index >= 0; index -= 1) {
          const particle = burstParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life) {
            burstParticles.splice(index, 1);
            continue;
          }
          particle.previousX = particle.x;
          particle.previousY = particle.y;
          const lifeRatio = particle.age / particle.life;
          const drag = Math.exp(-frameSeconds * particle.drag);
          particle.velocityX *= drag;
          particle.velocityY *= drag;
          particle.velocityX += Math.sin(particle.phase + particle.age * 1.8) * frameSeconds * 3.2;
          particle.velocityY += particle.gravity * frameSeconds * (0.16 + lifeRatio * 0.84);
          particle.x += particle.velocityX * frameSeconds;
          particle.y += particle.velocityY * frameSeconds;

          if (
            particle.x < -180
            || particle.x > width + 180
            || particle.y < -180
            || particle.y > height + 220
          ) {
            burstParticles.splice(index, 1);
            continue;
          }

          const fadeIn = smoothstep(clamp(particle.age / 0.055, 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeRatio - 0.46) / 0.54, 0, 1));
          const alpha = fadeIn * fadeOut * (0.28 + particle.size * 0.18);
          context.globalAlpha = alpha;
          context.strokeStyle = particle.tint === 0
            ? "#ffffff"
            : particle.tint < 4
              ? "#ff91aa"
              : "#c5d9ff";
          context.fillStyle = context.strokeStyle;
          context.lineCap = "round";
          const trailTime = 0.026 + (1 - lifeRatio) * 0.058;
          const trailX = particle.x - particle.velocityX * trailTime;
          const trailY = particle.y - particle.velocityY * trailTime;
          if (particle.shape > 0.82) {
            const angle = Math.atan2(particle.velocityY, particle.velocityX);
            const shardLength = 4 + particle.size * (3.2 + (1 - lifeRatio) * 4.6);
            const shardWidth = 0.7 + particle.size * 0.72;
            context.globalAlpha = alpha * 0.78;
            context.beginPath();
            context.moveTo(particle.x, particle.y);
            context.lineTo(
              particle.x - Math.cos(angle) * shardLength + Math.cos(angle + Math.PI / 2) * shardWidth,
              particle.y - Math.sin(angle) * shardLength + Math.sin(angle + Math.PI / 2) * shardWidth
            );
            context.lineTo(
              trailX - Math.cos(angle + Math.PI / 2) * shardWidth * 0.45,
              trailY - Math.sin(angle + Math.PI / 2) * shardWidth * 0.45
            );
            context.closePath();
            context.fill();
          } else {
            context.lineWidth = particle.size;
            context.beginPath();
            context.moveTo(particle.x, particle.y);
            context.lineTo(trailX, trailY);
            context.stroke();
          }
          if (particle.size > 1.35 && lifeRatio > 0.16) {
            context.globalAlpha = alpha * 0.44;
            context.beginPath();
            context.arc(particle.x, particle.y, particle.size * 0.44, 0, Math.PI * 2);
            context.fill();
          }
        }

        const rainLimit = width < 640 ? 130 : 230;
        const rainDrive = rainBuild * (1 - rainStop);
        if (!reducedMotion && rainDrive > 0.001) {
          rainEmissionBudget += frameSeconds * (18 + rainDrive * 132) * densityScale;
          while (rainEmissionBudget >= 1 && rainParticles.length < rainLimit) {
            rainEmissionBudget -= 1;
            const angle = nextParticleRandom() * Math.PI * 2;
            const radius = nextParticleRandom() * Math.min(width, height) * (0.08 + rainBuild * 0.24);
            const outwardSpeed = 20 + nextParticleRandom() * (54 + rainBuild * 68);
            rainParticles.push({
              x: originX + Math.cos(angle) * radius,
              y: originY + Math.sin(angle) * radius * 0.72,
              previousX: originX,
              previousY: originY,
              velocityX: Math.cos(angle) * outwardSpeed + (nextParticleRandom() - 0.5) * 46,
              velocityY: Math.sin(angle) * outwardSpeed * 0.62 - 34 - nextParticleRandom() * 96,
              age: 0,
              life: 3.1 + nextParticleRandom() * 3.2,
              gravity: 30 + nextParticleRandom() * 48,
              size: 0.5 + nextParticleRandom() * 1.55,
              phase: nextParticleRandom() * Math.PI * 2,
              tint: Math.floor(nextParticleRandom() * 7)
            });
          }
        } else {
          rainEmissionBudget = Math.min(rainEmissionBudget, 0.95);
        }

        for (let index = rainParticles.length - 1; index >= 0; index -= 1) {
          const particle = rainParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life) {
            rainParticles.splice(index, 1);
            continue;
          }
          particle.previousX = particle.x;
          particle.previousY = particle.y;
          const lifeRatio = particle.age / particle.life;
          particle.velocityX *= Math.exp(-frameSeconds * 0.34);
          particle.velocityX += Math.sin(particle.phase + particle.age * 1.1) * frameSeconds * 5.2;
          particle.velocityY += particle.gravity * frameSeconds;
          particle.x += particle.velocityX * frameSeconds;
          particle.y += particle.velocityY * frameSeconds;
          if (particle.y > height + 90 || particle.x < -90 || particle.x > width + 90) {
            rainParticles.splice(index, 1);
            continue;
          }

          const fadeIn = smoothstep(clamp(particle.age / 0.12, 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeRatio - 0.56) / 0.44, 0, 1));
          const alpha = fadeIn * fadeOut * (0.26 + particle.size * 0.19);
          context.globalAlpha = alpha;
          context.strokeStyle = particle.tint === 0
            ? "#ffffff"
            : particle.tint < 4
              ? "#ff9caf"
              : "#c9dcff";
          context.lineWidth = 0.45 + particle.size * 0.56;
          context.lineCap = "round";
          context.beginPath();
          context.moveTo(particle.previousX, particle.previousY);
          context.lineTo(
            particle.x - particle.velocityX * frameSeconds * 0.18,
            particle.y - Math.max(2, particle.velocityY * frameSeconds * (0.38 + lifeRatio * 0.42))
          );
          context.stroke();
          if (lifeRatio > 0.28) {
            context.globalAlpha = alpha * 0.32;
            context.fillStyle = context.strokeStyle;
            context.beginPath();
            context.arc(particle.x, particle.y, particle.size * 0.34, 0, Math.PI * 2);
            context.fill();
          }
        }

        if (afterglow > 0.001) {
          const afterglowRadius = Math.min(maxRadius * 0.5, 120 + afterglow * Math.min(width, height) * 0.48);
          const glow = context.createRadialGradient(originX, originY, 0, originX, originY, afterglowRadius);
          glow.addColorStop(0, "rgba(255,247,251,0.2)");
          glow.addColorStop(0.24, "rgba(255,114,148,0.12)");
          glow.addColorStop(0.66, "rgba(143,178,255,0.055)");
          glow.addColorStop(1, "rgba(143,178,255,0)");
          context.globalAlpha = afterglow * 0.72;
          context.fillStyle = glow;
          context.fillRect(0, 0, width, height);
        }

        context.restore();
      };

      const updateBurstPresentation = (timestamp, advanceCharge = true) => {
        const fill = clamp(energyProgress, 0, 1);
        const burst = clamp(burstProgress, 0, 1);
        const crossBuildLinear = clamp((burst - crossStart) / (crossBuildEnd - crossStart), 0, 1);
        const crossFlashLinear = clamp((burst - crossBuildEnd) / (crossFlashEnd - crossBuildEnd), 0, 1);
        const crossReleaseLinear = clamp((burst - crossFlashEnd) / (crossEnd - crossFlashEnd), 0, 1);
        const crossBuild = 1 - Math.pow(1 - crossBuildLinear, 3.2);
        const crossFlash = smoothstep(crossFlashLinear);
        const crossCollapse = Math.pow(crossReleaseLinear, 3.4);
        const releaseFlash = Math.pow(Math.sin(crossReleaseLinear * Math.PI), 1.45);
        const reform = phaseProgress(burst, crossEnd, reformEnd);
        const pressure = phaseProgress(burst, 0.7, 0.94);
        const detonation = phaseProgress(burst, detonationStart, detonationEnd);
        const detonationRush = 1 - Math.pow(1 - detonation, 2.6);
        const rainProgress = phaseProgress(burst, rainStart, rainPeak);
        const blurRecovery = phaseProgress(burst, detonationEnd, 1);
        const burstActive = burst > 0.001 && burst < 0.999;
        if (advanceCharge) {
          const frameSeconds = poseTimestamp
            ? clamp((timestamp - poseTimestamp) / 1000, 0.008, 0.06)
            : 1 / 60;
          poseTimestamp = timestamp;
          const atInitialState = fill <= 0.0005
            && targetProgress <= 0.0005
            && Math.abs(velocity) <= 0.0005
            && targetBurstProgress <= 0.0005
            && Math.abs(burstVelocity) <= 0.0005
            && burst <= 0.0005;
          if (atInitialState) {
            chargeInstability = 0;
            poseClock = 0;
            poseTimestamp = timestamp;
            poseAtRest = true;
          } else {
            if (poseAtRest) {
              poseClock = 0;
              chargeInstability = 0;
              poseAtRest = false;
            }
            poseClock += frameSeconds;
            const instabilityTarget = Math.pow(fill, 0.86);
            const instabilityResponse = instabilityTarget < chargeInstability ? 10.8 : 5.4;
            chargeInstability += (instabilityTarget - chargeInstability) * (1 - Math.exp(-frameSeconds * instabilityResponse));
          }
        }
        const time = poseClock;
        const instability = 0.28 + chargeInstability * 1.72;
        const floatFrequency = 0.68 + chargeInstability * 1.9;
        const floatAmplitudeX = 1.6 + instability * 5.5;
        const floatAmplitudeY = 1.25 + instability * 4.25;
        const floatX = Math.sin(time * floatFrequency) * floatAmplitudeX
          + Math.cos(time * floatFrequency * 0.61 + 1.7) * floatAmplitudeX * 0.42
          + Math.sin(time * (0.37 + chargeInstability * 0.7) + 2.4) * floatAmplitudeX * 0.24;
        const floatY = Math.cos(time * floatFrequency * 0.84 + 0.6) * floatAmplitudeY
          + Math.sin(time * floatFrequency * 0.47) * floatAmplitudeY * 0.36
          + Math.cos(time * (0.29 + chargeInstability * 0.58) + 0.9) * floatAmplitudeY * 0.22;
        const floatAngle = Math.sin(time * (0.58 + chargeInstability * 1.8) + 1.2) * (0.28 + instability * 0.86)
          + Math.cos(time * (0.31 + chargeInstability * 0.9)) * (0.16 + instability * 0.42);
        const jitterAmount = 0.14 + chargeInstability * 1.55;
        const jitterX = Math.sin(time * (8.4 + chargeInstability * 8.8) + 0.7) * jitterAmount;
        const jitterY = Math.cos(time * (10.1 + chargeInstability * 10.6) + 1.5) * jitterAmount * 0.62;
        const burstStrength = burstActive
          ? (1.1 + pressure * 6.2 + detonationRush * 22) * (0.2 + pressure * 0.8)
          : 0;
        const detonationShakeX = detonationRush > 0.001
          ? Math.sin(time * (42 + detonationRush * 58)) * (1.4 + detonationRush * 11)
            + Math.cos(time * (27 + detonationRush * 42) + 0.8) * detonationRush * 4.5
          : 0;
        const detonationShakeY = detonationRush > 0.001
          ? Math.cos(time * (49 + detonationRush * 64) + 1.2) * (1 + detonationRush * 8)
            + Math.sin(time * (31 + detonationRush * 48)) * detonationRush * 3.2
          : 0;
        const shakeX = floatX + jitterX
          + Math.sin(time * (18 + pressure * 36 + detonationRush * 34)) * burstStrength
          + detonationShakeX;
        const shakeY = floatY + jitterY
          + Math.cos(time * (24 + pressure * 44 + detonationRush * 42)) * burstStrength * 0.62
          + detonationShakeY;
        const beamLift = 0;
        const beamScaleX = burst > 0.001
          ? (reform > 0 ? 0.16 + reform * 0.84 : 1) * (1 + detonationRush * 0.12)
          : 1;
        const beamScaleY = burst > 0.001
          ? 1 + reform * 0.32 + pressure * 0.62 + detonationRush * 1.6
          : 1;
        const beamAngle = floatAngle - reform * 8.5 - detonationRush * 17;
        const anchorProgress = phaseProgress(burst, crossFlashEnd, crossEnd);
        let beamAnchorX = 0;
        let beamAnchorY = 0;
        if (meterShell && title && anchorProgress > 0.0005) {
          const gateRect = gate.getBoundingClientRect();
          const meterWidth = meterShell.clientWidth;
          const meterHeight = meterShell.clientHeight;
          const frontRadius = 5 + fill * 22;
          const localFrontX = clamp(meterWidth * fill, 3, Math.max(3, meterWidth - frontRadius * 2.2));
          const headOffset = (localFrontX - meterWidth * 0.5) * beamScaleX;
          const angleRadians = beamAngle * Math.PI / 180;
          const rotatedHeadX = Math.cos(angleRadians) * headOffset;
          const rotatedHeadY = Math.sin(angleRadians) * headOffset;
          const meterCenterX = meterShell.offsetLeft + meterWidth * 0.5 - gateRect.left;
          const meterCenterY = meterShell.offsetTop + meterHeight * 0.5 - gateRect.top;
          const crossRect = cross?.getBoundingClientRect();
          const titleRect = title.getBoundingClientRect();
          const crossCenterX = (crossRect ? crossRect.left + crossRect.width * 0.5 : titleRect.left + titleRect.width * 0.5) - gateRect.left;
          const crossCenterY = (crossRect ? crossRect.top + crossRect.height * 0.5 : titleRect.top + titleRect.height * 0.5) - gateRect.top;
          beamAnchorX = (crossCenterX - meterCenterX - rotatedHeadX) * anchorProgress;
          beamAnchorY = (crossCenterY - meterCenterY - rotatedHeadY - beamLift) * anchorProgress;
        }
        const fadeOut = phaseProgress(burst, 0.015, 0.13);
        const beamOpacity = burst <= 0.001 ? 1 : clamp(1 - fadeOut, 0, 1);
        const preBlastBlur = phaseProgress(burst, glossFadeEnd, crossStart + 0.04)
          * (1 - phaseProgress(burst, crossEnd, reformEnd)) * 4.8;
        const gravityBlur = phaseProgress(burst, crossEnd, 0.86)
          * (1 - phaseProgress(burst, detonationEnd, 1)) * 6.8;
        const impactBlur = pressure * 2.2 + detonationRush * 11;
        const performanceBlur = preBlastBlur + gravityBlur + impactBlur * (1 - blurRecovery);
        const crossPulse = 0.5 + 0.5 * Math.sin(time * (10 + crossFlash * 19) + Math.sin(time * 2.1));
        const crossStrobe = clamp(crossFlash * (0.42 + crossPulse * 0.64) + releaseFlash * 1.18, 0, 1.35);
        const crossRayProgress = clamp(crossBuild * (1 - crossCollapse), 0, 1);
        const crossRayBreath = 0.72 + crossBuild * 0.28 + crossStrobe * 0.22;
        const crossRingProgress = crossReleaseLinear;
        const crossRingOpacity = clamp(releaseFlash * (0.68 + crossPulse * 0.32), 0, 1);
        const crossShardProgress = clamp((crossBuild * 0.46 + crossFlash * 0.54) * (1 - crossCollapse), 0, 1);
        const crossShardOpacity = clamp(crossFlash * (0.24 + crossPulse * 0.62) * (1 - crossReleaseLinear) + releaseFlash * 0.28, 0, 1);
        const crossSparkProgress = clamp(crossFlash * (1 - crossReleaseLinear) + releaseFlash * 0.26, 0, 1);
        const crossSparkOpacity = clamp(Math.sin(crossFlashLinear * Math.PI) * 0.82 * (1 - crossReleaseLinear) + releaseFlash * 0.34, 0, 1);
        const crossSparkDistance = crossSparkProgress * Math.min(168, gate.clientWidth * 0.14);
        const crossCoreOpacity = clamp(crossBuild * 0.52 + crossFlash * 0.2 + releaseFlash * 0.98, 0, 1);
        const crossCoreScale = 0.16 + crossBuild * 0.46 + crossFlash * 0.14 + releaseFlash * 0.76 + crossCollapse * 0.12;
        const crossOpacity = clamp(
          crossBuild * (1 - crossReleaseLinear) * (0.68 + crossPulse * 0.24) + releaseFlash * 0.86,
          0,
          1
        );
        const crossScale = 0.68 + crossBuild * 0.22 + crossFlash * 0.08 - crossCollapse * 0.14 + releaseFlash * 0.12;
        const crossRotation = -18
          + crossBuild * 44
          + crossFlashLinear * 104
          + crossReleaseLinear * 68
          + Math.sin(time * (8 + crossFlash * 18)) * (0.7 + crossStrobe * 3.8);
        const crossShakeX = Math.sin(time * (16 + crossFlash * 28)) * (0.35 + crossStrobe * 2.6 + releaseFlash * 2.2);
        const crossShakeY = Math.cos(time * (19 + crossFlash * 31)) * (0.3 + crossStrobe * 2.1 + releaseFlash * 1.8);
        beamPose = {
          shakeX,
          shakeY,
          anchorX: beamAnchorX,
          anchorY: beamAnchorY,
          lift: beamLift,
          scaleX: beamScaleX,
          scaleY: beamScaleY,
          angle: beamAngle
        };
        meterShell?.style.setProperty("--kisara-beam-shake-x", `${shakeX.toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-shake-y", `${shakeY.toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-anchor-x", `${beamAnchorX.toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-anchor-y", `${beamAnchorY.toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-lift", `${beamLift.toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-expansion", beamScaleY.toFixed(4));
        meterShell?.style.setProperty("--kisara-beam-scale-x", beamScaleX.toFixed(4));
        meterShell?.style.setProperty("--kisara-beam-scale-y", beamScaleY.toFixed(4));
        meterShell?.style.setProperty("--kisara-beam-angle", `${beamAngle.toFixed(3)}deg`);
        meterShell?.style.setProperty("--kisara-beam-opacity", beamOpacity.toFixed(3));
        meterShell?.style.setProperty("--kisara-beam-glow", `${(pressure * 12 + detonationRush * 45).toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-brightness", (1 + pressure * 0.16 + detonationRush * 0.62).toFixed(3));
        gate.style.setProperty("--kisara-performance-blur", `${performanceBlur.toFixed(3)}px`);
        gate.style.setProperty("--kisara-cross-opacity", crossOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-ray-progress", crossRayProgress.toFixed(4));
        gate.style.setProperty("--kisara-cross-ray-breath", crossRayBreath.toFixed(3));
        gate.style.setProperty("--kisara-cross-core-scale", crossCoreScale.toFixed(3));
        gate.style.setProperty("--kisara-cross-core-opacity", crossCoreOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-ring-progress", crossRingProgress.toFixed(3));
        gate.style.setProperty("--kisara-cross-ring-opacity", crossRingOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-shard-progress", crossShardProgress.toFixed(4));
        gate.style.setProperty("--kisara-cross-shard-opacity", crossShardOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-spark-opacity", crossSparkOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-spark-distance", `${crossSparkDistance.toFixed(3)}px`);
        gate.style.setProperty("--kisara-cross-strobe", crossStrobe.toFixed(3));
        gate.style.setProperty("--kisara-cross-scale", crossScale.toFixed(3));
        gate.style.setProperty("--kisara-cross-rotation", `${crossRotation.toFixed(3)}deg`);
        gate.style.setProperty("--kisara-cross-shake-x", `${crossShakeX.toFixed(3)}px`);
        gate.style.setProperty("--kisara-cross-shake-y", `${crossShakeY.toFixed(3)}px`);
        gate.style.setProperty("--kisara-cross-blur", `${(0.08 + crossStrobe * 0.42 + releaseFlash * 0.5).toFixed(3)}px`);
      };

      const updateGlitchState = (timestamp) => {
        if (!state) return;
        const fillComplete = targetProgress >= 0.9995 && progress >= 0.999 && Math.abs(velocity) < 0.001;
        if (!fillComplete) {
          renderedGlitchTick = -1;
          return;
        }
        const tick = Math.floor(timestamp / 72);
        if (tick === renderedGlitchTick) return;
        const burstComplete = targetBurstProgress >= 0.9995
          && burstProgress >= 0.999
          && Math.abs(burstVelocity) < 0.001
          && burstAutoplayComplete;
        state.textContent = makeGlitchState(timestamp, burstProgress, burstComplete);
        renderedGlitchTick = tick;
      };

      const drawEnergy = (timestamp) => {
        energyFrame = 0;
        if (!energyCanvas || !energyContext) return;
        resizeEnergyCanvas();
        updateBurstPresentation(timestamp);
        updateGlitchState(timestamp);
        const width = energyCanvasWidth;
        const height = energyCanvasHeight;
        energyContext.clearRect(0, 0, width, height);
        drawScreenEnergy(timestamp);
        if (width <= 1 || height <= 1) return;

        const fill = Math.max(energyProgress, 0.012);
        const time = timestamp / 1000;
        const centerY = height / 2;
        const fadeOut = phaseProgress(burstProgress, 0.015, 0.13);
        const localBeamOpacity = burstProgress <= 0.001 ? 1 : clamp(1 - fadeOut, 0, 1);
        const intensity = 0.12 + fill * 0.88;
        const startThickness = 0.7 + fill * 1.45;
        const endThickness = 2.4 + fill * 31;
        const frontRadius = 4.5 + fill * 21;
        const frontX = clamp(width * fill, 3, Math.max(3, width - frontRadius * 2.05));
        const noseLength = Math.min(34, Math.max(5, frontRadius * 0.9 + frontX * 0.035));
        const bodyEndX = Math.max(1, frontX - noseLength);
        const context = energyContext;

        if (localBeamOpacity <= 0.001) {
          if (!reducedMotion && document.visibilityState === "visible" && pageMode === "gate") {
            energyFrame = window.requestAnimationFrame(drawEnergy);
          }
          return;
        }

        const thicknessAt = (x) => {
          const unit = clamp(x / Math.max(bodyEndX, 1), 0, 1);
          const tailEase = smoothstep(clamp(unit / 0.62, 0, 1));
          const cone = startThickness * 0.26
            + (endThickness - startThickness * 0.26) * Math.pow(unit, 1.16);
          const breathing = 1 + Math.sin(unit * Math.PI * 2.15 - time * 2.05) * (0.008 + fill * 0.01);
          return cone * (0.78 + tailEase * 0.22) * breathing;
        };

        const traceBeamEnvelope = () => {
          const segments = Math.max(36, Math.min(96, Math.ceil(bodyEndX / 5.5)));
          context.beginPath();
          for (let segment = 0; segment <= segments; segment += 1) {
            const x = bodyEndX * segment / segments;
            const unit = x / Math.max(bodyEndX, 1);
            const localThickness = thicknessAt(x);
            const ripple = (
              Math.sin(unit * Math.PI * 4.1 - time * 3.15)
              + Math.sin(unit * Math.PI * 9.2 + time * 1.76 + 0.7) * 0.28
            ) * localThickness * (0.012 + fill * 0.012);
            const y = centerY - localThickness - ripple;
            if (segment === 0) context.moveTo(x, y);
            else context.lineTo(x, y);
          }
          context.bezierCurveTo(
            bodyEndX + noseLength * 0.46,
            centerY - endThickness * 0.96,
            frontX - frontRadius * 0.12,
            centerY - frontRadius * 0.52,
            frontX,
            centerY
          );
          context.bezierCurveTo(
            frontX - frontRadius * 0.12,
            centerY + frontRadius * 0.52,
            bodyEndX + noseLength * 0.46,
            centerY + endThickness * 0.96,
            bodyEndX,
            centerY + thicknessAt(bodyEndX)
          );
          for (let segment = segments - 1; segment >= 0; segment -= 1) {
            const x = bodyEndX * segment / segments;
            const unit = x / Math.max(bodyEndX, 1);
            const localThickness = thicknessAt(x);
            const ripple = (
              Math.sin(unit * Math.PI * 3.85 + time * 2.88 + 1.1)
              + Math.cos(unit * Math.PI * 8.7 - time * 1.92) * 0.26
            ) * localThickness * (0.012 + fill * 0.012);
            context.lineTo(x, centerY + localThickness + ripple);
          }
          context.closePath();
        };

        context.save();
        context.globalCompositeOperation = "lighter";
        const beamGradient = context.createLinearGradient(0, 0, frontX, 0);
        beamGradient.addColorStop(0, "rgba(100, 150, 255, 0)");
        beamGradient.addColorStop(0.1, "rgba(112, 161, 255, 0.025)");
        beamGradient.addColorStop(0.34, "rgba(147, 187, 255, 0.24)");
        beamGradient.addColorStop(0.62, "rgba(255, 108, 150, 0.7)");
        beamGradient.addColorStop(0.84, "rgba(255, 191, 211, 0.94)");
        beamGradient.addColorStop(1, "rgba(255, 255, 255, 0.99)");

        traceBeamEnvelope();
        context.globalAlpha = localBeamOpacity * intensity * 0.16;
        context.fillStyle = beamGradient;
        context.shadowColor = "rgba(255, 83, 127, 0.88)";
        context.shadowBlur = 24 + fill * 22;
        context.fill();

        traceBeamEnvelope();
        context.globalAlpha = localBeamOpacity * intensity * 0.82;
        context.shadowColor = "rgba(255, 124, 158, 0.92)";
        context.shadowBlur = 7 + fill * 10;
        context.fill();

        context.save();
        traceBeamEnvelope();
        context.clip();
        context.shadowBlur = 0;

        const coreGradient = context.createLinearGradient(0, 0, frontX, 0);
        coreGradient.addColorStop(0, "rgba(170, 204, 255, 0)");
        coreGradient.addColorStop(0.3, "rgba(183, 211, 255, 0.12)");
        coreGradient.addColorStop(0.72, "rgba(255, 191, 211, 0.34)");
        coreGradient.addColorStop(1, "rgba(255, 255, 255, 0.72)");
        context.globalAlpha = localBeamOpacity * intensity;
        context.fillStyle = coreGradient;
        context.fillRect(0, 0, frontX, height);

        for (let strand = 0; strand < 8; strand += 1) {
          const strandGradient = context.createLinearGradient(0, 0, frontX, 0);
          strandGradient.addColorStop(0, "rgba(166, 201, 255, 0)");
          strandGradient.addColorStop(0.24, "rgba(174, 207, 255, 0.18)");
          strandGradient.addColorStop(0.7, "rgba(255, 143, 172, 0.74)");
          strandGradient.addColorStop(0.94, "rgba(255, 244, 248, 0.9)");
          strandGradient.addColorStop(1, "rgba(255, 255, 255, 0)");
          context.beginPath();
          const segments = Math.max(40, Math.min(104, Math.ceil(bodyEndX / 5)));
          for (let segment = 0; segment <= segments; segment += 1) {
            const x = bodyEndX * segment / segments;
            const unit = x / Math.max(bodyEndX, 1);
            const localThickness = thicknessAt(x) * 0.82;
            const mainPhase = unit * Math.PI * (2.35 + strand * 0.31)
              - time * (2.9 + strand * 0.23)
              + strand * 0.93;
            const secondaryPhase = unit * Math.PI * (7.1 + strand * 0.17)
              + time * (1.25 + strand * 0.09)
              + strand * 0.47;
            const offset = (strand - 3.5) * localThickness * 0.085;
            const y = centerY
              + Math.sin(mainPhase) * localThickness * (0.17 + strand % 2 * 0.025)
              + Math.sin(secondaryPhase) * localThickness * 0.045
              + offset;
            if (segment === 0) context.moveTo(x, y);
            else context.lineTo(x, y);
          }
          context.globalAlpha = localBeamOpacity * intensity * (strand === 3 || strand === 4 ? 0.74 : 0.32);
          context.strokeStyle = strandGradient;
          context.lineWidth = strand === 3 || strand === 4 ? 1 + fill * 2.2 : 0.52 + fill * 0.82;
          context.lineCap = "round";
          context.stroke();
        }

        const headCoreX = frontX - frontRadius * 0.48;
        const headGlow = context.createRadialGradient(headCoreX, centerY, 0, headCoreX, centerY, frontRadius * 1.35);
        headGlow.addColorStop(0, "rgba(255, 255, 255, 0.98)");
        headGlow.addColorStop(0.24, "rgba(255, 244, 248, 0.9)");
        headGlow.addColorStop(0.62, "rgba(255, 104, 145, 0.36)");
        headGlow.addColorStop(1, "rgba(255, 86, 128, 0)");
        context.globalAlpha = localBeamOpacity * intensity;
        context.fillStyle = headGlow;
        context.fillRect(headCoreX - frontRadius * 1.35, centerY - frontRadius * 1.35, frontRadius * 2.7, frontRadius * 2.7);
        context.restore();

        const auraGlow = context.createRadialGradient(
          frontX - frontRadius * 0.34,
          centerY,
          frontRadius * 0.12,
          frontX - frontRadius * 0.34,
          centerY,
          frontRadius * 1.7
        );
        auraGlow.addColorStop(0, "rgba(255, 250, 252, 0.34)");
        auraGlow.addColorStop(0.42, "rgba(255, 105, 145, 0.16)");
        auraGlow.addColorStop(1, "rgba(255, 91, 131, 0)");
        context.globalAlpha = localBeamOpacity * intensity * 0.72;
        context.fillStyle = auraGlow;
        context.beginPath();
        context.arc(frontX - frontRadius * 0.34, centerY, frontRadius * 1.7, 0, Math.PI * 2);
        context.fill();

        context.restore();

        if (!reducedMotion && document.visibilityState === "visible" && pageMode === "gate") {
          energyFrame = window.requestAnimationFrame(drawEnergy);
        }
      };

      const startEnergyAnimation = () => {
        if (!energyContext || pageMode !== "gate") return;
        if (reducedMotion) {
          drawEnergy(performance.now());
          return;
        }
        if (!energyFrame && document.visibilityState === "visible") {
          energyFrame = window.requestAnimationFrame(drawEnergy);
        }
      };

      const render = () => {
        const fill = clamp(progress, 0, 1);
        const percent = Math.round(progress * 100);
        const fillComplete = targetProgress >= 0.9995 && fill >= 0.999 && Math.abs(velocity) < 0.001;
        const burstComplete = fillComplete
          && targetBurstProgress >= 0.9995
          && burstProgress >= 0.999
          && Math.abs(burstVelocity) < 0.001
          && burstAutoplayComplete;
        const tideVisible = fill > 0.0005;
        const reveal = smoothstep(clamp((fill - 0.025) / 0.975, 0, 1));
        const glossSweep = phaseProgress(burstProgress, 0.01, 0.3);
        const glossPosition = -18 + glossSweep * 136;
        const glossOpacity = Math.sin(glossSweep * Math.PI) * (1 - phaseProgress(burstProgress, 0.3, glossFadeEnd)) * 0.98;
        const crestOpacity = fill <= 0.002 || fill >= 0.998
          ? 0
          : Math.min(0.92, 0.54 + Math.abs(velocity) * 42);
        const crestDrift = clamp(velocity * 820, -4.5, 4.5);

        gate.style.setProperty("--kisara-fill", `${(fill * 100).toFixed(3)}%`);
        gate.style.setProperty("--kisara-burst-progress", `${(burstProgress * 100).toFixed(3)}%`);
        gate.style.setProperty("--kisara-gloss-position", `${glossPosition.toFixed(3)}%`);
        gate.style.setProperty("--kisara-gloss-opacity", glossOpacity.toFixed(3));
        gate.style.setProperty("--kisara-tide-opacity", tideVisible ? "1" : "0");
        gate.style.setProperty("--kisara-crest-opacity", crestOpacity.toFixed(3));
        gate.style.setProperty("--kisara-crest-drift", `${crestDrift.toFixed(3)}px`);
        gate.style.setProperty("--kisara-bg-blur", `${(reveal * 12).toFixed(3)}px`);
        gate.style.setProperty("--kisara-bg-opacity", (0.98 - reveal * 0.66).toFixed(3));
        gate.style.setProperty("--kisara-bg-saturation", (1 - reveal * 0.26).toFixed(3));
        gate.style.setProperty("--kisara-bg-brightness", (1 - reveal * 0.14).toFixed(3));
        gate.style.setProperty("--kisara-fight-opacity", (reveal * 0.98).toFixed(3));
        gate.style.setProperty("--kisara-fight-blur", `${((1 - reveal) * 15).toFixed(3)}px`);
        gate.style.setProperty("--kisara-fight-scale", (1.06 - reveal * 0.06).toFixed(4));
        gate.style.setProperty("--kisara-fight-saturation", (0.84 + reveal * 0.36).toFixed(3));
        gate.style.setProperty("--kisara-fight-brightness", (0.86 + reveal * 0.22).toFixed(3));
        energyProgress = fill;
        updateBurstPresentation(performance.now(), false);
        startEnergyAnimation();
        const stage = fillComplete ? "glitch" : "contract";
        const glitchTick = fillComplete ? Math.floor(performance.now() / 72) : -1;
        if (state && (percent !== renderedPercent || stage !== renderedStage || glitchTick !== renderedGlitchTick)) {
          state.textContent = fillComplete
            ? makeGlitchState(performance.now(), burstProgress, burstComplete)
            : `CONTRACT ${String(percent).padStart(3, "0")}%`;
          renderedPercent = percent;
          renderedStage = stage;
          renderedGlitchTick = glitchTick;
        }
        gate.classList.toggle("is-complete", fillComplete);
        gate.classList.toggle("is-bursting", burstProgress > 0.001 && !burstComplete);
        gate.classList.toggle("is-burst-complete", burstComplete);
        gate.classList.toggle("is-released", pageMode === "next");
        gate.classList.toggle("is-receding", velocity < -0.0003);
        if (cue) {
          cue.textContent = burstAutoplay
            ? "AUTOMATIC RELEASE / STAND BY"
            : burstComplete
            ? "SIGNAL RELEASED / CONTINUE"
            : fillComplete
              ? "OVERCHARGE / BREAK THE SEAL"
              : "SCROLL / SIGN THE CONTRACT";
        }
      };

      const startReleaseAutoplay = (timestamp) => {
        if (burstAutoplay || burstAutoplayComplete) return;
        burstAutoplay = true;
        burstAutoplayStartedAt = timestamp;
        targetBurstProgress = 1;
        burstProgress = Math.max(crossEnd, burstProgress);
        burstVelocity = 0;
      };

      const animate = (timestamp) => {
        animationFrame = 0;
        const frameRatio = lastFrameTime
          ? clamp((timestamp - lastFrameTime) / 16.667, 0.5, 3)
          : 1;
        lastFrameTime = timestamp;
        const spring = (targetProgress - progress) * springStrength * frameRatio;
        velocity = (velocity + spring) * Math.pow(damping, frameRatio);
        progress = clamp(progress + velocity * frameRatio, 0, 1);
        if (burstAutoplay) {
          const autoplayProgress = clamp((timestamp - burstAutoplayStartedAt) / releaseAutoplayDuration, 0, 1);
          burstProgress = crossEnd + (1 - crossEnd) * autoplayProgress;
          targetBurstProgress = 1;
          burstVelocity = 0;
          if (autoplayProgress >= 1) {
            burstAutoplay = false;
            burstAutoplayComplete = true;
            burstProgress = 1;
          }
        } else {
          const burstSpring = (targetBurstProgress - burstProgress) * burstSpringStrength * frameRatio;
          burstVelocity = (burstVelocity + burstSpring) * Math.pow(burstDamping, frameRatio);
          burstProgress = clamp(burstProgress + burstVelocity * frameRatio, 0, 1);
          if (
            !burstAutoplayComplete
            && targetBurstProgress >= crossEnd - 0.0005
            && burstProgress >= crossEnd - 0.0007
          ) {
            startReleaseAutoplay(timestamp);
          }
        }

        const settled = !burstAutoplay
          && Math.abs(targetProgress - progress) < settleDistance
          && Math.abs(velocity) < settleDistance
          && Math.abs(targetBurstProgress - burstProgress) < settleDistance
          && Math.abs(burstVelocity) < settleDistance;
        if (settled) {
          progress = targetProgress;
          velocity = 0;
          burstProgress = targetBurstProgress;
          burstVelocity = 0;
          lastFrameTime = 0;
          render();
          return;
        }

        render();
        animationFrame = window.requestAnimationFrame(animate);
      };

      const startAnimation = () => {
        if (!animationFrame) {
          lastFrameTime = 0;
          animationFrame = window.requestAnimationFrame(animate);
        }
      };

      const getNextPageTop = () => {
        const openingRect = opening?.getBoundingClientRect();
        return Math.max(1, Math.round((openingRect?.top ?? gate.getBoundingClientRect().height) + window.scrollY));
      };

      const setScrollPosition = (value) => {
        window.scrollTo(0, clamp(value, 0, Math.max(0, document.documentElement.scrollHeight - window.innerHeight)));
      };

      const smoothScrollTo = (target, onComplete, onProgress) => {
        if (scrollFrame) return;
        const destination = Math.max(0, target);
        if (reducedMotion) {
          setScrollPosition(destination);
          onProgress?.(1);
          onComplete?.();
          return;
        }
        const root = document.documentElement;
        const previousScrollBehavior = root.style.scrollBehavior;
        root.style.scrollBehavior = "auto";
        let current = window.scrollY;
        let velocity = 0;
        let lastTimestamp = performance.now();
        const initialDistance = Math.max(1, Math.abs(destination - current));
        const stiffness = 38;
        const dampingForce = 11.8;
        const maxVelocity = clamp(Math.abs(destination - current) * 2.4, 620, 1900);

        const finish = () => {
          setScrollPosition(destination);
          onProgress?.(1);
          root.style.scrollBehavior = previousScrollBehavior;
          scrollFrame = 0;
          onComplete?.();
        };

        const step = (timestamp) => {
          const deltaTime = clamp((timestamp - lastTimestamp) / 1000, 0.008, 0.034);
          lastTimestamp = timestamp;
          const distance = destination - current;
          const acceleration = distance * stiffness - velocity * dampingForce;
          velocity = clamp(velocity + acceleration * deltaTime, -maxVelocity, maxVelocity);
          current += velocity * deltaTime;
          setScrollPosition(current);
          onProgress?.(clamp(1 - Math.abs(destination - current) / initialDistance, 0, 1));
          if (Math.abs(distance) < 0.35 && Math.abs(velocity) < 8) {
            finish();
            return;
          }
          scrollFrame = window.requestAnimationFrame(step);
        };

        scrollFrame = window.requestAnimationFrame(step);
      };

      const resetGateState = () => {
        if (animationFrame) window.cancelAnimationFrame(animationFrame);
        if (energyFrame) window.cancelAnimationFrame(energyFrame);
        animationFrame = 0;
        energyFrame = 0;
        lastFrameTime = 0;
        targetProgress = 0;
        progress = 0;
        velocity = 0;
        targetBurstProgress = 0;
        burstProgress = 0;
        burstVelocity = 0;
        burstAutoplay = false;
        burstAutoplayComplete = false;
        burstAutoplayStartedAt = 0;
        energyProgress = 0;
        poseTimestamp = 0;
        poseClock = 0;
        poseAtRest = true;
        chargeInstability = 0;
        screenParticleTimestamp = 0;
        particleSerial = 0;
        wakeEmissionBudget = 0;
        orbitEmissionBudget = 0;
        rainEmissionBudget = 0;
        burstWaveMask = 0;
        wakeParticles.length = 0;
        orbitParticles.length = 0;
        burstParticles.length = 0;
        rainParticles.length = 0;
        beamPose = {
          shakeX: 0,
          shakeY: 0,
          anchorX: 0,
          anchorY: 0,
          lift: 0,
          scaleX: 1,
          scaleY: 1,
          angle: 0
        };
        renderedPercent = -1;
        renderedStage = "";
        renderedGlitchTick = -1;
        energyContext?.clearRect(0, 0, energyCanvasWidth, energyCanvasHeight);
        burstContext?.clearRect(0, 0, burstCanvasWidth, burstCanvasHeight);
        render();
      };

      const enterNextPage = () => {
        if (scrollFrame) return;
        pageMode = "snap";
        let resetApplied = false;
        gate.classList.remove("is-color-resetting");
        smoothScrollTo(getNextPageTop(), () => {
          if (!resetApplied) resetGateState();
          pageMode = "next";
          render();
          if (resetTransitionTimer) window.clearTimeout(resetTransitionTimer);
          resetTransitionTimer = window.setTimeout(() => {
            gate.classList.remove("is-color-resetting");
            resetTransitionTimer = 0;
          }, 260);
        }, (scrollProgress) => {
          if (scrollProgress >= 0.68) gate.classList.add("is-color-resetting");
          if (scrollProgress >= 0.86 && !resetApplied) {
            resetApplied = true;
            resetGateState();
          }
        });
      };

      const returnToGate = () => {
        if (scrollFrame) return;
        if (resetTransitionTimer) {
          window.clearTimeout(resetTransitionTimer);
          resetTransitionTimer = 0;
        }
        gate.classList.remove("is-color-resetting");
        pageMode = "snap";
        smoothScrollTo(0, () => {
          pageMode = "gate";
          render();
        });
      };

      const addProgress = (delta) => {
        if (burstAutoplay || burstAutoplayComplete) return;
        const boundedDelta = clamp(delta, -180, 180);
        const fillComplete = targetProgress >= 0.9995
          && progress >= 0.999
          && Math.abs(velocity) < 0.001;
        const burstInProgress = targetBurstProgress > 0.0005 || burstProgress > 0.0005;
        if ((delta > 0 && fillComplete) || (delta < 0 && burstInProgress)) {
          targetBurstProgress = clamp(targetBurstProgress + boundedDelta / burstDistance, 0, crossEnd);
          burstVelocity += boundedDelta / burstDistance * 0.045;
        } else {
          targetProgress = clamp(targetProgress + boundedDelta / fillDistance, 0, 1);
          velocity += boundedDelta / fillDistance * 0.03;
        }
        startAnimation();
      };

      const isFillComplete = () => targetProgress >= 0.9995
        && progress >= 0.999
        && Math.abs(velocity) < 0.001;

      const isComplete = () => isFillComplete()
        && targetBurstProgress >= 0.9995
        && burstProgress >= 0.999
        && Math.abs(burstVelocity) < 0.001
        && burstAutoplayComplete;

      const shouldCaptureGate = (delta) => {
        if (window.scrollY > 2 || delta === 0) return false;
        if (burstAutoplay) return true;
        if (delta > 0) return !isComplete();
        return targetBurstProgress > 0.0005
          || burstProgress > 0.0005
          || Math.abs(burstVelocity) > 0.0005
          || targetProgress > 0.0005
          || progress > 0.0005
          || Math.abs(velocity) > 0.0005;
      };

      const normalizeWheel = (event) => {
        if (event.deltaMode === WheelEvent.DOM_DELTA_LINE) return event.deltaY * 16;
        if (event.deltaMode === WheelEvent.DOM_DELTA_PAGE) return event.deltaY * window.innerHeight;
        return event.deltaY;
      };

      const handleDirectionalInput = (delta, event) => {
        if (delta === 0) return;
        if (scrollFrame) {
          event.preventDefault();
          return;
        }
        if (pageMode === "gate") {
          if (window.scrollY > 2) return;
          if (delta > 0 && isComplete()) {
            event.preventDefault();
            enterNextPage();
            return;
          }
          if (!shouldCaptureGate(delta)) return;
          event.preventDefault();
          addProgress(delta);
          return;
        }
        if (pageMode === "next" && delta < 0 && window.scrollY <= getNextPageTop() + Math.max(28, window.innerHeight * 0.08)) {
          event.preventDefault();
          returnToGate();
        }
      };

      window.addEventListener("wheel", (event) => {
        if (event.ctrlKey || event.metaKey) return;
        const delta = normalizeWheel(event);
        handleDirectionalInput(delta, event);
      }, { passive: false });

      window.addEventListener("keydown", (event) => {
        if (event.ctrlKey || event.metaKey || event.altKey) return;
        if (event.target instanceof Element && event.target.closest("a, button, input, select, textarea, [contenteditable='true']")) return;
        let amount = 0;
        if (event.key === "ArrowDown") amount = 130;
        if (event.key === "ArrowUp") amount = -130;
        if (["PageDown", "End"].includes(event.key)) amount = 300;
        if (["PageUp", "Home"].includes(event.key)) amount = -300;
        if (event.key === " ") amount = event.shiftKey ? -300 : 300;
        if (!amount) return;
        handleDirectionalInput(amount, event);
      });

      window.addEventListener("touchstart", (event) => {
        if (event.touches.length !== 1) {
          touchY = null;
          touchId = null;
          return;
        }
        touchId = event.touches[0]?.identifier ?? null;
        touchY = event.touches[0]?.clientY ?? null;
      }, { passive: true });

      window.addEventListener("touchmove", (event) => {
        if (event.touches.length !== 1 || touchId === null) return;
        const touch = Array.from(event.touches).find((item) => item.identifier === touchId);
        const nextY = touch?.clientY ?? null;
        if (touchY === null || nextY === null) return;
        const delta = touchY - nextY;
        touchY = nextY;
        const touchDelta = delta * 2.25;
        handleDirectionalInput(touchDelta, event);
      }, { passive: false });

      window.addEventListener("touchend", () => {
        touchY = null;
        touchId = null;
      }, { passive: true });

      window.addEventListener("touchcancel", () => {
        touchY = null;
        touchId = null;
      }, { passive: true });

      skip?.addEventListener("click", (event) => {
        event.preventDefault();
        if (animationFrame) window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
        lastFrameTime = 0;
        targetProgress = 1;
        progress = 1;
        velocity = 0;
        targetBurstProgress = 1;
        burstProgress = 1;
        burstVelocity = 0;
        burstAutoplay = false;
        burstAutoplayComplete = true;
        burstAutoplayStartedAt = 0;
        render();
        enterNextPage();
      });

      window.addEventListener("resize", () => {
        resizeEnergyCanvas();
        resizeBurstCanvas();
        startEnergyAnimation();
      }, { passive: true });
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") {
          if (energyFrame) window.cancelAnimationFrame(energyFrame);
          energyFrame = 0;
          screenParticleTimestamp = 0;
          return;
        }
        startEnergyAnimation();
      });

      render();
      const syncRestoredPosition = () => {
        if (!restoreWindowOpen || scrollFrame || pageMode !== "gate" || window.scrollY <= 2) return;
        pageMode = "next";
        resetGateState();
      };
      window.addEventListener("pageshow", syncRestoredPosition);
      window.addEventListener("scroll", syncRestoredPosition, { passive: true });
      window.requestAnimationFrame(() => window.requestAnimationFrame(() => {
        syncRestoredPosition();
        window.setTimeout(() => {
          syncRestoredPosition();
          restoreWindowOpen = false;
          window.removeEventListener("scroll", syncRestoredPosition);
        }, 420);
      }));
    })();
  </script>
</KisaraLayout>
