---
import KisaraLayout from "../layouts/KisaraLayout.astro";
import { getPublishedPosts } from "@/core/content/blog";
import { getThemePath } from "@/core/themes/registry";
import { existsSync } from "node:fs";
import { resolve } from "node:path";

const posts = (await getPublishedPosts()).slice(0, 3);
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
});

const backgroundExtensions = ["webp", "png", "jpg", "jpeg"];
const findThemeAsset = (baseName: string) => {
  const extension = backgroundExtensions.find((candidate) =>
    existsSync(resolve(`public/themes/kisara/assets/${baseName}.${candidate}`))
  );
  return extension ? `/themes/kisara/assets/${baseName}.${extension}` : null;
};
const activeBackgroundUrl = findThemeAsset("gate-background");
const activeFightUrl = findThemeAsset("fight");
const gateStyle = [
  "--kisara-fill: 0%",
  "--kisara-burst-progress: 0%",
  `--kisara-gate-background-image: ${activeBackgroundUrl ? `url("${activeBackgroundUrl}")` : "none"}`,
  `--kisara-fight-background-image: ${activeFightUrl ? `url("${activeFightUrl}")` : "none"}`
].join("; ");
---

<KisaraLayout title="Kisara | Yuimi Lab" description="Yuimi Lab 的 Kisara 视觉交互主题。">
  <section class="kisara-gate" data-kisara-gate style={gateStyle}>
    <div class="kisara-gate-visual" aria-hidden="true">
      <div class="kisara-gate-background kisara-gate-background-base"></div>
      <div class="kisara-gate-background kisara-gate-background-fight"></div>
      <div class="kisara-gate-atmosphere"></div>
      <canvas class="kisara-burst-canvas" data-kisara-burst-canvas width="1280" height="900"></canvas>
    </div>
    <p class="kisara-gate-index">YUIMI LAB / INTERACTION CHANNEL 03</p>
    <h1 class="kisara-title" aria-label="Kisara">
      <span class="kisara-title-base" aria-hidden="true">Kisara</span>
      <span class="kisara-title-tide" aria-hidden="true">Kisara</span>
      <span class="kisara-title-crest" aria-hidden="true">Kisara</span>
      <span class="kisara-title-gloss" aria-hidden="true">Kisara</span>
      <i class="kisara-title-cross" aria-hidden="true">
        <span class="kisara-cross-ring"></span>
        <span class="kisara-cross-ray kisara-cross-ray-north"></span>
        <span class="kisara-cross-ray kisara-cross-ray-east"></span>
        <span class="kisara-cross-ray kisara-cross-ray-south"></span>
        <span class="kisara-cross-ray kisara-cross-ray-west"></span>
        <span class="kisara-cross-shard kisara-cross-shard-a"></span>
        <span class="kisara-cross-shard kisara-cross-shard-b"></span>
        <span class="kisara-cross-shard kisara-cross-shard-c"></span>
        <span class="kisara-cross-shard kisara-cross-shard-d"></span>
        <span class="kisara-cross-spark kisara-cross-spark-a"></span>
        <span class="kisara-cross-spark kisara-cross-spark-b"></span>
        <span class="kisara-cross-spark kisara-cross-spark-c"></span>
        <span class="kisara-cross-spark kisara-cross-spark-d"></span>
        <span class="kisara-cross-core"></span>
      </i>
    </h1>
    <div class="kisara-contract-meter" aria-hidden="true">
      <canvas class="kisara-energy-canvas" data-kisara-energy width="640" height="64"></canvas>
    </div>
    <p class="kisara-contract-state" data-kisara-state>CONTRACT 000%</p>
    <p class="kisara-scroll-cue" data-kisara-cue>SCROLL / SIGN THE CONTRACT</p>
    <a class="kisara-gate-skip" href="#kisara-opening" data-kisara-skip>SKIP</a>
  </section>

  <section id="kisara-opening" class="kisara-opening" aria-labelledby="kisara-opening-title">
    <div class="kisara-opening-inner">
      <p class="kisara-section-index">AFTER THE SIGNATURE / 001</p>
      <h2 id="kisara-opening-title">The signal continues below.</h2>
      <div class="kisara-opening-grid">
        <p>视觉、交互与技术记录沿着同一条契约线继续展开。</p>
        <nav aria-label="Kisara theme shortcuts">
          <a href={getThemePath("kisara", "/blog/")}><span>01</span>READ THE LOG</a>
          <a href={getThemePath("kisara", "/projects/")}><span>02</span>OPEN THE LAB</a>
          <a href={getThemePath("kisara", "/about/")}><span>03</span>TRACE YUIMI</a>
        </nav>
      </div>
    </div>
  </section>

  <section class="kisara-latest" aria-labelledby="kisara-latest-title">
    <div class="kisara-section-heading">
      <p class="kisara-section-index">RECENT TRANSMISSIONS / 002</p>
      <h2 id="kisara-latest-title">Latest notes</h2>
    </div>
    <div class="kisara-transmission-list">
      {posts.map((post, index) => (
        <a href={getThemePath("kisara", `/blog/${post.id}/`)}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div>
            <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.updatedDate ?? post.data.pubDate)}</time>
            <h3>{post.data.title}</h3>
          </div>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      const gate = document.querySelector("[data-kisara-gate]");
      if (!gate || gate.dataset.bound === "true") return;
      gate.dataset.bound = "true";

      const energyCanvas = gate.querySelector("[data-kisara-energy]");
      const energyContext = energyCanvas?.getContext("2d");
      const burstCanvas = gate.querySelector("[data-kisara-burst-canvas]");
      const burstContext = burstCanvas?.getContext("2d");
      const meterShell = gate.querySelector(".kisara-contract-meter");
      const opening = document.querySelector("#kisara-opening");
      const state = gate.querySelector("[data-kisara-state]");
      const cue = gate.querySelector("[data-kisara-cue]");
      const skip = gate.querySelector("[data-kisara-skip]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const restoredBelowGate = window.scrollY > 2;
      const fillDistance = 2100;
      const burstDistance = 2250;
      const springStrength = 0.06;
      const burstSpringStrength = 0.038;
      const damping = 0.76;
      const burstDamping = 0.86;
      const settleDistance = 0.00035;
      const glossFadeEnd = 0.42;
      const crossStart = 0.46;
      const crossBuildEnd = 0.58;
      const crossFlashEnd = 0.72;
      const crossEnd = 0.82;
      const reformEnd = 0.9;
      const detonationStart = 0.88;
      const detonationEnd = 0.97;
      const rainStart = 0.985;
      const clamp = (value, minimum, maximum) => Math.min(maximum, Math.max(minimum, value));
      let progress = reducedMotion || restoredBelowGate ? 1 : 0;
      let targetProgress = progress;
      let velocity = 0;
      let burstProgress = reducedMotion || restoredBelowGate ? 1 : 0;
      let targetBurstProgress = burstProgress;
      let burstVelocity = 0;
      let animationFrame = 0;
      let lastFrameTime = 0;
      let touchY = null;
      let touchId = null;
      let renderedPercent = -1;
      let renderedStage = "";
      let renderedGlitchTick = -1;
      let energyFrame = 0;
      let energyProgress = 0;
      let energyCanvasWidth = 0;
      let energyCanvasHeight = 0;
      let burstCanvasWidth = 0;
      let burstCanvasHeight = 0;
      let pageMode = restoredBelowGate ? "next" : "gate";
      let scrollFrame = 0;
      let restoreWindowOpen = true;
      let poseTimestamp = 0;
      let chargeInstability = 0;
      let beamPose = {
        shakeX: 0,
        shakeY: 0,
        lift: 0,
        scaleX: 1,
        scaleY: 1,
        angle: 0
      };

      const smoothstep = (value) => value * value * (3 - 2 * value);
      const phaseProgress = (value, start, end) => smoothstep(clamp((value - start) / (end - start), 0, 1));
      const randomSeed = (index) => {
        const value = Math.sin(index * 12.9898 + 78.233) * 43758.5453;
        return value - Math.floor(value);
      };
      const glitchAlphabet = "0123456789XZ!?/#@$%&<>";
      const makeGlitchState = (timestamp, burst, released) => {
        const tick = Math.floor(timestamp / 72);
        const patterns = released
          ? ["SIGNAL RELEASED", "CORE WITHOUT LIMIT", "CHANNEL UNBOUND", "OUTPUT OVERRUN"]
          : ["SYSTEM UNSTABLE", "KISARA OVERFLOW", "CONTRACT BREACH", "RED TIDE RISING"];
        const pattern = patterns[Math.floor(randomSeed(tick + 8401) * patterns.length)];
        const corrupted = pattern.split("").map((character, index) => {
          if (character === " " || randomSeed(tick * 31 + index + 8417) < 0.62) return character;
          const glyphIndex = Math.floor(randomSeed(tick * 47 + index + 8461) * glitchAlphabet.length);
          return glitchAlphabet[glyphIndex];
        }).join("");
        const code = Math.floor(randomSeed(tick + 8521) * 0xffffff).toString(16).toUpperCase().padStart(6, "0");
        const noise = Array.from({ length: 4 }, (_, index) => {
          const glyphIndex = Math.floor(randomSeed(tick * 59 + index + 8591) * glitchAlphabet.length);
          return glitchAlphabet[glyphIndex];
        }).join("");
        const phase = burst > 0.72 ? "// BREAK" : "// OVRFLW";
        return `${corrupted} ${phase} ${code} ${noise}`;
      };

      const resizeEnergyCanvas = () => {
        if (!energyCanvas || !energyContext) return;
        const rect = energyCanvas.getBoundingClientRect();
        const width = Math.max(1, Math.round(rect.width));
        const height = Math.max(1, Math.round(rect.height));
        const devicePixelRatio = Math.min(window.devicePixelRatio || 1, 2);
        const pixelWidth = Math.max(1, Math.round(width * devicePixelRatio));
        const pixelHeight = Math.max(1, Math.round(height * devicePixelRatio));
        if (energyCanvas.width !== pixelWidth || energyCanvas.height !== pixelHeight) {
          energyCanvas.width = pixelWidth;
          energyCanvas.height = pixelHeight;
          energyContext.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
        }
        energyCanvasWidth = width;
        energyCanvasHeight = height;
      };

      const resizeBurstCanvas = () => {
        if (!burstCanvas || !burstContext) return;
        const rect = burstCanvas.getBoundingClientRect();
        const width = Math.max(1, Math.round(rect.width));
        const height = Math.max(1, Math.round(rect.height));
        const devicePixelRatio = Math.min(window.devicePixelRatio || 1, 2);
        const pixelWidth = Math.max(1, Math.round(width * devicePixelRatio));
        const pixelHeight = Math.max(1, Math.round(height * devicePixelRatio));
        if (burstCanvas.width !== pixelWidth || burstCanvas.height !== pixelHeight) {
          burstCanvas.width = pixelWidth;
          burstCanvas.height = pixelHeight;
          burstContext.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
        }
        burstCanvasWidth = width;
        burstCanvasHeight = height;
      };

      const drawScreenEnergy = (timestamp) => {
        if (!burstCanvas || !burstContext) return;
        resizeBurstCanvas();
        const width = burstCanvasWidth;
        const height = burstCanvasHeight;
        const context = burstContext;
        context.clearRect(0, 0, width, height);
        const fill = Math.max(energyProgress, 0.012);
        const burst = burstProgress;
        if (width <= 1 || height <= 1) return;

        const time = timestamp / 1000;
        const intensity = 0.12 + fill * 0.88;
        const densityScale = width < 640 ? 0.68 : width < 960 ? 0.84 : 1;
        const meterWidth = meterShell?.clientWidth || Math.min(620, width * 0.78);
        const meterHeight = meterShell?.clientHeight || 68;
        const meterLeft = meterShell?.offsetLeft ?? (width - meterWidth) / 2;
        const meterTop = meterShell?.offsetTop ?? height * 0.58;
        const localFrontRadius = 5 + fill * 22;
        const localFrontX = clamp(
          meterWidth * fill,
          3,
          Math.max(3, meterWidth - localFrontRadius * 2.2)
        );
        const angleRadians = beamPose.angle * Math.PI / 180;
        const headOffset = (localFrontX - meterWidth * 0.5) * beamPose.scaleX;
        const originX = clamp(
          meterLeft + meterWidth * 0.5 + beamPose.shakeX + Math.cos(angleRadians) * headOffset,
          width * 0.05,
          width * 0.95
        );
        const originY = clamp(
          meterTop + meterHeight * 0.5 + beamPose.shakeY + beamPose.lift + Math.sin(angleRadians) * headOffset,
          height * 0.12,
          height * 0.88
        );
        const burstOriginX = originX;
        const burstOriginY = originY;
        const maxRadius = Math.hypot(width, height) * 1.16;
        const dissolve = phaseProgress(burst, 0.015, 0.14);
        const reform = phaseProgress(burst, crossEnd, reformEnd);
        const pressure = phaseProgress(burst, 0.7, 0.94);
        const detonation = phaseProgress(burst, detonationStart, detonationEnd);
        const detonationRush = 1 - Math.pow(1 - detonation, 2.6);
        const rainProgress = phaseProgress(burst, rainStart, 1);
        const wakeOpacity = clamp(1 - dissolve * 0.78 - rainProgress * 0.72, 0, 1);
        context.save();
        context.globalCompositeOperation = "lighter";

        const ambientCount = Math.floor((14 + fill * 86) * densityScale);
        for (let index = 0; index < ambientCount; index += 1) {
          const seedX = randomSeed(index + 1201);
          const seedY = randomSeed(index + 1801);
          const speed = 0.25 + seedX * (0.35 + fill * 1.1);
          const x = (seedX * width + Math.sin(time * speed + index) * (4 + fill * 20) + width) % width;
          const y = (seedY * height + Math.cos(time * (speed + 0.2) + index) * (3 + fill * 16) + height) % height;
          const size = 0.45 + seedY * (0.7 + fill * 1.8);
          const alpha = (0.025 + seedX * 0.14) * intensity;
          context.globalAlpha = alpha;
          context.fillStyle = fill > 0.56 && index % 3 !== 0 ? "#ff9caf" : "#c5d8ff";
          context.beginPath();
          context.arc(x, y, size, 0, Math.PI * 2);
          context.fill();
        }

        const wakeLength = Math.max(42, 42 + fill * (width * 0.82));
        const wakeSpread = 10 + fill * (height * 0.44);
        if (wakeOpacity > 0.001) {
          for (let sideIndex = 0; sideIndex < 2; sideIndex += 1) {
            const side = sideIndex === 0 ? -1 : 1;
            for (let ribbon = 0; ribbon < 2; ribbon += 1) {
              const ribbonSeed = randomSeed(sideIndex * 17 + ribbon + 3301);
              const ribbonSpread = 0.48 + ribbon * 0.22 + ribbonSeed * 0.12;
              const gradient = context.createLinearGradient(
                originX,
                originY,
                originX - wakeLength,
                originY + side * wakeSpread * ribbonSpread
              );
              gradient.addColorStop(0, "rgba(255, 250, 252, 0.58)");
              gradient.addColorStop(0.16, "rgba(255, 157, 181, 0.32)");
              gradient.addColorStop(0.58, "rgba(180, 211, 255, 0.12)");
              gradient.addColorStop(1, "rgba(180, 211, 255, 0)");
              context.globalAlpha = wakeOpacity * (0.2 - ribbon * 0.045) * intensity;
              context.strokeStyle = gradient;
              context.lineWidth = 1.2 + fill * (1.5 - ribbon * 0.22);
              context.lineCap = "round";
              context.shadowColor = side < 0 ? "rgba(196, 220, 255, 0.7)" : "rgba(255, 118, 151, 0.72)";
              context.shadowBlur = 3 + fill * 9;
              context.beginPath();
              context.moveTo(originX, originY);
              context.bezierCurveTo(
                originX - wakeLength * 0.12,
                originY + side * wakeSpread * (0.05 + ribbonSeed * 0.05),
                originX - wakeLength * 0.45,
                originY + side * wakeSpread * (0.24 + ribbonSeed * 0.12),
                originX - wakeLength,
                originY + side * wakeSpread * ribbonSpread
              );
              context.stroke();
              context.shadowBlur = 0;
            }
          }

          const wakeCount = Math.floor((28 + fill * 204) * densityScale);
          for (let index = 0; index < wakeCount; index += 1) {
            const seed = randomSeed(index + 3201);
            const drift = randomSeed(index + 3901);
            const side = seed > 0.5 ? 1 : -1;
            const speed = 0.08 + fill * (0.22 + seed * 0.42) + detonation * (0.18 + drift * 0.46);
            const age = (time * speed + drift * 11.7 + index * 0.037) % 1;
            const travel = smoothstep(age);
            const lane = 0.08 + drift * 0.92;
            const turbulence = Math.sin(time * (0.7 + seed * 1.2) + age * 9 + index) * (1.4 + fill * 8.5) * (0.3 + travel * 0.7);
            const flow = side * Math.pow(travel, 0.68) * wakeSpread * lane;
            const x = originX - travel * wakeLength + turbulence * 0.32;
            const y = originY + flow + turbulence;
            const previousAge = Math.max(0, age - 0.045);
            const previousTravel = smoothstep(previousAge);
            const previousTurbulence = Math.sin(time * (0.7 + seed * 1.2) + previousAge * 9 + index) * (1.4 + fill * 8.5) * (0.3 + previousTravel * 0.7);
            const previousX = originX - previousTravel * wakeLength + previousTurbulence * 0.32;
            const previousY = originY + side * Math.pow(previousTravel, 0.68) * wakeSpread * lane + previousTurbulence;
            if (x < -40 || x > width + 40 || y < -40 || y > height + 40) continue;
            const life = Math.pow(Math.sin(age * Math.PI), 1.45);
            const alpha = life * (0.025 + fill * 0.24) * (0.38 + drift * 0.68) * wakeOpacity;
            if (alpha <= 0.008) continue;
            const streakY = side * (0.8 + fill * (2.5 + seed * 8));
            context.globalAlpha = alpha;
            context.strokeStyle = index % 8 === 0 ? "#ffffff" : index % 3 === 0 ? "#b9d3ff" : "#ff8fa9";
            context.lineWidth = 0.4 + fill * (0.35 + seed * 0.7);
            context.lineCap = "round";
            context.beginPath();
            context.moveTo(previousX, previousY);
            context.quadraticCurveTo(x - 1.5 - drift * 3, y - streakY * 0.4, x, y);
            context.stroke();
          }
        }

        if (burst > 0.001) {
          const compressionRadius = 46 + pressure * 190 + detonationRush * 220;
          const compression = context.createRadialGradient(
            burstOriginX,
            burstOriginY,
            0,
            burstOriginX,
            burstOriginY,
            compressionRadius
          );
          compression.addColorStop(0, `rgba(255, 250, 252, ${0.08 + pressure * 0.13})`);
          compression.addColorStop(0.28, `rgba(255, 92, 128, ${0.035 + pressure * 0.09})`);
          compression.addColorStop(1, "rgba(255, 73, 105, 0)");
          context.globalAlpha = 1;
          context.fillStyle = compression;
          context.fillRect(0, 0, width, height);

          if (detonation > 0.001) {
            const pulse = Math.sin(detonation * Math.PI) * 0.86 + Math.pow(detonationRush, 5) * 0.48;
            const shockRadius = Math.max(1, detonationRush * maxRadius);
            if (pulse > 0.001) {
              const flash = context.createRadialGradient(
                burstOriginX,
                burstOriginY,
                0,
                burstOriginX,
                burstOriginY,
                maxRadius * 0.8
              );
              flash.addColorStop(0, `rgba(255, 249, 252, ${0.22 * pulse})`);
              flash.addColorStop(0.3, `rgba(255, 116, 149, ${0.085 * pulse})`);
              flash.addColorStop(1, "rgba(255, 73, 105, 0)");
              context.globalAlpha = 1;
              context.fillStyle = flash;
              context.fillRect(0, 0, width, height);
            }

            context.globalAlpha = Math.pow(detonation, 5) * 0.06;
            context.fillStyle = "#ff7894";
            context.fillRect(0, 0, width, height);

            for (let ring = 0; ring < 3; ring += 1) {
              const ringRadius = shockRadius - ring * (18 + detonationRush * 34);
              if (ringRadius <= 0) continue;
              context.globalAlpha = (0.2 - ring * 0.04) * intensity * (0.38 + detonationRush * 0.62);
              context.strokeStyle = ring % 2 === 0 ? "#ffb1c3" : "#d9e5ff";
              context.lineWidth = 1 + detonationRush * (3.8 - ring * 0.46);
              context.beginPath();
              context.ellipse(burstOriginX, burstOriginY, ringRadius, ringRadius * 0.72, -0.1, 0, Math.PI * 2);
              context.stroke();
            }

            const burstCount = Math.floor((18 + detonationRush * 460) * densityScale);
            for (let index = 0; index < burstCount; index += 1) {
              const seed = randomSeed(index + 2401);
              const speed = 0.18 + detonationRush * (1.02 + seed * 2.8);
              const age = (time * speed + seed * 1.9) % 1;
              const angle = seed * Math.PI * 2 + Math.sin(time * (0.8 + seed) + index) * 0.18;
              const radius = age * shockRadius;
              const x = burstOriginX + Math.cos(angle) * radius;
              const y = burstOriginY + Math.sin(angle) * radius * 0.76;
              const alpha = (1 - age) * (0.16 + seed * 0.76) * intensity * (0.4 + detonationRush * 0.86) * (1 - rainProgress);
              if (alpha <= 0.01) continue;
              const streak = 2 + detonationRush * (16 + seed * 48);
              context.globalAlpha = alpha;
              context.strokeStyle = index % 5 === 0 ? "#ffffff" : index % 2 === 0 ? "#ff8ea6" : "#c9dcff";
              context.lineWidth = 0.5 + detonationRush * (1 + seed * 1.8);
              context.beginPath();
              context.moveTo(x, y);
              context.lineTo(x - Math.cos(angle) * streak, y - Math.sin(angle) * streak * 0.76);
              context.stroke();
            }
          }

          if (rainProgress > 0.001) {
            const rainCount = Math.floor((14 + rainProgress * 280) * densityScale);
            for (let index = 0; index < rainCount; index += 1) {
              const seed = randomSeed(index + 5201);
              const drift = randomSeed(index + 5801);
              const speed = 0.055 + rainProgress * (0.12 + drift * 0.28);
              const age = (time * speed + seed * 2.4) % 1;
              const x = seed * width + Math.sin(time * (0.8 + drift) + index) * (8 + rainProgress * 24);
              const y = -48 + age * (height + 96) + (1 - rainProgress) * burstOriginY * 0.42;
              const length = 2 + rainProgress * (4 + drift * 12);
              const alpha = (0.16 + drift * 0.68) * rainProgress * (0.48 + intensity * 0.52);
              context.globalAlpha = alpha;
              context.strokeStyle = index % 6 === 0 ? "#ffffff" : index % 2 === 0 ? "#ff9caf" : "#c9dcff";
              context.lineWidth = 0.55 + rainProgress * (0.65 + seed * 1.1);
              context.beginPath();
              context.moveTo(x, y);
              context.lineTo(x - 1 - drift * 4, y + length);
              context.stroke();
            }
          }
        }
        context.restore();
      };

      const updateBurstPresentation = (timestamp, advanceCharge = true) => {
        const fill = clamp(energyProgress, 0, 1);
        const burst = clamp(burstProgress, 0, 1);
        const crossBuildLinear = clamp((burst - crossStart) / (crossBuildEnd - crossStart), 0, 1);
        const crossFlashLinear = clamp((burst - crossBuildEnd) / (crossFlashEnd - crossBuildEnd), 0, 1);
        const crossReleaseLinear = clamp((burst - crossFlashEnd) / (crossEnd - crossFlashEnd), 0, 1);
        const crossBuild = 1 - Math.pow(1 - crossBuildLinear, 3.2);
        const crossFlash = smoothstep(crossFlashLinear);
        const crossCollapse = Math.pow(crossReleaseLinear, 3.4);
        const releaseFlash = Math.pow(Math.sin(crossReleaseLinear * Math.PI), 1.45);
        const reform = phaseProgress(burst, crossEnd, reformEnd);
        const pressure = phaseProgress(burst, 0.7, 0.94);
        const detonation = phaseProgress(burst, detonationStart, detonationEnd);
        const detonationRush = 1 - Math.pow(1 - detonation, 2.6);
        const rainProgress = phaseProgress(burst, rainStart, 1);
        const blurRecovery = phaseProgress(burst, 0.9, 1);
        const burstActive = burst > 0.001 && burst < 0.999;
        const time = timestamp / 1000;
        if (advanceCharge) {
          const frameSeconds = poseTimestamp
            ? clamp((timestamp - poseTimestamp) / 1000, 0.008, 0.06)
            : 1 / 60;
          poseTimestamp = timestamp;
          const instabilityTarget = Math.pow(fill, 0.86);
          chargeInstability += (instabilityTarget - chargeInstability) * (1 - Math.exp(-frameSeconds * 5.4));
        }
        const instability = 0.28 + chargeInstability * 1.72;
        const floatFrequency = 0.68 + chargeInstability * 1.9;
        const floatAmplitudeX = 1.6 + instability * 5.5;
        const floatAmplitudeY = 1.25 + instability * 4.25;
        const floatX = Math.sin(time * floatFrequency) * floatAmplitudeX
          + Math.cos(time * floatFrequency * 0.61 + 1.7) * floatAmplitudeX * 0.42
          + Math.sin(time * (0.37 + chargeInstability * 0.7) + 2.4) * floatAmplitudeX * 0.24;
        const floatY = Math.cos(time * floatFrequency * 0.84 + 0.6) * floatAmplitudeY
          + Math.sin(time * floatFrequency * 0.47) * floatAmplitudeY * 0.36
          + Math.cos(time * (0.29 + chargeInstability * 0.58) + 0.9) * floatAmplitudeY * 0.22;
        const floatAngle = Math.sin(time * (0.58 + chargeInstability * 1.8) + 1.2) * (0.28 + instability * 0.86)
          + Math.cos(time * (0.31 + chargeInstability * 0.9)) * (0.16 + instability * 0.42);
        const jitterAmount = 0.14 + chargeInstability * 1.55;
        const jitterX = Math.sin(time * (8.4 + chargeInstability * 8.8) + 0.7) * jitterAmount;
        const jitterY = Math.cos(time * (10.1 + chargeInstability * 10.6) + 1.5) * jitterAmount * 0.62;
        const burstStrength = burstActive
          ? (1.1 + pressure * 6.2 + detonationRush * 22) * (0.2 + pressure * 0.8)
          : 0;
        const detonationShakeX = detonationRush > 0.001
          ? Math.sin(time * (42 + detonationRush * 58)) * (1.4 + detonationRush * 11)
            + Math.cos(time * (27 + detonationRush * 42) + 0.8) * detonationRush * 4.5
          : 0;
        const detonationShakeY = detonationRush > 0.001
          ? Math.cos(time * (49 + detonationRush * 64) + 1.2) * (1 + detonationRush * 8)
            + Math.sin(time * (31 + detonationRush * 48)) * detonationRush * 3.2
          : 0;
        const shakeX = floatX + jitterX
          + Math.sin(time * (18 + pressure * 36 + detonationRush * 34)) * burstStrength
          + detonationShakeX;
        const shakeY = floatY + jitterY
          + Math.cos(time * (24 + pressure * 44 + detonationRush * 42)) * burstStrength * 0.62
          + detonationShakeY;
        const beamLift = burst > 0.001
          ? -reform * Math.min(150, gate.clientHeight * 0.17) - detonationRush * Math.min(38, gate.clientHeight * 0.05)
          : 0;
        const beamScaleX = burst > 0.001
          ? (reform > 0 ? 0.16 + reform * 0.84 : 1) * (1 + detonationRush * 0.12)
          : 1;
        const beamScaleY = burst > 0.001
          ? 1 + reform * 0.32 + pressure * 0.62 + detonationRush * 1.6
          : 1;
        const beamAngle = floatAngle - reform * 8.5 - detonationRush * 17;
        const fadeOut = phaseProgress(burst, 0.015, 0.13);
        const beamVisibility = burst <= 0.001
          ? 1
          : clamp((1 - fadeOut) * (1 - reform) + reform, 0, 1);
        const beamOpacity = clamp(beamVisibility * (1 - rainProgress), 0, 1);
        const preBlastBlur = phaseProgress(burst, glossFadeEnd, crossStart + 0.04)
          * (1 - phaseProgress(burst, crossEnd, reformEnd)) * 4.8;
        const impactBlur = pressure * 2.2 + detonationRush * 11;
        const performanceBlur = preBlastBlur + impactBlur * (1 - blurRecovery);
        const crossPulse = 0.5 + 0.5 * Math.sin(time * (10 + crossFlash * 19) + Math.sin(time * 2.1));
        const crossStrobe = clamp(crossFlash * (0.42 + crossPulse * 0.64) + releaseFlash * 1.18, 0, 1.35);
        const crossRayProgress = clamp(crossBuild * (1 - crossCollapse), 0, 1);
        const crossRayBreath = 0.72 + crossBuild * 0.28 + crossStrobe * 0.22;
        const crossRingProgress = crossReleaseLinear;
        const crossRingOpacity = clamp(releaseFlash * (0.68 + crossPulse * 0.32), 0, 1);
        const crossShardProgress = clamp((crossBuild * 0.46 + crossFlash * 0.54) * (1 - crossCollapse), 0, 1);
        const crossShardOpacity = clamp(crossFlash * (0.24 + crossPulse * 0.62) * (1 - crossReleaseLinear) + releaseFlash * 0.28, 0, 1);
        const crossSparkProgress = clamp(crossFlash * (1 - crossReleaseLinear) + releaseFlash * 0.26, 0, 1);
        const crossSparkOpacity = clamp(Math.sin(crossFlashLinear * Math.PI) * 0.82 * (1 - crossReleaseLinear) + releaseFlash * 0.34, 0, 1);
        const crossSparkDistance = crossSparkProgress * Math.min(168, gate.clientWidth * 0.14);
        const crossCoreOpacity = clamp(crossBuild * 0.52 + crossFlash * 0.2 + releaseFlash * 0.98, 0, 1);
        const crossCoreScale = 0.16 + crossBuild * 0.46 + crossFlash * 0.14 + releaseFlash * 0.76 + crossCollapse * 0.12;
        const crossOpacity = clamp(
          crossBuild * (1 - crossReleaseLinear) * (0.68 + crossPulse * 0.24) + releaseFlash * 0.86,
          0,
          1
        );
        const crossScale = 0.68 + crossBuild * 0.22 + crossFlash * 0.08 - crossCollapse * 0.14 + releaseFlash * 0.12;
        const crossRotation = -18
          + crossBuild * 44
          + crossFlashLinear * 104
          + crossReleaseLinear * 68
          + Math.sin(time * (8 + crossFlash * 18)) * (0.7 + crossStrobe * 3.8);
        const crossShakeX = Math.sin(time * (16 + crossFlash * 28)) * (0.35 + crossStrobe * 2.6 + releaseFlash * 2.2);
        const crossShakeY = Math.cos(time * (19 + crossFlash * 31)) * (0.3 + crossStrobe * 2.1 + releaseFlash * 1.8);
        beamPose = { shakeX, shakeY, lift: beamLift, scaleX: beamScaleX, scaleY: beamScaleY, angle: beamAngle };
        meterShell?.style.setProperty("--kisara-beam-shake-x", `${shakeX.toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-shake-y", `${shakeY.toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-lift", `${beamLift.toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-expansion", beamScaleY.toFixed(4));
        meterShell?.style.setProperty("--kisara-beam-scale-x", beamScaleX.toFixed(4));
        meterShell?.style.setProperty("--kisara-beam-scale-y", beamScaleY.toFixed(4));
        meterShell?.style.setProperty("--kisara-beam-angle", `${beamAngle.toFixed(3)}deg`);
        meterShell?.style.setProperty("--kisara-beam-opacity", beamOpacity.toFixed(3));
        meterShell?.style.setProperty("--kisara-beam-glow", `${(pressure * 12 + detonationRush * 45).toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-brightness", (1 + pressure * 0.16 + detonationRush * 0.62).toFixed(3));
        gate.style.setProperty("--kisara-performance-blur", `${performanceBlur.toFixed(3)}px`);
        gate.style.setProperty("--kisara-cross-opacity", crossOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-ray-progress", crossRayProgress.toFixed(4));
        gate.style.setProperty("--kisara-cross-ray-breath", crossRayBreath.toFixed(3));
        gate.style.setProperty("--kisara-cross-core-scale", crossCoreScale.toFixed(3));
        gate.style.setProperty("--kisara-cross-core-opacity", crossCoreOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-ring-progress", crossRingProgress.toFixed(3));
        gate.style.setProperty("--kisara-cross-ring-opacity", crossRingOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-shard-progress", crossShardProgress.toFixed(4));
        gate.style.setProperty("--kisara-cross-shard-opacity", crossShardOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-spark-opacity", crossSparkOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-spark-distance", `${crossSparkDistance.toFixed(3)}px`);
        gate.style.setProperty("--kisara-cross-strobe", crossStrobe.toFixed(3));
        gate.style.setProperty("--kisara-cross-scale", crossScale.toFixed(3));
        gate.style.setProperty("--kisara-cross-rotation", `${crossRotation.toFixed(3)}deg`);
        gate.style.setProperty("--kisara-cross-shake-x", `${crossShakeX.toFixed(3)}px`);
        gate.style.setProperty("--kisara-cross-shake-y", `${crossShakeY.toFixed(3)}px`);
        gate.style.setProperty("--kisara-cross-blur", `${(0.08 + crossStrobe * 0.42 + releaseFlash * 0.5).toFixed(3)}px`);
      };

      const updateGlitchState = (timestamp) => {
        if (!state) return;
        const fillComplete = targetProgress >= 0.9995 && progress >= 0.999 && Math.abs(velocity) < 0.001;
        if (!fillComplete) {
          renderedGlitchTick = -1;
          return;
        }
        const tick = Math.floor(timestamp / 72);
        if (tick === renderedGlitchTick) return;
        const burstComplete = targetBurstProgress >= 0.9995
          && burstProgress >= 0.999
          && Math.abs(burstVelocity) < 0.001;
        state.textContent = makeGlitchState(timestamp, burstProgress, burstComplete);
        renderedGlitchTick = tick;
      };

      const drawEnergy = (timestamp) => {
        energyFrame = 0;
        if (!energyCanvas || !energyContext) return;
        resizeEnergyCanvas();
        updateBurstPresentation(timestamp);
        updateGlitchState(timestamp);
        const width = energyCanvasWidth;
        const height = energyCanvasHeight;
        energyContext.clearRect(0, 0, width, height);
        drawScreenEnergy(timestamp);
        const fill = Math.max(energyProgress, 0.012);
        if (width <= 1 || height <= 1) return;

        const time = timestamp / 1000;
        const centerY = height / 2;
        const reform = smoothstep(clamp((burstProgress - 0.15) / 0.29, 0, 1));
        const pressure = smoothstep(clamp((burstProgress - 0.22) / 0.52, 0, 1));
        const detonation = phaseProgress(burstProgress, detonationStart, detonationEnd);
        const detonationRush = 1 - Math.pow(1 - detonation, 2.6);
        const rainProgress = phaseProgress(burstProgress, rainStart, 1);
        const startThickness = 0.8 + fill * 1.8;
        const endThickness = 2 + fill * 34 + reform * 5 + pressure * 10 + detonationRush * 25;
        const intensity = 0.12 + fill * 0.88 + pressure * 0.12 + detonationRush * 0.3;
        const frontRadius = 5 + fill * 22 + pressure * 5 + detonationRush * 14;
        const frontX = clamp(width * fill, 3, Math.max(3, width - frontRadius * 2.2));
        const noseLength = Math.min(12, Math.max(1.5, frontX * 0.26));
        const context = energyContext;
        const thicknessAt = (x, scale = 1) =>
          (startThickness + (endThickness - startThickness) * clamp(x / frontX, 0, 1)) * scale;
        context.save();
        context.globalCompositeOperation = "lighter";

        const drawCone = (scale, alpha, blur) => {
          const gradient = context.createLinearGradient(0, 0, frontX, 0);
          gradient.addColorStop(0, "rgba(103, 151, 255, 0.04)");
          gradient.addColorStop(Math.max(0.12, fill * 0.56), "rgba(161, 196, 255, 0.36)");
          gradient.addColorStop(0.82, "rgba(255, 100, 137, 0.76)");
          gradient.addColorStop(1, "rgba(255, 248, 251, 0.98)");
          context.beginPath();
          context.moveTo(0, centerY - startThickness * scale / 2);
          context.lineTo(frontX - noseLength, centerY - endThickness * scale / 2);
          context.quadraticCurveTo(frontX - noseLength * 0.16, centerY - endThickness * scale * 0.18, frontX, centerY);
          context.quadraticCurveTo(frontX - noseLength * 0.16, centerY + endThickness * scale * 0.18, frontX - noseLength, centerY + endThickness * scale / 2);
          context.lineTo(0, centerY + startThickness * scale / 2);
          context.closePath();
          context.globalAlpha = alpha * intensity;
          context.fillStyle = gradient;
          context.shadowColor = "rgba(255, 84, 120, 0.84)";
          context.shadowBlur = blur + fill * 12;
          context.fill();
        };

        drawCone(2.1, 0.16, 12);
        drawCone(1.35, 0.24, 8);
        drawCone(1, 0.72, 4);

        for (let layer = 0; layer < 4; layer += 1) {
          const gradient = context.createLinearGradient(0, 0, frontX, 0);
          gradient.addColorStop(0, "rgba(130, 174, 255, 0.22)");
          gradient.addColorStop(0.72, "rgba(255, 166, 188, 0.78)");
          gradient.addColorStop(1, "rgba(255, 255, 255, 1)");
          context.beginPath();
          for (let x = 0; x <= frontX; x += 4) {
            const localThickness = thicknessAt(x, 0.82);
            const wave = Math.sin(x * (0.035 + layer * 0.009) - time * (4.6 + layer * 1.8))
              * localThickness * 0.42
              + Math.sin(x * 0.09 + time * 3.2 + layer) * localThickness * 0.18;
            const y = centerY + wave + (layer - 1.5) * (0.9 + fill * 1.4);
            if (x === 0) context.moveTo(x, y);
            else context.lineTo(x, y);
          }
          context.globalAlpha = (layer === 1 || layer === 2 ? 0.82 : 0.36) * intensity;
          context.strokeStyle = gradient;
          context.lineWidth = layer === 1 || layer === 2 ? 1.1 + fill * 2.6 : 0.7 + fill * 1.2;
          context.shadowColor = layer === 1 ? "rgba(255, 91, 123, 0.94)" : "rgba(160, 195, 255, 0.78)";
          context.shadowBlur = 3 + fill * 12;
          context.stroke();
        }

        const trailCount = 3 + Math.floor(fill * 38);
        for (let index = 0; index < trailCount; index += 1) {
          const seed = randomSeed(index + 1);
          const speed = 18 + seed * 66;
          const x = (time * speed + seed * Math.max(frontX, 1)) % Math.max(frontX, 1);
          const localThickness = thicknessAt(x, 0.7);
          const y = centerY + Math.sin(time * (2 + seed * 3) + index) * localThickness * 0.55;
          const size = 0.7 + seed * (0.9 + fill * 1.8);
          const alpha = (0.16 + seed * 0.56) * intensity;
          context.globalAlpha = alpha;
          context.strokeStyle = index % 3 === 0 ? "#fff6fa" : "#ff8da5";
          context.lineWidth = size;
          context.beginPath();
          context.moveTo(x, y);
          context.lineTo(x - 4 - seed * (5 + fill * 12), y - (seed - 0.5) * 3);
          context.stroke();
        }

        const wakeOpacity = clamp(1 - phaseProgress(burstProgress, 0.015, 0.14) * 0.82 - rainProgress * 0.7, 0, 1);
        const localWakeLength = Math.max(24, 26 + fill * frontX * 0.56);
        const localWakeSpread = 3 + fill * height * 0.28;
        if (wakeOpacity > 0.001) {
          for (let sideIndex = 0; sideIndex < 2; sideIndex += 1) {
            const side = sideIndex === 0 ? -1 : 1;
            for (let ribbon = 0; ribbon < 2; ribbon += 1) {
              const ribbonSeed = randomSeed(sideIndex * 13 + ribbon + 4401);
              context.globalAlpha = wakeOpacity * (0.22 - ribbon * 0.045) * intensity;
              context.strokeStyle = ribbon === 0 ? "rgba(255, 236, 244, 0.64)" : "rgba(255, 119, 148, 0.42)";
              context.lineWidth = 0.85 + fill * (0.85 - ribbon * 0.12);
              context.lineCap = "round";
              context.shadowColor = side < 0 ? "rgba(196, 220, 255, 0.56)" : "rgba(255, 118, 151, 0.64)";
              context.shadowBlur = 2 + fill * 5;
              context.beginPath();
              context.moveTo(frontX, centerY);
              context.bezierCurveTo(
                frontX - localWakeLength * 0.12,
                centerY + side * localWakeSpread * 0.04,
                frontX - localWakeLength * 0.48,
                centerY + side * localWakeSpread * (0.24 + ribbonSeed * 0.08),
                frontX - localWakeLength,
                centerY + side * localWakeSpread * (0.58 + ribbonSeed * 0.1)
              );
              context.stroke();
              context.shadowBlur = 0;
            }
          }

          const localWakeCount = 10 + Math.floor(fill * 68);
          for (let index = 0; index < localWakeCount; index += 1) {
            const seed = randomSeed(index + 401);
            const drift = randomSeed(index + 701);
            const side = seed > 0.5 ? 1 : -1;
            const speed = 0.08 + fill * (0.22 + seed * 0.38) + detonationRush * (0.24 + drift * 0.54);
            const age = (time * speed + drift * 11.7 + index * 0.053) % 1;
            const travel = smoothstep(age);
            const turbulence = Math.sin(time * (0.7 + seed) + age * 9 + index) * (0.8 + fill * 4.2) * (0.3 + travel * 0.7);
            const x = frontX - travel * localWakeLength + turbulence * 0.24;
            const y = centerY + side * Math.pow(travel, 0.68) * localWakeSpread * (0.12 + seed * 0.88) + turbulence;
            const previousAge = Math.max(0, age - 0.05);
            const previousTravel = smoothstep(previousAge);
            const previousTurbulence = Math.sin(time * (0.7 + seed) + previousAge * 9 + index) * (0.8 + fill * 4.2) * (0.3 + previousTravel * 0.7);
            const previousX = frontX - previousTravel * localWakeLength + previousTurbulence * 0.24;
            const previousY = centerY + side * Math.pow(previousTravel, 0.68) * localWakeSpread * (0.12 + seed * 0.88) + previousTurbulence;
            const alpha = Math.pow(Math.sin(age * Math.PI), 1.45) * (0.08 + seed * 0.34) * intensity * wakeOpacity;
            if (alpha <= 0.01) continue;
            context.globalAlpha = alpha;
            context.strokeStyle = index % 5 === 0 ? "#ffffff" : "#ff91aa";
            context.lineWidth = 0.4 + fill * (0.34 + seed * 0.58);
            context.lineCap = "round";
            context.beginPath();
            context.moveTo(previousX, previousY);
            context.quadraticCurveTo(x - 1 - drift * 2, y, x, y);
            context.stroke();
          }
        }

        const frontGlow = context.createRadialGradient(frontX, centerY, 0, frontX, centerY, frontRadius * 1.7);
        frontGlow.addColorStop(0, `rgba(255, 255, 255, ${0.92 * intensity})`);
        frontGlow.addColorStop(0.2, `rgba(255, 230, 237, ${0.74 * intensity})`);
        frontGlow.addColorStop(0.56, `rgba(255, 73, 105, ${0.42 * intensity})`);
        frontGlow.addColorStop(1, "rgba(255, 73, 105, 0)");
        context.globalAlpha = 1;
        context.fillStyle = frontGlow;
        context.beginPath();
        context.arc(frontX, centerY, frontRadius * 1.7, 0, Math.PI * 2);
        context.fill();

        context.beginPath();
        context.moveTo(frontX - frontRadius * 1.9, centerY);
        context.lineTo(frontX - frontRadius * 0.28, centerY - frontRadius);
        context.quadraticCurveTo(frontX + frontRadius * 0.35, centerY, frontX - frontRadius * 0.28, centerY + frontRadius);
        context.closePath();
        context.globalAlpha = 0.62 + fill * 0.38;
        context.fillStyle = "rgba(255, 126, 150, 0.74)";
        context.shadowColor = "rgba(255, 67, 104, 0.98)";
        context.shadowBlur = 8 + fill * 22;
        context.fill();

        for (let ray = 0; ray < 3 + Math.floor(fill * 10); ray += 1) {
          const raySeed = randomSeed(ray + 101);
          const rayLength = 8 + raySeed * (14 + fill * 42);
          const rayY = centerY + (raySeed - 0.5) * (8 + fill * 28);
          context.globalAlpha = (0.24 + raySeed * 0.42) * intensity;
          context.strokeStyle = ray % 2 === 0 ? "#fff" : "#ff7891";
          context.lineWidth = 0.7 + fill * 1.2;
          context.beginPath();
          context.moveTo(frontX - frontRadius * 0.16, rayY);
          context.lineTo(frontX - rayLength, rayY + (raySeed - 0.5) * 5);
          context.stroke();
        }

        const tailMaskLength = Math.max(frontX / 3, 18);
        const tailFade = context.createLinearGradient(0, 0, tailMaskLength, 0);
        tailFade.addColorStop(0, "rgba(0, 0, 0, 0)");
        tailFade.addColorStop(0.14, "rgba(0, 0, 0, 0.04)");
        tailFade.addColorStop(0.3, "rgba(0, 0, 0, 0.58)");
        tailFade.addColorStop(0.4, "rgba(0, 0, 0, 0.96)");
        tailFade.addColorStop(0.48, "rgba(0, 0, 0, 1)");
        tailFade.addColorStop(1, "rgba(0, 0, 0, 1)");
        context.globalCompositeOperation = "destination-in";
        context.globalAlpha = 1;
        context.shadowBlur = 0;
        context.shadowColor = "transparent";
        context.fillStyle = tailFade;
        context.fillRect(0, 0, width, height);
        context.restore();

        if (!reducedMotion && document.visibilityState === "visible" && pageMode !== "next") {
          energyFrame = window.requestAnimationFrame(drawEnergy);
        }
      };

      const startEnergyAnimation = () => {
        if (!energyContext || pageMode === "next") return;
        if (reducedMotion) {
          drawEnergy(performance.now());
          return;
        }
        if (!energyFrame && document.visibilityState === "visible") {
          energyFrame = window.requestAnimationFrame(drawEnergy);
        }
      };

      const render = () => {
        const fill = clamp(progress, 0, 1);
        const percent = Math.round(progress * 100);
        const fillComplete = targetProgress >= 0.9995 && fill >= 0.999 && Math.abs(velocity) < 0.001;
        const burstComplete = fillComplete
          && targetBurstProgress >= 0.9995
          && burstProgress >= 0.999
          && Math.abs(burstVelocity) < 0.001;
        const tideVisible = fill > 0.0005;
        const reveal = smoothstep(clamp((fill - 0.025) / 0.975, 0, 1));
        const glossSweep = phaseProgress(burstProgress, 0.01, 0.3);
        const glossPosition = -18 + glossSweep * 136;
        const glossOpacity = Math.sin(glossSweep * Math.PI) * (1 - phaseProgress(burstProgress, 0.3, glossFadeEnd)) * 0.98;
        const crestOpacity = fill <= 0.002 || fill >= 0.998
          ? 0
          : Math.min(0.92, 0.54 + Math.abs(velocity) * 42);
        const crestDrift = clamp(velocity * 820, -4.5, 4.5);

        gate.style.setProperty("--kisara-fill", `${(fill * 100).toFixed(3)}%`);
        gate.style.setProperty("--kisara-burst-progress", `${(burstProgress * 100).toFixed(3)}%`);
        gate.style.setProperty("--kisara-gloss-position", `${glossPosition.toFixed(3)}%`);
        gate.style.setProperty("--kisara-gloss-opacity", glossOpacity.toFixed(3));
        gate.style.setProperty("--kisara-tide-opacity", tideVisible ? "1" : "0");
        gate.style.setProperty("--kisara-crest-opacity", crestOpacity.toFixed(3));
        gate.style.setProperty("--kisara-crest-drift", `${crestDrift.toFixed(3)}px`);
        gate.style.setProperty("--kisara-bg-blur", `${(reveal * 12).toFixed(3)}px`);
        gate.style.setProperty("--kisara-bg-opacity", (0.98 - reveal * 0.66).toFixed(3));
        gate.style.setProperty("--kisara-bg-saturation", (1 - reveal * 0.26).toFixed(3));
        gate.style.setProperty("--kisara-bg-brightness", (1 - reveal * 0.14).toFixed(3));
        gate.style.setProperty("--kisara-fight-opacity", (reveal * 0.98).toFixed(3));
        gate.style.setProperty("--kisara-fight-blur", `${((1 - reveal) * 15).toFixed(3)}px`);
        gate.style.setProperty("--kisara-fight-scale", (1.06 - reveal * 0.06).toFixed(4));
        gate.style.setProperty("--kisara-fight-saturation", (0.84 + reveal * 0.36).toFixed(3));
        gate.style.setProperty("--kisara-fight-brightness", (0.86 + reveal * 0.22).toFixed(3));
        energyProgress = fill;
        updateBurstPresentation(performance.now(), false);
        startEnergyAnimation();
        const stage = fillComplete ? "glitch" : "contract";
        const glitchTick = fillComplete ? Math.floor(performance.now() / 72) : -1;
        if (state && (percent !== renderedPercent || stage !== renderedStage || glitchTick !== renderedGlitchTick)) {
          state.textContent = fillComplete
            ? makeGlitchState(performance.now(), burstProgress, burstComplete)
            : `CONTRACT ${String(percent).padStart(3, "0")}%`;
          renderedPercent = percent;
          renderedStage = stage;
          renderedGlitchTick = glitchTick;
        }
        gate.classList.toggle("is-complete", fillComplete);
        gate.classList.toggle("is-bursting", burstProgress > 0.001 && !burstComplete);
        gate.classList.toggle("is-burst-complete", burstComplete);
        gate.classList.toggle("is-released", pageMode === "next");
        gate.classList.toggle("is-receding", velocity < -0.0003);
        if (cue) {
          cue.textContent = burstComplete
            ? "SIGNAL RELEASED / CONTINUE"
            : fillComplete
              ? "OVERCHARGE / BREAK THE SEAL"
              : "SCROLL / SIGN THE CONTRACT";
        }
      };

      const animate = (timestamp) => {
        animationFrame = 0;
        const frameRatio = lastFrameTime
          ? clamp((timestamp - lastFrameTime) / 16.667, 0.5, 3)
          : 1;
        lastFrameTime = timestamp;
        const spring = (targetProgress - progress) * springStrength * frameRatio;
        velocity = (velocity + spring) * Math.pow(damping, frameRatio);
        progress = clamp(progress + velocity * frameRatio, 0, 1);
        const burstSpring = (targetBurstProgress - burstProgress) * burstSpringStrength * frameRatio;
        burstVelocity = (burstVelocity + burstSpring) * Math.pow(burstDamping, frameRatio);
        burstProgress = clamp(burstProgress + burstVelocity * frameRatio, 0, 1);

        const settled = Math.abs(targetProgress - progress) < settleDistance
          && Math.abs(velocity) < settleDistance
          && Math.abs(targetBurstProgress - burstProgress) < settleDistance
          && Math.abs(burstVelocity) < settleDistance;
        if (settled) {
          progress = targetProgress;
          velocity = 0;
          burstProgress = targetBurstProgress;
          burstVelocity = 0;
          lastFrameTime = 0;
          render();
          return;
        }

        render();
        animationFrame = window.requestAnimationFrame(animate);
      };

      const startAnimation = () => {
        if (!animationFrame) {
          lastFrameTime = 0;
          animationFrame = window.requestAnimationFrame(animate);
        }
      };

      const getNextPageTop = () => {
        const openingRect = opening?.getBoundingClientRect();
        return Math.max(1, Math.round((openingRect?.top ?? gate.getBoundingClientRect().height) + window.scrollY));
      };

      const setScrollPosition = (value) => {
        window.scrollTo(0, clamp(value, 0, Math.max(0, document.documentElement.scrollHeight - window.innerHeight)));
      };

      const smoothScrollTo = (target, onComplete) => {
        if (scrollFrame) return;
        const destination = Math.max(0, target);
        if (reducedMotion) {
          setScrollPosition(destination);
          onComplete?.();
          return;
        }
        const root = document.documentElement;
        const previousScrollBehavior = root.style.scrollBehavior;
        root.style.scrollBehavior = "auto";
        let current = window.scrollY;
        let velocity = 0;
        let lastTimestamp = performance.now();
        const stiffness = 38;
        const dampingForce = 11.8;
        const maxVelocity = clamp(Math.abs(destination - current) * 2.4, 620, 1900);

        const finish = () => {
          setScrollPosition(destination);
          root.style.scrollBehavior = previousScrollBehavior;
          scrollFrame = 0;
          onComplete?.();
        };

        const step = (timestamp) => {
          const deltaTime = clamp((timestamp - lastTimestamp) / 1000, 0.008, 0.034);
          lastTimestamp = timestamp;
          const distance = destination - current;
          const acceleration = distance * stiffness - velocity * dampingForce;
          velocity = clamp(velocity + acceleration * deltaTime, -maxVelocity, maxVelocity);
          current += velocity * deltaTime;
          setScrollPosition(current);
          if (Math.abs(distance) < 0.35 && Math.abs(velocity) < 8) {
            finish();
            return;
          }
          scrollFrame = window.requestAnimationFrame(step);
        };

        scrollFrame = window.requestAnimationFrame(step);
      };

      const resetGateState = () => {
        if (animationFrame) window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
        lastFrameTime = 0;
        targetProgress = 0;
        progress = 0;
        velocity = 0;
        targetBurstProgress = 0;
        burstProgress = 0;
        burstVelocity = 0;
        energyProgress = 0;
        poseTimestamp = 0;
        chargeInstability = 0;
        renderedPercent = -1;
        renderedStage = "";
        renderedGlitchTick = -1;
        render();
      };

      const enterNextPage = () => {
        if (scrollFrame) return;
        pageMode = "snap";
        smoothScrollTo(getNextPageTop(), () => {
          pageMode = "next";
          render();
        });
      };

      const returnToGate = () => {
        if (scrollFrame) return;
        pageMode = "snap";
        smoothScrollTo(0, () => {
          pageMode = "gate";
          resetGateState();
        });
      };

      const addProgress = (delta) => {
        const boundedDelta = clamp(delta, -180, 180);
        const fillComplete = targetProgress >= 0.9995
          && progress >= 0.999
          && Math.abs(velocity) < 0.001;
        const burstInProgress = targetBurstProgress > 0.0005 || burstProgress > 0.0005;
        if ((delta > 0 && fillComplete) || (delta < 0 && burstInProgress)) {
          targetBurstProgress = clamp(targetBurstProgress + boundedDelta / burstDistance, 0, 1);
          burstVelocity += boundedDelta / burstDistance * 0.045;
        } else {
          targetProgress = clamp(targetProgress + boundedDelta / fillDistance, 0, 1);
          velocity += boundedDelta / fillDistance * 0.03;
        }
        startAnimation();
      };

      const isFillComplete = () => targetProgress >= 0.9995
        && progress >= 0.999
        && Math.abs(velocity) < 0.001;

      const isComplete = () => isFillComplete()
        && targetBurstProgress >= 0.9995
        && burstProgress >= 0.999
        && Math.abs(burstVelocity) < 0.001;

      const shouldCaptureGate = (delta) => {
        if (window.scrollY > 2 || delta === 0) return false;
        if (delta > 0) return !isComplete();
        return targetBurstProgress > 0.0005
          || burstProgress > 0.0005
          || Math.abs(burstVelocity) > 0.0005
          || targetProgress > 0.0005
          || progress > 0.0005
          || Math.abs(velocity) > 0.0005;
      };

      const normalizeWheel = (event) => {
        if (event.deltaMode === WheelEvent.DOM_DELTA_LINE) return event.deltaY * 16;
        if (event.deltaMode === WheelEvent.DOM_DELTA_PAGE) return event.deltaY * window.innerHeight;
        return event.deltaY;
      };

      const handleDirectionalInput = (delta, event) => {
        if (delta === 0) return;
        if (scrollFrame) {
          event.preventDefault();
          return;
        }
        if (pageMode === "gate") {
          if (window.scrollY > 2) return;
          if (delta > 0 && isComplete()) {
            event.preventDefault();
            enterNextPage();
            return;
          }
          if (!shouldCaptureGate(delta)) return;
          event.preventDefault();
          addProgress(delta);
          return;
        }
        if (pageMode === "next" && delta < 0 && window.scrollY <= getNextPageTop() + Math.max(28, window.innerHeight * 0.08)) {
          event.preventDefault();
          returnToGate();
        }
      };

      window.addEventListener("wheel", (event) => {
        if (event.ctrlKey || event.metaKey) return;
        const delta = normalizeWheel(event);
        handleDirectionalInput(delta, event);
      }, { passive: false });

      window.addEventListener("keydown", (event) => {
        if (event.ctrlKey || event.metaKey || event.altKey) return;
        if (event.target instanceof Element && event.target.closest("a, button, input, select, textarea, [contenteditable='true']")) return;
        let amount = 0;
        if (event.key === "ArrowDown") amount = 130;
        if (event.key === "ArrowUp") amount = -130;
        if (["PageDown", "End"].includes(event.key)) amount = 300;
        if (["PageUp", "Home"].includes(event.key)) amount = -300;
        if (event.key === " ") amount = event.shiftKey ? -300 : 300;
        if (!amount) return;
        handleDirectionalInput(amount, event);
      });

      window.addEventListener("touchstart", (event) => {
        if (event.touches.length !== 1) {
          touchY = null;
          touchId = null;
          return;
        }
        touchId = event.touches[0]?.identifier ?? null;
        touchY = event.touches[0]?.clientY ?? null;
      }, { passive: true });

      window.addEventListener("touchmove", (event) => {
        if (event.touches.length !== 1 || touchId === null) return;
        const touch = Array.from(event.touches).find((item) => item.identifier === touchId);
        const nextY = touch?.clientY ?? null;
        if (touchY === null || nextY === null) return;
        const delta = touchY - nextY;
        touchY = nextY;
        const touchDelta = delta * 2.25;
        handleDirectionalInput(touchDelta, event);
      }, { passive: false });

      window.addEventListener("touchend", () => {
        touchY = null;
        touchId = null;
      }, { passive: true });

      window.addEventListener("touchcancel", () => {
        touchY = null;
        touchId = null;
      }, { passive: true });

      skip?.addEventListener("click", (event) => {
        event.preventDefault();
        if (animationFrame) window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
        lastFrameTime = 0;
        targetProgress = 1;
        progress = 1;
        velocity = 0;
        targetBurstProgress = 1;
        burstProgress = 1;
        burstVelocity = 0;
        render();
        enterNextPage();
      });

      window.addEventListener("resize", () => {
        resizeEnergyCanvas();
        resizeBurstCanvas();
        startEnergyAnimation();
      }, { passive: true });
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") {
          if (energyFrame) window.cancelAnimationFrame(energyFrame);
          energyFrame = 0;
          return;
        }
        startEnergyAnimation();
      });

      render();
      const syncRestoredPosition = () => {
        if (!restoreWindowOpen || scrollFrame || pageMode !== "gate" || window.scrollY <= 2 || isComplete()) return;
        if (animationFrame) window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
        lastFrameTime = 0;
        targetProgress = 1;
        progress = 1;
        velocity = 0;
        targetBurstProgress = 1;
        burstProgress = 1;
        burstVelocity = 0;
        pageMode = "next";
        render();
      };
      window.addEventListener("pageshow", syncRestoredPosition);
      window.addEventListener("scroll", syncRestoredPosition, { passive: true });
      window.requestAnimationFrame(() => window.requestAnimationFrame(() => {
        syncRestoredPosition();
        window.setTimeout(() => {
          syncRestoredPosition();
          restoreWindowOpen = false;
          window.removeEventListener("scroll", syncRestoredPosition);
        }, 420);
      }));
    })();
  </script>
</KisaraLayout>
