          const outsidePoints = centerSamples.map((sample) => {
            const edgeFade = Math.sin(sample.unit * Math.PI);
            const orbitPhase = sample.unit * fullTurn * (1.18 + strand * 0.22) + phaseOffset;
            const radius = sample.thickness * (1.18 + strand * 0.16) + 5 + geometry.flight * 7;
            return {
              x: sample.x + sample.normalX * Math.sin(orbitPhase) * radius * edgeFade
                + sample.tangentX * Math.cos(orbitPhase) * 3.5,
              y: sample.y + sample.normalY * Math.sin(orbitPhase) * radius * edgeFade
                + sample.tangentY * Math.cos(orbitPhase) * 3.5
            };
          });
