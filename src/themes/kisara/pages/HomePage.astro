            stopHeroAutoplay();
          }
          if (delta > 0 && isComplete()) {
            event.preventDefault();
            enterNextPage();
            return;
          }
          if (["forward", "rewinding", "paused"].includes(releaseMode)) {
            const releaseInputHandled = handleReleaseInput(delta, performance.now());
            if (releaseInputHandled) {
              event.preventDefault();
              return;
            }
          }
          if (!shouldCaptureGate(delta)) return;
          event.preventDefault();
          const gateDelta = inputType === "wheel"
            ? shapeGateWheelDelta(delta, performance.now())
            : delta;
          addProgress(gateDelta);
          return;
        }
