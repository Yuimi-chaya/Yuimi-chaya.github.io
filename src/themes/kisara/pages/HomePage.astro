              * smoothstep(0.0, 0.025, 1.0 - sourceUv.y);
            vec2 clampedSourceUv = clamp(sourceUv, vec2(0.001), vec2(0.999));
            vec2 chromaticAxis = normalize(vec2(flowDirection, -0.18));
            vec2 chromaticOffset = chromaticAxis
              * (0.8 + liquidPressure * 1.75)
