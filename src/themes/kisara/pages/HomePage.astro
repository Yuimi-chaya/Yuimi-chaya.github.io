          headNosePoints.push({
            x: headSample.x
              + headSample.tangentX * Math.cos(angle) * headSample.thickness * 0.88
              + headSample.normalX * Math.sin(angle) * headSample.thickness,
            y: headSample.y
              + headSample.tangentY * Math.cos(angle) * headSample.thickness * 0.88
              + headSample.normalY * Math.sin(angle) * headSample.thickness
          });
        }
        const envelope = createClosedCanvasPath([
          ...upperPoints,
