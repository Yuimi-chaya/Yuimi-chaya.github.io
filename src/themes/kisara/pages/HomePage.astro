      const getNextPageTop = () => {
        const openingRect = opening?.getBoundingClientRect();
        return Math.max(1, Math.round((openingRect?.top ?? gate.getBoundingClientRect().height) + window.scrollY));
      };

      const getReturnToGateThreshold = () => {
        const edgeHeight = openingEdge instanceof HTMLElement
          ? openingEdge.offsetHeight
          : 180;
        return getNextPageTop() + edgeHeight + Math.max(24, window.innerHeight * 0.04);
      };

      const getDocumentScrollProgress = () => {
        const root = document.scrollingElement ?? document.documentElement;
