            liquidOffset *= 0.58 + liquidPressure * 0.88;
            float directionalPull = flowInfluence
              * (11.0 + liquidPressure * 29.0 + abs(uParallax) * 7.0)
              * impactDrive
              * resolutionScale;
            liquidOffset.x += flowDirection * directionalPull;
            liquidOffset.y += sin(
              normalizedPoint.y * 17.0
              - uLiquidPhase * 2.1
              + normalizedPoint.x * 4.0
            )
              * flowInfluence
              * impactDrive
              * (4.2 + liquidPressure * 8.4)
              * resolutionScale;
            liquidOffset.x += normalizedPoint.y * uParallax * 7.2 * resolutionScale;

            vec2 sourcePixel = pixel
              + vec2(ribbonShear + breathing, sideBend)
              + tangent * orbitBend
              + direction * shockPull
              - direction * releaseReach
              + tangent * releaseFlutter
              + liquidOffset * finalFlow;
            vec2 sourceUv = sourcePixel / uResolution;
            float edge = smoothstep(0.0, 0.025, sourceUv.x)
              * smoothstep(0.0, 0.025, sourceUv.y)
