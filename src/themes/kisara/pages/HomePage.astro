      const createTransparentWebglWarmup = (gl, canvas, drawFrame, clearFrame) => {
        let warmed = false;
        let destroyed = false;
        let activePromise = null;
        let activeResolve = null;
        let settleFrame = 0;
        let completionFence = null;

        const releaseFence = () => {
          if (!completionFence) return;
          gl.deleteSync(completionFence);
          completionFence = null;
        };

        const finish = (completed, shouldClear = true) => {
          if (settleFrame) window.cancelAnimationFrame(settleFrame);
          settleFrame = 0;
          releaseFence();
          if (!completed) warmed = false;
          if (shouldClear && !destroyed) {
            try {
              clearFrame();
            } catch {}
          }
          const resolve = activeResolve;
          activeResolve = null;
          activePromise = null;
          resolve?.(completed);
        };

        const warm = (force = false) => {
          if (destroyed) return Promise.resolve(false);
          if (activePromise) return activePromise;
          if (warmed && !force) return Promise.resolve(true);

          warmed = true;
          try {
            drawFrame();
            completionFence = gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0);
            gl.flush();
          } catch {
            warmed = false;
            try {
              clearFrame();
            } catch {}
            return Promise.resolve(false);
          }

          activePromise = new Promise((resolve) => {
            activeResolve = resolve;
            let frameCount = 0;
            const settle = () => {
              settleFrame = 0;
              if (destroyed || gl.isContextLost()) {
                finish(false, false);
                return;
              }

              frameCount += 1;
              let gpuReady = !completionFence;
              if (completionFence) {
                const status = gl.clientWaitSync(completionFence, 0, 0);
                if (status === gl.WAIT_FAILED) {
                  finish(false, true);
                  return;
                }
                gpuReady = status === gl.ALREADY_SIGNALED
                  || status === gl.CONDITION_SATISFIED;
              }

              // The first callback runs before paint. Keep the transparent canvas
              // alive through one compositor frame before clearing it.
              if (frameCount < 2 || (!gpuReady && frameCount < 8)) {
                settleFrame = window.requestAnimationFrame(settle);
                return;
              }
              finish(true, true);
            };
            settleFrame = window.requestAnimationFrame(settle);
          });
          return activePromise;
        };

        return {
          warm,
          reset: () => {
            if (activePromise) finish(false, true);
            else warmed = false;
          },
          destroy: () => {
            destroyed = true;
            finish(false, false);
          }
        };
      };


      const createTitleLensRenderer = () => {
