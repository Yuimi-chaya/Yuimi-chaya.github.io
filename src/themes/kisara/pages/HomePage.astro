          context.strokeStyle = strand === 0 ? "rgba(255, 229, 239, 0.96)" : "rgba(144, 185, 255, 0.82)";
          context.lineWidth = 1.1 + geometry.flight * 1.1;
          context.shadowColor = strand === 0 ? "rgba(255, 86, 139, 0.88)" : "rgba(112, 160, 255, 0.78)";
          context.shadowBlur = 8 + geometry.flight * 8;
          context.stroke(createSmoothCanvasPath(outsidePoints));
        }

        const headAngle = Math.atan2(headSample.tangentY, headSample.tangentX);
        const headRadius = headSample.thickness * (0.72 + impactPulse * 0.18);
        context.save();
