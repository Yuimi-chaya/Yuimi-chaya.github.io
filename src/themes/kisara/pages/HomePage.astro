          !titleAbyssContext
          || lovebrainActive
          || pageMode !== "gate"
          || !precisePointer
          || reducedMotion
          || progress >= 0.999
          || window.scrollY > 2
        ) {
          resetTitleAbyssPointer();
          return;
        }
        const gateRect = gate.getBoundingClientRect();
        if (
          event.clientX < gateRect.left
          || event.clientX > gateRect.right
          || event.clientY < gateRect.top
          || event.clientY > gateRect.bottom
        ) {
          resetTitleAbyssPointer();
          return;
        }
        const titleRect = title?.getBoundingClientRect();
        const centerX = titleRect
          ? titleRect.left + titleRect.width * 0.5
          : gateRect.left + gateRect.width * 0.5;
        const centerY = titleRect
          ? titleRect.top + titleRect.height * 0.5
          : gateRect.top + gateRect.height * 0.5;
        titleAbyssPointerTargetX = clamp(
          (event.clientX - centerX) / Math.max(1, gateRect.width * 0.34),
          -1,
          1
        );
        titleAbyssPointerTargetY = clamp(
          (event.clientY - centerY) / Math.max(1, gateRect.height * 0.28),
          -1,
          1
        );
        startEnergyAnimation();
      };

      const handlePostReleasePointer = (event) => {
        if (
          !postReleaseActive
          || lovebrainActive
          || pageMode !== "gate"
          || !precisePointer
          || reducedMotion
          || window.scrollY > 2
        ) return;
        const gateRect = gate.getBoundingClientRect();
        if (
          event.clientX < gateRect.left
          || event.clientX > gateRect.right
          || event.clientY < gateRect.top
          || event.clientY > gateRect.bottom
        ) return;
