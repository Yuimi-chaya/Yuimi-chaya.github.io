---
import KisaraLayout from "../layouts/KisaraLayout.astro";
import { Icon } from "astro-icon/components";
import { getPublishedPosts } from "@/core/content/blog";
import { currentSignals, profileIdentity } from "@/core/data/profile";
import { projectEntries } from "@/core/data/projects";
import { getThemePath } from "@/core/themes/registry";
import { categoryLabel } from "@/lib/site";
import { existsSync } from "node:fs";
import { resolve } from "node:path";

const posts = (await getPublishedPosts()).slice(0, 3);
const featuredProjects = projectEntries.slice(0, 3);
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
});

const backgroundExtensions = ["webp", "png", "jpg", "jpeg"];
const findThemeAsset = (baseName: string) => {
  const extension = backgroundExtensions.find((candidate) =>
    existsSync(resolve(`public/themes/kisara/assets/${baseName}.${candidate}`))
  );
  return extension ? `/themes/kisara/assets/${baseName}.${extension}` : null;
};
const activeBackgroundUrl = findThemeAsset("gate-background");
const activeFightUrl = findThemeAsset("fight");
const channelLinks = [
  { index: "01", label: "READ THE LOG", note: "开发与部署记录", href: getThemePath("kisara", "/blog/"), icon: "tabler:book-2" },
  { index: "02", label: "OPEN THE LAB", note: "项目与互动实验", href: getThemePath("kisara", "/projects/"), icon: "tabler:flask-2" },
  { index: "03", label: "ENTER PLAY", note: "短暂切进小游戏", href: getThemePath("kisara", "/games/"), icon: "tabler:device-gamepad-2" },
  { index: "04", label: "TRACE YUIMI", note: "读取契约者资料", href: getThemePath("kisara", "/about/"), icon: "tabler:user-scan" }
] as const;
const gateStyle = [
  "--kisara-fill: 0%",
  "--kisara-burst-progress: 0%",
  `--kisara-gate-background-image: ${activeBackgroundUrl ? `url("${activeBackgroundUrl}")` : "none"}`,
  `--kisara-fight-background-image: ${activeFightUrl ? `url("${activeFightUrl}")` : "none"}`
].join("; ");
---

<KisaraLayout title="Kisara | Yuimi Lab" description="Yuimi Lab 的 Kisara 视觉交互主题。">
  <section class="kisara-gate" data-kisara-gate style={gateStyle}>
    <div class="kisara-gate-visual" aria-hidden="true">
      <div class="kisara-gate-background kisara-gate-background-base"></div>
      <div class="kisara-gate-background kisara-gate-background-fight"></div>
      <canvas
        class="kisara-space-lens-canvas"
        data-kisara-space-lens
        data-base-src={activeBackgroundUrl ?? ""}
        data-fight-src={activeFightUrl ?? ""}
        width="1280"
        height="900"
      ></canvas>
      <div class="kisara-gate-atmosphere"></div>
    </div>
    <canvas class="kisara-burst-canvas" data-kisara-burst-canvas width="1280" height="900" aria-hidden="true"></canvas>
    <div class="kisara-screen-impact" aria-hidden="true"></div>
    <p class="kisara-gate-index">YUIMI LAB / INTERACTION CHANNEL 03</p>
    <h1 class="kisara-title" aria-label="Kisara">
      <span class="kisara-title-base" aria-hidden="true">Kisara</span>
      <span class="kisara-title-tide" aria-hidden="true">Kisara</span>
      <span class="kisara-title-crest" aria-hidden="true">Kisara</span>
      <span class="kisara-title-gloss" aria-hidden="true">Kisara</span>
      <canvas
        class="kisara-title-lens-canvas"
        data-kisara-title-lens
        width="1200"
        height="260"
        aria-hidden="true"
      ></canvas>
      <i class="kisara-title-cross" aria-hidden="true">
        <span class="kisara-cross-ring"></span>
        <span class="kisara-cross-ray kisara-cross-ray-north"></span>
        <span class="kisara-cross-ray kisara-cross-ray-east"></span>
        <span class="kisara-cross-ray kisara-cross-ray-south"></span>
        <span class="kisara-cross-ray kisara-cross-ray-west"></span>
        <span class="kisara-cross-shard kisara-cross-shard-a"></span>
        <span class="kisara-cross-shard kisara-cross-shard-b"></span>
        <span class="kisara-cross-shard kisara-cross-shard-c"></span>
        <span class="kisara-cross-shard kisara-cross-shard-d"></span>
        <span class="kisara-cross-spark kisara-cross-spark-a"></span>
        <span class="kisara-cross-spark kisara-cross-spark-b"></span>
        <span class="kisara-cross-spark kisara-cross-spark-c"></span>
        <span class="kisara-cross-spark kisara-cross-spark-d"></span>
        <span class="kisara-cross-core"></span>
      </i>
    </h1>
    <div class="kisara-contract-meter" aria-hidden="true">
      <canvas class="kisara-energy-canvas" data-kisara-energy width="640" height="64"></canvas>
    </div>
    <p class="kisara-contract-state" data-kisara-state>CONTRACT 000%</p>
    <p class="kisara-scroll-cue" data-kisara-cue>SCROLL / SIGN THE CONTRACT</p>
    <a class="kisara-gate-skip" href="#kisara-opening" data-kisara-skip>SKIP</a>
  </section>

  <section id="kisara-opening" class="kisara-opening" aria-labelledby="kisara-opening-title">
    <div class="kisara-opening-inner">
      <p class="kisara-section-index">AFTER THE SIGNATURE / 001</p>
      <div class="kisara-opening-heading">
        <h2 id="kisara-opening-title">After the contract.</h2>
        <span>CHANNEL 03 / CONNECTED</span>
      </div>
      <div class="kisara-opening-grid">
        <div class="kisara-opening-copy">
          <p>这里不再继续重复首屏的演出，而是把视觉、交互与技术记录接到同一条契约线上。</p>
          <div class="kisara-contractor-line">
            <span>CONTRACTOR</span>
            <strong>{profileIdentity.displayName} / {profileIdentity.handle}</strong>
            <small>兴趣驱动型折腾人 · 喜欢把技术做得有一点可爱</small>
          </div>
        </div>
        <nav class="kisara-channel-links" aria-label="Kisara theme shortcuts">
          {channelLinks.map((item) => (
            <a href={item.href}>
              <span>{item.index}</span>
              <Icon name={item.icon} aria-hidden="true" />
              <div><strong>{item.label}</strong><small>{item.note}</small></div>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <section class="kisara-signal-deck" aria-labelledby="kisara-signal-title">
    <div class="kisara-content-shell">
      <div class="kisara-section-heading">
        <div>
          <p class="kisara-section-index">LIVE SIGNALS / 002</p>
          <h2 id="kisara-signal-title">Current pulse.</h2>
        </div>
        <p>不用仪表盘汇报人生，只留三条现在确实还在发热的信号。</p>
      </div>
      <div class="kisara-signal-grid">
        {currentSignals.map((signal, index) => (
          <article>
            <span>0{index + 1}</span>
            <small>{signal.label}</small>
            <h3>{signal.text}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="kisara-home-projects" aria-labelledby="kisara-project-title">
    <div class="kisara-content-shell">
      <div class="kisara-section-heading">
        <div>
          <p class="kisara-section-index">ACTIVE LAB / 003</p>
          <h2 id="kisara-project-title">Work in motion.</h2>
        </div>
        <a class="kisara-section-link" href={getThemePath("kisara", "/projects/")}>VIEW ALL WORKS <span>↗</span></a>
      </div>
      <div class="kisara-project-tracks">
        {featuredProjects.map((project, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <small>{project.type} / {project.status}</small>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
            </div>
            <strong>{project.line.toUpperCase()}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="kisara-latest" aria-labelledby="kisara-latest-title">
    <div class="kisara-section-heading">
      <div>
        <p class="kisara-section-index">RECENT TRANSMISSIONS / 004</p>
        <h2 id="kisara-latest-title">Latest notes.</h2>
      </div>
      <a class="kisara-section-link" href={getThemePath("kisara", "/blog/")}>OPEN ARCHIVE <span>↗</span></a>
    </div>
    <div class="kisara-transmission-list">
      {posts.map((post, index) => (
        <a href={getThemePath("kisara", `/blog/${post.id}/`)}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div>
            <small>{categoryLabel[post.data.category]} / <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.updatedDate ?? post.data.pubDate)}</time></small>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      const gate = document.querySelector("[data-kisara-gate]");
      if (!gate || gate.dataset.bound === "true") return;
      gate.dataset.bound = "true";

      const energyCanvas = gate.querySelector("[data-kisara-energy]");
      const energyContext = energyCanvas?.getContext("2d");
      const burstCanvas = gate.querySelector("[data-kisara-burst-canvas]");
      const burstContext = burstCanvas?.getContext("2d");
      const spaceLensCanvas = gate.querySelector("[data-kisara-space-lens]");
      const titleLensCanvas = gate.querySelector("[data-kisara-title-lens]");
      const meterShell = gate.querySelector(".kisara-contract-meter");
      const title = gate.querySelector(".kisara-title");
      const cross = gate.querySelector(".kisara-title-cross");
      const opening = document.querySelector("#kisara-opening");
      const state = gate.querySelector("[data-kisara-state]");
      const cue = gate.querySelector("[data-kisara-cue]");
      const skip = gate.querySelector("[data-kisara-skip]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const restoredBelowGate = window.scrollY > 2;
      const fillDistance = 2100;
      const burstDistance = 2250;
      const springStrength = 0.06;
      const burstSpringStrength = 0.038;
      const damping = 0.76;
      const burstDamping = 0.86;
      const settleDistance = 0.00035;
      const glossFadeEnd = 0.42;
      const crossStart = 0.46;
      const crossBuildEnd = 0.58;
      const crossFlashEnd = 0.72;
      const crossEnd = 0.82;
      const reformEnd = 0.9;
      const collapseStart = 0.858;
      const shockwaveStart = 0.91;
      const detonationStart = 0.936;
      const detonationEnd = 0.968;
      const rainStart = 0.948;
      const rainPeak = 0.986;
      const releaseAutoplayDuration = 8200;
      const clamp = (value, minimum, maximum) => Math.min(maximum, Math.max(minimum, value));
      const startsComplete = reducedMotion && !restoredBelowGate;
      let progress = startsComplete ? 1 : 0;
      let targetProgress = progress;
      let velocity = 0;
      let burstProgress = startsComplete ? 1 : 0;
      let targetBurstProgress = burstProgress;
      let burstVelocity = 0;
      let burstAutoplay = false;
      let burstAutoplayComplete = startsComplete;
      let burstAutoplayStartedAt = 0;
      let animationFrame = 0;
      let lastFrameTime = 0;
      let touchY = null;
      let touchId = null;
      let renderedPercent = -1;
      let renderedStage = "";
      let renderedGlitchTick = -1;
      let energyFrame = 0;
      let energyTimer = 0;
      let energyLoopActive = false;
      let energyProgress = 0;
      let energyCanvasWidth = 0;
      let energyCanvasHeight = 0;
      let burstCanvasWidth = 0;
      let burstCanvasHeight = 0;
      let spaceLensRenderer = null;
      let spaceLensInitGeneration = 0;
      let lastSpaceLensPaintTimestamp = 0;
      let titleLensRenderer = null;
      let titleLensInitGeneration = 0;
      let lastTitleLensPaintTimestamp = 0;
      let pageMode = restoredBelowGate ? "next" : "gate";
      let scrollFrame = 0;
      let resetTransitionTimer = 0;
      let restoreWindowOpen = true;
      let poseTimestamp = 0;
      let poseClock = 0;
      let poseAtRest = true;
      let chargeInstability = 0;
      const makeMotionPhases = () => ({
        floatPrimary: 0,
        floatSecondary: 1.7,
        floatTertiary: 2.4,
        verticalPrimary: 0.6,
        verticalSecondary: 0,
        verticalTertiary: 0.9,
        anglePrimary: 1.2,
        angleSecondary: 0,
        jitterX: 0.7,
        jitterY: 1.5,
        burstX: 0,
        burstY: 0,
        detonationX: 0,
        detonationXSecondary: 0.8,
        detonationY: 1.2,
        detonationYSecondary: 0,
        screenX: 0.3,
        screenXSecondary: 0,
        screenY: 1.1,
        screenYSecondary: 0,
        gravityX: 0.7,
        gravityY: 1.2,
        crossPulse: 0,
        crossPulseMod: 0,
        crossRotation: 0,
        crossShakeX: 0,
        crossShakeY: 0
      });
      let motionPhases = makeMotionPhases();
      const fullTurn = Math.PI * 2;
      const advanceMotionPhase = (key, amount) => {
        motionPhases[key] = (motionPhases[key] + amount) % fullTurn;
      };
      let beamPose = {
        shakeX: 0,
        shakeY: 0,
        anchorX: 0,
        anchorY: 0,
        lift: 0,
        scaleX: 1,
        scaleY: 1,
        angle: 0
      };
      let screenParticleTimestamp = 0;
      let lastEnergyPaintTimestamp = 0;
      let energyFlowTimestamp = 0;
      let energyFlowPhase = 0;
      let beamHeadTimestamp = 0;
      let beamHeadX = 0;
      let beamHeadY = 0;
      let beamHeadVelocityX = 0;
      let beamHeadVelocityY = 0;
      let beamMotionEnergy = 0;
      let particleSerial = 0;
      let wakeEmissionBudget = 0;
      let orbitEmissionBudget = 0;
      let rainEmissionBudget = 0;
      let burstWaveMask = 0;
      let wakePrimed = false;
      const wakeParticles = [];
      const orbitParticles = [];
      const burstParticles = [];
      const rainParticles = [];

      const smoothstep = (value) => value * value * (3 - 2 * value);
      const phaseProgress = (value, start, end) => smoothstep(clamp((value - start) / (end - start), 0, 1));
      const randomSeed = (index) => {
        const value = Math.sin(index * 12.9898 + 78.233) * 43758.5453;
        return value - Math.floor(value);
      };
      const nextParticleRandom = () => randomSeed((particleSerial += 1) * 1.61803398875 + 0.37);

      const createSpaceLensRenderer = async () => {
        if (!spaceLensCanvas || reducedMotion) return null;
        const baseSource = spaceLensCanvas.dataset.baseSrc || spaceLensCanvas.dataset.fightSrc;
        const fightSource = spaceLensCanvas.dataset.fightSrc || spaceLensCanvas.dataset.baseSrc;
        if (!baseSource || !fightSource) return null;

        const gl = spaceLensCanvas.getContext("webgl2", {
          alpha: true,
          antialias: false,
          depth: false,
          stencil: false,
          premultipliedAlpha: true,
          preserveDrawingBuffer: false,
          powerPreference: "high-performance"
        });
        if (!gl) return null;

        const vertexSource = `#version 300 es
          precision highp float;
          const vec2 POSITIONS[3] = vec2[3](
            vec2(-1.0, -1.0),
            vec2(3.0, -1.0),
            vec2(-1.0, 3.0)
          );
          out vec2 vUv;
          void main() {
            vec2 position = POSITIONS[gl_VertexID];
            vUv = position * 0.5 + 0.5;
            gl_Position = vec4(position, 0.0, 1.0);
          }
        `;
        const fragmentSource = `#version 300 es
          precision highp float;
          in vec2 vUv;
          out vec4 outputColor;

          uniform sampler2D uBaseTexture;
          uniform sampler2D uFightTexture;
          uniform vec2 uResolution;
          uniform vec2 uBaseSize;
          uniform vec2 uFightSize;
          uniform vec2 uCenter;
          uniform float uReveal;
          uniform float uOpacity;
          uniform float uGravity;
          uniform float uCollapse;
          uniform float uCrush;
          uniform float uShockStrength;
          uniform float uShockRadius;
          uniform float uShockWidth;
          uniform float uCoreRadius;
          uniform float uLensRadius;
          uniform float uTime;

          vec2 coverUv(vec2 uv, vec2 imageSize, float scale) {
            float viewportAspect = uResolution.x / max(1.0, uResolution.y);
            float imageAspect = imageSize.x / max(1.0, imageSize.y);
            vec2 mapped = uv;
            if (imageAspect > viewportAspect) {
              float visibleWidth = viewportAspect / imageAspect;
              mapped.x = (mapped.x - 0.5) * visibleWidth + 0.5;
            } else {
              float visibleHeight = imageAspect / viewportAspect;
              mapped.y = (mapped.y - 0.5) * visibleHeight + 0.5;
            }
            mapped = (mapped - 0.5) / scale + 0.5;
            return clamp(mapped, vec2(0.001), vec2(0.999));
          }

          vec3 adjustSceneColor(vec3 color, float saturation, float brightness) {
            float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));
            return mix(vec3(luminance), color, saturation) * brightness;
          }

          vec3 sampleScene(vec2 uv) {
            vec2 baseUv = coverUv(uv, uBaseSize, 1.045);
            vec2 fightUv = coverUv(uv, uFightSize, 1.0);
            vec3 baseColor = texture(uBaseTexture, baseUv).rgb;
            vec3 fightColor = texture(uFightTexture, fightUv).rgb;
            baseColor = adjustSceneColor(baseColor, 1.0 - uReveal * 0.26, 1.0 - uReveal * 0.14);
            fightColor = adjustSceneColor(fightColor, 0.84 + uReveal * 0.36, 0.86 + uReveal * 0.22);
            vec3 sceneColor = mix(baseColor, fightColor, smoothstep(0.0, 1.0, uReveal));
            float atmosphere = mix(0.58, 0.34, clamp(uv.y, 0.0, 1.0));
            return mix(sceneColor, vec3(0.027, 0.039, 0.122), atmosphere);
          }

          void main() {
            float aspect = uResolution.x / max(1.0, uResolution.y);
            vec2 point = vUv - uCenter;
            point.x *= aspect;
            float radius = length(point);
            vec2 direction = point / max(radius, 0.0001);
            vec2 tangent = vec2(-direction.y, direction.x);
            float core = max(uCoreRadius, 0.004);
            float gravityStrength = clamp(
              uGravity * (0.68 + uCollapse * 0.2 + uCrush * 0.12),
              0.0,
              1.12
            );
            float massRadius = max(
              core,
              0.044 + uCollapse * 0.009 + uCrush * 0.01
            );
            float lensReach = min(max(uLensRadius, massRadius * 4.0), 0.76);
            float outsideCore = smoothstep(core * 0.98, core * 1.22, radius);
            float reachProgress = smoothstep(core * 1.15, lensReach, radius);
            float radialReach = pow(max(0.0, 1.0 - reachProgress), 1.32);
            float gravityField = outsideCore * radialReach;
            float sideDistance = abs(vUv.x - 0.5);
            float sideMask = smoothstep(0.166, 0.225, sideDistance);
            float sideDepth = smoothstep(0.18, 0.5, sideDistance);
            float distortionField = gravityField
              * sideMask
              * (0.62 + sideDepth * 0.58);

            float einsteinRadius = massRadius * (
              1.0
              + gravityStrength * 0.34
              + uCollapse * 0.1
              + uCrush * 0.08
            );
            float inverseRadius = max(radius, massRadius * 0.54);
            float lensPull = (einsteinRadius * einsteinRadius)
              / (radius * radius + core * core * 2.15)
              * gravityStrength;
            lensPull = min(lensPull, 0.64);
            float primaryRadius = radius / (1.0 + lensPull * distortionField * 0.86);

            float criticalRadius = einsteinRadius * sqrt(max(gravityStrength, 0.02));
            float ringWidth = max(massRadius * 0.2, 0.007);
            float causticDistance = (radius - criticalRadius) / ringWidth;
            float caustic = exp(-causticDistance * causticDistance)
              * distortionField
              * gravityStrength;

            float waveWidth = max(uShockWidth, 0.006);
            float waveCoordinate = (radius - uShockRadius) / waveWidth;
            float waveEnvelope = exp(-waveCoordinate * waveCoordinate);
            float waveDisplacement = -waveCoordinate
              * waveEnvelope
              * uShockStrength
              * (0.009 + waveWidth * 0.065)
              * sideMask;
            float fieldBreath = sin(
              (radius - core) / max(lensReach - core, 0.01) * 9.0 - uTime * 0.56
            ) * distortionField * uCollapse * 0.00085;

            float frameDrag = massRadius / inverseRadius
              * distortionField
              * uCollapse
              * gravityStrength
              * (0.044 + uCrush * 0.03);
            float dragCos = cos(frameDrag);
            float dragSin = sin(frameDrag);
            vec2 lensedDirection = vec2(
              direction.x * dragCos - direction.y * dragSin,
              direction.x * dragSin + direction.y * dragCos
            );
            float sideSweep = sin(vUv.y * 5.4 - uTime * 0.34)
              * (0.002 + uCollapse * 0.0045 + uCrush * 0.006)
              * gravityStrength
              * gravityField
              * sideMask
              * sign(vUv.x - 0.5);

            float edgeFade = smoothstep(0.0, 0.055, vUv.x)
              * smoothstep(0.0, 0.055, vUv.y)
              * smoothstep(0.0, 0.055, 1.0 - vUv.x)
              * smoothstep(0.0, 0.055, 1.0 - vUv.y);
            vec2 lensedPoint = lensedDirection * (
              primaryRadius + waveDisplacement + fieldBreath
            ) + tangent * sideSweep;
            vec2 displacedPoint = mix(point, lensedPoint, edgeFade);
            vec2 displacedUv = uCenter + vec2(displacedPoint.x / aspect, displacedPoint.y);
            displacedUv = mix(vUv, displacedUv, sideMask);

            vec3 color = sampleScene(displacedUv);
            color *= 1.0 + caustic * 0.045 + waveEnvelope * uShockStrength * sideMask * 0.018;

            float horizon = 1.0 - smoothstep(core * 0.98, core * 1.04, radius);
            color = mix(color, vec3(0.0), horizon * sideMask);
            float alpha = max(
              clamp(uOpacity, 0.0, 1.0),
              horizon * sideMask * smoothstep(0.05, 0.15, gravityStrength)
            );
            outputColor = vec4(color * alpha, alpha);
          }
        `;

        const compileShader = (type, source) => {
          const shader = gl.createShader(type);
          if (!shader) return null;
          gl.shaderSource(shader, source);
          gl.compileShader(shader);
          if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
            gl.deleteShader(shader);
            return null;
          }
          return shader;
        };
        const vertexShader = compileShader(gl.VERTEX_SHADER, vertexSource);
        const fragmentShader = compileShader(gl.FRAGMENT_SHADER, fragmentSource);
        if (!vertexShader || !fragmentShader) return null;
        const program = gl.createProgram();
        if (!program) return null;
        gl.attachShader(program, vertexShader);
        gl.attachShader(program, fragmentShader);
        gl.linkProgram(program);
        gl.deleteShader(vertexShader);
        gl.deleteShader(fragmentShader);
        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
          gl.deleteProgram(program);
          return null;
        }
        const vertexArray = gl.createVertexArray();
        if (!vertexArray) {
          gl.deleteProgram(program);
          return null;
        }

        const loadTexture = (source) => new Promise((resolveTexture) => {
          const image = new Image();
          image.decoding = "async";
          image.onload = () => {
            const texture = gl.createTexture();
            if (!texture) {
              resolveTexture(null);
              return;
            }
            gl.bindTexture(gl.TEXTURE_2D, texture);
            gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
            gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image);
            resolveTexture({
              texture,
              width: image.naturalWidth || image.width,
              height: image.naturalHeight || image.height
            });
          };
          image.onerror = () => resolveTexture(null);
          image.src = source;
        });

        const [baseTexture, fightTexture] = await Promise.all([
          loadTexture(baseSource),
          loadTexture(fightSource)
        ]);
        if (!baseTexture || !fightTexture) {
          if (baseTexture?.texture) gl.deleteTexture(baseTexture.texture);
          if (fightTexture?.texture) gl.deleteTexture(fightTexture.texture);
          gl.deleteProgram(program);
          return null;
        }

        const uniforms = {
          baseTexture: gl.getUniformLocation(program, "uBaseTexture"),
          fightTexture: gl.getUniformLocation(program, "uFightTexture"),
          resolution: gl.getUniformLocation(program, "uResolution"),
          baseSize: gl.getUniformLocation(program, "uBaseSize"),
          fightSize: gl.getUniformLocation(program, "uFightSize"),
          center: gl.getUniformLocation(program, "uCenter"),
          reveal: gl.getUniformLocation(program, "uReveal"),
          opacity: gl.getUniformLocation(program, "uOpacity"),
          gravity: gl.getUniformLocation(program, "uGravity"),
          collapse: gl.getUniformLocation(program, "uCollapse"),
          crush: gl.getUniformLocation(program, "uCrush"),
          shockStrength: gl.getUniformLocation(program, "uShockStrength"),
          shockRadius: gl.getUniformLocation(program, "uShockRadius"),
          shockWidth: gl.getUniformLocation(program, "uShockWidth"),
          coreRadius: gl.getUniformLocation(program, "uCoreRadius"),
          lensRadius: gl.getUniformLocation(program, "uLensRadius"),
          time: gl.getUniformLocation(program, "uTime")
        };
        let cssWidth = 0;
        let cssHeight = 0;

        const resize = () => {
          const rect = spaceLensCanvas.getBoundingClientRect();
          cssWidth = Math.max(1, Math.round(rect.width));
          cssHeight = Math.max(1, Math.round(rect.height));
          const mobile = cssWidth < 640;
          const deviceScale = Math.min(window.devicePixelRatio || 1, 1);
          let renderScale = mobile ? 0.68 : cssWidth < 1000 ? 0.86 : 1;
          const maxPixels = mobile ? 360000 : 1300000;
          const estimatedPixels = cssWidth * cssHeight * deviceScale * deviceScale * renderScale * renderScale;
          if (estimatedPixels > maxPixels) renderScale *= Math.sqrt(maxPixels / estimatedPixels);
          const pixelWidth = Math.max(1, Math.round(cssWidth * deviceScale * renderScale));
          const pixelHeight = Math.max(1, Math.round(cssHeight * deviceScale * renderScale));
          if (spaceLensCanvas.width !== pixelWidth || spaceLensCanvas.height !== pixelHeight) {
            spaceLensCanvas.width = pixelWidth;
            spaceLensCanvas.height = pixelHeight;
          }
          gl.viewport(0, 0, pixelWidth, pixelHeight);
        };

        const clear = () => {
          spaceLensCanvas.style.opacity = "0";
          spaceLensCanvas.dataset.active = "false";
          gl.clearColor(0, 0, 0, 0);
          gl.clear(gl.COLOR_BUFFER_BIT);
        };

        const draw = (parameters) => {
          resize();
          gl.clearColor(0, 0, 0, 0);
          gl.clear(gl.COLOR_BUFFER_BIT);
          gl.useProgram(program);
          gl.bindVertexArray(vertexArray);
          gl.activeTexture(gl.TEXTURE0);
          gl.bindTexture(gl.TEXTURE_2D, baseTexture.texture);
          gl.uniform1i(uniforms.baseTexture, 0);
          gl.activeTexture(gl.TEXTURE1);
          gl.bindTexture(gl.TEXTURE_2D, fightTexture.texture);
          gl.uniform1i(uniforms.fightTexture, 1);
          gl.uniform2f(uniforms.resolution, cssWidth, cssHeight);
          gl.uniform2f(uniforms.baseSize, baseTexture.width, baseTexture.height);
          gl.uniform2f(uniforms.fightSize, fightTexture.width, fightTexture.height);
          gl.uniform2f(uniforms.center, parameters.centerX, parameters.centerY);
          gl.uniform1f(uniforms.reveal, parameters.reveal);
          gl.uniform1f(uniforms.opacity, parameters.opacity);
          gl.uniform1f(uniforms.gravity, parameters.gravity);
          gl.uniform1f(uniforms.collapse, parameters.collapse);
          gl.uniform1f(uniforms.crush, parameters.crush);
          gl.uniform1f(uniforms.shockStrength, parameters.shockStrength);
          gl.uniform1f(uniforms.shockRadius, parameters.shockRadius);
          gl.uniform1f(uniforms.shockWidth, parameters.shockWidth);
          gl.uniform1f(uniforms.coreRadius, parameters.coreRadius);
          gl.uniform1f(uniforms.lensRadius, parameters.lensRadius);
          gl.uniform1f(uniforms.time, parameters.time);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          spaceLensCanvas.style.opacity = "1";
          spaceLensCanvas.dataset.active = "true";
        };

        const destroy = () => {
          gl.deleteTexture(baseTexture.texture);
          gl.deleteTexture(fightTexture.texture);
          gl.deleteVertexArray(vertexArray);
          gl.deleteProgram(program);
          clear();
        };

        resize();
        clear();
        return { clear, destroy, draw, resize };
      };

      const createTitleLensRenderer = () => {
        if (!titleLensCanvas || !title || reducedMotion) return null;
        const gl = titleLensCanvas.getContext("webgl2", {
          alpha: true,
          antialias: false,
          depth: false,
          stencil: false,
          premultipliedAlpha: true,
          preserveDrawingBuffer: false,
          powerPreference: "high-performance"
        });
        if (!gl) return null;

        const sourceCanvas = document.createElement("canvas");
        const sourceContext = sourceCanvas.getContext("2d");
        if (!sourceContext) return null;

        const vertexSource = `#version 300 es
          precision highp float;
          const vec2 POSITIONS[3] = vec2[3](
            vec2(-1.0, -1.0),
            vec2(3.0, -1.0),
            vec2(-1.0, 3.0)
          );
          out vec2 vUv;
          void main() {
            vec2 position = POSITIONS[gl_VertexID];
            vUv = position * 0.5 + 0.5;
            gl_Position = vec4(position, 0.0, 1.0);
          }
        `;
        const fragmentSource = `#version 300 es
          precision highp float;
          in vec2 vUv;
          out vec4 outputColor;

          uniform sampler2D uTitleTexture;
          uniform vec2 uResolution;
          uniform vec2 uCenter;
          uniform float uOpacity;
          uniform float uStrength;
          uniform float uGravity;
          uniform float uCollapse;
          uniform float uCrush;
          uniform float uShockStrength;
          uniform float uShockRadius;
          uniform float uShockWidth;
          uniform float uCoreRadius;
          uniform float uLensRadius;
          uniform float uTime;

          void main() {
            vec2 pixel = vUv * uResolution;
            vec2 point = pixel - uCenter;
            float radius = length(point);
            vec2 direction = point / max(radius, 0.001);
            vec2 tangent = vec2(-direction.y, direction.x);
            float core = max(uCoreRadius, 10.0);
            float reach = max(uLensRadius, core * 4.2);
            vec2 normalizedPoint = point / max(uResolution * 0.5, vec2(1.0));
            float horizontalEnvelope = 1.0 - smoothstep(0.72, 1.08, abs(normalizedPoint.x));
            float verticalEnvelope = 1.0 - smoothstep(0.58, 1.08, abs(normalizedPoint.y));
            float field = horizontalEnvelope * verticalEnvelope;
            float pressure = clamp(
              uStrength * (0.58 + uGravity * 0.26 + uCollapse * 0.22 + uCrush * 0.16),
              0.0,
              1.16
            );
            float orbitRadius = core * (1.75 + uCollapse * 0.2);
            float orbitBand = exp(-pow(
              (radius - orbitRadius) / max(core * 1.15, 12.0),
              2.0
            ));
            float sideBend = sin(normalizedPoint.x * 2.55)
              * (5.0 + uGravity * 5.0 + uCollapse * 9.0 + uCrush * 11.0)
              * field
              * pressure;
            float ribbonShear = normalizedPoint.y
              * (5.0 + uCollapse * 8.0 + uCrush * 9.0)
              * field
              * pressure
              * (0.5 + abs(normalizedPoint.x) * 0.5);
            float orbitBend = (4.0 + uCollapse * 8.0 + uCrush * 10.0)
              * orbitBand
              * field
              * pressure;
            float breathing = sin(
              normalizedPoint.x * 4.0 - uTime * 0.66
            ) * field * pressure * (0.7 + uCollapse * 1.1);

            float waveWidth = max(uShockWidth, 5.0);
            float waveCoordinate = (radius - uShockRadius) / waveWidth;
            float waveEnvelope = exp(-waveCoordinate * waveCoordinate);
            float shockPull = -waveCoordinate * waveEnvelope
              * uShockStrength
              * (7.0 + waveWidth * 0.12);

            vec2 sourcePixel = pixel
              + vec2(ribbonShear + breathing, sideBend)
              + tangent * orbitBend
              + direction * shockPull;
            vec2 sourceUv = sourcePixel / uResolution;
            float edge = smoothstep(0.0, 0.025, sourceUv.x)
              * smoothstep(0.0, 0.025, sourceUv.y)
              * smoothstep(0.0, 0.025, 1.0 - sourceUv.x)
              * smoothstep(0.0, 0.025, 1.0 - sourceUv.y);
            vec4 titleColor = texture(uTitleTexture, clamp(sourceUv, vec2(0.001), vec2(0.999)));
            float caustic = orbitBand * field * pressure;
            titleColor.rgb *= 1.0 + caustic * 0.12 + waveEnvelope * uShockStrength * 0.08;
            float alpha = titleColor.a * edge * clamp(uOpacity, 0.0, 1.0);
            outputColor = vec4(titleColor.rgb * edge * uOpacity, alpha);
          }
        `;

        const compileShader = (type, source) => {
          const shader = gl.createShader(type);
          if (!shader) return null;
          gl.shaderSource(shader, source);
          gl.compileShader(shader);
          if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
            gl.deleteShader(shader);
            return null;
          }
          return shader;
        };
        const vertexShader = compileShader(gl.VERTEX_SHADER, vertexSource);
        const fragmentShader = compileShader(gl.FRAGMENT_SHADER, fragmentSource);
        if (!vertexShader || !fragmentShader) return null;
        const program = gl.createProgram();
        if (!program) return null;
        gl.attachShader(program, vertexShader);
        gl.attachShader(program, fragmentShader);
        gl.linkProgram(program);
        gl.deleteShader(vertexShader);
        gl.deleteShader(fragmentShader);
        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
          gl.deleteProgram(program);
          return null;
        }
        const vertexArray = gl.createVertexArray();
        const titleTexture = gl.createTexture();
        if (!vertexArray || !titleTexture) {
          if (vertexArray) gl.deleteVertexArray(vertexArray);
          if (titleTexture) gl.deleteTexture(titleTexture);
          gl.deleteProgram(program);
          return null;
        }

        const uniforms = {
          titleTexture: gl.getUniformLocation(program, "uTitleTexture"),
          resolution: gl.getUniformLocation(program, "uResolution"),
          center: gl.getUniformLocation(program, "uCenter"),
          opacity: gl.getUniformLocation(program, "uOpacity"),
          strength: gl.getUniformLocation(program, "uStrength"),
          gravity: gl.getUniformLocation(program, "uGravity"),
          collapse: gl.getUniformLocation(program, "uCollapse"),
          crush: gl.getUniformLocation(program, "uCrush"),
          shockStrength: gl.getUniformLocation(program, "uShockStrength"),
          shockRadius: gl.getUniformLocation(program, "uShockRadius"),
          shockWidth: gl.getUniformLocation(program, "uShockWidth"),
          coreRadius: gl.getUniformLocation(program, "uCoreRadius"),
          lensRadius: gl.getUniformLocation(program, "uLensRadius"),
          time: gl.getUniformLocation(program, "uTime")
        };
        let cssWidth = 0;
        let cssHeight = 0;
        let renderScale = 1;

        const resize = (force = false) => {
          const rect = titleLensCanvas.getBoundingClientRect();
          const nextCssWidth = Math.max(1, rect.width);
          const nextCssHeight = Math.max(1, rect.height);
          const deviceScale = Math.min(window.devicePixelRatio || 1, 1.25);
          const nextRenderScale = Math.min(
            deviceScale,
            1536 / nextCssWidth,
            384 / nextCssHeight
          );
          const pixelWidth = Math.max(1, Math.round(nextCssWidth * nextRenderScale));
          const pixelHeight = Math.max(1, Math.round(nextCssHeight * nextRenderScale));
          const sizeChanged = titleLensCanvas.width !== pixelWidth
            || titleLensCanvas.height !== pixelHeight
            || sourceCanvas.width !== pixelWidth
            || sourceCanvas.height !== pixelHeight;
          cssWidth = nextCssWidth;
          cssHeight = nextCssHeight;
          renderScale = nextRenderScale;
          gl.viewport(0, 0, pixelWidth, pixelHeight);
          if (!force && !sizeChanged) return;
          if (titleLensCanvas.width !== pixelWidth || titleLensCanvas.height !== pixelHeight) {
            titleLensCanvas.width = pixelWidth;
            titleLensCanvas.height = pixelHeight;
          }
          if (sourceCanvas.width !== pixelWidth || sourceCanvas.height !== pixelHeight) {
            sourceCanvas.width = pixelWidth;
            sourceCanvas.height = pixelHeight;
          }

          const style = window.getComputedStyle(title);
          const fontSize = Math.max(1, Number.parseFloat(style.fontSize) * renderScale);
          sourceContext.clearRect(0, 0, pixelWidth, pixelHeight);
          sourceContext.save();
          sourceContext.font = `${style.fontWeight} ${fontSize}px ${style.fontFamily}`;
          sourceContext.textAlign = "center";
          sourceContext.textBaseline = "alphabetic";
          sourceContext.lineJoin = "round";
          const metrics = sourceContext.measureText("Kisara");
          const baseline = pixelHeight * 0.5
            + ((metrics.actualBoundingBoxAscent || fontSize * 0.72)
              - (metrics.actualBoundingBoxDescent || fontSize * 0.16)) * 0.5;
          const gradient = sourceContext.createLinearGradient(0, pixelHeight * 0.16, 0, pixelHeight * 0.86);
          gradient.addColorStop(0, "#ffdce6");
          gradient.addColorStop(0.24, "#ff8ca5");
          gradient.addColorStop(0.58, "#ff315e");
          gradient.addColorStop(1, "#c81343");
          sourceContext.shadowColor = "rgba(255, 45, 96, 0.58)";
          sourceContext.shadowBlur = Math.max(8, 20 * renderScale);
          sourceContext.strokeStyle = "rgba(255, 235, 242, 0.82)";
          sourceContext.lineWidth = Math.max(1.2, 1.8 * renderScale);
          sourceContext.strokeText("Kisara", pixelWidth * 0.5, baseline);
          sourceContext.fillStyle = gradient;
          sourceContext.fillText("Kisara", pixelWidth * 0.5, baseline);
          sourceContext.restore();

          gl.viewport(0, 0, pixelWidth, pixelHeight);
          gl.bindTexture(gl.TEXTURE_2D, titleTexture);
          gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
          gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, true);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
          gl.texImage2D(
            gl.TEXTURE_2D,
            0,
            gl.RGBA,
            gl.RGBA,
            gl.UNSIGNED_BYTE,
            sourceCanvas
          );
        };

        const clear = () => {
          titleLensCanvas.style.opacity = "0";
          titleLensCanvas.dataset.active = "false";
          gl.clearColor(0, 0, 0, 0);
          gl.clear(gl.COLOR_BUFFER_BIT);
        };

        const draw = (parameters) => {
          resize();
          const scaleX = titleLensCanvas.width / Math.max(1, cssWidth);
          const scaleY = titleLensCanvas.height / Math.max(1, cssHeight);
          gl.clearColor(0, 0, 0, 0);
          gl.clear(gl.COLOR_BUFFER_BIT);
          gl.useProgram(program);
          gl.bindVertexArray(vertexArray);
          gl.activeTexture(gl.TEXTURE0);
          gl.bindTexture(gl.TEXTURE_2D, titleTexture);
          gl.uniform1i(uniforms.titleTexture, 0);
          gl.uniform2f(uniforms.resolution, titleLensCanvas.width, titleLensCanvas.height);
          gl.uniform2f(
            uniforms.center,
            parameters.centerX * scaleX,
            (cssHeight - parameters.centerY) * scaleY
          );
          gl.uniform1f(uniforms.opacity, parameters.opacity);
          gl.uniform1f(uniforms.strength, parameters.strength);
          gl.uniform1f(uniforms.gravity, parameters.gravity);
          gl.uniform1f(uniforms.collapse, parameters.collapse);
          gl.uniform1f(uniforms.crush, parameters.crush);
          gl.uniform1f(uniforms.shockStrength, parameters.shockStrength);
          gl.uniform1f(uniforms.shockRadius, parameters.shockRadius * renderScale);
          gl.uniform1f(uniforms.shockWidth, parameters.shockWidth * renderScale);
          gl.uniform1f(uniforms.coreRadius, parameters.coreRadius * renderScale);
          gl.uniform1f(uniforms.lensRadius, parameters.lensRadius * renderScale);
          gl.uniform1f(uniforms.time, parameters.time);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          titleLensCanvas.style.opacity = "1";
          titleLensCanvas.dataset.active = "true";
        };

        const destroy = () => {
          gl.deleteTexture(titleTexture);
          gl.deleteVertexArray(vertexArray);
          gl.deleteProgram(program);
          clear();
        };

        resize();
        clear();
        return { clear, destroy, draw, refresh: () => resize(true), resize };
      };

      const startSpaceLens = () => {
        if (!spaceLensCanvas || reducedMotion) return;
        const generation = ++spaceLensInitGeneration;
        spaceLensCanvas.dataset.state = "loading";
        createSpaceLensRenderer().then((renderer) => {
          if (generation !== spaceLensInitGeneration) {
            renderer?.destroy();
            return;
          }
          spaceLensRenderer = renderer;
          spaceLensCanvas.dataset.state = renderer ? "ready" : "fallback";
        });
      };

      spaceLensCanvas?.addEventListener("webglcontextlost", (event) => {
        event.preventDefault();
        spaceLensInitGeneration += 1;
        spaceLensRenderer = null;
        spaceLensCanvas.style.opacity = "0";
        spaceLensCanvas.dataset.state = "lost";
      }, { passive: false });
      spaceLensCanvas?.addEventListener("webglcontextrestored", () => {
        startSpaceLens();
      }, { passive: true });
      startSpaceLens();

      const startTitleLens = () => {
        if (!titleLensCanvas || reducedMotion) return;
        const generation = ++titleLensInitGeneration;
        titleLensCanvas.dataset.state = "loading";
        const renderer = createTitleLensRenderer();
        if (generation !== titleLensInitGeneration) {
          renderer?.destroy();
          return;
        }
        titleLensRenderer = renderer;
        titleLensCanvas.dataset.state = renderer ? "ready" : "fallback";
      };

      titleLensCanvas?.addEventListener("webglcontextlost", (event) => {
        event.preventDefault();
        titleLensInitGeneration += 1;
        titleLensRenderer = null;
        titleLensCanvas.style.opacity = "0";
        titleLensCanvas.dataset.state = "lost";
        gate.style.setProperty("--kisara-title-source-opacity", "1");
      }, { passive: false });
      titleLensCanvas?.addEventListener("webglcontextrestored", () => {
        startTitleLens();
      }, { passive: true });
      startTitleLens();
      document.fonts?.ready.then(() => titleLensRenderer?.refresh());

      const drawSpaceLens = (timestamp, parameters) => {
        if (!spaceLensRenderer || !spaceLensCanvas) return;
        if (parameters.opacity <= 0.001 || pageMode !== "gate" || document.visibilityState !== "visible") {
          if (spaceLensCanvas.dataset.active === "true") spaceLensRenderer.clear();
          lastSpaceLensPaintTimestamp = 0;
          return;
        }
        const minimumInterval = gate.clientWidth < 640 ? 1000 / 30 : 1000 / 60;
        if (
          lastSpaceLensPaintTimestamp > 0
          && timestamp - lastSpaceLensPaintTimestamp < minimumInterval
        ) return;
        lastSpaceLensPaintTimestamp = timestamp;
        spaceLensRenderer.draw(parameters);
      };

      const drawTitleLens = (timestamp, parameters) => {
        if (!titleLensRenderer || !titleLensCanvas) {
          gate.style.setProperty("--kisara-title-source-opacity", "1");
          return;
        }
        if (parameters.opacity <= 0.001 || pageMode !== "gate" || document.visibilityState !== "visible") {
          if (titleLensCanvas.dataset.active === "true") titleLensRenderer.clear();
          gate.style.setProperty("--kisara-title-source-opacity", "1");
          lastTitleLensPaintTimestamp = 0;
          return;
        }
        const minimumInterval = gate.clientWidth < 640 ? 1000 / 30 : 1000 / 60;
        if (
          lastTitleLensPaintTimestamp > 0
          && timestamp - lastTitleLensPaintTimestamp < minimumInterval
        ) return;
        lastTitleLensPaintTimestamp = timestamp;
        titleLensRenderer.draw(parameters);
        gate.style.setProperty(
          "--kisara-title-source-opacity",
          (1 - parameters.opacity).toFixed(4)
        );
      };

      const glitchAlphabet = "0123456789XZ!?/#@$%&<>";
      const makeGlitchState = (timestamp, burst, released) => {
        const tick = Math.floor(timestamp / 72);
        const patterns = released
          ? ["SIGNAL RELEASED", "CORE WITHOUT LIMIT", "CHANNEL UNBOUND", "OUTPUT OVERRUN"]
          : ["SYSTEM UNSTABLE", "KISARA OVERFLOW", "CONTRACT BREACH", "RED TIDE RISING"];
        const pattern = patterns[Math.floor(randomSeed(tick + 8401) * patterns.length)];
        const corrupted = pattern.split("").map((character, index) => {
          if (character === " " || randomSeed(tick * 31 + index + 8417) < 0.62) return character;
          const glyphIndex = Math.floor(randomSeed(tick * 47 + index + 8461) * glitchAlphabet.length);
          return glitchAlphabet[glyphIndex];
        }).join("");
        const code = Math.floor(randomSeed(tick + 8521) * 0xffffff).toString(16).toUpperCase().padStart(6, "0");
        const noise = Array.from({ length: 4 }, (_, index) => {
          const glyphIndex = Math.floor(randomSeed(tick * 59 + index + 8591) * glitchAlphabet.length);
          return glitchAlphabet[glyphIndex];
        }).join("");
        const phase = burst > 0.72 ? "// BREAK" : "// OVRFLW";
        return `${corrupted} ${phase} ${code} ${noise}`;
      };

      const resizeEnergyCanvas = () => {
        if (!energyCanvas || !energyContext) return;
        const rect = energyCanvas.getBoundingClientRect();
        const width = Math.max(1, Math.round(rect.width));
        const height = Math.max(1, Math.round(rect.height));
        const devicePixelRatio = Math.min(window.devicePixelRatio || 1, 2);
        const pixelWidth = Math.max(1, Math.round(width * devicePixelRatio));
        const pixelHeight = Math.max(1, Math.round(height * devicePixelRatio));
        if (energyCanvas.width !== pixelWidth || energyCanvas.height !== pixelHeight) {
          energyCanvas.width = pixelWidth;
          energyCanvas.height = pixelHeight;
          energyContext.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
        }
        energyCanvasWidth = width;
        energyCanvasHeight = height;
      };

      const resizeBurstCanvas = () => {
        if (!burstCanvas || !burstContext) return;
        const rect = burstCanvas.getBoundingClientRect();
        const width = Math.max(1, Math.round(rect.width));
        const height = Math.max(1, Math.round(rect.height));
        const ratioCap = width < 640 ? 1.25 : 1.5;
        const devicePixelRatio = Math.min(window.devicePixelRatio || 1, ratioCap);
        const pixelWidth = Math.max(1, Math.round(width * devicePixelRatio));
        const pixelHeight = Math.max(1, Math.round(height * devicePixelRatio));
        if (burstCanvas.width !== pixelWidth || burstCanvas.height !== pixelHeight) {
          burstCanvas.width = pixelWidth;
          burstCanvas.height = pixelHeight;
          burstContext.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
        }
        burstCanvasWidth = width;
        burstCanvasHeight = height;
      };

      const drawScreenEnergy = (timestamp) => {
        if (!burstCanvas || !burstContext) return;
        resizeBurstCanvas();
        const width = burstCanvasWidth;
        const height = burstCanvasHeight;
        const context = burstContext;
        context.clearRect(0, 0, width, height);
        if (width <= 1 || height <= 1) return;

        const frameSeconds = screenParticleTimestamp
          ? clamp((timestamp - screenParticleTimestamp) / 1000, 0.008, 0.05)
          : 1 / 60;
        screenParticleTimestamp = timestamp;
        const time = timestamp / 1000;
        const fill = Math.max(energyProgress, 0.012);
        const burst = clamp(burstProgress, 0, 1);
        const intensity = 0.12 + fill * 0.88;
        const densityScale = width < 640 ? 0.62 : width < 960 ? 0.82 : 1;
        const meterWidth = meterShell?.clientWidth || Math.min(620, width * 0.78);
        const meterHeight = meterShell?.clientHeight || 68;
        const meterLeft = meterShell?.offsetLeft ?? (width - meterWidth) / 2;
        const meterTop = meterShell?.offsetTop ?? height * 0.58;
        const localFrontRadius = 5 + fill * 22;
        const localFrontX = clamp(
          meterWidth * fill,
          3,
          Math.max(3, meterWidth - localFrontRadius * 2.2)
        );
        const angleRadians = beamPose.angle * Math.PI / 180;
        const headOffset = (localFrontX - meterWidth * 0.5) * beamPose.scaleX;
        const stableOriginX = clamp(
          meterLeft + meterWidth * 0.5 + beamPose.anchorX + Math.cos(angleRadians) * headOffset,
          width * 0.04,
          width * 0.96
        );
        const stableOriginY = clamp(
          meterTop + meterHeight * 0.5 + beamPose.anchorY + beamPose.lift + Math.sin(angleRadians) * headOffset,
          height * 0.08,
          height * 0.92
        );
        const originX = clamp(stableOriginX + beamPose.shakeX * 0.36, width * 0.04, width * 0.96);
        const originY = clamp(stableOriginY + beamPose.shakeY * 0.36, height * 0.08, height * 0.92);
        const headFrameSeconds = beamHeadTimestamp
          ? clamp((timestamp - beamHeadTimestamp) / 1000, 0.008, 0.05)
          : frameSeconds;
        if (!beamHeadTimestamp || fill <= 0.018) {
          beamHeadX = stableOriginX;
          beamHeadY = stableOriginY;
          beamHeadVelocityX = 0;
          beamHeadVelocityY = 0;
          beamMotionEnergy = 0;
        } else {
          let rawVelocityX = (stableOriginX - beamHeadX) / headFrameSeconds;
          let rawVelocityY = (stableOriginY - beamHeadY) / headFrameSeconds;
          const rawSpeed = Math.hypot(rawVelocityX, rawVelocityY);
          if (rawSpeed > 980) {
            const speedScale = 980 / rawSpeed;
            rawVelocityX *= speedScale;
            rawVelocityY *= speedScale;
          }
          const velocityResponse = 1 - Math.exp(-headFrameSeconds * 10.5);
          beamHeadVelocityX += (rawVelocityX - beamHeadVelocityX) * velocityResponse;
          beamHeadVelocityY += (rawVelocityY - beamHeadVelocityY) * velocityResponse;
          const motionTarget = clamp(Math.hypot(beamHeadVelocityX, beamHeadVelocityY) / 620, 0, 1);
          const motionResponse = 1 - Math.exp(-headFrameSeconds * (motionTarget < beamMotionEnergy ? 8.5 : 5.8));
          beamMotionEnergy += (motionTarget - beamMotionEnergy) * motionResponse;
          beamHeadX = stableOriginX;
          beamHeadY = stableOriginY;
        }
        beamHeadTimestamp = timestamp;
        const maxRadius = Math.hypot(width, height) * 1.18;
        const dissolve = phaseProgress(burst, 0.015, 0.14);
        const releaseBuild = phaseProgress(burst, crossEnd, reformEnd);
        const releasePressure = phaseProgress(burst, 0.855, shockwaveStart);
        const shockwaveLinear = clamp((burst - shockwaveStart) / (detonationStart - shockwaveStart), 0, 1);
        const shockwave = smoothstep(shockwaveLinear);
        const detonationLinear = clamp((burst - detonationStart) / (detonationEnd - detonationStart), 0, 1);
        const detonation = smoothstep(detonationLinear);
        const rainBuild = phaseProgress(burst, rainStart, rainPeak);
        const rainStop = phaseProgress(burst, rainPeak, 1);
        const wakeOpacity = clamp(1 - dissolve, 0, 1);
        const afterglow = phaseProgress(burst, detonationStart, detonationEnd)
          * (1 - phaseProgress(burst, rainPeak, 1));
        const blackHoleBuild = phaseProgress(burst, crossEnd, collapseStart - 0.006);
        const gravityLock = phaseProgress(burst, 0.85, shockwaveStart);
        const collapse = phaseProgress(burst, collapseStart, shockwaveStart);
        const collapseDepth = Math.pow(collapse, 1.48);
        const terminalCrush = phaseProgress(collapse, 0.62, 1);
        const crushCompression = Math.pow(terminalCrush, 1.85);
        const blackHoleFade = 1 - phaseProgress(
          detonationLinear,
          0.08,
          0.78
        );
        const blackHoleOpacity = blackHoleBuild * blackHoleFade;
        const blackHoleAngle = -0.16 + Math.sin(time * 0.43) * 0.025 - collapseDepth * 0.16;

        context.save();
        context.globalCompositeOperation = "lighter";

        if (wakeOpacity > 0.001) {
          const ambientCount = Math.floor((10 + fill * 34) * densityScale);
          for (let index = 0; index < ambientCount; index += 1) {
            const seedX = randomSeed(index + 1201);
            const seedY = randomSeed(index + 1801);
            const speed = 0.18 + seedX * (0.28 + fill * 0.56);
            let x = (seedX * width + Math.sin(time * speed + index) * (5 + fill * 17) + width) % width;
            let y = (seedY * height + Math.cos(time * (speed + 0.17) + index) * (4 + fill * 13) + height) % height;
            const size = 0.42 + seedY * (0.6 + fill * 1.25);
            const gravityX = originX - x;
            const gravityY = originY - y;
            const gravityDistance = Math.max(1, Math.hypot(gravityX, gravityY));
            const gravityFalloff = 1 - clamp(gravityDistance / maxRadius, 0, 1);
            const screenPull = gravityLock * gravityFalloff
              * (0.018 + collapseDepth * 0.12 + crushCompression * 0.075 + shockwave * 0.018);
            x += gravityX * screenPull;
            y += gravityY * screenPull;
            context.globalAlpha = (0.018 + seedX * 0.085) * intensity * wakeOpacity;
            context.fillStyle = fill > 0.56 && index % 3 !== 0 ? "#ff9caf" : "#c5d8ff";
            if (gravityLock > 0.025) {
              const inverseDistance = 1 / gravityDistance;
              const streakLength = gravityLock * gravityFalloff * (3 + seedX * 16);
              context.globalAlpha *= 0.72 + gravityLock * 0.48;
              context.strokeStyle = context.fillStyle;
              context.lineWidth = 0.45 + size * 0.38;
              context.lineCap = "round";
              context.beginPath();
              context.moveTo(x - gravityX * inverseDistance * streakLength, y - gravityY * inverseDistance * streakLength);
              context.lineTo(x, y);
              context.stroke();
            }
            context.beginPath();
            context.arc(x, y, size, 0, Math.PI * 2);
            context.fill();
          }
        }

        if (fill <= 0.018) wakePrimed = false;
        const wakeLimit = width < 640 ? 175 : 280;
        const forwardX = Math.cos(angleRadians);
        const forwardY = Math.sin(angleRadians);
        const normalX = -forwardY;
        const normalY = forwardX;
        const spawnWakeParticle = (launchBoost = 1, primed = false) => {
          const sideNoise = nextParticleRandom() + nextParticleRandom() - 1;
          const sideDirection = sideNoise >= 0 ? 1 : -1;
          const inheritedMotion = 0.64 + nextParticleRandom() * 0.24;
          const slipSpeed = (24 + fill * 72 + nextParticleRandom() * 46) * launchBoost;
          const sideSpeed = sideNoise * (10 + fill * 42)
            * (0.52 + nextParticleRandom() * 0.76)
            * Math.sqrt(launchBoost);
          const exhaustAcceleration = (92 + fill * 238 + nextParticleRandom() * 118) * launchBoost;
          const lateralAcceleration = sideDirection * (22 + fill * 92)
            * (0.42 + Math.abs(sideNoise) * 0.9 + nextParticleRandom() * 0.32);
          let velocityX = beamHeadVelocityX * inheritedMotion - forwardX * slipSpeed + normalX * sideSpeed;
          let velocityY = beamHeadVelocityY * inheritedMotion - forwardY * slipSpeed + normalY * sideSpeed;
          const startGap = 2 + localFrontRadius * 0.3;
          const sideOffset = sideNoise * localFrontRadius * (0.08 + nextParticleRandom() * 0.2);
          const startX = originX - forwardX * startGap + normalX * sideOffset;
          const startY = originY - forwardY * startGap + normalY * sideOffset;
          const warmup = primed ? nextParticleRandom() * (0.08 + fill * 0.22) : 0;
          const warmupExhaust = exhaustAcceleration * warmup;
          const warmupLateral = lateralAcceleration * warmup;
          const x = startX + velocityX * warmup
            - forwardX * warmupExhaust * warmup * 0.5
            + normalX * warmupLateral * warmup * 0.5;
          const y = startY + velocityY * warmup
            - forwardY * warmupExhaust * warmup * 0.5
            + normalY * warmupLateral * warmup * 0.5;
          velocityX += -forwardX * warmupExhaust + normalX * warmupLateral;
          velocityY += -forwardY * warmupExhaust + normalY * warmupLateral;
          const historySeconds = Math.min(frameSeconds, 0.022) * (1.1 + nextParticleRandom() * 0.8);
          wakeParticles.push({
            x,
            y,
            previousX: x - velocityX * historySeconds,
            previousY: y - velocityY * historySeconds,
            velocityX,
            velocityY,
            age: warmup,
            jetLife: 0.58 + nextParticleRandom() * 0.66,
            coastLife: 1.45 + nextParticleRandom() * 1.65,
            life: 7.8 + nextParticleRandom() * 5.6,
            size: 0.58 + nextParticleRandom() * (1 + fill * 1.48),
            phase: nextParticleRandom() * Math.PI * 2,
            curl: (nextParticleRandom() - 0.5) * 2,
            forwardX,
            forwardY,
            normalX,
            normalY,
            exhaustAcceleration,
            lateralAcceleration,
            tint: Math.floor(nextParticleRandom() * 5)
          });
        };

        if (!reducedMotion && wakeOpacity > 0.02 && fill > 0.025 && burst < 0.02) {
          if (!wakePrimed) {
            wakePrimed = true;
            const primeCount = width < 640 ? 18 : width < 960 ? 24 : 30;
            for (let index = 0; index < primeCount && wakeParticles.length < wakeLimit; index += 1) {
              spawnWakeParticle(1.04 + nextParticleRandom() * 0.24, true);
            }
          }
          wakeEmissionBudget += frameSeconds * (14 + fill * 48 + beamMotionEnergy * 44) * densityScale;
          while (wakeEmissionBudget >= 1 && wakeParticles.length < wakeLimit) {
            wakeEmissionBudget -= 1;
            spawnWakeParticle(1 + fill * 0.12 + beamMotionEnergy * 0.12);
          }
        } else {
          wakeEmissionBudget = Math.min(wakeEmissionBudget, 0.95);
        }

        if (wakeOpacity <= 0.001 && wakeParticles.length) wakeParticles.length = 0;

        for (let index = wakeParticles.length - 1; index >= 0; index -= 1) {
          const particle = wakeParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life) {
            wakeParticles[index] = wakeParticles[wakeParticles.length - 1];
            wakeParticles.pop();
            continue;
          }

          particle.previousX = particle.x;
          particle.previousY = particle.y;
          const inJet = particle.age < particle.jetLife;
          const inCoast = particle.age < particle.jetLife + particle.coastLife;
          const jetProgress = clamp(particle.age / particle.jetLife, 0, 1);
          const drag = Math.exp(-frameSeconds * (inJet ? 0.46 : inCoast ? 0.14 : 0.08));
          particle.velocityX *= drag;
          particle.velocityY *= drag;
          if (inJet) {
            const exhaustForce = particle.exhaustAcceleration * (0.52 + (1 - jetProgress) * 0.48);
            const separationForce = particle.lateralAcceleration * (0.24 + jetProgress * 0.76);
            particle.velocityX += (-particle.forwardX * exhaustForce + particle.normalX * separationForce) * frameSeconds;
            particle.velocityY += (-particle.forwardY * exhaustForce + particle.normalY * separationForce) * frameSeconds;
          }
          const particleSpeed = Math.max(1, Math.hypot(particle.velocityX, particle.velocityY));
          const curveX = -particle.velocityY / particleSpeed;
          const curveY = particle.velocityX / particleSpeed;
          if (inCoast) {
            const curveStrength = particle.curl * (inJet ? 2.6 : 3.6) * (0.45 + particle.size * 0.24);
            particle.velocityX += curveX * curveStrength * frameSeconds;
            particle.velocityY += curveY * curveStrength * frameSeconds;
          } else {
            const driftAge = particle.age - particle.jetLife;
            particle.velocityX += Math.sin(particle.phase + driftAge * (0.54 + particle.size * 0.08))
              * frameSeconds * (3.2 + particle.size * 1.4);
            particle.velocityY += Math.cos(particle.phase * 0.73 + driftAge * 0.46)
              * frameSeconds * (2.1 + particle.size * 0.9);
            particle.velocityY -= frameSeconds * (0.52 + particle.size * 0.18);
          }
          particle.x += particle.velocityX * frameSeconds;
          particle.y += particle.velocityY * frameSeconds;

          if (!inJet && !inCoast) {
            if (particle.x < 10 && particle.velocityX < 0) particle.velocityX *= -0.46;
            if (particle.x > width - 10 && particle.velocityX > 0) particle.velocityX *= -0.46;
            if (particle.y < 10 && particle.velocityY < 0) particle.velocityY *= -0.42;
            if (particle.y > height - 10 && particle.velocityY > 0) particle.velocityY *= -0.42;
            particle.x = clamp(particle.x, -20, width + 20);
            particle.y = clamp(particle.y, -20, height + 20);
          }

          const lifeRatio = particle.age / particle.life;
          const fadeIn = smoothstep(clamp(particle.age / 0.14, 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeRatio - 0.74) / 0.26, 0, 1));
          const alpha = fadeIn * fadeOut * (inJet ? 0.68 : inCoast ? 0.54 : 0.42)
            * intensity * wakeOpacity;
          if (alpha <= 0.004) continue;

          context.globalAlpha = alpha;
          context.strokeStyle = particle.tint === 0
            ? "#ffffff"
            : particle.tint < 3
              ? "#ff9bb1"
              : "#bfd6ff";
          context.fillStyle = context.strokeStyle;
          context.lineCap = "round";
          if (inJet || inCoast) {
            const coastFade = inJet ? 1 : 1 - clamp((particle.age - particle.jetLife) / particle.coastLife, 0, 1) * 0.34;
            const trailScale = inJet ? 1.9 + beamMotionEnergy * 0.8 : 1.3;
            const motionX = particle.x - particle.previousX;
            const motionY = particle.y - particle.previousY;
            context.globalAlpha = alpha * coastFade;
            context.lineWidth = particle.size * (inJet ? 0.78 : 0.62);
            context.beginPath();
            context.moveTo(
              particle.previousX - motionX * (trailScale - 1),
              particle.previousY - motionY * (trailScale - 1)
            );
            context.lineTo(particle.x, particle.y);
            context.stroke();
          } else {
            const pulse = 0.76 + Math.sin(time * 1.2 + particle.phase) * 0.24;
            context.globalAlpha = alpha * pulse;
            context.beginPath();
            context.arc(particle.x, particle.y, particle.size * (0.46 + pulse * 0.22), 0, Math.PI * 2);
            context.fill();
          }
        }

        const viewportScale = Math.min(width, height);
        const baseCoreRadius = clamp(viewportScale * 0.09, 28, 82);
        const coreRadius = baseCoreRadius
          * (0.86 + blackHoleBuild * 0.18)
          * (1 - collapseDepth * 0.58)
          * (1 - crushCompression * 0.48)
          * (1 + shockwave * 0.05);
        const diskRadius = coreRadius
          * (3.12 + blackHoleBuild * 0.62)
          * (1 - collapseDepth * 0.18)
          * (1 - crushCompression * 0.16)
          * (1 + shockwave * 0.11);
        const diskFlatten = Math.max(
          0.105,
          (0.27 + blackHoleBuild * 0.055) * (1 - collapseDepth * 0.48 - crushCompression * 0.12)
        );

        const orbitLimit = width < 640 ? 82 : 160;
        const orbitDrive = blackHoleOpacity * (1 - detonationLinear) * (1 - crushCompression * 0.78);
        if (!reducedMotion && orbitDrive > 0.01) {
          orbitEmissionBudget += frameSeconds * (18 + gravityLock * 86) * densityScale;
          while (orbitEmissionBudget >= 1 && orbitParticles.length < orbitLimit) {
            orbitEmissionBudget -= 1;
            orbitParticles.push({
              angle: nextParticleRandom() * Math.PI * 2,
              radius: diskRadius * (1.05 + nextParticleRandom() * 1.55),
              angularVelocity: (0.72 + nextParticleRandom() * 1.08) * (nextParticleRandom() > 0.1 ? 1 : -1),
              radialSpeed: 5 + nextParticleRandom() * 13,
              lane: 0.74 + nextParticleRandom() * 0.34,
              age: 0,
              life: 4.8 + nextParticleRandom() * 5.4,
              size: 0.45 + nextParticleRandom() * 1.35,
              escape: nextParticleRandom() < 0.18,
              tint: Math.floor(nextParticleRandom() * 6)
            });
          }
        } else {
          orbitEmissionBudget = Math.min(orbitEmissionBudget, 0.95);
        }

        const projectOrbit = (angle, radius, lane) => {
          const localX = Math.cos(angle) * radius;
          const localY = Math.sin(angle) * radius * diskFlatten * lane;
          return {
            x: originX + localX * Math.cos(blackHoleAngle) - localY * Math.sin(blackHoleAngle),
            y: originY + localX * Math.sin(blackHoleAngle) + localY * Math.cos(blackHoleAngle)
          };
        };

        for (let index = orbitParticles.length - 1; index >= 0; index -= 1) {
          const particle = orbitParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life || blackHoleOpacity <= 0.001) {
            orbitParticles[index] = orbitParticles[orbitParticles.length - 1];
            orbitParticles.pop();
            continue;
          }
          const previousAngle = particle.angle;
          const previousRadius = particle.radius;
          const orbitAcceleration = 1 + gravityLock * 4.8 + collapseDepth * 5.4 + crushCompression * 9.5;
          particle.angle += particle.angularVelocity * frameSeconds * orbitAcceleration
            * Math.pow(diskRadius / Math.max(coreRadius, particle.radius), 0.46);
          particle.radius -= (
            particle.radialSpeed
            + gravityLock * (11 + particle.size * 7)
            + collapseDepth * (32 + particle.size * 12)
            + crushCompression * (115 + particle.size * 42)
          ) * frameSeconds;

          if (particle.radius <= coreRadius * 1.12) {
            if (
              particle.escape
              && gravityLock > 0.54
              && detonationLinear <= 0.001
              && burstParticles.length < (width < 640 ? 110 : 210)
            ) {
              const escapePoint = projectOrbit(particle.angle, coreRadius * 1.18, particle.lane);
              const tangentAngle = particle.angle + (particle.angularVelocity > 0 ? Math.PI / 2 : -Math.PI / 2) + blackHoleAngle;
              const escapeSpeed = 150 + gravityLock * 260 + nextParticleRandom() * 120;
              burstParticles.push({
                x: escapePoint.x,
                y: escapePoint.y,
                previousX: escapePoint.x,
                previousY: escapePoint.y,
                velocityX: Math.cos(tangentAngle) * escapeSpeed + Math.cos(blackHoleAngle) * escapeSpeed * 0.18,
                velocityY: Math.sin(tangentAngle) * escapeSpeed + Math.sin(blackHoleAngle) * escapeSpeed * 0.18,
                age: 0,
                life: 2.8 + nextParticleRandom() * 3.6,
                size: particle.size * (0.9 + nextParticleRandom() * 0.8),
                drag: 0.3 + nextParticleRandom() * 0.42,
                gravity: 4 + nextParticleRandom() * 14,
                phase: nextParticleRandom() * Math.PI * 2,
                tint: particle.tint,
                shape: nextParticleRandom()
              });
              orbitParticles[index] = orbitParticles[orbitParticles.length - 1];
              orbitParticles.pop();
              continue;
            }
            if (burst < detonationStart && blackHoleOpacity > 0.2 && terminalCrush < 0.72) {
              particle.radius = diskRadius * (1.6 + nextParticleRandom() * 0.92);
              particle.angle += Math.PI * (0.42 + nextParticleRandom() * 0.34);
            } else {
              orbitParticles[index] = orbitParticles[orbitParticles.length - 1];
              orbitParticles.pop();
              continue;
            }
          }

          const previousPoint = projectOrbit(previousAngle, previousRadius, particle.lane);
          const point = projectOrbit(particle.angle, particle.radius, particle.lane);
          particle.previousRenderX = previousPoint.x;
          particle.previousRenderY = previousPoint.y;
          particle.renderX = point.x;
          particle.renderY = point.y;
          particle.depth = Math.sin(particle.angle);
        }

        const drawOrbitParticle = (particle) => {
          const lifeRatio = particle.age / particle.life;
          const fadeIn = smoothstep(clamp(particle.age / 0.14, 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeRatio - 0.72) / 0.28, 0, 1));
          const coreProximity = clamp((particle.radius - coreRadius) / Math.max(1, diskRadius * 1.55), 0, 1);
          context.globalAlpha = fadeIn * fadeOut * blackHoleOpacity * (0.28 + (1 - coreProximity) * 0.56);
          context.strokeStyle = particle.tint === 0
            ? "#ffffff"
            : particle.tint < 4
              ? "#ff89a9"
              : "#b9d4ff";
          context.fillStyle = context.strokeStyle;
          context.lineWidth = particle.size * (0.58 + gravityLock * 0.38);
          context.lineCap = "round";
          context.beginPath();
          context.moveTo(particle.previousRenderX, particle.previousRenderY);
          context.lineTo(particle.renderX, particle.renderY);
          context.stroke();
          if (particle.size > 1.12) {
            context.globalAlpha *= 0.48;
            context.beginPath();
            context.arc(particle.renderX, particle.renderY, particle.size * 0.4, 0, Math.PI * 2);
            context.fill();
          }
        };

        if (blackHoleOpacity > 0.001) {
          context.save();
          context.globalCompositeOperation = "source-over";
          const gravityShade = context.createRadialGradient(
            originX,
            originY,
            coreRadius * 0.4,
            originX,
            originY,
            maxRadius * 0.72
          );
          gravityShade.addColorStop(0, "rgba(1, 1, 8, 0.18)");
          gravityShade.addColorStop(0.22, "rgba(7, 3, 17, 0.12)");
          gravityShade.addColorStop(0.58, "rgba(20, 5, 26, 0.045)");
          gravityShade.addColorStop(1, "rgba(3, 4, 13, 0)");
          context.globalAlpha = blackHoleOpacity * (0.34 + collapse * 0.36);
          context.fillStyle = gravityShade;
          context.fillRect(0, 0, width, height);
          context.restore();

          if (collapse > 0.001 && detonationLinear <= 0.001) {
            context.save();
            context.globalCompositeOperation = "lighter";
            context.lineCap = "round";
            for (let ring = 0; ring < 5; ring += 1) {
              const delayed = phaseProgress(collapse, ring * 0.055, 1);
              if (delayed <= 0.001) continue;
              const ringPlunge = Math.pow(delayed, 1.38);
              const ringRadius = diskRadius * (3.05 - ring * 0.34) * (1 - ringPlunge * 0.9);
              const ringPulse = Math.pow(Math.sin(delayed * Math.PI), 0.68);
              context.globalAlpha = blackHoleOpacity * ringPulse * (0.12 + ring * 0.028 + crushCompression * 0.16);
              context.strokeStyle = ring === 2 ? "rgba(255,248,251,0.94)" : "rgba(255,103,148,0.8)";
              context.lineWidth = 0.7 + delayed * (3.6 - ring * 0.42) + crushCompression * 1.4;
              context.shadowColor = ring === 2 ? "rgba(255,255,255,0.9)" : "rgba(255,55,120,0.9)";
              context.shadowBlur = 7 + delayed * 17 + crushCompression * 12;
              context.beginPath();
              context.ellipse(
                originX,
                originY,
                ringRadius,
                ringRadius * (0.48 + ring * 0.035),
                blackHoleAngle,
                0,
                Math.PI * 2
              );
              context.stroke();
            }

            const inwardCount = width < 640 ? 22 : 34;
            for (let index = 0; index < inwardCount; index += 1) {
              const seed = randomSeed(index + 13701);
              const delayed = phaseProgress(collapse, seed * 0.16, 1);
              if (delayed <= 0.001) continue;
              const angle = seed * Math.PI * 2 + blackHoleAngle + Math.sin(seed * 17.3) * 0.22;
              const outerRadius = Math.max(baseCoreRadius * 4.2, diskRadius * (2.5 + seed * 3.2));
              const innerRadius = coreRadius * (0.3 + seed * 0.36);
              const plunge = clamp(
                Math.pow(delayed, 1.34) + Math.pow(phaseProgress(delayed, 0.58, 1), 2.2) * 0.32,
                0,
                1
              );
              const currentRadius = outerRadius + (innerRadius - outerRadius) * plunge;
              const streakLength = 22 + delayed * (72 + seed * 104) + crushCompression * 46;
              const tangent = angle + Math.PI / 2;
              const curl = (seed - 0.5) * Math.max(diskRadius, baseCoreRadius * 1.4) * 0.28 * delayed
                * (1 - crushCompression * 0.72);
              const endX = originX + Math.cos(angle) * currentRadius + Math.cos(tangent) * curl;
              const endY = originY + Math.sin(angle) * currentRadius * 0.62 + Math.sin(tangent) * curl * 0.62;
              const startX = originX + Math.cos(angle) * (currentRadius + streakLength);
              const startY = originY + Math.sin(angle) * (currentRadius + streakLength) * 0.62;
              const gradient = context.createLinearGradient(startX, startY, endX, endY);
              gradient.addColorStop(0, "rgba(144,181,255,0)");
              gradient.addColorStop(0.55, index % 3 === 0 ? "rgba(195,217,255,0.34)" : "rgba(255,105,151,0.28)");
              gradient.addColorStop(1, index % 4 === 0 ? "rgba(255,255,255,0.9)" : "rgba(255,115,157,0.72)");
              context.globalAlpha = blackHoleOpacity * delayed * (0.16 + seed * 0.26 + crushCompression * 0.16);
              context.strokeStyle = gradient;
              context.lineWidth = 0.5 + delayed * (0.9 + seed * 1.2) + crushCompression * 0.55;
              context.shadowBlur = 3 + delayed * 7 + crushCompression * 5;
              context.beginPath();
              context.moveTo(startX, startY);
              context.quadraticCurveTo(
                originX + Math.cos(angle + (seed - 0.5) * 0.35) * (currentRadius + streakLength * 0.38),
                originY + Math.sin(angle + (seed - 0.5) * 0.35) * (currentRadius + streakLength * 0.38) * 0.62,
                endX,
                endY
              );
              context.stroke();
            }

            const compressionGlowRadius = Math.max(
              5,
              coreRadius * (0.72 + (1 - collapseDepth) * 2.65)
            );
            const compressionGlow = context.createRadialGradient(
              originX,
              originY,
              0,
              originX,
              originY,
              compressionGlowRadius
            );
            compressionGlow.addColorStop(0, "rgba(255,255,255,0.98)");
            compressionGlow.addColorStop(0.16, "rgba(255,214,230,0.86)");
            compressionGlow.addColorStop(0.48, "rgba(255,68,128,0.32)");
            compressionGlow.addColorStop(1, "rgba(255,68,128,0)");
            context.globalAlpha = blackHoleOpacity * Math.pow(collapse, 2.05) * (0.72 + crushCompression * 0.26);
            context.fillStyle = compressionGlow;
            context.fillRect(
              originX - compressionGlowRadius,
              originY - compressionGlowRadius,
              compressionGlowRadius * 2,
              compressionGlowRadius * 2
            );

            if (crushCompression > 0.001) {
              const singularityRadius = Math.max(3.5, baseCoreRadius * (0.31 - crushCompression * 0.19));
              const singularity = context.createRadialGradient(
                originX,
                originY,
                0,
                originX,
                originY,
                singularityRadius
              );
              singularity.addColorStop(0, "rgba(255,255,255,1)");
              singularity.addColorStop(0.18, "rgba(255,239,247,0.98)");
              singularity.addColorStop(0.52, "rgba(255,71,132,0.72)");
              singularity.addColorStop(1, "rgba(255,40,111,0)");
              context.globalAlpha = blackHoleOpacity * Math.pow(crushCompression, 2.6);
              context.fillStyle = singularity;
              context.shadowColor = "rgba(255,75,135,0.96)";
              context.shadowBlur = 12 + crushCompression * 24;
              context.beginPath();
              context.arc(originX, originY, singularityRadius, 0, Math.PI * 2);
              context.fill();
            }
            context.restore();
          }

          context.save();
          context.globalCompositeOperation = "lighter";
          context.shadowBlur = 0;
          for (let lens = 0; lens < 3; lens += 1) {
            const lensPhase = (time * (0.1 + lens * 0.025) + lens * 0.31) % 1;
            const lensRadius = coreRadius * (1.8 + lens * 1.15)
              + lensPhase * maxRadius * (0.2 + gravityLock * 0.18);
            const lensFade = (1 - lensPhase) * blackHoleOpacity * (0.075 + gravityLock * 0.08);
            context.globalAlpha = lensFade;
            context.strokeStyle = lens % 2 === 0 ? "rgba(255, 111, 151, 0.72)" : "rgba(156, 190, 255, 0.64)";
            context.lineWidth = 0.7 + gravityLock * 1.15;
            context.beginPath();
            context.ellipse(
              originX,
              originY,
              lensRadius,
              lensRadius * (0.52 + lens * 0.035),
              blackHoleAngle,
              0,
              Math.PI * 2
            );
            context.stroke();
          }
          context.restore();

          context.save();
          context.globalCompositeOperation = "lighter";
          for (const particle of orbitParticles) {
            if (particle.depth < 0 && particle.renderX !== undefined) drawOrbitParticle(particle);
          }

          context.translate(originX, originY);
          context.rotate(blackHoleAngle);
          const diskGradient = context.createLinearGradient(-diskRadius, 0, diskRadius, 0);
          diskGradient.addColorStop(0, "rgba(111, 157, 255, 0)");
          diskGradient.addColorStop(0.18, "rgba(143, 184, 255, 0.42)");
          diskGradient.addColorStop(0.46, "rgba(255, 89, 137, 0.86)");
          diskGradient.addColorStop(0.58, "rgba(255, 242, 248, 0.98)");
          diskGradient.addColorStop(0.78, "rgba(255, 107, 149, 0.62)");
          diskGradient.addColorStop(1, "rgba(255, 107, 149, 0)");

          for (let band = 0; band < 4; band += 1) {
            context.globalAlpha = blackHoleOpacity * (0.14 + band * 0.038) * (0.78 + gravityLock * 0.54);
            context.strokeStyle = diskGradient;
            context.lineWidth = 1.7 + (4 - band) * (1.7 + gravityLock * 0.82);
            context.shadowColor = band < 2 ? "rgba(140, 181, 255, 0.72)" : "rgba(255, 77, 126, 0.9)";
            context.shadowBlur = 7 + (4 - band) * 3 + gravityLock * 12;
            context.beginPath();
            context.ellipse(
              0,
              0,
              diskRadius * (0.92 + band * 0.035),
              diskRadius * diskFlatten * (0.84 + band * 0.055),
              0,
              Math.PI,
              Math.PI * 2
            );
            context.stroke();
          }

          context.globalAlpha = blackHoleOpacity * (0.17 + gravityLock * 0.16);
          context.strokeStyle = diskGradient;
          context.lineWidth = coreRadius * (0.16 + gravityLock * 0.055);
          context.shadowColor = "rgba(255, 77, 128, 0.88)";
          context.shadowBlur = 22 + gravityLock * 22;
          context.beginPath();
          context.ellipse(0, 0, diskRadius * 1.02, diskRadius * diskFlatten * 0.96, 0, 0, Math.PI * 2);
          context.stroke();

          const halo = context.createRadialGradient(0, 0, coreRadius * 0.7, 0, 0, diskRadius * 1.08);
          halo.addColorStop(0, "rgba(255, 92, 137, 0.14)");
          halo.addColorStop(0.42, "rgba(255, 82, 131, 0.07)");
          halo.addColorStop(0.76, "rgba(139, 176, 255, 0.035)");
          halo.addColorStop(1, "rgba(139, 176, 255, 0)");
          context.globalAlpha = blackHoleOpacity * (0.72 + gravityLock * 0.34);
          context.fillStyle = halo;
          context.fillRect(-diskRadius * 1.12, -diskRadius, diskRadius * 2.24, diskRadius * 2);

          context.globalCompositeOperation = "source-over";
          const horizonRadiusX = coreRadius * 1.08;
          const horizonRadiusY = coreRadius * (1.02 - collapseDepth * 0.16 - crushCompression * 0.1);
          const horizonOpacity = clamp(blackHoleOpacity * 1.45, 0, 1);
          context.globalAlpha = horizonOpacity;
          context.fillStyle = "rgba(0, 0, 0, 1)";
          context.beginPath();
          context.ellipse(0, 0, horizonRadiusX, horizonRadiusY, 0, 0, Math.PI * 2);
          context.fill();

          context.globalCompositeOperation = "lighter";
          context.globalAlpha = blackHoleOpacity * (0.34 + gravityLock * 0.12);
          context.strokeStyle = "rgba(255, 166, 195, 0.7)";
          context.lineWidth = 0.65 + gravityLock * 0.72;
          context.shadowColor = "rgba(255, 66, 123, 0.96)";
          context.shadowBlur = 5 + gravityLock * 8;
          context.beginPath();
          context.ellipse(
            0,
            0,
            horizonRadiusX * 1.02,
            horizonRadiusY * 1.02,
            0,
            0,
            Math.PI * 2
          );
          context.stroke();

          for (let band = 0; band < 3; band += 1) {
            context.globalAlpha = blackHoleOpacity * (0.34 + band * 0.082) * (0.8 + gravityLock * 0.46);
            context.strokeStyle = diskGradient;
            context.lineWidth = 2 + (3 - band) * (2.15 + gravityLock * 0.96);
            context.shadowColor = "rgba(255, 74, 125, 0.9)";
            context.shadowBlur = 8 + (3 - band) * 3 + gravityLock * 14;
            context.beginPath();
            context.ellipse(
              0,
              0,
              diskRadius * (0.9 + band * 0.042),
              diskRadius * diskFlatten * (0.82 + band * 0.06),
              0,
              0,
              Math.PI
            );
            context.stroke();
          }

          const lensingHeight = coreRadius * (1.92 + gravityLock * 0.52);
          for (let sideIndex = 0; sideIndex < 2; sideIndex += 1) {
            const side = sideIndex === 0 ? -1 : 1;
            context.globalAlpha = blackHoleOpacity * (0.3 + gravityLock * 0.34);
            context.strokeStyle = side < 0 ? "rgba(184, 211, 255, 0.78)" : "rgba(255, 170, 195, 0.82)";
            context.lineWidth = 1.3 + gravityLock * 1.35;
            context.shadowColor = context.strokeStyle;
            context.shadowBlur = 8 + gravityLock * 11;
            context.beginPath();
            context.moveTo(-diskRadius * 0.66, side * coreRadius * 0.12);
            context.bezierCurveTo(
              -coreRadius * 1.18,
              side * lensingHeight,
              coreRadius * 1.18,
              side * lensingHeight,
              diskRadius * 0.66,
              side * coreRadius * 0.08
            );
            context.stroke();
          }

          for (let highlight = 0; highlight < 4; highlight += 1) {
            const seed = randomSeed(highlight + 7301);
            const phase = time * (0.42 + seed * 0.5) + seed * Math.PI * 2;
            const span = 0.18 + seed * 0.42;
            context.globalAlpha = blackHoleOpacity * (0.12 + gravityLock * 0.18) * (0.46 + seed * 0.54);
            context.strokeStyle = highlight % 3 === 0 ? "#ffffff" : highlight % 2 === 0 ? "#ff8fab" : "#bed7ff";
            context.lineWidth = 0.55 + seed * 1.15;
            context.shadowBlur = 3 + gravityLock * 7;
            context.beginPath();
            context.ellipse(0, 0, diskRadius * (0.96 + seed * 0.16), diskRadius * diskFlatten, 0, phase, phase + span);
            context.stroke();
          }

          // Keep the event horizon optically empty even when foreground disk
          // streaks and orbit highlights cross its silhouette.
          context.globalCompositeOperation = "source-over";
          context.globalAlpha = horizonOpacity;
          context.shadowBlur = 0;
          context.fillStyle = "rgba(0, 0, 0, 1)";
          context.beginPath();
          context.ellipse(
            0,
            0,
            horizonRadiusX,
            horizonRadiusY,
            0,
            0,
            Math.PI * 2
          );
          context.fill();
          context.restore();

          context.save();
          context.globalCompositeOperation = "lighter";
          for (const particle of orbitParticles) {
            if (particle.depth >= 0 && particle.renderX !== undefined) drawOrbitParticle(particle);
          }
          context.restore();
        }

        const burstLimit = width < 640 ? 110 : 210;
        const spawnBurstWave = (waveIndex) => {
          const count = Math.floor((waveIndex === 0 ? 58 : 82) * densityScale);
          for (let index = 0; index < count && burstParticles.length < burstLimit; index += 1) {
            const angle = nextParticleRandom() * Math.PI * 2;
            const spawnRadius = coreRadius * (0.82 + nextParticleRandom() * 0.92);
            const localX = Math.cos(angle) * spawnRadius;
            const localY = Math.sin(angle) * spawnRadius * diskFlatten;
            const spawnX = originX + localX * Math.cos(blackHoleAngle) - localY * Math.sin(blackHoleAngle);
            const spawnY = originY + localX * Math.sin(blackHoleAngle) + localY * Math.cos(blackHoleAngle);
            const lobeSign = nextParticleRandom() > 0.5 ? 1 : -1;
            const spreadNoise = nextParticleRandom() + nextParticleRandom() - 1;
            const axisAngle = blackHoleAngle + (lobeSign < 0 ? Math.PI : 0);
            const directionAngle = axisAngle + spreadNoise * (waveIndex === 0 ? 0.3 : 0.68);
            const directionX = Math.cos(directionAngle);
            const directionY = Math.sin(directionAngle);
            const swirlDirection = nextParticleRandom() > 0.5 ? 1 : -1;
            const swirlX = -directionY * swirlDirection;
            const swirlY = directionX * swirlDirection;
            const speed = (waveIndex === 0 ? 248 : 174)
              + nextParticleRandom() * (waveIndex === 0 ? 330 : 260);
            const swirlWeight = (waveIndex === 0 ? 0.1 : 0.2) + nextParticleRandom() * 0.12;
            const velocityX = directionX * speed + swirlX * speed * swirlWeight;
            const velocityY = directionY * speed + swirlY * speed * swirlWeight;
            const historyTime = 0.012 + nextParticleRandom() * 0.022;
            burstParticles.push({
              x: spawnX,
              y: spawnY,
              previousX: spawnX - velocityX * historyTime,
              previousY: spawnY - velocityY * historyTime,
              velocityX,
              velocityY,
              age: 0,
              life: 2.05 + nextParticleRandom() * 2.2 + waveIndex * 0.28,
              size: 0.58 + nextParticleRandom() * (1.52 + waveIndex * 0.34),
              drag: 0.38 + nextParticleRandom() * 0.44,
              gravity: 2 + nextParticleRandom() * 12,
              phase: nextParticleRandom() * Math.PI * 2,
              tint: Math.floor(nextParticleRandom() * 6),
              shape: nextParticleRandom(),
              spark: nextParticleRandom() < 0.18
            });
          }
        };

        if (!reducedMotion && shockwaveLinear > 0.001 && shockwaveLinear < 0.9995) {
          const waveRadius = coreRadius * 1.1 + shockwave * maxRadius * 1.08;
          const waveBand = 28 + (1 - shockwave) * 74;
          const waveOuter = Math.max(1, waveRadius + waveBand);
          const innerStop = clamp((waveRadius - waveBand) / waveOuter, 0, 0.96);
          const brightInnerStop = clamp((waveRadius - waveBand * 0.2) / waveOuter, innerStop, 0.985);
          const brightOuterStop = clamp((waveRadius + waveBand * 0.18) / waveOuter, brightInnerStop, 0.995);
          const waveGradient = context.createRadialGradient(originX, originY, 0, originX, originY, waveOuter);
          waveGradient.addColorStop(0, "rgba(3,2,12,0)");
          waveGradient.addColorStop(innerStop, "rgba(7,4,18,0)");
          waveGradient.addColorStop(brightInnerStop, "rgba(255,92,143,0.12)");
          waveGradient.addColorStop(brightOuterStop, "rgba(255,248,251,0.32)");
          waveGradient.addColorStop(1, "rgba(144,181,255,0)");
          context.save();
          context.globalCompositeOperation = "lighter";
          context.globalAlpha = Math.pow(Math.sin(shockwaveLinear * Math.PI), 0.82) * 0.92;
          context.fillStyle = waveGradient;
          context.fillRect(0, 0, width, height);
          context.lineCap = "round";
          for (let ring = 0; ring < 2; ring += 1) {
            const delayed = clamp((shockwaveLinear - ring * 0.09) / (1 - ring * 0.09), 0, 1);
            if (delayed <= 0.001) continue;
            const ringEase = 1 - Math.pow(1 - delayed, 3.4);
            const ringRadius = coreRadius * 1.2 + ringEase * maxRadius * (1.02 + ring * 0.08);
            const ringFade = Math.pow(Math.sin(delayed * Math.PI), 0.9);
            context.globalAlpha = ringFade * (0.34 - ring * 0.1);
            context.strokeStyle = ring === 0 ? "rgba(255,245,249,0.96)" : "rgba(174,203,255,0.82)";
            context.lineWidth = 1 + (1 - delayed) * (6.4 - ring * 1.8);
            context.shadowColor = ring === 0 ? "rgba(255,73,130,0.86)" : "rgba(137,179,255,0.72)";
            context.shadowBlur = 8 + (1 - delayed) * 22;
            context.beginPath();
            context.ellipse(
              originX,
              originY,
              ringRadius,
              ringRadius * (0.72 + ring * 0.06),
              blackHoleAngle,
              0,
              Math.PI * 2
            );
            context.stroke();
          }
          context.restore();
        }

        if (!reducedMotion) {
          const waveThresholds = [0.08, 0.42];
          for (let waveIndex = 0; waveIndex < waveThresholds.length; waveIndex += 1) {
            const waveBit = 1 << waveIndex;
            if (detonationLinear >= waveThresholds[waveIndex] && (burstWaveMask & waveBit) === 0) {
              burstWaveMask |= waveBit;
              spawnBurstWave(waveIndex);
            }
          }
        }

        if (detonationLinear > 0.001 && detonationLinear < 0.9995) {
          const inversionFlash = Math.exp(-Math.pow((detonationLinear - 0.12) / 0.075, 2));
          const ruptureFlash = Math.exp(-Math.pow((detonationLinear - 0.38) / 0.16, 2)) * 0.72;
          const flashStrength = clamp(inversionFlash + ruptureFlash, 0, 1.24);
          const jetRise = phaseProgress(detonationLinear, 0.03, 0.28);
          const jetFall = 1 - phaseProgress(detonationLinear, 0.72, 1);
          const jetStrength = jetRise * jetFall;
          const shockEase = 1 - Math.pow(1 - detonationLinear, 3.2);

          if (flashStrength > 0.002) {
            const flash = context.createRadialGradient(originX, originY, 0, originX, originY, maxRadius * 0.88);
            flash.addColorStop(0, "rgba(255, 255, 255, 0.96)");
            flash.addColorStop(0.07, "rgba(255, 240, 247, 0.82)");
            flash.addColorStop(0.24, "rgba(255, 91, 139, 0.34)");
            flash.addColorStop(0.54, "rgba(160, 101, 255, 0.09)");
            flash.addColorStop(1, "rgba(255, 72, 112, 0)");
            context.globalAlpha = flashStrength * 0.92;
            context.fillStyle = flash;
            context.fillRect(0, 0, width, height);
          }

          if (jetStrength > 0.001) {
            context.save();
            context.translate(originX, originY);
            context.rotate(blackHoleAngle + Math.PI / 2);
            const jetLength = maxRadius * (0.24 + jetStrength * 0.72);
            const jetWidth = coreRadius * (0.1 + jetStrength * 0.62);
            const traceJet = (direction, widthScale = 1, lengthScale = 1, bendScale = 1) => {
              const activeLength = jetLength * lengthScale;
              const activeWidth = jetWidth * widthScale;
              const jetBend = Math.sin(time * (8.2 + jetStrength * 8.6) + direction * 0.9)
                * activeWidth * 0.62 * bendScale;
              context.beginPath();
              context.moveTo(direction * coreRadius * 0.36, -activeWidth * 0.2);
              context.bezierCurveTo(
                direction * activeLength * 0.18,
                -activeWidth + jetBend * 0.1,
                direction * activeLength * 0.7,
                -activeWidth * 0.28 + jetBend * 0.72,
                direction * activeLength,
                jetBend
              );
              context.bezierCurveTo(
                direction * activeLength * 0.7,
                activeWidth * 0.28 + jetBend * 0.72,
                direction * activeLength * 0.18,
                activeWidth + jetBend * 0.1,
                direction * coreRadius * 0.36,
                activeWidth * 0.2
              );
              context.closePath();
            };

            for (const direction of [-1, 1]) {
              const jetGradient = context.createLinearGradient(0, 0, direction * jetLength, 0);
              jetGradient.addColorStop(0, "rgba(255,255,255,0.98)");
              jetGradient.addColorStop(0.08, "rgba(255,216,231,0.92)");
              jetGradient.addColorStop(0.36, "rgba(255,76,130,0.56)");
              jetGradient.addColorStop(0.72, "rgba(153,126,255,0.16)");
              jetGradient.addColorStop(1, "rgba(126,157,255,0)");
              traceJet(direction);
              context.globalAlpha = jetStrength * 0.2;
              context.fillStyle = jetGradient;
              context.shadowColor = "rgba(255, 71, 130, 0.94)";
              context.shadowBlur = 34 + jetStrength * 46;
              context.fill();
              traceJet(direction);
              context.globalAlpha = jetStrength * 0.62;
              context.shadowBlur = 8 + jetStrength * 14;
              context.fill();
              traceJet(direction, 0.3, 0.94, 0.58);
              context.globalAlpha = jetStrength * 0.86;
              context.fillStyle = "rgba(255, 244, 249, 0.88)";
              context.shadowColor = "rgba(255, 188, 213, 0.98)";
              context.shadowBlur = 7 + jetStrength * 12;
              context.fill();
            }
            context.restore();
          }

          for (let ring = 0; ring < 3; ring += 1) {
            const delayed = clamp((detonationLinear - ring * 0.14) / (1 - ring * 0.14), 0, 1);
            if (delayed <= 0) continue;
            const ringEase = 1 - Math.pow(1 - delayed, 3);
            const ringRadius = ringEase * maxRadius * (0.62 + ring * 0.12);
            const ringAlpha = Math.pow(Math.sin(delayed * Math.PI), 1.42) * (0.3 - ring * 0.054);
            context.globalAlpha = ringAlpha;
            context.strokeStyle = ring % 2 === 0 ? "#ffd2dc" : "#c9dcff";
            context.lineWidth = 0.8 + (1 - delayed) * (5.2 - ring * 0.68);
            context.shadowColor = ring % 2 === 0 ? "rgba(255,92,139,0.84)" : "rgba(157,192,255,0.7)";
            context.shadowBlur = 6 + (1 - delayed) * 14;
            context.beginPath();
            context.ellipse(originX, originY, ringRadius, ringRadius * (0.54 + ring * 0.045), blackHoleAngle, 0, Math.PI * 2);
            context.stroke();
          }

          const rushStrength = Math.pow(Math.sin(clamp(detonationLinear / 0.84, 0, 1) * Math.PI), 1.15);
          if (rushStrength > 0.001) {
            const rushCount = 12 + Math.floor(rushStrength * 22);
            for (let index = 0; index < rushCount; index += 1) {
              const seed = randomSeed(index + 9301);
              const angle = seed * Math.PI * 2 + blackHoleAngle + detonationLinear * (0.8 + seed * 1.4);
              const startRadius = coreRadius * (1.1 + seed * 1.7);
              const streakLength = 34 + rushStrength * (110 + seed * 240);
              const startX = originX + Math.cos(angle) * startRadius;
              const startY = originY + Math.sin(angle) * startRadius * 0.66;
              const curveAngle = angle + (seed > 0.5 ? 0.28 : -0.28);
              const endX = originX + Math.cos(curveAngle) * (startRadius + streakLength);
              const endY = originY + Math.sin(curveAngle) * (startRadius + streakLength) * 0.72;
              const streakGradient = context.createLinearGradient(startX, startY, endX, endY);
              streakGradient.addColorStop(0, index % 4 === 0 ? "rgba(255,255,255,0.86)" : "rgba(255,122,157,0.66)");
              streakGradient.addColorStop(0.42, index % 3 === 0 ? "rgba(255,95,143,0.38)" : "rgba(173,194,255,0.26)");
              streakGradient.addColorStop(1, "rgba(140,178,255,0)");
              context.globalAlpha = rushStrength * (0.04 + seed * 0.18);
              context.strokeStyle = streakGradient;
              context.lineWidth = 0.55 + seed * 1.7;
              context.shadowColor = index % 3 === 0 ? "rgba(255,79,130,0.8)" : "rgba(154,188,255,0.62)";
              context.shadowBlur = 3 + rushStrength * 8;
              context.beginPath();
              context.moveTo(startX, startY);
              context.quadraticCurveTo(
                originX + Math.cos(angle + (seed - 0.5) * 0.9) * (startRadius + streakLength * 0.48),
                originY + Math.sin(angle + (seed - 0.5) * 0.9) * (startRadius + streakLength * 0.48) * 0.66,
                endX,
                endY
              );
              context.stroke();
            }
          }

          for (let arcIndex = 0; arcIndex < 8; arcIndex += 1) {
            const seed = randomSeed(arcIndex + 10101);
            const delayed = clamp((detonationLinear - seed * 0.28) / (1 - seed * 0.28), 0, 1);
            if (delayed <= 0) continue;
            const radius = (1 - Math.pow(1 - delayed, 2.7)) * maxRadius * (0.18 + seed * 0.42);
            const startAngle = seed * Math.PI * 2 + detonationLinear * (0.8 + seed * 1.3) + blackHoleAngle;
            const span = 0.22 + seed * 0.9;
            context.globalAlpha = Math.pow(Math.sin(delayed * Math.PI), 1.32) * (0.055 + seed * 0.14);
            context.strokeStyle = arcIndex % 3 === 0 ? "#ffffff" : arcIndex % 2 === 0 ? "#ff9db3" : "#bfd6ff";
            context.lineWidth = 0.65 + (1 - delayed) * (2.2 + seed * 2.8);
            context.shadowColor = context.strokeStyle;
            context.shadowBlur = 4 + (1 - delayed) * 8;
            context.beginPath();
            context.ellipse(
              originX,
              originY,
              radius,
              radius * 0.62,
              blackHoleAngle,
              startAngle,
              startAngle + span
            );
            context.stroke();
          }

          const blastCoreRadius = coreRadius * 0.72 + shockEase * Math.min(width, height) * 0.24;
          const blastCore = context.createRadialGradient(originX, originY, 0, originX, originY, blastCoreRadius);
          blastCore.addColorStop(0, "rgba(255,255,255,0.96)");
          blastCore.addColorStop(0.12, "rgba(255,226,237,0.84)");
          blastCore.addColorStop(0.34, "rgba(255,80,134,0.42)");
          blastCore.addColorStop(0.66, "rgba(164,111,255,0.12)");
          blastCore.addColorStop(1, "rgba(255,74,116,0)");
          context.globalAlpha = Math.pow(1 - detonationLinear, 0.72) * 0.82 + afterglow * 0.24;
          context.fillStyle = blastCore;
          context.fillRect(
            originX - blastCoreRadius,
            originY - blastCoreRadius,
            blastCoreRadius * 2,
            blastCoreRadius * 2
          );
        }

        context.shadowBlur = 0;
        context.shadowColor = "transparent";
        for (let index = burstParticles.length - 1; index >= 0; index -= 1) {
          const particle = burstParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life) {
            burstParticles[index] = burstParticles[burstParticles.length - 1];
            burstParticles.pop();
            continue;
          }
          particle.previousX = particle.x;
          particle.previousY = particle.y;
