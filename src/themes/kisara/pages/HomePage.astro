        signal.addEventListener("abort", abortInitialization, { once: true });
        const generation = ++spaceLensInitGeneration;
        spaceLensCanvas.dataset.state = "loading";
        createGateReconstructionRenderer({
          canvas: spaceLensCanvas, reducedMotion, mobile: mobilePerformance,
          lite: litePerformance, signal: controller.signal, warmup: createTransparentWebglWarmup
        }).then((renderer) => {
          if (disposed || generation !== spaceLensInitGeneration) {
