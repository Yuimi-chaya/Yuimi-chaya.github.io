        for (let index = 0; index <= sampleCount; index += 1) {
          const unit = index / sampleCount;
          const point = pointOnCubicCurve(
            geometry.tail,
            geometry.controlA,
            geometry.controlB,
            geometry.head,
            unit
          );
          const tangent = tangentOnCubicCurve(
            geometry.tail,
            geometry.controlA,
            geometry.controlB,
            geometry.head,
            unit
          );
          const tangentLength = Math.max(0.001, Math.hypot(tangent.x, tangent.y));
          const normalX = -tangent.y / tangentLength;
          const normalY = tangent.x / tangentLength;
          const edgeTaper = Math.sin(unit * Math.PI);
          const softWave = (
            Math.sin(unit * fullTurn * 1.22 - energyFlowPhase)
            + Math.sin(unit * fullTurn * 2.7 + energyFlowPhase + 0.8) * 0.34
