            float liquidPressure = clamp(uLiquidPressure, 0.0, 1.4);
            float flowDirection = uFlowDirection < 0.0 ? -1.0 : 1.0;
            float resolutionScale = clamp(uResolution.x / 900.0, 0.55, 1.28);
            float animatedFlowFront = uFlowFront + sin(uLiquidPhase * 0.24) * 0.022;
            float tiltedFlowCoordinate = vUv.x
              + (vUv.y - 0.5) * 0.13 * flowDirection;
            float flowWidth = mix(0.22, 0.115, clamp(liquidPressure, 0.0, 1.0));
            float flowDistance = (tiltedFlowCoordinate - animatedFlowFront) / max(flowWidth, 0.075);
            float pressureBand = exp(-flowDistance * flowDistance);
            float elasticWake = exp(-abs(flowDistance) * 0.72)
              * (0.26 + liquidPressure * 0.74);
            float flowInfluence = clamp(pressureBand + elasticWake * 0.62, 0.0, 1.28);
            float impactDrive = clamp(
              liquidPressure * 0.78 + abs(uParallax) * 0.48,
              0.14,
              1.15
            );
            float liquidPrimary = sin(
              normalizedPoint.y * 9.4
              + uLiquidPhase * 1.18
              + sin(normalizedPoint.x * 4.8 - uLiquidPhase * 0.42) * 1.25
            );
            float liquidSecondary = sin(
              normalizedPoint.x * 7.6
              - normalizedPoint.y * 5.2
              - uLiquidPhase * 0.82
            );
            float liquidCurl = cos(
              (normalizedPoint.x + normalizedPoint.y * 0.72) * 13.2
              + uLiquidPhase * 1.46
