            float blueTrace = pow(
              max(
                0.0,
                0.5 + 0.5 * sin(
                  sourcePixel.x * 0.048
                  + sourcePixel.y * 0.031
                  + uLiquidPhase * 1.68
                )
              ),
              9.0
            ) * finalFlow * (0.22 + flowInfluence * 0.78);
