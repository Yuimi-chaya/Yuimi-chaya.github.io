          spaceLensRenderer = renderer;
          releaseWarmupState.spaceLens = !renderer;
          releaseWarmupPending.spaceLens = false;
          syncReleaseWarmupState();
          spaceLensCanvas.dataset.state = renderer ? "ready" : "fallback";
          scheduleReleaseWarmup();
        }).catch(() => {
          if (disposed || generation !== spaceLensInitGeneration) return;
          controller.abort();
          spaceLensCanvas.dataset.state = "fallback";
