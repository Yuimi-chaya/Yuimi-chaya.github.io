          && (inputType === "touch" || !homeSectionSnapMedia.matches)) {
          const target = getHomeSectionStopRecords()[1];
          if (target) { event.preventDefault(); smoothScrollToHomeSection(target); return; }
        }
        if (pageMode === "next" && handleHomeSectionInput(delta, event, inputType)) return;
        if (
          pageMode === "next"
          && delta < 0
          && window.scrollY + delta <= getReturnToGateThreshold()
        ) {
          event.preventDefault();
          returnToGate();
        }
      };

      window.addEventListener("wheel", (event) => {
        if (event.ctrlKey || event.metaKey) return;
        const delta = normalizeWheel(event);
        handleDirectionalInput(delta, event, "wheel");
      }, { passive: false, signal });

      opening?.addEventListener("click", (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
        const link = event.target instanceof Element
          ? event.target.closest('a[data-kisara-route-kind="chapter"], a[data-comic-next]')
          : null;
        if (!(link instanceof HTMLAnchorElement)) return;
        const id = link.hasAttribute("data-comic-next") ? "002" : link.dataset.kisaraRouteId;
        const stop = getHomeSectionStopRecords().find(record => record.element.dataset.kisaraHomeStop === id);
        if (!stop) return;
        event.preventDefault();
        if (!comicTransition.active) smoothScrollToHomeSection(stop);
      }, { signal });

      window.addEventListener("keydown", (event) => {
        if (event.ctrlKey || event.metaKey || event.altKey) return;
        if (event.target instanceof Element && event.target.closest("a, button, input, select, textarea, [contenteditable='true']")) return;
        let amount = 0;
        if (event.key === "ArrowDown") amount = 130;
        if (event.key === "ArrowUp") amount = -130;
        if (["PageDown", "End"].includes(event.key)) amount = 300;
        if (["PageUp", "Home"].includes(event.key)) amount = -300;
        if (event.key === " ") amount = event.shiftKey ? -300 : 300;
        if (!amount) return;
        handleDirectionalInput(amount, event, "keyboard");
      }, { signal });

      window.addEventListener("touchstart", (event) => {
        if (event.touches.length !== 1) {
          touchY = null;
          touchId = null;
          return;
        }
        touchId = event.touches[0]?.identifier ?? null;
        touchY = event.touches[0]?.clientY ?? null;
      }, { passive: true, signal });

      window.addEventListener("touchmove", (event) => {
        if (event.touches.length !== 1 || touchId === null) return;
        const touch = Array.from(event.touches).find((item) => item.identifier === touchId);
        const nextY = touch?.clientY ?? null;
        if (touchY === null || nextY === null) return;
        const delta = touchY - nextY;
        touchY = nextY;
        const touchDelta = delta * 2.25;
        handleDirectionalInput(touchDelta, event, "touch");
      }, { passive: false, signal });

      window.addEventListener("touchend", () => {
        touchY = null;
        touchId = null;
      }, { passive: true, signal });

      window.addEventListener("touchcancel", () => {
        touchY = null;
        touchId = null;
      }, { passive: true, signal });

      window.addEventListener("pointermove", handlePostReleasePointer, { passive: true, signal });
      window.addEventListener("pointermove", handleTitleAbyssPointer, { passive: true, signal });
      document.addEventListener("pointerleave", () => {
        postReleasePointerX = null;
        postReleasePointerAccumulator = 0;
        postReleaseTargetX = 0;
        postReleaseTargetY = 0;
        resetTitleAbyssPointer();
      }, { passive: true, signal });

      gate.addEventListener("kisara:scene-ready", () => {
        if (foundSelfActive || lovebrainActive) return;
        render();
        startEnergyAnimation();
      }, { signal });

      autoPlay?.addEventListener("click", () => {
        startHeroAutoplay();
      }, { signal });
      if (autoPlay instanceof HTMLElement) {
        autoPlay.dataset.kisaraRuntimeBound = "true";
      }

      foundSelfSkip?.addEventListener("click", (event) => {
        event.preventDefault();
        leaveFoundSelfSequence();
      }, { signal });

      skip?.addEventListener("click", (event) => {
        event.preventDefault();
        stopHeroAutoplay();
        if (animationFrame) window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
        lastFrameTime = 0;
        velocity = 0;
        burstVelocity = 0;
        releaseMode = "manual";
        releaseTimeline = 0;
        releaseLastTimestamp = 0;
        releasePlaybackRate = 1;
        releaseBoost = 0;
        releaseVisualPressure = 0;
        releaseRewindVeil = 0;
        chargeIntroActive = false;
        chargeIntroStartedAt = 0;
        enterNextPage();
      }, { signal });

      const refreshLayoutSize = () => {
        lastEnergyPaintTimestamp = 0;
        lastSpaceLensPaintTimestamp = 0;
        lastTitleLensPaintTimestamp = 0;
        titleAbyssLastPaintTimestamp = 0;
        resizeEnergyCanvas(true);
        refreshGateEffectLayout(true);
        resizePostReleaseCanvas(true);
        resizeTitleChains(true);
        resizeTitleDataCanvas(true);
        spaceLensRenderer?.resize();
        titleLensRenderer?.resize();
        if (foundSelfActive || lovebrainActive) return;
        startEnergyAnimation();
        startPostReleaseAnimation();
