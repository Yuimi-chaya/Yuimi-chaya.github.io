      let releaseWarmupScheduled = false;
      let releaseWarmupHandle = 0;
      let releaseWarmupUsesIdleCallback = false;
      let releaseWarmupForceRequested = false;
      const releaseWarmupState = {
        spaceLens: reducedMotion,
        titleLens: reducedMotion
      };
      const releaseWarmupPending = {
        spaceLens: false,
        titleLens: false
      };
      const releaseWarmupGeneration = {
        spaceLens: 0,
        titleLens: 0
      };
      const isReleaseWarmupComplete = () => Object.values(releaseWarmupState).every(Boolean);
      const hasReleaseWarmupPending = () => Object.values(releaseWarmupPending).some(Boolean);
      const syncReleaseWarmupState = () => {
        gate.dataset.releaseWarmup = isReleaseWarmupComplete() ? "ready" : "pending";
      };
      const cancelReleaseWarmupSchedule = () => {
        if (!releaseWarmupScheduled || !releaseWarmupHandle) return;
        if (releaseWarmupUsesIdleCallback && "cancelIdleCallback" in window) {
