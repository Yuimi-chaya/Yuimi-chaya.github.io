          if (sourceCanvas.width !== pixelWidth || sourceCanvas.height !== pixelHeight) {
            sourceCanvas.width = pixelWidth;
            sourceCanvas.height = pixelHeight;
          }

          const style = window.getComputedStyle(title);
          const fontSize = Math.max(1, Number.parseFloat(style.fontSize) * renderScale);
          sourceContext.clearRect(0, 0, pixelWidth, pixelHeight);
          sourceContext.save();
          sourceContext.font = `${style.fontWeight} ${fontSize}px ${style.fontFamily}`;
          sourceContext.textAlign = "center";
          sourceContext.textBaseline = "alphabetic";
          sourceContext.lineJoin = "round";
          const metrics = sourceContext.measureText("Kisara");
          const baseline = pixelHeight * 0.5
            + ((metrics.actualBoundingBoxAscent || fontSize * 0.72)
              - (metrics.actualBoundingBoxDescent || fontSize * 0.16)) * 0.5;
          const gradient = sourceContext.createLinearGradient(0, pixelHeight * 0.16, 0, pixelHeight * 0.86);
          gradient.addColorStop(0, "#ffdce6");
          gradient.addColorStop(0.24, "#ff8ca5");
