            titleColor.r = mix(titleColor.r, roseSample.r, finalFlow * (0.18 + liquidPressure * 0.12));
            titleColor.b = mix(titleColor.b, blueSample.b, finalFlow * (0.12 + liquidPressure * 0.12));
