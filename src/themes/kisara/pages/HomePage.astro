        ]);
        const bodyGradient = context.createLinearGradient(
          geometry.tail.x,
          geometry.tail.y,
          geometry.head.x,
          geometry.head.y
        );
        bodyGradient.addColorStop(0, "rgba(104, 158, 255, 0)");
        bodyGradient.addColorStop(0.16, "rgba(129, 178, 255, 0.18)");
        bodyGradient.addColorStop(0.5, "rgba(255, 83, 136, 0.72)");
        bodyGradient.addColorStop(0.82, "rgba(255, 155, 190, 0.96)");
        bodyGradient.addColorStop(1, "rgba(255, 118, 167, 0.98)");

        context.save();
        context.globalCompositeOperation = "lighter";
        const flightEnergy = 0.8 + geometry.flight * 0.2;
