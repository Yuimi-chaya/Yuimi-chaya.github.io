        }
        if (energyTimer) window.clearTimeout(energyTimer);
        if (restoreSyncTimer) window.clearTimeout(restoreSyncTimer);
        if (openingBridgeRecoveryFrame) window.cancelAnimationFrame(openingBridgeRecoveryFrame);
        if (openingBridgeHandoffFrame) window.cancelAnimationFrame(openingBridgeHandoffFrame);
        if (openingTitleBridgeHandoffFrame) {
          window.cancelAnimationFrame(openingTitleBridgeHandoffFrame);
        }
        if (homeSectionWheelTimer) window.clearTimeout(homeSectionWheelTimer);
        if (homeGateReturnTimer) window.clearTimeout(homeGateReturnTimer);
        if (releaseWarmupHandle) {
