          + Math.sin(motionPhases.crossRotation) * (0.7 + crossStrobe * 3.8);
        const crossShakeX = Math.sin(motionPhases.crossShakeX) * (0.35 + crossStrobe * 2.6 + releaseFlash * 2.2);
        const crossShakeY = Math.cos(motionPhases.crossShakeY) * (0.3 + crossStrobe * 2.1 + releaseFlash * 1.8);
        const introKickFade = 1 - phaseProgress(introImpactLinear, 0.58, 1);
        const introKickX = Math.sin(introImpactLinear * Math.PI * 5.2)
          * introImpactPulse * introKickFade * 4.6;
        const introKickY = Math.cos(introImpactLinear * Math.PI * 4.4)
          * introImpactPulse * introKickFade * 2.8;
        const enchantOpacity = clamp(introImpactPulse * 0.92 + introEnchantHold * 0.58, 0, 1);
        const enchantPulse = clamp(
          introImpactPulse * 1.16
            + introEnchantHold * (0.24 + Math.sin(timestamp / 132) * 0.08),
          0,
          1.3
        );
        const enchantFlow = ((timestamp * 0.034 + intro * 178) % 240) - 70;
        beamPose = {
          shakeX,
          shakeY,
          anchorX: beamAnchorX,
          anchorY: beamAnchorY,
          lift: beamLift,
          scaleX: beamScaleX,
          scaleY: beamScaleY,
          angle: beamAngle
        };
        const normalChargeFrame = advanceCharge
          && burst <= 0.001
          && !chargeIntroActive
          && !chargeIntroComplete;
        meterShell?.style.setProperty("--kisara-beam-shake-x", `${shakeX.toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-shake-y", `${shakeY.toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-anchor-x", `${beamAnchorX.toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-anchor-y", `${beamAnchorY.toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-lift", `${beamLift.toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-expansion", beamScaleY.toFixed(4));
        meterShell?.style.setProperty("--kisara-beam-scale-x", beamScaleX.toFixed(4));
        meterShell?.style.setProperty("--kisara-beam-scale-y", beamScaleY.toFixed(4));
        meterShell?.style.setProperty("--kisara-beam-angle", `${beamAngle.toFixed(3)}deg`);
        if (normalChargeFrame) return;
        meterShell?.style.setProperty("--kisara-beam-opacity", beamOpacity.toFixed(3));
        meterShell?.style.setProperty("--kisara-beam-glow", `${(pressure * 12 + detonationRush * 45).toFixed(3)}px`);
        meterShell?.style.setProperty("--kisara-beam-brightness", (1 + pressure * 0.16 + detonationRush * 0.62).toFixed(3));
        gate.style.setProperty("--kisara-enchant-progress", introEnchant.toFixed(4));
        gate.style.setProperty("--kisara-enchant-opacity", enchantOpacity.toFixed(3));
        gate.style.setProperty("--kisara-enchant-pulse", enchantPulse.toFixed(3));
        gate.style.setProperty("--kisara-enchant-flow", `${enchantFlow.toFixed(3)}%`);
        gate.style.setProperty("--kisara-title-impact-x", `${introKickX.toFixed(3)}px`);
        gate.style.setProperty("--kisara-title-impact-y", `${introKickY.toFixed(3)}px`);
        gate.style.setProperty("--kisara-performance-blur", `${performanceBlur.toFixed(3)}px`);
        gate.style.setProperty("--kisara-screen-shake-x", `${screenShakeX.toFixed(3)}px`);
        gate.style.setProperty("--kisara-screen-shake-y", `${screenShakeY.toFixed(3)}px`);
        gate.style.setProperty("--kisara-base-shift-x", `${(-gravityDriftX).toFixed(3)}px`);
        gate.style.setProperty("--kisara-base-shift-y", `${(-gravityDriftY).toFixed(3)}px`);
        gate.style.setProperty("--kisara-fight-shift-x", `${(gravityDriftX * 1.65).toFixed(3)}px`);
        gate.style.setProperty("--kisara-fight-shift-y", `${(gravityDriftY * 1.45).toFixed(3)}px`);
        gate.style.setProperty("--kisara-gravity-scale", gravityScale.toFixed(4));
        gate.style.setProperty("--kisara-title-blur", `${titleBlur.toFixed(3)}px`);
        drawSpaceLens(timestamp, {
          centerX: clamp(warpOriginX / Math.max(1, gate.clientWidth), 0, 1),
          centerY: clamp(1 - warpOriginY / gateHeight, 0, 1),
          reveal: lensReveal,
          opacity: lensOpacity,
          gravity: lensGravity * spaceLensStrengthScale,
          collapse: collapseDepth * (0.62 + spaceLensStrengthScale * 0.38),
          crush: crushCompression * (0.56 + spaceLensStrengthScale * 0.44),
          shockStrength: lensShockStrength * (0.68 + spaceLensStrengthScale * 0.32),
          shockRadius: lensShockRadiusPixels / gateHeight,
          shockWidth: Math.max(8, lensShockWidthPixels * 0.56) / gateHeight,
          coreRadius: lensCoreRadius / gateHeight,
          lensRadius,
          reconstruction: reconstructionLinear,
          reconstructionOpacity,
          time: timestamp / 1000
        });
        drawTitleLens(timestamp, {
          centerX: titleLensCenterX,
          centerY: titleLensCenterY,
          opacity: titleLensOpacity,
          strength: titleWarp * titleLensStrengthScale,
          gravity: lensGravity * (0.72 + titleLensStrengthScale * 0.28),
          collapse: collapseDepth,
          crush: crushCompression,
          shockStrength: lensShockStrength * titleLensStrengthScale,
          shockRadius: lensShockRadiusPixels,
          shockWidth: Math.max(12, lensShockWidthPixels * 0.72),
          coreRadius: lensCoreRadius,
          lensRadius: gateShortSide * (0.42 + gravityPressure * 0.2 + collapseDepth * 0.12),
          release: titleRupture,
          dissolve: titleDissolve,
          sourceOpacity: titleSourceOpacity,
          time: timestamp / 1000
        });
        gate.style.setProperty("--kisara-chromatic-shift", `${chromaticShift.toFixed(3)}px`);
        gate.style.setProperty("--kisara-impact-flash", impactFlash.toFixed(3));
        gate.style.setProperty("--kisara-impact-vignette", impactVignette.toFixed(3));
        gate.style.setProperty("--kisara-impact-scale", impactScale.toFixed(4));
        gate.style.setProperty("--kisara-cross-opacity", crossOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-ray-progress", crossRayProgress.toFixed(4));
        gate.style.setProperty("--kisara-cross-ray-breath", crossRayBreath.toFixed(3));
        gate.style.setProperty("--kisara-cross-core-scale", crossCoreScale.toFixed(3));
        gate.style.setProperty("--kisara-cross-core-opacity", crossCoreOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-ring-progress", crossRingProgress.toFixed(3));
        gate.style.setProperty("--kisara-cross-ring-opacity", crossRingOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-shard-progress", crossShardProgress.toFixed(4));
        gate.style.setProperty("--kisara-cross-shard-opacity", crossShardOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-spark-opacity", crossSparkOpacity.toFixed(3));
        gate.style.setProperty("--kisara-cross-spark-distance", `${crossSparkDistance.toFixed(3)}px`);
        gate.style.setProperty("--kisara-cross-strobe", crossStrobe.toFixed(3));
        gate.style.setProperty("--kisara-cross-scale", crossScale.toFixed(3));
        gate.style.setProperty("--kisara-cross-rotation", `${crossRotation.toFixed(3)}deg`);
        gate.style.setProperty("--kisara-cross-shake-x", `${crossShakeX.toFixed(3)}px`);
        gate.style.setProperty("--kisara-cross-shake-y", `${crossShakeY.toFixed(3)}px`);
        gate.style.setProperty("--kisara-cross-blur", `${(0.08 + crossStrobe * 0.42 + releaseFlash * 0.5).toFixed(3)}px`);
      };

      const updateGlitchState = (timestamp) => {
        if (!state) return;
        const fillComplete = targetProgress >= 0.9995 && progress >= 0.999 && Math.abs(velocity) < 0.001;
        if (!fillComplete) {
          renderedGlitchTick = -1;
          return;
        }
        const tick = Math.floor(timestamp / 72);
        if (tick === renderedGlitchTick) return;
        const burstComplete = targetBurstProgress >= 0.9995
          && burstProgress >= 0.999
          && Math.abs(burstVelocity) < 0.001
          && burstAutoplayComplete;
        state.textContent = makeGlitchState(timestamp, burstProgress, burstComplete);
        renderedGlitchTick = tick;
      };

      const queueEnergyFrame = (delay = 0) => {
        if (!reducedMotion && document.visibilityState === "visible" && pageMode === "gate" && energyLoopActive) {
          if (delay > 0) {
            if (energyTimer) window.clearTimeout(energyTimer);
            energyTimer = window.setTimeout(() => {
              energyTimer = 0;
              if (document.visibilityState === "visible" && pageMode === "gate" && energyLoopActive) {
                energyFrame = window.requestAnimationFrame(drawEnergy);
              } else {
                energyLoopActive = false;
              }
            }, delay);
            return;
          }
          energyFrame = window.requestAnimationFrame(drawEnergy);
          return;
        }
        if (energyTimer) window.clearTimeout(energyTimer);
        energyTimer = 0;
        energyFrame = 0;
        energyLoopActive = false;
      };

      const drawEnergy = (timestamp) => {
        energyFrame = 0;
        if (!energyLoopActive || !energyCanvas || !energyContext) return;
        const releaseSettled = burstAutoplayComplete
          && burstProgress >= 0.999
          && targetBurstProgress >= 0.9995;
        const residualParticleCount = wakeParticles.length
          + orbitParticles.length
          + burstParticles.length
          + rainParticles.length;
        const staticRelease = releaseSettled && residualParticleCount === 0;
        const minimumFrameInterval = releaseSettled
          ? (staticRelease ? 72 : 34)
          : 0;
        if (
          minimumFrameInterval > 0
          && lastEnergyPaintTimestamp > 0
          && timestamp - lastEnergyPaintTimestamp < minimumFrameInterval
        ) {
          queueEnergyFrame(minimumFrameInterval - (timestamp - lastEnergyPaintTimestamp));
          return;
        }
        lastEnergyPaintTimestamp = timestamp;
        if (staticRelease) {
          updateGlitchState(timestamp);
          queueEnergyFrame(minimumFrameInterval);
          return;
        }
        const renderStartedAt = performance.now();
        if (energyCanvasWidth <= 0 || energyCanvasHeight <= 0) resizeEnergyCanvas();
        updateBurstPresentation(timestamp);
        updateGlitchState(timestamp);
        const width = energyCanvasWidth;
        const height = energyCanvasHeight;
        energyContext.clearRect(0, 0, width, height);
        drawScreenEnergy(timestamp);
        if (width <= 1 || height <= 1) {
          updateRenderQuality(timestamp, performance.now() - renderStartedAt);
          queueEnergyFrame();
          return;
        }

        const fill = Math.max(energyProgress, 0.012);
        const flowFrameSeconds = energyFlowTimestamp
          ? clamp((timestamp - energyFlowTimestamp) / 1000, 0.008, 0.05)
          : 1 / 60;
        energyFlowTimestamp = timestamp;
        const flowSpeed = 2.15 + fill * 1.25 + beamMotionEnergy * 0.62;
        energyFlowPhase += flowFrameSeconds * flowSpeed;
        const flowUnit = ((energyFlowPhase / fullTurn) % 1 + 1) % 1;
        const centerY = height / 2;
        const fadeOut = phaseProgress(burstProgress, 0.015, 0.13);
        const detach = phaseProgress(
          chargeIntroProgress,
          chargeHandoffStart,
          chargeHandoffEnd
        );
        const localBeamOpacity = (burstProgress <= 0.001 ? 1 : clamp(1 - fadeOut, 0, 1))
          * (1 - detach);
        const intensity = 0.12 + fill * 0.88;
        const startThickness = 1.05 + fill * 1.7;
        const endThickness = 3.4 + fill * 27;
        const frontRadius = 5.5 + fill * 20;
        const frontX = clamp(width * fill, 3, Math.max(3, width - frontRadius * 2.05));
        const noseLength = Math.min(44, Math.max(7, frontRadius * 1.08 + frontX * 0.028));
        const bodyEndX = Math.max(1, frontX - noseLength);
        const context = energyContext;

        if (localBeamOpacity <= 0.001) {
          updateRenderQuality(timestamp, performance.now() - renderStartedAt);
          queueEnergyFrame();
          return;
        }

        const centerlineAt = (x) => {
          const unit = clamp(x / Math.max(bodyEndX, 1), 0, 1);
          const edgeTaper = Math.sin(unit * Math.PI);
          const primary = Math.sin(unit * fullTurn * 1.22 - energyFlowPhase);
          const secondary = Math.sin(unit * fullTurn * 2.7 + energyFlowPhase + 0.8) * 0.34;
          return centerY + (primary + secondary) * edgeTaper * (1.65 + fill * 5.25);
        };
        const thicknessAt = (x) => {
          const unit = clamp(x / Math.max(bodyEndX, 1), 0, 1);
          const growth = Math.pow(unit, 0.56) * (0.78 + smoothstep(unit) * 0.22);
          const shoulder = Math.exp(-Math.pow((unit - 0.68) / 0.25, 2));
          const tailBloom = smoothstep(clamp(unit / 0.18, 0, 1));
          const body = startThickness * (0.5 + tailBloom * 0.5)
            + (endThickness - startThickness) * growth
            + shoulder * (0.8 + fill * 3.2);
          const breathing = 1 + (
            Math.sin(unit * fullTurn * 2 - energyFlowPhase * 2)
            + Math.sin(unit * fullTurn * 4 + energyFlowPhase) * 0.24
          ) * (0.018 + fill * 0.018);
          return body * breathing;
        };

        const traceBeamEnvelope = () => {
          const segments = Math.max(36, Math.min(96, Math.ceil(bodyEndX / 5.5)));
          const upper = [];
          const lower = [];
          for (let segment = 0; segment <= segments; segment += 1) {
            const x = bodyEndX * segment / segments;
            const localThickness = thicknessAt(x);
            const localCenter = centerlineAt(x);
            upper.push({ x, y: localCenter - localThickness });
            lower.push({ x, y: localCenter + localThickness });
          }
          const noseCenter = centerlineAt(bodyEndX);
          const upperEnd = upper[upper.length - 1];
          const upperPrevious = upper[Math.max(0, upper.length - 2)];
          const lowerEnd = lower[lower.length - 1];
          const lowerPrevious = lower[Math.max(0, lower.length - 2)];
          const upperTangentLength = Math.max(
            0.001,
            Math.hypot(upperEnd.x - upperPrevious.x, upperEnd.y - upperPrevious.y)
          );
          const lowerTangentLength = Math.max(
            0.001,
            Math.hypot(lowerPrevious.x - lowerEnd.x, lowerPrevious.y - lowerEnd.y)
          );
          const upperTangent = {
            x: (upperEnd.x - upperPrevious.x) / upperTangentLength,
            y: (upperEnd.y - upperPrevious.y) / upperTangentLength
          };
          const lowerTangent = {
            x: (lowerPrevious.x - lowerEnd.x) / lowerTangentLength,
            y: (lowerPrevious.y - lowerEnd.y) / lowerTangentLength
          };
          const shoulderReach = Math.min(noseLength * 0.74, frontRadius * 0.92);
          const tipControlY = frontRadius * 0.86;
          const path = new Path2D();
          path.moveTo(upper[0].x, upper[0].y);
          for (let index = 1; index < upper.length; index += 1) {
            path.lineTo(upper[index].x, upper[index].y);
          }
          path.bezierCurveTo(
            upperEnd.x + upperTangent.x * shoulderReach,
            upperEnd.y + upperTangent.y * shoulderReach,
            frontX,
            noseCenter - tipControlY,
            frontX,
            noseCenter
          );
          path.bezierCurveTo(
            frontX,
            noseCenter + tipControlY,
            lowerEnd.x - lowerTangent.x * shoulderReach,
            lowerEnd.y - lowerTangent.y * shoulderReach,
            lowerEnd.x,
            lowerEnd.y
          );
          for (let index = lower.length - 2; index >= 0; index -= 1) {
            path.lineTo(lower[index].x, lower[index].y);
          }
          path.closePath();
          return path;
        };

        context.save();
        context.globalCompositeOperation = "lighter";
        const beamGradient = context.createLinearGradient(0, 0, frontX, 0);
        beamGradient.addColorStop(0, "rgba(100, 150, 255, 0.035)");
        beamGradient.addColorStop(0.1, "rgba(112, 161, 255, 0.1)");
        beamGradient.addColorStop(0.34, "rgba(147, 187, 255, 0.3)");
        beamGradient.addColorStop(0.62, "rgba(255, 108, 150, 0.7)");
        beamGradient.addColorStop(0.84, "rgba(255, 191, 211, 0.94)");
        beamGradient.addColorStop(1, "rgba(255, 255, 255, 0.99)");

        const beamEnvelope = traceBeamEnvelope();
        context.globalAlpha = localBeamOpacity * intensity * 0.16;
        context.fillStyle = beamGradient;
        context.shadowColor = "rgba(255, 83, 127, 0.88)";
        context.shadowBlur = 24 + fill * 22;
        context.fill(beamEnvelope);

        context.globalAlpha = localBeamOpacity * intensity * 0.82;
        context.shadowColor = "rgba(255, 124, 158, 0.92)";
        context.shadowBlur = 7 + fill * 10;
        context.fill(beamEnvelope);

        context.save();
        context.clip(beamEnvelope);
        context.shadowBlur = 0;

        const coreGradient = context.createLinearGradient(0, 0, frontX, 0);
        coreGradient.addColorStop(0, "rgba(170, 204, 255, 0)");
        coreGradient.addColorStop(0.3, "rgba(183, 211, 255, 0.12)");
        coreGradient.addColorStop(0.72, "rgba(255, 191, 211, 0.34)");
        coreGradient.addColorStop(1, "rgba(255, 255, 255, 0.72)");
        context.globalAlpha = localBeamOpacity * intensity * 0.6;
        context.fillStyle = coreGradient;
        context.fillRect(0, 0, frontX, height);

        const helixGradient = context.createLinearGradient(0, 0, frontX, 0);
        helixGradient.addColorStop(0, "rgba(155, 195, 255, 0)");
        helixGradient.addColorStop(0.2, "rgba(169, 205, 255, 0.18)");
        helixGradient.addColorStop(0.66, "rgba(255, 126, 163, 0.76)");
        helixGradient.addColorStop(0.91, "rgba(255, 239, 246, 0.96)");
        helixGradient.addColorStop(1, "rgba(255, 255, 255, 0)");
        const helixShadowGradient = context.createLinearGradient(0, 0, frontX, 0);
        helixShadowGradient.addColorStop(0, "rgba(31, 61, 132, 0)");
        helixShadowGradient.addColorStop(0.22, "rgba(49, 82, 160, 0.34)");
        helixShadowGradient.addColorStop(0.66, "rgba(129, 26, 78, 0.42)");
        helixShadowGradient.addColorStop(0.94, "rgba(185, 43, 96, 0.16)");
        helixShadowGradient.addColorStop(1, "rgba(185, 43, 96, 0)");
        const helixSegments = Math.max(
          38,
          Math.round((width < 420 ? 54 : 72) * (0.78 + renderQuality * 0.22))
        );
        const helixStrands = 3;
        for (let strand = 0; strand < helixStrands; strand += 1) {
          const strandOffset = strand * fullTurn / helixStrands;
          const strandSamples = [];
          for (let segment = 0; segment <= helixSegments; segment += 1) {
              const x = bodyEndX * segment / helixSegments;
              const unit = x / Math.max(bodyEndX, 1);
              const localThickness = thicknessAt(x) * (0.8 + strand * 0.035);
              const spiralPhase = unit * fullTurn * 3 - energyFlowPhase * 2 + strandOffset;
              const counterPhase = unit * fullTurn * 6 + energyFlowPhase + strandOffset * 0.5;
            strandSamples.push({
              x,
              y: centerlineAt(x)
                + Math.sin(spiralPhase) * localThickness * (0.4 + strand * 0.025)
                + Math.sin(counterPhase) * localThickness * 0.05,
              depth: Math.cos(spiralPhase),
              unit
            });
          }
          for (let depthPass = 0; depthPass < 2; depthPass += 1) {
            const frontPass = depthPass === 1;
            context.globalCompositeOperation = frontPass ? "lighter" : "source-over";
            context.strokeStyle = frontPass ? helixGradient : helixShadowGradient;
            context.lineCap = "round";
            const depthBuckets = Array.from({ length: 4 }, () => new Path2D());
            for (let segment = 1; segment < strandSamples.length; segment += 1) {
              const previous = strandSamples[segment - 1];
              const point = strandSamples[segment];
              const midpointUnit = (previous.unit + point.unit) * 0.5;
              const midpointDepth = (previous.depth + point.depth) * 0.5;
              const depthWeight = frontPass
                ? smoothstep(clamp((midpointDepth + 0.34) / 1.34, 0, 1))
                : smoothstep(clamp((0.34 - midpointDepth) / 1.34, 0, 1));
              const edgeFade = smoothstep(clamp(midpointUnit / 0.13, 0, 1))
                * (1 - smoothstep(clamp((midpointUnit - 0.88) / 0.12, 0, 1)));
              const visibility = edgeFade * (0.28 + depthWeight * 0.72);
              if (visibility <= 0.018) continue;
              const bucket = Math.min(depthBuckets.length - 1, Math.floor(visibility * depthBuckets.length));
              depthBuckets[bucket].moveTo(previous.x, previous.y);
              depthBuckets[bucket].lineTo(point.x, point.y);
            }
            const baseAlpha = localBeamOpacity * intensity * (frontPass ? 0.7 : 0.24);
            const baseWidth = frontPass ? 1.05 + fill * 2.15 : 0.62 + fill * 1.02;
            for (let bucket = 0; bucket < depthBuckets.length; bucket += 1) {
              const bucketWeight = (bucket + 0.5) / depthBuckets.length;
              context.globalAlpha = baseAlpha * bucketWeight;
              context.lineWidth = baseWidth * (0.72 + bucketWeight * 0.4);
              context.stroke(depthBuckets[bucket]);
            }
          }
        }
        context.globalCompositeOperation = "lighter";

        const compressionCount = width < 420 ? 3 : 5;
        for (let pulse = 0; pulse < compressionCount; pulse += 1) {
          const travel = (flowUnit + pulse / compressionCount) % 1;
          const wrapFade = smoothstep(clamp(travel / 0.13, 0, 1))
            * (1 - smoothstep(clamp((travel - 0.84) / 0.16, 0, 1)));
          const x = bodyEndX * (0.1 + travel * 0.86);
          const localThickness = thicknessAt(x);
          context.globalAlpha = localBeamOpacity * intensity * wrapFade * (0.14 + beamMotionEnergy * 0.18);
          context.strokeStyle = pulse % 2 === 0 ? "rgba(255, 245, 249, 0.9)" : "rgba(178, 211, 255, 0.82)";
          context.lineWidth = 0.55 + fill * 0.9;
          context.beginPath();
            context.ellipse(
              x,
              centerlineAt(x),
            1.4 + fill * 2.8 + beamMotionEnergy * 2.6,
            localThickness * (0.18 + fill * 0.1),
            0,
            0,
            Math.PI * 2
          );
          context.stroke();
        }

        const fragmentCount = width < 420 ? 12 : 20;
        for (let fragment = 0; fragment < fragmentCount; fragment += 1) {
          const seed = randomSeed(fragment + 11401);
          const speedBand = 1 + fragment % 3;
          const travel = (flowUnit * speedBand + seed * 1.73) % 1;
          const wrapFade = smoothstep(clamp(travel / 0.12, 0, 1))
            * (1 - smoothstep(clamp((travel - 0.82) / 0.18, 0, 1)));
          const x = bodyEndX * (0.06 + travel * 0.9);
          const localThickness = thicknessAt(x) * 0.78;
          const spiralPhase = travel * fullTurn * (3 + fragment % 2)
            - energyFlowPhase * (1 + fragment % 2)
            + seed * fullTurn;
          const depth = 0.5 + Math.cos(spiralPhase) * 0.5;
          const y = centerlineAt(x) + Math.sin(spiralPhase) * localThickness * (0.28 + seed * 0.18);
          const size = (0.72 + fill * 1.5 + beamMotionEnergy * 0.42)
            * (0.62 + seed * 0.72)
            * (0.68 + depth * 0.5);
          context.save();
          context.translate(x, y);
          context.rotate(0.18 + Math.sin(spiralPhase) * 0.52 + seed * 0.38);
          context.globalAlpha = localBeamOpacity * intensity * wrapFade * (0.2 + depth * 0.62);
          context.fillStyle = fragment % 4 === 0
            ? "#ffffff"
            : fragment % 2 === 0
              ? "#ffacc0"
              : "#bfd6ff";
          context.beginPath();
          context.moveTo(size * 1.75, 0);
          context.lineTo(-size * 0.42, size * 0.7);
          context.lineTo(-size * 1.08, 0);
          context.lineTo(-size * 0.42, -size * 0.7);
          context.closePath();
          context.fill();
          context.restore();
        }

        const frontCenterY = centerlineAt(bodyEndX);
        const headCoreX = frontX - frontRadius * 0.48;
        const headGlow = context.createRadialGradient(headCoreX, frontCenterY, 0, headCoreX, frontCenterY, frontRadius * 1.35);
        headGlow.addColorStop(0, "rgba(255, 255, 255, 0.98)");
        headGlow.addColorStop(0.24, "rgba(255, 244, 248, 0.9)");
        headGlow.addColorStop(0.62, "rgba(255, 104, 145, 0.36)");
        headGlow.addColorStop(1, "rgba(255, 86, 128, 0)");
        context.globalAlpha = localBeamOpacity * intensity;
        context.fillStyle = headGlow;
        context.fillRect(headCoreX - frontRadius * 1.35, frontCenterY - frontRadius * 1.35, frontRadius * 2.7, frontRadius * 2.7);
        context.restore();

        const overcharge = phaseProgress(fill, 0.46, 0.74);
        if (overcharge > 0.001) {
          context.save();
          context.globalCompositeOperation = "lighter";
          context.lineCap = "round";
          const orbitSegments = Math.max(
            30,
            Math.round((width < 420 ? 36 : 48) * (0.8 + renderQuality * 0.2))
          );
          for (let strand = 0; strand < 3; strand += 1) {
            const phaseOffset = strand * fullTurn / 3 + energyFlowPhase * (strand % 2 === 0 ? -1 : 1);
            const orbitSamples = [];
            for (let segment = 0; segment <= orbitSegments; segment += 1) {
              const unit = 0.12 + segment / orbitSegments * 0.88;
              const x = bodyEndX * unit;
              const localThickness = thicknessAt(x);
              const orbitPhase = unit * fullTurn * (1.18 + strand * 0.16) + phaseOffset;
              const edgeFade = Math.sin(clamp((unit - 0.1) / 0.9, 0, 1) * Math.PI);
              const orbitRadius = (localThickness * (1.12 + strand * 0.12) + 2.5 + overcharge * 4.8)
                * edgeFade;
              orbitSamples.push({
                x: x + Math.cos(orbitPhase) * (1.8 + overcharge * 3.2),
                y: centerlineAt(x) + Math.sin(orbitPhase) * orbitRadius,
                depth: Math.cos(orbitPhase)
              });
            }
            context.strokeStyle = strand === 1
              ? "rgba(139, 181, 255, 0.92)"
              : "rgba(255, 226, 237, 0.98)";
            context.shadowColor = strand === 1
              ? "rgba(111, 160, 255, 0.82)"
              : "rgba(255, 77, 132, 0.9)";
            for (let pass = 0; pass < 2; pass += 1) {
              const frontPass = pass === 1;
              context.shadowBlur = frontPass ? 6 + overcharge * 9 : 2;
              const depthBuckets = Array.from({ length: 4 }, () => new Path2D());
              for (let segment = 1; segment < orbitSamples.length; segment += 1) {
                const previous = orbitSamples[segment - 1];
                const point = orbitSamples[segment];
                const midpointDepth = (previous.depth + point.depth) * 0.5;
                const depthWeight = frontPass
                  ? smoothstep(clamp((midpointDepth + 0.3) / 1.3, 0, 1))
                  : smoothstep(clamp((0.3 - midpointDepth) / 1.3, 0, 1));
                const visibility = 0.26 + depthWeight * 0.74;
                const bucket = Math.min(depthBuckets.length - 1, Math.floor(visibility * depthBuckets.length));
                depthBuckets[bucket].moveTo(previous.x, previous.y);
                depthBuckets[bucket].lineTo(point.x, point.y);
              }
              const baseAlpha = localBeamOpacity * overcharge * (frontPass ? 0.68 : 0.25);
              const baseWidth = frontPass ? 1.15 + overcharge * 1.75 : 0.7 + overcharge * 0.58;
              for (let bucket = 0; bucket < depthBuckets.length; bucket += 1) {
                const bucketWeight = (bucket + 0.5) / depthBuckets.length;
                context.globalAlpha = baseAlpha * bucketWeight;
                context.lineWidth = baseWidth * (0.74 + bucketWeight * 0.36);
                context.stroke(depthBuckets[bucket]);
              }
            }
          }

          const haloCount = width < 420 ? 2 : 3;
          for (let halo = 0; halo < haloCount; halo += 1) {
            const pulse = 0.5 + Math.sin(energyFlowPhase * (2 + halo) + halo * 2.2) * 0.5;
            const haloX = bodyEndX * (0.58 + halo * 0.12);
            const haloY = centerlineAt(haloX);
            const haloThickness = thicknessAt(haloX);
            context.globalAlpha = localBeamOpacity * overcharge * (0.26 + pulse * 0.22);
            context.strokeStyle = halo % 2 === 0
              ? "rgba(255, 241, 246, 0.96)"
              : "rgba(151, 191, 255, 0.88)";
            context.lineWidth = 0.8 + overcharge * 1.15;
            context.shadowColor = halo % 2 === 0
              ? "rgba(255, 88, 139, 0.92)"
              : "rgba(111, 160, 255, 0.84)";
            context.shadowBlur = 7 + pulse * 8;
            context.beginPath();
            context.ellipse(
              haloX,
              haloY,
              6 + overcharge * (10 + halo * 4),
              haloThickness * (1.12 + overcharge * 0.3),
              -0.12 + halo * 0.1,
              -Math.PI * (0.78 + pulse * 0.08),
              Math.PI * (0.78 + pulse * 0.08)
            );
            context.stroke();
          }
          context.restore();
        }

        const auraGlow = context.createRadialGradient(
          frontX - frontRadius * 0.34,
          frontCenterY,
          frontRadius * 0.12,
          frontX - frontRadius * 0.34,
          frontCenterY,
          frontRadius * 1.7
        );
        auraGlow.addColorStop(0, "rgba(255, 250, 252, 0.34)");
        auraGlow.addColorStop(0.42, "rgba(255, 105, 145, 0.16)");
        auraGlow.addColorStop(1, "rgba(255, 91, 131, 0)");
        context.globalAlpha = localBeamOpacity * intensity * 0.72;
        context.fillStyle = auraGlow;
        context.beginPath();
        context.ellipse(
          frontX - frontRadius * 0.34,
          frontCenterY,
          frontRadius * 1.72,
          frontRadius * 1.28,
          0,
          0,
          Math.PI * 2
        );
        context.fill();

        const impactStrength = clamp(fill * 0.34 + beamMotionEnergy * 0.92, 0, 1.18);
        if (impactStrength > 0.025) {
          context.save();
          context.globalCompositeOperation = "lighter";
          context.translate(frontX - frontRadius * 0.2, frontCenterY);
          for (let ring = 0; ring < 2; ring += 1) {
            const pulse = 0.5 + Math.sin(energyFlowPhase * (3 + ring) + ring * 1.4) * 0.5;
            context.globalAlpha = localBeamOpacity * impactStrength * (0.22 - ring * 0.065) * (0.72 + pulse * 0.28);
            context.strokeStyle = ring === 0 ? "rgba(255, 252, 253, 0.96)" : "rgba(255, 112, 151, 0.76)";
            context.lineWidth = 0.8 + fill * 1.3 + beamMotionEnergy * 1.2;
            context.beginPath();
            context.ellipse(
              0,
              0,
              frontRadius * (0.28 + ring * 0.24 + beamMotionEnergy * 0.18),
              frontRadius * (0.72 + ring * 0.42 + impactStrength * 0.25),
              0,
              -Math.PI * 0.72,
              Math.PI * 0.72
            );
            context.stroke();
          }
          const impactFlare = context.createLinearGradient(-frontRadius * 2.8, 0, frontRadius * 0.9, 0);
          impactFlare.addColorStop(0, "rgba(255, 94, 139, 0)");
          impactFlare.addColorStop(0.72, "rgba(255, 121, 158, 0.12)");
          impactFlare.addColorStop(1, "rgba(255, 255, 255, 0.82)");
          context.globalAlpha = localBeamOpacity * impactStrength * 0.48;
          context.fillStyle = impactFlare;
          context.beginPath();
          context.moveTo(-frontRadius * (2.4 + beamMotionEnergy * 1.4), -frontRadius * 0.08);
          context.lineTo(frontRadius * 0.7, -frontRadius * (0.22 + impactStrength * 0.12));
          context.lineTo(frontRadius * 0.7, frontRadius * (0.22 + impactStrength * 0.12));
          context.lineTo(-frontRadius * (2.4 + beamMotionEnergy * 1.4), frontRadius * 0.08);
          context.closePath();
          context.fill();
          context.restore();
        }

        context.restore();

        updateRenderQuality(timestamp, performance.now() - renderStartedAt);
        queueEnergyFrame();
      };

      const startEnergyAnimation = () => {
        if (!energyContext || pageMode !== "gate" || energyLoopActive) return;
        energyLoopActive = true;
        if (reducedMotion) {
          drawEnergy(performance.now());
          return;
        }
        if (document.visibilityState === "visible") {
          energyFrame = window.requestAnimationFrame(drawEnergy);
        } else {
          energyLoopActive = false;
        }
      };

      const render = () => {
        const fill = clamp(progress, 0, 1);
        const percent = Math.round(progress * 100);
        const fillComplete = targetProgress >= 0.9995 && fill >= 0.999 && Math.abs(velocity) < 0.001;
        const burstComplete = fillComplete
          && chargeIntroComplete
          && targetBurstProgress >= 0.9995
          && burstProgress >= 0.999
          && Math.abs(burstVelocity) < 0.001
          && burstAutoplayComplete;
        const tideVisible = fill > 0.0005;
        const reveal = smoothstep(clamp((fill - 0.025) / 0.975, 0, 1));
        const glossSweep = phaseProgress(burstProgress, 0.01, 0.3);
        const glossPosition = -18 + glossSweep * 136;
        const glossOpacity = Math.sin(glossSweep * Math.PI) * (1 - phaseProgress(burstProgress, 0.3, glossFadeEnd)) * 0.98;
        const crestOpacity = fill <= 0.002 || fill >= 0.998
          ? 0
          : Math.min(0.92, 0.54 + Math.abs(velocity) * 42);
        const crestDrift = clamp(velocity * 820, -4.5, 4.5);

        gate.style.setProperty("--kisara-fill", `${(fill * 100).toFixed(3)}%`);
        gate.style.setProperty("--kisara-burst-progress", `${(burstProgress * 100).toFixed(3)}%`);
        gate.style.setProperty("--kisara-gloss-position", `${glossPosition.toFixed(3)}%`);
        gate.style.setProperty("--kisara-gloss-opacity", glossOpacity.toFixed(3));
        gate.style.setProperty("--kisara-tide-opacity", tideVisible ? "1" : "0");
        gate.style.setProperty("--kisara-crest-opacity", crestOpacity.toFixed(3));
        gate.style.setProperty("--kisara-crest-drift", `${crestDrift.toFixed(3)}px`);
        gate.style.setProperty("--kisara-bg-blur", `${(reveal * 12).toFixed(3)}px`);
        gate.style.setProperty("--kisara-bg-opacity", (0.98 - reveal * 0.66).toFixed(3));
        gate.style.setProperty("--kisara-bg-saturation", (1 - reveal * 0.26).toFixed(3));
        gate.style.setProperty("--kisara-bg-brightness", (1 - reveal * 0.14).toFixed(3));
        gate.style.setProperty("--kisara-fight-opacity", (reveal * 0.98).toFixed(3));
        gate.style.setProperty("--kisara-fight-blur", `${((1 - reveal) * 15).toFixed(3)}px`);
        gate.style.setProperty("--kisara-fight-scale", (1.06 - reveal * 0.06).toFixed(4));
        gate.style.setProperty("--kisara-fight-saturation", (0.84 + reveal * 0.36).toFixed(3));
        gate.style.setProperty("--kisara-fight-brightness", (0.86 + reveal * 0.22).toFixed(3));
        energyProgress = fill;
        updateBurstPresentation(performance.now(), false);
        startEnergyAnimation();
        const stage = fillComplete ? "glitch" : "contract";
        const glitchTick = fillComplete ? Math.floor(performance.now() / 72) : -1;
        if (state && (percent !== renderedPercent || stage !== renderedStage || glitchTick !== renderedGlitchTick)) {
          state.textContent = fillComplete
            ? makeGlitchState(performance.now(), burstProgress, burstComplete)
            : `CONTRACT ${String(percent).padStart(3, "0")}%`;
          renderedPercent = percent;
          renderedStage = stage;
          renderedGlitchTick = glitchTick;
        }
        gate.classList.toggle("is-complete", fillComplete);
        gate.classList.toggle("is-enchanting", chargeIntroActive);
        gate.classList.toggle("is-enchanted", chargeIntroComplete && fillComplete);
        gate.classList.toggle("is-bursting", burstProgress > 0.001 && !burstComplete);
        gate.classList.toggle("is-burst-complete", burstComplete);
        gate.classList.toggle("is-released", pageMode === "next");
        gate.classList.toggle("is-receding", velocity < -0.0003);
        setPostReleaseActive(burstComplete && pageMode === "gate");
        if (cue) {
          cue.textContent = chargeIntroActive
            ? "ENERGY VECTOR / ENCHANTING"
            : burstAutoplay
            ? "AUTOMATIC RELEASE / STAND BY"
            : burstComplete
            ? "SIGNAL RELEASED / CONTINUE"
            : fillComplete
              ? "OVERCHARGE / BREAK THE SEAL"
              : "SCROLL / SIGN THE CONTRACT";
        }
      };

      const startChargeIntro = (timestamp) => {
        if (chargeIntroActive || chargeIntroComplete || pageMode !== "gate") return;
        progress = 1;
        targetProgress = 1;
        velocity = 0;
        energyProgress = 1;
        chargeIntroActive = true;
        chargeIntroStartedAt = timestamp;
        chargeIntroProgress = 0;
      };

      const startReleaseAutoplay = (timestamp) => {
        if (burstAutoplay || burstAutoplayComplete) return;
        burstAutoplay = true;
        burstAutoplayStartedAt = timestamp;
        targetBurstProgress = 1;
        burstProgress = Math.max(crossEnd, burstProgress);
        burstVelocity = 0;
      };

      const animate = (timestamp) => {
        animationFrame = 0;
        const frameRatio = lastFrameTime
          ? clamp((timestamp - lastFrameTime) / 16.667, 0.5, 3)
          : 1;
        lastFrameTime = timestamp;
        const spring = (targetProgress - progress) * springStrength * frameRatio;
        velocity = (velocity + spring) * Math.pow(damping, frameRatio);
        progress = clamp(progress + velocity * frameRatio, 0, 1);
        const fillReadyForIntro = targetProgress >= 0.9995 && progress >= 0.995;
        if (fillReadyForIntro && !chargeIntroActive && !chargeIntroComplete) {
          startChargeIntro(timestamp);
        }
        if (chargeIntroActive) {
          chargeIntroProgress = clamp((timestamp - chargeIntroStartedAt) / chargeIntroDuration, 0, 1);
          if (chargeIntroProgress >= 1) {
            chargeIntroProgress = 1;
            chargeIntroActive = false;
            chargeIntroComplete = true;
            chargeIntroStartedAt = 0;
          }
        }
        if (burstAutoplay) {
          const autoplayProgress = clamp((timestamp - burstAutoplayStartedAt) / releaseAutoplayDuration, 0, 1);
          burstProgress = mapReleaseAutoplayProgress(autoplayProgress);
          targetBurstProgress = 1;
          burstVelocity = 0;
          if (autoplayProgress >= 1) {
            burstAutoplay = false;
            burstAutoplayComplete = true;
            burstProgress = 1;
          }
        } else {
          const burstSpring = (targetBurstProgress - burstProgress) * burstSpringStrength * frameRatio;
          burstVelocity = (burstVelocity + burstSpring) * Math.pow(burstDamping, frameRatio);
          burstProgress = clamp(burstProgress + burstVelocity * frameRatio, 0, 1);
          if (
            !burstAutoplayComplete
            && targetBurstProgress >= crossEnd - 0.0005
            && burstProgress >= crossEnd - 0.0007
          ) {
            startReleaseAutoplay(timestamp);
          }
        }

        const settled = !chargeIntroActive
          && !burstAutoplay
          && Math.abs(targetProgress - progress) < settleDistance
          && Math.abs(velocity) < settleDistance
          && Math.abs(targetBurstProgress - burstProgress) < settleDistance
          && Math.abs(burstVelocity) < settleDistance;
        if (settled) {
          progress = targetProgress;
          velocity = 0;
          burstProgress = targetBurstProgress;
          burstVelocity = 0;
          lastFrameTime = 0;
          render();
          return;
        }

        render();
        animationFrame = window.requestAnimationFrame(animate);
      };

      const startAnimation = () => {
        if (!animationFrame) {
          lastFrameTime = 0;
          animationFrame = window.requestAnimationFrame(animate);
        }
      };

      const getNextPageTop = () => {
        const openingRect = opening?.getBoundingClientRect();
        return Math.max(1, Math.round((openingRect?.top ?? gate.getBoundingClientRect().height) + window.scrollY));
      };

      const setScrollPosition = (value) => {
        window.scrollTo(0, clamp(value, 0, Math.max(0, document.documentElement.scrollHeight - window.innerHeight)));
      };

      const smoothScrollTo = (target, onComplete, onProgress) => {
        if (scrollFrame) return;
        const destination = Math.max(0, target);
        if (reducedMotion) {
          setScrollPosition(destination);
          onProgress?.(1);
          onComplete?.();
          return;
        }
        const root = document.documentElement;
        const previousScrollBehavior = root.style.scrollBehavior;
        root.style.scrollBehavior = "auto";
        let current = window.scrollY;
        let velocity = 0;
        let lastTimestamp = performance.now();
        const initialDistance = Math.max(1, Math.abs(destination - current));
        const stiffness = 38;
        const dampingForce = 11.8;
        const maxVelocity = clamp(Math.abs(destination - current) * 2.4, 620, 1900);

        const finish = () => {
          setScrollPosition(destination);
          onProgress?.(1);
          root.style.scrollBehavior = previousScrollBehavior;
          scrollFrame = 0;
          onComplete?.();
        };

        const step = (timestamp) => {
          const deltaTime = clamp((timestamp - lastTimestamp) / 1000, 0.008, 0.034);
          lastTimestamp = timestamp;
          const distance = destination - current;
          const acceleration = distance * stiffness - velocity * dampingForce;
          velocity = clamp(velocity + acceleration * deltaTime, -maxVelocity, maxVelocity);
          current += velocity * deltaTime;
          setScrollPosition(current);
          onProgress?.(clamp(1 - Math.abs(destination - current) / initialDistance, 0, 1));
          if (Math.abs(distance) < 0.35 && Math.abs(velocity) < 8) {
            finish();
            return;
          }
          scrollFrame = window.requestAnimationFrame(step);
        };

        scrollFrame = window.requestAnimationFrame(step);
      };

      const resetGateState = () => {
        if (animationFrame) window.cancelAnimationFrame(animationFrame);
        if (energyFrame) window.cancelAnimationFrame(energyFrame);
        if (energyTimer) window.clearTimeout(energyTimer);
        animationFrame = 0;
        energyFrame = 0;
        energyTimer = 0;
        energyLoopActive = false;
        lastFrameTime = 0;
        targetProgress = 0;
        progress = 0;
        velocity = 0;
        targetBurstProgress = 0;
        burstProgress = 0;
        burstVelocity = 0;
        burstAutoplay = false;
        burstAutoplayComplete = false;
        burstAutoplayStartedAt = 0;
        chargeIntroProgress = 0;
        chargeIntroActive = false;
        chargeIntroComplete = false;
        chargeIntroStartedAt = 0;
        energyProgress = 0;
        poseTimestamp = 0;
        poseClock = 0;
        poseAtRest = true;
        chargeInstability = 0;
        motionPhases = makeMotionPhases();
        screenParticleTimestamp = 0;
        lastEnergyPaintTimestamp = 0;
        renderQuality = Math.max(renderQuality, 0.88);
        renderCostEma = 0;
        lastQualityAdjustment = 0;
        singularityFieldLastPaintTimestamp = 0;
        energyFlowTimestamp = 0;
        beamHeadTimestamp = 0;
        beamHeadX = 0;
        beamHeadY = 0;
        beamHeadVelocityX = 0;
        beamHeadVelocityY = 0;
        beamMotionEnergy = 0;
        particleSerial = 0;
        wakeEmissionBudget = 0;
        orbitEmissionBudget = 0;
        rainEmissionBudget = 0;
        burstWaveMask = 0;
        wakePrimed = false;
        wakeParticles.length = 0;
        orbitParticles.length = 0;
        burstParticles.length = 0;
        rainParticles.length = 0;
        beamPose = {
          shakeX: 0,
          shakeY: 0,
          anchorX: 0,
          anchorY: 0,
          lift: 0,
          scaleX: 1,
          scaleY: 1,
          angle: 0
        };
        renderedPercent = -1;
        renderedStage = "";
        renderedGlitchTick = -1;
        energyContext?.clearRect(0, 0, energyCanvasWidth, energyCanvasHeight);
        burstContext?.clearRect(0, 0, burstCanvasWidth, burstCanvasHeight);
        singularityFieldContext?.clearRect(
          0,
          0,
          singularityFieldCanvas.width,
          singularityFieldCanvas.height
        );
        singularityFieldLastPaintTimestamp = 0;
        spaceLensRenderer?.clear();
        titleLensRenderer?.clear();
        gate.style.setProperty("--kisara-title-source-opacity", "1");
        lastSpaceLensPaintTimestamp = 0;
        lastTitleLensPaintTimestamp = 0;
        render();
      };

      const enterNextPage = () => {
        if (scrollFrame) return;
        pageMode = "snap";
        setPostReleaseActive(false);
        let resetApplied = false;
        gate.classList.remove("is-color-resetting");
        smoothScrollTo(getNextPageTop(), () => {
          if (!resetApplied) resetGateState();
          pageMode = "next";
          render();
          if (resetTransitionTimer) window.clearTimeout(resetTransitionTimer);
          resetTransitionTimer = window.setTimeout(() => {
            gate.classList.remove("is-color-resetting");
            resetTransitionTimer = 0;
          }, 260);
        }, (scrollProgress) => {
          if (scrollProgress >= 0.68) gate.classList.add("is-color-resetting");
          if (scrollProgress >= 0.86 && !resetApplied) {
            resetApplied = true;
            resetGateState();
          }
        });
      };

      const returnToGate = () => {
        if (scrollFrame) return;
        if (resetTransitionTimer) {
          window.clearTimeout(resetTransitionTimer);
          resetTransitionTimer = 0;
        }
        gate.classList.remove("is-color-resetting");
        pageMode = "snap";
        smoothScrollTo(0, () => {
          pageMode = "gate";
          poseTimestamp = 0;
          poseClock = 0;
          poseAtRest = true;
          chargeInstability = 0;
          motionPhases = makeMotionPhases();
          screenParticleTimestamp = 0;
          lastEnergyPaintTimestamp = 0;
          renderCostEma = 0;
          singularityFieldLastPaintTimestamp = 0;
          energyFlowTimestamp = 0;
          beamHeadTimestamp = 0;
          beamHeadVelocityX = 0;
          beamHeadVelocityY = 0;
          beamMotionEnergy = 0;
          render();
        });
      };

      const addProgress = (delta) => {
        if (chargeIntroActive || burstAutoplay || burstAutoplayComplete) return;
        const boundedDelta = clamp(delta, -180, 180);
        const fillComplete = targetProgress >= 0.9995 && progress >= 0.995;
        const burstInProgress = targetBurstProgress > 0.0005 || burstProgress > 0.0005;
        if (fillComplete && !chargeIntroComplete) {
          startChargeIntro(performance.now());
          startAnimation();
          return;
        }
        if (delta < 0 && chargeIntroComplete && !burstInProgress) {
          chargeIntroProgress = 0;
          chargeIntroActive = false;
          chargeIntroComplete = false;
          chargeIntroStartedAt = 0;
        }
        if ((delta > 0 && fillComplete) || (delta < 0 && burstInProgress)) {
          targetBurstProgress = clamp(targetBurstProgress + boundedDelta / burstDistance, 0, crossEnd);
          burstVelocity += boundedDelta / burstDistance * 0.045;
        } else {
          targetProgress = clamp(targetProgress + boundedDelta / fillDistance, 0, 1);
          velocity += boundedDelta / fillDistance * 0.03;
        }
        startAnimation();
      };

      const isFillComplete = () => targetProgress >= 0.9995
        && progress >= 0.999
        && Math.abs(velocity) < 0.001;

      const isComplete = () => isFillComplete()
        && targetBurstProgress >= 0.9995
        && burstProgress >= 0.999
        && Math.abs(burstVelocity) < 0.001
        && burstAutoplayComplete;

      const shouldCaptureGate = (delta) => {
        if (window.scrollY > 2 || delta === 0) return false;
        if (chargeIntroActive || burstAutoplay) return true;
        if (delta > 0 && isFillComplete() && !chargeIntroComplete) return true;
        if (delta > 0) return !isComplete();
        return targetBurstProgress > 0.0005
          || burstProgress > 0.0005
          || Math.abs(burstVelocity) > 0.0005
          || targetProgress > 0.0005
          || progress > 0.0005
          || Math.abs(velocity) > 0.0005;
      };

      const normalizeWheel = (event) => {
        if (event.deltaMode === WheelEvent.DOM_DELTA_LINE) return event.deltaY * 16;
        if (event.deltaMode === WheelEvent.DOM_DELTA_PAGE) return event.deltaY * window.innerHeight;
        return event.deltaY;
      };

      const handleDirectionalInput = (delta, event) => {
        if (delta === 0) return;
        if (scrollFrame) {
          event.preventDefault();
          return;
        }
        if (pageMode === "gate") {
          if (window.scrollY > 2) return;
          if (delta > 0 && isComplete()) {
            event.preventDefault();
            enterNextPage();
            return;
          }
          if (!shouldCaptureGate(delta)) return;
          event.preventDefault();
          addProgress(delta);
          return;
        }
        if (pageMode === "next" && delta < 0 && window.scrollY <= getNextPageTop() + Math.max(28, window.innerHeight * 0.08)) {
          event.preventDefault();
          returnToGate();
        }
      };

      window.addEventListener("wheel", (event) => {
        if (event.ctrlKey || event.metaKey) return;
        const delta = normalizeWheel(event);
        handleDirectionalInput(delta, event);
      }, { passive: false });

      window.addEventListener("keydown", (event) => {
        if (event.ctrlKey || event.metaKey || event.altKey) return;
        if (event.target instanceof Element && event.target.closest("a, button, input, select, textarea, [contenteditable='true']")) return;
        let amount = 0;
        if (event.key === "ArrowDown") amount = 130;
        if (event.key === "ArrowUp") amount = -130;
        if (["PageDown", "End"].includes(event.key)) amount = 300;
        if (["PageUp", "Home"].includes(event.key)) amount = -300;
        if (event.key === " ") amount = event.shiftKey ? -300 : 300;
        if (!amount) return;
        handleDirectionalInput(amount, event);
      });

      window.addEventListener("touchstart", (event) => {
        if (event.touches.length !== 1) {
          touchY = null;
          touchId = null;
          return;
        }
        touchId = event.touches[0]?.identifier ?? null;
        touchY = event.touches[0]?.clientY ?? null;
      }, { passive: true });

      window.addEventListener("touchmove", (event) => {
        if (event.touches.length !== 1 || touchId === null) return;
        const touch = Array.from(event.touches).find((item) => item.identifier === touchId);
        const nextY = touch?.clientY ?? null;
        if (touchY === null || nextY === null) return;
        const delta = touchY - nextY;
        touchY = nextY;
        const touchDelta = delta * 2.25;
        handleDirectionalInput(touchDelta, event);
      }, { passive: false });

      window.addEventListener("touchend", () => {
        touchY = null;
        touchId = null;
      }, { passive: true });

      window.addEventListener("touchcancel", () => {
        touchY = null;
        touchId = null;
      }, { passive: true });

      window.addEventListener("pointermove", handlePostReleasePointer, { passive: true });
      document.addEventListener("pointerleave", () => {
        postReleasePointerX = null;
        postReleasePointerAccumulator = 0;
        postReleaseTargetX = 0;
        postReleaseTargetY = 0;
      }, { passive: true });

      skip?.addEventListener("click", (event) => {
        event.preventDefault();
        if (animationFrame) window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
        lastFrameTime = 0;
        targetProgress = 1;
        progress = 1;
        velocity = 0;
        targetBurstProgress = 1;
        burstProgress = 1;
        burstVelocity = 0;
        burstAutoplay = false;
        burstAutoplayComplete = true;
        burstAutoplayStartedAt = 0;
        chargeIntroProgress = 1;
        chargeIntroActive = false;
        chargeIntroComplete = true;
        chargeIntroStartedAt = 0;
        render();
        enterNextPage();
      });

      const refreshLayoutSize = () => {
        lastEnergyPaintTimestamp = 0;
        lastSpaceLensPaintTimestamp = 0;
        lastTitleLensPaintTimestamp = 0;
        resizeEnergyCanvas(true);
        resizeBurstCanvas(true);
        resizePostReleaseCanvas(true);
        resizeTitleDataCanvas(true);
        spaceLensRenderer?.resize();
        titleLensRenderer?.resize();
        startEnergyAnimation();
        startPostReleaseAnimation();
      };
      const scheduleLayoutSizeRefresh = () => {
        if (layoutResizeFrame) return;
        layoutResizeFrame = window.requestAnimationFrame(() => {
          layoutResizeFrame = 0;
          refreshLayoutSize();
        });
      };
      window.addEventListener("resize", scheduleLayoutSizeRefresh, { passive: true });
      const layoutResizeObserver = typeof ResizeObserver === "function"
        ? new ResizeObserver(scheduleLayoutSizeRefresh)
        : null;
      if (layoutResizeObserver) {
        for (const target of [gate, meterShell, title, energyCanvas, burstCanvas, postReleaseCanvas]) {
          if (target) layoutResizeObserver.observe(target);
        }
      }
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") {
          if (energyFrame) window.cancelAnimationFrame(energyFrame);
          if (energyTimer) window.clearTimeout(energyTimer);
          energyFrame = 0;
          energyTimer = 0;
          energyLoopActive = false;
          screenParticleTimestamp = 0;
          lastEnergyPaintTimestamp = 0;
          energyFlowTimestamp = 0;
          beamHeadTimestamp = 0;
          lastSpaceLensPaintTimestamp = 0;
          lastTitleLensPaintTimestamp = 0;
          stopPostReleaseAnimation();
          spaceLensRenderer?.clear();
          titleLensRenderer?.clear();
          gate.style.setProperty("--kisara-title-source-opacity", "1");
          return;
        }
        startEnergyAnimation();
        startPostReleaseAnimation();
      });

      render();
      const syncRestoredPosition = () => {
        if (!restoreWindowOpen || scrollFrame || pageMode !== "gate" || window.scrollY <= 2) return;
        pageMode = "next";
        resetGateState();
      };
      window.addEventListener("pageshow", syncRestoredPosition);
      window.addEventListener("scroll", syncRestoredPosition, { passive: true });
      window.requestAnimationFrame(() => window.requestAnimationFrame(() => {
        syncRestoredPosition();
        window.setTimeout(() => {
          syncRestoredPosition();
          restoreWindowOpen = false;
          window.removeEventListener("scroll", syncRestoredPosition);
        }, 420);
      }));
    })();
  </script>
</KisaraLayout>
