            const travel = phaseProgress(geometry.impact, seed * 0.22, 0.76 + seed * 0.16);
            const distance = travel * (28 + seed * 128);
            const x = geometry.target.x + Math.cos(angle) * distance;
            const y = geometry.target.y + Math.sin(angle) * distance * 0.58;
