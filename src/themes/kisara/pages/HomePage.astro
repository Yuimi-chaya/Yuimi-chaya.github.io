        }
        if (
          chargeIntroProgress >= titleAbyssDomHandoffStart
          || burstProgress >= releaseStart
        ) {
          gate.classList.remove("is-title-abyss-ready");
          return;
        }

        const fill = clamp(Math.max(progress, energyProgress), 0, 1);
        const gap = titleAbyssLastPaintTimestamp > 0
          ? timestamp - titleAbyssLastPaintTimestamp
          : Number.POSITIVE_INFINITY;
        const inputMotion = Math.abs(titleAbyssPointerTargetX - titleAbyssPointerX)
          + Math.abs(titleAbyssPointerTargetY - titleAbyssPointerY)
          + Math.abs(velocity) * 180;
        const activeMotion = inputMotion > 0.012 || (fill > 0.001 && fill < 0.999);
        const frameInterval = reducedMotion
          ? Number.POSITIVE_INFINITY
          : litePerformance
            ? 1000 / (activeMotion ? 20 : 16)
            : mobilePerformance
              ? 1000 / (activeMotion ? 28 : 22)
              : 1000 / (activeMotion ? 45 : 30);
        if (
          !force
          && gap < frameInterval
          && Math.abs(fill - titleAbyssLastFill) < 0.0025
        ) return;

        const frameSeconds = Number.isFinite(gap)
          ? clamp(gap / 1000, 0.008, 0.08)
          : 1 / 60;
        const pointerEase = 1 - Math.exp(-frameSeconds * 6.8);
        titleAbyssPointerX += (titleAbyssPointerTargetX - titleAbyssPointerX) * pointerEase;
        titleAbyssPointerY += (titleAbyssPointerTargetY - titleAbyssPointerY) * pointerEase;
        titleAbyssLastPaintTimestamp = timestamp;
        titleAbyssLastFill = fill;

        const context = titleAbyssContext;
        const width = titleDataCanvasWidth;
        const height = titleDataCanvasHeight;
        const time = timestamp / 1000;
        const parallaxX = titleAbyssPointerX * (mobilePerformance ? 20 : 76);
        const parallaxY = titleAbyssPointerY * (mobilePerformance ? 12 : 40);
        const abyssExposure = 1 - smoothstep(clamp((fill - 0.9) / 0.1, 0, 1)) * 0.18;

        context.setTransform(1, 0, 0, 1, 0, 0);
        context.clearRect(0, 0, titleAbyssCanvas.width, titleAbyssCanvas.height);
        context.setTransform(titleDataPixelRatio, 0, 0, titleDataPixelRatio, 0, 0);
        context.globalCompositeOperation = "source-over";
        context.globalAlpha = 1;
        context.imageSmoothingEnabled = true;
