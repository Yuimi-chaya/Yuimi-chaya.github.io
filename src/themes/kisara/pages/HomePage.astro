          titleLensCanvas.dataset.active = "true";
        };

        const transparentWarmup = createTransparentWebglWarmup(
          gl,
          titleLensCanvas,
          () => draw({
            centerX: cssWidth * 0.5,
            centerY: cssHeight * 0.5,
            opacity: 0,
            strength: 0.78,
            gravity: 0.82,
            collapse: 0.56,
            crush: 0.3,
            shockStrength: 0.42,
            shockRadius: Math.max(1, cssHeight * 0.24),
            shockWidth: Math.max(1, cssHeight * 0.035),
            coreRadius: Math.max(1, cssHeight * 0.055),
            lensRadius: Math.max(1, cssHeight * 0.62),
            release: 0.28,
            dissolve: 0.16,
            time: performance.now() / 1000,
            finalFlow: 0.24,
            liquidPhase: 0.36,
