        postReleaseX = clamp(postReleaseX, -postReleaseMaxX, postReleaseMaxX);
        postReleaseTargetY = clamp(postReleaseTargetY, -postReleaseMaxY, postReleaseMaxY);
        postReleaseY = clamp(postReleaseY, -postReleaseMaxY, postReleaseMaxY);
        postReleaseLayout = {
          layerLeft,
          layerTop,
          layerWidth,
          layerHeight,
          imageScale,
          imageLeft: layerLeft + (layerWidth - renderedWidth) * 0.5,
          imageTop: layerTop + (layerHeight - renderedHeight) * 0.5
        };
      };

      const resizePostReleaseCanvas = (force = false) => {
        if (!postReleaseCanvas || !postReleaseContext) return;
        const width = Math.max(1, Math.round(gate.clientWidth));
        const height = Math.max(1, Math.round(gate.clientHeight));
        const pixelRatio = Math.min(window.devicePixelRatio || 1, width < 640 ? 1.18 : 1.45);
        const pixelWidth = Math.max(1, Math.round(width * pixelRatio));
        const pixelHeight = Math.max(1, Math.round(height * pixelRatio));
        if (
          force
          || postReleaseCanvasWidth !== width
          || postReleaseCanvasHeight !== height
          || Math.abs(postReleasePixelRatio - pixelRatio) > 0.01
        ) {
          postReleaseCanvas.width = pixelWidth;
          postReleaseCanvas.height = pixelHeight;
          postReleaseCanvasWidth = width;
          postReleaseCanvasHeight = height;
          postReleasePixelRatio = pixelRatio;
          clearPostReleaseCanvas();
        }
        refreshPostReleaseLayout();
      };

      const mapPostReleaseSource = (source) => ({
        x: postReleaseLayout.imageLeft
          + source.x * fightImageWidth * postReleaseLayout.imageScale
          + postReleaseX,
        y: postReleaseLayout.imageTop
          + source.y * fightImageHeight * postReleaseLayout.imageScale
          + postReleaseY,
        scale: postReleaseLayout.imageScale
      });

      const drawPostReleaseBloom = (context, x, y, radiusX, radiusY, rotation, alpha) => {
        context.save();
        context.translate(x, y);
        context.rotate(rotation);
        context.scale(Math.max(0.001, radiusX), Math.max(0.001, radiusY));
        const gradient = context.createRadialGradient(0, 0, 0, 0, 0, 1);
        gradient.addColorStop(0, `rgba(255, 255, 255, ${0.9 * alpha})`);
        gradient.addColorStop(0.16, `rgba(255, 221, 236, ${0.78 * alpha})`);
        gradient.addColorStop(0.42, `rgba(255, 83, 151, ${0.38 * alpha})`);
        gradient.addColorStop(1, "rgba(255, 31, 118, 0)");
        context.fillStyle = gradient;
        context.beginPath();
        context.arc(0, 0, 1, 0, fullTurn);
        context.fill();
        context.restore();
      };

      const drawPostReleaseTrail = (context, source, point, speed, alpha) => {
        const trailLength = source.kind === "blade"
          ? 24 + Math.min(56, speed * 0.32) + postReleaseFlowWhip * 18
          : 10 + Math.min(34, speed * 0.22) + postReleaseFlowWhip * 10;
        const segmentCount = source.kind === "blade" ? 8 : 6;
        const segmentLength = trailLength / segmentCount;
        let tailX = point.x;
        let tailY = point.y;
        for (let segment = 0; segment < segmentCount; segment += 1) {
          const angle = getPostReleaseFlowAngle((segment + 0.5) / segmentCount);
          tailX += Math.cos(angle) * segmentLength;
          tailY += Math.sin(angle) * segmentLength;
        }
        const gradient = context.createLinearGradient(
          tailX,
          tailY,
          point.x,
          point.y
        );
        gradient.addColorStop(0, "rgba(255, 52, 139, 0)");
        gradient.addColorStop(0.48, `rgba(255, 83, 157, ${0.18 * alpha})`);
        gradient.addColorStop(0.84, `rgba(255, 203, 231, ${0.62 * alpha})`);
        gradient.addColorStop(1, `rgba(255, 255, 255, ${0.9 * alpha})`);
        context.save();
        context.strokeStyle = gradient;
        context.lineCap = "round";
        context.lineWidth = source.kind === "blade"
          ? Math.max(1.2, point.scale * 2.3)
          : Math.max(0.8, point.scale * 1.35);
        context.beginPath();
        context.moveTo(point.x, point.y);
        let x = point.x;
        let y = point.y;
        for (let segment = 0; segment < segmentCount; segment += 1) {
          const angle = getPostReleaseFlowAngle((segment + 0.5) / segmentCount);
          x += Math.cos(angle) * segmentLength;
          y += Math.sin(angle) * segmentLength;
          context.lineTo(x, y);
        }
        context.stroke();
        context.restore();
      };

      const drawPostReleaseEyeFlame = (context, source, point, speed, time, alpha) => {
        const glowScale = clamp(point.scale, 0.58, 1.35);
        const motionStretch = Math.min(22, speed * 0.16) + postReleaseFlowWhip * 12;
        const baseLength = (25 + motionStretch) * glowScale;
        const phase = time * 2.15 + source.x * 31 + source.y * 17;
        const rootAngle = getPostReleaseFlowAngle(0.04) + source.angle * 0.025;
        const middleAngle = getPostReleaseFlowAngle(0.46) + source.angle * 0.018;
        const tipAngle = getPostReleaseFlowAngle(0.92) + source.angle * 0.012;
        const rootX = Math.cos(rootAngle);
        const rootY = Math.sin(rootAngle);
        const middleX = Math.cos(middleAngle);
        const middleY = Math.sin(middleAngle);
        const tipX = Math.cos(tipAngle);
        const tipY = Math.sin(tipAngle);
        const rootNormalX = -rootY;
        const rootNormalY = rootX;
        const middleNormalX = -middleY;
        const middleNormalY = middleX;
        const tipNormalX = -tipY;
        const tipNormalY = tipX;
        const lobes = [
          { length: 1, width: 1, offset: 0, phase: 0, alpha: 0.58 },
          { length: 0.72, width: 0.72, offset: -3.2, phase: 1.8, alpha: 0.42 },
          { length: 0.56, width: 0.58, offset: 3.5, phase: 3.6, alpha: 0.34 }
        ];

        context.save();
        context.lineCap = "round";
        context.lineJoin = "round";
        for (const lobe of lobes) {
          const flutter = Math.sin(phase * 1.7 + lobe.phase) * (2.4 + lobe.length * 2.1) * glowScale;
          const length = baseLength * lobe.length * (0.92 + Math.sin(phase + lobe.phase) * 0.08);
          const width = (3.7 + Math.min(2.8, speed * 0.024)) * glowScale * lobe.width;
          const sideOffset = (lobe.offset + flutter * 0.28) * glowScale;
          const tailX = point.x
            + rootX * length * 0.2
            + middleX * length * 0.34
            + tipX * length * 0.46
            + tipNormalX * (sideOffset + flutter);
          const tailY = point.y
            + rootY * length * 0.2
            + middleY * length * 0.34
            + tipY * length * 0.46
            + tipNormalY * (sideOffset + flutter);
          const gradient = context.createLinearGradient(tailX, tailY, point.x, point.y);
          gradient.addColorStop(0, "rgba(255, 33, 120, 0)");
          gradient.addColorStop(0.34, `rgba(255, 38, 125, ${alpha * lobe.alpha * 0.42})`);
          gradient.addColorStop(0.72, `rgba(255, 91, 158, ${alpha * lobe.alpha * 0.9})`);
          gradient.addColorStop(1, `rgba(255, 241, 250, ${alpha * lobe.alpha})`);

          context.fillStyle = gradient;
          context.shadowColor = `rgba(255, 35, 124, ${alpha * 0.56})`;
          context.shadowBlur = 10 * glowScale;
          context.beginPath();
          context.moveTo(
            point.x + rootNormalX * width,
            point.y + rootNormalY * width
          );
          context.bezierCurveTo(
            point.x + rootX * length * 0.24 + rootNormalX * (width * 1.5 + sideOffset * 0.2),
            point.y + rootY * length * 0.24 + rootNormalY * (width * 1.5 + sideOffset * 0.2),
            point.x
              + rootX * length * 0.2
              + middleX * length * 0.46
              + middleNormalX * (width * 0.44 + sideOffset),
            point.y
              + rootY * length * 0.2
              + middleY * length * 0.46
              + middleNormalY * (width * 0.44 + sideOffset),
            tailX,
            tailY
          );
          context.bezierCurveTo(
            point.x
              + rootX * length * 0.18
              + middleX * length * 0.42
              + middleNormalX * (-width * 0.42 + sideOffset),
            point.y
              + rootY * length * 0.18
              + middleY * length * 0.42
              + middleNormalY * (-width * 0.42 + sideOffset),
            point.x + rootX * length * 0.18 - rootNormalX * width,
            point.y + rootY * length * 0.18 - rootNormalY * width,
            point.x - rootNormalX * width * 0.72,
            point.y - rootNormalY * width * 0.72
          );
          context.closePath();
          context.fill();
        }

        const coreLength = baseLength * 0.82;
        const coreTailX = point.x
          + rootX * coreLength * 0.22
          + middleX * coreLength * 0.34
          + tipX * coreLength * 0.44;
        const coreTailY = point.y
          + rootY * coreLength * 0.22
          + middleY * coreLength * 0.34
          + tipY * coreLength * 0.44
          + tipNormalY * Math.sin(phase * 1.6) * 2.6 * glowScale;
        const coreGradient = context.createLinearGradient(coreTailX, coreTailY, point.x, point.y);
        coreGradient.addColorStop(0, "rgba(255, 80, 151, 0)");
        coreGradient.addColorStop(0.58, `rgba(255, 119, 180, ${alpha * 0.48})`);
        coreGradient.addColorStop(1, `rgba(255, 255, 255, ${alpha * 0.92})`);
        context.shadowBlur = 7 * glowScale;
        context.strokeStyle = coreGradient;
        context.lineWidth = Math.max(0.8, 1.45 * glowScale);
        context.beginPath();
        context.moveTo(coreTailX, coreTailY);
        context.bezierCurveTo(
          point.x
            + rootX * coreLength * 0.18
            + middleX * coreLength * 0.5
            + middleNormalX * Math.sin(phase) * 2.4 * glowScale,
          point.y
            + rootY * coreLength * 0.18
            + middleY * coreLength * 0.5
            + middleNormalY * Math.sin(phase) * 2.4 * glowScale,
          point.x + rootX * coreLength * 0.2,
          point.y + rootY * coreLength * 0.2,
          point.x,
          point.y
        );
        context.stroke();
        context.restore();
      };

      const drawPostReleaseHighlights = (context, timestamp, intro) => {
        const time = timestamp / 1000;
        const speed = Math.abs(postReleaseVelocityX);
        context.save();
        context.globalCompositeOperation = "lighter";
        for (let index = 0; index < postReleaseSources.length; index += 1) {
          const source = postReleaseSources[index];
          const point = mapPostReleaseSource(source);
          if (
            point.x < -90
            || point.x > postReleaseCanvasWidth + 90
            || point.y < -90
            || point.y > postReleaseCanvasHeight + 90
          ) continue;
          const pulse = 0.88 + Math.sin(time * (3.4 + index * 0.28) + index * 1.7) * 0.12;
          const movementLift = clamp(speed / 120, 0, 1) * 0.24 + postReleaseFlowWhip * 0.12;
          const alpha = intro * source.strength * (pulse + movementLift);
          if (source.kind === "eye") {
            const glowScale = clamp(point.scale, 0.58, 1.35);
            const firePulse = 0.92
              + Math.sin(time * 4.6 + index * 1.3) * 0.13
              + Math.sin(time * 8.7 + index * 0.8) * 0.05;
            const fireRise = (1 + Math.sin(time * 3.8 + index * 1.7)) * 1.35 * glowScale;
            drawPostReleaseEyeFlame(
              context,
              source,
              point,
              speed,
              time,
              alpha * 0.94
            );
            drawPostReleaseBloom(
              context,
              point.x,
              point.y,
              23 * glowScale * firePulse,
              16 * glowScale * firePulse,
              source.angle,
              alpha * 0.62
            );
            drawPostReleaseBloom(
              context,
              point.x - 0.6 * glowScale,
              point.y - 1.8 * glowScale - fireRise * 0.28,
              5.5 * glowScale * firePulse,
              9.6 * glowScale * firePulse,
              source.angle,
              alpha
            );
            context.save();
            context.translate(point.x, point.y);
            context.rotate(source.angle);
            const tongueHeight = (10.5 + fireRise * 0.72) * glowScale * firePulse;
            const tongueGradient = context.createLinearGradient(0, 4 * glowScale, 0, -tongueHeight);
            tongueGradient.addColorStop(0, `rgba(255, 249, 253, ${0.98 * alpha})`);
            tongueGradient.addColorStop(0.34, `rgba(255, 126, 179, ${0.9 * alpha})`);
            tongueGradient.addColorStop(0.72, `rgba(255, 43, 128, ${0.62 * alpha})`);
            tongueGradient.addColorStop(1, "rgba(255, 35, 124, 0)");
            context.fillStyle = tongueGradient;
            context.shadowColor = `rgba(255, 47, 132, ${0.76 * alpha})`;
            context.shadowBlur = 7.5 * glowScale;
            context.beginPath();
            context.moveTo(-3.15 * glowScale, 3.2 * glowScale);
            context.bezierCurveTo(
              -4.5 * glowScale,
              -1.4 * glowScale,
              -2.2 * glowScale,
              -tongueHeight * 0.72,
              0.25 * glowScale,
              -tongueHeight
            );
            context.bezierCurveTo(
              2.8 * glowScale,
              -tongueHeight * 0.66,
              4.4 * glowScale,
              -1.1 * glowScale,
              3 * glowScale,
              3.2 * glowScale
            );
            context.closePath();
            context.fill();
            context.shadowBlur = 4 * glowScale;
            context.fillStyle = `rgba(255, 255, 255, ${0.96 * alpha})`;
            context.beginPath();
            context.ellipse(
              -0.7 * glowScale,
              -2.5 * glowScale - fireRise * 0.22,
              1.7 * glowScale * firePulse,
              3.1 * glowScale * firePulse,
              0,
              0,
              fullTurn
            );
            context.fill();
            context.restore();
          } else {
            const glowScale = clamp(point.scale, 0.62, 1.4);
            drawPostReleaseBloom(
              context,
              point.x,
              point.y,
              31 * glowScale,
              10.5 * glowScale,
              source.angle,
              alpha * 0.58
            );
            context.save();
            context.translate(point.x, point.y);
            context.rotate(source.angle);
            context.shadowColor = `rgba(255, 54, 145, ${0.72 * alpha})`;
            context.shadowBlur = 12 * glowScale;
            const bladeGradient = context.createLinearGradient(-38 * glowScale, 0, 42 * glowScale, 0);
            bladeGradient.addColorStop(0, "rgba(255, 76, 158, 0)");
            bladeGradient.addColorStop(0.3, `rgba(255, 72, 153, ${0.36 * alpha})`);
            bladeGradient.addColorStop(0.7, `rgba(255, 216, 238, ${0.9 * alpha})`);
            bladeGradient.addColorStop(1, "rgba(255, 255, 255, 0)");
            context.strokeStyle = bladeGradient;
            context.lineCap = "round";
            context.lineWidth = Math.max(1.6, 4.2 * glowScale);
            context.beginPath();
            context.moveTo(-38 * glowScale, 0);
            context.quadraticCurveTo(0, -2.2 * glowScale, 42 * glowScale, 0.7 * glowScale);
            context.stroke();
            context.shadowBlur = 5 * glowScale;
            context.strokeStyle = `rgba(255, 249, 253, ${0.92 * alpha})`;
            context.lineWidth = Math.max(0.65, 1.05 * glowScale);
            context.beginPath();
            context.moveTo(-8 * glowScale, -0.2 * glowScale);
            context.quadraticCurveTo(10 * glowScale, -1.1 * glowScale, 31 * glowScale, 0.2 * glowScale);
            context.stroke();
            context.strokeStyle = `rgba(255, 174, 211, ${0.7 * alpha})`;
            context.lineWidth = Math.max(0.55, 0.82 * glowScale);
            context.beginPath();
            context.moveTo(18 * glowScale, -6 * glowScale);
            context.lineTo(18 * glowScale, 6 * glowScale);
            context.stroke();
            context.restore();
            drawPostReleaseTrail(context, source, point, speed, alpha * 0.92);
          }
        }
        context.restore();
      };

      const spawnPostReleaseParticle = (source, point, speed, ambient = false) => {
        if (postReleaseParticles.length >= (postReleaseCanvasWidth < 640 ? 136 : 224)) return;
        const randomA = nextPostReleaseRandom();
        const randomB = nextPostReleaseRandom();
        const randomC = nextPostReleaseRandom();
        const power = ambient
          ? 48 + randomB * 46
          : 76 + Math.min(180, speed * 0.82) + randomB * 62;
        const flowOffset = (randomC - 0.5) * (ambient ? 0.2 : 0.14);
        const launchAngle = getPostReleaseFlowAngle(0.025 + randomA * 0.045) + flowOffset;
        const launchPower = power * (0.9 + randomA * 0.3);
        const velocityX = Math.cos(launchAngle) * launchPower;
        const velocityY = Math.sin(launchAngle) * launchPower;
        const history = 0.016 + randomA * 0.022;
        const x = point.x + (randomA - 0.5) * (source.kind === "blade" ? 9 : 4);
        const y = point.y + (randomB - 0.5) * (source.kind === "blade" ? 6 : 4);
        postReleaseParticles.push({
          x,
          y,
          previousX: x - velocityX * history,
          previousY: y - velocityY * history,
          velocityX,
          velocityY,
          age: 0,
          life: ambient ? 1.08 + randomC * 0.82 : 0.86 + randomC * 0.9,
          size: (source.kind === "blade" ? 1.18 : 1.02) + randomB * 1.72,
          hue: source.kind === "blade" ? 338 + randomA * 12 : 326 + randomA * 18,
          curl: 12 + randomA * 22,
          lift: 26 + randomB * 24,
          phase: randomC * fullTurn,
          flowOffset,
          flowLag: randomA * 0.075,
          flowCoupling: 0.84 + randomB * 0.3,
          ambient
        });
      };

      const updatePostReleaseParticles = (context, frameSeconds, speed, intro) => {
        if (precisePointer && (speed > 0.7 || postReleaseFlowWhip > 0.025)) {
          postReleaseEmissionBudget += frameSeconds * (
            34
            + Math.min(70, speed * 0.52)
            + postReleaseFlowWhip * 48
          );
        }
        postReleaseAmbientBudget += frameSeconds * (postReleaseCanvasWidth < 640 ? 26 : 42) * intro;
        while (postReleaseEmissionBudget >= 1) {
          postReleaseEmissionBudget -= 1;
          const source = postReleaseSources[
            postReleaseSourceOrder[postReleaseSourceIndex % postReleaseSourceOrder.length]
          ];
          postReleaseSourceIndex += 1;
          spawnPostReleaseParticle(source, mapPostReleaseSource(source), speed, false);
        }
        while (postReleaseAmbientBudget >= 1) {
          postReleaseAmbientBudget -= 1;
          const source = postReleaseSources[
            postReleaseSourceOrder[postReleaseSourceIndex % postReleaseSourceOrder.length]
          ];
          postReleaseSourceIndex += 1;
          spawnPostReleaseParticle(source, mapPostReleaseSource(source), speed, true);
        }

        context.save();
        context.globalCompositeOperation = "lighter";
        for (let index = postReleaseParticles.length - 1; index >= 0; index -= 1) {
          const particle = postReleaseParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life) {
            postReleaseParticles[index] = postReleaseParticles[postReleaseParticles.length - 1];
            postReleaseParticles.pop();
            continue;
          }
          particle.previousX = particle.x;
          particle.previousY = particle.y;
          const drag = Math.exp(-(particle.ambient ? 0.68 : 0.92) * frameSeconds);
          particle.velocityX *= drag;
          particle.velocityY *= drag;
          particle.velocityX += Math.cos(particle.phase + particle.age * 4.2)
            * particle.curl * frameSeconds * 0.24;
          particle.velocityY += Math.sin(particle.phase + particle.age * 4.8)
            * particle.curl * frameSeconds * 0.62;
          particle.velocityY -= particle.lift
            * frameSeconds
            * (0.82 + Math.min(0.9, particle.age * 0.72));
          const lifeProgress = particle.age / particle.life;
          const currentSpeed = Math.max(1, Math.hypot(particle.velocityX, particle.velocityY));
          const currentAngle = Math.atan2(particle.velocityY, particle.velocityX);
          const guideUnit = clamp(lifeProgress * 0.88 + particle.flowLag, 0, 1);
          const targetAngle = getPostReleaseFlowAngle(guideUnit)
            + particle.flowOffset * (1 - guideUnit * 0.48);
          const turnRate = (particle.ambient ? 3.8 : 5.15)
            * particle.flowCoupling
            * (1 + postReleaseFlowWhip * 0.82)
            * (1 - lifeProgress * 0.2);
          const turn = clamp(
            shortestAngleDelta(currentAngle, targetAngle),
            -turnRate * frameSeconds,
            turnRate * frameSeconds
          );
          const steeredAngle = currentAngle + turn;
          particle.velocityX = Math.cos(steeredAngle) * currentSpeed;
          particle.velocityY = Math.sin(steeredAngle) * currentSpeed;
          particle.x += particle.velocityX * frameSeconds;
          particle.y += particle.velocityY * frameSeconds;
          const fadeIn = smoothstep(clamp(particle.age / 0.09, 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeProgress - 0.58) / 0.42, 0, 1));
          const flicker = 0.76 + Math.sin(particle.phase + particle.age * 9.4) * 0.24;
          const alpha = fadeIn * fadeOut * flicker * intro;
          const trailLength = clamp(Math.hypot(particle.velocityX, particle.velocityY) * 0.058, 5, 23);
          const magnitude = Math.max(1, Math.hypot(particle.velocityX, particle.velocityY));
          const tailX = particle.x - particle.velocityX / magnitude * trailLength;
          const tailY = particle.y - particle.velocityY / magnitude * trailLength;
          const gradient = context.createLinearGradient(tailX, tailY, particle.x, particle.y);
          gradient.addColorStop(0, `hsla(${particle.hue}, 100%, 68%, 0)`);
          gradient.addColorStop(0.58, `hsla(${particle.hue}, 100%, 72%, ${0.48 * alpha})`);
          gradient.addColorStop(1, `rgba(255, 246, 252, ${0.96 * alpha})`);
          context.strokeStyle = gradient;
          context.lineWidth = Math.max(0.62, particle.size * (1.08 - lifeProgress * 0.42));
          context.lineCap = "round";
          context.beginPath();
          context.moveTo(tailX, tailY);
          context.lineTo(particle.x, particle.y);
          context.stroke();
          context.fillStyle = `rgba(255, 223, 239, ${0.82 * alpha})`;
          context.beginPath();
          context.arc(particle.x, particle.y, Math.max(0.45, particle.size * 0.46), 0, fullTurn);
          context.fill();
        }
        context.restore();
      };

      const updatePostReleaseDataStream = (timestamp, frameSeconds, intro) => {
        if (!postReleaseDataInitialized) {
          postReleaseDataOpacity = 0;
          return;
        }
        let activeDirection = postReleaseDirection || 1;
        if (postReleaseJourney) {
          activeDirection = postReleaseJourney.direction;
          const progress = clamp(
            (timestamp - postReleaseJourney.startedAt) / postReleaseJourney.duration,
            0,
            1
          );
          const eased = smoothstep(smoothstep(progress));
          postReleaseDataPosition = postReleaseJourney.startPosition
            + (postReleaseJourney.endPosition - postReleaseJourney.startPosition) * eased;
          if (progress >= 0.999) {
            postReleaseDataPosition = postReleaseJourney.endPosition;
            postReleaseJourney = null;
          }
        }
        const moving = Boolean(postReleaseJourney);
        const targetOpacity = moving ? 0.96 : 0.76;
        postReleaseDataOpacity += (targetOpacity - postReleaseDataOpacity)
          * (1 - Math.exp(-frameSeconds * (moving ? 7.4 : 4.2)));
        postReleaseDataPhase += frameSeconds * (moving ? 34 : 7.5) * (activeDirection > 0 ? -1 : 1);
        if (Math.abs(postReleaseDataPhase) > 2048) postReleaseDataPhase %= 2048;
      };

      const drawTitleDataReconstruction = (timestamp, intro) => {
        if (!titleDataCanvas || !titleDataContext) return;
        if (!postReleaseDataInitialized || postReleaseDataOpacity * intro <= 0.003) {
          if (titleDataCanvas.style.opacity !== "0") clearTitleDataCanvas();
          return;
        }
        if (titleDataCanvasWidth <= 1 || titleDataCanvasHeight <= 1) {
          resizeTitleDataCanvas();
        }
        if (titleDataCells.length === 0) return;

        titleDataContext.setTransform(1, 0, 0, 1, 0, 0);
        titleDataContext.clearRect(0, 0, titleDataCanvas.width, titleDataCanvas.height);
        titleDataContext.setTransform(titleDataPixelRatio, 0, 0, titleDataPixelRatio, 0, 0);
        titleDataContext.save();
        titleDataContext.globalCompositeOperation = "source-over";
        titleDataContext.lineWidth = 0.72;

        const width = titleDataCanvasWidth;
        const height = titleDataCanvasHeight;
        const moving = Boolean(postReleaseJourney);
        const direction = postReleaseJourney?.direction || postReleaseDirection || 1;
        const position = postReleaseDataPosition;
        const bandReach = moving ? 15.8 : 13.6;
        const phase = postReleaseDataPhase;
        const time = timestamp / 1000;

        const drawTitleDataCell = (cell, edgePass) => {
          if (edgePass ? cell.ring === 0 : cell.ring > 0) return;
          const normalizedX = cell.x / Math.max(1, width);
          const normalizedY = cell.y / Math.max(1, height);
          const cellCoordinate = (
            normalizedX
            + (normalizedY - 0.5) * 0.1 * direction
          ) * 100;
          const distance = Math.abs(cellCoordinate - position);
          const radialProgress = clamp(
            (bandReach - distance) / Math.max(1, bandReach * 0.68) + 0.5,
            0,
            1
          );
          if (radialProgress <= 0.001) continue;

          const animatedNoise = 0.5 + 0.5 * Math.sin(
            cell.x * 0.031
            - cell.y * 0.047
            + phase * 0.11
            + cell.flicker * fullTurn
          );
          const dataNoise = cell.noise * 0.58 + animatedNoise * 0.42;
          const dataMask = smoothstep(clamp(
            (radialProgress - (dataNoise - 0.16)) / 0.32,
            0,
            1
          ));
          const dataSettle = smoothstep(clamp(
            (radialProgress - (dataNoise + 0.04)) / 0.58,
            0,
            1
          ));
          const dataFront = Math.exp(-Math.pow(
            (radialProgress - dataNoise) / 0.17,
            2
          ));
          const ringWeight = [1, 0.74, 0.46, 0.27][cell.ring] ?? 0.2;
          const edgeBleed = cell.ring === 0
            ? 1
            : [0, 0.38, 0.16, 0.055][cell.ring] ?? 0.04;
          const erosionGate = cell.ring === 0
            ? 1
            : clamp(dataFront * 1.42 + dataMask * (0.2 - cell.ring * 0.025), 0, 1);
          const pulse = 0.9 + Math.sin(time * 4.2 + cell.flicker * 17.4) * 0.1;
          const alpha = clamp(
            (dataMask * (0.54 + dataSettle * 0.24) + dataFront * 0.52)
              * ringWeight
              * erosionGate
              * cell.edgeStrength
              * edgeBleed
              * pulse,
            0,
            1
          );
          if (alpha <= 0.018) continue;

          const blueCell = cell.tone < 0.18 || (cell.ring > 0 && cell.tone < 0.38);
          const frontHeat = clamp(dataFront * 1.16, 0, 1);
          const sampledRed = cell.sourceRed || 226;
          const sampledGreen = cell.sourceGreen || 54;
          const sampledBlue = cell.sourceBlue || 137;
          const red = blueCell
            ? sampledRed * 0.52 + 92 + frontHeat * 58
            : sampledRed + frontHeat * (255 - sampledRed) * 0.86;
          const green = blueCell
            ? sampledGreen * 0.42 + 132 + frontHeat * 72
            : sampledGreen + dataSettle * 18 + frontHeat * (245 - sampledGreen) * 0.72;
          const blue = blueCell
            ? sampledBlue * 0.34 + 172 + frontHeat * 48
            : sampledBlue + dataSettle * 12 + frontHeat * (246 - sampledBlue) * 0.68;
          const renderRed = Math.round(clamp(red, 0, 255));
          const renderGreen = Math.round(clamp(green, 0, 255));
          const renderBlue = Math.round(clamp(blue, 0, 255));
          const size = Math.max(2.8, cell.size * (0.88 + dataFront * 0.12));
          const left = cell.x - size * 0.5;
          const top = cell.y - size * 0.5;

          if (dataFront > 0.52 && cell.flicker > 0.64) {
            const glowSize = size * (
              cell.ring === 0
                ? 1.28 + dataFront * 0.2
                : 1.04 + dataFront * 0.12
            );
            titleDataContext.fillStyle = `rgba(${renderRed}, ${renderGreen}, ${renderBlue}, ${alpha * 0.2})`;
            titleDataContext.fillRect(
              cell.x - glowSize * 0.5,
              cell.y - glowSize * 0.5,
              glowSize,
              glowSize
            );
          }

          titleDataContext.fillStyle = `rgba(${renderRed}, ${renderGreen}, ${renderBlue}, ${alpha})`;
          titleDataContext.fillRect(left, top, size, size);
          if (dataFront > 0.3) {
            titleDataContext.strokeStyle = `rgba(255, 244, 250, ${alpha * (0.22 + dataFront * 0.58)})`;
            titleDataContext.strokeRect(left + 0.35, top + 0.35, Math.max(0, size - 0.7), Math.max(0, size - 0.7));
          }
        };

        for (const cell of titleDataCells) drawTitleDataCell(cell, false);
        titleDataContext.setTransform(1, 0, 0, 1, 0, 0);
        titleDataContext.globalCompositeOperation = "destination-in";
        titleDataContext.drawImage(titleDataMaskCanvas, 0, 0);
        titleDataContext.globalCompositeOperation = "source-over";
        titleDataContext.setTransform(titleDataPixelRatio, 0, 0, titleDataPixelRatio, 0, 0);
        for (const cell of titleDataCells) drawTitleDataCell(cell, true);

        titleDataContext.restore();
        titleDataCanvas.style.opacity = (postReleaseDataOpacity * intro).toFixed(3);
      };

      const drawPostRelease = (timestamp) => {
        postReleaseFrame = 0;
        if (
          !postReleaseActive
          || pageMode !== "gate"
          || document.visibilityState !== "visible"
          || !postReleaseContext
        ) return;
        const motionPending = Math.abs(postReleaseTargetX - postReleaseX) > 0.03
          || Math.abs(postReleaseTargetY - postReleaseY) > 0.03
          || Boolean(postReleaseJourney)
          || postReleaseFlowWhip > 0.018;
        const minimumFrameInterval = motionPending ? 1000 / 60 : 1000 / 30;
        if (
          postReleaseLastTimestamp
          && timestamp - postReleaseLastTimestamp < minimumFrameInterval * 0.9
        ) {
          postReleaseFrame = window.requestAnimationFrame(drawPostRelease);
          return;
        }
        if (postReleaseCanvasWidth <= 1 || postReleaseCanvasHeight <= 1) resizePostReleaseCanvas();
        const frameSeconds = postReleaseLastTimestamp
          ? clamp((timestamp - postReleaseLastTimestamp) / 1000, 0.008, 0.045)
          : 1 / 60;
        postReleaseLastTimestamp = timestamp;
        const previousX = postReleaseX;
        const response = 1 - Math.exp(-frameSeconds * 3.35);
        postReleaseX += (postReleaseTargetX - postReleaseX) * response;
        postReleaseY += (postReleaseTargetY - postReleaseY) * (1 - Math.exp(-frameSeconds * 5.4));
        postReleaseVelocityX = (postReleaseX - previousX) / Math.max(0.001, frameSeconds);
        updatePostReleaseFlow(frameSeconds);
        const intro = reducedMotion
          ? 1
          : smoothstep(clamp((timestamp - postReleaseStartedAt) / 880, 0, 1));
        gate.style.setProperty("--kisara-post-parallax-x", `${postReleaseX.toFixed(3)}px`);
        gate.style.setProperty("--kisara-post-parallax-y", `${postReleaseY.toFixed(3)}px`);
        gate.style.setProperty("--kisara-post-release-opacity", intro.toFixed(3));
        updatePostReleaseDataStream(timestamp, frameSeconds, intro);
        drawTitleDataReconstruction(timestamp, intro);
        clearPostReleaseCanvas();
        drawPostReleaseHighlights(postReleaseContext, timestamp, intro);
        updatePostReleaseParticles(
          postReleaseContext,
          frameSeconds,
          Math.abs(postReleaseVelocityX),
          intro
        );
        if (!reducedMotion) postReleaseFrame = window.requestAnimationFrame(drawPostRelease);
      };

      const startPostReleaseAnimation = () => {
        if (
          postReleaseFrame
          || !postReleaseActive
          || pageMode !== "gate"
          || document.visibilityState !== "visible"
          || !postReleaseContext
        ) return;
        postReleaseLastTimestamp = 0;
        if (reducedMotion) {
          drawPostRelease(performance.now());
          return;
        }
        postReleaseFrame = window.requestAnimationFrame(drawPostRelease);
      };

      const stopPostReleaseAnimation = (reset = false) => {
        if (postReleaseFrame) window.cancelAnimationFrame(postReleaseFrame);
        postReleaseFrame = 0;
        postReleaseLastTimestamp = 0;
        if (!reset) return;
        postReleaseX = 0;
        postReleaseY = 0;
        postReleaseTargetX = 0;
        postReleaseTargetY = 0;
        postReleaseVelocityX = 0;
        postReleasePointerX = null;
        postReleasePointerAccumulator = 0;
        postReleaseDirection = 1;
        postReleaseDirectionChangedAt = 0;
        postReleaseFlowAngles.fill(postReleaseInitialFlowAngle);
        postReleaseFlowAngularVelocities.fill(0);
        postReleaseFlowWhip = 0;
        postReleaseJourney = null;
        postReleaseDataInitialized = false;
        postReleaseDataPosition = 50;
        postReleaseDataOpacity = 0;
        postReleaseDataPhase = 0;
        postReleaseEmissionBudget = 0;
        postReleaseAmbientBudget = 0;
        postReleaseSourceIndex = 0;
        postReleaseParticleSerial = 0;
        postReleaseParticles.length = 0;
        gate.style.setProperty("--kisara-post-parallax-x", "0px");
        gate.style.setProperty("--kisara-post-parallax-y", "0px");
        gate.style.setProperty("--kisara-post-release-opacity", "0");
        clearTitleDataCanvas();
        clearPostReleaseCanvas();
      };

      const setPostReleaseActive = (active) => {
        if (postReleaseActive === active) return;
        postReleaseActive = active;
        gate.classList.toggle("is-post-release", active);
        if (!active) {
          stopPostReleaseAnimation(true);
          return;
        }
        resizePostReleaseCanvas(true);
        postReleaseStartedAt = performance.now();
        startPostReleaseAnimation();
      };

      const beginPostReleaseJourney = (direction, timestamp) => {
        if (!postReleaseActive || !precisePointer || reducedMotion || direction === 0) return;
        const destination = direction * postReleaseMaxX;
        if (
          direction === postReleaseDirection
          && Math.abs(postReleaseTargetX - destination) < 0.01
        ) return;
        if (
          direction !== postReleaseDirection
          && timestamp - postReleaseDirectionChangedAt < 110
        ) return;
        const directionChanged = direction !== postReleaseDirection;
        postReleaseDirection = direction;
        postReleaseDirectionChangedAt = timestamp;
        if (directionChanged) {
          const targetFlowAngle = Math.atan2(-0.42, -direction);
          const turnImpulse = shortestAngleDelta(postReleaseFlowAngles[0], targetFlowAngle);
          postReleaseFlowAngularVelocities[0] += clamp(turnImpulse * 0.58, -1.55, 1.55);
          postReleaseFlowWhip = 1;
          postReleaseEmissionBudget = Math.min(postReleaseEmissionBudget, 0.75);
        }
        postReleaseTargetX = destination;
        const startPosition = postReleaseDataInitialized
          ? postReleaseDataPosition
          : direction > 0
            ? 85
            : 15;
        const endPosition = direction > 0 ? 15 : 85;
        postReleaseDataInitialized = true;
        postReleaseDataPosition = startPosition;
        postReleaseJourney = {
          direction,
          startX: postReleaseX,
          endX: destination,
          startPosition,
          endPosition,
          startedAt: timestamp,
          duration: Math.max(880, 900 + Math.abs(endPosition - startPosition) * 5)
        };
        startPostReleaseAnimation();
      };

      const handlePostReleasePointer = (event) => {
        if (
          !postReleaseActive
          || pageMode !== "gate"
          || !precisePointer
          || reducedMotion
          || window.scrollY > 2
        ) return;
        const gateRect = gate.getBoundingClientRect();
        if (
          event.clientX < gateRect.left
          || event.clientX > gateRect.right
          || event.clientY < gateRect.top
          || event.clientY > gateRect.bottom
        ) return;
        postReleaseTargetY = clamp(
          ((event.clientY - gateRect.top) / Math.max(1, gateRect.height) - 0.5) * 2 * postReleaseMaxY,
          -postReleaseMaxY,
          postReleaseMaxY
        );
        if (postReleasePointerX === null) {
          postReleasePointerX = event.clientX;
          return;
        }
        const deltaX = event.clientX - postReleasePointerX;
        postReleasePointerX = event.clientX;
        if (Math.abs(deltaX) < 0.15) return;
        if (
          postReleasePointerAccumulator !== 0
          && Math.sign(postReleasePointerAccumulator) !== Math.sign(deltaX)
        ) postReleasePointerAccumulator *= 0.32;
        postReleasePointerAccumulator = clamp(postReleasePointerAccumulator + deltaX, -24, 24);
        if (Math.abs(postReleasePointerAccumulator) < 7) return;
        const direction = Math.sign(postReleasePointerAccumulator);
        postReleasePointerAccumulator = 0;
        beginPostReleaseJourney(direction, event.timeStamp || performance.now());
      };

      const fightSource = postReleaseCanvas?.dataset.fightSrc;
      if (fightSource) {
        const fightImage = new Image();
        fightImage.decoding = "async";
        fightImage.addEventListener("load", () => {
          fightImageWidth = Math.max(1, fightImage.naturalWidth || fightImageWidth);
          fightImageHeight = Math.max(1, fightImage.naturalHeight || fightImageHeight);
          refreshPostReleaseLayout();
          if (postReleaseActive) startPostReleaseAnimation();
        }, { once: true });
        fightImage.src = fightSource;
      }

      const createSpaceLensRenderer = async () => {
        if (!spaceLensCanvas || reducedMotion) return null;
        const baseSource = spaceLensCanvas.dataset.baseSrc || spaceLensCanvas.dataset.fightSrc;
        const fightSource = spaceLensCanvas.dataset.fightSrc || spaceLensCanvas.dataset.baseSrc;
        if (!baseSource || !fightSource) return null;

        const gl = spaceLensCanvas.getContext("webgl2", {
          alpha: true,
          antialias: false,
          depth: false,
          stencil: false,
          premultipliedAlpha: true,
          preserveDrawingBuffer: false,
          powerPreference: "high-performance"
        });
        if (!gl) return null;

        const vertexSource = `#version 300 es
          precision highp float;
          const vec2 POSITIONS[3] = vec2[3](
            vec2(-1.0, -1.0),
            vec2(3.0, -1.0),
            vec2(-1.0, 3.0)
          );
          out vec2 vUv;
          void main() {
            vec2 position = POSITIONS[gl_VertexID];
            vUv = position * 0.5 + 0.5;
            gl_Position = vec4(position, 0.0, 1.0);
          }
        `;
        const fragmentSource = `#version 300 es
          precision highp float;
          in vec2 vUv;
          out vec4 outputColor;

          uniform sampler2D uBaseTexture;
          uniform sampler2D uFightTexture;
          uniform vec2 uResolution;
          uniform vec2 uBaseSize;
          uniform vec2 uFightSize;
          uniform vec2 uCenter;
          uniform float uReveal;
          uniform float uOpacity;
          uniform float uGravity;
          uniform float uCollapse;
          uniform float uCrush;
          uniform float uShockStrength;
          uniform float uShockRadius;
          uniform float uShockWidth;
          uniform float uCoreRadius;
          uniform float uLensRadius;
          uniform float uReconstruction;
          uniform float uReconstructionOpacity;
          uniform float uTime;

          vec2 coverUv(vec2 uv, vec2 imageSize, float scale) {
            float viewportAspect = uResolution.x / max(1.0, uResolution.y);
            float imageAspect = imageSize.x / max(1.0, imageSize.y);
            vec2 mapped = uv;
            if (imageAspect > viewportAspect) {
              float visibleWidth = viewportAspect / imageAspect;
              mapped.x = (mapped.x - 0.5) * visibleWidth + 0.5;
            } else {
              float visibleHeight = imageAspect / viewportAspect;
              mapped.y = (mapped.y - 0.5) * visibleHeight + 0.5;
            }
            mapped = (mapped - 0.5) / scale + 0.5;
            return clamp(mapped, vec2(0.001), vec2(0.999));
          }

          vec3 adjustSceneColor(vec3 color, float saturation, float brightness) {
            float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));
            return mix(vec3(luminance), color, saturation) * brightness;
          }

          float hash21(vec2 point) {
            point = fract(point * vec2(123.34, 456.21));
            point += dot(point, point + 45.32);
            return fract(point.x * point.y);
          }

          vec3 sampleScene(vec2 uv) {
            vec2 baseUv = coverUv(uv, uBaseSize, 1.045);
            vec2 fightUv = coverUv(uv, uFightSize, 1.0);
            vec3 baseColor = texture(uBaseTexture, baseUv).rgb;
            vec3 fightColor = texture(uFightTexture, fightUv).rgb;
            baseColor = adjustSceneColor(baseColor, 1.0 - uReveal * 0.26, 1.0 - uReveal * 0.14);
            fightColor = adjustSceneColor(fightColor, 0.84 + uReveal * 0.36, 0.86 + uReveal * 0.22);
            vec3 sceneColor = mix(baseColor, fightColor, smoothstep(0.0, 1.0, uReveal));
            float atmosphere = mix(0.58, 0.34, clamp(uv.y, 0.0, 1.0));
            return mix(sceneColor, vec3(0.027, 0.039, 0.122), atmosphere);
          }

          void main() {
            float aspect = uResolution.x / max(1.0, uResolution.y);
            vec2 point = vUv - uCenter;
            point.x *= aspect;
            float radius = length(point);
            vec2 direction = point / max(radius, 0.0001);
            vec2 tangent = vec2(-direction.y, direction.x);
            float core = max(uCoreRadius, 0.004);
            float gravityStrength = clamp(
              uGravity * (0.68 + uCollapse * 0.2 + uCrush * 0.12),
              0.0,
              1.12
            );
            float massRadius = max(
              core,
              0.044 + uCollapse * 0.009 + uCrush * 0.01
            );
            float lensReach = min(max(uLensRadius, massRadius * 4.0), 0.94);
            float outsideCore = smoothstep(core * 0.98, core * 1.22, radius);
            float reachProgress = smoothstep(core * 1.15, lensReach, radius);
            float radialReach = pow(max(0.0, 1.0 - reachProgress), 1.12);
            float gravityField = outsideCore * radialReach;
            float sideDistance = abs(vUv.x - 0.5);
            float sideMask = smoothstep(0.166, 0.195, sideDistance);
            float sideDepth = smoothstep(0.166, 0.5, sideDistance);
            float sideReach = max(
              radialReach,
              sideDepth * gravityStrength * (0.12 + uCollapse * 0.2 + uCrush * 0.24)
            );
            float distortionField = outsideCore
              * sideMask
              * sideReach
              * (0.86 + sideDepth * 0.86);

            float einsteinRadius = massRadius * (
              1.0
              + gravityStrength * 0.34
              + uCollapse * 0.1
              + uCrush * 0.08
            );
            float inverseRadius = max(radius, massRadius * 0.54);
            float lensPull = (einsteinRadius * einsteinRadius)
              / (radius * radius + core * core * 2.15)
              * gravityStrength;
            lensPull = min(lensPull, 0.82);
            float primaryRadius = radius / (1.0 + lensPull * distortionField * 1.18);

            float criticalRadius = einsteinRadius * sqrt(max(gravityStrength, 0.02));
            float ringWidth = max(massRadius * 0.2, 0.007);
            float causticDistance = (radius - criticalRadius) / ringWidth;
            float caustic = exp(-causticDistance * causticDistance)
              * distortionField
              * gravityStrength;

            float waveWidth = max(uShockWidth, 0.006);
            float waveCoordinate = (radius - uShockRadius) / waveWidth;
            float waveEnvelope = exp(-waveCoordinate * waveCoordinate);
            float waveDisplacement = -waveCoordinate
              * waveEnvelope
              * uShockStrength
              * (0.009 + waveWidth * 0.065)
              * sideMask;
            float fieldBreath = sin(
              (radius - core) / max(lensReach - core, 0.01) * 9.0 - uTime * 0.56
            ) * distortionField * uCollapse * 0.0032;

            float frameDrag = massRadius / inverseRadius
              * distortionField
              * uCollapse
              * gravityStrength
              * (0.078 + uCrush * 0.052);
            float dragCos = cos(frameDrag);
            float dragSin = sin(frameDrag);
            vec2 lensedDirection = vec2(
              direction.x * dragCos - direction.y * dragSin,
              direction.x * dragSin + direction.y * dragCos
            );
            float sideSweep = sin(vUv.y * 5.4 - uTime * 0.34)
              * (0.006 + uCollapse * 0.012 + uCrush * 0.018)
              * gravityStrength
              * sideReach
              * sideMask
              * sign(vUv.x - 0.5);
            float sidePolarity = sign(vUv.x - 0.5);
            float sideTension = gravityStrength
              * sideMask
              * (0.0045 + uCollapse * 0.015 + uCrush * 0.022)
              * (0.5 + sideDepth * 0.72);
            vec2 sideDisplacement = vec2(
              -sidePolarity * sideTension,
              sin(vUv.y * 10.5 + uTime * 0.86 + sidePolarity * 1.7)
                * sideTension
                * (0.38 + sideDepth * 0.34)
            );
            float sideFold = sin(vUv.y * 8.6 + sideDepth * 4.2 - uTime * 1.05)
              * gravityStrength
              * sideMask
              * (0.006 + uCollapse * 0.016 + uCrush * 0.021)
              * (0.48 + sideDepth * 0.52);
            float sideTorsion = cos(sideDepth * 8.0 - vUv.y * 3.2 + uTime * 0.72)
              * gravityStrength
              * sideMask
              * (0.003 + uCollapse * 0.009 + uCrush * 0.012);
            sideDisplacement += vec2(sidePolarity * sideFold, sideTorsion);
            sideDisplacement += vec2(
              -sidePolarity * waveEnvelope * uShockStrength * (0.008 + waveWidth * 0.12),
              cos(vUv.y * 13.0 - uTime * 1.1) * waveEnvelope * uShockStrength * 0.008
            ) * sideMask;

            float edgeFade = smoothstep(0.0, 0.055, vUv.x)
              * smoothstep(0.0, 0.055, vUv.y)
              * smoothstep(0.0, 0.055, 1.0 - vUv.x)
              * smoothstep(0.0, 0.055, 1.0 - vUv.y);
            vec2 lensedPoint = lensedDirection * (
              primaryRadius + waveDisplacement + fieldBreath
            ) + tangent * sideSweep;
            vec2 displacedPoint = mix(point, lensedPoint, edgeFade);
            vec2 displacedUv = uCenter + vec2(displacedPoint.x / aspect, displacedPoint.y);
            displacedUv = mix(vUv, displacedUv, sideMask);
            displacedUv += sideDisplacement * edgeFade;

            vec3 color = sampleScene(displacedUv);
            float refractionSheen = sin(vUv.y * 15.0 + sideDepth * 5.2 - uTime * 1.28)
              * sideMask
              * gravityStrength
              * (0.012 + uCollapse * 0.022 + uCrush * 0.026);
            color *= 1.0
              + caustic * 0.065
              + waveEnvelope * uShockStrength * sideMask * 0.028
              + refractionSheen;

            float horizon = 1.0 - smoothstep(core * 0.98, core * 1.04, radius);
            color = mix(color, vec3(0.0), horizon * sideMask);
            float lensAlpha = max(
              clamp(uOpacity, 0.0, 1.0),
              horizon * sideMask * smoothstep(0.05, 0.15, gravityStrength)
            );

            vec2 pixel = vUv * uResolution;
            vec2 dataCell = floor(pixel / 9.0);
            vec2 dataCellCenter = (dataCell + 0.5) * 9.0 / uResolution;
            vec2 dataPoint = dataCellCenter - uCenter;
            dataPoint.x *= aspect;
            float dataRadius = length(dataPoint);
            float farthestRadius = max(
              max(
                length(vec2(uCenter.x * aspect, uCenter.y)),
                length(vec2((1.0 - uCenter.x) * aspect, uCenter.y))
              ),
              max(
                length(vec2(uCenter.x * aspect, 1.0 - uCenter.y)),
                length(vec2((1.0 - uCenter.x) * aspect, 1.0 - uCenter.y))
              )
            );
            float reconstructionEase = 1.0 - pow(
              1.0 - clamp(uReconstruction, 0.0, 1.0),
              2.35
            );
            float reconstructionFront = reconstructionEase * farthestRadius;
            float reconstructionBand = max(0.055, farthestRadius * 0.085);
            float radialProgress = clamp(
              (reconstructionFront - dataRadius) / reconstructionBand + 0.5,
              0.0,
              1.0
            );
            float dataNoise = mix(
              hash21(dataCell),
              0.5 + 0.5 * sin(dataCell.x * 0.31 - dataCell.y * 0.47 + uTime * 4.2),
              0.42
            );
            float dataMask = smoothstep(
              dataNoise - 0.16,
              dataNoise + 0.16,
              radialProgress
            );
            float dataSettle = smoothstep(
              dataNoise + 0.04,
              dataNoise + 0.62,
              radialProgress
            );
            float dataFront = exp(-pow(
              (radialProgress - dataNoise) / 0.17,
              2.0
            ));
            vec2 localCell = fract(pixel / 9.0);
            float cellEdgeDistance = min(
              min(localCell.x, 1.0 - localCell.x),
              min(localCell.y, 1.0 - localCell.y)
            );
            float cellEdge = 1.0 - smoothstep(0.035, 0.14, cellEdgeDistance);
            vec3 blockColor = sampleScene(dataCellCenter);
            vec3 cleanColor = sampleScene(vUv);
            vec3 reconstructedColor = mix(blockColor, cleanColor, dataSettle);
            reconstructedColor += vec3(0.26, 0.035, 0.12)
              * dataFront
              * (0.38 + cellEdge * 0.62);
            reconstructedColor += vec3(0.075, 0.13, 0.28)
              * dataFront
              * cellEdge
              * (0.28 + 0.22 * sin(dataCell.x + dataCell.y));
            float reconstructionMix = dataMask * clamp(uReconstructionOpacity, 0.0, 1.0);
            color = mix(color, reconstructedColor, reconstructionMix);
            float reconstructionAlpha = reconstructionMix
              * (0.72 + dataFront * 0.28);
            float alpha = max(lensAlpha, reconstructionAlpha);
            outputColor = vec4(color * alpha, alpha);
          }
        `;

        const compileShader = (type, source) => {
          const shader = gl.createShader(type);
          if (!shader) return null;
          gl.shaderSource(shader, source);
          gl.compileShader(shader);
          if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
            gl.deleteShader(shader);
            return null;
          }
          return shader;
        };
        const vertexShader = compileShader(gl.VERTEX_SHADER, vertexSource);
        const fragmentShader = compileShader(gl.FRAGMENT_SHADER, fragmentSource);
        if (!vertexShader || !fragmentShader) return null;
        const program = gl.createProgram();
        if (!program) return null;
        gl.attachShader(program, vertexShader);
        gl.attachShader(program, fragmentShader);
        gl.linkProgram(program);
        gl.deleteShader(vertexShader);
        gl.deleteShader(fragmentShader);
        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
          gl.deleteProgram(program);
          return null;
        }
        const vertexArray = gl.createVertexArray();
        if (!vertexArray) {
          gl.deleteProgram(program);
          return null;
        }

        const loadTexture = (source) => new Promise((resolveTexture) => {
          const image = new Image();
          image.decoding = "async";
          image.onload = () => {
            const texture = gl.createTexture();
            if (!texture) {
              resolveTexture(null);
              return;
            }
            gl.bindTexture(gl.TEXTURE_2D, texture);
            gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
            gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image);
            resolveTexture({
              texture,
              width: image.naturalWidth || image.width,
              height: image.naturalHeight || image.height
            });
          };
          image.onerror = () => resolveTexture(null);
          image.src = source;
        });

        const [baseTexture, fightTexture] = await Promise.all([
          loadTexture(baseSource),
          loadTexture(fightSource)
        ]);
        if (!baseTexture || !fightTexture) {
          if (baseTexture?.texture) gl.deleteTexture(baseTexture.texture);
          if (fightTexture?.texture) gl.deleteTexture(fightTexture.texture);
          gl.deleteProgram(program);
          return null;
        }

        const uniforms = {
          baseTexture: gl.getUniformLocation(program, "uBaseTexture"),
          fightTexture: gl.getUniformLocation(program, "uFightTexture"),
          resolution: gl.getUniformLocation(program, "uResolution"),
          baseSize: gl.getUniformLocation(program, "uBaseSize"),
          fightSize: gl.getUniformLocation(program, "uFightSize"),
          center: gl.getUniformLocation(program, "uCenter"),
          reveal: gl.getUniformLocation(program, "uReveal"),
          opacity: gl.getUniformLocation(program, "uOpacity"),
          gravity: gl.getUniformLocation(program, "uGravity"),
          collapse: gl.getUniformLocation(program, "uCollapse"),
          crush: gl.getUniformLocation(program, "uCrush"),
          shockStrength: gl.getUniformLocation(program, "uShockStrength"),
          shockRadius: gl.getUniformLocation(program, "uShockRadius"),
          shockWidth: gl.getUniformLocation(program, "uShockWidth"),
          coreRadius: gl.getUniformLocation(program, "uCoreRadius"),
          lensRadius: gl.getUniformLocation(program, "uLensRadius"),
          reconstruction: gl.getUniformLocation(program, "uReconstruction"),
          reconstructionOpacity: gl.getUniformLocation(program, "uReconstructionOpacity"),
          time: gl.getUniformLocation(program, "uTime")
        };
        let cssWidth = 0;
        let cssHeight = 0;
        let sizeDirty = true;

        const resize = (force = false) => {
          if (!force && !sizeDirty) return;
          sizeDirty = false;
          const rect = spaceLensCanvas.getBoundingClientRect();
          cssWidth = Math.max(1, Math.round(rect.width));
          cssHeight = Math.max(1, Math.round(rect.height));
          const mobile = cssWidth < 640;
          const deviceScale = Math.min(window.devicePixelRatio || 1, 1);
          let renderScale = mobile ? 0.68 : cssWidth < 1000 ? 0.86 : 1;
          const maxPixels = mobile ? 360000 : 1300000;
          const estimatedPixels = cssWidth * cssHeight * deviceScale * deviceScale * renderScale * renderScale;
          if (estimatedPixels > maxPixels) renderScale *= Math.sqrt(maxPixels / estimatedPixels);
          const pixelWidth = Math.max(1, Math.round(cssWidth * deviceScale * renderScale));
          const pixelHeight = Math.max(1, Math.round(cssHeight * deviceScale * renderScale));
          if (spaceLensCanvas.width !== pixelWidth || spaceLensCanvas.height !== pixelHeight) {
            spaceLensCanvas.width = pixelWidth;
            spaceLensCanvas.height = pixelHeight;
          }
          gl.viewport(0, 0, pixelWidth, pixelHeight);
        };
        const requestResize = () => {
          sizeDirty = true;
          resize();
        };

        const clear = () => {
          spaceLensCanvas.style.opacity = "0";
          spaceLensCanvas.dataset.active = "false";
          gl.clearColor(0, 0, 0, 0);
          gl.clear(gl.COLOR_BUFFER_BIT);
        };

        const draw = (parameters) => {
          resize();
          gl.clearColor(0, 0, 0, 0);
          gl.clear(gl.COLOR_BUFFER_BIT);
          gl.useProgram(program);
          gl.bindVertexArray(vertexArray);
          gl.activeTexture(gl.TEXTURE0);
          gl.bindTexture(gl.TEXTURE_2D, baseTexture.texture);
          gl.uniform1i(uniforms.baseTexture, 0);
          gl.activeTexture(gl.TEXTURE1);
          gl.bindTexture(gl.TEXTURE_2D, fightTexture.texture);
          gl.uniform1i(uniforms.fightTexture, 1);
          gl.uniform2f(uniforms.resolution, cssWidth, cssHeight);
          gl.uniform2f(uniforms.baseSize, baseTexture.width, baseTexture.height);
          gl.uniform2f(uniforms.fightSize, fightTexture.width, fightTexture.height);
          gl.uniform2f(uniforms.center, parameters.centerX, parameters.centerY);
          gl.uniform1f(uniforms.reveal, parameters.reveal);
          gl.uniform1f(uniforms.opacity, parameters.opacity);
          gl.uniform1f(uniforms.gravity, parameters.gravity);
          gl.uniform1f(uniforms.collapse, parameters.collapse);
          gl.uniform1f(uniforms.crush, parameters.crush);
          gl.uniform1f(uniforms.shockStrength, parameters.shockStrength);
          gl.uniform1f(uniforms.shockRadius, parameters.shockRadius);
          gl.uniform1f(uniforms.shockWidth, parameters.shockWidth);
          gl.uniform1f(uniforms.coreRadius, parameters.coreRadius);
          gl.uniform1f(uniforms.lensRadius, parameters.lensRadius);
          gl.uniform1f(uniforms.reconstruction, parameters.reconstruction);
          gl.uniform1f(uniforms.reconstructionOpacity, parameters.reconstructionOpacity);
          gl.uniform1f(uniforms.time, parameters.time);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          spaceLensCanvas.style.opacity = "1";
          spaceLensCanvas.dataset.active = "true";
        };

        const destroy = () => {
          gl.deleteTexture(baseTexture.texture);
          gl.deleteTexture(fightTexture.texture);
          gl.deleteVertexArray(vertexArray);
          gl.deleteProgram(program);
          clear();
        };

        resize(true);
        clear();
        return { clear, destroy, draw, resize: requestResize };
      };

      const createTitleLensRenderer = () => {
        if (!titleLensCanvas || !title || reducedMotion) return null;
        const gl = titleLensCanvas.getContext("webgl2", {
          alpha: true,
          antialias: false,
          depth: false,
          stencil: false,
          premultipliedAlpha: true,
          preserveDrawingBuffer: false,
          powerPreference: "high-performance"
        });
        if (!gl) return null;

        const sourceCanvas = document.createElement("canvas");
        const sourceContext = sourceCanvas.getContext("2d");
        if (!sourceContext) return null;

        const vertexSource = `#version 300 es
          precision highp float;
          const vec2 POSITIONS[3] = vec2[3](
            vec2(-1.0, -1.0),
            vec2(3.0, -1.0),
            vec2(-1.0, 3.0)
          );
          out vec2 vUv;
          void main() {
            vec2 position = POSITIONS[gl_VertexID];
            vUv = position * 0.5 + 0.5;
            gl_Position = vec4(position, 0.0, 1.0);
          }
        `;
        const fragmentSource = `#version 300 es
          precision highp float;
          in vec2 vUv;
          out vec4 outputColor;

          uniform sampler2D uTitleTexture;
          uniform vec2 uResolution;
          uniform vec2 uCenter;
          uniform float uOpacity;
          uniform float uStrength;
          uniform float uGravity;
          uniform float uCollapse;
          uniform float uCrush;
          uniform float uShockStrength;
          uniform float uShockRadius;
          uniform float uShockWidth;
          uniform float uCoreRadius;
          uniform float uLensRadius;
          uniform float uRelease;
          uniform float uDissolve;
          uniform float uTime;

          float hash21(vec2 point) {
            point = fract(point * vec2(123.34, 456.21));
            point += dot(point, point + 45.32);
            return fract(point.x * point.y);
          }

          void main() {
            vec2 pixel = vUv * uResolution;
            vec2 point = pixel - uCenter;
            float radius = length(point);
            vec2 direction = point / max(radius, 0.001);
            vec2 tangent = vec2(-direction.y, direction.x);
            float core = max(uCoreRadius, 10.0);
            float reach = max(uLensRadius, core * 4.2);
            vec2 normalizedPoint = point / max(uResolution * 0.5, vec2(1.0));
            float horizontalEnvelope = 1.0 - smoothstep(0.72, 1.08, abs(normalizedPoint.x));
            float verticalEnvelope = 1.0 - smoothstep(0.58, 1.08, abs(normalizedPoint.y));
            float field = horizontalEnvelope * verticalEnvelope;
            float pressure = clamp(
              uStrength * (0.58 + uGravity * 0.26 + uCollapse * 0.22 + uCrush * 0.16),
              0.0,
              1.16
            );
            float orbitRadius = core * (1.75 + uCollapse * 0.2);
            float orbitBand = exp(-pow(
              (radius - orbitRadius) / max(core * 1.15, 12.0),
              2.0
            ));
            float sideBend = sin(normalizedPoint.x * 2.55)
              * (5.0 + uGravity * 5.0 + uCollapse * 9.0 + uCrush * 11.0)
              * field
              * pressure;
            float ribbonShear = normalizedPoint.y
              * (5.0 + uCollapse * 8.0 + uCrush * 9.0)
              * field
              * pressure
              * (0.5 + abs(normalizedPoint.x) * 0.5);
            float orbitBend = (4.0 + uCollapse * 8.0 + uCrush * 10.0)
              * orbitBand
              * field
              * pressure;
            float breathing = sin(
              normalizedPoint.x * 4.0 - uTime * 0.66
            ) * field * pressure * (0.7 + uCollapse * 1.1);

            float waveWidth = max(uShockWidth, 5.0);
            float waveCoordinate = (radius - uShockRadius) / waveWidth;
            float waveEnvelope = exp(-waveCoordinate * waveCoordinate);
            float shockPull = -waveCoordinate * waveEnvelope
              * uShockStrength
              * (7.0 + waveWidth * 0.12);

            float releaseReach = pow(uRelease, 1.18)
              * field
              * (10.0 + uCrush * 18.0 + uShockStrength * 16.0);
            float releaseFlutter = sin(
              normalizedPoint.x * 8.0
              + normalizedPoint.y * 5.0
              - uTime * 5.2
            ) * field * uRelease * (2.0 + uShockStrength * 4.5);

            vec2 sourcePixel = pixel
              + vec2(ribbonShear + breathing, sideBend)
              + tangent * orbitBend
              + direction * shockPull
              - direction * releaseReach
              + tangent * releaseFlutter;
            vec2 sourceUv = sourcePixel / uResolution;
            float edge = smoothstep(0.0, 0.025, sourceUv.x)
              * smoothstep(0.0, 0.025, sourceUv.y)
              * smoothstep(0.0, 0.025, 1.0 - sourceUv.x)
              * smoothstep(0.0, 0.025, 1.0 - sourceUv.y);
            vec4 titleColor = texture(uTitleTexture, clamp(sourceUv, vec2(0.001), vec2(0.999)));
            float caustic = orbitBand * field * pressure;
            float dissolveNoise = mix(
              hash21(floor(pixel / 9.0)),
              0.5 + 0.5 * sin(pixel.x * 0.045 - pixel.y * 0.072 + uTime * 4.2),
              0.42
            );
            float dissolveMask = 1.0 - smoothstep(
              dissolveNoise - 0.16,
              dissolveNoise + 0.16,
              clamp(uDissolve, 0.0, 1.0)
            );
            titleColor.rgb *= 1.0
              + caustic * 0.12
              + waveEnvelope * uShockStrength * 0.08
              + uRelease * dissolveMask * 0.24;
            float alpha = titleColor.a
              * edge
              * dissolveMask
              * clamp(uOpacity, 0.0, 1.0);
            outputColor = vec4(titleColor.rgb * edge * uOpacity, alpha);
          }
        `;

        const compileShader = (type, source) => {
          const shader = gl.createShader(type);
          if (!shader) return null;
          gl.shaderSource(shader, source);
          gl.compileShader(shader);
          if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
            gl.deleteShader(shader);
            return null;
          }
          return shader;
        };
        const vertexShader = compileShader(gl.VERTEX_SHADER, vertexSource);
        const fragmentShader = compileShader(gl.FRAGMENT_SHADER, fragmentSource);
        if (!vertexShader || !fragmentShader) return null;
        const program = gl.createProgram();
        if (!program) return null;
        gl.attachShader(program, vertexShader);
        gl.attachShader(program, fragmentShader);
        gl.linkProgram(program);
        gl.deleteShader(vertexShader);
        gl.deleteShader(fragmentShader);
        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
          gl.deleteProgram(program);
          return null;
        }
        const vertexArray = gl.createVertexArray();
        const titleTexture = gl.createTexture();
        if (!vertexArray || !titleTexture) {
          if (vertexArray) gl.deleteVertexArray(vertexArray);
          if (titleTexture) gl.deleteTexture(titleTexture);
          gl.deleteProgram(program);
          return null;
        }

        const uniforms = {
          titleTexture: gl.getUniformLocation(program, "uTitleTexture"),
          resolution: gl.getUniformLocation(program, "uResolution"),
          center: gl.getUniformLocation(program, "uCenter"),
          opacity: gl.getUniformLocation(program, "uOpacity"),
          strength: gl.getUniformLocation(program, "uStrength"),
          gravity: gl.getUniformLocation(program, "uGravity"),
          collapse: gl.getUniformLocation(program, "uCollapse"),
          crush: gl.getUniformLocation(program, "uCrush"),
          shockStrength: gl.getUniformLocation(program, "uShockStrength"),
          shockRadius: gl.getUniformLocation(program, "uShockRadius"),
          shockWidth: gl.getUniformLocation(program, "uShockWidth"),
          coreRadius: gl.getUniformLocation(program, "uCoreRadius"),
          lensRadius: gl.getUniformLocation(program, "uLensRadius"),
          release: gl.getUniformLocation(program, "uRelease"),
          dissolve: gl.getUniformLocation(program, "uDissolve"),
          time: gl.getUniformLocation(program, "uTime")
        };
        let cssWidth = 0;
        let cssHeight = 0;
        let renderScale = 1;
        let sizeDirty = true;

        const resize = (force = false) => {
          if (!force && !sizeDirty) return;
          sizeDirty = false;
          const rect = titleLensCanvas.getBoundingClientRect();
          const nextCssWidth = Math.max(1, rect.width);
          const nextCssHeight = Math.max(1, rect.height);
          const deviceScale = Math.min(window.devicePixelRatio || 1, 1.25);
          const nextRenderScale = Math.min(
            deviceScale,
            1536 / nextCssWidth,
            384 / nextCssHeight
          );
          const pixelWidth = Math.max(1, Math.round(nextCssWidth * nextRenderScale));
          const pixelHeight = Math.max(1, Math.round(nextCssHeight * nextRenderScale));
          const sizeChanged = titleLensCanvas.width !== pixelWidth
            || titleLensCanvas.height !== pixelHeight
            || sourceCanvas.width !== pixelWidth
            || sourceCanvas.height !== pixelHeight;
          cssWidth = nextCssWidth;
          cssHeight = nextCssHeight;
          renderScale = nextRenderScale;
          gl.viewport(0, 0, pixelWidth, pixelHeight);
          if (!force && !sizeChanged) return;
          if (titleLensCanvas.width !== pixelWidth || titleLensCanvas.height !== pixelHeight) {
            titleLensCanvas.width = pixelWidth;
            titleLensCanvas.height = pixelHeight;
          }
          if (sourceCanvas.width !== pixelWidth || sourceCanvas.height !== pixelHeight) {
            sourceCanvas.width = pixelWidth;
            sourceCanvas.height = pixelHeight;
          }

          const style = window.getComputedStyle(title);
          const fontSize = Math.max(1, Number.parseFloat(style.fontSize) * renderScale);
          sourceContext.clearRect(0, 0, pixelWidth, pixelHeight);
          sourceContext.save();
          sourceContext.font = `${style.fontWeight} ${fontSize}px ${style.fontFamily}`;
          sourceContext.textAlign = "center";
          sourceContext.textBaseline = "alphabetic";
          sourceContext.lineJoin = "round";
          const metrics = sourceContext.measureText("Kisara");
          const baseline = pixelHeight * 0.5
            + ((metrics.actualBoundingBoxAscent || fontSize * 0.72)
              - (metrics.actualBoundingBoxDescent || fontSize * 0.16)) * 0.5;
          const gradient = sourceContext.createLinearGradient(0, pixelHeight * 0.16, 0, pixelHeight * 0.86);
          gradient.addColorStop(0, "#ffdce6");
          gradient.addColorStop(0.24, "#ff8ca5");
          gradient.addColorStop(0.58, "#ff315e");
          gradient.addColorStop(1, "#c81343");
          sourceContext.shadowColor = "rgba(255, 45, 96, 0.34)";
          sourceContext.shadowBlur = Math.max(4, 10 * renderScale);
          sourceContext.strokeStyle = "rgba(255, 235, 242, 0.82)";
          sourceContext.lineWidth = Math.max(1.2, 1.8 * renderScale);
          sourceContext.strokeText("Kisara", pixelWidth * 0.5, baseline);
          sourceContext.fillStyle = gradient;
          sourceContext.fillText("Kisara", pixelWidth * 0.5, baseline);
          sourceContext.restore();

          gl.viewport(0, 0, pixelWidth, pixelHeight);
          gl.bindTexture(gl.TEXTURE_2D, titleTexture);
          gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
          gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, true);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
          gl.texImage2D(
            gl.TEXTURE_2D,
            0,
            gl.RGBA,
            gl.RGBA,
            gl.UNSIGNED_BYTE,
            sourceCanvas
          );
        };
        const requestResize = () => {
          sizeDirty = true;
          resize();
        };

        const clear = () => {
          titleLensCanvas.style.opacity = "0";
          titleLensCanvas.dataset.active = "false";
          gl.clearColor(0, 0, 0, 0);
          gl.clear(gl.COLOR_BUFFER_BIT);
        };

        const draw = (parameters) => {
          resize();
          const scaleX = titleLensCanvas.width / Math.max(1, cssWidth);
          const scaleY = titleLensCanvas.height / Math.max(1, cssHeight);
          gl.clearColor(0, 0, 0, 0);
          gl.clear(gl.COLOR_BUFFER_BIT);
          gl.useProgram(program);
          gl.bindVertexArray(vertexArray);
          gl.activeTexture(gl.TEXTURE0);
          gl.bindTexture(gl.TEXTURE_2D, titleTexture);
          gl.uniform1i(uniforms.titleTexture, 0);
          gl.uniform2f(uniforms.resolution, titleLensCanvas.width, titleLensCanvas.height);
          gl.uniform2f(
            uniforms.center,
            parameters.centerX * scaleX,
            (cssHeight - parameters.centerY) * scaleY
          );
          gl.uniform1f(uniforms.opacity, parameters.opacity);
          gl.uniform1f(uniforms.strength, parameters.strength);
          gl.uniform1f(uniforms.gravity, parameters.gravity);
          gl.uniform1f(uniforms.collapse, parameters.collapse);
          gl.uniform1f(uniforms.crush, parameters.crush);
          gl.uniform1f(uniforms.shockStrength, parameters.shockStrength);
          gl.uniform1f(uniforms.shockRadius, parameters.shockRadius * renderScale);
          gl.uniform1f(uniforms.shockWidth, parameters.shockWidth * renderScale);
          gl.uniform1f(uniforms.coreRadius, parameters.coreRadius * renderScale);
          gl.uniform1f(uniforms.lensRadius, parameters.lensRadius * renderScale);
          gl.uniform1f(uniforms.release, parameters.release);
          gl.uniform1f(uniforms.dissolve, parameters.dissolve);
          gl.uniform1f(uniforms.time, parameters.time);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          titleLensCanvas.style.opacity = "1";
          titleLensCanvas.dataset.active = "true";
        };

        const destroy = () => {
          gl.deleteTexture(titleTexture);
          gl.deleteVertexArray(vertexArray);
          gl.deleteProgram(program);
          clear();
        };

        resize(true);
        clear();
        return {
          clear,
          destroy,
          draw,
          refresh: () => {
            sizeDirty = true;
            resize(true);
          },
          resize: requestResize
        };
      };

      const startSpaceLens = () => {
        if (!spaceLensCanvas || reducedMotion) return;
        const generation = ++spaceLensInitGeneration;
        spaceLensCanvas.dataset.state = "loading";
        createSpaceLensRenderer().then((renderer) => {
          if (generation !== spaceLensInitGeneration) {
            renderer?.destroy();
            return;
          }
          spaceLensRenderer = renderer;
          spaceLensCanvas.dataset.state = renderer ? "ready" : "fallback";
        });
      };

      spaceLensCanvas?.addEventListener("webglcontextlost", (event) => {
        event.preventDefault();
        spaceLensInitGeneration += 1;
        spaceLensRenderer = null;
        spaceLensCanvas.style.opacity = "0";
        spaceLensCanvas.dataset.state = "lost";
      }, { passive: false });
      spaceLensCanvas?.addEventListener("webglcontextrestored", () => {
        startSpaceLens();
      }, { passive: true });
      startSpaceLens();

      const startTitleLens = () => {
        if (!titleLensCanvas || reducedMotion) return;
        const generation = ++titleLensInitGeneration;
        titleLensCanvas.dataset.state = "loading";
        const renderer = createTitleLensRenderer();
        if (generation !== titleLensInitGeneration) {
          renderer?.destroy();
          return;
        }
        titleLensRenderer = renderer;
        titleLensCanvas.dataset.state = renderer ? "ready" : "fallback";
      };

      titleLensCanvas?.addEventListener("webglcontextlost", (event) => {
        event.preventDefault();
        titleLensInitGeneration += 1;
        titleLensRenderer = null;
        titleLensCanvas.style.opacity = "0";
        titleLensCanvas.dataset.state = "lost";
        gate.style.setProperty("--kisara-title-source-opacity", "1");
      }, { passive: false });
      titleLensCanvas?.addEventListener("webglcontextrestored", () => {
        startTitleLens();
      }, { passive: true });
      startTitleLens();
      document.fonts?.ready.then(() => {
        titleLensRenderer?.refresh();
        resizeTitleDataCanvas(true);
      });

      const drawSpaceLens = (timestamp, parameters) => {
        if (!spaceLensRenderer || !spaceLensCanvas) return;
        const activeOpacity = Math.max(
          parameters.opacity,
          parameters.reconstructionOpacity ?? 0
        );
        if (activeOpacity <= 0.001 || pageMode !== "gate" || document.visibilityState !== "visible") {
          if (spaceLensCanvas.dataset.active === "true") spaceLensRenderer.clear();
          lastSpaceLensPaintTimestamp = 0;
          return;
        }
        const minimumInterval = gate.clientWidth < 640 ? 1000 / 30 : 1000 / 60;
        if (
          lastSpaceLensPaintTimestamp > 0
          && timestamp - lastSpaceLensPaintTimestamp < minimumInterval
        ) return;
        lastSpaceLensPaintTimestamp = timestamp;
        spaceLensRenderer.draw(parameters);
      };

      const drawTitleLens = (timestamp, parameters) => {
        if (!titleLensRenderer || !titleLensCanvas) {
          gate.style.setProperty("--kisara-title-source-opacity", "1");
          return;
        }
        const sourceOpacity = clamp(
          parameters.sourceOpacity ?? (1 - parameters.opacity),
          0,
          1
        );
        if (parameters.opacity <= 0.001 || pageMode !== "gate" || document.visibilityState !== "visible") {
          if (titleLensCanvas.dataset.active === "true") titleLensRenderer.clear();
          gate.style.setProperty("--kisara-title-source-opacity", sourceOpacity.toFixed(4));
          lastTitleLensPaintTimestamp = 0;
          return;
        }
        const minimumInterval = gate.clientWidth < 640 ? 1000 / 30 : 1000 / 60;
        if (
          lastTitleLensPaintTimestamp > 0
          && timestamp - lastTitleLensPaintTimestamp < minimumInterval
        ) return;
        lastTitleLensPaintTimestamp = timestamp;
        titleLensRenderer.draw(parameters);
        gate.style.setProperty(
          "--kisara-title-source-opacity",
          sourceOpacity.toFixed(4)
        );
      };

      const glitchAlphabet = "0123456789XZ!?/#@$%&<>";
      const makeGlitchState = (timestamp, burst, released) => {
        const tick = Math.floor(timestamp / 72);
        const patterns = released
          ? ["SIGNAL RELEASED", "CORE WITHOUT LIMIT", "CHANNEL UNBOUND", "OUTPUT OVERRUN"]
          : ["SYSTEM UNSTABLE", "KISARA OVERFLOW", "CONTRACT BREACH", "RED TIDE RISING"];
        const pattern = patterns[Math.floor(randomSeed(tick + 8401) * patterns.length)];
        const corrupted = pattern.split("").map((character, index) => {
          if (character === " " || randomSeed(tick * 31 + index + 8417) < 0.62) return character;
          const glyphIndex = Math.floor(randomSeed(tick * 47 + index + 8461) * glitchAlphabet.length);
          return glitchAlphabet[glyphIndex];
        }).join("");
        const code = Math.floor(randomSeed(tick + 8521) * 0xffffff).toString(16).toUpperCase().padStart(6, "0");
        const noise = Array.from({ length: 4 }, (_, index) => {
          const glyphIndex = Math.floor(randomSeed(tick * 59 + index + 8591) * glitchAlphabet.length);
          return glitchAlphabet[glyphIndex];
        }).join("");
        const phase = burst > 0.72 ? "// BREAK" : "// OVRFLW";
        return `${corrupted} ${phase} ${code} ${noise}`;
      };

      const resizeEnergyCanvas = (force = false) => {
        if (!energyCanvas || !energyContext) return;
        if (!force && energyCanvasWidth > 0 && energyCanvasHeight > 0) return;
        const rect = energyCanvas.getBoundingClientRect();
        const width = Math.max(1, Math.round(rect.width));
        const height = Math.max(1, Math.round(rect.height));
        const devicePixelRatio = Math.min(window.devicePixelRatio || 1, 2);
        const pixelWidth = Math.max(1, Math.round(width * devicePixelRatio));
        const pixelHeight = Math.max(1, Math.round(height * devicePixelRatio));
        if (energyCanvas.width !== pixelWidth || energyCanvas.height !== pixelHeight) {
          energyCanvas.width = pixelWidth;
          energyCanvas.height = pixelHeight;
          energyContext.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
        }
        energyCanvasWidth = width;
        energyCanvasHeight = height;
      };

      const resizeBurstCanvas = (force = false) => {
        if (!burstCanvas || !burstContext) return;
        if (!force && burstCanvasWidth > 0 && burstCanvasHeight > 0) return;
        const rect = burstCanvas.getBoundingClientRect();
        const width = Math.max(1, Math.round(rect.width));
        const height = Math.max(1, Math.round(rect.height));
        const ratioCap = width < 640 ? 1.16 : 1.38;
        const devicePixelRatio = Math.min(window.devicePixelRatio || 1, ratioCap);
        const pixelWidth = Math.max(1, Math.round(width * devicePixelRatio));
        const pixelHeight = Math.max(1, Math.round(height * devicePixelRatio));
        if (burstCanvas.width !== pixelWidth || burstCanvas.height !== pixelHeight) {
          burstCanvas.width = pixelWidth;
          burstCanvas.height = pixelHeight;
          burstContext.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
        }
        burstCanvasWidth = width;
        burstCanvasHeight = height;
        meterLayout = {
          width: meterShell?.clientWidth || Math.min(620, width * 0.78),
          height: meterShell?.clientHeight || 68,
          left: meterShell?.offsetLeft ?? (width - Math.min(620, width * 0.78)) / 2,
          top: meterShell?.offsetTop ?? height * 0.58
        };
        titleLayout = {
          width: title?.offsetWidth || Math.min(width * 0.82, 880),
          height: title?.offsetHeight || Math.min(height * 0.24, 190),
          left: title?.offsetLeft ?? width * 0.09,
          top: title?.offsetTop ?? height * 0.28
        };
      };

      const trimParticlePool = (particles, limit, seedOffset) => {
        while (particles.length > limit) {
          const index = Math.floor(
            randomSeed(particles.length * 1.371 + limit * 0.719 + seedOffset) * particles.length
          );
          particles[index] = particles[particles.length - 1];
          particles.pop();
        }
      };

      const updateRenderQuality = (timestamp, renderCost) => {
        if (!Number.isFinite(renderCost) || renderCost <= 0) return;
        renderCostEma = renderCostEma > 0
          ? renderCostEma * 0.92 + renderCost * 0.08
          : renderCost;
        if (timestamp - lastQualityAdjustment < 1200) return;
        lastQualityAdjustment = timestamp;
        const mobile = burstCanvasWidth > 0 ? burstCanvasWidth < 640 : window.innerWidth < 640;
        const highCost = mobile ? 13.5 : 16.5;
        const lowCost = mobile ? 7.4 : 9.2;
        if (renderCostEma > highCost && renderQuality > 0.7) {
          renderQuality = Math.max(0.7, renderQuality - 0.08);
          const width = burstCanvasWidth || window.innerWidth;
          trimParticlePool(
            wakeParticles,
            Math.floor((width < 640 ? 175 : 280) * (0.8 + renderQuality * 0.2)),
            11
          );
          trimParticlePool(
            orbitParticles,
            Math.floor((width < 640 ? 82 : 160) * renderQuality),
            23
          );
          trimParticlePool(
            burstParticles,
            Math.floor((width < 640 ? 120 : 220) * renderQuality),
            37
          );
          trimParticlePool(
            rainParticles,
            Math.floor((width < 640 ? 88 : 152) * renderQuality),
            53
          );
        } else if (renderCostEma < lowCost && renderQuality < 1) {
          renderQuality = Math.min(1, renderQuality + 0.035);
        }
      };

      const paintSingularityField = (context, timestamp, parameters) => {
        if (
          !singularityFieldContext
          || parameters.activity <= 0.001
          || parameters.opacity <= 0.001
        ) return false;

        const quality = clamp(parameters.quality, 0.7, 1);
        const activity = clamp(parameters.activity, 0, 1.35);
        const opacity = clamp(parameters.opacity, 0, 1);
        const compression = clamp(parameters.compression, 0, 1);
        const gravity = clamp(parameters.gravity, 0, 1);
        const radius = Math.max(5, parameters.radius);
        const time = timestamp / 1000;
        const fieldTargetSize = parameters.mobile
          ? (quality < 0.8 ? 68 : 80)
          : (quality < 0.8 ? 88 : 108);

        if (singularityFieldCanvas.width !== fieldTargetSize) {
          singularityFieldCanvas.width = fieldTargetSize;
          singularityFieldCanvas.height = fieldTargetSize;
          singularityFieldImageData = singularityFieldContext.createImageData(
            fieldTargetSize,
            fieldTargetSize
          );
          singularityFieldLastPaintTimestamp = 0;
        }

        const minimumInterval = parameters.mobile
          ? 1000 / 30
          : quality < 0.8
            ? 1000 / 36
            : 1000 / 45;
        const paintGap = singularityFieldLastPaintTimestamp > 0
          ? timestamp - singularityFieldLastPaintTimestamp
          : Number.POSITIVE_INFINITY;
        const electricPulse = 0.5
          + Math.sin(time * (4.7 + activity * 2.4)) * 0.23
          + Math.sin(time * 10.9 + 1.7) * 0.11;

        if (paintGap >= minimumInterval && singularityFieldImageData) {
          singularityFieldLastPaintTimestamp = timestamp;
          const fieldSize = singularityFieldCanvas.width;
          const pixels = singularityFieldImageData.data;
          const inverseHalfSize = 2 / fieldSize;
          const fieldTime = time * (0.92 + activity * 0.18);
          let offset = 0;

          for (let y = 0; y < fieldSize; y += 1) {
            const normalizedY = (y + 0.5) * inverseHalfSize - 1;
            for (let x = 0; x < fieldSize; x += 1) {
              const normalizedX = (x + 0.5) * inverseHalfSize - 1;
              const fieldX = normalizedX;
              const fieldY = normalizedY;
              const angle = Math.atan2(fieldY, fieldX);
              const baseRadius = Math.hypot(fieldX, fieldY);
              const boundaryBreath = 0.5
                + Math.sin(fieldTime * 0.74) * 0.28
                + Math.sin(fieldTime * 1.31 + 1.2) * 0.12;
              const boundary = 0.95
                + Math.sin(angle * 2.17 + 0.82) * 0.034 * (0.82 + boundaryBreath * 0.18)
                + Math.sin(angle * 5.03 - 1.34) * 0.021 * (0.88 + boundaryBreath * 0.12)
                + Math.cos(angle * 8.11 + 0.37) * 0.011;
              const fieldRadius = baseRadius / Math.max(0.74, boundary);
              const outerMask = 1 - smoothstep(clamp((fieldRadius - 0.7) / 0.33, 0, 1));
              const throatRadius = 0.135
                + (1 - compression) * 0.032
                + Math.sin(angle * 2.73 + 1.88) * 0.008 * (0.8 + boundaryBreath * 0.2)
                + Math.sin(angle * 6.13 - 0.54) * 0.004;
              const innerMask = smoothstep(clamp((fieldRadius - throatRadius) / 0.19, 0, 1));
              const fieldMask = outerMask * innerMask;

              if (fieldMask <= 0.0005) {
                pixels[offset] = 0;
                pixels[offset + 1] = 0;
                pixels[offset + 2] = 0;
                pixels[offset + 3] = 0;
                offset += 4;
                continue;
              }

              const warpX = fieldX
                + Math.sin(fieldY * 5.2 + fieldTime * 0.82) * 0.11
                + Math.sin((fieldX + fieldY) * 3.7 - fieldTime * 0.43) * 0.046;
              const warpY = fieldY
                + Math.cos(fieldX * 4.8 - fieldTime * 0.74) * 0.1
                + Math.cos((fieldX - fieldY) * 3.35 + fieldTime * 0.51) * 0.044;
              const currentA = Math.sin(
                warpX * (8.1 + gravity * 1.2)
                + warpY * 3.2
                - fieldTime * (1.54 + gravity * 0.34)
                + Math.sin(warpY * 4.7 + fieldTime * 0.39) * 0.78
              );
              const currentB = Math.sin(
                warpY * 8.9
                - warpX * 2.85
                + fieldTime * 1.27
                + Math.cos(warpX * 5.1 - fieldTime * 0.36) * 0.72
              );
              const crossCurrent = Math.cos(
                (warpX + warpY) * 6.15
                - fieldTime * 0.93
                + Math.sin((warpX - warpY) * 4.4 + fieldTime * 0.31) * 0.64
              );
              const ridgeA = Math.pow(
                Math.max(0, 1 - Math.abs(currentA * 0.68 + currentB * 0.32 - 0.06) / 0.37),
                3.55
              );
              const ridgeB = Math.pow(
                Math.max(0, 1 - Math.abs(currentB * 0.58 - crossCurrent * 0.42 + 0.11) / 0.35),
                3.65
              );
              const mist = (
                0.5
                + Math.sin(warpX * 4.5 + warpY * 3.8 - fieldTime * 0.78) * 0.5
              ) * (0.11 + gravity * 0.045);
              const electric = Math.max(ridgeA, ridgeB * 0.9);
              const brightness = clamp(
                (electric * 0.92 + mist)
                * fieldMask
                * (0.72 + electricPulse * 0.22)
                * (1 - compression * 0.24),
                0,
                1
              );
              const hue = 0.5
                + Math.sin(warpX * 3.35 - warpY * 2.65 + fieldTime * 0.41 + crossCurrent * 0.72) * 0.5;
              const whiteHeat = Math.pow(electric, 4) * (0.28 + gravity * 0.26);

              pixels[offset] = Math.round(136 + hue * 103 + whiteHeat * 20);
              pixels[offset + 1] = Math.round(45 + electric * 96 + whiteHeat * 72);
              pixels[offset + 2] = Math.round(196 + (1 - hue) * 54 + whiteHeat * 5);
              pixels[offset + 3] = Math.round(255 * brightness * activity * 0.78);
              offset += 4;
            }
          }

          singularityFieldContext.setTransform(1, 0, 0, 1, 0, 0);
          singularityFieldContext.globalCompositeOperation = "source-over";
          singularityFieldContext.globalAlpha = 1;
          singularityFieldContext.putImageData(singularityFieldImageData, 0, 0);
        }

        const fieldWidth = radius * (3.88 + gravity * 0.34);
        const fieldHeight = radius * (3.56 + gravity * 0.3);
        context.save();
        context.globalCompositeOperation = "lighter";
        context.globalAlpha = opacity * activity * (0.82 + electricPulse * 0.18);
        context.imageSmoothingEnabled = true;
        context.drawImage(
          singularityFieldCanvas,
          -fieldWidth * 0.5,
          -fieldHeight * 0.5,
          fieldWidth,
          fieldHeight
        );
        context.restore();

        const streamCount = parameters.mobile ? 2 : 3;
        context.save();
        context.globalCompositeOperation = "lighter";
        context.lineCap = "round";
        context.lineJoin = "round";
        for (let stream = 0; stream < streamCount; stream += 1) {
          const seed = randomSeed(stream + 19421);
          const anchorAngle = seed * fullTurn + (stream - 1) * 0.43;
          for (let fragment = 0; fragment < 2; fragment += 1) {
            const travel = (time * (0.11 + seed * 0.045) + seed + fragment * 0.43) % 1;
            const startUnit = Math.max(0, travel - 0.075);
            const endUnit = Math.min(1, travel + 0.075);
            if (endUnit - startUnit < 0.035) continue;
            const points = [];
            const segments = 5;
            for (let segment = 0; segment <= segments; segment += 1) {
              const unit = startUnit + (endUnit - startUnit) * (segment / segments);
              const distance = radius * (
                1.72 - unit * (1.34 + seed * 0.12)
              ) * (1 - compression * (0.24 + unit * 0.38));
              const localBend = (seed - 0.5) * 0.34 * (1 - unit)
                + Math.sin(unit * 8.2 + time * (0.72 + seed * 0.24) + stream) * 0.035;
              const angle = anchorAngle + localBend;
              points.push({
                x: Math.cos(angle) * distance,
                y: Math.sin(angle) * distance * (0.9 + seed * 0.08)
              });
            }
            const path = createSmoothCanvasPath(points);
            const pulse = Math.sin(clamp((travel - startUnit) / Math.max(0.001, endUnit - startUnit), 0, 1) * Math.PI);
            context.globalAlpha = opacity
              * activity
              * (0.055 + pulse * 0.075)
              * (1 - compression * 0.58);
            context.strokeStyle = stream === 0
              ? "rgba(181, 211, 255, 0.72)"
              : "rgba(255, 91, 153, 0.76)";
            context.lineWidth = 1.05 + gravity * 0.72;
            context.shadowColor = context.strokeStyle;
            context.shadowBlur = (4 + gravity * 5) * parameters.shadowQuality;
            context.stroke(path);
          }
        }
        context.restore();

        const collapseScale = 1 - compression * 0.58;
        const driftX = Math.sin(time * 0.43) * radius * 0.007 * (1 - compression);
        const driftY = Math.sin(time * 0.37 + 1.74) * radius * 0.006 * (1 - compression);
        const buildVoidPath = (scale, phaseOffset, roughness = 1, aspect = 0.96) => {
          const points = [];
          const pointCount = parameters.mobile ? 18 : 24;
          const radiusX = radius * scale * collapseScale;
          const radiusY = radius * scale * aspect * collapseScale;
          const contourBreath = 0.78
            + Math.sin(time * 0.66 + phaseOffset) * 0.12
            + Math.sin(time * 1.17 + phaseOffset * 0.43) * 0.06;
          for (let index = 0; index < pointCount; index += 1) {
            const angle = index / pointCount * fullTurn;
            const wobble = 1
              + Math.sin(angle * 2.13 + phaseOffset)
                * (0.028 + gravity * 0.008) * roughness * contourBreath
              + Math.sin(angle * 5.07 - phaseOffset * 1.31)
                * 0.016 * roughness
              + Math.cos(angle * 8.17 + phaseOffset * 0.67)
                * 0.008 * roughness;
            points.push({
              x: driftX * (1 - scale * 0.32) + Math.cos(angle) * radiusX * wobble,
              y: driftY * (1 - scale * 0.28) + Math.sin(angle) * radiusY * wobble
            });
          }
          return createClosedCanvasPath(points);
        };

        context.save();
        context.globalCompositeOperation = "source-over";
        const absorptionVeilRadius = radius * 1.46 * collapseScale;
        const absorptionVeil = context.createRadialGradient(
          driftX * 0.42,
          driftY * 0.42,
          0,
          0,
          0,
          absorptionVeilRadius
        );
        absorptionVeil.addColorStop(0, "rgba(0,0,4,0.82)");
        absorptionVeil.addColorStop(0.48, "rgba(3,1,10,0.46)");
        absorptionVeil.addColorStop(0.8, "rgba(11,3,22,0.16)");
        absorptionVeil.addColorStop(1, "rgba(8,2,18,0)");
        context.globalAlpha = opacity * (0.44 + gravity * 0.13 + compression * 0.08);
        context.fillStyle = absorptionVeil;
        context.fill(buildVoidPath(1.42, 0.84, 1.52));

        const cloudCount = parameters.mobile ? 7 : 10;
        for (let cloud = 0; cloud < cloudCount; cloud += 1) {
          const seed = randomSeed(cloud + 19747);
          const cloudAngle = seed * fullTurn + (cloud % 3 - 1) * 0.18;
          const inwardPulse = 0.5 + Math.sin(time * (0.38 + seed * 0.24) + seed * 13.7) * 0.5;
          const cloudDistance = radius
            * (0.035 + seed * 0.19)
            * (0.76 + inwardPulse * 0.24)
            * (1 - compression * 0.76);
          const cloudX = driftX + Math.cos(cloudAngle) * cloudDistance;
          const cloudY = driftY + Math.sin(cloudAngle) * cloudDistance * 0.9;
          const cloudRadius = radius * collapseScale * (0.38 + seed * 0.46);
          const cloudFlatten = 0.74 + randomSeed(cloud + 19789) * 0.2;
          context.save();
          context.translate(cloudX, cloudY);
          context.rotate(cloudAngle * 0.16 + Math.sin(time * 0.31 + cloud) * 0.035);
          context.scale(1, cloudFlatten);
          const cloudGradient = context.createRadialGradient(0, 0, 0, 0, 0, cloudRadius);
          cloudGradient.addColorStop(0, "rgba(0,0,3,0.88)");
          cloudGradient.addColorStop(0.42, "rgba(1,0,6,0.62)");
          cloudGradient.addColorStop(0.74, "rgba(7,2,16,0.2)");
          cloudGradient.addColorStop(1, "rgba(9,3,18,0)");
          context.globalAlpha = opacity * (0.23 + seed * 0.17 + compression * 0.055);
          context.fillStyle = cloudGradient;
          context.fillRect(-cloudRadius, -cloudRadius, cloudRadius * 2, cloudRadius * 2);
          context.restore();
        }

        context.save();
        context.globalCompositeOperation = "source-over";
        const voidLayers = [
          {
            scale: 0.39,
            phase: 0.84,
            roughness: 1.55,
            aspect: 0.97,
            alpha: 0.16,
            fill: "rgba(7,2,18,0.9)",
            blur: radius * 0.12,
            offsetX: -0.038,
            offsetY: 0.016
          },
          {
            scale: 0.31,
            phase: 1.92,
            roughness: 2.2,
            aspect: 0.94,
            alpha: 0.4,
            fill: "rgba(2,0,8,0.96)",
            blur: radius * 0.075,
            offsetX: 0.028,
            offsetY: -0.021
          },
          {
            scale: 0.235,
            phase: 3.67,
            roughness: 3.25,
            aspect: 0.9,
            alpha: 0.68,
            fill: "rgba(0,0,2,0.99)",
            blur: radius * 0.026,
            offsetX: -0.014,
            offsetY: 0.025
          },
          {
            scale: 0.082,
            phase: 5.18,
            roughness: 4.6,
            aspect: 0.86,
            alpha: 0.94,
            fill: "rgba(0,0,0,0.998)",
            blur: 0,
            offsetX: 0.022,
            offsetY: -0.012
          }
        ];
        for (const layer of voidLayers) {
          context.save();
          context.translate(radius * layer.offsetX, radius * layer.offsetY);
          context.globalAlpha = opacity
            * layer.alpha
            * (0.92 + compression * 0.08);
          context.fillStyle = layer.fill;
          context.shadowColor = layer.fill;
          context.shadowBlur = layer.blur * parameters.shadowQuality;
          context.fill(buildVoidPath(
            layer.scale,
            layer.phase,
            layer.roughness,
            layer.aspect
          ));
          context.restore();
        }
        context.shadowBlur = 0;
        context.restore();
        context.restore();

        context.save();
        context.globalCompositeOperation = "lighter";
        context.lineCap = "round";
        for (let arc = 0; arc < 2; arc += 1) {
          const seed = randomSeed(arc + 19681);
          const start = seed * fullTurn + arc * 0.71;
          const span = 0.24 + seed * 0.22;
          const points = [];
          const segments = 6;
          for (let segment = 0; segment <= segments; segment += 1) {
            const unit = segment / segments;
            const angle = start + span * unit;
            const edgeRadius = radius * collapseScale * (
              0.96
              + Math.sin(angle * 4.7 + arc * 1.8) * 0.028
              + Math.sin(time * (0.86 + seed * 0.34) + unit * Math.PI) * 0.012
            );
            points.push({
              x: driftX + Math.cos(angle) * edgeRadius,
              y: driftY + Math.sin(angle) * edgeRadius * 0.95
            });
          }
          const edgePath = createSmoothCanvasPath(points);
          const flicker = Math.pow(
            0.5 + Math.sin(time * (1.7 + seed * 0.8) + seed * 19.4) * 0.5,
            2.2
          );
          context.globalAlpha = opacity
            * (0.035 + gravity * 0.055)
            * (0.34 + flicker * 0.66)
            * (1 - compression * 0.48);
          context.strokeStyle = arc % 2 === 0
            ? "rgba(255, 112, 165, 0.86)"
            : "rgba(182, 211, 255, 0.78)";
          context.lineWidth = 0.5 + gravity * 0.42;
          context.shadowColor = context.strokeStyle;
          context.shadowBlur = (3 + gravity * 5) * parameters.shadowQuality;
          context.stroke(edgePath);
        }
        context.restore();
        return true;
      };

      const drawScreenEnergy = (timestamp) => {
        if (!burstCanvas || !burstContext) return;
        if (burstCanvasWidth <= 0 || burstCanvasHeight <= 0) resizeBurstCanvas();
        const width = burstCanvasWidth;
        const height = burstCanvasHeight;
        const context = burstContext;
        context.clearRect(0, 0, width, height);
        if (width <= 1 || height <= 1) return;

        const frameSeconds = screenParticleTimestamp
          ? clamp((timestamp - screenParticleTimestamp) / 1000, 0.008, 0.05)
          : 1 / 60;
        screenParticleTimestamp = timestamp;
        const time = timestamp / 1000;
        const fill = Math.max(energyProgress, 0.012);
        const burst = clamp(burstProgress, 0, 1);
        const intensity = 0.12 + fill * 0.88;
        const densityScale = (width < 640 ? 0.62 : width < 960 ? 0.82 : 1) * renderQuality;
        const shadowQuality = renderQuality;
        const meterWidth = meterLayout.width || Math.min(620, width * 0.78);
        const meterHeight = meterLayout.height || 68;
        const meterLeft = meterLayout.left || (width - meterWidth) / 2;
        const meterTop = meterLayout.top || height * 0.58;
        const localFrontRadius = 5 + fill * 22;
        const localFrontX = clamp(
          meterWidth * fill,
          3,
          Math.max(3, meterWidth - localFrontRadius * 2.2)
        );
        const angleRadians = beamPose.angle * Math.PI / 180;
        const headOffset = (localFrontX - meterWidth * 0.5) * beamPose.scaleX;
        const chargeFlight = getChargeFlightGeometry(chargeIntroProgress, width, height);
        const rigidOriginX = clamp(
          meterLeft + meterWidth * 0.5 + beamPose.anchorX + Math.cos(angleRadians) * headOffset,
          width * 0.04,
          width * 0.96
        );
        const rigidOriginY = clamp(
          meterTop + meterHeight * 0.5 + beamPose.anchorY + beamPose.lift + Math.sin(angleRadians) * headOffset,
          height * 0.08,
          height * 0.92
        );
        const flightBlend = phaseProgress(chargeIntroProgress, 0.14, 0.22);
        const stableOriginX = rigidOriginX + (chargeFlight.head.x - rigidOriginX) * flightBlend;
        const stableOriginY = rigidOriginY + (chargeFlight.head.y - rigidOriginY) * flightBlend;
        const originX = clamp(stableOriginX + beamPose.shakeX * 0.36, width * 0.04, width * 0.96);
        const originY = clamp(stableOriginY + beamPose.shakeY * 0.36, height * 0.08, height * 0.92);
        const headFrameSeconds = beamHeadTimestamp
          ? clamp((timestamp - beamHeadTimestamp) / 1000, 0.008, 0.05)
          : frameSeconds;
        if (!beamHeadTimestamp || fill <= 0.018) {
          beamHeadX = stableOriginX;
          beamHeadY = stableOriginY;
          beamHeadVelocityX = 0;
          beamHeadVelocityY = 0;
          beamMotionEnergy = 0;
        } else {
          let rawVelocityX = (stableOriginX - beamHeadX) / headFrameSeconds;
          let rawVelocityY = (stableOriginY - beamHeadY) / headFrameSeconds;
          const rawSpeed = Math.hypot(rawVelocityX, rawVelocityY);
          if (rawSpeed > 980) {
            const speedScale = 980 / rawSpeed;
            rawVelocityX *= speedScale;
            rawVelocityY *= speedScale;
          }
          const velocityResponse = 1 - Math.exp(-headFrameSeconds * 10.5);
          beamHeadVelocityX += (rawVelocityX - beamHeadVelocityX) * velocityResponse;
          beamHeadVelocityY += (rawVelocityY - beamHeadVelocityY) * velocityResponse;
          const motionTarget = clamp(Math.hypot(beamHeadVelocityX, beamHeadVelocityY) / 620, 0, 1);
          const motionResponse = 1 - Math.exp(-headFrameSeconds * (motionTarget < beamMotionEnergy ? 8.5 : 5.8));
          beamMotionEnergy += (motionTarget - beamMotionEnergy) * motionResponse;
          beamHeadX = stableOriginX;
          beamHeadY = stableOriginY;
        }
        beamHeadTimestamp = timestamp;
        const maxRadius = Math.hypot(width, height) * 1.18;
        const dissolve = phaseProgress(burst, 0.015, 0.14);
        const releaseBuild = phaseProgress(burst, crossEnd, reformEnd);
        const releasePressure = phaseProgress(burst, 0.855, shockwaveStart);
        const shockwaveLinear = clamp((burst - shockwaveStart) / (detonationStart - shockwaveStart), 0, 1);
        const shockwave = smoothstep(shockwaveLinear);
        const detonationLinear = clamp((burst - detonationStart) / (detonationEnd - detonationStart), 0, 1);
        const detonation = smoothstep(detonationLinear);
        const rainBuild = phaseProgress(burst, rainStart, rainPeak);
        const rainStop = phaseProgress(burst, rainPeak, 1);
        const wakeOpacity = clamp(1 - dissolve, 0, 1);
        const afterglow = phaseProgress(burst, detonationStart, detonationEnd)
          * (1 - phaseProgress(burst, rainPeak, 1));
        const aftermath = phaseProgress(burst, detonationStart + 0.006, detonationEnd)
          * (1 - phaseProgress(burst, rainPeak, 1));
        const blackHoleBuild = phaseProgress(burst, crossEnd, collapseStart - 0.006);
        const gravityLock = phaseProgress(burst, 0.85, collapseEnd);
        const collapse = phaseProgress(burst, collapseStart, collapseEnd);
        const collapseDepth = Math.pow(collapse, 1.48);
        const terminalCrush = phaseProgress(collapse, 0.62, 1);
        const crushCompression = Math.pow(terminalCrush, 1.85);
        const blackHoleFade = 1 - phaseProgress(
          detonationLinear,
          0.18,
          0.92
        );
        const blackHoleOpacity = blackHoleBuild * blackHoleFade;
        const blackHoleAngle = -0.16 - collapseDepth * 0.16;

        context.save();
        context.globalCompositeOperation = "lighter";

        if (wakeOpacity > 0.001) {
          const ambientCount = Math.floor((10 + fill * 34) * densityScale);
          for (let index = 0; index < ambientCount; index += 1) {
            const seedX = randomSeed(index + 1201);
            const seedY = randomSeed(index + 1801);
            const speed = 0.18 + seedX * (0.28 + fill * 0.56);
            let x = (seedX * width + Math.sin(time * speed + index) * (5 + fill * 17) + width) % width;
            let y = (seedY * height + Math.cos(time * (speed + 0.17) + index) * (4 + fill * 13) + height) % height;
            const size = 0.42 + seedY * (0.6 + fill * 1.25);
            const gravityX = originX - x;
            const gravityY = originY - y;
            const gravityDistance = Math.max(1, Math.hypot(gravityX, gravityY));
            const gravityFalloff = 1 - clamp(gravityDistance / maxRadius, 0, 1);
            const screenPull = gravityLock * gravityFalloff
              * (0.018 + collapseDepth * 0.12 + crushCompression * 0.075 + shockwave * 0.018);
            x += gravityX * screenPull;
            y += gravityY * screenPull;
            context.globalAlpha = (0.018 + seedX * 0.085) * intensity * wakeOpacity;
            context.fillStyle = fill > 0.56 && index % 3 !== 0 ? "#ff9caf" : "#c5d8ff";
            if (gravityLock > 0.025) {
              const inverseDistance = 1 / gravityDistance;
              const streakLength = gravityLock * gravityFalloff * (3 + seedX * 16);
              context.globalAlpha *= 0.72 + gravityLock * 0.48;
              context.strokeStyle = context.fillStyle;
              context.lineWidth = 0.45 + size * 0.38;
              context.lineCap = "round";
              context.beginPath();
              context.moveTo(x - gravityX * inverseDistance * streakLength, y - gravityY * inverseDistance * streakLength);
              context.lineTo(x, y);
              context.stroke();
            }
            context.beginPath();
            context.arc(x, y, size, 0, Math.PI * 2);
            context.fill();
          }
        }

        const chargeFlightOpacity = phaseProgress(
          chargeIntroProgress,
          chargeHandoffStart,
          chargeHandoffEnd
        )
          * (1 - phaseProgress(chargeIntroProgress, 0.86, 1));
        drawChargeFlightBeam(
          context,
          timestamp,
          chargeFlight,
          chargeFlightOpacity,
          intensity,
          width
        );

        if (fill <= 0.018) wakePrimed = false;
        const wakeLimit = Math.floor((width < 640 ? 175 : 280) * (0.8 + renderQuality * 0.2));
        const forwardX = Math.cos(angleRadians);
        const forwardY = Math.sin(angleRadians);
        const normalX = -forwardY;
        const normalY = forwardX;
        const spawnWakeParticle = (launchBoost = 1, primed = false) => {
          const sideNoise = nextParticleRandom() + nextParticleRandom() - 1;
          const sideDirection = sideNoise >= 0 ? 1 : -1;
          const inheritedMotion = 0.64 + nextParticleRandom() * 0.24;
          const slipSpeed = (24 + fill * 72 + nextParticleRandom() * 46) * launchBoost;
          const sideSpeed = sideNoise * (10 + fill * 42)
            * (0.52 + nextParticleRandom() * 0.76)
            * Math.sqrt(launchBoost);
          const exhaustAcceleration = (92 + fill * 238 + nextParticleRandom() * 118) * launchBoost;
          const lateralAcceleration = sideDirection * (22 + fill * 92)
            * (0.42 + Math.abs(sideNoise) * 0.9 + nextParticleRandom() * 0.32);
          let velocityX = beamHeadVelocityX * inheritedMotion - forwardX * slipSpeed + normalX * sideSpeed;
          let velocityY = beamHeadVelocityY * inheritedMotion - forwardY * slipSpeed + normalY * sideSpeed;
          const startGap = 2 + localFrontRadius * 0.3;
          const sideOffset = sideNoise * localFrontRadius * (0.08 + nextParticleRandom() * 0.2);
          const startX = originX - forwardX * startGap + normalX * sideOffset;
          const startY = originY - forwardY * startGap + normalY * sideOffset;
          const warmup = primed ? nextParticleRandom() * (0.08 + fill * 0.22) : 0;
          const warmupExhaust = exhaustAcceleration * warmup;
          const warmupLateral = lateralAcceleration * warmup;
          const x = startX + velocityX * warmup
            - forwardX * warmupExhaust * warmup * 0.5
            + normalX * warmupLateral * warmup * 0.5;
          const y = startY + velocityY * warmup
            - forwardY * warmupExhaust * warmup * 0.5
            + normalY * warmupLateral * warmup * 0.5;
          velocityX += -forwardX * warmupExhaust + normalX * warmupLateral;
          velocityY += -forwardY * warmupExhaust + normalY * warmupLateral;
          const historySeconds = Math.min(frameSeconds, 0.022) * (1.1 + nextParticleRandom() * 0.8);
          wakeParticles.push({
            x,
            y,
            previousX: x - velocityX * historySeconds,
            previousY: y - velocityY * historySeconds,
            velocityX,
            velocityY,
            age: warmup,
            jetLife: 0.58 + nextParticleRandom() * 0.66,
            coastLife: 1.45 + nextParticleRandom() * 1.65,
            life: 7.8 + nextParticleRandom() * 5.6,
            size: 0.58 + nextParticleRandom() * (1 + fill * 1.48),
            phase: nextParticleRandom() * Math.PI * 2,
            curl: (nextParticleRandom() - 0.5) * 2,
            forwardX,
            forwardY,
            normalX,
            normalY,
            exhaustAcceleration,
            lateralAcceleration,
            tint: Math.floor(nextParticleRandom() * 5)
          });
        };

        if (!reducedMotion && wakeOpacity > 0.02 && fill > 0.025 && burst < 0.02) {
          if (!wakePrimed) {
            wakePrimed = true;
            const primeCount = width < 640 ? 18 : width < 960 ? 24 : 30;
            for (let index = 0; index < primeCount && wakeParticles.length < wakeLimit; index += 1) {
              spawnWakeParticle(1.04 + nextParticleRandom() * 0.24, true);
            }
          }
          wakeEmissionBudget += frameSeconds * (14 + fill * 48 + beamMotionEnergy * 44) * densityScale;
          while (wakeEmissionBudget >= 1 && wakeParticles.length < wakeLimit) {
            wakeEmissionBudget -= 1;
            spawnWakeParticle(1 + fill * 0.12 + beamMotionEnergy * 0.12);
          }
        } else {
          wakeEmissionBudget = Math.min(wakeEmissionBudget, 0.95);
        }

        if (wakeOpacity <= 0.001 && wakeParticles.length) wakeParticles.length = 0;

        for (let index = wakeParticles.length - 1; index >= 0; index -= 1) {
          const particle = wakeParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life) {
            wakeParticles[index] = wakeParticles[wakeParticles.length - 1];
            wakeParticles.pop();
            continue;
          }

          particle.previousX = particle.x;
          particle.previousY = particle.y;
          const inJet = particle.age < particle.jetLife;
          const inCoast = particle.age < particle.jetLife + particle.coastLife;
          const jetProgress = clamp(particle.age / particle.jetLife, 0, 1);
          const drag = Math.exp(-frameSeconds * (inJet ? 0.46 : inCoast ? 0.14 : 0.08));
          particle.velocityX *= drag;
          particle.velocityY *= drag;
          if (inJet) {
            const exhaustForce = particle.exhaustAcceleration * (0.52 + (1 - jetProgress) * 0.48);
            const separationForce = particle.lateralAcceleration * (0.24 + jetProgress * 0.76);
            particle.velocityX += (-particle.forwardX * exhaustForce + particle.normalX * separationForce) * frameSeconds;
            particle.velocityY += (-particle.forwardY * exhaustForce + particle.normalY * separationForce) * frameSeconds;
          }
          const particleSpeed = Math.max(1, Math.hypot(particle.velocityX, particle.velocityY));
          const curveX = -particle.velocityY / particleSpeed;
          const curveY = particle.velocityX / particleSpeed;
          if (inCoast) {
            const curveStrength = particle.curl * (inJet ? 2.6 : 3.6) * (0.45 + particle.size * 0.24);
            particle.velocityX += curveX * curveStrength * frameSeconds;
            particle.velocityY += curveY * curveStrength * frameSeconds;
          } else {
            const driftAge = particle.age - particle.jetLife;
            particle.velocityX += Math.sin(particle.phase + driftAge * (0.54 + particle.size * 0.08))
              * frameSeconds * (3.2 + particle.size * 1.4);
            particle.velocityY += Math.cos(particle.phase * 0.73 + driftAge * 0.46)
              * frameSeconds * (2.1 + particle.size * 0.9);
            particle.velocityY -= frameSeconds * (0.52 + particle.size * 0.18);
          }
          particle.x += particle.velocityX * frameSeconds;
          particle.y += particle.velocityY * frameSeconds;

          if (!inJet && !inCoast) {
            if (particle.x < 10 && particle.velocityX < 0) particle.velocityX *= -0.46;
            if (particle.x > width - 10 && particle.velocityX > 0) particle.velocityX *= -0.46;
            if (particle.y < 10 && particle.velocityY < 0) particle.velocityY *= -0.42;
            if (particle.y > height - 10 && particle.velocityY > 0) particle.velocityY *= -0.42;
            particle.x = clamp(particle.x, -20, width + 20);
            particle.y = clamp(particle.y, -20, height + 20);
          }

          const lifeRatio = particle.age / particle.life;
          const fadeIn = smoothstep(clamp(particle.age / 0.14, 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeRatio - 0.74) / 0.26, 0, 1));
          const alpha = fadeIn * fadeOut * (inJet ? 0.68 : inCoast ? 0.54 : 0.42)
            * intensity * wakeOpacity;
          if (alpha <= 0.004) continue;

          context.globalAlpha = alpha;
          context.strokeStyle = particle.tint === 0
            ? "#ffffff"
            : particle.tint < 3
              ? "#ff9bb1"
              : "#bfd6ff";
          context.fillStyle = context.strokeStyle;
          context.lineCap = "round";
          if (inJet || inCoast) {
            const coastFade = inJet ? 1 : 1 - clamp((particle.age - particle.jetLife) / particle.coastLife, 0, 1) * 0.34;
            const trailScale = inJet ? 1.9 + beamMotionEnergy * 0.8 : 1.3;
            const motionX = particle.x - particle.previousX;
            const motionY = particle.y - particle.previousY;
            context.globalAlpha = alpha * coastFade;
            context.lineWidth = particle.size * (inJet ? 0.78 : 0.62);
            context.beginPath();
            context.moveTo(
              particle.previousX - motionX * (trailScale - 1),
              particle.previousY - motionY * (trailScale - 1)
            );
            context.lineTo(particle.x, particle.y);
            context.stroke();
          } else {
            const pulse = 0.76 + Math.sin(time * 1.2 + particle.phase) * 0.24;
            context.globalAlpha = alpha * pulse;
            context.beginPath();
            context.arc(particle.x, particle.y, particle.size * (0.46 + pulse * 0.22), 0, Math.PI * 2);
            context.fill();
          }
        }

        const viewportScale = Math.min(width, height);
        const baseCoreRadius = clamp(viewportScale * 0.09, 28, 82);
        const coreRadius = baseCoreRadius
          * (0.86 + blackHoleBuild * 0.18)
          * (1 - collapseDepth * 0.58)
          * (1 - crushCompression * 0.48)
          * (1 + shockwave * 0.05);
        const diskRadius = coreRadius
          * (3.12 + blackHoleBuild * 0.62)
          * (1 - collapseDepth * 0.18)
          * (1 - crushCompression * 0.16)
          * (1 + shockwave * 0.11);
        const diskFlatten = Math.max(
          0.105,
          (0.27 + blackHoleBuild * 0.055) * (1 - collapseDepth * 0.48 - crushCompression * 0.12)
        );

        const orbitLimit = Math.floor((width < 640 ? 82 : 160) * renderQuality);
        const orbitDrive = blackHoleOpacity * (1 - detonationLinear) * (1 - crushCompression * 0.78);
        if (!reducedMotion && orbitDrive > 0.01) {
          orbitEmissionBudget += frameSeconds * (18 + gravityLock * 86) * densityScale;
          while (orbitEmissionBudget >= 1 && orbitParticles.length < orbitLimit) {
            orbitEmissionBudget -= 1;
            orbitParticles.push({
              angle: nextParticleRandom() * Math.PI * 2,
              radius: diskRadius * (1.05 + nextParticleRandom() * 1.55),
              angularVelocity: (0.16 + nextParticleRandom() * 0.34) * (nextParticleRandom() > 0.16 ? 1 : -1),
              radialSpeed: 10 + nextParticleRandom() * 18,
              lane: 0.74 + nextParticleRandom() * 0.34,
              age: 0,
              life: 4.8 + nextParticleRandom() * 5.4,
              size: 0.45 + nextParticleRandom() * 1.35,
              escape: nextParticleRandom() < 0.18,
              tint: Math.floor(nextParticleRandom() * 6)
            });
          }
        } else {
          orbitEmissionBudget = Math.min(orbitEmissionBudget, 0.95);
        }

        const projectOrbit = (angle, radius, lane) => {
          const localX = Math.cos(angle) * radius;
          const localY = Math.sin(angle) * radius * diskFlatten * lane;
          return {
            x: originX + localX * Math.cos(blackHoleAngle) - localY * Math.sin(blackHoleAngle),
            y: originY + localX * Math.sin(blackHoleAngle) + localY * Math.cos(blackHoleAngle)
          };
        };

        for (let index = orbitParticles.length - 1; index >= 0; index -= 1) {
          const particle = orbitParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life || blackHoleOpacity <= 0.001) {
            orbitParticles[index] = orbitParticles[orbitParticles.length - 1];
            orbitParticles.pop();
            continue;
          }
          const previousAngle = particle.angle;
          const previousRadius = particle.radius;
          const orbitAcceleration = 1 + gravityLock * 0.9 + collapseDepth * 0.8 + crushCompression * 1.4;
          particle.angle += particle.angularVelocity * frameSeconds * orbitAcceleration
            * Math.pow(diskRadius / Math.max(coreRadius, particle.radius), 0.46);
          particle.radius -= (
            particle.radialSpeed
            + gravityLock * (11 + particle.size * 7)
            + collapseDepth * (32 + particle.size * 12)
            + crushCompression * (115 + particle.size * 42)
          ) * frameSeconds;

          if (particle.radius <= coreRadius * 1.12) {
            if (
              particle.escape
              && gravityLock > 0.54
              && detonationLinear <= 0.001
              && burstParticles.length < (width < 640 ? 110 : 210)
            ) {
              const escapePoint = projectOrbit(particle.angle, coreRadius * 1.18, particle.lane);
              const tangentAngle = particle.angle + (particle.angularVelocity > 0 ? Math.PI / 2 : -Math.PI / 2) + blackHoleAngle;
              const escapeSpeed = 150 + gravityLock * 260 + nextParticleRandom() * 120;
              burstParticles.push({
                x: escapePoint.x,
                y: escapePoint.y,
                previousX: escapePoint.x,
                previousY: escapePoint.y,
                velocityX: Math.cos(tangentAngle) * escapeSpeed + Math.cos(blackHoleAngle) * escapeSpeed * 0.18,
                velocityY: Math.sin(tangentAngle) * escapeSpeed + Math.sin(blackHoleAngle) * escapeSpeed * 0.18,
                age: 0,
                life: 2.8 + nextParticleRandom() * 3.6,
                size: particle.size * (0.9 + nextParticleRandom() * 0.8),
                drag: 0.3 + nextParticleRandom() * 0.42,
                gravity: 4 + nextParticleRandom() * 14,
                phase: nextParticleRandom() * Math.PI * 2,
                tint: particle.tint,
                shape: nextParticleRandom()
              });
              orbitParticles[index] = orbitParticles[orbitParticles.length - 1];
              orbitParticles.pop();
              continue;
            }
            if (burst < detonationStart && blackHoleOpacity > 0.2 && terminalCrush < 0.72) {
              particle.radius = diskRadius * (1.6 + nextParticleRandom() * 0.92);
              particle.angle += Math.PI * (0.42 + nextParticleRandom() * 0.34);
            } else {
              orbitParticles[index] = orbitParticles[orbitParticles.length - 1];
              orbitParticles.pop();
              continue;
            }
          }

          const previousPoint = projectOrbit(previousAngle, previousRadius, particle.lane);
          const point = projectOrbit(particle.angle, particle.radius, particle.lane);
          particle.previousRenderX = previousPoint.x;
          particle.previousRenderY = previousPoint.y;
          particle.renderX = point.x;
          particle.renderY = point.y;
          particle.depth = Math.sin(particle.angle);
        }

        const drawOrbitParticle = (particle) => {
          const lifeRatio = particle.age / particle.life;
          const fadeIn = smoothstep(clamp(particle.age / 0.14, 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeRatio - 0.72) / 0.28, 0, 1));
          const coreProximity = clamp((particle.radius - coreRadius) / Math.max(1, diskRadius * 1.55), 0, 1);
          context.globalAlpha = fadeIn * fadeOut * blackHoleOpacity * (0.28 + (1 - coreProximity) * 0.56);
          context.strokeStyle = particle.tint === 0
            ? "#ffffff"
            : particle.tint < 4
              ? "#ff89a9"
              : "#b9d4ff";
          context.fillStyle = context.strokeStyle;
          context.lineWidth = particle.size * (0.58 + gravityLock * 0.38);
          context.lineCap = "round";
          context.beginPath();
          context.moveTo(particle.previousRenderX, particle.previousRenderY);
          context.lineTo(particle.renderX, particle.renderY);
          context.stroke();
          if (particle.size > 1.12) {
            context.globalAlpha *= 0.48;
            context.beginPath();
            context.arc(particle.renderX, particle.renderY, particle.size * 0.4, 0, Math.PI * 2);
            context.fill();
          }
        };

        if (blackHoleOpacity > 0.001) {
          context.save();
          context.globalCompositeOperation = "source-over";
          const gravityShade = context.createRadialGradient(
            originX,
            originY,
            coreRadius * 0.4,
            originX,
            originY,
            maxRadius * 0.72
          );
          gravityShade.addColorStop(0, "rgba(1, 1, 8, 0.18)");
          gravityShade.addColorStop(0.22, "rgba(7, 3, 17, 0.12)");
          gravityShade.addColorStop(0.58, "rgba(20, 5, 26, 0.045)");
          gravityShade.addColorStop(1, "rgba(3, 4, 13, 0)");
          context.globalAlpha = blackHoleOpacity * (0.34 + collapse * 0.36);
          context.fillStyle = gravityShade;
          context.fillRect(0, 0, width, height);
          context.restore();

          if (collapse > 0.001 && detonationLinear <= 0.001) {
            context.save();
            context.globalCompositeOperation = "lighter";
            context.lineCap = "round";
            for (let ring = 0; ring < 5; ring += 1) {
              const delayed = phaseProgress(collapse, ring * 0.055, 1);
              if (delayed <= 0.001) continue;
              const ringPlunge = Math.pow(delayed, 1.38);
              const ringRadius = diskRadius * (3.05 - ring * 0.34) * (1 - ringPlunge * 0.9);
              const ringPulse = Math.pow(Math.sin(delayed * Math.PI), 0.68);
              context.globalAlpha = blackHoleOpacity * ringPulse * (0.12 + ring * 0.028 + crushCompression * 0.16);
              context.strokeStyle = ring === 2 ? "rgba(255,248,251,0.94)" : "rgba(255,103,148,0.8)";
              context.lineWidth = 0.7 + delayed * (3.6 - ring * 0.42) + crushCompression * 1.4;
              context.shadowColor = ring === 2 ? "rgba(255,255,255,0.9)" : "rgba(255,55,120,0.9)";
              context.shadowBlur = (7 + delayed * 17 + crushCompression * 12) * shadowQuality;
              context.beginPath();
              context.ellipse(
                originX,
                originY,
                ringRadius,
                ringRadius * (0.48 + ring * 0.035),
                blackHoleAngle,
                0,
                Math.PI * 2
              );
              context.stroke();
            }

            const inwardCount = Math.max(16, Math.floor((width < 640 ? 22 : 34) * renderQuality));
            for (let index = 0; index < inwardCount; index += 1) {
              const seed = randomSeed(index + 13701);
              const delayed = phaseProgress(collapse, seed * 0.16, 1);
              if (delayed <= 0.001) continue;
              const angle = seed * Math.PI * 2 + blackHoleAngle + Math.sin(seed * 17.3) * 0.22;
              const outerRadius = Math.max(baseCoreRadius * 4.2, diskRadius * (2.5 + seed * 3.2));
              const innerRadius = coreRadius * (0.3 + seed * 0.36);
              const plunge = clamp(
                Math.pow(delayed, 1.34) + Math.pow(phaseProgress(delayed, 0.58, 1), 2.2) * 0.32,
                0,
                1
              );
              const currentRadius = outerRadius + (innerRadius - outerRadius) * plunge;
              const streakLength = 22 + delayed * (72 + seed * 104) + crushCompression * 46;
              const tangent = angle + Math.PI / 2;
              const curl = (seed - 0.5) * Math.max(diskRadius, baseCoreRadius * 1.4) * 0.28 * delayed
                * (1 - crushCompression * 0.72);
              const endX = originX + Math.cos(angle) * currentRadius + Math.cos(tangent) * curl;
              const endY = originY + Math.sin(angle) * currentRadius * 0.62 + Math.sin(tangent) * curl * 0.62;
              const startX = originX + Math.cos(angle) * (currentRadius + streakLength);
              const startY = originY + Math.sin(angle) * (currentRadius + streakLength) * 0.62;
              const gradient = context.createLinearGradient(startX, startY, endX, endY);
              gradient.addColorStop(0, "rgba(144,181,255,0)");
              gradient.addColorStop(0.55, index % 3 === 0 ? "rgba(195,217,255,0.34)" : "rgba(255,105,151,0.28)");
              gradient.addColorStop(1, index % 4 === 0 ? "rgba(255,255,255,0.9)" : "rgba(255,115,157,0.72)");
              context.globalAlpha = blackHoleOpacity * delayed * (0.16 + seed * 0.26 + crushCompression * 0.16);
              context.strokeStyle = gradient;
              context.lineWidth = 0.5 + delayed * (0.9 + seed * 1.2) + crushCompression * 0.55;
              context.shadowBlur = (3 + delayed * 7 + crushCompression * 5) * shadowQuality;
              context.beginPath();
              context.moveTo(startX, startY);
              context.quadraticCurveTo(
                originX + Math.cos(angle + (seed - 0.5) * 0.35) * (currentRadius + streakLength * 0.38),
                originY + Math.sin(angle + (seed - 0.5) * 0.35) * (currentRadius + streakLength * 0.38) * 0.62,
                endX,
                endY
              );
              context.stroke();
            }

            const compressionGlowRadius = Math.max(
              5,
              coreRadius * (0.72 + (1 - collapseDepth) * 2.65)
            );
            const compressionGlow = context.createRadialGradient(
              originX,
              originY,
              0,
              originX,
              originY,
              compressionGlowRadius
            );
            compressionGlow.addColorStop(0, "rgba(255,255,255,0.98)");
            compressionGlow.addColorStop(0.16, "rgba(255,214,230,0.86)");
            compressionGlow.addColorStop(0.48, "rgba(255,68,128,0.32)");
            compressionGlow.addColorStop(1, "rgba(255,68,128,0)");
            context.globalAlpha = blackHoleOpacity * Math.pow(collapse, 2.05) * (0.72 + crushCompression * 0.26);
            context.fillStyle = compressionGlow;
            context.fillRect(
              originX - compressionGlowRadius,
              originY - compressionGlowRadius,
              compressionGlowRadius * 2,
              compressionGlowRadius * 2
            );

            if (crushCompression > 0.001) {
              const singularityRadius = Math.max(3.5, baseCoreRadius * (0.31 - crushCompression * 0.19));
              const singularity = context.createRadialGradient(
                originX,
                originY,
                0,
                originX,
                originY,
                singularityRadius
              );
              singularity.addColorStop(0, "rgba(255,255,255,1)");
              singularity.addColorStop(0.18, "rgba(255,239,247,0.98)");
              singularity.addColorStop(0.52, "rgba(255,71,132,0.72)");
              singularity.addColorStop(1, "rgba(255,40,111,0)");
              context.globalAlpha = blackHoleOpacity * Math.pow(crushCompression, 2.6);
              context.fillStyle = singularity;
              context.shadowColor = "rgba(255,75,135,0.96)";
              context.shadowBlur = (12 + crushCompression * 24) * shadowQuality;
              context.beginPath();
              context.arc(originX, originY, singularityRadius, 0, Math.PI * 2);
              context.fill();
            }
            context.restore();
          }

          context.save();
          context.globalCompositeOperation = "lighter";
          context.shadowBlur = 0;
          for (let lens = 0; lens < 3; lens += 1) {
            const lensPhase = (time * (0.1 + lens * 0.025) + lens * 0.31) % 1;
            const lensRadius = coreRadius * (1.8 + lens * 1.15)
              + lensPhase * maxRadius * (0.2 + gravityLock * 0.18);
            const lensFade = (1 - lensPhase) * blackHoleOpacity * (0.075 + gravityLock * 0.08);
            context.globalAlpha = lensFade;
            context.strokeStyle = lens % 2 === 0 ? "rgba(255, 111, 151, 0.72)" : "rgba(156, 190, 255, 0.64)";
            context.lineWidth = 0.7 + gravityLock * 1.15;
            context.beginPath();
            context.ellipse(
              originX,
              originY,
              lensRadius,
              lensRadius * (0.52 + lens * 0.035),
              blackHoleAngle,
              0,
              Math.PI * 2
            );
            context.stroke();
          }
          context.restore();

          context.save();
          context.globalCompositeOperation = "lighter";
          for (const particle of orbitParticles) {
            if (particle.depth < 0 && particle.renderX !== undefined) drawOrbitParticle(particle);
          }

          context.translate(originX, originY);
          context.rotate(blackHoleAngle);
          const diskGradient = context.createLinearGradient(-diskRadius, 0, diskRadius, 0);
          diskGradient.addColorStop(0, "rgba(111, 157, 255, 0)");
          diskGradient.addColorStop(0.18, "rgba(143, 184, 255, 0.42)");
          diskGradient.addColorStop(0.46, "rgba(255, 89, 137, 0.86)");
          diskGradient.addColorStop(0.58, "rgba(255, 242, 248, 0.98)");
          diskGradient.addColorStop(0.78, "rgba(255, 107, 149, 0.62)");
          diskGradient.addColorStop(1, "rgba(255, 107, 149, 0)");

          for (let band = 0; band < 4; band += 1) {
            context.globalAlpha = blackHoleOpacity * (0.14 + band * 0.038) * (0.78 + gravityLock * 0.54);
            context.strokeStyle = diskGradient;
            context.lineWidth = 1.7 + (4 - band) * (1.7 + gravityLock * 0.82);
            context.shadowColor = band < 2 ? "rgba(140, 181, 255, 0.72)" : "rgba(255, 77, 126, 0.9)";
            context.shadowBlur = (7 + (4 - band) * 3 + gravityLock * 12) * shadowQuality;
            context.beginPath();
            context.ellipse(
              0,
              0,
              diskRadius * (0.92 + band * 0.035),
              diskRadius * diskFlatten * (0.84 + band * 0.055),
              0,
              Math.PI,
              Math.PI * 2
            );
            context.stroke();
          }

          context.globalAlpha = blackHoleOpacity * (0.17 + gravityLock * 0.16);
          context.strokeStyle = diskGradient;
          context.lineWidth = coreRadius * (0.16 + gravityLock * 0.055);
          context.shadowColor = "rgba(255, 77, 128, 0.88)";
          context.shadowBlur = (22 + gravityLock * 22) * shadowQuality;
          context.beginPath();
          context.ellipse(0, 0, diskRadius * 1.02, diskRadius * diskFlatten * 0.96, 0, 0, Math.PI * 2);
          context.stroke();

          const halo = context.createRadialGradient(0, 0, coreRadius * 0.7, 0, 0, diskRadius * 1.08);
          halo.addColorStop(0, "rgba(255, 92, 137, 0.14)");
          halo.addColorStop(0.42, "rgba(255, 82, 131, 0.07)");
          halo.addColorStop(0.76, "rgba(139, 176, 255, 0.035)");
          halo.addColorStop(1, "rgba(139, 176, 255, 0)");
          context.globalAlpha = blackHoleOpacity * (0.72 + gravityLock * 0.34);
          context.fillStyle = halo;
          context.fillRect(-diskRadius * 1.12, -diskRadius, diskRadius * 2.24, diskRadius * 2);

          const lightningActivity = clamp(
            blackHoleBuild * (0.42 + gravityLock * 0.7) + collapseDepth * 0.12,
            0,
            1.28
          );
          const lightningRadius = Math.max(
            5,
            coreRadius * (1.02 + blackHoleBuild * 0.08 + gravityLock * 0.08)
          );
          paintSingularityField(context, timestamp, {
            mobile: width < 640,
            quality: renderQuality,
            activity: lightningActivity,
            opacity: blackHoleOpacity,
            radius: lightningRadius,
            gravity: gravityLock,
            shadowQuality,
            compression: clamp(collapseDepth * 0.36 + crushCompression * 0.82, 0, 1)
          });

          context.globalCompositeOperation = "lighter";
          for (let band = 0; band < 3; band += 1) {
            context.globalAlpha = blackHoleOpacity * (0.34 + band * 0.082) * (0.8 + gravityLock * 0.46);
            context.strokeStyle = diskGradient;
            context.lineWidth = 2 + (3 - band) * (2.15 + gravityLock * 0.96);
            context.shadowColor = "rgba(255, 74, 125, 0.9)";
            context.shadowBlur = (8 + (3 - band) * 3 + gravityLock * 14) * shadowQuality;
            context.beginPath();
            context.ellipse(
              0,
              0,
              diskRadius * (0.9 + band * 0.042),
              diskRadius * diskFlatten * (0.82 + band * 0.06),
              0,
              0,
              Math.PI
            );
            context.stroke();
          }

          const lensingHeight = coreRadius * (1.92 + gravityLock * 0.52);
          for (let sideIndex = 0; sideIndex < 2; sideIndex += 1) {
            const side = sideIndex === 0 ? -1 : 1;
            context.globalAlpha = blackHoleOpacity * (0.3 + gravityLock * 0.34);
            context.strokeStyle = side < 0 ? "rgba(184, 211, 255, 0.78)" : "rgba(255, 170, 195, 0.82)";
            context.lineWidth = 1.3 + gravityLock * 1.35;
            context.shadowColor = context.strokeStyle;
            context.shadowBlur = (8 + gravityLock * 11) * shadowQuality;
            context.beginPath();
            context.moveTo(-diskRadius * 0.66, side * coreRadius * 0.12);
            context.bezierCurveTo(
              -coreRadius * 1.18,
              side * lensingHeight,
              coreRadius * 1.18,
              side * lensingHeight,
              diskRadius * 0.66,
              side * coreRadius * 0.08
            );
            context.stroke();
          }

          for (let highlight = 0; highlight < 4; highlight += 1) {
            const seed = randomSeed(highlight + 7301);
            const phase = time * (0.42 + seed * 0.5) + seed * Math.PI * 2;
            const span = 0.18 + seed * 0.42;
            context.globalAlpha = blackHoleOpacity * (0.12 + gravityLock * 0.18) * (0.46 + seed * 0.54);
            context.strokeStyle = highlight % 3 === 0 ? "#ffffff" : highlight % 2 === 0 ? "#ff8fab" : "#bed7ff";
            context.lineWidth = 0.55 + seed * 1.15;
            context.shadowBlur = (3 + gravityLock * 7) * shadowQuality;
            context.beginPath();
            context.ellipse(0, 0, diskRadius * (0.96 + seed * 0.16), diskRadius * diskFlatten, 0, phase, phase + span);
            context.stroke();
          }

          context.restore();

          context.save();
          context.globalCompositeOperation = "lighter";
          for (const particle of orbitParticles) {
            if (particle.depth >= 0 && particle.renderX !== undefined) drawOrbitParticle(particle);
          }
          context.restore();
        }

        const burstLimit = Math.floor((width < 640 ? 120 : 220) * renderQuality);
        const spawnBurstWave = (waveIndex) => {
          const waveCounts = [48, 64, 76];
          const count = Math.floor(waveCounts[waveIndex] * densityScale);
          for (let index = 0; index < count && burstParticles.length < burstLimit; index += 1) {
            const angle = nextParticleRandom() * Math.PI * 2;
            const spawnRadius = coreRadius * (0.82 + nextParticleRandom() * 0.92);
            const localX = Math.cos(angle) * spawnRadius;
            const localY = Math.sin(angle) * spawnRadius * diskFlatten;
            const spawnX = originX + localX * Math.cos(blackHoleAngle) - localY * Math.sin(blackHoleAngle);
            const spawnY = originY + localX * Math.sin(blackHoleAngle) + localY * Math.cos(blackHoleAngle);
            const lobeSign = nextParticleRandom() > 0.5 ? 1 : -1;
            const spreadNoise = nextParticleRandom() + nextParticleRandom() - 1;
            const axisAngle = blackHoleAngle + (lobeSign < 0 ? Math.PI : 0);
            const directionAngle = axisAngle + spreadNoise * (waveIndex === 0 ? 0.3 : 0.68);
            const directionX = Math.cos(directionAngle);
            const directionY = Math.sin(directionAngle);
            const swirlDirection = nextParticleRandom() > 0.5 ? 1 : -1;
            const swirlX = -directionY * swirlDirection;
            const swirlY = directionX * swirlDirection;
            const speed = (waveIndex === 0 ? 248 : 174)
              + nextParticleRandom() * (waveIndex === 0 ? 330 : 260);
            const swirlWeight = (waveIndex === 0 ? 0.1 : 0.2) + nextParticleRandom() * 0.12;
            const velocityX = directionX * speed + swirlX * speed * swirlWeight;
            const velocityY = directionY * speed + swirlY * speed * swirlWeight;
            const historyTime = 0.012 + nextParticleRandom() * 0.022;
            burstParticles.push({
              x: spawnX,
              y: spawnY,
              previousX: spawnX - velocityX * historyTime,
              previousY: spawnY - velocityY * historyTime,
              velocityX,
              velocityY,
              age: 0,
              life: 3.15 + nextParticleRandom() * 3.25 + waveIndex * 0.34,
              size: 0.58 + nextParticleRandom() * (1.52 + waveIndex * 0.34),
              drag: 0.38 + nextParticleRandom() * 0.44,
              gravity: 2 + nextParticleRandom() * 12,
              phase: nextParticleRandom() * Math.PI * 2,
              tint: Math.floor(nextParticleRandom() * 6),
              shape: nextParticleRandom(),
              spark: nextParticleRandom() < 0.18
            });
          }
        };

        if (!reducedMotion && shockwaveLinear > 0.001 && shockwaveLinear < 0.9995) {
          const waveRadius = coreRadius * 1.1 + shockwave * maxRadius * 1.08;
          const waveBand = 28 + (1 - shockwave) * 74;
          const waveOuter = Math.max(1, waveRadius + waveBand);
          const innerStop = clamp((waveRadius - waveBand) / waveOuter, 0, 0.96);
          const brightInnerStop = clamp((waveRadius - waveBand * 0.2) / waveOuter, innerStop, 0.985);
          const brightOuterStop = clamp((waveRadius + waveBand * 0.18) / waveOuter, brightInnerStop, 0.995);
          const waveGradient = context.createRadialGradient(originX, originY, 0, originX, originY, waveOuter);
          waveGradient.addColorStop(0, "rgba(3,2,12,0)");
          waveGradient.addColorStop(innerStop, "rgba(7,4,18,0)");
          waveGradient.addColorStop(brightInnerStop, "rgba(255,92,143,0.12)");
          waveGradient.addColorStop(brightOuterStop, "rgba(255,248,251,0.32)");
          waveGradient.addColorStop(1, "rgba(144,181,255,0)");
          context.save();
          context.globalCompositeOperation = "lighter";
          context.globalAlpha = Math.pow(Math.sin(shockwaveLinear * Math.PI), 0.82) * 0.92;
          context.fillStyle = waveGradient;
          context.fillRect(0, 0, width, height);
          context.lineCap = "round";
          for (let ring = 0; ring < 2; ring += 1) {
            const delayed = clamp((shockwaveLinear - ring * 0.09) / (1 - ring * 0.09), 0, 1);
            if (delayed <= 0.001) continue;
            const ringEase = 1 - Math.pow(1 - delayed, 3.4);
            const ringRadius = coreRadius * 1.2 + ringEase * maxRadius * (1.02 + ring * 0.08);
            const ringFade = Math.pow(Math.sin(delayed * Math.PI), 0.9);
            context.globalAlpha = ringFade * (0.34 - ring * 0.1);
            context.strokeStyle = ring === 0 ? "rgba(255,245,249,0.96)" : "rgba(174,203,255,0.82)";
            context.lineWidth = 1 + (1 - delayed) * (6.4 - ring * 1.8);
            context.shadowColor = ring === 0 ? "rgba(255,73,130,0.86)" : "rgba(137,179,255,0.72)";
            context.shadowBlur = (8 + (1 - delayed) * 22) * shadowQuality;
            context.beginPath();
            context.ellipse(
              originX,
              originY,
              ringRadius,
              ringRadius * (0.72 + ring * 0.06),
              blackHoleAngle,
              0,
              Math.PI * 2
            );
            context.stroke();
          }
          context.restore();
        }

        if (!reducedMotion) {
          const waveThresholds = [0.06, 0.34, 0.66];
          for (let waveIndex = 0; waveIndex < waveThresholds.length; waveIndex += 1) {
            const waveBit = 1 << waveIndex;
            if (detonationLinear >= waveThresholds[waveIndex] && (burstWaveMask & waveBit) === 0) {
              burstWaveMask |= waveBit;
              spawnBurstWave(waveIndex);
            }
          }
        }

        if (detonationLinear > 0.001 && detonationLinear < 0.9995) {
          const inversionFlash = Math.exp(-Math.pow((detonationLinear - 0.12) / 0.075, 2));
          const ruptureFlash = Math.exp(-Math.pow((detonationLinear - 0.38) / 0.16, 2)) * 0.72;
          const flashStrength = clamp(inversionFlash + ruptureFlash, 0, 1.24);
          const jetRise = phaseProgress(detonationLinear, 0.03, 0.28);
          const jetFall = 1 - phaseProgress(detonationLinear, 0.72, 1);
          const jetStrength = jetRise * jetFall;
          const shockEase = 1 - Math.pow(1 - detonationLinear, 3.2);

          if (flashStrength > 0.002) {
            const flash = context.createRadialGradient(originX, originY, 0, originX, originY, maxRadius * 0.88);
            flash.addColorStop(0, "rgba(255, 255, 255, 0.96)");
            flash.addColorStop(0.07, "rgba(255, 240, 247, 0.82)");
            flash.addColorStop(0.24, "rgba(255, 91, 139, 0.34)");
            flash.addColorStop(0.54, "rgba(160, 101, 255, 0.09)");
            flash.addColorStop(1, "rgba(255, 72, 112, 0)");
            context.globalAlpha = flashStrength * 0.92;
            context.fillStyle = flash;
            context.fillRect(0, 0, width, height);
          }

          if (jetStrength > 0.001) {
            context.save();
            context.translate(originX, originY);
            context.rotate(blackHoleAngle + Math.PI / 2);
            const jetLength = maxRadius * (0.24 + jetStrength * 0.72);
            const jetWidth = coreRadius * (0.1 + jetStrength * 0.62);
            const traceJet = (direction, widthScale = 1, lengthScale = 1, bendScale = 1) => {
              const activeLength = jetLength * lengthScale;
              const activeWidth = jetWidth * widthScale;
              const jetBend = Math.sin(time * (8.2 + jetStrength * 8.6) + direction * 0.9)
                * activeWidth * 0.62 * bendScale;
              context.beginPath();
              context.moveTo(direction * coreRadius * 0.36, -activeWidth * 0.2);
              context.bezierCurveTo(
                direction * activeLength * 0.18,
                -activeWidth + jetBend * 0.1,
                direction * activeLength * 0.7,
                -activeWidth * 0.28 + jetBend * 0.72,
                direction * activeLength,
                jetBend
              );
              context.bezierCurveTo(
                direction * activeLength * 0.7,
                activeWidth * 0.28 + jetBend * 0.72,
                direction * activeLength * 0.18,
                activeWidth + jetBend * 0.1,
                direction * coreRadius * 0.36,
                activeWidth * 0.2
              );
              context.closePath();
            };

            for (const direction of [-1, 1]) {
              const jetGradient = context.createLinearGradient(0, 0, direction * jetLength, 0);
              jetGradient.addColorStop(0, "rgba(255,255,255,0.98)");
              jetGradient.addColorStop(0.08, "rgba(255,216,231,0.92)");
              jetGradient.addColorStop(0.36, "rgba(255,76,130,0.56)");
              jetGradient.addColorStop(0.72, "rgba(153,126,255,0.16)");
              jetGradient.addColorStop(1, "rgba(126,157,255,0)");
              traceJet(direction);
              context.globalAlpha = jetStrength * 0.2;
              context.fillStyle = jetGradient;
              context.shadowColor = "rgba(255, 71, 130, 0.94)";
              context.shadowBlur = (34 + jetStrength * 46) * shadowQuality;
              context.fill();
              traceJet(direction);
              context.globalAlpha = jetStrength * 0.62;
              context.shadowBlur = (8 + jetStrength * 14) * shadowQuality;
              context.fill();
              traceJet(direction, 0.3, 0.94, 0.58);
              context.globalAlpha = jetStrength * 0.86;
              context.fillStyle = "rgba(255, 244, 249, 0.88)";
              context.shadowColor = "rgba(255, 188, 213, 0.98)";
              context.shadowBlur = (7 + jetStrength * 12) * shadowQuality;
              context.fill();
            }
            context.restore();
          }

          for (let ring = 0; ring < 3; ring += 1) {
            const delayed = clamp((detonationLinear - ring * 0.14) / (1 - ring * 0.14), 0, 1);
            if (delayed <= 0) continue;
            const ringEase = 1 - Math.pow(1 - delayed, 3);
            const ringRadius = ringEase * maxRadius * (0.62 + ring * 0.12);
            const ringAlpha = Math.pow(Math.sin(delayed * Math.PI), 1.42) * (0.3 - ring * 0.054);
            context.globalAlpha = ringAlpha;
            context.strokeStyle = ring % 2 === 0 ? "#ffd2dc" : "#c9dcff";
            context.lineWidth = 0.8 + (1 - delayed) * (5.2 - ring * 0.68);
            context.shadowColor = ring % 2 === 0 ? "rgba(255,92,139,0.84)" : "rgba(157,192,255,0.7)";
            context.shadowBlur = (6 + (1 - delayed) * 14) * shadowQuality;
            context.beginPath();
            context.ellipse(originX, originY, ringRadius, ringRadius * (0.54 + ring * 0.045), blackHoleAngle, 0, Math.PI * 2);
            context.stroke();
          }

          const rushStrength = Math.pow(Math.sin(clamp(detonationLinear / 0.84, 0, 1) * Math.PI), 1.15);
          if (rushStrength > 0.001) {
            const rushCount = Math.floor((12 + rushStrength * 22) * renderQuality);
            for (let index = 0; index < rushCount; index += 1) {
              const seed = randomSeed(index + 9301);
              const angle = seed * Math.PI * 2 + blackHoleAngle + detonationLinear * (0.8 + seed * 1.4);
              const startRadius = coreRadius * (1.1 + seed * 1.7);
              const streakLength = 34 + rushStrength * (110 + seed * 240);
              const startX = originX + Math.cos(angle) * startRadius;
              const startY = originY + Math.sin(angle) * startRadius * 0.66;
              const curveAngle = angle + (seed > 0.5 ? 0.28 : -0.28);
              const endX = originX + Math.cos(curveAngle) * (startRadius + streakLength);
              const endY = originY + Math.sin(curveAngle) * (startRadius + streakLength) * 0.72;
              const streakGradient = context.createLinearGradient(startX, startY, endX, endY);
              streakGradient.addColorStop(0, index % 4 === 0 ? "rgba(255,255,255,0.86)" : "rgba(255,122,157,0.66)");
              streakGradient.addColorStop(0.42, index % 3 === 0 ? "rgba(255,95,143,0.38)" : "rgba(173,194,255,0.26)");
              streakGradient.addColorStop(1, "rgba(140,178,255,0)");
              context.globalAlpha = rushStrength * (0.04 + seed * 0.18);
              context.strokeStyle = streakGradient;
              context.lineWidth = 0.55 + seed * 1.7;
              context.shadowColor = index % 3 === 0 ? "rgba(255,79,130,0.8)" : "rgba(154,188,255,0.62)";
              context.shadowBlur = (3 + rushStrength * 8) * shadowQuality;
              context.beginPath();
              context.moveTo(startX, startY);
              context.quadraticCurveTo(
                originX + Math.cos(angle + (seed - 0.5) * 0.9) * (startRadius + streakLength * 0.48),
                originY + Math.sin(angle + (seed - 0.5) * 0.9) * (startRadius + streakLength * 0.48) * 0.66,
                endX,
                endY
              );
              context.stroke();
            }
          }

          for (let arcIndex = 0; arcIndex < 8; arcIndex += 1) {
            const seed = randomSeed(arcIndex + 10101);
            const delayed = clamp((detonationLinear - seed * 0.28) / (1 - seed * 0.28), 0, 1);
            if (delayed <= 0) continue;
            const radius = (1 - Math.pow(1 - delayed, 2.7)) * maxRadius * (0.18 + seed * 0.42);
            const startAngle = seed * Math.PI * 2 + detonationLinear * (0.8 + seed * 1.3) + blackHoleAngle;
            const span = 0.22 + seed * 0.9;
            context.globalAlpha = Math.pow(Math.sin(delayed * Math.PI), 1.32) * (0.055 + seed * 0.14);
            context.strokeStyle = arcIndex % 3 === 0 ? "#ffffff" : arcIndex % 2 === 0 ? "#ff9db3" : "#bfd6ff";
            context.lineWidth = 0.65 + (1 - delayed) * (2.2 + seed * 2.8);
            context.shadowColor = context.strokeStyle;
            context.shadowBlur = (4 + (1 - delayed) * 8) * shadowQuality;
            context.beginPath();
            context.ellipse(
              originX,
              originY,
              radius,
              radius * 0.62,
              blackHoleAngle,
              startAngle,
              startAngle + span
            );
            context.stroke();
          }

          const blastCoreRadius = coreRadius * 0.72 + shockEase * Math.min(width, height) * 0.24;
          const blastCore = context.createRadialGradient(originX, originY, 0, originX, originY, blastCoreRadius);
          blastCore.addColorStop(0, "rgba(255,255,255,0.96)");
          blastCore.addColorStop(0.12, "rgba(255,226,237,0.84)");
          blastCore.addColorStop(0.34, "rgba(255,80,134,0.42)");
          blastCore.addColorStop(0.66, "rgba(164,111,255,0.12)");
          blastCore.addColorStop(1, "rgba(255,74,116,0)");
          context.globalAlpha = Math.pow(1 - detonationLinear, 0.72) * 0.82 + afterglow * 0.24;
          context.fillStyle = blastCore;
          context.fillRect(
            originX - blastCoreRadius,
            originY - blastCoreRadius,
            blastCoreRadius * 2,
            blastCoreRadius * 2
          );
        }

        context.shadowBlur = 0;
        context.shadowColor = "transparent";
        for (let index = burstParticles.length - 1; index >= 0; index -= 1) {
          const particle = burstParticles[index];
          particle.age += frameSeconds;
          if (particle.age >= particle.life) {
            burstParticles[index] = burstParticles[burstParticles.length - 1];
            burstParticles.pop();
            continue;
          }
          particle.previousX = particle.x;
          particle.previousY = particle.y;
          const lifeRatio = particle.age / particle.life;
          const drag = Math.exp(-frameSeconds * particle.drag);
          particle.velocityX *= drag;
          particle.velocityY *= drag;
          particle.velocityX += Math.sin(particle.phase + particle.age * 1.5) * frameSeconds * 1.6;
          particle.velocityY += particle.gravity * frameSeconds * (0.16 + lifeRatio * 0.84);
          particle.x += particle.velocityX * frameSeconds;
          particle.y += particle.velocityY * frameSeconds;

          if (
            particle.x < -180
            || particle.x > width + 180
            || particle.y < -180
            || particle.y > height + 220
          ) {
            burstParticles[index] = burstParticles[burstParticles.length - 1];
            burstParticles.pop();
            continue;
          }

          const fadeIn = smoothstep(clamp(particle.age / 0.055, 0, 1));
          const fadeOut = 1 - smoothstep(clamp((lifeRatio - 0.46) / 0.54, 0, 1));
          const alpha = fadeIn * fadeOut * (0.28 + particle.size * 0.18);
          context.globalAlpha = alpha;
          context.strokeStyle = particle.tint === 0
            ? "#ffffff"
            : particle.tint < 4
              ? "#ff91aa"
              : "#c5d9ff";
          context.fillStyle = context.strokeStyle;
          context.lineCap = "round";
          const trailTime = 0.026 + (1 - lifeRatio) * 0.058;
          const trailX = particle.x - particle.velocityX * trailTime;
          const trailY = particle.y - particle.velocityY * trailTime;
          if (particle.shape > 0.82) {
            const angle = Math.atan2(particle.velocityY, particle.velocityX);
            const shardLength = 4 + particle.size * (3.2 + (1 - lifeRatio) * 4.6);
            const shardWidth = 0.7 + particle.size * 0.72;
            context.globalAlpha = alpha * 0.78;
            context.beginPath();
            context.moveTo(particle.x, particle.y);
            context.lineTo(
              particle.x - Math.cos(angle) * shardLength + Math.cos(angle + Math.PI / 2) * shardWidth,
              particle.y - Math.sin(angle) * shardLength + Math.sin(angle + Math.PI / 2) * shardWidth
            );
            context.lineTo(
              trailX - Math.cos(angle + Math.PI / 2) * shardWidth * 0.45,
              trailY - Math.sin(angle + Math.PI / 2) * shardWidth * 0.45
            );
            context.closePath();
            context.fill();
          } else {
            context.lineWidth = particle.size;
            context.beginPath();
            context.moveTo(particle.x, particle.y);
            context.lineTo(trailX, trailY);
            context.stroke();
          }
          if (particle.spark && lifeRatio > 0.1 && lifeRatio < 0.72) {
            context.globalAlpha = alpha * 0.44;
            const sparkSize = Math.max(0.7, particle.size * 0.52);
            context.fillRect(particle.x - sparkSize * 0.5, particle.y - sparkSize * 0.5, sparkSize, sparkSize);
          }
        }

        const rainLimit = Math.floor((width < 640 ? 88 : 152) * renderQuality);
        const rainDrive = rainBuild * (1 - rainStop);
        if (!reducedMotion && rainDrive > 0.001) {
          rainEmissionBudget += frameSeconds * (10 + rainDrive * 76) * densityScale;
          while (rainEmissionBudget >= 1 && rainParticles.length < rainLimit) {
            rainEmissionBudget -= 1;
            const angle = nextParticleRandom() * Math.PI * 2;
            const radius = nextParticleRandom() * Math.min(width, height) * (0.08 + rainBuild * 0.24);
            const outwardSpeed = 20 + nextParticleRandom() * (54 + rainBuild * 68);
            rainParticles.push({
