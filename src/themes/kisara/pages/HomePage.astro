          if (openingBridgeRecoveryFrame) window.cancelAnimationFrame(openingBridgeRecoveryFrame);
          openingBridgeRecoveryFrame = 0;
          if (energyFrame) window.cancelAnimationFrame(energyFrame);
          if (energyTimer) window.clearTimeout(energyTimer);
          energyFrame = 0;
          energyTimer = 0;
          energyLoopActive = false;
          pauseSceneBreathClock();
          screenParticleTimestamp = 0;
          lastEnergyPaintTimestamp = 0;
          energyFlowTimestamp = 0;
          beamHeadTimestamp = 0;
          lastSpaceLensPaintTimestamp = 0;
          lastTitleLensPaintTimestamp = 0;
          titleAbyssLastPaintTimestamp = 0;
          stopPostReleaseAnimation();
          resetOrientationCalibration();
          spaceLensRenderer?.clear();
          titleLensRenderer?.clear();
          gate.style.setProperty("--kisara-title-source-opacity", "1");
          return;
        }
        if (foundSelfActive || lovebrainActive) return;
        refreshOpeningMemoryPresentation();
        refreshFridgeScenePresentation();
        if (pageMode === "next") openingBridgeRecoveryPending = true;
        const keptLiveBridge = openingBridgeResumeLive && restoreLiveOpeningBridge();
        openingBridgeResumeLive = false;
        startEnergyAnimation();
        startPostReleaseAnimation();
        scheduleReleaseWarmup(true);
        if (keptLiveBridge || openingBridgeRecoveryPending) scheduleOpeningBridgeRecovery();
      }, { signal });

      const cleanup = () => {
        if (disposed) return;
        disposed = true;
        lovebrainActive = false;
        lovebrainExitCommitted = false;
        gate.classList.remove(
          "is-lovebrain-active",
          "is-lovebrain-transporting",
          "is-lovebrain-transported",
          "is-lovebrain-returning"
        );
