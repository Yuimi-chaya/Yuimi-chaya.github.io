        titleAbyssFluidLastPaintTimestamp = 0;
        titleAbyssFluidLastPalette = -1;
        titleLiquidLastPaintTimestamp = 0;
        titleLiquidLastPosition = Number.NaN;
        titleLiquidLastPhase = Number.NaN;
        titleLiquidLastPressure = Number.NaN;
        titleLiquidLastOpacity = Number.NaN;
        gate.classList.remove("is-title-abyss-ready");
        if (!resetPointer) return;
        titleAbyssPointerX = 0;
        titleAbyssPointerY = 0;
        titleAbyssPointerTargetX = 0;
        titleAbyssPointerTargetY = 0;
      };

      const drawTitleAbyss = (timestamp, force = false) => {
        if (
          !titleAbyssCanvas
          || !titleAbyssContext
          || !titleDataMaskContext
          || pageMode !== "gate"
          || document.visibilityState !== "visible"
        ) return;
        if (titleDataCanvasWidth <= 1 || titleDataCanvasHeight <= 1) {
          resizeTitleDataCanvas();
        }
        if (titleDataCanvasWidth <= 1 || titleDataCanvasHeight <= 1) return;
        if (
          !titleAbyssRimContext
          || !titleAbyssFluidContext
          || !titleAbyssFluidImageData
          || !titleAbyssTideContext
          || !titleAbyssTideImageData
        ) {
          gate.classList.remove("is-title-abyss-ready");
