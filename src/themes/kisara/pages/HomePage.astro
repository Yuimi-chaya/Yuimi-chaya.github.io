---
import KisaraLayout from "../layouts/KisaraLayout.astro";
import { Icon } from "astro-icon/components";
import { getPublishedPosts } from "@/core/content/blog";
import { currentSignals, profileIdentity } from "@/core/data/profile";
import { projectEntries } from "@/core/data/projects";
import { getThemePath } from "@/core/themes/registry";
import { categoryLabel } from "@/lib/site";
import { existsSync } from "node:fs";
import { resolve } from "node:path";

const posts = (await getPublishedPosts()).slice(0, 3);
const featuredProjects = projectEntries.slice(0, 3);
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
});

const backgroundExtensions = ["webp", "png", "jpg", "jpeg"];
const findThemeAsset = (baseName: string) => {
  const extension = backgroundExtensions.find((candidate) =>
    existsSync(resolve(`public/themes/kisara/assets/${baseName}.${candidate}`))
  );
  return extension ? `/themes/kisara/assets/${baseName}.${extension}` : null;
};
const activeBackgroundUrl = findThemeAsset("gate-background");
const activeFightUrl = findThemeAsset("fight");
const channelLinks = [
  { index: "01", label: "READ THE LOG", note: "开发与部署记录", href: getThemePath("kisara", "/blog/"), icon: "tabler:book-2" },
  { index: "02", label: "OPEN THE LAB", note: "项目与互动实验", href: getThemePath("kisara", "/projects/"), icon: "tabler:flask-2" },
  { index: "03", label: "ENTER PLAY", note: "短暂切进小游戏", href: getThemePath("kisara", "/games/"), icon: "tabler:device-gamepad-2" },
  { index: "04", label: "TRACE YUIMI", note: "读取契约者资料", href: getThemePath("kisara", "/about/"), icon: "tabler:user-scan" }
] as const;
const gateStyle = [
  "--kisara-fill: 0%",
  "--kisara-burst-progress: 0%",
  `--kisara-gate-background-image: ${activeBackgroundUrl ? `url("${activeBackgroundUrl}")` : "none"}`,
  `--kisara-fight-background-image: ${activeFightUrl ? `url("${activeFightUrl}")` : "none"}`
].join("; ");
---

<KisaraLayout title="Kisara | Yuimi Lab" description="Yuimi Lab 的 Kisara 视觉交互主题。">
  <section class="kisara-gate" data-kisara-gate style={gateStyle}>
    <div class="kisara-gate-visual" aria-hidden="true">
      <div class="kisara-gate-background kisara-gate-background-base"></div>
      <div class="kisara-gate-background kisara-gate-background-fight"></div>
      <canvas
        class="kisara-space-lens-canvas"
        data-kisara-space-lens
        data-base-src={activeBackgroundUrl ?? ""}
        data-fight-src={activeFightUrl ?? ""}
        width="1280"
        height="900"
      ></canvas>
      <div class="kisara-gate-atmosphere"></div>
      <canvas
        class="kisara-post-release-canvas"
        data-kisara-post-release-canvas
        data-fight-src={activeFightUrl ?? ""}
        width="1280"
        height="900"
      ></canvas>
    </div>
    <canvas class="kisara-burst-canvas" data-kisara-burst-canvas width="1280" height="900" aria-hidden="true"></canvas>
    <div class="kisara-screen-impact" aria-hidden="true"></div>
    <h1 class="kisara-title" aria-label="Kisara">
      <span class="kisara-title-base" aria-hidden="true">Kisara</span>
      <span class="kisara-title-tide" aria-hidden="true">Kisara</span>
      <span class="kisara-title-crest" aria-hidden="true">Kisara</span>
      <span class="kisara-title-enchant" aria-hidden="true">Kisara</span>
      <span class="kisara-title-gloss" aria-hidden="true">Kisara</span>
      <canvas
        class="kisara-title-data-canvas"
        data-kisara-title-data
        width="1200"
        height="320"
        aria-hidden="true"
      ></canvas>
      <canvas
        class="kisara-title-lens-canvas"
        data-kisara-title-lens
        width="1200"
        height="260"
        aria-hidden="true"
      ></canvas>
      <i class="kisara-title-cross" aria-hidden="true">
        <span class="kisara-cross-ring"></span>
        <span class="kisara-cross-ray kisara-cross-ray-north"></span>
        <span class="kisara-cross-ray kisara-cross-ray-east"></span>
        <span class="kisara-cross-ray kisara-cross-ray-south"></span>
        <span class="kisara-cross-ray kisara-cross-ray-west"></span>
        <span class="kisara-cross-shard kisara-cross-shard-a"></span>
        <span class="kisara-cross-shard kisara-cross-shard-b"></span>
        <span class="kisara-cross-shard kisara-cross-shard-c"></span>
        <span class="kisara-cross-shard kisara-cross-shard-d"></span>
        <span class="kisara-cross-spark kisara-cross-spark-a"></span>
        <span class="kisara-cross-spark kisara-cross-spark-b"></span>
        <span class="kisara-cross-spark kisara-cross-spark-c"></span>
        <span class="kisara-cross-spark kisara-cross-spark-d"></span>
        <span class="kisara-cross-core"></span>
      </i>
    </h1>
    <div class="kisara-contract-meter" aria-hidden="true">
      <canvas class="kisara-energy-canvas" data-kisara-energy width="640" height="64"></canvas>
    </div>
    <p class="kisara-contract-state" data-kisara-state>CONTRACT 000%</p>
    <p class="kisara-scroll-cue" data-kisara-cue>SCROLL / SIGN THE CONTRACT</p>
    <a class="kisara-gate-skip" href="#kisara-opening" data-kisara-skip>SKIP</a>
  </section>

  <section id="kisara-opening" class="kisara-opening" aria-labelledby="kisara-opening-title">
    <div class="kisara-opening-inner">
      <p class="kisara-section-index">AFTER THE SIGNATURE / 001</p>
      <div class="kisara-opening-heading">
        <h2 id="kisara-opening-title">After the contract.</h2>
        <span>CHANNEL 03 / CONNECTED</span>
      </div>
      <div class="kisara-opening-grid">
        <div class="kisara-opening-copy">
          <p>这里不再继续重复首屏的演出，而是把视觉、交互与技术记录接到同一条契约线上。</p>
          <div class="kisara-contractor-line">
            <span>CONTRACTOR</span>
            <strong>{profileIdentity.displayName} / {profileIdentity.handle}</strong>
            <small>兴趣驱动型折腾人 · 喜欢把技术做得有一点可爱</small>
          </div>
        </div>
        <nav class="kisara-channel-links" aria-label="Kisara theme shortcuts">
          {channelLinks.map((item) => (
            <a href={item.href}>
              <span>{item.index}</span>
              <Icon name={item.icon} aria-hidden="true" />
              <div><strong>{item.label}</strong><small>{item.note}</small></div>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <section class="kisara-signal-deck" aria-labelledby="kisara-signal-title">
    <div class="kisara-content-shell">
      <div class="kisara-section-heading">
        <div>
          <p class="kisara-section-index">LIVE SIGNALS / 002</p>
          <h2 id="kisara-signal-title">Current pulse.</h2>
        </div>
        <p>不用仪表盘汇报人生，只留三条现在确实还在发热的信号。</p>
      </div>
      <div class="kisara-signal-grid">
        {currentSignals.map((signal, index) => (
          <article>
            <span>0{index + 1}</span>
            <small>{signal.label}</small>
            <h3>{signal.text}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="kisara-home-projects" aria-labelledby="kisara-project-title">
    <div class="kisara-content-shell">
      <div class="kisara-section-heading">
        <div>
          <p class="kisara-section-index">ACTIVE LAB / 003</p>
          <h2 id="kisara-project-title">Work in motion.</h2>
        </div>
        <a class="kisara-section-link" href={getThemePath("kisara", "/projects/")}>VIEW ALL WORKS <span>↗</span></a>
      </div>
      <div class="kisara-project-tracks">
        {featuredProjects.map((project, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <small>{project.type} / {project.status}</small>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
            </div>
            <strong>{project.line.toUpperCase()}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="kisara-latest" aria-labelledby="kisara-latest-title">
    <div class="kisara-section-heading">
      <div>
        <p class="kisara-section-index">RECENT TRANSMISSIONS / 004</p>
        <h2 id="kisara-latest-title">Latest notes.</h2>
      </div>
      <a class="kisara-section-link" href={getThemePath("kisara", "/blog/")}>OPEN ARCHIVE <span>↗</span></a>
    </div>
    <div class="kisara-transmission-list">
      {posts.map((post, index) => (
        <a href={getThemePath("kisara", `/blog/${post.id}/`)}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div>
            <small>{categoryLabel[post.data.category]} / <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.updatedDate ?? post.data.pubDate)}</time></small>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      const gate = document.querySelector("[data-kisara-gate]");
      if (!gate || gate.dataset.bound === "true") return;
      gate.dataset.bound = "true";

      const energyCanvas = gate.querySelector("[data-kisara-energy]");
      const energyContext = energyCanvas?.getContext("2d");
      const burstCanvas = gate.querySelector("[data-kisara-burst-canvas]");
      const burstContext = burstCanvas?.getContext("2d");
      const spaceLensCanvas = gate.querySelector("[data-kisara-space-lens]");
      const titleLensCanvas = gate.querySelector("[data-kisara-title-lens]");
      const titleDataCanvas = gate.querySelector("[data-kisara-title-data]");
      const titleDataContext = titleDataCanvas?.getContext("2d", { alpha: true });
      const postReleaseCanvas = gate.querySelector("[data-kisara-post-release-canvas]");
      const postReleaseContext = postReleaseCanvas?.getContext("2d", { alpha: true });
      const fightBackground = gate.querySelector(".kisara-gate-background-fight");
      const meterShell = gate.querySelector(".kisara-contract-meter");
      const title = gate.querySelector(".kisara-title");
      const cross = gate.querySelector(".kisara-title-cross");
      const opening = document.querySelector("#kisara-opening");
      const state = gate.querySelector("[data-kisara-state]");
      const cue = gate.querySelector("[data-kisara-cue]");
      const skip = gate.querySelector("[data-kisara-skip]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const restoredBelowGate = window.scrollY > 2;
      const fillDistance = 2100;
      const burstDistance = 2250;
      const springStrength = 0.06;
      const burstSpringStrength = 0.038;
      const damping = 0.76;
      const burstDamping = 0.86;
      const settleDistance = 0.00035;
      const chargeIntroDuration = 2700;
      const chargeHandoffStart = 0.015;
      const chargeHandoffEnd = 0.18;
      const glossFadeEnd = 0.42;
      const crossStart = 0.46;
      const crossBuildEnd = 0.58;
      const crossFlashEnd = 0.72;
      const crossEnd = 0.82;
      const reformEnd = 0.9;
      const collapseStart = 0.855;
      const collapseEnd = 0.905;
      const shockwaveStart = 0.925;
      const detonationStart = 0.948;
      const detonationEnd = 0.982;
      const rainStart = 0.956;
      const rainPeak = 0.992;
      const releaseAutoplayDuration = 10600;
      const clamp = (value, minimum, maximum) => Math.min(maximum, Math.max(minimum, value));
      const startsComplete = reducedMotion && !restoredBelowGate;
      let progress = startsComplete ? 1 : 0;
      let targetProgress = progress;
      let velocity = 0;
      let burstProgress = startsComplete ? 1 : 0;
      let targetBurstProgress = burstProgress;
      let burstVelocity = 0;
      let burstAutoplay = false;
      let burstAutoplayComplete = startsComplete;
      let burstAutoplayStartedAt = 0;
      let chargeIntroProgress = startsComplete ? 1 : 0;
      let chargeIntroActive = false;
      let chargeIntroComplete = startsComplete;
      let chargeIntroStartedAt = 0;
      let animationFrame = 0;
      let lastFrameTime = 0;
      let touchY = null;
      let touchId = null;
      let renderedPercent = -1;
      let renderedStage = "";
      let renderedGlitchTick = -1;
      let energyFrame = 0;
      let energyTimer = 0;
      let energyLoopActive = false;
      let energyProgress = 0;
      let energyCanvasWidth = 0;
      let energyCanvasHeight = 0;
      let burstCanvasWidth = 0;
      let burstCanvasHeight = 0;
      let postReleaseCanvasWidth = 0;
      let postReleaseCanvasHeight = 0;
      let postReleasePixelRatio = 1;
      let titleDataCanvasWidth = 0;
      let titleDataCanvasHeight = 0;
      let titleDataPixelRatio = 1;
      let titleDataCells = [];
      let meterLayout = { width: 0, height: 0, left: 0, top: 0 };
      let titleLayout = { width: 0, height: 0, left: 0, top: 0 };
      let renderQuality = 1;
      let renderCostEma = 0;
      let lastQualityAdjustment = 0;
      const singularityFieldCanvas = document.createElement("canvas");
      const singularityFieldContext = singularityFieldCanvas.getContext("2d", { alpha: true });
      let singularityFieldImageData = null;
      let singularityFieldLastPaintTimestamp = 0;
      const titleDataMaskCanvas = document.createElement("canvas");
      const titleDataMaskContext = titleDataMaskCanvas.getContext("2d", {
        alpha: true,
        willReadFrequently: true
      });
      let spaceLensRenderer = null;
      let spaceLensInitGeneration = 0;
      let lastSpaceLensPaintTimestamp = 0;
      let titleLensRenderer = null;
      let titleLensInitGeneration = 0;
      let lastTitleLensPaintTimestamp = 0;
      let pageMode = restoredBelowGate ? "next" : "gate";
      let scrollFrame = 0;
      let layoutResizeFrame = 0;
      let resetTransitionTimer = 0;
      let restoreWindowOpen = true;
      let poseTimestamp = 0;
      let poseClock = 0;
      let poseAtRest = true;
      let chargeInstability = 0;
      const makeMotionPhases = () => ({
        floatPrimary: 0,
        floatSecondary: 1.7,
        floatTertiary: 2.4,
        verticalPrimary: 0.6,
        verticalSecondary: 0,
        verticalTertiary: 0.9,
        anglePrimary: 1.2,
        angleSecondary: 0,
        jitterX: 0.7,
        jitterY: 1.5,
        burstX: 0,
        burstY: 0,
        detonationX: 0,
        detonationXSecondary: 0.8,
        detonationY: 1.2,
        detonationYSecondary: 0,
        screenX: 0.3,
        screenXSecondary: 0,
        screenY: 1.1,
        screenYSecondary: 0,
        gravityX: 0.7,
        gravityY: 1.2,
        crossPulse: 0,
        crossPulseMod: 0,
        crossRotation: 0,
        crossShakeX: 0,
        crossShakeY: 0
      });
      let motionPhases = makeMotionPhases();
      const fullTurn = Math.PI * 2;
      const advanceMotionPhase = (key, amount) => {
        motionPhases[key] = (motionPhases[key] + amount) % fullTurn;
      };
      let beamPose = {
        shakeX: 0,
        shakeY: 0,
        anchorX: 0,
        anchorY: 0,
        lift: 0,
        scaleX: 1,
        scaleY: 1,
        angle: 0
      };
      let screenParticleTimestamp = 0;
      let lastEnergyPaintTimestamp = 0;
      let energyFlowTimestamp = 0;
      let energyFlowPhase = 0;
      let beamHeadTimestamp = 0;
      let beamHeadX = 0;
      let beamHeadY = 0;
      let beamHeadVelocityX = 0;
      let beamHeadVelocityY = 0;
      let beamMotionEnergy = 0;
      let particleSerial = 0;
      let wakeEmissionBudget = 0;
      let orbitEmissionBudget = 0;
      let rainEmissionBudget = 0;
      let burstWaveMask = 0;
      let wakePrimed = false;
      const wakeParticles = [];
      const orbitParticles = [];
      const burstParticles = [];
      const rainParticles = [];
      const postReleaseParticles = [];

      const smoothstep = (value) => value * value * (3 - 2 * value);
      const phaseProgress = (value, start, end) => smoothstep(clamp((value - start) / (end - start), 0, 1));
      const releaseAutoplayKeyframes = [
        [0, crossEnd],
        [0.14, collapseStart],
        [0.45, collapseEnd],
        [0.56, shockwaveStart],
        [0.7, detonationStart],
        [0.88, detonationEnd],
        [1, 1]
      ];
      const mapReleaseAutoplayProgress = (value) => {
        const timeline = clamp(value, 0, 1);
        for (let index = 0; index < releaseAutoplayKeyframes.length - 1; index += 1) {
          const [timeStart, progressStart] = releaseAutoplayKeyframes[index];
          const [timeEnd, progressEnd] = releaseAutoplayKeyframes[index + 1];
          if (timeline > timeEnd && index < releaseAutoplayKeyframes.length - 2) continue;
          const local = clamp((timeline - timeStart) / Math.max(0.0001, timeEnd - timeStart), 0, 1);
          const eased = index === 4
            ? 1 - Math.pow(1 - local, 2.45)
            : index === 2
              ? Math.pow(smoothstep(local), 1.35)
              : smoothstep(local);
          return progressStart + (progressEnd - progressStart) * eased;
        }
        return 1;
      };
      const randomSeed = (index) => {
        const value = Math.sin(index * 12.9898 + 78.233) * 43758.5453;
        return value - Math.floor(value);
      };
      const createSmoothCanvasPath = (points) => {
        const path = new Path2D();
        if (points.length === 0) return path;
        path.moveTo(points[0].x, points[0].y);
        for (let index = 1; index < points.length - 1; index += 1) {
          const next = points[index + 1];
          path.quadraticCurveTo(
            points[index].x,
            points[index].y,
            (points[index].x + next.x) * 0.5,
            (points[index].y + next.y) * 0.5
          );
        }
        if (points.length > 1) {
          const last = points[points.length - 1];
          path.lineTo(last.x, last.y);
        }
        return path;
      };
      const createClosedCanvasPath = (points) => {
        const path = new Path2D();
        if (points.length < 3) return path;
        const last = points[points.length - 1];
        const first = points[0];
        path.moveTo((last.x + first.x) * 0.5, (last.y + first.y) * 0.5);
        for (let index = 0; index < points.length; index += 1) {
          const current = points[index];
          const next = points[(index + 1) % points.length];
          path.quadraticCurveTo(
            current.x,
            current.y,
            (current.x + next.x) * 0.5,
            (current.y + next.y) * 0.5
          );
        }
        path.closePath();
        return path;
      };
      const pointOnQuadraticCurve = (start, control, end, progress) => {
        const inverse = 1 - progress;
        return {
          x: inverse * inverse * start.x + 2 * inverse * progress * control.x + progress * progress * end.x,
          y: inverse * inverse * start.y + 2 * inverse * progress * control.y + progress * progress * end.y
        };
      };
      const pointOnCubicCurve = (start, controlA, controlB, end, progress) => {
        const inverse = 1 - progress;
        const inverseSquared = inverse * inverse;
        const progressSquared = progress * progress;
        return {
          x: inverseSquared * inverse * start.x
            + 3 * inverseSquared * progress * controlA.x
            + 3 * inverse * progressSquared * controlB.x
            + progressSquared * progress * end.x,
          y: inverseSquared * inverse * start.y
            + 3 * inverseSquared * progress * controlA.y
            + 3 * inverse * progressSquared * controlB.y
            + progressSquared * progress * end.y
        };
      };
      const tangentOnCubicCurve = (start, controlA, controlB, end, progress) => {
        const inverse = 1 - progress;
        return {
          x: 3 * inverse * inverse * (controlA.x - start.x)
            + 6 * inverse * progress * (controlB.x - controlA.x)
            + 3 * progress * progress * (end.x - controlB.x),
          y: 3 * inverse * inverse * (controlA.y - start.y)
            + 6 * inverse * progress * (controlB.y - controlA.y)
            + 3 * progress * progress * (end.y - controlB.y)
        };
      };
      const getChargeFlightGeometry = (introProgress, width, height) => {
        const flight = phaseProgress(introProgress, 0.16, 0.78);
        const impact = phaseProgress(introProgress, 0.72, 0.88);
        const enchant = phaseProgress(introProgress, 0.75, 1);
        const baseY = meterLayout.top + meterLayout.height * 0.5;
        const initialTail = {
          x: meterLayout.left - 2,
          y: baseY
        };
        const baseHead = {
          x: meterLayout.left + meterLayout.width - clamp(24 + meterLayout.width * 0.038, 32, 48),
          y: baseY
        };
        const target = {
          x: titleLayout.left + titleLayout.width * 0.53,
          y: titleLayout.top + titleLayout.height * 0.57
        };
        const turnPoint = {
          x: clamp(baseHead.x + Math.min(width * 0.145, 176), baseHead.x + 28, width - 24),
          y: clamp(baseY + Math.min(height * 0.17, 138), baseY + 42, height - 64)
        };
        const tailLag = 0.46;
        const pointOnFlightPath = (pathProgress) => {
          if (pathProgress <= 0) {
            const gather = smoothstep(clamp((pathProgress + tailLag) / tailLag, 0, 1));
            return {
              x: initialTail.x + (baseHead.x - initialTail.x) * gather,
              y: initialTail.y + (baseHead.y - initialTail.y) * gather
            };
          }
          if (pathProgress < 0.46) {
            const launch = smoothstep(pathProgress / 0.46);
            return pointOnQuadraticCurve(
              baseHead,
              {
                x: turnPoint.x + Math.min(width * 0.035, 42),
                y: baseY + Math.min(height * 0.045, 38)
              },
              turnPoint,
              launch
            );
          }
          const returnProgress = smoothstep(clamp((pathProgress - 0.46) / 0.54, 0, 1));
          return pointOnCubicCurve(
            turnPoint,
            {
              x: turnPoint.x + Math.min(width * 0.045, 54),
              y: turnPoint.y + Math.min(height * 0.08, 62)
            },
            {
              x: target.x + Math.min(width * 0.2, 230),
              y: turnPoint.y + Math.min(height * 0.035, 30)
            },
            target,
            returnProgress
          );
        };
        const tangentOnFlightPath = (pathProgress) => {
          const sampleDistance = 0.004;
          const before = pointOnFlightPath(Math.max(-tailLag, pathProgress - sampleDistance));
          const after = pointOnFlightPath(Math.min(1, pathProgress + sampleDistance));
          const length = Math.max(0.001, Math.hypot(after.x - before.x, after.y - before.y));
          return {
            x: (after.x - before.x) / length,
            y: (after.y - before.y) / length
          };
        };
        const rawHead = pointOnFlightPath(flight);
        const tailProgress = flight - tailLag;
        const rawTail = pointOnFlightPath(tailProgress);
        const tailTangent = tangentOnFlightPath(tailProgress);
        const headTangent = tangentOnFlightPath(flight);
        const beamLength = Math.hypot(rawHead.x - rawTail.x, rawHead.y - rawTail.y);
        const handleLength = clamp(beamLength * 0.36, 24, meterLayout.width * 0.44);
        const rawControlA = {
          x: rawTail.x + tailTangent.x * handleLength,
          y: rawTail.y + tailTangent.y * handleLength
        };
        const rawControlB = {
          x: rawHead.x - headTangent.x * handleLength,
          y: rawHead.y - headTangent.y * handleLength
        };
        const poseInfluence = 1 - phaseProgress(introProgress, chargeHandoffStart, 0.22);
        const meterCenterX = meterLayout.left + meterLayout.width * 0.5;
        const meterCenterY = baseY;
        const poseAngle = beamPose.angle * poseInfluence * Math.PI / 180;
        const poseScaleX = 1 + (beamPose.scaleX - 1) * poseInfluence;
        const poseScaleY = 1 + (beamPose.scaleY - 1) * poseInfluence;
        const poseTranslateX = (beamPose.anchorX + beamPose.shakeX) * poseInfluence;
        const poseTranslateY = (beamPose.anchorY + beamPose.shakeY + beamPose.lift) * poseInfluence;
        const applyMeterPose = (point) => {
          if (poseInfluence <= 0.0005) return point;
          const localX = (point.x - meterCenterX) * poseScaleX;
          const localY = (point.y - meterCenterY) * poseScaleY;
          return {
            x: meterCenterX + localX * Math.cos(poseAngle) - localY * Math.sin(poseAngle) + poseTranslateX,
            y: meterCenterY + localX * Math.sin(poseAngle) + localY * Math.cos(poseAngle) + poseTranslateY
          };
        };
        const tail = applyMeterPose(rawTail);
        const head = applyMeterPose(rawHead);
        const controlA = applyMeterPose(rawControlA);
        const controlB = applyMeterPose(rawControlB);
        return {
          flight,
          impact,
          enchant,
          tail,
          head,
          target,
          controlA,
          controlB
