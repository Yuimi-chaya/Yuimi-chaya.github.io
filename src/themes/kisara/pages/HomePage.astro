          -parallaxY * 0.08
        );
        baseGradient.addColorStop(0, "#111d47");
        baseGradient.addColorStop(0.36, "#080d29");
        baseGradient.addColorStop(0.68, "#160a32");
        baseGradient.addColorStop(1, "#070c24");
        context.fillStyle = baseGradient;
