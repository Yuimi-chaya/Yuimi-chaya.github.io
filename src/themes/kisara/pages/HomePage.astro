        window.clearTimeout(foundSelfReadyTimer);
        window.clearTimeout(foundSelfSequenceTimer);
        window.clearTimeout(foundSelfExitTimer);
        foundSelfReadyTimer = 0;
        foundSelfSequenceTimer = 0;
        foundSelfExitTimer = 0;
        setFoundSelfMusicSuspended(false);
        foundSelfActive = false;
        foundSelfState = "inactive";
        delete document.documentElement.dataset.kisaraFoundSelfEntry;
        window.dispatchEvent(new CustomEvent("yuimi:kisara-found-self-state", {
          detail: { active: false, state: foundSelfState }
