        renderedStage = "";
        renderedGlitchTick = -1;
        renderedRailProgress = -1;
        renderedRailStage = "";
        renderedRailActive = null;
        renderedRailGuided = null;
        renderedRailTransitioning = null;
        renderedRailPlaybackRate = -1;
        renderedRailPressure = -1;
        renderedRailReleaseMode = "";
        energyContext?.clearRect(0, 0, energyCanvasWidth, energyCanvasHeight);
        clearTitleChains();
        burstContext?.clearRect(0, 0, burstCanvasWidth, burstCanvasHeight);
        singularityFieldContext?.clearRect(
          0,
          0,
          singularityFieldCanvas.width,
          singularityFieldCanvas.height
        );
        singularityFieldLastPaintTimestamp = 0;
        spaceLensRenderer?.clear();
        titleLensRenderer?.clear();
        gate.style.setProperty("--kisara-title-source-opacity", "1");
        lastSpaceLensPaintTimestamp = 0;
        lastTitleLensPaintTimestamp = 0;
        render();
      };

      const finalizeGateResetForNextPage = () => {
        if (!gateVisualResetPending) return;
        gateVisualResetPending = false;
        deactivateOpeningBridgePortal();
        releaseOpeningEdgeState();
        resetGateState();
        lockOpeningEdgeState();
      };

      const enterNextPage = () => {
        if (scrollFrame) return;
        pageMode = "snap";
        setPostReleaseActive(false);
        releaseOpeningEdgeState();
        syncOpeningEdgeLiveGeometry(true);
        primeCurrentOpeningEdgeTextures();
        activateOpeningBridgePortal();
        smoothScrollTo(getNextPageTop(), () => {
          pageMode = "next";
          render();
          syncOpeningEdgeLiveGeometry(true);
          lockOpeningEdgeState();
          gateVisualResetPending = true;
        }, () => {
          syncOpeningEdgeLiveGeometry(true);
        });
      };

      const returnToGate = () => {
        if (scrollFrame) return;
        pageMode = "snap";
        const returnRailStart = getDocumentScrollProgress();
        gateVisualResetPending = false;
        activateOpeningBridgePortal();
        publishGateRailState({
          active: true,
          progress: returnRailStart,
          stage: "returning",
          guided: false,
          transitioning: true
        });
        smoothScrollTo(0, () => {
          deactivateOpeningBridgePortal();
          releaseOpeningEdgeState();
          pageMode = "gate";
          resetGateState();
          lockOpeningEdgeState();
          scheduleWarningWarmup(true);
        }, (journeyProgress) => {
          publishGateRailState({
            active: true,
            progress: returnRailStart * (1 - journeyProgress),
            stage: "returning",
            guided: false,
            transitioning: true
          });
        });
      };

      const addProgress = (delta) => {
        if (["forward", "rewinding", "complete"].includes(releaseMode)) return;
        const boundedDelta = clamp(delta, -180, 180);
        const fillComplete = targetProgress >= 0.9995 && progress >= 0.995;
        const burstInProgress = targetBurstProgress > 0.0005 || burstProgress > 0.0005;
        const timestamp = performance.now();
        if (chargeIntroActive) {
          if (delta < 0) {
            targetProgress = clamp(
              targetProgress + boundedDelta / fillDistance * 0.22,
              0,
              0.988
            );
            velocity += boundedDelta / fillDistance * 0.012;
            transitionChargeIntro(0, timestamp);
          } else if (chargeIntroReversing) {
            targetProgress = 1;
            transitionChargeIntro(1, timestamp);
          }
          startAnimation();
          return;
        }
        if (delta < 0 && chargeIntroComplete && !burstInProgress) {
          targetProgress = Math.min(targetProgress, 0.988);
          velocity += boundedDelta / fillDistance * 0.012;
          transitionChargeIntro(0, timestamp);
          startAnimation();
          return;
        }
        if (delta > 0 && fillComplete && !chargeIntroComplete) {
          startChargeIntro(timestamp);
          startAnimation();
          return;
        }
        if ((delta > 0 && fillComplete) || (delta < 0 && burstInProgress)) {
          targetBurstProgress = clamp(targetBurstProgress + boundedDelta / burstDistance, 0, crossEnd);
          burstVelocity += boundedDelta / burstDistance * 0.045;
        } else {
          targetProgress = clamp(targetProgress + boundedDelta / fillDistance, 0, 1);
          velocity += boundedDelta / fillDistance * 0.03;
          if (delta > 0 && targetProgress >= 0.9995 && !chargeIntroComplete) {
            startChargeIntro(timestamp);
          }
        }
        startAnimation();
      };

      const isFillComplete = () => targetProgress >= 0.9995
        && progress >= 0.999
        && Math.abs(velocity) < 0.001;

      const isComplete = () => isFillComplete()
        && targetBurstProgress >= 0.9995
        && burstProgress >= 0.999
        && Math.abs(burstVelocity) < 0.001
        && releaseMode === "complete";

      const shouldCaptureGate = (delta) => {
        if (window.scrollY > 2 || delta === 0) return false;
        if (chargeIntroActive || ["forward", "rewinding", "paused"].includes(releaseMode)) return true;
        if (delta > 0 && isFillComplete() && !chargeIntroComplete) return true;
        if (delta > 0) return !isComplete();
        return targetBurstProgress > 0.0005
          || burstProgress > 0.0005
          || Math.abs(burstVelocity) > 0.0005
          || targetProgress > 0.0005
          || progress > 0.0005
          || Math.abs(velocity) > 0.0005;
      };

      const normalizeWheel = (event) => {
        if (event.deltaMode === WheelEvent.DOM_DELTA_LINE) return event.deltaY * 16;
        if (event.deltaMode === WheelEvent.DOM_DELTA_PAGE) return event.deltaY * window.innerHeight;
        return event.deltaY;
      };

      const handleDirectionalInput = (delta, event) => {
        if (delta === 0) return;
        if (scrollFrame) {
          event.preventDefault();
          return;
        }
        if (pageMode === "gate") {
          if (window.scrollY > 2) return;
          if (delta > 0 && isComplete()) {
            event.preventDefault();
            enterNextPage();
            return;
          }
          if (["forward", "rewinding", "paused"].includes(releaseMode)) {
            const releaseInputHandled = handleReleaseInput(delta, performance.now());
            if (releaseInputHandled) {
              event.preventDefault();
              return;
            }
          }
          if (!shouldCaptureGate(delta)) return;
          event.preventDefault();
          addProgress(delta);
          return;
        }
        if (
          pageMode === "next"
          && delta < 0
          && window.scrollY + delta <= getReturnToGateThreshold()
        ) {
          event.preventDefault();
          returnToGate();
        }
      };

      window.addEventListener("wheel", (event) => {
        if (event.ctrlKey || event.metaKey) return;
        const delta = normalizeWheel(event);
        handleDirectionalInput(delta, event);
      }, { passive: false, signal });

      window.addEventListener("keydown", (event) => {
        if (event.ctrlKey || event.metaKey || event.altKey) return;
        if (event.target instanceof Element && event.target.closest("a, button, input, select, textarea, [contenteditable='true']")) return;
        let amount = 0;
        if (event.key === "ArrowDown") amount = 130;
        if (event.key === "ArrowUp") amount = -130;
        if (["PageDown", "End"].includes(event.key)) amount = 300;
        if (["PageUp", "Home"].includes(event.key)) amount = -300;
        if (event.key === " ") amount = event.shiftKey ? -300 : 300;
        if (!amount) return;
        handleDirectionalInput(amount, event);
      }, { signal });

      window.addEventListener("touchstart", (event) => {
        if (event.touches.length !== 1) {
          touchY = null;
          touchId = null;
          return;
        }
        touchId = event.touches[0]?.identifier ?? null;
        touchY = event.touches[0]?.clientY ?? null;
      }, { passive: true, signal });

      window.addEventListener("touchmove", (event) => {
        if (event.touches.length !== 1 || touchId === null) return;
        const touch = Array.from(event.touches).find((item) => item.identifier === touchId);
        const nextY = touch?.clientY ?? null;
        if (touchY === null || nextY === null) return;
        const delta = touchY - nextY;
        touchY = nextY;
        const touchDelta = delta * 2.25;
        handleDirectionalInput(touchDelta, event);
      }, { passive: false, signal });

      window.addEventListener("touchend", () => {
        touchY = null;
        touchId = null;
      }, { passive: true, signal });

      window.addEventListener("touchcancel", () => {
        touchY = null;
        touchId = null;
      }, { passive: true, signal });

      window.addEventListener("pointermove", handlePostReleasePointer, { passive: true, signal });
      document.addEventListener("pointerleave", () => {
        postReleasePointerX = null;
        postReleasePointerAccumulator = 0;
        postReleaseTargetX = 0;
        postReleaseTargetY = 0;
      }, { passive: true, signal });

      skip?.addEventListener("click", (event) => {
        event.preventDefault();
        if (animationFrame) window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
        lastFrameTime = 0;
        velocity = 0;
        burstVelocity = 0;
        releaseMode = "manual";
        releaseTimeline = 0;
        releaseLastTimestamp = 0;
        releasePlaybackRate = 1;
        releaseBoost = 0;
        releaseVisualPressure = 0;
        releaseRewindVeil = 0;
        chargeIntroActive = false;
        chargeIntroStartedAt = 0;
        enterNextPage();
      }, { signal });

      const refreshLayoutSize = () => {
        lastEnergyPaintTimestamp = 0;
        lastSpaceLensPaintTimestamp = 0;
        lastTitleLensPaintTimestamp = 0;
        resizeEnergyCanvas(true);
        resizeBurstCanvas(true);
        resizePostReleaseCanvas(true);
        resizeTitleChains(true);
        resizeTitleDataCanvas(true);
        spaceLensRenderer?.resize();
        titleLensRenderer?.resize();
        startEnergyAnimation();
        startPostReleaseAnimation();
      };
      const scheduleLayoutSizeRefresh = () => {
        if (layoutResizeFrame) return;
        layoutResizeFrame = window.requestAnimationFrame(() => {
          layoutResizeFrame = 0;
          if (disposed) return;
          refreshLayoutSize();
        });
      };
      window.addEventListener("resize", scheduleLayoutSizeRefresh, { passive: true, signal });
      const layoutResizeObserver = typeof ResizeObserver === "function"
        ? new ResizeObserver(scheduleLayoutSizeRefresh)
        : null;
      if (layoutResizeObserver) {
        for (const target of [
          gate,
          meterShell,
          title,
          chainBackCanvas,
          chainFrontCanvas,
          energyCanvas,
          burstCanvas,
          postReleaseCanvas
        ]) {
          if (target) layoutResizeObserver.observe(target);
        }
      }
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") {
          if (energyFrame) window.cancelAnimationFrame(energyFrame);
          if (energyTimer) window.clearTimeout(energyTimer);
          energyFrame = 0;
          energyTimer = 0;
          energyLoopActive = false;
          screenParticleTimestamp = 0;
          lastEnergyPaintTimestamp = 0;
          energyFlowTimestamp = 0;
          beamHeadTimestamp = 0;
          lastSpaceLensPaintTimestamp = 0;
          lastTitleLensPaintTimestamp = 0;
          stopPostReleaseAnimation();
          resetOrientationCalibration();
          spaceLensRenderer?.clear();
          titleLensRenderer?.clear();
          gate.style.setProperty("--kisara-title-source-opacity", "1");
          return;
        }
        startEnergyAnimation();
        startPostReleaseAnimation();
        scheduleWarningWarmup(true);
      }, { signal });

      const cleanup = () => {
        if (disposed) return;
        disposed = true;
        gate.removeAttribute("data-bound");
        gate.removeAttribute("data-binding");
        deactivateOpeningBridgePortal();
        lifecycle.abort();
        spaceLensInitGeneration += 1;
        titleLensInitGeneration += 1;
        if (openingEdgeResizeFrame) window.cancelAnimationFrame(openingEdgeResizeFrame);
        if (openingEdgeRenderHandle) {
          if (openingEdgeRenderUsesIdleCallback && "cancelIdleCallback" in window) {
            window.cancelIdleCallback(openingEdgeRenderHandle);
          } else {
            window.clearTimeout(openingEdgeRenderHandle);
          }
        }
        if (animationFrame) window.cancelAnimationFrame(animationFrame);
        if (energyFrame) window.cancelAnimationFrame(energyFrame);
        if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
        if (layoutResizeFrame) window.cancelAnimationFrame(layoutResizeFrame);
        if (energyTimer) window.clearTimeout(energyTimer);
        if (restoreSyncTimer) window.clearTimeout(restoreSyncTimer);
        if (warningWarmupHandle) {
          if (warningWarmupUsesIdleCallback && "cancelIdleCallback" in window) {
            window.cancelIdleCallback(warningWarmupHandle);
          } else {
            window.clearTimeout(warningWarmupHandle);
          }
        }
        if (warningWarmupReleaseFrame) window.cancelAnimationFrame(warningWarmupReleaseFrame);
        if (warningLensWarmupFrame) window.cancelAnimationFrame(warningLensWarmupFrame);
        openingEdgeResizeFrame = 0;
        openingEdgeRenderHandle = 0;
        openingEdgeRenderQueue.length = 0;
        openingEdgeRecords.forEach((record) => {
          record.sampler = null;
          record.samplerPromise = null;
          record.textureQueued = false;
        });
        animationFrame = 0;
        energyFrame = 0;
        scrollFrame = 0;
        layoutResizeFrame = 0;
        energyTimer = 0;
        restoreSyncTimer = 0;
        warningWarmupHandle = 0;
        warningWarmupReleaseFrame = 0;
        warningLensWarmupFrame = 0;
        warningWarmupScheduled = false;
        warningWarmupForceRequested = false;
        gate.classList.remove("is-warning-prewarm");
        energyLoopActive = false;
        setOrientationEnabled(false);
        stopPostReleaseAnimation();
        layoutResizeObserver?.disconnect();
        spaceLensRenderer?.destroy();
        titleLensRenderer?.destroy();
        spaceLensRenderer = null;
        titleLensRenderer = null;
        if (window.__yuimiKisaraHomeCleanup === cleanup) {
          window.__yuimiKisaraHomeCleanup = null;
        }
      };
      window.__yuimiKisaraHomeCleanup = cleanup;

      render();
      gate.dataset.bound = "true";
      gate.removeAttribute("data-binding");
      gate.removeAttribute("data-kisara-runtime-retries");
      window.__yuimiKisaraHomeBootController?.markReady?.();
      scheduleWarningWarmup();
      const syncRestoredPosition = () => {
        if (!restoreWindowOpen || scrollFrame || pageMode !== "gate" || window.scrollY <= 2) return;
        pageMode = "next";
        gateVisualResetPending = true;
        finalizeGateResetForNextPage();
      };
      const syncDeferredGateReset = () => {
        if (!gateVisualResetPending || pageMode !== "next" || scrollFrame) return;
        const edgeRect = openingEdge instanceof HTMLElement
          ? openingEdge.getBoundingClientRect()
          : null;
        if (edgeRect && edgeRect.bottom >= -24) return;
        finalizeGateResetForNextPage();
      };
      window.addEventListener("pageshow", syncRestoredPosition, { signal });
      window.addEventListener("scroll", syncRestoredPosition, { passive: true, signal });
      window.addEventListener("scroll", syncDeferredGateReset, { passive: true, signal });
      window.requestAnimationFrame(() => window.requestAnimationFrame(() => {
        if (disposed) return;
        syncRestoredPosition();
        restoreSyncTimer = window.setTimeout(() => {
          restoreSyncTimer = 0;
          if (disposed) return;
          syncRestoredPosition();
          restoreWindowOpen = false;
          window.removeEventListener("scroll", syncRestoredPosition);
        }, 420);
      }));
        })();
      } catch (error) {
        const failedGate = document.querySelector("[data-kisara-gate]");
        if (failedGate instanceof HTMLElement) {
          failedGate.removeAttribute("data-bound");
          failedGate.removeAttribute("data-binding");
          window.__yuimiKisaraHomeCleanup?.();
          const retryCount = Number.parseInt(failedGate.dataset.kisaraRuntimeRetries ?? "0", 10);
          if (retryCount < 2) {
            failedGate.dataset.kisaraRuntimeRetries = String(retryCount + 1);
            window.setTimeout(() => {
              if (document.querySelector("[data-kisara-gate]") === failedGate) {
                window.__yuimiKisaraHomeSchedule?.();
              }
            }, 160 * (retryCount + 1));
            return;
          }
        }
        console.error("[Kisara] homepage runtime initialization failed", error);
        window.__yuimiKisaraHomeBootController?.markReady?.();
      }
      }, 0);
    };

    window.__yuimiKisaraHomeSchedule = scheduleKisaraHome;
    if (!window.__yuimiKisaraHomeLifecycleBound) {
      document.addEventListener("astro:before-swap", () => {
        window.clearTimeout(window.__yuimiKisaraHomeInitTimer);
        window.__yuimiKisaraHomeInitTimer = 0;
        window.__yuimiKisaraHomeCleanup?.();
      });
      document.addEventListener("astro:page-load", () => {
        window.__yuimiKisaraHomeSchedule?.();
      });
      window.__yuimiKisaraHomeLifecycleBound = true;
    }
    scheduleKisaraHome();
  </script>
  <script is:inline data-astro-rerun>
    (() => {
      window.__yuimiKisaraRuntimeGuardCleanup?.();
      const gate = document.querySelector("[data-kisara-gate]");
      if (!(gate instanceof HTMLElement)) return;
      const sourceScript = Array.from(document.scripts).find((script) => (
        script.type === "module"
        && script.src.includes("HomePage.astro_astro_type_script")
      ));
      if (!(sourceScript instanceof HTMLScriptElement)) return;
      sourceScript.setAttribute("fetchpriority", "high");

      let retryTimer = 0;
      let retryAttempt = 0;
      let retryScript = null;
      const hasBoundRuntime = () => gate.dataset.bound === "true";

      const cleanup = () => {
        if (retryTimer) window.clearTimeout(retryTimer);
        retryTimer = 0;
        sourceScript.removeEventListener("error", retryRuntime);
        if (retryScript instanceof HTMLScriptElement) {
          retryScript.onload = null;
          retryScript.onerror = null;
        }
        if (window.__yuimiKisaraRuntimeGuardCleanup === cleanup) {
          window.__yuimiKisaraRuntimeGuardCleanup = null;
        }
      };

      const scheduleRetry = (delay) => {
        if (retryTimer || hasBoundRuntime()) return;
        retryTimer = window.setTimeout(() => {
          retryTimer = 0;
          retryRuntime();
        }, delay);
      };

      function retryRuntime() {
        if (hasBoundRuntime()) {
          cleanup();
          return;
        }
        if (retryAttempt >= 2) {
          window.__yuimiKisaraHomeBootController?.markReady?.();
          cleanup();
          return;
        }
        retryAttempt += 1;
        window.__yuimiKisaraHomeBootController?.arm?.();
        const script = document.createElement("script");
        const separator = sourceScript.src.includes("?") ? "&" : "?";
        script.type = "module";
        script.src = `${sourceScript.src}${separator}kisara-runtime-retry=${retryAttempt}`;
        script.setAttribute("fetchpriority", "high");
        script.dataset.kisaraRuntimeRetry = String(retryAttempt);
        script.onload = () => scheduleRetry(900);
        script.onerror = () => scheduleRetry(360);
        retryScript = script;
        document.head.appendChild(script);
      }

      sourceScript.addEventListener("error", retryRuntime, { once: true });
      window.__yuimiKisaraRuntimeGuardCleanup = cleanup;
      document.addEventListener("astro:before-swap", cleanup, { once: true });
      scheduleRetry(3200);
    })();
  </script>
</KisaraLayout>
