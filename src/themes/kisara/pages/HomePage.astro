---
import KisaraLayout from "../layouts/KisaraLayout.astro";
import { Icon } from "astro-icon/components";
import { getPublishedPosts } from "@/core/content/blog";
import { currentSignals, profileIdentity } from "@/core/data/profile";
import { projectEntries } from "@/core/data/projects";
import { getThemePath } from "@/core/themes/registry";
import { categoryLabel } from "@/lib/site";
import { existsSync } from "node:fs";
import { resolve } from "node:path";

const posts = (await getPublishedPosts()).slice(0, 3);
const featuredProjects = projectEntries.slice(0, 3);
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
});

const backgroundExtensions = ["webp", "png", "jpg", "jpeg"];
const findThemeAsset = (baseName: string) => {
  const extension = backgroundExtensions.find((candidate) =>
    existsSync(resolve(`public/themes/kisara/assets/${baseName}.${candidate}`))
  );
  return extension ? `/themes/kisara/assets/${baseName}.${extension}` : null;
};
const activeBackgroundUrl = findThemeAsset("gate-background");
const activeFightUrl = findThemeAsset("fight");
const activeTransformationUrl = findThemeAsset("transformation-silhouette");
const memoryScenes = [
  {
    id: "rescue",
    image: "/themes/kisara/assets/memory-rescue.webp",
    position: "center 50%",
    saturation: 0.88,
    brightness: 1.03
  },
  {
    id: "attack",
    image: "/themes/kisara/assets/memory-attack.webp",
    position: "center 42%",
    saturation: 0.96,
    brightness: 1.04
  },
  {
    id: "clash",
    image: "/themes/kisara/assets/memory-clash.webp",
    position: "center 50%",
    saturation: 1.08,
    brightness: 1.08
  },
  {
    id: "embrace",
    image: "/themes/kisara/assets/memory-embrace.webp",
    position: "center 50%",
    saturation: 0.9,
    brightness: 1.03
  },
  {
    id: "kiss",
    image: "/themes/kisara/assets/memory-kiss.webp",
    position: "center 50%",
    saturation: 0.88,
    brightness: 1.06
  }
] as const;
const transformationScenes = [
  {
    id: "smoke-wide",
    image: "/themes/kisara/assets/transformation-smoke-wide.webp",
    position: "center 50%",
    saturation: 0.96,
    brightness: 1.02
  },
  {
    id: "detail",
    image: "/themes/kisara/assets/transformation-detail.webp",
    position: "center 48%",
    saturation: 1.02,
    brightness: 0.98
  },
  {
    id: "silhouette",
    image: "/themes/kisara/assets/transformation-silhouette.webp",
    position: "center 50%",
    saturation: 1.04,
    brightness: 0.96
  }
] as const;
const gateSceneManifest = [
  ...memoryScenes.map((scene, index) => ({
    ...scene,
    id: `memory-${scene.id}`,
    kind: "memory",
    index,
    order: index
  })),
  ...transformationScenes.map((scene, index) => ({
    ...scene,
    id: `transformation-${scene.id}`,
    kind: "transformation",
    index,
    order: memoryScenes.length + index
  }))
] as const;
const openingEdgeScenes = [
  {
    id: "base",
    kind: "base",
    index: -1,
    image: activeBackgroundUrl ?? "",
    position: "center 50%"
  },
  ...gateSceneManifest.map((scene) => ({
    id: scene.id,
    kind: scene.kind,
    index: scene.index,
    image: scene.image,
    position: scene.position
  })),
  {
    id: "fight",
    kind: "fight",
    index: -1,
    image: activeFightUrl ?? "",
    position: "center 50%"
  }
].filter((scene) => scene.image);
const channelLinks = [
  { index: "01", label: "READ THE LOG", note: "开发与部署记录", href: getThemePath("kisara", "/blog/"), icon: "tabler:book-2" },
  { index: "02", label: "OPEN THE LAB", note: "项目与互动实验", href: getThemePath("kisara", "/projects/"), icon: "tabler:flask-2" },
  { index: "03", label: "ENTER PLAY", note: "短暂切进小游戏", href: getThemePath("kisara", "/games/"), icon: "tabler:device-gamepad-2" },
  { index: "04", label: "TRACE YUIMI", note: "读取契约者资料", href: getThemePath("kisara", "/about/"), icon: "tabler:user-scan" }
] as const;
const signalPresentation = [
  { code: "LEARN", icon: "tabler:sparkles", accent: "blue" },
  { code: "BUILD", icon: "tabler:flask-2", accent: "pink" },
  { code: "TUNE", icon: "tabler:activity-heartbeat", accent: "violet" }
] as const;
const projectPresentation: Record<string, { icon: string; code: string }> = {
  astrbot: { icon: "tabler:terminal-2", code: "BOT" },
  unity: { icon: "tabler:device-gamepad-2", code: "PLAY" },
  blender: { icon: "tabler:sparkles", code: "FORM" },
  ue5: { icon: "tabler:flask-2", code: "SCENE" },
  mmd: { icon: "tabler:movie", code: "MOTION" }
};
const ambientParticles = [
  { x: 7, y: 21, driftX: 88, driftY: -54, size: 3.2, duration: 18.4, delay: -4.8, opacity: 0.46, hue: 338 },
  { x: 15, y: 73, driftX: 64, driftY: -92, size: 2.1, duration: 21.7, delay: -13.2, opacity: 0.34, hue: 346 },
  { x: 24, y: 39, driftX: -42, driftY: -68, size: 4.1, duration: 24.2, delay: -8.7, opacity: 0.38, hue: 329 },
  { x: 32, y: 84, driftX: 76, driftY: -74, size: 2.7, duration: 19.6, delay: -16.4, opacity: 0.42, hue: 341 },
  { x: 41, y: 16, driftX: 45, driftY: 62, size: 2.4, duration: 22.8, delay: -10.1, opacity: 0.31, hue: 350 },
  { x: 49, y: 66, driftX: -58, driftY: -86, size: 3.6, duration: 25.1, delay: -2.6, opacity: 0.4, hue: 334 },
  { x: 57, y: 28, driftX: 73, driftY: -48, size: 2.2, duration: 20.3, delay: -15.5, opacity: 0.36, hue: 344 },
  { x: 64, y: 79, driftX: -66, driftY: -96, size: 3.1, duration: 23.7, delay: -7.4, opacity: 0.44, hue: 327 },
  { x: 72, y: 46, driftX: 51, driftY: 58, size: 2.5, duration: 17.9, delay: -11.6, opacity: 0.33, hue: 348 },
  { x: 79, y: 17, driftX: -84, driftY: 72, size: 3.8, duration: 26.2, delay: -19.3, opacity: 0.39, hue: 336 },
  { x: 86, y: 69, driftX: -52, driftY: -82, size: 2.2, duration: 19.1, delay: -5.9, opacity: 0.37, hue: 343 },
  { x: 93, y: 35, driftX: -77, driftY: -61, size: 3.4, duration: 22.4, delay: -14.1, opacity: 0.43, hue: 331 },
  { x: 37, y: 53, driftX: 95, driftY: -42, size: 1.9, duration: 16.8, delay: -9.2, opacity: 0.3, hue: 352 },
  { x: 68, y: 91, driftX: -91, driftY: -70, size: 2.8, duration: 24.9, delay: -17.8, opacity: 0.35, hue: 339 }
] as const;
const gateStyle = [
  "--kisara-fill: 0%",
  "--kisara-burst-progress: 0%",
  `--kisara-gate-background-image: ${activeBackgroundUrl ? `url("${activeBackgroundUrl}")` : "none"}`,
  `--kisara-fight-background-image: ${activeFightUrl ? `url("${activeFightUrl}")` : "none"}`
].join("; ");
---

<KisaraLayout title="Kisara | Yuimi Lab" description="Yuimi Lab 的 Kisara 视觉交互主题。">
  <section class="kisara-gate" data-kisara-gate style={gateStyle}>
    <script type="application/json" data-kisara-scene-manifest set:html={JSON.stringify(gateSceneManifest)}></script>
    <div class="kisara-gate-visual-shell" aria-hidden="true">
      <div class="kisara-gate-visual-camera">
        <div class="kisara-gate-visual">
          <div class="kisara-gate-background kisara-gate-background-base"></div>
          <div class="kisara-gate-background kisara-gate-scene-slot" data-kisara-scene-slot="0"></div>
          <div class="kisara-gate-background kisara-gate-scene-slot" data-kisara-scene-slot="1"></div>
          <div class="kisara-gate-background kisara-gate-background-fight"></div>
          <div class="kisara-memory-flare"></div>
          <div class="kisara-gate-background kisara-gate-background-fight-wash"></div>
          <div class="kisara-gate-atmosphere"></div>
        </div>
        <canvas
          class="kisara-space-lens-canvas"
          data-kisara-space-lens
          data-base-src={activeBackgroundUrl ?? ""}
          data-pre-release-src={activeTransformationUrl ?? activeBackgroundUrl ?? ""}
          data-fight-src={activeFightUrl ?? ""}
          width="1280"
          height="900"
        ></canvas>
        <canvas
          class="kisara-post-release-canvas"
          data-kisara-post-release-canvas
          data-fight-src={activeFightUrl ?? ""}
          width="1280"
          height="900"
        ></canvas>
      </div>
    </div>
    <div class="kisara-ambient-particles" aria-hidden="true">
      {ambientParticles.map((particle) => (
        <i
          style={[
            `--kisara-particle-x: ${particle.x}%`,
            `--kisara-particle-y: ${particle.y}%`,
            `--kisara-particle-drift-x: ${particle.driftX}px`,
            `--kisara-particle-drift-y: ${particle.driftY}px`,
            `--kisara-particle-size: ${particle.size}px`,
            `--kisara-particle-duration: ${particle.duration}s`,
            `--kisara-particle-delay: ${particle.delay}s`,
            `--kisara-particle-opacity: ${particle.opacity}`,
            `--kisara-particle-hue: ${particle.hue}`
          ].join("; ")}
        ></i>
      ))}
    </div>
    <canvas class="kisara-burst-canvas" data-kisara-burst-canvas width="1280" height="900" aria-hidden="true"></canvas>
    <div class="kisara-screen-impact" aria-hidden="true">
      <span class="kisara-warning-monochrome"></span>
      <span class="kisara-warning-focus"></span>
      <span class="kisara-warning-exposure"></span>
      <i class="kisara-title-cross">
        <span class="kisara-cross-ring"></span>
        <span class="kisara-cross-ray kisara-cross-ray-north"></span>
        <span class="kisara-cross-ray kisara-cross-ray-east"></span>
        <span class="kisara-cross-ray kisara-cross-ray-south"></span>
        <span class="kisara-cross-ray kisara-cross-ray-west"></span>
        <span class="kisara-cross-shard kisara-cross-shard-a"></span>
        <span class="kisara-cross-shard kisara-cross-shard-b"></span>
        <span class="kisara-cross-shard kisara-cross-shard-c"></span>
        <span class="kisara-cross-shard kisara-cross-shard-d"></span>
        <span class="kisara-cross-spark kisara-cross-spark-a"></span>
        <span class="kisara-cross-spark kisara-cross-spark-b"></span>
        <span class="kisara-cross-spark kisara-cross-spark-c"></span>
        <span class="kisara-cross-spark kisara-cross-spark-d"></span>
        <span class="kisara-cross-core"></span>
      </i>
    </div>
    <h1 class="kisara-title" aria-label="Kisara">
      <canvas
        class="kisara-title-chain-canvas kisara-title-chain-canvas-back"
        data-kisara-chain-back
        width="1400"
        height="420"
        aria-hidden="true"
      ></canvas>
      <span class="kisara-title-base" aria-hidden="true">Kisara</span>
      <span class="kisara-title-tide" aria-hidden="true">Kisara</span>
      <canvas
        class="kisara-title-chain-canvas kisara-title-chain-canvas-front"
        data-kisara-chain-front
        width="1400"
        height="420"
        aria-hidden="true"
      ></canvas>
      <span class="kisara-title-enchant" aria-hidden="true">Kisara</span>
      <span class="kisara-title-gloss" aria-hidden="true">Kisara</span>
      <canvas
        class="kisara-title-data-canvas"
        data-kisara-title-data
        width="1200"
        height="320"
        aria-hidden="true"
      ></canvas>
      <canvas
        class="kisara-title-lens-canvas"
        data-kisara-title-lens
        width="1200"
        height="260"
        aria-hidden="true"
      ></canvas>
    </h1>
    <div class="kisara-contract-meter" aria-hidden="true">
      <canvas class="kisara-energy-canvas" data-kisara-energy width="640" height="64"></canvas>
    </div>
    <p class="kisara-contract-state" data-kisara-state>SEAL CHAINS / DORMANT</p>
    <p class="kisara-scroll-cue" data-kisara-cue>Yuimi-chaya/GPT in Codex</p>
    <button class="kisara-motion-toggle" type="button" data-kisara-motion-toggle hidden aria-pressed="false">
      <Icon name="tabler:activity-heartbeat" aria-hidden="true" />
      <span>体感视差</span>
    </button>
    <a class="kisara-gate-skip" href="#kisara-opening" data-kisara-skip>SKIP</a>
  </section>

  <section
    id="kisara-opening"
    class="kisara-opening"
    aria-labelledby="kisara-opening-title"
  >
    <div class="kisara-opening-edge" aria-hidden="true">
      <span class="kisara-opening-edge-backdrop"></span>
      {openingEdgeScenes.map((scene) => (
        <span
          class="kisara-opening-edge-scene"
          data-kisara-opening-edge-scene={scene.id}
          data-edge-kind={scene.kind}
          data-edge-index={scene.index}
          data-edge-source={scene.image}
          data-edge-position={scene.position}
        >
          <i class="kisara-opening-edge-continuation"></i>
          <i class="kisara-opening-edge-live-clip">
            <b class="kisara-opening-edge-live-surface"></b>
          </i>
        </span>
      ))}
      <span class="kisara-opening-edge-atmosphere"></span>
      <span class="kisara-opening-edge-flare">
        <i class="kisara-opening-edge-flare-surface"></i>
      </span>
    </div>
    <div class="kisara-opening-inner">
      <p class="kisara-section-index">AFTER THE SIGNATURE / 001</p>
      <div class="kisara-opening-heading">
        <h2 id="kisara-opening-title">After the contract.</h2>
        <span>CHANNEL 03 / CONNECTED</span>
      </div>
      <div class="kisara-opening-grid">
        <div class="kisara-opening-copy">
          <p>这里不再继续重复首屏的演出，而是把视觉、交互与技术记录接到同一条契约线上。</p>
          <div class="kisara-contractor-line">
            <span>CONTRACTOR</span>
            <strong>{profileIdentity.displayName} / {profileIdentity.handle}</strong>
            <small>兴趣驱动型折腾人 · 喜欢把技术做得有一点可爱</small>
          </div>
        </div>
        <nav class="kisara-channel-links" aria-label="Kisara theme shortcuts">
          {channelLinks.map((item) => (
            <a href={item.href}>
              <span>{item.index}</span>
              <Icon name={item.icon} aria-hidden="true" />
              <div><strong>{item.label}</strong><small>{item.note}</small></div>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <section class="kisara-signal-deck" aria-labelledby="kisara-signal-title">
    <div class="kisara-content-shell">
      <header class="kisara-home-band-heading">
        <div>
          <p class="kisara-section-index">LIVE SIGNALS / 002</p>
          <h2 id="kisara-signal-title">Current pulse.</h2>
        </div>
        <p>不用仪表盘汇报人生，只留三条现在确实还在发热的信号。</p>
        <div class="kisara-home-frequency" aria-hidden="true"><span>CH.03</span><i></i><i></i><i></i><i></i></div>
      </header>
      <div class="kisara-signal-stage">
        <div class="kisara-signal-axis" aria-hidden="true">
          <span>LIVE</span>
          <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
          <strong>NOW</strong>
        </div>
        <div class="kisara-signal-stream">
        {currentSignals.map((signal, index) => (
          <article class={`is-${signalPresentation[index]?.accent ?? "blue"}`} style={`--signal-order: ${index};`}>
            <div class="kisara-signal-pulse" aria-hidden="true">
              <span><Icon name={signalPresentation[index]?.icon ?? "tabler:activity-heartbeat"} /></span>
              <i></i>
            </div>
            <div>
              <small>0{index + 1} / {signalPresentation[index]?.code ?? "LIVE"} / {signal.label}</small>
              <h3>{signal.text}</h3>
            </div>
          </article>
        ))}
        </div>
      </div>
    </div>
  </section>

  <section class="kisara-home-projects" aria-labelledby="kisara-project-title">
    <div class="kisara-content-shell">
      <header class="kisara-home-band-heading is-lab-heading">
        <div>
          <p class="kisara-section-index">ACTIVE LAB / 003</p>
          <h2 id="kisara-project-title">Work in motion.</h2>
        </div>
        <a class="kisara-section-link" href={getThemePath("kisara", "/projects/")}>VIEW ALL WORKS <span>↗</span></a>
      </header>
      <div class="kisara-lab-runway">
        <div class="kisara-lab-index" aria-hidden="true"><span>ACTIVE</span><strong>03</strong><small>LAB CHANNELS</small></div>
        <div class="kisara-project-tracks">
        {featuredProjects.map((project, index) => (
          <a href={getThemePath("kisara", "/projects/")} style={`--track-order: ${index};`}>
            <span class="kisara-project-track-icon" aria-hidden="true">
              <Icon name={projectPresentation[project.line]?.icon ?? "tabler:flask-2"} />
            </span>
            <div class="kisara-project-track-copy">
              <small>{project.type} / {project.status}</small>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
            </div>
            <div class="kisara-project-track-signal">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <i aria-hidden="true"></i>
              <strong>{projectPresentation[project.line]?.code ?? project.line.toUpperCase()}</strong>
            </div>
          </a>
        ))}
        </div>
      </div>
    </div>
  </section>

  <section class="kisara-latest" aria-labelledby="kisara-latest-title">
    <header class="kisara-home-band-heading is-transmission-heading">
      <div>
        <p class="kisara-section-index">RECENT TRANSMISSIONS / 004</p>
        <h2 id="kisara-latest-title">Latest notes.</h2>
      </div>
      <a class="kisara-section-link" href={getThemePath("kisara", "/blog/")}>OPEN ARCHIVE <span>↗</span></a>
    </header>
    <div class="kisara-transmission-shelf">
      {posts.map((post, index) => (
        <a href={getThemePath("kisara", `/blog/${post.id}/`)} style={`--transmission-order: ${index}; --transmission-cover: ${post.data.cover ? `url("${post.data.cover}")` : "none"};`}>
          <figure>
            {post.data.cover ? <img src={post.data.cover} alt="" width="700" height="990" loading="lazy" decoding="async" /> : <span>{String(index + 1).padStart(2, "0")}</span>}
          </figure>
          <div class="kisara-transmission-copy">
            <small>{categoryLabel[post.data.category]} / <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.updatedDate ?? post.data.pubDate)}</time></small>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span>READ SIGNAL <i aria-hidden="true">↗</i></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script>
    const scheduleKisaraHome = () => {
      window.__yuimiKisaraHomeSchedule = scheduleKisaraHome;
      window.clearTimeout(window.__yuimiKisaraHomeInitTimer);
      const scheduledGate = document.querySelector("[data-kisara-gate]");
      if (!(scheduledGate instanceof HTMLElement)) return;
      if (scheduledGate.dataset.bound === "true") {
        window.__yuimiKisaraHomeBootController?.markReady?.();
        return;
      }
      if (scheduledGate.dataset.binding === "true") return;
      window.__yuimiKisaraHomeInitTimer = window.setTimeout(() => {
        window.__yuimiKisaraHomeInitTimer = 0;
        const pendingGate = document.querySelector("[data-kisara-gate]");
        if (!(pendingGate instanceof HTMLElement)) return;
        if (pendingGate.dataset.bound === "true") {
          window.__yuimiKisaraHomeBootController?.markReady?.();
          return;
        }
        if (pendingGate.dataset.binding === "true") return;
        window.__yuimiKisaraHomeCleanup?.();
      try {
        (() => {
      const gate = document.querySelector("[data-kisara-gate]");
      if (!gate) return;
      if (gate.dataset.bound === "true") {
        window.__yuimiKisaraHomeBootController?.markReady?.();
        return;
      }
      if (gate.dataset.binding === "true") return;
      gate.dataset.binding = "true";
      const lifecycle = new AbortController();
      const signal = lifecycle.signal;
      let disposed = false;

      const energyCanvas = gate.querySelector("[data-kisara-energy]");
      const energyContext = energyCanvas?.getContext("2d");
      const burstCanvas = gate.querySelector("[data-kisara-burst-canvas]");
      const burstContext = burstCanvas?.getContext("2d");
      const spaceLensCanvas = gate.querySelector("[data-kisara-space-lens]");
      const titleLensCanvas = gate.querySelector("[data-kisara-title-lens]");
      const chainBackCanvas = gate.querySelector("[data-kisara-chain-back]");
      const chainBackContext = chainBackCanvas?.getContext("2d", { alpha: true });
      const chainFrontCanvas = gate.querySelector("[data-kisara-chain-front]");
      const chainFrontContext = chainFrontCanvas?.getContext("2d", { alpha: true });
      const titleDataCanvas = gate.querySelector("[data-kisara-title-data]");
      const titleDataContext = titleDataCanvas?.getContext("2d", { alpha: true });
      const postReleaseCanvas = gate.querySelector("[data-kisara-post-release-canvas]");
      const postReleaseContext = postReleaseCanvas?.getContext("2d", { alpha: true });
      const gateVisualShell = gate.querySelector(".kisara-gate-visual-shell");
      const gateVisual = gate.querySelector(".kisara-gate-visual");
      const baseBackground = gate.querySelector(".kisara-gate-background-base");
      const fightBackground = gate.querySelector(".kisara-gate-background-fight");
      const fightWashBackground = gate.querySelector(".kisara-gate-background-fight-wash");
      const memoryFlare = gate.querySelector(".kisara-memory-flare");
      const sceneManifestElement = gate.querySelector("[data-kisara-scene-manifest]");
      let sceneManifest = [];
      try {
        const parsedManifest = JSON.parse(sceneManifestElement?.textContent ?? "[]");
        sceneManifest = Array.isArray(parsedManifest) ? parsedManifest : [];
      } catch {
        sceneManifest = [];
      }
      const memorySceneRecords = sceneManifest.filter((scene) => scene?.kind === "memory");
      const transformationSceneRecords = sceneManifest.filter(
        (scene) => scene?.kind === "transformation"
      );
      const sceneSlotRecords = Array.from(
        gate.querySelectorAll("[data-kisara-scene-slot]")
      ).map((element, index) => ({
        element,
        index,
        sceneId: "",
        rendered: Object.create(null)
      }));
