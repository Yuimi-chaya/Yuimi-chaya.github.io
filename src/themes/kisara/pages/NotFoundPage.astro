---
import KisaraLayout from "../layouts/KisaraLayout.astro";
import { getThemePath } from "@/core/themes/registry";

const from = Astro.url.searchParams.get("from");
---

<KisaraLayout title="404 | Kisara" description="这条契约线路没有响应。">
  <section class="kisara-not-found">
    <p class="kisara-section-index">SIGNAL LOST</p>
    <h1>404</h1>
    <p>{from ? `未找到：${from}` : "这条契约线路没有返回任何信号。"}</p>
    <a href={getThemePath("kisara", "/")}>RETURN TO KISARA</a>
  </section>
</KisaraLayout>
