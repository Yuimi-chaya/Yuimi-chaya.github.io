---
import KisaraLayout from "../layouts/KisaraLayout.astro";
import { Icon } from "astro-icon/components";
import { getThemePath } from "@/core/themes/registry";

const from = Astro.url.searchParams.get("from");
---

<KisaraLayout title="404 | Kisara" description="这条契约线路没有响应。">
  <section class="kisara-not-found">
    <div class="kisara-error-orbit" aria-hidden="true"><span>4</span><i></i><span>4</span></div>
    <div>
      <p class="kisara-section-index">SIGNAL LOST / NO RESPONSE</p>
      <h1>404</h1>
      <p>{from ? `未找到：${from}` : "这条契约线路没有返回任何信号。可能是坐标失效，也可能只是被木更切断了。"}</p>
      <nav aria-label="错误恢复操作">
        <a href={getThemePath("kisara", "/")}><Icon name="tabler:home" aria-hidden="true" />KISARA HOME</a>
        <a href={getThemePath("kisara", "/blog/")}><Icon name="tabler:book-2" aria-hidden="true" />READ LOGS</a>
        <button type="button" data-kisara-back><Icon name="tabler:arrow-back-up" aria-hidden="true" />GO BACK</button>
      </nav>
    </div>
  </section>

  <script is:inline>
    document.querySelector("[data-kisara-back]")?.addEventListener("click", () => {
      if (history.length > 1) history.back();
      else window.location.href = "/themes/kisara/";
    });
  </script>
</KisaraLayout>
