---
import KisaraLayout from "../layouts/KisaraLayout.astro";
import { profileIdentity, profileStatus, profileTech } from "@/core/data/profile";
---

<KisaraLayout title="About | Kisara" description="关于喝益胃与 Yuimi Lab。">
  <section class="kisara-page-lead">
    <p class="kisara-section-index">IDENTITY TRACE</p>
    <h1>{profileIdentity.handle}</h1>
    <p>{profileIdentity.bio}</p>
  </section>
  <section class="kisara-data-section">
    <h2>Current status</h2>
    <div class="kisara-inline-signals">{profileStatus.map((item) => <span>{item}</span>)}</div>
  </section>
  <section class="kisara-data-section">
    <h2>Technical lines</h2>
    <dl>{profileTech.map((item) => <div><dt>{item.name}</dt><dd>{item.note}</dd></div>)}</dl>
  </section>
</KisaraLayout>
