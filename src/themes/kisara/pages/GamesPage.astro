---
import KisaraLayout from "../layouts/KisaraLayout.astro";
import gamesStylesheet from "../styles/games.css?url";
import { Icon } from "astro-icon/components";
import { gamePicks } from "@/core/data/games";

const gamePresentation = {
  "2048": {
    channel: "TILE LOGIC",
    code: "02 / 48",
    embed: "/themes/kisara/games/2048/index.html",
    prompt: "MERGE THE QUIET",
    session: "02-10 MIN",
    control: "ARROW KEYS",
    status: "CALM LOOP / READY"
  },
  hextris: {
    channel: "HEX REACTOR",
    code: "HEX / 06",
    embed: "https://hextris.github.io/hextris/",
    prompt: "ROTATE THE PANIC",
    session: "03-12 MIN",
    control: "LEFT / RIGHT",
    status: "REACTOR / STABLE"
  },
  "clumsy-bird": {
    channel: "PIXEL FLIGHT",
    code: "FLY / 01",
    embed: "https://ellisonleao.github.io/clumsy-bird/",
    prompt: "MISS. RETRY. FLY.",
    session: "01-05 MIN",
    control: "CLICK / SPACE",
    status: "FLIGHT PATH / OPEN"
  }
} as const;

const gameMessageBursts = [
  { draft: "綾乃、読んだよね.....ねえ、読んだ???", display: "READ ME???", x: "2%", y: "13%", rotate: "-7deg", scale: "0.94" },
  { draft: "返事、返事、返事、返事.....", display: "RE: RE: RE:", x: "48%", y: "10%", rotate: "5deg", scale: "0.72" },
  { draft: "好きxxxxx好きxxxxx.....???", display: "XXXXX...???", x: "19%", y: "33%", rotate: "-2deg", scale: "0.84" },
  { draft: "離れるほど重くなる。どうして???", display: "HEAVIER.", x: "56%", y: "37%", rotate: "7deg", scale: "0.76" },
  { draft: "沈む、沈む、まだ沈む.....", display: "DOWN / DOWN", x: "5%", y: "60%", rotate: "2.5deg", scale: "0.82" },
  { draft: "その隣、空けて。空けて。空けて。", display: "MINE.", x: "50%", y: "64%", rotate: "-5deg", scale: "0.94" },
  { draft: "既読xxxxxxxxx.............まだいる???", display: "STILL THERE?", x: "21%", y: "78%", rotate: "3deg", scale: "0.68" }
] as const;
---

<KisaraLayout title="Games | Kisara" description="Yuimi Lab 的小游戏收藏。" stylesheets={[gamesStylesheet]}>
  <div class="kisara-games" data-kisara-games data-active-scene="0" data-media-state="loading">
    <section
      id="kisara-game-message"
      class="kisara-game-scene kisara-game-hero"
      data-game-scene
      data-scene-position="active"
      data-intro-state="idle"
      data-easter-pressure="0"
      aria-labelledby="kisara-game-hero-title"
    >
      <div class="kisara-game-hero-media" aria-hidden="true">
        <video
          class="kisara-game-hero-video"
          data-game-hero-video
          poster="/themes/kisara/assets/game-message-hero.webp"
          width="1280"
          height="720"
          preload="auto"
          autoplay
          muted
          playsinline
        >
          <source src="/themes/kisara/assets/game-message-hero.mp4" type="video/mp4" />
        </video>
        <span class="kisara-game-hero-light"></span>
      </div>

      <div class="kisara-game-message-echoes" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i>
      </div>

      <div class="kisara-game-sent-field" data-game-sent-field aria-hidden="true">
        {gameMessageBursts.map((message, index) => (
          <p
            data-game-sent-burst={index}
            data-game-message-draft={message.draft}
            style={`--sent-x: ${message.x}; --sent-y: ${message.y}; --sent-rotate: ${message.rotate}; --sent-scale: ${message.scale}; --sent-order: ${index};`}
          >{message.display}</p>
        ))}
      </div>

      <div class="kisara-game-terminal" data-game-terminal data-message-state="idle">
        <header>
          <span>private://ayano</span>
          <i aria-hidden="true"></i>
          <em>OUTBOX / LIVE</em>
        </header>
        <div class="kisara-game-terminal-line">
          <span aria-hidden="true">&gt;</span>
          <p id="kisara-game-hero-title" lang="ja" data-game-terminal-copy aria-live="off"></p>
          <i aria-hidden="true"></i>
        </div>
        <footer>
          <span data-game-terminal-status>QUEUE 01 / {String(gameMessageBursts.length).padStart(2, "0")}</span>
          <em data-game-terminal-action>COMPOSING</em>
        </footer>
      </div>

      <div class="kisara-game-hand-meter" aria-hidden="true">
        <p><span>HAND VELOCITY</span><output data-game-input-speed>00</output></p>
        <i><b></b></i>
        <small>MOVE POINTER / SEE PANIC</small>
      </div>

      <div class="kisara-game-overdrive" data-game-overdrive aria-hidden="true">
        <span class="kisara-game-overdrive-frame"><i></i><i></i><i></i><i></i></span>
        <span class="kisara-game-overdrive-tears"><i></i><i></i><i></i></span>
        <p>
          <small data-game-easter-hint>SHAKE THE MESSAGE APART</small>
          <strong><output data-game-easter-progress>5.0</output><span>SEC</span></strong>
          <em>KEEP MOVING AFTER THE LIMIT LOCKS</em>
        </p>
      </div>

      <div class="kisara-game-transition-cuts" aria-hidden="true"><i></i><i></i><i></i></div>

      <button class="kisara-game-scene-step is-next" type="button" data-game-scene-next aria-label="进入街机厅">
        <span>INSERT COIN / LEAVE CHAT</span>
        <Icon name="tabler:chevron-down" aria-hidden="true" />
      </button>
    </section>

    <section
      id="kisara-arcade-console"
      class="kisara-game-scene kisara-arcade"
      data-game-scene
      data-kisara-arcade
      data-scene-position="after"
      data-active-game={gamePicks[0].id}
      aria-labelledby="kisara-arcade-title"
    >
      <div class="kisara-arcade-backdrop" aria-hidden="true">
        <img src="/themes/kisara/assets/game-arcade-room.webp" alt="" width="2200" height="1238" decoding="async" />
        <span></span>
      </div>
      <div class="kisara-arcade-arrival" aria-hidden="true"><i></i><i></i><i></i></div>

      <header class="kisara-arcade-heading">
        <p><span>02</span> AFTER HOURS / OPEN CHANNEL</p>
        <h2 id="kisara-arcade-title">Insert a moment.<em>Keep the night.</em></h2>
        <p>三条短暂离线的轨道。选好频道，再让这台机子真正亮起来。</p>
      </header>

      <div class="kisara-arcade-layout">
        <aside class="kisara-arcade-queue" aria-label="游戏选择">
          <header><span>CHANNEL</span><small>{String(gamePicks.length).padStart(2, "0")} READY</small></header>
          <div role="tablist" aria-label="游戏频道">
            {gamePicks.map((game, index) => (
              <button
                type="button"
                data-game-select={game.id}
                data-game-status={gamePresentation[game.id].status}
                data-game-src={gamePresentation[game.id].embed}
                data-game-external-src={game.play}
                data-game-name={game.name}
                id={`kisara-game-tab-${game.id}`}
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-pressed={index === 0 ? "true" : "false"}
                aria-controls={`kisara-game-${game.id}`}
                tabindex={index === 0 ? "0" : "-1"}
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{game.name}</strong>
                <small>{gamePresentation[game.id].channel}</small>
                <i aria-hidden="true"></i>
              </button>
            ))}
          </div>
        </aside>

        <div class="kisara-arcade-machine" data-game-machine>
          <div class="kisara-arcade-machine-body">
            <header class="kisara-arcade-machine-marquee">
              <span>YUIMI NIGHT ARCADE</span>
              <strong data-game-machine-title>{gamePicks[0].name}</strong>
              <output data-game-status>{gamePresentation[gamePicks[0].id].status}</output>
            </header>

            <div class="kisara-arcade-machine-shell">
              <div class="kisara-arcade-screen" data-game-stage data-game-screen data-screen-state="idle">
                <div class="kisara-arcade-visual" aria-hidden="true">
                  <span class="kisara-arcade-horizon"></span>
                  <div class="kisara-arcade-world is-2048">
                    <div class="kisara-arcade-tiles">
                      <i data-value="2"></i><i data-value="4"></i><i data-value="8"></i><i data-value="16"></i>
                      <i data-value="32"></i><i data-value="64"></i><i data-value="128"></i><i data-value="256"></i>
                    </div>
                    <b>2048</b>
                  </div>
                  <div class="kisara-arcade-world is-hextris">
                    <div class="kisara-arcade-hex-core"><i></i><i></i><i></i><i></i><i></i><i></i><b></b></div>
                  </div>
                  <div class="kisara-arcade-world is-clumsy-bird">
                    <div class="kisara-arcade-flight"><i class="is-bird"></i><i class="is-pipe-one"></i><i class="is-pipe-two"></i><span></span></div>
                  </div>
                </div>

                <div class="kisara-arcade-panels" aria-live="polite">
                  {gamePicks.map((game, index) => (
                    <article
                      id={`kisara-game-${game.id}`}
                      data-game-panel={game.id}
                      role="tabpanel"
                      aria-labelledby={`kisara-game-tab-${game.id}`}
                      hidden={index !== 0}
                    >
                      <div class="kisara-arcade-panel-meta">
                        <span>{gamePresentation[game.id].code}</span>
                        <small>{gamePresentation[game.id].prompt}</small>
                      </div>
                      <h3>{game.name}</h3>
                      <p>{game.summary}</p>
                      <dl>
                        <div><dt>SESSION</dt><dd>{gamePresentation[game.id].session}</dd></div>
                        <div><dt>CONTROL</dt><dd>{gamePresentation[game.id].control}</dd></div>
                      </dl>
                      <a class="kisara-arcade-source" href={game.repo} target="_blank" rel="noreferrer">
                        <Icon name="tabler:brand-github" aria-hidden="true" />SOURCE<Icon name="tabler:external-link" aria-hidden="true" />
                      </a>
                    </article>
                  ))}
                </div>

                <iframe
                  data-game-frame
                  title={`${gamePicks[0].name} 游戏画面`}
                  sandbox="allow-scripts allow-same-origin allow-pointer-lock allow-popups"
                  allow="fullscreen; gamepad"
                  referrerpolicy="strict-origin-when-cross-origin"
                  hidden
                ></iframe>
                <div class="kisara-arcade-loader" data-game-loader hidden aria-live="polite">
                  <i aria-hidden="true"></i><span>CONNECTING GAME FEED</span>
                </div>
                <span class="kisara-arcade-screen-glass" aria-hidden="true"></span>
              </div>
            </div>

            <footer class="kisara-arcade-controls">
              <div class="kisara-arcade-joystick" aria-hidden="true">
                <span></span><i></i><em></em><small>PLAYER 01</small>
              </div>
              <div class="kisara-arcade-machine-actions">
                <output data-game-counter aria-live="polite">01 / {String(gamePicks.length).padStart(2, "0")}</output>
                <button class="kisara-arcade-start" type="button" data-game-launch>
                  <i><Icon name="tabler:player-play" aria-hidden="true" /></i>
                  <span><strong data-game-launch-label>START</strong><small data-game-launch-note>LOAD GAME</small></span>
                </button>
                <div class="kisara-arcade-machine-secondary">
                  <button class="kisara-arcade-eject" type="button" data-game-eject hidden>EJECT</button>
                  <a data-game-external href={gamePicks[0].play} target="_blank" rel="noreferrer">
                    REMOTE <Icon name="tabler:external-link" aria-hidden="true" />
                  </a>
                </div>
              </div>
              <div class="kisara-arcade-machine-switches">
                <small>CHANNEL</small>
                <div>
                  <button type="button" data-game-previous aria-label="上一个游戏" title="上一个游戏"><Icon name="tabler:chevron-left" aria-hidden="true" /></button>
                  <button type="button" data-game-next aria-label="下一个游戏" title="下一个游戏"><Icon name="tabler:chevron-right" aria-hidden="true" /></button>
                </div>
              </div>
            </footer>

            <div class="kisara-arcade-machine-base" aria-hidden="true">
              <div class="kisara-arcade-speaker"><i></i><span>STEREO</span></div>
              <div class="kisara-arcade-coin-bay"><i></i><strong>YUIMI COIN</strong><span>READY</span></div>
              <div class="kisara-arcade-service-plate"><span>03</span><strong>REMOTE PLAY UNIT</strong><i></i></div>
            </div>
          </div>
        </div>
      </div>

      <button class="kisara-game-scene-step is-previous" type="button" data-game-scene-previous aria-label="返回消息场景">
        <Icon name="tabler:chevron-down" aria-hidden="true" />
        <span>TRANSMISSION</span>
      </button>
    </section>

    <nav class="kisara-game-scene-rail" aria-label="GAME 页面场景">
      <button type="button" data-game-scene-jump="0" aria-current="true"><span>01</span><i></i></button>
      <button type="button" data-game-scene-jump="1" aria-current="false"><span>02</span><i></i></button>
    </nav>

    <div class="kisara-game-shake-easter" data-game-shake-easter data-state="idle" aria-hidden="true">
      <video
        data-game-shake-video
        poster="/themes/kisara/assets/game-shake-easter-first.webp"
        width="1280"
        height="720"
        preload="none"
        muted
        playsinline
      >
        <source data-src="/themes/kisara/assets/game-shake-easter.mp4" type="video/mp4" />
      </video>
      <span class="kisara-game-shake-scan" aria-hidden="true"></span>
      <span class="kisara-game-shake-slices" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <p class="kisara-game-shake-status" aria-hidden="true">
        <span>EXTRA SIGNAL / 01</span>
        <strong>誰彼スクランブル</strong>
        <small>INPUT LIMIT EXCEEDED</small>
      </p>
      <button type="button" data-game-shake-close aria-label="退出彩蛋画面" title="退出彩蛋画面">
        <Icon name="tabler:x" aria-hidden="true" />
      </button>
    </div>
  </div>

  <script is:inline data-astro-rerun>
    (() => {
      window.__yuimiKisaraInnerCleanup?.();
      const page = document.querySelector("[data-kisara-games]");
      if (!(page instanceof HTMLElement)) return;

      const lifecycle = new AbortController();
      const signal = lifecycle.signal;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      const performanceTier = document.documentElement.dataset.yuimiPerformance ?? "full";
      const mediaConnection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      const mediaEffectiveType = String(mediaConnection?.effectiveType || "").toLowerCase();
      const canAutomaticallyWarmMedia = performanceTier === "full"
        && !mediaConnection?.saveData
        && !/(^|-)2g$/.test(mediaEffectiveType);
      const scenes = Array.from(page.querySelectorAll("[data-game-scene]"));
      const hero = page.querySelector(".kisara-game-hero");
      const arcade = page.querySelector("[data-kisara-arcade]");
      let gameFrame = null;
      let heroVideo = null;
      const messageTimers = new Map();
      let messageRun = 0;
      let scrollFrame = 0;
      let pointerFrame = 0;
      let wheelTimer = 0;
      let wheelAccumulator = 0;
      let wheelLastTimestamp = 0;
      let activeScene = 0;
      let transitionSerial = 0;
      let pointerX = 0;
      let pointerY = 0;
      let renderedPointerX = 0;
      let renderedPointerY = 0;
      let heroPointerFrame = 0;
      let heroPointerX = 0;
      let heroPointerY = 0;
      let renderedHeroPointerX = 0;
      let renderedHeroPointerY = 0;
      let heroInputEnergy = 0;
      let heroInputTarget = 0;
      let heroLastPointerX = 0;
      let heroLastPointerY = 0;
      let heroLastPointerAt = 0;
      let heroLastMotionAt = 0;
      let heroShakeTravel = 0;
      let heroShakeLatched = false;
      let heroPressureMs = 0;
      let heroPressureLastFrame = 0;
      let heroPressureStage = 0;
      let shakeEasterPreloaded = false;
      let shakeEasterWarmupIdle = 0;
      let shakeEasterWarmupTimer = 0;
      let shakeEasterExitTimer = 0;
      let shakeEasterScrollLocked = false;
      let shakeEasterPreviousOverflow = "";
      let releaseGameShakeEaster = () => {};
      let resetGameShakePressure = () => {};
      let heroReady = false;

      const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
      const GAME_SHAKE_TRAVEL_TARGET = 620;
      const GAME_SHAKE_HOLD_DURATION = 5000;
      const gameShakeEasterViewport = window.matchMedia("(min-width: 761px)");
      let gameShakeEasterAttempt = 0;
      let gameShakeEasterArming = false;
      let gameShakeAfterglow = false;
      const terminal = hero?.querySelector("[data-game-terminal]");
      const terminalCopy = hero?.querySelector("[data-game-terminal-copy]");
      const terminalStatus = hero?.querySelector("[data-game-terminal-status]");
      const terminalAction = hero?.querySelector("[data-game-terminal-action]");
      const sentBursts = Array.from(hero?.querySelectorAll("[data-game-sent-burst]") || []);
      const terminalMessages = sentBursts.map((burst) => burst.dataset.gameMessageDraft || "");

      const waitForMessageFrame = (delay) => new Promise((resolve) => {
        if (signal.aborted) {
          resolve(false);
          return;
        }
        const timer = window.setTimeout(() => {
          messageTimers.delete(timer);
          resolve(!signal.aborted);
        }, delay);
        messageTimers.set(timer, resolve);
      });

      const resetMessageField = () => {
        if (terminalCopy) terminalCopy.textContent = "";
        if (terminalStatus) terminalStatus.textContent = `QUEUE 01 / ${String(terminalMessages.length).padStart(2, "0")}`;
        if (terminalAction) terminalAction.textContent = "COMPOSING";
        if (terminal instanceof HTMLElement) terminal.dataset.messageState = "idle";
        sentBursts.forEach((burst) => burst.classList.remove("is-sent"));
      };

      const finishMessageField = () => {
        if (terminalCopy) terminalCopy.textContent = "";
        if (terminalStatus) terminalStatus.textContent = `${String(terminalMessages.length).padStart(2, "0")} MESSAGES / DELIVERED`;
        if (terminalAction) terminalAction.textContent = "NO DRAFT";
        if (terminal instanceof HTMLElement) terminal.dataset.messageState = "complete";
        sentBursts.forEach((burst) => burst.classList.add("is-sent"));
        if (hero instanceof HTMLElement) hero.dataset.introState = "complete";
      };

      const playMessageField = async () => {
        const run = ++messageRun;
        resetMessageField();
        if (reducedMotion || !terminalMessages.length) {
          finishMessageField();
          return;
        }

        for (let messageIndex = 0; messageIndex < terminalMessages.length; messageIndex += 1) {
          const message = terminalMessages[messageIndex];
          if (terminalStatus) terminalStatus.textContent = `QUEUE ${String(messageIndex + 1).padStart(2, "0")} / ${String(terminalMessages.length).padStart(2, "0")}`;
          if (terminalAction) terminalAction.textContent = "COMPOSING";
          if (terminal instanceof HTMLElement) terminal.dataset.messageState = "typing";

          for (let characterIndex = 1; characterIndex <= message.length; characterIndex += 1) {
            if (signal.aborted || run !== messageRun) return;
            if (terminalCopy) terminalCopy.textContent = message.slice(0, characterIndex);
            if (!await waitForMessageFrame(characterIndex === 1 ? 42 : 16)) return;
          }

          if (!await waitForMessageFrame(105)) return;
          if (terminal instanceof HTMLElement) terminal.dataset.messageState = "sending";
          if (terminalAction) terminalAction.textContent = "SENT";
          sentBursts[messageIndex]?.classList.add("is-sent");
          if (!await waitForMessageFrame(85)) return;

          for (let characterIndex = message.length - 1; characterIndex >= 0; characterIndex -= 1) {
            if (signal.aborted || run !== messageRun) return;
            if (terminalCopy) terminalCopy.textContent = message.slice(0, characterIndex);
            if (!await waitForMessageFrame(7)) return;
          }

          if (!await waitForMessageFrame(45)) return;
        }

        if (run === messageRun && !signal.aborted) finishMessageField();
      };

      const cleanup = () => {
        lifecycle.abort();
        gameShakeAfterglow = false;
        messageRun += 1;
        messageTimers.forEach((resolve, timer) => {
          window.clearTimeout(timer);
          resolve(false);
        });
        messageTimers.clear();
        window.clearTimeout(wheelTimer);
        if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
        if (pointerFrame) window.cancelAnimationFrame(pointerFrame);
        if (heroPointerFrame) window.cancelAnimationFrame(heroPointerFrame);
        if (heroVideo instanceof HTMLVideoElement) heroVideo.pause();
        if (shakeEasterWarmupIdle && window.cancelIdleCallback) window.cancelIdleCallback(shakeEasterWarmupIdle);
        if (shakeEasterWarmupTimer) window.clearTimeout(shakeEasterWarmupTimer);
        shakeEasterWarmupIdle = 0;
        shakeEasterWarmupTimer = 0;
        window.clearTimeout(shakeEasterExitTimer);
        releaseGameShakeEaster(true);
        if (gameFrame instanceof HTMLIFrameElement) {
          gameFrame.src = "about:blank";
          gameFrame.removeAttribute("src");
        }
        if (window.__yuimiKisaraInnerCleanup === cleanup) window.__yuimiKisaraInnerCleanup = null;
      };
      window.__yuimiKisaraInnerCleanup = cleanup;
      document.addEventListener("astro:before-swap", cleanup, { once: true, signal });

      document.addEventListener("astro:before-preparation", (event) => {
        if (typeof event.loader !== "function") return;
        const load = event.loader;
        event.loader = async () => {
          const resumeVideoOnFailure = heroVideo instanceof HTMLVideoElement && !heroVideo.paused;
          if (heroVideo instanceof HTMLVideoElement) heroVideo.pause();
          try {
            await load();
          } catch (error) {
            if (resumeVideoOnFailure && heroVideo instanceof HTMLVideoElement) void heroVideo.play().catch(() => undefined);
            throw error;
          }
        };
      }, { signal });

      const setActiveScene = (nextScene) => {
        activeScene = clamp(nextScene, 0, scenes.length - 1);
        page.dataset.activeScene = String(activeScene);
        if (activeScene !== 0) resetGameShakePressure();
        scenes.forEach((scene, index) => {
          if (!(scene instanceof HTMLElement)) return;
          scene.dataset.scenePosition = index < activeScene ? "before" : index > activeScene ? "after" : "active";
        });
        page.querySelectorAll("[data-game-scene-jump]").forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          button.setAttribute("aria-current", String(Number(button.dataset.gameSceneJump) === activeScene));
        });
      };

      const getSceneTop = (index) => {
        const scene = scenes[index];
        return scene instanceof HTMLElement ? scene.offsetTop : 0;
      };

      const smoothScrollToScene = (nextScene) => {
        const targetScene = clamp(nextScene, 0, scenes.length - 1);
        if (scrollFrame) return false;
        const previousScene = activeScene;
        const destination = getSceneTop(targetScene);
        if (targetScene === activeScene && Math.abs(destination - window.scrollY) < 1) return false;
        if (reducedMotion) {
          setActiveScene(targetScene);
          window.scrollTo(0, destination);
          return true;
        }

        const transitionId = ++transitionSerial;
        const root = document.documentElement;
        const previousScrollBehavior = root.style.scrollBehavior;
        root.style.scrollBehavior = "auto";
        page.dataset.transitionDirection = targetScene > previousScene ? "down" : "up";
        page.style.setProperty("--game-scene-progress", "0");
        page.style.setProperty("--game-cut-shift", targetScene > previousScene ? "-120%" : "120%");
        let current = window.scrollY;
        let velocity = 0;
        let lastTimestamp = performance.now();
        const distanceTotal = Math.max(1, Math.abs(destination - current));
        const maxVelocity = clamp(distanceTotal * 2.05, 560, 1650);
        let sceneStateSwapped = false;

        const finish = () => {
          if (transitionId !== transitionSerial) return;
          if (!sceneStateSwapped) setActiveScene(targetScene);
          window.scrollTo(0, destination);
          scrollFrame = 0;
          root.style.scrollBehavior = previousScrollBehavior;
          page.dataset.transitionDirection = "idle";
          page.style.setProperty("--game-cut-shift", targetScene > previousScene ? "120%" : "-120%");
        };

        const step = (timestamp) => {
          if (transitionId !== transitionSerial) return;
          const deltaTime = clamp((timestamp - lastTimestamp) / 1000, 0.008, 0.034);
          lastTimestamp = timestamp;
          const distance = destination - current;
          const acceleration = distance * 24 - velocity * 9.4;
          velocity = clamp(velocity + acceleration * deltaTime, -maxVelocity, maxVelocity);
          current += velocity * deltaTime;
          window.scrollTo(0, current);
          const progress = clamp(1 - Math.abs(destination - current) / distanceTotal, 0, 1);
          page.style.setProperty("--game-scene-progress", String(progress));
          const cutProgress = targetScene > previousScene ? -120 + progress * 240 : 120 - progress * 240;
          page.style.setProperty("--game-cut-shift", `${cutProgress.toFixed(2)}%`);
          if (!sceneStateSwapped && progress >= 0.34) {
            sceneStateSwapped = true;
            setActiveScene(targetScene);
          }
          if (Math.abs(distance) < 0.35 && Math.abs(velocity) < 8) {
            finish();
            return;
          }
          scrollFrame = window.requestAnimationFrame(step);
        };

        scrollFrame = window.requestAnimationFrame(step);
        return true;
      };

      const resetWheelGesture = () => {
        wheelAccumulator = 0;
        wheelLastTimestamp = 0;
        wheelTimer = 0;
      };

      const readWheelDirection = (delta) => {
        const timestamp = performance.now();
        if (timestamp - wheelLastTimestamp > 170) wheelAccumulator = 0;
        wheelLastTimestamp = timestamp;
        if (wheelTimer) window.clearTimeout(wheelTimer);
        wheelTimer = window.setTimeout(resetWheelGesture, 170);
        if (wheelAccumulator && Math.sign(wheelAccumulator) !== Math.sign(delta)) wheelAccumulator = 0;
        wheelAccumulator += clamp(delta, -180, 180);
        const threshold = clamp(window.innerHeight * 0.085, 56, 78);
        if (Math.abs(wheelAccumulator) < threshold) return 0;
        const direction = Math.sign(wheelAccumulator);
        wheelAccumulator = 0;
        return direction;
      };

      const normalizeWheel = (event) => {
        if (event.deltaMode === WheelEvent.DOM_DELTA_LINE) return event.deltaY * 16;
        if (event.deltaMode === WheelEvent.DOM_DELTA_PAGE) return event.deltaY * window.innerHeight;
        return event.deltaY;
      };

      if (finePointer && !reducedMotion) {
        window.addEventListener("wheel", (event) => {
          if (event.ctrlKey || event.metaKey) return;
          if (event.target instanceof Element && event.target.closest("dialog[open], [data-kisara-context-menu]")) return;
          const delta = normalizeWheel(event);
          if (!delta) return;
          event.preventDefault();
          if (scrollFrame) {
            wheelAccumulator = 0;
            return;
          }
          const direction = readWheelDirection(delta);
          if (!direction) return;
          smoothScrollToScene(activeScene + direction);
        }, { passive: false, signal });
      }

      window.addEventListener("scroll", () => {
        if (scrollFrame) return;
        const nearest = scenes.reduce((best, scene, index) => {
          if (!(scene instanceof HTMLElement)) return best;
          return Math.abs(scene.offsetTop - window.scrollY) < Math.abs(getSceneTop(best) - window.scrollY) ? index : best;
        }, activeScene);
        if (nearest !== activeScene) setActiveScene(nearest);
      }, { passive: true, signal });

      window.addEventListener("keydown", (event) => {
        if (event.ctrlKey || event.metaKey || event.altKey) return;
        if (event.target instanceof Element && event.target.closest("a, button, input, select, textarea, iframe, [contenteditable='true']")) return;
        if (["ArrowDown", "PageDown"].includes(event.key)) {
          event.preventDefault();
          smoothScrollToScene(activeScene + 1);
        }
        if (["ArrowUp", "PageUp"].includes(event.key)) {
          event.preventDefault();
          smoothScrollToScene(activeScene - 1);
        }
        if (event.key === "Home") {
          event.preventDefault();
          smoothScrollToScene(0);
        }
        if (event.key === "End") {
          event.preventDefault();
          smoothScrollToScene(scenes.length - 1);
        }
      }, { signal });

      page.querySelector("[data-game-scene-next]")?.addEventListener("click", () => smoothScrollToScene(1), { signal });
      page.querySelector("[data-game-scene-previous]")?.addEventListener("click", () => smoothScrollToScene(0), { signal });
      page.querySelectorAll("[data-game-scene-jump]").forEach((button) => {
        button.addEventListener("click", () => smoothScrollToScene(Number(button.dataset.gameSceneJump)), { signal });
      });

      heroVideo = page.querySelector("[data-game-hero-video]");
      const shakeEaster = page.querySelector("[data-game-shake-easter]");
      const shakeEasterVideo = page.querySelector("[data-game-shake-video]");
      const shakeEasterSource = shakeEasterVideo?.querySelector("source[data-src]");
      const shakeEasterClose = page.querySelector("[data-game-shake-close]");
      const shakeEasterHint = page.querySelector("[data-game-easter-hint]");
      const shakeEasterProgress = page.querySelector("[data-game-easter-progress]");
      const audioPlayer = document.querySelector("[data-kisara-audio-player]");
      const themeAudio = audioPlayer?.querySelector("[data-kisara-theme-audio]");

      const isDarekareScramblePlaying = () => (
        audioPlayer instanceof HTMLElement
        && audioPlayer.dataset.secretVariant === "scramble"
        && themeAudio instanceof HTMLAudioElement
        && !themeAudio.paused
        && !themeAudio.ended
      );

      const isGameShakeSequenceActive = () => (
        gameShakeEasterArming
        || (shakeEaster instanceof HTMLElement && shakeEaster.dataset.state !== "idle")
      );

      const canChargeGameShakeEaster = () => (
        activeScene === 0
        && gameShakeEasterViewport.matches
        && !gameShakeAfterglow
        && !isGameShakeSequenceActive()
        && !isDarekareScramblePlaying()
      );

      const setShakeEasterScrollLock = (locked) => {
        if (locked === shakeEasterScrollLocked) return;
        shakeEasterScrollLocked = locked;
        if (locked) {
          shakeEasterPreviousOverflow = document.documentElement.style.overflow;
          document.documentElement.style.overflow = "hidden";
        } else {
          document.documentElement.style.overflow = shakeEasterPreviousOverflow;
          shakeEasterPreviousOverflow = "";
        }
      };

      releaseGameShakeEaster = (immediate = false) => {
        gameShakeEasterAttempt += 1;
        gameShakeEasterArming = false;
        window.clearTimeout(shakeEasterExitTimer);
        shakeEasterExitTimer = 0;
        if (shakeEasterVideo instanceof HTMLVideoElement) shakeEasterVideo.pause();
        if (!(shakeEaster instanceof HTMLElement)) {
          setShakeEasterScrollLock(false);
          return;
        }
        const finish = () => {
          shakeEaster.dataset.state = "idle";
          shakeEaster.setAttribute("aria-hidden", "true");
          delete page.dataset.easterState;
          resetGameShakePressure();
          setShakeEasterScrollLock(false);
        };
        if (immediate || shakeEaster.dataset.state === "idle") {
          finish();
          return;
        }
        shakeEaster.dataset.state = "leaving";
        shakeEasterExitTimer = window.setTimeout(finish, 720);
      };

      const preloadGameShakeEaster = () => {
        if (shakeEasterPreloaded) return;
        shakeEasterPreloaded = true;
        if (shakeEasterVideo instanceof HTMLVideoElement) {
          if (shakeEasterSource instanceof HTMLSourceElement && !shakeEasterSource.hasAttribute("src")) {
            shakeEasterSource.src = shakeEasterSource.dataset.src || "";
          }
          shakeEasterVideo.preload = "auto";
          shakeEasterVideo.load();
        }
      };

      const scheduleGameShakeWarmup = () => {
        if (!canAutomaticallyWarmMedia || reducedMotion || !gameShakeEasterViewport.matches) return;
        const warm = () => {
          shakeEasterWarmupIdle = 0;
          shakeEasterWarmupTimer = 0;
          if (signal.aborted) return;
          preloadGameShakeEaster();
        };
        if (window.requestIdleCallback) {
          shakeEasterWarmupIdle = window.requestIdleCallback(warm, { timeout: 5200 });
        } else {
          shakeEasterWarmupTimer = window.setTimeout(warm, 3200);
        }
      };

      const waitForGameShakeFrame = (video) => {
        if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) return Promise.resolve();
        return new Promise((resolve, reject) => {
          let settled = false;
          let timeout = 0;
          const finish = (error) => {
            if (settled) return;
            settled = true;
            if (timeout) window.clearTimeout(timeout);
            video.removeEventListener("loadeddata", ready);
            video.removeEventListener("canplay", ready);
            video.removeEventListener("error", failed);
            signal.removeEventListener("abort", aborted);
            if (error) reject(error);
            else resolve();
          };
          const ready = () => finish();
          const failed = () => finish(new Error("Game shake media failed to load"));
          const aborted = () => finish(new Error("Game shake media aborted"));
          video.addEventListener("loadeddata", ready, { once: true });
          video.addEventListener("canplay", ready, { once: true });
          video.addEventListener("error", failed, { once: true });
          signal.addEventListener("abort", aborted, { once: true });
          timeout = window.setTimeout(failed, 7200);
        });
      };

      const startGameShakeEasterVideo = async (attempt) => {
        if (!(shakeEasterVideo instanceof HTMLVideoElement)) return;
        for (let retry = 0; retry < 2; retry += 1) {
          try {
            preloadGameShakeEaster();
            await waitForGameShakeFrame(shakeEasterVideo);
            if (signal.aborted || attempt !== gameShakeEasterAttempt || !gameShakeEasterArming) return;
            try { shakeEasterVideo.currentTime = 0; } catch {}
            shakeEasterVideo.muted = true;
            await shakeEasterVideo.play();
            if (signal.aborted || attempt !== gameShakeEasterAttempt || !gameShakeEasterArming) return;
            gameShakeEasterArming = false;
            window.__yuimiKisaraEasterLedger?.mark("game-shake");
            page.dataset.easterState = "playing";
            shakeEaster.dataset.state = "playing";
            window.dispatchEvent(new CustomEvent("yuimi:kisara-secret-audio", {
              detail: {
                trackId: "darekare-scramble",
                autoplay: true
              }
            }));
            return;
          } catch {
            if (signal.aborted || attempt !== gameShakeEasterAttempt || !gameShakeEasterArming) return;
            if (retry === 0) {
              try { shakeEasterVideo.currentTime = 0; } catch {}
              shakeEasterVideo.load();
              continue;
            }
          }
        }
        if (attempt !== gameShakeEasterAttempt) return;
        gameShakeEasterArming = false;
        releaseGameShakeEaster();
      };

      const triggerGameShakeEaster = () => {
        if (
          !canChargeGameShakeEaster()
          || !(shakeEaster instanceof HTMLElement)
        ) return;
        gameShakeEasterArming = true;
        const attempt = ++gameShakeEasterAttempt;
        heroPressureMs = GAME_SHAKE_HOLD_DURATION;
        heroShakeTravel = GAME_SHAKE_TRAVEL_TARGET;
        heroShakeLatched = true;
        heroPressureStage = 4;
        if (hero instanceof HTMLElement) {
          hero.dataset.easterPressure = "4";
          hero.style.setProperty("--game-easter-charge", "1");
          hero.style.setProperty("--game-easter-shake", "1");
        }
        page.dataset.easterState = "arming";
        shakeEaster.dataset.state = "arming";
        shakeEaster.setAttribute("aria-hidden", "false");
        setShakeEasterScrollLock(true);
        if (!(shakeEasterVideo instanceof HTMLVideoElement)) {
          gameShakeEasterArming = false;
          releaseGameShakeEaster(true);
          return;
        }
        void startGameShakeEasterVideo(attempt);
      };

      resetGameShakePressure = () => {
        const keepAfterglow = gameShakeAfterglow;
        heroPressureMs = 0;
        heroPressureLastFrame = 0;
        heroPressureStage = 0;
        heroLastMotionAt = 0;
        heroShakeTravel = 0;
        heroShakeLatched = false;
        if (hero instanceof HTMLElement) {
          hero.dataset.easterPressure = keepAfterglow ? "afterglow" : "0";
          hero.style.setProperty("--game-easter-charge", "0");
          hero.style.setProperty("--game-easter-shake", keepAfterglow ? "1" : "0");
          if (keepAfterglow) hero.style.setProperty("--game-input-energy", "1");
        }
        if (shakeEasterProgress) shakeEasterProgress.textContent = "5.0";
        if (shakeEasterHint) shakeEasterHint.textContent = "SHAKE THE MESSAGE APART";
      };

      const updateGameShakePressure = (timestamp) => {
        if (
          !canChargeGameShakeEaster()
          || !(hero instanceof HTMLElement)
        ) return;
        const delta = heroPressureLastFrame > 0 ? clamp(timestamp - heroPressureLastFrame, 0, 34) : 0;
        heroPressureLastFrame = timestamp;
        const idleFor = heroLastMotionAt > 0 ? timestamp - heroLastMotionAt : Number.POSITIVE_INFINITY;

        if (!heroShakeLatched) {
          if (idleFor > 150) heroShakeTravel = Math.max(0, heroShakeTravel - delta * 0.68);
          if (heroShakeTravel >= GAME_SHAKE_TRAVEL_TARGET) {
            heroShakeTravel = GAME_SHAKE_TRAVEL_TARGET;
            heroShakeLatched = true;
            heroPressureMs = 0;
          }
        } else if (idleFor <= 260) {
          heroPressureMs = Math.min(GAME_SHAKE_HOLD_DURATION, heroPressureMs + delta);
        } else if (idleFor > 680) {
          heroShakeLatched = false;
          heroPressureMs = 0;
          heroShakeTravel = GAME_SHAKE_TRAVEL_TARGET * 0.18;
        }

        const shakeIntensity = clamp(heroShakeTravel / GAME_SHAKE_TRAVEL_TARGET, 0, 1);
        const holdProgress = clamp(heroPressureMs / GAME_SHAKE_HOLD_DURATION, 0, 1);
        const visualCharge = heroShakeLatched
          ? 0.22 + holdProgress * 0.78
          : Math.pow(shakeIntensity, 2) * 0.14;
        const visualShake = heroShakeLatched
          ? 0.08 + Math.pow(holdProgress, 1.12) * 0.92
          : Math.pow(shakeIntensity, 2) * 0.06;
        const stage = !heroShakeLatched
          ? 0
          : holdProgress >= 0.72
            ? 3
            : holdProgress >= 0.34
              ? 2
              : 1;
        hero.style.setProperty("--game-easter-charge", visualCharge.toFixed(4));
        hero.style.setProperty("--game-easter-shake", visualShake.toFixed(4));
        if (stage !== heroPressureStage) {
          heroPressureStage = stage;
          hero.dataset.easterPressure = String(stage);
        }
        if (shakeEasterProgress) {
          const remainingSeconds = Math.max(0, (GAME_SHAKE_HOLD_DURATION - heroPressureMs) / 1000);
          shakeEasterProgress.textContent = remainingSeconds.toFixed(1);
        }
        if (shakeEasterHint) {
          shakeEasterHint.textContent = stage >= 3
            ? "THE SIGNAL IS LOOKING BACK"
            : stage === 2
              ? "DO NOT LET THE MESSAGE SETTLE"
              : stage === 1
                ? "LIMIT LOCKED / KEEP MOVING"
                : shakeIntensity >= 0.58
                  ? "ALMOST UNSTABLE / SHAKE HARDER"
                  : "SHAKE THE MESSAGE APART";
        }
        if (shakeIntensity >= 0.52) preloadGameShakeEaster();
        if (heroPressureMs >= GAME_SHAKE_HOLD_DURATION) triggerGameShakeEaster();
      };

      if (shakeEasterVideo instanceof HTMLVideoElement) {
        shakeEasterVideo.addEventListener("playing", () => {
          if (shakeEaster instanceof HTMLElement) shakeEaster.dataset.state = "playing";
        }, { signal });
        shakeEasterVideo.addEventListener("ended", () => {
          if (!(shakeEaster instanceof HTMLElement)) return;
          gameShakeAfterglow = true;
          shakeEaster.dataset.state = "ending";
          shakeEasterExitTimer = window.setTimeout(() => releaseGameShakeEaster(), 1050);
        }, { signal });
        shakeEasterVideo.addEventListener("error", () => {
          if (!gameShakeEasterArming) releaseGameShakeEaster();
        }, { signal });
      }
      if (themeAudio instanceof HTMLAudioElement) {
        themeAudio.addEventListener("playing", () => {
          if (isDarekareScramblePlaying() && !isGameShakeSequenceActive()) resetGameShakePressure();
        }, { signal });
      }
      shakeEasterClose?.addEventListener("click", () => releaseGameShakeEaster(), { signal });
      gameShakeEasterViewport.addEventListener("change", () => {
        if (gameShakeEasterViewport.matches) return;
        if (shakeEaster instanceof HTMLElement && shakeEaster.dataset.state !== "idle") releaseGameShakeEaster(true);
        else resetGameShakePressure();
      }, { signal });
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && shakeEaster instanceof HTMLElement && shakeEaster.dataset.state !== "idle") {
          event.preventDefault();
          releaseGameShakeEaster();
        }
      }, { signal });

      const markHeroReady = () => {
        if (heroReady) return;
        heroReady = true;
        page.dataset.mediaState = "ready";
        if (!(hero instanceof HTMLElement)) return;
        hero.dataset.introState = reducedMotion ? "complete" : "playing";
        void playMessageField();
        scheduleGameShakeWarmup();
      };
      if (heroVideo instanceof HTMLVideoElement) {
        heroVideo.muted = true;
        try { heroVideo.currentTime = 0; } catch {}
        heroVideo.addEventListener("play", () => {
          if (hero instanceof HTMLElement) hero.dataset.videoState = "playing";
        }, { once: true, signal });
        heroVideo.addEventListener("ended", () => {
          if (hero instanceof HTMLElement) hero.dataset.videoState = "ended";
        }, { once: true, signal });
        if (heroVideo.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) markHeroReady();
        else {
          heroVideo.addEventListener("loadeddata", markHeroReady, { once: true, signal });
          heroVideo.addEventListener("canplay", markHeroReady, { once: true, signal });
          heroVideo.addEventListener("error", markHeroReady, { once: true, signal });
        }
        void heroVideo.play().catch(() => undefined);
      } else {
        markHeroReady();
      }

      if (arcade instanceof HTMLElement && finePointer && !reducedMotion) {
        const renderPointer = () => {
          pointerFrame = 0;
          renderedPointerX += (pointerX - renderedPointerX) * 0.13;
          renderedPointerY += (pointerY - renderedPointerY) * 0.13;
          arcade.style.setProperty("--arcade-pointer-x", `${(renderedPointerX * 10).toFixed(2)}px`);
          arcade.style.setProperty("--arcade-pointer-y", `${(renderedPointerY * 7).toFixed(2)}px`);
          if (Math.abs(pointerX - renderedPointerX) > 0.002 || Math.abs(pointerY - renderedPointerY) > 0.002) {
            pointerFrame = window.requestAnimationFrame(renderPointer);
          }
        };
        const schedulePointer = () => {
          if (!pointerFrame) pointerFrame = window.requestAnimationFrame(renderPointer);
        };
        arcade.addEventListener("pointermove", (event) => {
          const rect = arcade.getBoundingClientRect();
          pointerX = clamp(((event.clientX - rect.left) / rect.width - 0.5) * 2, -1, 1);
          pointerY = clamp(((event.clientY - rect.top) / rect.height - 0.5) * 2, -1, 1);
          schedulePointer();
        }, { signal });
        arcade.addEventListener("pointerleave", () => {
          pointerX = 0;
          pointerY = 0;
          schedulePointer();
        }, { signal });
      }

      if (hero instanceof HTMLElement && finePointer && !reducedMotion) {
        const speedOutput = hero.querySelector("[data-game-input-speed]");
        const renderHeroPointer = (timestamp) => {
          heroPointerFrame = 0;
          renderedHeroPointerX += (heroPointerX - renderedHeroPointerX) * 0.14;
          renderedHeroPointerY += (heroPointerY - renderedHeroPointerY) * 0.14;
          heroInputEnergy += (heroInputTarget - heroInputEnergy) * 0.34;
          heroInputTarget *= 0.95;
          updateGameShakePressure(timestamp);
          const travelEnergy = clamp(heroShakeTravel / GAME_SHAKE_TRAVEL_TARGET, 0, 1);
          const displayedInputEnergy = gameShakeAfterglow
            ? 1
            : heroShakeLatched
              ? 1
              : Math.max(heroInputEnergy, travelEnergy * 0.76);
          hero.style.setProperty("--game-hero-pointer-x", `${renderedHeroPointerX.toFixed(2)}px`);
          hero.style.setProperty("--game-hero-pointer-y", `${renderedHeroPointerY.toFixed(2)}px`);
          hero.style.setProperty("--game-input-energy", displayedInputEnergy.toFixed(3));
          if (speedOutput) speedOutput.textContent = String(Math.round(displayedInputEnergy * 99)).padStart(2, "0");
          if (
            Math.abs(heroPointerX - renderedHeroPointerX) > 0.04
            || Math.abs(heroPointerY - renderedHeroPointerY) > 0.04
            || heroInputEnergy > 0.008
            || heroInputTarget > 0.008
            || heroPressureMs > 0
            || heroShakeTravel > 0
            || heroShakeLatched
          ) {
            heroPointerFrame = window.requestAnimationFrame(renderHeroPointer);
          }
        };
        const scheduleHeroPointer = () => {
          if (!heroPointerFrame) heroPointerFrame = window.requestAnimationFrame(renderHeroPointer);
        };
        hero.addEventListener("pointermove", (event) => {
          if (!gameShakeEasterViewport.matches) {
            heroLastPointerAt = 0;
            heroInputTarget = 0;
            resetGameShakePressure();
            return;
          }
          const rect = hero.getBoundingClientRect();
          const now = event.timeStamp || performance.now();
          if (heroLastPointerAt > 0) {
            const elapsed = Math.max(8, now - heroLastPointerAt);
            const distance = Math.hypot(event.clientX - heroLastPointerX, event.clientY - heroLastPointerY);
            const velocityEnergy = clamp(distance / elapsed / 0.54, 0, 1);
            const travelEnergy = clamp(distance / 18, 0, 1);
            const motionEnergy = Math.max(velocityEnergy, travelEnergy * 0.94);
            heroInputTarget = Math.max(heroInputTarget, motionEnergy);
            if (distance >= 1.5) {
              heroLastMotionAt = performance.now();
              if (canChargeGameShakeEaster() && !heroShakeLatched) {
                heroShakeTravel = Math.min(
                  GAME_SHAKE_TRAVEL_TARGET,
                  heroShakeTravel + Math.min(distance, 54) * (0.72 + motionEnergy * 0.46)
                );
              }
            }
          }
          heroLastPointerX = event.clientX;
          heroLastPointerY = event.clientY;
          heroLastPointerAt = now;
          heroPointerX = clamp(((event.clientX - rect.left) / rect.width - 0.5) * 4.4, -2.2, 2.2);
          heroPointerY = clamp(((event.clientY - rect.top) / rect.height - 0.5) * 3.2, -1.6, 1.6);
          scheduleHeroPointer();
        }, { signal });
        hero.addEventListener("pointerleave", () => {
          heroPointerX = 0;
          heroPointerY = 0;
          heroInputTarget = 0;
          heroLastPointerAt = 0;
          scheduleHeroPointer();
        }, { signal });
      }

      if (!(arcade instanceof HTMLElement)) return;
      const selectors = Array.from(arcade.querySelectorAll("[data-game-select]"));
      const panels = Array.from(arcade.querySelectorAll("[data-game-panel]"));
      const counter = arcade.querySelector("[data-game-counter]");
      const status = arcade.querySelector("[data-game-status]");
      const machineTitle = arcade.querySelector("[data-game-machine-title]");
      const screen = arcade.querySelector("[data-game-screen]");
      const loader = arcade.querySelector("[data-game-loader]");
      const launch = arcade.querySelector("[data-game-launch]");
      const launchLabel = arcade.querySelector("[data-game-launch-label]");
      const launchNote = arcade.querySelector("[data-game-launch-note]");
      const eject = arcade.querySelector("[data-game-eject]");
      const external = arcade.querySelector("[data-game-external]");
      gameFrame = arcade.querySelector("[data-game-frame]");
      let activeGame = 0;

      const setLaunchCopy = (label, note) => {
        if (launchLabel) launchLabel.textContent = label;
        if (launchNote) launchNote.textContent = note;
      };

      const unloadGame = () => {
        if (gameFrame instanceof HTMLIFrameElement) {
          gameFrame.src = "about:blank";
          gameFrame.removeAttribute("src");
          gameFrame.hidden = true;
        }
        if (loader instanceof HTMLElement) loader.hidden = true;
        if (screen instanceof HTMLElement) screen.dataset.screenState = "idle";
        if (launch instanceof HTMLButtonElement) launch.disabled = false;
        if (eject instanceof HTMLButtonElement) eject.hidden = true;
        setLaunchCopy("START", "LOAD GAME");
      };

      const loadActiveGame = () => {
        const selector = selectors[activeGame];
        if (!(selector instanceof HTMLElement) || !(gameFrame instanceof HTMLIFrameElement)) return;
        const src = selector.dataset.gameSrc;
        const name = selector.dataset.gameName ?? "GAME";
        if (!src) return;
        if (screen instanceof HTMLElement) screen.dataset.screenState = "loading";
        if (loader instanceof HTMLElement) loader.hidden = false;
        if (launch instanceof HTMLButtonElement) launch.disabled = true;
        if (eject instanceof HTMLButtonElement) eject.hidden = true;
        setLaunchCopy("CONNECTING", "PLEASE WAIT");
        gameFrame.title = `${name} 游戏画面`;
        gameFrame.hidden = false;
        gameFrame.src = src;
      };

      const activateGame = (nextIndex) => {
        const total = selectors.length;
        activeGame = (nextIndex + total) % total;
        const selector = selectors[activeGame];
        if (!(selector instanceof HTMLElement)) return;
        const id = selector.dataset.gameSelect ?? "2048";
        unloadGame();
        arcade.dataset.activeGame = id;
        arcade.classList.remove("is-switching");
        void arcade.offsetWidth;
        arcade.classList.add("is-switching");
        selectors.forEach((item, index) => {
          const selected = index === activeGame;
          item.setAttribute("aria-pressed", String(selected));
          item.setAttribute("aria-selected", String(selected));
          item.setAttribute("tabindex", selected ? "0" : "-1");
        });
        panels.forEach((panel) => {
          if (panel instanceof HTMLElement) panel.hidden = panel.dataset.gamePanel !== id;
        });
        if (counter) counter.textContent = `${String(activeGame + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
        if (status) status.textContent = selector.dataset.gameStatus ?? "CHANNEL READY";
        if (machineTitle) machineTitle.textContent = selector.dataset.gameName ?? id;
        if (external instanceof HTMLAnchorElement) external.href = selector.dataset.gameExternalSrc ?? selector.dataset.gameSrc ?? "#";
      };

      selectors.forEach((selector, index) => selector.addEventListener("click", () => activateGame(index), { signal }));
      arcade.querySelector("[data-game-previous]")?.addEventListener("click", () => activateGame(activeGame - 1), { signal });
      arcade.querySelector("[data-game-next]")?.addEventListener("click", () => activateGame(activeGame + 1), { signal });
      launch?.addEventListener("click", loadActiveGame, { signal });
      eject?.addEventListener("click", unloadGame, { signal });
      gameFrame?.addEventListener("load", () => {
        if (!(gameFrame instanceof HTMLIFrameElement) || !gameFrame.hasAttribute("src")) return;
        if (screen instanceof HTMLElement) screen.dataset.screenState = "loaded";
        if (loader instanceof HTMLElement) loader.hidden = true;
        if (launch instanceof HTMLButtonElement) launch.disabled = false;
        if (eject instanceof HTMLButtonElement) eject.hidden = false;
        setLaunchCopy("RESTART", "RELOAD GAME");
      }, { signal });

      const initialScene = window.location.hash === "#kisara-arcade-console" ? 1 : 0;
      setActiveScene(initialScene);
      window.scrollTo(0, getSceneTop(initialScene));
      window.requestAnimationFrame(() => window.scrollTo(0, getSceneTop(initialScene)));
    })();
  </script>
</KisaraLayout>
