---
import KisaraLayout from "../layouts/KisaraLayout.astro";
import { gamePicks } from "@/core/data/games";
---

<KisaraLayout title="Games | Kisara" description="Yuimi Lab 的小游戏收藏。">
  <section class="kisara-page-lead">
    <p class="kisara-section-index">PLAY CHANNEL</p>
    <h1>Games</h1>
    <p>短暂离开记录区，切进一局刚刚好的小游戏。</p>
  </section>
  <div class="kisara-record-list">
    {gamePicks.map((game, index) => (
      <article>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <div><small>{game.vibe}</small><h2>{game.name}</h2><p>{game.summary}</p><a class="kisara-text-link" href={game.play} target="_blank" rel="noreferrer">START ↗</a></div>
      </article>
    ))}
  </div>
</KisaraLayout>
