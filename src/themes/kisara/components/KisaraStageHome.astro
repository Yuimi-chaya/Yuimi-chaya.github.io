---
import { Icon } from "astro-icon/components";

const base = "/themes/kisara/assets/home-stage/chapters";
const legacyBase = "/themes/kisara/assets";
const chapters = [
  { id: "rescue", label: "RESCUE", title: "阻断" },
  { id: "request", label: "REQUEST", title: "请求" },
  { id: "counterattack", label: "COUNTER", title: "反击" },
  { id: "contract", label: "CONTRACT", title: "契约" },
  { id: "transformation", label: "AWAKEN", title: "变身" },
  { id: "jealousy", label: "JEALOUSY", title: "妒火" }
] as const;

const manifest = chapters.map((chapter, index) => ({ ...chapter, index }));
---

<section
  class="kisara-stage-home"
  data-kisara-stage-home
  data-stage-engine="keyframe-owner"
  data-active-chapter="rescue"
  data-stage-state="booting"
  aria-label="Kisara 第一集章节演出"
>
  <script type="application/json" data-kisara-stage-manifest set:html={JSON.stringify(manifest)}></script>

  <div class="kisara-stage-viewport">
    <article
      class="kisara-home-chapter kisara-home-rescue"
      data-home-chapter="rescue"
      data-chapter-position="active"
      data-scene-action="idle"
      data-rescue-bridge-state="hidden"
      aria-hidden="false"
    >
      <figure class="kisara-chapter-layer kisara-scene-base" data-stage-layer="rescue-base" data-frame-state="hold">
        <img data-layer-hold src={`${base}/rescue-eye-last.webp`} alt="" fetchpriority="high" />
      </figure>
      <figure class="kisara-chapter-layer kisara-scene-action" data-stage-layer="rescue-action" data-frame-state="first">
        <img data-layer-first data-src={`${base}/rescue-action-first.webp`} alt="" />
        <video data-layer-video data-src={`${base}/rescue-action.mp4`} muted playsinline preload="none"></video>
        <img data-layer-hold data-src={`${base}/rescue-action-last.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-rescue-bridge kisara-rescue-severed" data-stage-layer="rescue-severed" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/rescue-severed.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-rescue-bridge kisara-rescue-back" data-stage-layer="rescue-back" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/rescue-slash-last.webp`} alt="" />
      </figure>
      <span class="kisara-chapter-grade" aria-hidden="true"></span>
      <div class="kisara-home-copy kisara-home-copy-rescue" data-home-copy>
        <span class="kisara-home-copy-kicker">YUIMI LAB / OPENING</span>
        <h1>把喜欢的东西，做成能被看见的样子。</h1>
        <p>这是一个把博客、作品、游戏和一点私人偏好编进同一场演出的个人站。</p>
      </div>
    </article>

    <article
      class="kisara-home-chapter kisara-home-request"
      data-home-chapter="request"
      data-chapter-position="after"
      data-scene-action="idle"
      aria-hidden="true"
      inert
    >
      <figure class="kisara-chapter-layer kisara-scene-base kisara-request-face" data-stage-layer="request-face" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/request-face.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-request-comic" data-stage-layer="request-emerged" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/request-emerged.webp`} alt="" />
      </figure>
      <span class="kisara-request-doodles" aria-hidden="true"><i></i><b></b><em></em></span>
      <span class="kisara-chapter-grade" aria-hidden="true"></span>
      <div class="kisara-home-copy kisara-home-copy-request" data-home-copy>
        <span class="kisara-home-copy-kicker">BLOG / NOTES FROM THE WORKBENCH</span>
        <h2>想法先落下来。</h2>
        <p>开发笔记、部署折腾，也记一点不太正经的感想。</p>
        <a href="/blog/">进入文章档案 <span aria-hidden="true">↗</span></a>
      </div>
    </article>

    <article
      class="kisara-home-chapter kisara-home-counterattack"
      data-home-chapter="counterattack"
      data-chapter-position="after"
      data-scene-action="idle"
      aria-hidden="true"
      inert
    >
      <figure class="kisara-chapter-layer kisara-scene-base" data-stage-layer="counter-base" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/counter-roll-last.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-scene-action" data-stage-layer="counter-action" data-frame-state="first">
        <img data-layer-first data-src={`${base}/counter-action-first.webp`} alt="" />
        <video data-layer-video data-src={`${base}/counter-action.mp4`} muted playsinline preload="none"></video>
        <img data-layer-hold data-src={`${base}/counter-roll-last.webp`} alt="" />
      </figure>
      <span class="kisara-chapter-grade" aria-hidden="true"></span>
      <div class="kisara-home-copy kisara-home-copy-counter" data-home-copy>
        <span class="kisara-home-copy-kicker">WORKS / THINGS THAT MOVE</span>
        <h2>然后让它跑起来。</h2>
        <p>Astro、AstrBot、UE5，还有一堆做着做着就长出新枝的实验。</p>
        <a href="/works/">查看工作台 <span aria-hidden="true">↗</span></a>
      </div>
    </article>

    <article
      class="kisara-home-chapter kisara-home-contract"
      data-home-chapter="contract"
      data-chapter-position="after"
      data-scene-action="idle"
      aria-hidden="true"
      inert
    >
      <figure class="kisara-chapter-layer kisara-scene-base kisara-contract-final" data-stage-layer="contract-base" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/contract-kiss-03.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-contract-cut kisara-contract-embrace" data-stage-layer="contract-embrace" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/contract-embrace.webp`} alt="" />
      </figure>
      <span class="kisara-chapter-grade" aria-hidden="true"></span>
      <div class="kisara-home-copy kisara-home-copy-contract" data-home-copy>
        <span class="kisara-home-copy-kicker">ME / PRIVATE CONTRACT</span>
        <h2>契约写的是我。</h2>
        <p>技术、动画、XP、游戏，以及最近仍在做的东西。</p>
        <a href="/me/">打开个人档案 <span aria-hidden="true">↗</span></a>
      </div>
    </article>

    <article
      class="kisara-home-chapter kisara-home-transformation"
      data-home-chapter="transformation"
      data-chapter-position="after"
      data-scene-action="idle"
      aria-hidden="true"
      inert
    >
      <figure class="kisara-chapter-layer kisara-scene-base kisara-transform-final" data-stage-layer="transform-base" data-frame-state="hold">
        <img data-layer-hold data-src={`${legacyBase}/fight.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-transform-cut kisara-transform-explosion" data-stage-layer="transform-explosion" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/transformation-explosion.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-transform-cut kisara-transform-detail" data-stage-layer="transform-detail" data-frame-state="hold">
        <img data-layer-hold data-src={`${legacyBase}/transformation-detail.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-transform-cut kisara-transform-silhouette" data-stage-layer="transform-silhouette" data-frame-state="hold">
        <img data-layer-hold data-src={`${legacyBase}/transformation-silhouette.webp`} alt="" />
      </figure>
      <span class="kisara-chapter-grade" aria-hidden="true"></span>
      <div class="kisara-home-copy kisara-home-copy-transform" data-home-copy>
        <span class="kisara-home-copy-kicker">GAMES / TOUCH THE SCENE</span>
        <h2>别只站着看。</h2>
        <p>街机、互动和彩蛋，等你把下一步按出来。</p>
        <a href="/games/">进入游戏场 <span aria-hidden="true">↗</span></a>
      </div>
    </article>

    <article
      class="kisara-home-chapter kisara-home-jealousy"
      data-home-chapter="jealousy"
      data-chapter-position="after"
      data-scene-action="idle"
      data-jealousy-panel-state="hidden"
      aria-hidden="true"
      inert
    >
      <figure class="kisara-chapter-layer kisara-scene-base" data-stage-layer="jealousy-base" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/jealousy-action-hold.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-scene-action" data-stage-layer="jealousy-action" data-frame-state="first">
        <img data-layer-first data-src={`${base}/jealousy-action-first.webp`} alt="" />
        <video data-layer-video data-src={`${base}/jealousy-action.mp4`} muted playsinline preload="none"></video>
        <img data-layer-hold data-src={`${base}/jealousy-action-last.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-jealousy-panel" data-stage-layer="jealousy-blackface" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/jealousy-blackface-last.webp`} alt="" />
      </figure>
      <span class="kisara-chapter-grade" aria-hidden="true"></span>
      <div class="kisara-home-copy kisara-home-copy-jealousy" data-home-copy>
        <span class="kisara-home-copy-kicker">END OF THE OPENING</span>
        <p>有些东西，最好不要让她看见。</p>
      </div>
    </article>
  </div>

  <nav class="kisara-home-chapter-rail" aria-label="首页演出章节">
    {chapters.map((chapter, index) => (
      <button
        type="button"
        data-home-chapter-target={chapter.id}
        aria-label={`切换到${chapter.title}`}
        aria-current={index === 0 ? "step" : undefined}
      >
        <i aria-hidden="true"></i>
        <span>{chapter.label}</span>
      </button>
    ))}
  </nav>

  <button class="kisara-home-replay" type="button" data-home-replay aria-label="重新播放首页演出" title="重新播放">
    <Icon name="tabler:refresh" aria-hidden="true" />
  </button>
  <p class="sr-only" data-stage-status aria-live="polite"></p>
</section>

<script>
  import { initKisaraStageHomeLifecycle } from "../runtime/stageHome";

  initKisaraStageHomeLifecycle();
</script>
