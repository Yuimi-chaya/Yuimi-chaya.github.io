---
import { Icon } from "astro-icon/components";

const base = "/themes/kisara/assets/home-stage/chapters";
const legacyBase = "/themes/kisara/assets";
const chapters = [
  { id: "rescue", label: "RESCUE", title: "阻断" },
  { id: "request", label: "REQUEST", title: "请求" },
  { id: "counterattack", label: "COUNTER", title: "反击" },
  { id: "contract", label: "CONTRACT", title: "契约" },
  { id: "transformation", label: "AWAKEN", title: "变身" },
  { id: "jealousy", label: "JEALOUSY", title: "妒火" }
] as const;

const manifest = chapters.map((chapter, index) => ({
  ...chapter,
  index
}));
---

<section
  class="kisara-stage-home"
  data-kisara-stage-home
  data-stage-engine="chapter-owner"
  data-active-chapter="rescue"
  data-stage-state="booting"
  aria-label="Kisara 第一集章节演出"
>
  <script type="application/json" data-kisara-stage-manifest set:html={JSON.stringify(manifest)}></script>

  <div class="kisara-stage-viewport">
    <article
      class="kisara-home-chapter kisara-home-rescue"
      data-home-chapter="rescue"
      data-chapter-position="active"
      data-rescue-beat="entry"
      aria-hidden="false"
    >
      <figure class="kisara-chapter-layer" data-stage-layer="rescue-eye" data-frame-state="first">
        <img data-layer-first src={`${base}/rescue-eye-first.webp`} alt="" fetchpriority="high" />
        <video data-layer-video data-src={`${base}/rescue-eye.mp4`} muted playsinline preload="none"></video>
        <img data-layer-hold data-src={`${base}/rescue-eye-last.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-still-shot kisara-rescue-severed" data-stage-layer="rescue-severed" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/rescue-severed.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-still-shot kisara-rescue-back" data-stage-layer="rescue-back" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/rescue-slash-last.webp`} alt="" />
      </figure>
      <i class="kisara-rescue-cutline" aria-hidden="true"></i>
      <span class="kisara-chapter-grade" aria-hidden="true"></span>
    </article>

    <article
      class="kisara-home-chapter kisara-home-request"
      data-home-chapter="request"
      data-chapter-position="after"
      data-request-beat="entry"
      aria-hidden="true"
      inert
    >
      <figure class="kisara-chapter-layer kisara-still-shot kisara-request-face" data-stage-layer="request-face" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/request-face.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-still-shot kisara-request-comic" data-stage-layer="request-emerged" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/request-emerged.webp`} alt="" />
      </figure>
      <span class="kisara-request-doodles" aria-hidden="true"><i></i><b></b><em></em></span>
      <span class="kisara-chapter-grade" aria-hidden="true"></span>
    </article>

    <article
      class="kisara-home-chapter kisara-home-counterattack"
      data-home-chapter="counterattack"
      data-chapter-position="after"
      data-counter-beat="entry"
      aria-hidden="true"
      inert
    >
      <figure class="kisara-chapter-layer" data-stage-layer="counter-entry" data-frame-state="first">
        <img data-layer-first data-src={`${base}/counter-entry-first.webp`} alt="" />
        <video data-layer-video data-src={`${base}/counter-entry.mp4`} muted playsinline preload="none"></video>
        <img data-layer-hold data-src={`${base}/counter-entry-last.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-counter-scrub" data-stage-layer="counter-run" data-frame-state="first">
        <img data-layer-first data-src={`${base}/counter-run-first.webp`} alt="" />
        <video data-layer-video data-src={`${base}/counter-run-scrub.mp4`} muted playsinline preload="none"></video>
        <img data-layer-hold data-src={`${base}/counter-run-last.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-counter-montage" data-stage-layer="counter-roll" data-frame-state="first">
        <img data-layer-first data-src={`${base}/counter-roll-first.webp`} alt="" />
        <video data-layer-video data-src={`${base}/counter-roll.mp4`} muted playsinline preload="none"></video>
        <img data-layer-hold data-src={`${base}/counter-roll-last.webp`} alt="" />
      </figure>
      <span class="kisara-chapter-grade" aria-hidden="true"></span>
    </article>

    <article
      class="kisara-home-chapter kisara-home-contract"
      data-home-chapter="contract"
      data-chapter-position="after"
      data-contract-beat="entry"
      aria-hidden="true"
      inert
    >
      <figure class="kisara-chapter-layer kisara-still-shot kisara-contract-embrace" data-stage-layer="contract-embrace" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/contract-embrace.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-still-shot kisara-contract-kiss-01" data-stage-layer="contract-kiss-01" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/contract-kiss-01.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-still-shot kisara-contract-kiss-02" data-stage-layer="contract-kiss-02" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/contract-kiss-02.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-still-shot kisara-contract-kiss-03" data-stage-layer="contract-kiss-03" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/contract-kiss-03.webp`} alt="" />
      </figure>
      <span class="kisara-chapter-grade" aria-hidden="true"></span>
    </article>

    <article
      class="kisara-home-chapter kisara-home-transformation"
      data-home-chapter="transformation"
      data-chapter-position="after"
      data-transformation-beat="entry"
      aria-hidden="true"
      inert
    >
      <figure class="kisara-chapter-layer kisara-still-shot kisara-transform-explosion" data-stage-layer="transform-explosion" data-frame-state="hold">
        <img data-layer-hold data-src={`${base}/transformation-explosion.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-still-shot kisara-transform-detail" data-stage-layer="transform-detail" data-frame-state="hold">
        <img data-layer-hold data-src={`${legacyBase}/transformation-detail.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-still-shot kisara-transform-silhouette" data-stage-layer="transform-silhouette" data-frame-state="hold">
        <img data-layer-hold data-src={`${legacyBase}/transformation-silhouette.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-still-shot kisara-transform-fight" data-stage-layer="transform-fight" data-frame-state="hold">
        <img data-layer-hold data-src={`${legacyBase}/fight.webp`} alt="" />
      </figure>
      <span class="kisara-chapter-grade" aria-hidden="true"></span>
    </article>

    <article
      class="kisara-home-chapter kisara-home-jealousy"
      data-home-chapter="jealousy"
      data-chapter-position="after"
      data-jealousy-beat="entry"
      aria-hidden="true"
      inert
    >
      <figure class="kisara-chapter-layer" data-stage-layer="jealousy-slash" data-frame-state="first">
        <img data-layer-first data-src={`${base}/jealousy-setup.webp`} alt="" />
        <video data-layer-video data-src={`${base}/jealousy-slash.mp4`} muted playsinline preload="none"></video>
        <img data-layer-hold data-src={`${base}/jealousy-setup.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-jealousy-action" data-stage-layer="jealousy-action" data-frame-state="first">
        <img data-layer-first data-src={`${base}/jealousy-blackface-first.webp`} alt="" />
        <video data-layer-video data-src={`${base}/jealousy-blackface.mp4`} muted playsinline preload="none"></video>
        <img data-layer-hold data-src={`${base}/jealousy-action-hold.webp`} alt="" />
      </figure>
      <figure class="kisara-chapter-layer kisara-jealousy-split" data-stage-layer="jealousy-blackface" data-frame-state="first">
        <img data-layer-first data-src={`${base}/jealousy-blackface-first.webp`} alt="" />
        <video data-layer-video data-src={`${base}/jealousy-blackface.mp4`} muted playsinline preload="none"></video>
        <img data-layer-hold data-src={`${base}/jealousy-blackface-last.webp`} alt="" />
      </figure>
      <span class="kisara-chapter-grade" aria-hidden="true"></span>
    </article>
  </div>

  <nav class="kisara-home-chapter-rail" aria-label="首页演出章节">
    {chapters.map((chapter, index) => (
      <button
        type="button"
        data-home-chapter-target={chapter.id}
        aria-label={`切换到${chapter.title}`}
        aria-current={index === 0 ? "step" : undefined}
      >
        <i aria-hidden="true"></i>
        <span>{chapter.label}</span>
      </button>
    ))}
  </nav>

  <button class="kisara-home-replay" type="button" data-home-replay aria-label="重新播放首页演出" title="重新播放">
    <Icon name="tabler:refresh" aria-hidden="true" />
  </button>
  <p class="sr-only" data-stage-status aria-live="polite"></p>
</section>

<script>
  import { initKisaraStageHomeLifecycle } from "../runtime/stageHome";

  initKisaraStageHomeLifecycle();
</script>
