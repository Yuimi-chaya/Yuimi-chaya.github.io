---
import { Icon } from "astro-icon/components";
import { getThemePath } from "@/core/themes/registry";
import KisaraFoundSelfEasterEgg from "./KisaraFoundSelfEasterEgg.astro";
import KisaraLovebrainEasterEgg from "./KisaraLovebrainEasterEgg.astro";

type StageMode = "auto" | "still" | "scrub" | "sequence";

const base = "/themes/kisara/assets/home-stage";
const scenes: Array<{
  id: string;
  order: number;
  mode: StageMode;
  media: "image" | "video";
  src: string;
  poster?: string;
  lastPoster?: string;
  group: "intercept" | "contract" | "intimacy" | "transformation" | "jealousy";
  minWatch?: number;
  hold?: number;
  position: string;
  mobilePosition: string;
}> = [
  { id: "01", order: 1, mode: "auto", media: "video", src: `${base}/01.mp4`, poster: `${base}/01-first.webp`, lastPoster: `${base}/01-last.webp`, group: "intercept", minWatch: 0.72, hold: 0.08, position: "50% 50%", mobilePosition: "48% 50%" },
  { id: "02", order: 2, mode: "auto", media: "video", src: `${base}/02.mp4`, poster: `${base}/02-first.webp`, lastPoster: `${base}/02-last.webp`, group: "intercept", minWatch: 0.72, hold: 0.34, position: "50% 50%", mobilePosition: "57% 50%" },
  { id: "03", order: 3, mode: "still", media: "image", src: `${base}/03.webp`, group: "intercept", hold: 1.1, position: "50% 50%", mobilePosition: "66% 50%" },
  { id: "04", order: 4, mode: "auto", media: "video", src: `${base}/04.mp4`, poster: `${base}/04-first.webp`, lastPoster: `${base}/04-last.webp`, group: "contract", minWatch: 0.58, hold: 0.12, position: "50% 50%", mobilePosition: "55% 50%" },
  { id: "05", order: 5, mode: "auto", media: "video", src: `${base}/05.mp4`, poster: `${base}/05-first.webp`, lastPoster: `${base}/05-last.webp`, group: "contract", minWatch: 0.36, hold: 0.04, position: "50% 50%", mobilePosition: "53% 50%" },
  { id: "06", order: 6, mode: "scrub", media: "video", src: `${base}/06.mp4`, poster: `${base}/06-first.webp`, lastPoster: `${base}/06-last.webp`, group: "contract", position: "50% 50%", mobilePosition: "54% 50%" },
  { id: "07", order: 7, mode: "auto", media: "video", src: `${base}/07.mp4`, poster: `${base}/07-first.webp`, lastPoster: `${base}/07-last.webp`, group: "contract", minWatch: 0.9, hold: 0.82, position: "50% 50%", mobilePosition: "58% 50%" },
  { id: "08", order: 8, mode: "still", media: "image", src: `${base}/08.webp`, group: "intimacy", hold: 1.2, position: "50% 50%", mobilePosition: "53% 50%" },
  { id: "09", order: 9, mode: "still", media: "image", src: `${base}/09.webp`, group: "intimacy", hold: 0.95, position: "50% 50%", mobilePosition: "53% 50%" },
  { id: "10", order: 10, mode: "sequence", media: "image", src: `${base}/10.webp`, group: "transformation", hold: 0.72, position: "50% 50%", mobilePosition: "50% 50%" },
  { id: "11", order: 11, mode: "sequence", media: "image", src: `${base}/11.webp`, group: "transformation", hold: 0.56, position: "50% 50%", mobilePosition: "53% 50%" },
  { id: "12", order: 12, mode: "sequence", media: "image", src: `${base}/12.webp`, group: "transformation", hold: 0.62, position: "50% 50%", mobilePosition: "54% 50%" },
  { id: "13", order: 13, mode: "still", media: "image", src: `${base}/13.webp`, group: "transformation", hold: 1.25, position: "50% 50%", mobilePosition: "56% 50%" },
  { id: "14", order: 14, mode: "auto", media: "video", src: `${base}/14.mp4`, poster: `${base}/14-first.webp`, lastPoster: `${base}/14-last.webp`, group: "jealousy", minWatch: 4.5, hold: 0, position: "50% 50%", mobilePosition: "57% 50%" }
];

const manifest = scenes.map(({ id, order, mode, media, src, poster, lastPoster, group, minWatch, hold }) => ({
  id,
  order,
  mode,
  media,
  src,
  poster,
  lastPoster,
  group,
  minWatch: minWatch ?? 0,
  hold: hold ?? 0.6
}));
---

<script is:inline data-astro-rerun>
  (() => {
    const ticketKey = "yuimi-kisara-found-self-ticket-v1";
    let ticket = null;
    try {
      ticket = JSON.parse(sessionStorage.getItem(ticketKey) ?? "null");
    } catch {}
    const requested = ticket?.source === "me-games"
      && Number.isFinite(ticket?.createdAt)
      && Date.now() - ticket.createdAt < 30_000;
    if (requested) document.documentElement.dataset.kisaraFoundSelfEntry = "pending";
    else delete document.documentElement.dataset.kisaraFoundSelfEntry;
  })();
</script>

<section
  class="kisara-stage-home"
  data-kisara-stage-home
  data-kisara-gate
  data-kisara-scroll-active="true"
  data-kisara-scroll-progress="0"
  data-kisara-scroll-stage="opening"
  data-kisara-scroll-guided="false"
  data-kisara-scroll-transitioning="false"
  data-kisara-stage-settled="false"
  data-title-phase="dormant"
  aria-label="Kisara 第一集互动演出"
>
  <script type="application/json" data-kisara-stage-manifest set:html={JSON.stringify(manifest)}></script>

  <div class="kisara-stage-viewport">
    <div class="kisara-stage-media" aria-hidden="true">
      {scenes.map((scene) => (
        <figure
          class:list={["kisara-stage-shot", `is-shot-${scene.id}`]}
          data-stage-scene={scene.id}
          data-stage-mode={scene.mode}
          data-stage-group={scene.group}
          data-frame-state={scene.media === "video" ? "first" : "still"}
          style={`--stage-position:${scene.position};--stage-mobile-position:${scene.mobilePosition}`}
        >
          {
            scene.media === "video" ? (
              <>
                <img
                  class="kisara-stage-frame kisara-stage-frame-first"
                  data-stage-first-frame
                  src={scene.id === "01" ? scene.poster : undefined}
                  data-src={scene.id === "01" ? undefined : scene.poster}
                  alt=""
                  decoding="async"
                  fetchpriority={scene.id === "01" ? "high" : "low"}
                />
                <video
                  class="kisara-stage-frame kisara-stage-frame-video"
                  data-stage-video
                  data-src={scene.src}
                  muted
                  playsinline
                  preload="none"
                ></video>
                <img
                  class="kisara-stage-frame kisara-stage-frame-hold"
                  data-stage-hold-frame
                  data-src={scene.lastPoster}
                  alt=""
                  decoding="async"
                />
              </>
            ) : (
              <img class="kisara-stage-frame" data-stage-image data-src={scene.src} alt="" decoding="async" />
            )
          }
          <span class="kisara-stage-shot-grade"></span>
        </figure>
      ))}
    </div>

    <div class="kisara-stage-camera-field" aria-hidden="true">
      <span class="kisara-stage-exposure"></span>
      <span class="kisara-stage-motion-haze"></span>
      <span class="kisara-stage-side-refraction"></span>
    </div>

    <div class="kisara-stage-copy-field">
      <article class="kisara-stage-copy kisara-stage-copy-intro" data-stage-copy="02">
        <p>YUIMI LAB / VISUAL JOURNAL</p>
        <h2>这里收着做过、写过，也推翻重来的东西。</h2>
        <span>动画、代码与个人实验，不再被拆成互不相干的页面。</span>
      </article>

      <a class="kisara-stage-copy kisara-stage-copy-blog" data-stage-copy="03" href={getThemePath("kisara", "/blog/")}>
        <span class="kisara-stage-copy-index">01</span>
        <span class="kisara-stage-copy-label">BLOG / NOTES</span>
        <strong>把过程留下来</strong>
        <Icon name="tabler:external-link" aria-hidden="true" />
      </a>

      <a class="kisara-stage-copy kisara-stage-copy-me" data-stage-copy="08" href={getThemePath("kisara", "/about/")}>
        <span>ME / MEMORY</span>
        <strong>有些自我介绍，要等被接住之后再说。</strong>
        <Icon name="tabler:arrow-right" aria-hidden="true" />
      </a>

      <nav class="kisara-stage-copy kisara-stage-final-links" data-stage-copy="13" aria-label="继续浏览">
        <a href={getThemePath("kisara", "/projects/")}>
          <span>WORKS</span>
          <small>做成的东西</small>
        </a>
        <i></i>
        <a href={getThemePath("kisara", "/games/")}>
          <span>GAMES</span>
          <small>可以玩的东西</small>
        </a>
      </nav>
    </div>

    <div class="kisara-stage-title-performance" data-stage-title aria-hidden="true">
      <div class="kisara-stage-contract-mark">
        <span class="kisara-stage-chain kisara-stage-chain-a">{Array.from({ length: 6 }, () => <i></i>)}</span>
        <span class="kisara-stage-chain kisara-stage-chain-b">{Array.from({ length: 6 }, () => <i></i>)}</span>
        <Icon name="tabler:heart" class="kisara-stage-contract-heart" />
      </div>
      <span class="kisara-stage-warning-cross"><i></i><b></b></span>
      <h1 class="kisara-stage-title-word" aria-label="Kisara">
        <span class="kisara-stage-title-base">Kisara</span>
        <span class="kisara-stage-title-tide">Kisara</span>
        <span class="kisara-stage-title-enchant">Kisara</span>
        <span class="kisara-stage-title-gloss">Kisara</span>
      </h1>
    </div>

    <div class="kisara-stage-seal" data-stage-seal aria-hidden="true">
      <span>KISARA</span>
      <small>JEALOUSY ROUTE</small>
    </div>

    <div class="kisara-stage-chrome">
      <div class="kisara-stage-counter" aria-hidden="true">
        <span data-stage-index-label>01</span>
        <i></i>
        <span>14</span>
      </div>

      <div class="kisara-stage-actions">
        <button type="button" data-stage-auto aria-pressed="false" aria-label="自动播放演出" title="自动播放">
          <Icon name="tabler:player-play" aria-hidden="true" />
          <span>AUTO</span>
        </button>
        <button type="button" data-stage-skip aria-label="跳至演出结尾" title="跳过演出">
          <Icon name="tabler:player-skip-forward" aria-hidden="true" />
          <span>SKIP</span>
        </button>
        <button type="button" data-stage-replay aria-label="重新播放演出" title="重新播放" hidden>
          <Icon name="tabler:refresh" aria-hidden="true" />
          <span>REPLAY</span>
        </button>
      </div>
    </div>

    <div class="kisara-stage-scrub" data-stage-scrub aria-label="场景推进控制">
      <div class="kisara-stage-scrub-cue">
        <Icon name="tabler:hand-finger" aria-hidden="true" />
        <span class="is-desktop">滚动推进这一击</span>
        <span class="is-touch">上下拖动推进这一击</span>
      </div>
      <div class="kisara-stage-scrub-track"><i></i><span></span><b></b></div>
      <a href={getThemePath("kisara", "/games/")}>GAMES / INPUT</a>
    </div>

    <p class="sr-only" data-stage-status aria-live="polite"></p>
  </div>

  <KisaraFoundSelfEasterEgg />
  <KisaraLovebrainEasterEgg />
</section>

<script>
  import { initKisaraStageHomeLifecycle } from "../runtime/stageHome";

  initKisaraStageHomeLifecycle();
</script>
