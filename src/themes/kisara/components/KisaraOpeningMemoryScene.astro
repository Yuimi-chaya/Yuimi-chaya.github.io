---
import { Icon } from "astro-icon/components";
import { getThemePath } from "@/core/themes/registry";

const hiddenRoutes = [
  { id: "chibi-jealousy", code: "A", label: "嫉妒舞台", detail: "后宫总会起火，别让她们看见不该看的东西", icon: "tabler:heart" },
  { id: "chibi-apple", code: "B", label: "飞来之物", detail: "舞台记住两次争吵，飞来的就不再只是台词", icon: "tabler:hand-finger" },
  { id: "found-self", code: "C", label: "寻找自我", detail: "契约真正被改写前停下，回到一切的起点", icon: "tabler:arrow-back-up" },
  { id: "photo-archive", code: "D", label: "照片暗门", detail: "照片不会开口，胶带边缘未必守得住秘密", icon: "tabler:search" },
  { id: "memory-return", code: "E", label: "记忆归还", detail: "被归还的记忆不会立刻歌唱，先等十一段旧旋律走完", icon: "tabler:player-skip-forward" },
  { id: "game-shake", code: "F", label: "屏幕回望", detail: "让没发出去的话一直颤抖，屏幕另一侧也会开始注视你", icon: "tabler:activity-heartbeat" }
] as const;

const routeBranches = [
  {
    id: "home",
    pageId: "home",
    code: "01",
    label: "HOME",
    detail: "首页章节",
    href: getThemePath("kisara", "/"),
    icon: "tabler:home-heart",
    accent: "#bb4778",
    columns: 4,
    routes: [
      { id: "001", kind: "chapter", code: "001", label: "站点档案", detail: "ARCHIVE", href: "#kisara-opening", icon: "tabler:file-text" },
      { id: "002", kind: "chapter", code: "002", label: "冰箱库存", detail: "FRIDGE", href: "#kisara-fridge-title", icon: "tabler:glass-full" },
      { id: "003", kind: "chapter", code: "003", label: "照片线索", detail: "PHOTO", href: "#kisara-project-title", icon: "tabler:search" },
      { id: "004", kind: "chapter", code: "004", label: "最新信号", detail: "LATEST", href: "#kisara-latest-title", icon: "tabler:archive" }
    ]
  },
  {
    id: "blog",
    pageId: "blog",
    code: "02",
    label: "BLOG",
    detail: "文章信号",
    href: getThemePath("kisara", "/blog/"),
    icon: "tabler:book-2",
    accent: "#9a4b7e",
    columns: 3,
    routes: [
      { id: "blog-cast", kind: "feature", code: "VIEW", label: "人物视点", detail: "CAST FOCUS", href: `${getThemePath("kisara", "/blog/")}#kisara-blog-hero-title`, icon: "tabler:user-heart" },
      { id: "blog-archive", kind: "feature", code: "LOG", label: "文章档案", detail: "SIGNAL ARCHIVE", href: `${getThemePath("kisara", "/blog/")}#kisara-blog-archive`, icon: "tabler:archive" }
    ]
  },
  {
    id: "games",
    pageId: "games",
    code: "03",
    label: "GAME",
    detail: "互动游乐场",
    href: getThemePath("kisara", "/games/"),
    icon: "tabler:device-gamepad-2",
    accent: "#5573aa",
    columns: 3,
    routes: [
      { id: "game-message", kind: "feature", code: "MSG", label: "私聊信号", detail: "MESSAGE", href: `${getThemePath("kisara", "/games/")}#kisara-game-hero-title`, icon: "tabler:activity-heartbeat" },
      { id: "game-arcade", kind: "feature", code: "PLAY", label: "夜间街机", detail: "ARCADE", href: `${getThemePath("kisara", "/games/")}#kisara-arcade-title`, icon: "tabler:device-gamepad-2" }
    ]
  },
  {
    id: "projects",
    pageId: "projects",
    code: "04",
    label: "WORKS",
    detail: "创作现场",
    href: getThemePath("kisara", "/projects/"),
    icon: "tabler:code",
    accent: "#4f7798",
    columns: 3,
    routes: [
      { id: "works-cut", kind: "feature", code: "CUT", label: "刀切测试", detail: "CUT TEST", href: `${getThemePath("kisara", "/projects/")}#kisara-works-title`, icon: "tabler:blade" },
      { id: "works-kitchen", kind: "feature", code: "PREP", label: "技术食材", detail: "KITCHEN LAB", href: `${getThemePath("kisara", "/projects/")}#kisara-kitchen-lab`, icon: "tabler:flask-2" },
      { id: "works-result", kind: "feature", code: "MIX", label: "实验配方", detail: "RESULT LAB", href: `${getThemePath("kisara", "/projects/")}#kisara-drink-title`, icon: "tabler:flask-2" }
    ]
  },
  {
    id: "about",
    pageId: "about",
    code: "05",
    label: "ME",
    detail: "个人档案",
    href: getThemePath("kisara", "/about/"),
    icon: "tabler:user-heart",
    accent: "#7c4e89",
    columns: 3,
    routes: [
      { id: "me-profile", kind: "feature", code: "ME", label: "身份档案", detail: "PROFILE", href: getThemePath("kisara", "/about/"), icon: "tabler:user-heart" },
      { id: "me-memories", kind: "feature", code: "05", label: "五段记忆", detail: "MEMORIES", href: getThemePath("kisara", "/about/"), icon: "tabler:archive" },
      { id: "me-friends", kind: "feature", code: "LINK", label: "友联坐标", detail: "FRIENDS", href: getThemePath("kisara", "/friends/"), icon: "tabler:link" }
    ]
  },
] as const;
---

<kisara-opening-memory-scene class="kisara-opening-video-scene is-memory-video-armed" data-kisara-opening-memory>
  <div class="kisara-opening-video-media" aria-hidden="true">
    <img
      class="kisara-opening-video-poster is-first"
      src="/themes/kisara/assets/opening-memory-001-first.webp?v=b207a3d7"
      alt=""
      width="1920"
      height="1080"
      loading="eager"
      decoding="async"
    />
    <video
      class="kisara-opening-video"
      data-memory-video
      src="/themes/kisara/assets/opening-memory-001.mp4?v=26026bec"
      poster="/themes/kisara/assets/opening-memory-001-first.webp?v=b207a3d7"
      preload="auto"
      muted
      playsinline
      disablepictureinpicture
    ></video>
    <img
      class="kisara-opening-video-poster is-last"
      src="/themes/kisara/assets/opening-memory-001-last.webp?v=85ffa275"
      alt=""
      width="1920"
      height="1080"
      loading="eager"
      decoding="async"
    />
    <span class="kisara-opening-video-grade"></span>
  </div>

  <header class="kisara-opening-video-copy">
    <p class="kisara-section-index">YUIMI LAB / 001</p>
    <h2 id="kisara-opening-title">
      <span>A personal archive,</span>
      <em>still growing.</em>
    </h2>
    <p class="kisara-opening-video-lead">这份契约还没有定稿。选择一条，把它重新写进记忆。</p>
    <nav class="kisara-opening-video-body kisara-opening-route-map" data-kisara-opening-route-map aria-label="Kisara 全站路线图">
      <a class="kisara-opening-route-root" href={getThemePath("kisara", "/")} data-kisara-opening-route-root aria-label="返回 Kisara 首页">
        <span class="kisara-opening-route-root-mark" aria-hidden="true"><Icon name="tabler:heart" /></span>
        <span class="kisara-opening-route-root-copy">
          <small>YUIMI LAB / CONTRACT 001</small>
          <strong>KISARA</strong>
          <em>authorized revision / memory owner</em>
        </span>
      </a>

      <span class="kisara-opening-contract-copy" aria-hidden="true">
        <i>SUPPLEMENT 263 / MEMORY OWNERSHIP</i>
        <b>THE FOLLOWING CLAUSES REMAIN SUBJECT TO REVISION</b>
        <em>sign, amend, remember.</em>
      </span>

      <p class="kisara-opening-contract-caption">AMENDMENT / SELECT A CLAUSE</p>

      <ol class="kisara-opening-route-journey">
        {routeBranches.map((branch, branchIndex) => (
          <li
            class:list={["kisara-opening-route-page", `is-${branch.id}`]}
            style={`--route-branch-order: ${branchIndex}; --route-accent: ${branch.accent}; --route-columns: ${branch.columns};`}
            data-kisara-route-branch={branch.id}
          >
            <a
              class="kisara-opening-route-page-hub"
              href={branch.href}
              data-kisara-route-kind="page"
              data-kisara-route-id={branch.pageId}
              data-astro-prefetch="hover"
            >
              <span class="kisara-opening-route-page-icon"><Icon name={branch.icon} aria-hidden="true" /></span>
              <span class="kisara-opening-route-page-copy">
                <b>CLAUSE {branch.code}</b>
                <strong>{branch.label}</strong>
                <small>{branch.detail}</small>
              </span>
              <span class="kisara-opening-route-revision" aria-hidden="true">REWRITE</span>
            </a>
            <ul class="kisara-opening-route-notes">
              {branch.routes.map((route, routeIndex) => (
                <li style={`--route-order: ${routeIndex};`}>
                  <a
                    class="kisara-opening-route-node"
                    href={route.href}
                    data-kisara-route-kind={route.kind}
                    data-kisara-route-id={route.id}
                    data-astro-prefetch={route.href.startsWith("#") ? undefined : "hover"}
                  >
                    <span class="kisara-opening-route-node-icon"><Icon name={route.icon} aria-hidden="true" /></span>
                    <span><b>{route.code}</b><strong>{route.label}</strong><small>{route.detail}</small></span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>

      <aside class="kisara-opening-route-secrets" aria-label="隐藏路线">
        <p aria-hidden="true"><b>SUPPLEMENT</b><span>REDACTED / A-F</span></p>
        <ol>
          {hiddenRoutes.map((route, routeIndex) => (
            <li style={`--route-order: ${routeIndex};`}>
              <span
                class="kisara-opening-route-secret"
                data-kisara-route-kind="easter"
                data-kisara-route-id={route.id}
                data-kisara-opening-hint={route.id}
                data-hint-code={route.code}
                aria-label={`${route.label}：${route.detail}`}
                title={route.detail}
              >
                <b class="kisara-opening-easter-hint-code">{route.code}</b>
                <span class="kisara-opening-easter-hint-copy">
                  <span class="kisara-opening-easter-hint-fragment"><strong>{route.label}</strong></span>
                </span>
              </span>
            </li>
          ))}
        </ol>
      </aside>
    </nav>
  </header>

  <p class="kisara-opening-video-clause">ROOT / PAGE / ROUTE</p>
</kisara-opening-memory-scene>

<script>
  if (!customElements.get("kisara-opening-memory-scene")) {
    class KisaraOpeningMemoryScene extends HTMLElement {
      controller: AbortController | null = null;
      observer: IntersectionObserver | null = null;
      chapterObserver: IntersectionObserver | null = null;
      resetScene: (() => void) | null = null;
      refreshScene: (() => void) | null = null;

      resetPresentation() {
        this.resetScene?.();
      }

      refreshPresentationAfterVisibility() {
        this.refreshScene?.();
      }

      connectedCallback() {
        this.controller?.abort();
        const controller = new AbortController();
        this.controller = controller;
        const { signal } = controller;
        const video = this.querySelector<HTMLVideoElement>("[data-memory-video]");
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const hintNodes = Array.from(
          this.querySelectorAll<HTMLElement>("[data-kisara-opening-hint]")
        );
        const routeNodes = Array.from(
          this.querySelectorAll<HTMLElement>("[data-kisara-route-kind][data-kisara-route-id]")
        );
        const pageNodes = routeNodes.filter((node) => node.dataset.kisaraRouteKind === "page");
        const chapterNodes = routeNodes.filter((node) => node.dataset.kisaraRouteKind === "chapter");
        const routeMap = this.querySelector<HTMLElement>("[data-kisara-opening-route-map]");
        const routeRoot = this.querySelector<HTMLElement>("[data-kisara-opening-route-root]");
        const routeBranchNodes = Array.from(
          this.querySelectorAll<HTMLElement>("[data-kisara-route-branch]")
        );
        let routeRootTravel = 0;
        let sceneVisible = false;

        const measureRouteRootTravel = () => {
          if (!routeMap || !routeRoot) return;
          routeRootTravel = Math.max(0, (routeMap.clientWidth - routeRoot.offsetWidth) / 2);
        };
        measureRouteRootTravel();

        const activateRouteBranch = (activeBranch: HTMLElement) => {
          routeMap?.classList.add("is-route-focused");
          routeBranchNodes.forEach((branch) => {
            branch.classList.toggle("is-active", branch === activeBranch);
          });
        };
        const clearRouteBranch = () => {
          routeMap?.classList.remove("is-route-focused");
          routeBranchNodes.forEach((branch) => {
            branch.classList.remove("is-active");
            delete branch.dataset.routeTapReady;
          });
        };
        const fineRoutePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        routeBranchNodes.forEach((branch) => {
          const hub = branch.querySelector<HTMLElement>(".kisara-opening-route-page-hub");
          if (fineRoutePointer) {
            branch.addEventListener("pointerenter", () => activateRouteBranch(branch), { signal });
            branch.addEventListener("focusin", () => activateRouteBranch(branch), { signal });
            return;
          }
          hub?.addEventListener("click", (event) => {
            if (branch.dataset.routeTapReady === "true") return;
            event.preventDefault();
            routeBranchNodes.forEach((candidate) => delete candidate.dataset.routeTapReady);
            branch.dataset.routeTapReady = "true";
            activateRouteBranch(branch);
          }, { signal });
        });
        routeMap?.addEventListener("pointerleave", () => {
          if (fineRoutePointer && !routeMap.contains(document.activeElement)) clearRouteBranch();
        }, { signal });
        routeMap?.addEventListener("focusout", (event) => {
          if (event.relatedTarget instanceof Node && routeMap.contains(event.relatedTarget)) return;
          clearRouteBranch();
        }, { signal });
        routeMap?.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          clearRouteBranch();
          routeRoot?.focus();
        }, { signal });

        const animateRouteNode = (node: HTMLElement) => {
          if (reducedMotion) return;
          node.classList.remove("is-route-drawing", "is-hint-drawing");
          void node.offsetWidth;
          node.classList.add("is-route-drawing");
          if (node.hasAttribute("data-kisara-opening-hint")) node.classList.add("is-hint-drawing");
          delete node.dataset.routePending;
        };

        const achieveRouteNode = (node: HTMLElement | undefined, animate = false) => {
          if (!node || node.classList.contains("is-route-achieved")) return;
          node.classList.add("is-route-achieved");
          node.dataset.routeState = "visited";
          if (node.hasAttribute("data-kisara-opening-hint")) node.classList.add("is-hint-achieved");
          if (!animate || reducedMotion) return;
          if (sceneVisible) animateRouteNode(node);
          else node.dataset.routePending = "true";
        };

        const achieveHint = (id: string, animate = false) => {
          const node = hintNodes.find((candidate) => candidate.dataset.kisaraOpeningHint === id);
          achieveRouteNode(node, animate);
        };

        hintNodes.forEach((node) => {
          const id = node.dataset.kisaraOpeningHint;
          if (id && window.__yuimiKisaraEasterLedger?.has(id)) achieveHint(id);
        });
        window.addEventListener("yuimi:kisara-opening-hint-achieved", (event) => {
          const detail = event instanceof CustomEvent && event.detail && typeof event.detail === "object"
            ? event.detail
            : {};
          if (typeof detail.id === "string") achieveHint(detail.id, true);
        }, { signal });

        const syncVisitedPages = (visited: unknown) => {
          const visitedPages = new Set(Array.isArray(visited) ? visited : []);
          pageNodes.forEach((node) => {
            const id = node.dataset.kisaraRouteId;
            if (id && visitedPages.has(id)) achieveRouteNode(node);
          });
        };
        syncVisitedPages(window.__yuimiKisaraLovebrainProgress?.snapshot?.().visited);
        achieveRouteNode(pageNodes.find((node) => node.dataset.kisaraRouteId === "home"));
        window.addEventListener("yuimi:kisara-lovebrain-progress", (event) => {
          const visited = event instanceof CustomEvent ? event.detail?.visited : [];
          syncVisitedPages(visited);
        }, { signal });

        const chapterStorageKey = "yuimi-kisara-opening-route-chapters-v1";
        const validChapterIds = new Set(["001", "002", "003", "004"]);
        const visitedChapters = new Set<string>();
        try {
          const stored = JSON.parse(sessionStorage.getItem(chapterStorageKey) ?? "null");
          const values = Array.isArray(stored)
            ? stored
            : stored?.version === 1 && Array.isArray(stored.visited)
              ? stored.visited
              : [];
          values.forEach((id) => {
            if (validChapterIds.has(id)) visitedChapters.add(id);
          });
        } catch {}

        const persistChapters = () => {
          try {
            sessionStorage.setItem(chapterStorageKey, JSON.stringify({
              version: 1,
              visited: [...visitedChapters]
            }));
          } catch {}
        };
        const achieveChapter = (id: string, animate = false) => {
          if (!validChapterIds.has(id)) return;
          const isNew = !visitedChapters.has(id);
          if (isNew) {
            visitedChapters.add(id);
            persistChapters();
          }
          const node = chapterNodes.find((candidate) => candidate.dataset.kisaraRouteId === id);
          achieveRouteNode(node, animate && isNew);
        };
        chapterNodes.forEach((node) => {
          const id = node.dataset.kisaraRouteId;
          if (id && visitedChapters.has(id)) achieveRouteNode(node);
        });

        const revealPendingRoutes = () => {
          if (!sceneVisible || reducedMotion) return;
          routeNodes.forEach((node) => {
            if (node.dataset.routePending === "true") animateRouteNode(node);
          });
        };

        this.chapterObserver?.disconnect();
        const chapterTargets = Array.from(document.querySelectorAll<HTMLElement>("[data-kisara-home-stop]"));
        if ("IntersectionObserver" in window) {
          this.chapterObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting || entry.intersectionRatio < 0.24) return;
              const id = (entry.target as HTMLElement).dataset.kisaraHomeStop;
              if (id) achieveChapter(id, true);
            });
          }, { threshold: [0, 0.24, 0.5], rootMargin: "-8% 0px -8%" });
          chapterTargets.forEach((target) => this.chapterObserver?.observe(target));
        } else {
          achieveChapter("001");
        }

        if (!video) return;

        let waitingForFreshEntry = false;
        let state: "armed" | "playing" | "settled" = "armed";
        let generation = 0;
        let recoveryFrame = 0;
        let copySyncFrame = 0;
        let playbackWatchdog = 0;
        let playbackRetryTimer = 0;
        let stallRecoveries = 0;
        let reloadPipelineOnResume = false;
        let playbackEndedHandler: (() => void) | null = null;

        const clamp = (value: number, min = 0, max = 1) => Math.min(max, Math.max(min, value));
        const easePhase = (value: number, start: number, end: number) => {
          const progress = clamp((value - start) / Math.max(0.001, end - start));
          return progress * progress * (3 - 2 * progress);
        };

        const setCopyTimeline = (mediaTime = 0, complete = false) => {
          const duration = Number.isFinite(video.duration) && video.duration > 0
            ? video.duration
            : 1.584917;
          const timeline = complete ? 1 : clamp(mediaTime / duration);
          const lift = easePhase(timeline, 0.42, 0.65);
          const magnify = easePhase(timeline, 0.65, 0.97);
          const compact = window.innerWidth <= 620;
          const medium = !compact && window.innerWidth <= 900;
          const finalScale = compact ? 0.8 : 0.88;
          const initialScale = compact ? 0.62 : 0.69;
          const initialOffset = compact ? 34 : medium ? 62 : 86;
          const ruleProgress = easePhase(timeline, 0.74, 0.99);
          const routeRootReveal = easePhase(timeline, 0.48, 0.68);
          const routeRootDock = easePhase(timeline, 0.7, 0.97);
          const routeRootPeakScale = 0.5 + routeRootReveal * 0.62;
          const routeRootScale = routeRootPeakScale + (1 - routeRootPeakScale) * routeRootDock;

          this.style.setProperty(
            "--kisara-opening-copy-scale",
            (initialScale + (finalScale - initialScale) * magnify).toFixed(4)
          );
          this.style.setProperty(
            "--kisara-opening-copy-offset-y",
            `${(initialOffset * (1 - lift)).toFixed(2)}px`
          );
          this.style.setProperty(
            "--kisara-opening-index-opacity",
            easePhase(timeline, 0.36, 0.54).toFixed(4)
          );
          this.style.setProperty(
            "--kisara-opening-title-opacity",
            easePhase(timeline, 0.42, 0.62).toFixed(4)
          );
          this.style.setProperty(
            "--kisara-opening-accent-opacity",
            easePhase(timeline, 0.5, 0.72).toFixed(4)
          );
          this.style.setProperty(
            "--kisara-opening-lead-opacity",
            easePhase(timeline, 0.54, 0.76).toFixed(4)
          );
          this.style.setProperty(
            "--kisara-opening-body-opacity",
            (0.96 * easePhase(timeline, 0.62, 0.88)).toFixed(4)
          );
          this.style.setProperty(
            "--kisara-opening-note-opacity",
            (0.9 * easePhase(timeline, 0.7, 0.98)).toFixed(4)
          );
          this.style.setProperty(
            "--kisara-opening-clause-opacity",
            (0.72 * easePhase(timeline, 0.76, 1)).toFixed(4)
          );
          this.style.setProperty("--kisara-opening-rule-opacity", ruleProgress.toFixed(4));
          this.style.setProperty(
            "--kisara-opening-rule-scale",
            (0.18 + 0.82 * ruleProgress).toFixed(4)
          );
          this.style.setProperty("--kisara-opening-route-root-opacity", routeRootReveal.toFixed(4));
          this.style.setProperty(
            "--kisara-opening-route-root-scale",
            routeRootScale.toFixed(4)
          );
          this.style.setProperty(
            "--kisara-opening-route-root-shift",
            `${(routeRootTravel * (1 - routeRootDock)).toFixed(2)}px`
          );
        };

        const stopCopySync = () => {
          if (copySyncFrame) window.cancelAnimationFrame(copySyncFrame);
          copySyncFrame = 0;
        };

        const startCopySync = (playGeneration: number) => {
          stopCopySync();
          const sync = () => {
            if (
              signal.aborted
              || playGeneration !== generation
              || state !== "playing"
            ) {
              copySyncFrame = 0;
              return;
            }
            setCopyTimeline(video.currentTime);
            copySyncFrame = window.requestAnimationFrame(sync);
          };
          copySyncFrame = window.requestAnimationFrame(sync);
        };

        const setVideoTime = (time: number) => {
          try {
            video.currentTime = time;
          } catch {
            // Metadata can finish loading between lifecycle transitions.
          }
        };

        const markFrameReady = () => {
          if (state !== "playing" || signal.aborted) return;
          this.classList.add("is-memory-video-frame-ready");
        };

        const clearPlaybackTimers = () => {
          stopCopySync();
          if (playbackWatchdog) window.clearTimeout(playbackWatchdog);
          if (playbackRetryTimer) window.clearTimeout(playbackRetryTimer);
          if (playbackEndedHandler) video.removeEventListener("ended", playbackEndedHandler);
          playbackWatchdog = 0;
          playbackRetryTimer = 0;
          playbackEndedHandler = null;
        };

        const setArmedPresentation = () => {
          state = "armed";
          clearRouteBranch();
          video.pause();
          setVideoTime(0);
          setCopyTimeline(0);
          this.classList.remove(
            "is-memory-video-playing",
            "is-memory-video-frame-ready",
            "is-memory-video-settled"
          );
          this.classList.add("is-memory-video-armed");
        };

        const resetActivePlayback = (reloadPipeline = false) => {
          generation += 1;
          clearPlaybackTimers();
          setArmedPresentation();
          if (reloadPipeline) {
            try {
              video.load();
            } catch {
              // A fresh play attempt can still rebuild the media pipeline.
            }
          }
        };

        const finish = () => {
          generation += 1;
          clearPlaybackTimers();
          stallRecoveries = 0;
          reloadPipelineOnResume = false;
          state = "settled";
          video.pause();
          if (Number.isFinite(video.duration) && video.duration > 0) {
            setVideoTime(Math.max(0, video.duration - 0.04));
          }
          setCopyTimeline(video.duration, true);
          this.classList.remove(
            "is-memory-video-armed",
            "is-memory-video-playing",
            "is-memory-video-frame-ready"
          );
          this.classList.add("is-memory-video-settled");
        };

        const recoverStalledPlayback = (playGeneration: number) => {
          if (
            signal.aborted
            || playGeneration !== generation
            || state !== "playing"
          ) return;

          const shouldRetry = stallRecoveries < 2;
          const shouldReload = stallRecoveries === 0;
          stallRecoveries += 1;
          resetActivePlayback(shouldReload);
          if (!shouldRetry || document.hidden || !sceneVisible || waitingForFreshEntry) return;

          const retryGeneration = generation;
          playbackRetryTimer = window.setTimeout(() => {
            playbackRetryTimer = 0;
            if (
              signal.aborted
              || retryGeneration !== generation
              || state !== "armed"
              || document.hidden
              || !sceneVisible
              || waitingForFreshEntry
            ) return;
            void play(true);
          }, shouldReload ? 120 : 260);
        };

        const schedulePlaybackWatchdog = (playGeneration: number, baseline = 0) => {
          if (playbackWatchdog) window.clearTimeout(playbackWatchdog);
          playbackWatchdog = window.setTimeout(() => {
            playbackWatchdog = 0;
            if (
              signal.aborted
              || playGeneration !== generation
              || state !== "playing"
              || document.hidden
              || !sceneVisible
            ) return;

            const currentTime = Number.isFinite(video.currentTime) ? video.currentTime : 0;
            if (
              Number.isFinite(video.duration)
              && video.duration > 0
              && currentTime >= video.duration - 0.08
            ) {
              finish();
              return;
            }
            if (!video.paused && currentTime > baseline + 0.025) {
              markFrameReady();
              schedulePlaybackWatchdog(playGeneration, currentTime);
              return;
            }
            recoverStalledPlayback(playGeneration);
          }, baseline > 0.025 ? 700 : 1300);
        };

        const play = async (isRecoveryRetry = false) => {
          if (
            document.hidden
            || !sceneVisible
            || waitingForFreshEntry
            || state === "playing"
            || state === "settled"
          ) return;
          if (!isRecoveryRetry) stallRecoveries = 0;
          if (reducedMotion) {
            finish();
            return;
          }

          const playGeneration = ++generation;
          state = "playing";
          video.pause();
          setVideoTime(0);
          this.classList.remove("is-memory-video-armed", "is-memory-video-settled");
          this.classList.add("is-memory-video-playing");
          this.classList.remove("is-memory-video-frame-ready");
          const handleEnded = () => {
            if (playGeneration !== generation || state !== "playing") return;
            finish();
          };
          playbackEndedHandler = handleEnded;
          video.addEventListener("ended", handleEnded, { once: true });
          schedulePlaybackWatchdog(playGeneration, 0);

          try {
            await video.play();
            if (signal.aborted || playGeneration !== generation || state !== "playing") return;
            startCopySync(playGeneration);
            if ("requestVideoFrameCallback" in video) {
              video.requestVideoFrameCallback(() => markFrameReady());
            } else {
              markFrameReady();
            }
          } catch {
            recoverStalledPlayback(playGeneration);
          }
        };

        const arm = (waitForExit = false) => {
          generation += 1;
          clearPlaybackTimers();
          stallRecoveries = 0;
          reloadPipelineOnResume = false;
          waitingForFreshEntry = waitForExit && sceneVisible;
          setArmedPresentation();
          requestAnimationFrame(() => {
            if (!signal.aborted && sceneVisible && !waitingForFreshEntry) void play();
          });
        };

        const measureVisibility = () => {
          const rect = this.getBoundingClientRect();
          const viewportHeight = Math.max(1, window.innerHeight);
          const visibleHeight = Math.max(0, Math.min(rect.bottom, viewportHeight) - Math.max(rect.top, 0));
          return visibleHeight / Math.max(1, Math.min(rect.height, viewportHeight)) >= 0.16;
        };

        const syncVisibility = () => {
          const wasVisible = sceneVisible;
          sceneVisible = measureVisibility();
          if (!sceneVisible) {
            waitingForFreshEntry = false;
            if (state === "playing") {
              resetActivePlayback();
            }
            return;
          }
          revealPendingRoutes();
          if (waitingForFreshEntry) {
            if (!wasVisible) waitingForFreshEntry = false;
            else return;
          }
          if (state === "playing" && video.paused) {
            resetActivePlayback();
          }
          if (state === "armed") void play();
        };

        const scheduleVisibilitySync = () => {
          if (recoveryFrame) window.cancelAnimationFrame(recoveryFrame);
          recoveryFrame = window.requestAnimationFrame(() => {
            recoveryFrame = window.requestAnimationFrame(() => {
              recoveryFrame = 0;
              if (!signal.aborted) syncVisibility();
            });
          });
        };

        const interruptForLifecycle = () => {
          if (state !== "playing") return;
          resetActivePlayback();
          stallRecoveries = 0;
          reloadPipelineOnResume = true;
        };

        const recoverAfterLifecycle = () => {
          if (document.hidden) return;
          if (reloadPipelineOnResume) {
            reloadPipelineOnResume = false;
            try {
              video.load();
            } catch {
              // The visibility sync below will still make a fresh play attempt.
            }
          }
          scheduleVisibilitySync();
        };

        video.addEventListener("playing", markFrameReady, { signal });
        video.addEventListener("timeupdate", () => {
          if (state === "playing" && video.currentTime > 0.025) {
            markFrameReady();
            setCopyTimeline(video.currentTime);
          }
        }, { signal });
        window.addEventListener("resize", () => {
          measureRouteRootTravel();
          setCopyTimeline(video.currentTime, state === "settled");
        }, { passive: true, signal });
        window.addEventListener("pointerdown", () => {
          if (sceneVisible && state === "armed") void play();
        }, { signal });
        window.addEventListener("wheel", () => {
          if (sceneVisible && state === "armed") void play();
        }, { passive: true, signal });
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            interruptForLifecycle();
            return;
          }
          recoverAfterLifecycle();
        }, { signal });
        window.addEventListener("pagehide", interruptForLifecycle, { signal });
        window.addEventListener("pageshow", recoverAfterLifecycle, { signal });
        window.addEventListener("focus", recoverAfterLifecycle, { signal });
        document.addEventListener("freeze", interruptForLifecycle, { signal });
        document.addEventListener("resume", recoverAfterLifecycle, { signal });

        if ("IntersectionObserver" in window) {
          this.observer = new IntersectionObserver((entries) => {
            const entry = entries[entries.length - 1];
            sceneVisible = Boolean(entry?.isIntersecting && entry.intersectionRatio >= 0.16);
            if (!sceneVisible) {
              waitingForFreshEntry = false;
              if (state === "playing") arm(false);
              return;
            }
            revealPendingRoutes();
            if (!waitingForFreshEntry && state === "armed") void play();
          }, { threshold: [0, 0.16, 0.42], rootMargin: "4% 0px 4%" });
          this.observer.observe(this);
        } else {
          sceneVisible = true;
          revealPendingRoutes();
          void play();
        }

        this.resetScene = () => arm(true);
        this.refreshScene = scheduleVisibilitySync;
        signal.addEventListener("abort", () => {
          generation += 1;
          clearPlaybackTimers();
          video.pause();
          if (recoveryFrame) window.cancelAnimationFrame(recoveryFrame);
          recoveryFrame = 0;
        }, { once: true });
      }

      disconnectedCallback() {
        this.controller?.abort();
        this.controller = null;
        this.observer?.disconnect();
        this.observer = null;
        this.chapterObserver?.disconnect();
        this.chapterObserver = null;
        this.resetScene = null;
        this.refreshScene = null;
      }
    }

    customElements.define("kisara-opening-memory-scene", KisaraOpeningMemoryScene);
  }
</script>
