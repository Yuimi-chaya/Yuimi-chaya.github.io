<kisara-opening-memory-scene class="kisara-opening-video-scene is-memory-video-armed" data-kisara-opening-memory>
  <div class="kisara-opening-video-media" aria-hidden="true">
    <img
      class="kisara-opening-video-poster is-first"
      src="/themes/kisara/assets/opening-memory-001-first.webp?v=b207a3d7"
      alt=""
      width="1920"
      height="1080"
      loading="eager"
      decoding="async"
    />
    <video
      class="kisara-opening-video"
      data-memory-video
      src="/themes/kisara/assets/opening-memory-001.mp4?v=26026bec"
      poster="/themes/kisara/assets/opening-memory-001-first.webp?v=b207a3d7"
      preload="auto"
      muted
      playsinline
      disablepictureinpicture
    ></video>
    <img
      class="kisara-opening-video-poster is-last"
      src="/themes/kisara/assets/opening-memory-001-last.webp?v=85ffa275"
      alt=""
      width="1920"
      height="1080"
      loading="eager"
      decoding="async"
    />
    <span class="kisara-opening-video-grade"></span>
  </div>

  <header class="kisara-opening-video-copy">
    <p class="kisara-section-index">YUIMI LAB / 001</p>
    <h2 id="kisara-opening-title">
      <span>A personal archive,</span>
      <em>still growing.</em>
    </h2>
    <p class="kisara-opening-video-lead">这里是 Yuimi Lab，一份还在继续生长的个人博客。</p>
    <p class="kisara-opening-video-body">文章、作品、游戏，以及关于我的一些碎片，都收在这里。</p>
    <p class="kisara-opening-video-note">技术搭起骨架，动画与交互把脑海里的画面一点点落实。</p>
  </header>

  <p class="kisara-opening-video-clause">BLOG / WORKS / GAME / ME</p>
</kisara-opening-memory-scene>

<script>
  if (!customElements.get("kisara-opening-memory-scene")) {
    class KisaraOpeningMemoryScene extends HTMLElement {
      controller: AbortController | null = null;
      observer: IntersectionObserver | null = null;
      resetScene: (() => void) | null = null;
      refreshScene: (() => void) | null = null;

      resetPresentation() {
        this.resetScene?.();
      }

      refreshPresentationAfterVisibility() {
        this.refreshScene?.();
      }

      connectedCallback() {
        this.controller?.abort();
        const controller = new AbortController();
        this.controller = controller;
        const { signal } = controller;
        const video = this.querySelector<HTMLVideoElement>("[data-memory-video]");
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!video) return;

        let sceneVisible = false;
        let waitingForFreshEntry = false;
        let state: "armed" | "playing" | "settled" = "armed";
        let generation = 0;
        let recoveryFrame = 0;
        let playbackWatchdog = 0;
        let playbackRetryTimer = 0;
        let stallRecoveries = 0;
        let reloadPipelineOnResume = false;
        let playbackEndedHandler: (() => void) | null = null;

        const setVideoTime = (time: number) => {
          try {
            video.currentTime = time;
          } catch {
            // Metadata can finish loading between lifecycle transitions.
          }
        };

        const markFrameReady = () => {
          if (state !== "playing" || signal.aborted) return;
          this.classList.add("is-memory-video-frame-ready");
        };

        const clearPlaybackTimers = () => {
          if (playbackWatchdog) window.clearTimeout(playbackWatchdog);
          if (playbackRetryTimer) window.clearTimeout(playbackRetryTimer);
          if (playbackEndedHandler) video.removeEventListener("ended", playbackEndedHandler);
          playbackWatchdog = 0;
          playbackRetryTimer = 0;
          playbackEndedHandler = null;
        };

        const setArmedPresentation = () => {
          state = "armed";
          video.pause();
          setVideoTime(0);
          this.classList.remove(
            "is-memory-video-playing",
            "is-memory-video-frame-ready",
            "is-memory-video-settled"
          );
          this.classList.add("is-memory-video-armed");
        };

        const resetActivePlayback = (reloadPipeline = false) => {
          generation += 1;
          clearPlaybackTimers();
          setArmedPresentation();
          if (reloadPipeline) {
            try {
              video.load();
            } catch {
              // A fresh play attempt can still rebuild the media pipeline.
            }
          }
        };

        const finish = () => {
          generation += 1;
          clearPlaybackTimers();
          stallRecoveries = 0;
          reloadPipelineOnResume = false;
          state = "settled";
          video.pause();
          if (Number.isFinite(video.duration) && video.duration > 0) {
            setVideoTime(Math.max(0, video.duration - 0.04));
          }
          this.classList.remove(
            "is-memory-video-armed",
            "is-memory-video-playing",
            "is-memory-video-frame-ready"
          );
          this.classList.add("is-memory-video-settled");
        };

        const recoverStalledPlayback = (playGeneration: number) => {
          if (
            signal.aborted
            || playGeneration !== generation
            || state !== "playing"
          ) return;

          const shouldRetry = stallRecoveries < 2;
          const shouldReload = stallRecoveries === 0;
          stallRecoveries += 1;
          resetActivePlayback(shouldReload);
          if (!shouldRetry || document.hidden || !sceneVisible || waitingForFreshEntry) return;

          const retryGeneration = generation;
          playbackRetryTimer = window.setTimeout(() => {
            playbackRetryTimer = 0;
            if (
              signal.aborted
              || retryGeneration !== generation
              || state !== "armed"
              || document.hidden
              || !sceneVisible
              || waitingForFreshEntry
            ) return;
            void play(true);
          }, shouldReload ? 120 : 260);
        };

        const schedulePlaybackWatchdog = (playGeneration: number, baseline = 0) => {
          if (playbackWatchdog) window.clearTimeout(playbackWatchdog);
          playbackWatchdog = window.setTimeout(() => {
            playbackWatchdog = 0;
            if (
              signal.aborted
              || playGeneration !== generation
              || state !== "playing"
              || document.hidden
              || !sceneVisible
            ) return;

            const currentTime = Number.isFinite(video.currentTime) ? video.currentTime : 0;
            if (
              Number.isFinite(video.duration)
              && video.duration > 0
              && currentTime >= video.duration - 0.08
            ) {
              finish();
              return;
            }
            if (!video.paused && currentTime > baseline + 0.025) {
              markFrameReady();
              schedulePlaybackWatchdog(playGeneration, currentTime);
              return;
            }
            recoverStalledPlayback(playGeneration);
          }, baseline > 0.025 ? 700 : 1300);
        };

        const play = async (isRecoveryRetry = false) => {
          if (
            document.hidden
            || !sceneVisible
            || waitingForFreshEntry
            || state === "playing"
            || state === "settled"
          ) return;
          if (!isRecoveryRetry) stallRecoveries = 0;
          if (reducedMotion) {
            finish();
            return;
          }

          const playGeneration = ++generation;
          state = "playing";
          video.pause();
          setVideoTime(0);
          this.classList.remove("is-memory-video-armed", "is-memory-video-settled");
          this.classList.add("is-memory-video-playing");
          this.classList.remove("is-memory-video-frame-ready");
          const handleEnded = () => {
            if (playGeneration !== generation || state !== "playing") return;
            finish();
          };
          playbackEndedHandler = handleEnded;
          video.addEventListener("ended", handleEnded, { once: true });
          schedulePlaybackWatchdog(playGeneration, 0);

          try {
            await video.play();
            if (signal.aborted || playGeneration !== generation || state !== "playing") return;
            if ("requestVideoFrameCallback" in video) {
              video.requestVideoFrameCallback(() => markFrameReady());
            } else {
              markFrameReady();
            }
          } catch {
            recoverStalledPlayback(playGeneration);
          }
        };

        const arm = (waitForExit = false) => {
          generation += 1;
          clearPlaybackTimers();
          stallRecoveries = 0;
          reloadPipelineOnResume = false;
          waitingForFreshEntry = waitForExit && sceneVisible;
          setArmedPresentation();
          requestAnimationFrame(() => {
            if (!signal.aborted && sceneVisible && !waitingForFreshEntry) void play();
          });
        };

        const measureVisibility = () => {
          const rect = this.getBoundingClientRect();
          const viewportHeight = Math.max(1, window.innerHeight);
          const visibleHeight = Math.max(0, Math.min(rect.bottom, viewportHeight) - Math.max(rect.top, 0));
          return visibleHeight / Math.max(1, Math.min(rect.height, viewportHeight)) >= 0.16;
        };

        const syncVisibility = () => {
          const wasVisible = sceneVisible;
          sceneVisible = measureVisibility();
          if (!sceneVisible) {
            waitingForFreshEntry = false;
            if (state === "playing") {
              resetActivePlayback();
            }
            return;
          }
          if (waitingForFreshEntry) {
            if (!wasVisible) waitingForFreshEntry = false;
            else return;
          }
          if (state === "playing" && video.paused) {
            resetActivePlayback();
          }
          if (state === "armed") void play();
        };

        const scheduleVisibilitySync = () => {
          if (recoveryFrame) window.cancelAnimationFrame(recoveryFrame);
          recoveryFrame = window.requestAnimationFrame(() => {
            recoveryFrame = window.requestAnimationFrame(() => {
              recoveryFrame = 0;
              if (!signal.aborted) syncVisibility();
            });
          });
        };

        const interruptForLifecycle = () => {
          if (state !== "playing") return;
          resetActivePlayback();
          stallRecoveries = 0;
          reloadPipelineOnResume = true;
        };

        const recoverAfterLifecycle = () => {
          if (document.hidden) return;
          if (reloadPipelineOnResume) {
            reloadPipelineOnResume = false;
            try {
              video.load();
            } catch {
              // The visibility sync below will still make a fresh play attempt.
            }
          }
          scheduleVisibilitySync();
        };

        video.addEventListener("playing", markFrameReady, { signal });
        video.addEventListener("timeupdate", () => {
          if (state === "playing" && video.currentTime > 0.025) {
            markFrameReady();
          }
        }, { signal });
        window.addEventListener("pointerdown", () => {
          if (sceneVisible && state === "armed") void play();
        }, { signal });
        window.addEventListener("wheel", () => {
          if (sceneVisible && state === "armed") void play();
        }, { passive: true, signal });
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            interruptForLifecycle();
            return;
          }
          recoverAfterLifecycle();
        }, { signal });
        window.addEventListener("pagehide", interruptForLifecycle, { signal });
        window.addEventListener("pageshow", recoverAfterLifecycle, { signal });
        window.addEventListener("focus", recoverAfterLifecycle, { signal });
        document.addEventListener("freeze", interruptForLifecycle, { signal });
        document.addEventListener("resume", recoverAfterLifecycle, { signal });

        if ("IntersectionObserver" in window) {
          this.observer = new IntersectionObserver((entries) => {
            const entry = entries[entries.length - 1];
            sceneVisible = Boolean(entry?.isIntersecting && entry.intersectionRatio >= 0.16);
            if (!sceneVisible) {
              waitingForFreshEntry = false;
              if (state === "playing") arm(false);
              return;
            }
            if (!waitingForFreshEntry && state === "armed") void play();
          }, { threshold: [0, 0.16, 0.42], rootMargin: "4% 0px 4%" });
          this.observer.observe(this);
        } else {
          sceneVisible = true;
          void play();
        }

        this.resetScene = () => arm(true);
        this.refreshScene = scheduleVisibilitySync;
        signal.addEventListener("abort", () => {
          generation += 1;
          clearPlaybackTimers();
          video.pause();
          if (recoveryFrame) window.cancelAnimationFrame(recoveryFrame);
          recoveryFrame = 0;
        }, { once: true });
      }

      disconnectedCallback() {
        this.controller?.abort();
        this.controller = null;
        this.observer?.disconnect();
        this.observer = null;
        this.resetScene = null;
        this.refreshScene = null;
      }
    }

    customElements.define("kisara-opening-memory-scene", KisaraOpeningMemoryScene);
  }
</script>
