---
import { Icon } from "astro-icon/components";

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;

const characters = [
  { id: "kisara", src: "/themes/kisara/assets/chibi/kisara.webp", label: "木更", width: 360, height: 458 },
  { id: "ayano", src: "/themes/kisara/assets/chibi/ayano.webp", label: "绫乃", width: 298, height: 472 },
  { id: "shu", src: "/themes/kisara/assets/chibi/shu.webp", label: "修", width: 354, height: 532 },
  { id: "sharon", src: "/themes/kisara/assets/chibi/sharon.webp", label: "莎朗", width: 392, height: 482 },
];
---

<section class:list={["kisara-chibi-stage", { "is-embedded": embedded }]} data-kisara-chibi-stage aria-label="Q 版角色互动舞台">
  <header class="kisara-chibi-heading">
    <span>AFTER HOURS / BAYRON CITY</span>
    <h2>散场之后<span>.</span></h2>
    <p>木更 / 绫乃 / 修 / 莎朗</p>
  </header>
  <div class="kisara-chibi-baseline" aria-hidden="true"></div>

  <div class="kisara-apple-cutscene" data-chibi-apple-cutscene aria-hidden="true">
    <span class="kisara-apple-wash"></span>
    <span class="kisara-apple-speedlines"><i></i><i></i><i></i></span>
    <span class="kisara-apple-media" data-chibi-apple-media>
      <video
        data-chibi-apple-video
        data-src="/themes/kisara/assets/effects/apple-throw.webm"
        width="740"
        height="540"
        muted
        playsinline
        preload="none"
      ></video>
      <img
        data-chibi-apple-fallback
        data-src="/themes/kisara/assets/effects/apple-throw.webp"
        width="640"
        height="468"
        alt=""
        draggable="false"
      />
    </span>
    <span class="kisara-apple-impact"><i></i></span>
  </div>

  <button
    class="kisara-chibi-reset"
    type="button"
    data-chibi-reset
    aria-label="复位 Q 版角色"
    title="复位角色"
  >
    <Icon name="tabler:refresh" aria-hidden="true" />
  </button>

  {characters.map((character) => (
    <button
      class="kisara-chibi"
      type="button"
      data-chibi={character.id}
      aria-label={`拖动${character.label}`}
      title={`拖动${character.label}靠近其他角色`}
      style={`--chibi-order: ${characters.indexOf(character)}`}
    >
      <span class="kisara-chibi-bubble" data-chibi-bubble aria-hidden="true"></span>
      <span class="kisara-chibi-arrival">
        <span class="kisara-chibi-figure">
          <img src={character.src} width={character.width} height={character.height} alt="" draggable="false" loading="lazy" decoding="async" />
        </span>
      </span>
      <span class="kisara-chibi-shadow" aria-hidden="true"></span>
      <span class="kisara-chibi-name" aria-hidden="true">{character.label}</span>
    </button>
  ))}

  <span class="sr-only" data-chibi-live aria-live="polite"></span>
</section>

<style>
  .kisara-chibi-stage {
    --scene-accent: 255, 91, 126;
    --apple-throw-wind: -5deg;
    --apple-throw-release: 7deg;
    --apple-throw-settle: -2deg;
    --apple-hit-far: 13px;
    --apple-hit-return: -5px;
    --apple-hit-settle: 3px;
    --apple-hit-tilt: 7deg;
    --apple-hit-return-tilt: -4deg;
    --apple-hit-settle-tilt: 2deg;
    position: relative;
    width: min(1240px, 100%);
    min-height: 520px;
    margin-inline: auto;
    overflow: clip;
    isolation: isolate;
    color: #34363a;
    background: #f4f5f6;
    user-select: none;
    -webkit-user-select: none;
  }

  .kisara-chibi-heading {
    position: absolute;
    inset: 24px 72px auto 24px;
    pointer-events: none;
  }

  .kisara-chibi-heading > span {
    color: #72767c;
    font: 12px/1.5 "Courier New", monospace;
  }

  .kisara-chibi-heading h2 {
    margin: 12px 0;
    font-size: 38px;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .kisara-chibi-heading h2 span { color: #aa3657; }
  .kisara-chibi-heading p { margin: 0; font-size: 12px; color: #72767c; }

  .kisara-chibi-baseline {
    position: absolute;
    inset: auto 24px 24px;
    height: 1px;
    background: #c7cbce;
  }

  .kisara-chibi-baseline::before {
    content: "";
    position: absolute;
    bottom: 0;
    width: 64px;
    height: 3px;
    background: #aa3657;
  }

  .kisara-chibi-stage:not([data-ready]) .kisara-chibi {
    top: auto;
    bottom: 38px;
    opacity: 1;
  }
  .kisara-chibi-stage:not([data-ready]) [data-chibi="kisara"] { left: 6%; }
  .kisara-chibi-stage:not([data-ready]) [data-chibi="ayano"] { left: 31%; }
  .kisara-chibi-stage:not([data-ready]) [data-chibi="shu"] { left: 58%; }
  .kisara-chibi-stage:not([data-ready]) [data-chibi="sharon"] { left: 79%; }

  .kisara-apple-cutscene {
    --apple-x: 50%;
    --apple-y: 50%;
    --apple-media-width: clamp(414px, 70%, 830px);
    --apple-direction: 1;
    --apple-entry-x: -42px;
    --apple-exit-x: 24px;
    --apple-impact-x: 70%;
    --apple-impact-y: 56%;
    position: absolute;
    z-index: 5;
    inset: 0;
    overflow: hidden;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease, visibility 0s linear 900ms;
  }

  .kisara-apple-cutscene.is-active {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }

  .kisara-apple-wash,
  .kisara-apple-speedlines,
  .kisara-apple-impact {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .kisara-apple-wash {
    z-index: 0;
    opacity: 0;
    background:
      radial-gradient(circle at var(--apple-impact-x) var(--apple-impact-y), rgba(255, 226, 236, 0.18), transparent 22%),
      linear-gradient(112deg, rgba(5, 7, 26, 0.04), rgba(5, 7, 26, 0.46) 44%, rgba(91, 7, 34, 0.22) 74%, rgba(5, 7, 26, 0.08));
  }

  .kisara-apple-cutscene.is-active .kisara-apple-wash {
    animation: kisara-apple-wash 940ms ease-out both;
  }

  .kisara-apple-speedlines {
    z-index: 1;
    opacity: 0;
    overflow: hidden;
    transform: scaleX(var(--apple-direction));
    transform-origin: center;
  }

  .kisara-apple-speedlines::before,
  .kisara-apple-speedlines::after,
  .kisara-apple-speedlines > i {
    position: absolute;
    content: "";
    height: 2px;
    border-radius: 999px;
    transform-origin: right center;
    background: linear-gradient(90deg, transparent, rgba(255, 216, 230, 0.2) 22%, rgba(255, 119, 158, 0.88) 72%, transparent);
    filter: drop-shadow(0 0 7px rgba(255, 73, 105, 0.46));
  }

  .kisara-apple-speedlines::before {
    top: 24%;
    right: -7%;
    width: 58%;
    transform: rotate(-11deg);
  }

  .kisara-apple-speedlines::after {
    right: -3%;
    bottom: 23%;
    width: 48%;
    transform: rotate(8deg);
  }

  .kisara-apple-speedlines > i:nth-child(1) {
    top: 36%;
    right: 4%;
    width: 34%;
    transform: rotate(-5deg);
  }

  .kisara-apple-speedlines > i:nth-child(2) {
    top: 51%;
    right: -5%;
    width: 66%;
    height: 3px;
    transform: rotate(2deg);
  }

  .kisara-apple-speedlines > i:nth-child(3) {
    right: 11%;
    bottom: 34%;
    width: 28%;
    transform: rotate(13deg);
  }

  .kisara-apple-cutscene.is-active .kisara-apple-speedlines {
    animation: kisara-apple-speedlines 820ms cubic-bezier(0.2, 0.72, 0.2, 1) both;
  }

  .kisara-apple-media {
    position: absolute;
    z-index: 2;
    top: var(--apple-y);
    left: var(--apple-x);
    display: block;
    width: var(--apple-media-width);
    max-width: none;
    aspect-ratio: 740 / 540;
    opacity: 0;
    transform: translate(-50%, -50%) translateX(var(--apple-entry-x)) scale(0.86);
    transform-origin: center;
    filter: blur(9px) brightness(1.28) saturate(1.08);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 0 42%, rgba(0, 0, 0, 0.94) 56%, rgba(0, 0, 0, 0.42) 71%, transparent 88%);
    mask-image: radial-gradient(ellipse at center, #000 0 42%, rgba(0, 0, 0, 0.94) 56%, rgba(0, 0, 0, 0.42) 71%, transparent 88%);
    will-change: transform, opacity, filter;
  }

  .kisara-apple-media video,
  .kisara-apple-media img {
    position: absolute;
    inset: 0;
    display: none;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: contrast(1.035) saturate(1.06) drop-shadow(0 22px 28px rgba(9, 1, 20, 0.38));
    transform: scaleX(var(--apple-direction));
    transform-origin: center;
  }

  .kisara-apple-cutscene[data-renderer="video"] .kisara-apple-media video,
  .kisara-apple-cutscene[data-renderer="fallback"] .kisara-apple-media img {
    display: block;
  }

  .kisara-apple-cutscene.is-active .kisara-apple-media {
    animation: kisara-apple-media 840ms cubic-bezier(0.16, 0.82, 0.22, 1) both;
  }

  .kisara-apple-impact {
    z-index: 3;
    top: var(--apple-impact-y);
    left: var(--apple-impact-x);
    width: 84px;
    height: 84px;
    margin: -42px 0 0 -42px;
    inset: auto;
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.25) rotate(-12deg);
  }

  .kisara-apple-impact::before,
  .kisara-apple-impact::after,
  .kisara-apple-impact > i {
    position: absolute;
    content: "";
    pointer-events: none;
  }

  .kisara-apple-impact::before {
    inset: 17%;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0 9%, #ffdce7 10% 22%, rgba(255, 82, 124, 0.88) 34%, transparent 72%);
    box-shadow: 0 0 32px rgba(255, 74, 116, 0.82), 0 0 72px rgba(255, 73, 105, 0.38);
  }

  .kisara-apple-impact::after {
    inset: -22%;
    border: 2px solid rgba(255, 206, 221, 0.74);
    border-radius: 50%;
    box-shadow: inset 0 0 18px rgba(255, 73, 105, 0.22), 0 0 24px rgba(255, 73, 105, 0.3);
  }

  .kisara-apple-impact > i {
    top: 50%;
    left: 50%;
    width: 170px;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(255, 232, 240, 0.95), transparent);
    box-shadow: 0 -19px 0 -0.5px rgba(255, 132, 165, 0.52), 0 21px 0 -0.5px rgba(255, 132, 165, 0.38);
    transform: translate(-50%, -50%) rotate(-13deg);
  }

  .kisara-chibi-stage.is-apple-impact .kisara-apple-impact {
    animation: kisara-apple-impact 520ms cubic-bezier(0.12, 0.8, 0.2, 1) both;
  }

  .kisara-chibi-stage[data-apple-playing="true"] .kisara-chibi {
    pointer-events: none;
  }

  .kisara-chibi-stage[data-apple-playing="true"] .kisara-chibi.is-apple-focus {
    z-index: 7;
  }

  .kisara-chibi-stage[data-apple-playing="true"] .kisara-chibi:not(.is-apple-focus) .kisara-chibi-figure {
    opacity: 0.34;
    filter: blur(1.2px) saturate(0.58) brightness(0.66);
    transform: translateY(4px) scale(0.97);
  }

  .kisara-chibi.is-apple-throw .kisara-chibi-figure {
    animation: kisara-chibi-apple-throw 720ms cubic-bezier(0.16, 0.82, 0.24, 1) both;
  }

  .kisara-chibi.is-apple-hit .kisara-chibi-figure {
    animation: kisara-chibi-apple-hit 680ms cubic-bezier(0.12, 0.86, 0.2, 1) both;
  }

  @keyframes kisara-apple-wash {
    0% { opacity: 0; }
    18% { opacity: 1; }
    72% { opacity: 0.88; }
    100% { opacity: 0; }
  }

  @keyframes kisara-apple-speedlines {
    0% { opacity: 0; transform: scaleX(var(--apple-direction)) translateX(-8%); }
    24% { opacity: 0.2; }
    54% { opacity: 0.92; }
    100% { opacity: 0; transform: scaleX(var(--apple-direction)) translateX(13%); }
  }

  @keyframes kisara-apple-media {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) translateX(var(--apple-entry-x)) scale(0.86) skewX(-2deg);
      filter: blur(9px) brightness(1.28) saturate(1.08);
    }
    14% {
      opacity: 1;
      filter: blur(1.5px) brightness(1.06) saturate(1.08);
    }
    62% {
      opacity: 1;
      transform: translate(-50%, -50%) translateX(0) scale(1);
      filter: blur(0) brightness(1.02) saturate(1.08);
    }
    78% {
      opacity: 1;
      filter: blur(0.6px) brightness(1.32) saturate(1.22);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) translateX(var(--apple-exit-x)) scale(1.055);
      filter: blur(3px) brightness(1.5) saturate(1.22);
    }
  }

  @keyframes kisara-apple-impact {
    0% { opacity: 0; transform: scale(0.2) rotate(-14deg); }
    24% { opacity: 1; transform: scale(1.12) rotate(0); }
    54% { opacity: 0.86; transform: scale(1.7) rotate(8deg); }
    100% { opacity: 0; transform: scale(2.5) rotate(13deg); }
  }

  @keyframes kisara-chibi-apple-throw {
    0% { transform: translateY(0) rotate(0) scale(1); }
    26% { transform: translateY(-6px) rotate(var(--apple-throw-wind)) scale(1.035, 0.98); }
    54% { transform: translateY(-2px) rotate(var(--apple-throw-release)) scale(0.98, 1.035); }
    76% { transform: translateY(-4px) rotate(var(--apple-throw-settle)) scale(1.015); }
    100% { transform: translateY(0) rotate(0) scale(1); }
  }

  @keyframes kisara-chibi-apple-hit {
    0% { transform: translate(0, 0) rotate(0) scale(1); }
    18% { transform: translate(var(--apple-hit-far), -3px) rotate(var(--apple-hit-tilt)) scale(0.96, 1.04); }
    42% { transform: translate(var(--apple-hit-return), 1px) rotate(var(--apple-hit-return-tilt)) scale(1.03, 0.97); }
    68% { transform: translate(var(--apple-hit-settle), -2px) rotate(var(--apple-hit-settle-tilt)); }
    100% { transform: translate(0, 0) rotate(0) scale(1); }
  }

  .kisara-chibi-reset {
    position: absolute;
    z-index: 8;
    top: 20px;
    right: 14px;
    display: grid;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    color: #575d63;
    border: 1px solid #c7cbce;
    border-radius: 6px;
    background: #fff;
    cursor: pointer;
    transition: color 160ms ease, background 160ms ease;
  }

  .kisara-chibi-reset :global(svg) {
    width: 17px;
    height: 17px;
    transition: transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .kisara-chibi-reset:focus-visible {
    color: #aa3657;
    outline: 2px solid #aa3657;
    outline-offset: 3px;
    background: #fff;
  }

  @media (hover: hover) and (pointer: fine) {
    .kisara-chibi-reset:hover { color: #aa3657; background: #f9edf1; }
    .kisara-chibi-reset:hover :global(svg) { transform: rotate(-90deg); }
  }

  .kisara-chibi {
    --chibi-x: 0px;
    --chibi-y: 0px;
    --drag-tilt: 0deg;
    --chibi-acrylic: 255, 116, 161;
    position: absolute;
    z-index: 3;
    top: 0;
    left: 0;
    display: block;
    width: clamp(124px, calc(14.2vw / var(--kisara-scale, 1)), 176px);
    padding: 0;
    color: inherit;
    border: 0;
    background: transparent;
    transform: translate3d(var(--chibi-x), var(--chibi-y), 0);
    isolation: isolate;
    touch-action: none;
    cursor: grab;
    opacity: 0;
  }

  .kisara-chibi::before,
  .kisara-chibi::after {
    position: absolute;
    content: "";
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 220ms ease,
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kisara-chibi::before {
    z-index: 0;
    inset: 8% -3% 4%;
    border-bottom: 2px solid rgb(var(--chibi-acrylic));
    transform: scaleX(.8);
  }

  .kisara-chibi::after {
    z-index: 4;
    top: 50%;
    left: 50%;
    width: auto;
    height: 84%;
    aspect-ratio: 1;
    border: 1px dashed rgba(var(--chibi-acrylic), .65);
    border-radius: 8px;
    transform: translate(-50%, -50%) scale(0.78);
  }

  .kisara-chibi[data-chibi="kisara"] {
    --chibi-acrylic: 255, 113, 164;
    aspect-ratio: 180 / 229;
  }

  .kisara-chibi[data-chibi="ayano"] {
    --chibi-acrylic: 104, 156, 255;
    width: clamp(112px, calc(12.7vw / var(--kisara-scale, 1)), 158px);
    aspect-ratio: 149 / 236;
  }

  .kisara-chibi[data-chibi="sharon"] {
    --chibi-acrylic: 177, 139, 255;
    width: clamp(132px, calc(15.2vw / var(--kisara-scale, 1)), 188px);
    aspect-ratio: 196 / 241;
  }

  .kisara-chibi[data-chibi="shu"] {
    --chibi-acrylic: 124, 181, 150;
    width: clamp(112px, calc(12.8vw / var(--kisara-scale, 1)), 158px);
    aspect-ratio: 177 / 266;
  }

  .kisara-chibi-stage[data-ready="true"] .kisara-chibi {
    opacity: 1;
    transition: opacity 320ms ease;
  }

  .kisara-chibi.is-snapping {
    transition: transform 520ms cubic-bezier(0.16, 1.25, 0.3, 1), opacity 220ms ease;
  }

  .kisara-chibi.is-dragging {
    z-index: 7;
    cursor: grabbing;
    will-change: transform;
  }

  .kisara-chibi:focus-visible {
    outline: 2px solid #aa3657;
    outline-offset: 5px;
  }

  .kisara-chibi:focus-visible::before {
    opacity: 1;
    transform: scale(1);
  }

  .kisara-chibi:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .kisara-chibi:focus-visible .kisara-chibi-figure {
    transform: translateY(-7px) scale(1.035);
  }

  .kisara-chibi-figure {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    isolation: isolate;
    transform-origin: 50% 92%;
    filter: drop-shadow(0 4px 2px rgba(30, 32, 36, .14));
    transition:
      transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 220ms ease;
  }

  .kisara-chibi-arrival { display: block; width: 100%; height: 100%; }

  .kisara-chibi-figure img {
    position: relative;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  .kisara-chibi-name {
    position: absolute;
    right: 0;
    bottom: -18px;
    left: 0;
    color: #575d63;
    font-size: 11px;
    line-height: 18px;
    text-align: center;
    opacity: .7;
    pointer-events: none;
  }

  .kisara-chibi:is(:focus-visible, .is-dragging) .kisara-chibi-name {
    color: #aa3657;
    opacity: 1;
  }

  .kisara-chibi-stage:not([data-stage-visible]) *,
  .kisara-chibi-stage:not([data-stage-visible]) *::before,
  .kisara-chibi-stage:not([data-stage-visible]) *::after {
    animation-play-state: paused !important;
  }

  .kisara-chibi.is-dragging .kisara-chibi-figure {
    transform: translateY(-13px) rotate(var(--drag-tilt)) scale(1.055);
    transition: transform 90ms linear;
  }

  .kisara-chibi.is-speaking .kisara-chibi-figure {
    animation: kisara-chibi-speak 520ms cubic-bezier(0.16, 1.25, 0.3, 1);
  }

  .kisara-chibi.is-speaking .kisara-chibi-shadow {
    animation: kisara-chibi-shadow-speak 520ms cubic-bezier(0.16, 1.25, 0.3, 1);
  }

  .kisara-chibi.is-dropped .kisara-chibi-figure {
    animation: kisara-chibi-drop 560ms cubic-bezier(0.16, 1.3, 0.3, 1);
  }

  .kisara-chibi.is-dropped .kisara-chibi-shadow {
    animation: kisara-chibi-shadow-drop 560ms cubic-bezier(0.16, 1.3, 0.3, 1);
  }

  .kisara-chibi-shadow {
    position: absolute;
    z-index: 1;
    right: 22%;
    bottom: -4px;
    left: 22%;
    height: 10px;
    border-radius: 50%;
    background: rgba(0, 0, 16, 0.32);
    pointer-events: none;
    transform: scaleX(0.78);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .kisara-chibi.is-dragging .kisara-chibi-shadow {
    opacity: 0.42;
    transform: scaleX(0.54);
  }

  @media (hover: hover) and (pointer: fine) {
    .kisara-chibi:hover:not(.is-dragging)::before {
      opacity: 1;
      transform: scale(1);
    }

    .kisara-chibi:hover:not(.is-dragging)::after {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    .kisara-chibi:hover:not(.is-dragging) .kisara-chibi-figure {
      transform: translateY(-7px) scale(1.035);
    }

    .kisara-chibi:hover:not(.is-dragging) .kisara-chibi-shadow {
      opacity: 0.68;
      transform: scaleX(0.62);
    }
  }

  .kisara-chibi-bubble {
    position: absolute;
    z-index: 9;
    top: -24%;
    left: 50%;
    display: grid;
    min-width: 58px;
