---
import { Icon } from "astro-icon/components";

const characters = [
  { id: "kisara", src: "/themes/kisara/assets/chibi/kisara.webp", label: "木更" },
  { id: "ayano", src: "/themes/kisara/assets/chibi/ayano.webp", label: "绫乃" },
  { id: "shu", src: "/themes/kisara/assets/chibi/shu.webp", label: "修" },
  { id: "sharon", src: "/themes/kisara/assets/chibi/sharon.webp", label: "莎朗" },
];
---

<section class="kisara-chibi-stage" data-kisara-chibi-stage aria-label="Q 版角色互动舞台">
  <div class="kisara-chibi-city" aria-hidden="true">
    <span class="kisara-chibi-city-copy"><b>BAYRON CITY</b><small>CONTRACT STAGE / CHANNEL 03</small></span>
    <i class="kisara-chibi-skyline is-back"></i>
    <i class="kisara-chibi-skyline is-front"></i>
    <span class="kisara-chibi-beacon"><i></i></span>
  </div>
  <div class="kisara-chibi-ambient" aria-hidden="true">
    <i></i><i></i><i></i>
  </div>
  <div class="kisara-chibi-floor" aria-hidden="true"><span></span></div>

  <div class="kisara-apple-cutscene" data-chibi-apple-cutscene aria-hidden="true">
    <span class="kisara-apple-wash"></span>
    <span class="kisara-apple-speedlines"><i></i><i></i><i></i></span>
    <span class="kisara-apple-media" data-chibi-apple-media>
      <video
        data-chibi-apple-video
        data-src="/themes/kisara/assets/effects/apple-throw.webm"
        width="740"
        height="540"
        muted
        playsinline
        preload="none"
      ></video>
      <img
        data-chibi-apple-fallback
        data-src="/themes/kisara/assets/effects/apple-throw.webp"
        width="640"
        height="468"
        alt=""
        draggable="false"
      />
    </span>
    <span class="kisara-apple-impact"><i></i></span>
  </div>

  <button
    class="kisara-chibi-reset"
    type="button"
    data-chibi-reset
    aria-label="复位 Q 版角色"
    title="复位角色"
  >
    <Icon name="tabler:refresh" aria-hidden="true" />
  </button>

  {characters.map((character) => (
    <button
      class="kisara-chibi"
      type="button"
      data-chibi={character.id}
      aria-label={`拖动${character.label}`}
      title={`拖动${character.label}靠近其他角色`}
    >
      <span class="kisara-chibi-bubble" data-chibi-bubble aria-hidden="true"></span>
      <span class="kisara-chibi-figure">
        <img src={character.src} alt="" draggable="false" loading="lazy" decoding="async" />
      </span>
      <span class="kisara-chibi-shadow" aria-hidden="true"></span>
    </button>
  ))}

  <span class="sr-only" data-chibi-live aria-live="polite"></span>
</section>

<style>
  .kisara-chibi-stage {
    --scene-accent: 255, 91, 126;
    --apple-throw-wind: -5deg;
    --apple-throw-release: 7deg;
    --apple-throw-settle: -2deg;
    --apple-hit-far: 13px;
    --apple-hit-return: -5px;
    --apple-hit-settle: 3px;
    --apple-hit-tilt: 7deg;
    --apple-hit-return-tilt: -4deg;
    --apple-hit-settle-tilt: 2deg;
    position: relative;
    width: min(1240px, 100%);
    min-height: clamp(430px, 48vw, 560px);
    margin-inline: auto;
    overflow: clip;
    isolation: isolate;
    background: linear-gradient(180deg, rgba(18, 24, 58, 0.12), transparent 42%, rgba(3, 6, 24, 0.2));
    user-select: none;
    -webkit-user-select: none;
  }

  .kisara-chibi-stage::before {
    position: absolute;
    z-index: -2;
    inset: 4% 3% 1%;
    content: "";
    background:
      linear-gradient(116deg, transparent 15%, rgba(255, 105, 146, 0.055) 15.2%, transparent 15.7% 47%, rgba(121, 155, 255, 0.05) 47.2%, transparent 47.7% 78%, rgba(255, 211, 129, 0.04) 78.2%, transparent 78.7%),
      linear-gradient(180deg, transparent 52%, rgba(94, 114, 192, 0.035));
    transition: background 500ms ease;
  }

  .kisara-chibi-stage::after {
    position: absolute;
    z-index: -1;
    right: 3%;
    bottom: 10.5%;
    left: 3%;
    height: 1px;
    content: "";
    background: linear-gradient(90deg, transparent, rgba(255, 103, 137, 0.58) 18%, rgba(141, 170, 255, 0.38) 52%, rgba(255, 103, 137, 0.58) 82%, transparent);
    box-shadow: 0 0 18px rgba(var(--scene-accent), 0.28);
  }

  .kisara-chibi-city {
    position: absolute;
    z-index: -2;
    inset: 3% 2% 9%;
    overflow: hidden;
    color: #91b1ff;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 8%, #000 95%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 8%, #000 95%, transparent);
  }

  .kisara-chibi-city::before,
  .kisara-chibi-city::after {
    position: absolute;
    content: "";
    pointer-events: none;
  }

  .kisara-chibi-city::before {
    right: 0;
    bottom: 22%;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(145, 177, 255, 0.24) 18%, rgba(255, 94, 137, 0.4) 52%, rgba(145, 177, 255, 0.24) 82%, transparent);
    box-shadow: 0 0 24px rgba(255, 73, 105, 0.12);
  }

  .kisara-chibi-city::after {
    inset: 6% 0 20%;
    opacity: 0.24;
    background:
      linear-gradient(rgba(145, 177, 255, 0.08) 1px, transparent 1px) 0 0 / 100% 48px,
      linear-gradient(90deg, rgba(145, 177, 255, 0.06) 1px, transparent 1px) 0 0 / 64px 100%;
    -webkit-mask-image: linear-gradient(180deg, #000, transparent 86%);
    mask-image: linear-gradient(180deg, #000, transparent 86%);
  }

  .kisara-chibi-city-copy {
    position: absolute;
    z-index: 0;
    top: 7%;
    left: 2.5%;
    display: grid;
    gap: 7px;
    color: rgba(168, 184, 239, 0.38);
    font: 800 0.55rem/1 "Courier New", Courier, monospace;
  }

  .kisara-chibi-city-copy b {
    color: rgba(130, 151, 220, 0.075);
    font: 400 clamp(4.8rem, 10vw, 8.6rem)/0.78 Georgia, "Times New Roman", serif;
  }

  .kisara-chibi-city-copy small {
    padding-left: 5px;
    font: inherit;
  }

  .kisara-chibi-skyline {
    position: absolute;
    right: -1%;
    bottom: 3%;
    left: -1%;
    display: block;
    transform-origin: bottom;
  }

  .kisara-chibi-skyline::after {
    position: absolute;
    inset: 18% 0 7%;
    content: "";
    opacity: 0.34;
    background:
      repeating-linear-gradient(90deg, transparent 0 17px, rgba(205, 218, 255, 0.34) 17px 19px, transparent 19px 36px),
      repeating-linear-gradient(180deg, transparent 0 15px, rgba(255, 111, 151, 0.24) 15px 17px, transparent 17px 32px);
    mix-blend-mode: screen;
  }

  .kisara-chibi-skyline.is-back {
    height: 31%;
    opacity: 0.52;
    background: linear-gradient(180deg, #1e2857, #0b1029);
    clip-path: polygon(0 100%, 0 63%, 4% 63%, 4% 39%, 8% 39%, 8% 70%, 13% 70%, 13% 27%, 17% 27%, 17% 58%, 23% 58%, 23% 44%, 29% 44%, 29% 73%, 34% 73%, 34% 31%, 39% 31%, 39% 64%, 45% 64%, 45% 19%, 49% 19%, 49% 67%, 56% 67%, 56% 38%, 61% 38%, 61% 72%, 67% 72%, 67% 26%, 72% 26%, 72% 61%, 78% 61%, 78% 41%, 83% 41%, 83% 69%, 89% 69%, 89% 30%, 94% 30%, 94% 58%, 100% 58%, 100% 100%);
  }

  .kisara-chibi-skyline.is-front {
    height: 22%;
    opacity: 0.82;
    background: linear-gradient(180deg, #11183a, #070a1c);
    clip-path: polygon(0 100%, 0 54%, 6% 54%, 6% 23%, 11% 23%, 11% 68%, 19% 68%, 19% 39%, 26% 39%, 26% 74%, 34% 74%, 34% 17%, 40% 17%, 40% 61%, 49% 61%, 49% 34%, 56% 34%, 56% 72%, 64% 72%, 64% 24%, 70% 24%, 70% 58%, 78% 58%, 78% 31%, 85% 31%, 85% 69%, 92% 69%, 92% 20%, 97% 20%, 97% 56%, 100% 56%, 100% 100%);
  }

  .kisara-chibi-beacon {
    position: absolute;
    z-index: 1;
    right: 15%;
    bottom: 23%;
    width: 1px;
    height: 33%;
    background: linear-gradient(180deg, rgba(255, 88, 132, 0.7), rgba(145, 177, 255, 0.18) 62%, transparent);
  }

  .kisara-chibi-beacon::before,
  .kisara-chibi-beacon::after {
    position: absolute;
    top: -4px;
    left: 50%;
    content: "";
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .kisara-chibi-beacon::before {
    width: 7px;
    height: 7px;
    background: #ff5b82;
    box-shadow: 0 0 12px rgba(255, 73, 105, 0.82);
    animation: kisara-chibi-beacon 1.8s ease-in-out infinite;
  }

  .kisara-chibi-beacon::after {
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 104, 143, 0.22);
    animation: kisara-chibi-beacon-ring 2.8s ease-out infinite;
  }

  .kisara-chibi-beacon > i {
    position: absolute;
    top: 31%;
    left: -23px;
    width: 47px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(145, 177, 255, 0.32), transparent);
  }

  .kisara-chibi-ambient {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
  }

  .kisara-chibi-ambient i {
    position: absolute;
    top: 7%;
    width: 1px;
    height: 68%;
    transform-origin: 50% 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.2), rgba(var(--scene-accent), 0.035) 45%, transparent);
    filter: blur(0.2px);
    opacity: 0.42;
  }

  .kisara-chibi-ambient i:nth-child(1) { left: 19%; transform: rotate(13deg); }
  .kisara-chibi-ambient i:nth-child(2) { left: 50%; transform: rotate(-4deg); opacity: 0.28; }
  .kisara-chibi-ambient i:nth-child(3) { right: 17%; transform: rotate(-14deg); }

  .kisara-chibi-floor {
    position: absolute;
    z-index: -1;
    right: 6%;
    bottom: 1.5%;
    left: 6%;
    height: 24%;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(var(--scene-accent), 0.105), rgba(67, 84, 145, 0.035) 45%, transparent 72%);
    transform: perspective(300px) rotateX(67deg);
    filter: blur(1px);
    pointer-events: none;
  }

  .kisara-chibi-floor span {
    position: absolute;
    inset: 15% 8%;
    border: 1px solid rgba(160, 180, 255, 0.11);
    border-radius: 50%;
  }

  .kisara-apple-cutscene {
    --apple-x: 50%;
    --apple-y: 50%;
    --apple-media-width: clamp(414px, 70%, 830px);
    --apple-direction: 1;
    --apple-entry-x: -42px;
    --apple-exit-x: 24px;
    --apple-impact-x: 70%;
    --apple-impact-y: 56%;
    position: absolute;
    z-index: 5;
    inset: 0;
    overflow: hidden;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease, visibility 0s linear 900ms;
  }

  .kisara-apple-cutscene.is-active {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }

  .kisara-apple-wash,
  .kisara-apple-speedlines,
  .kisara-apple-impact {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .kisara-apple-wash {
    z-index: 0;
    opacity: 0;
    background:
      radial-gradient(circle at var(--apple-impact-x) var(--apple-impact-y), rgba(255, 226, 236, 0.18), transparent 22%),
      linear-gradient(112deg, rgba(5, 7, 26, 0.04), rgba(5, 7, 26, 0.46) 44%, rgba(91, 7, 34, 0.22) 74%, rgba(5, 7, 26, 0.08));
  }

  .kisara-apple-cutscene.is-active .kisara-apple-wash {
    animation: kisara-apple-wash 940ms ease-out both;
  }

  .kisara-apple-speedlines {
    z-index: 1;
    opacity: 0;
    overflow: hidden;
    transform: scaleX(var(--apple-direction));
    transform-origin: center;
  }

  .kisara-apple-speedlines::before,
  .kisara-apple-speedlines::after,
  .kisara-apple-speedlines > i {
    position: absolute;
    content: "";
    height: 2px;
    border-radius: 999px;
    transform-origin: right center;
    background: linear-gradient(90deg, transparent, rgba(255, 216, 230, 0.2) 22%, rgba(255, 119, 158, 0.88) 72%, transparent);
    filter: drop-shadow(0 0 7px rgba(255, 73, 105, 0.46));
  }

  .kisara-apple-speedlines::before {
    top: 24%;
    right: -7%;
    width: 58%;
    transform: rotate(-11deg);
  }

  .kisara-apple-speedlines::after {
    right: -3%;
    bottom: 23%;
    width: 48%;
    transform: rotate(8deg);
  }

  .kisara-apple-speedlines > i:nth-child(1) {
    top: 36%;
    right: 4%;
    width: 34%;
    transform: rotate(-5deg);
  }

  .kisara-apple-speedlines > i:nth-child(2) {
    top: 51%;
    right: -5%;
    width: 66%;
    height: 3px;
    transform: rotate(2deg);
  }

  .kisara-apple-speedlines > i:nth-child(3) {
    right: 11%;
    bottom: 34%;
    width: 28%;
    transform: rotate(13deg);
  }

  .kisara-apple-cutscene.is-active .kisara-apple-speedlines {
    animation: kisara-apple-speedlines 820ms cubic-bezier(0.2, 0.72, 0.2, 1) both;
  }

  .kisara-apple-media {
    position: absolute;
    z-index: 2;
    top: var(--apple-y);
    left: var(--apple-x);
    display: block;
    width: var(--apple-media-width);
    max-width: none;
    aspect-ratio: 740 / 540;
    opacity: 0;
    transform: translate(-50%, -50%) translateX(var(--apple-entry-x)) scale(0.86);
    transform-origin: center;
    filter: blur(9px) brightness(1.28) saturate(1.08);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 0 42%, rgba(0, 0, 0, 0.94) 56%, rgba(0, 0, 0, 0.42) 71%, transparent 88%);
    mask-image: radial-gradient(ellipse at center, #000 0 42%, rgba(0, 0, 0, 0.94) 56%, rgba(0, 0, 0, 0.42) 71%, transparent 88%);
    will-change: transform, opacity, filter;
  }

  .kisara-apple-media video,
  .kisara-apple-media img {
    position: absolute;
    inset: 0;
    display: none;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: contrast(1.035) saturate(1.06) drop-shadow(0 22px 28px rgba(9, 1, 20, 0.38));
    transform: scaleX(var(--apple-direction));
    transform-origin: center;
  }

  .kisara-apple-cutscene[data-renderer="video"] .kisara-apple-media video,
  .kisara-apple-cutscene[data-renderer="fallback"] .kisara-apple-media img {
    display: block;
  }

  .kisara-apple-cutscene.is-active .kisara-apple-media {
    animation: kisara-apple-media 840ms cubic-bezier(0.16, 0.82, 0.22, 1) both;
  }

  .kisara-apple-impact {
    z-index: 3;
    top: var(--apple-impact-y);
    left: var(--apple-impact-x);
    width: 84px;
    height: 84px;
    margin: -42px 0 0 -42px;
    inset: auto;
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.25) rotate(-12deg);
  }

  .kisara-apple-impact::before,
  .kisara-apple-impact::after,
  .kisara-apple-impact > i {
    position: absolute;
    content: "";
    pointer-events: none;
  }

  .kisara-apple-impact::before {
    inset: 17%;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0 9%, #ffdce7 10% 22%, rgba(255, 82, 124, 0.88) 34%, transparent 72%);
    box-shadow: 0 0 32px rgba(255, 74, 116, 0.82), 0 0 72px rgba(255, 73, 105, 0.38);
  }

  .kisara-apple-impact::after {
    inset: -22%;
    border: 2px solid rgba(255, 206, 221, 0.74);
    border-radius: 50%;
    box-shadow: inset 0 0 18px rgba(255, 73, 105, 0.22), 0 0 24px rgba(255, 73, 105, 0.3);
  }

  .kisara-apple-impact > i {
    top: 50%;
    left: 50%;
    width: 170px;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(255, 232, 240, 0.95), transparent);
    box-shadow: 0 -19px 0 -0.5px rgba(255, 132, 165, 0.52), 0 21px 0 -0.5px rgba(255, 132, 165, 0.38);
    transform: translate(-50%, -50%) rotate(-13deg);
  }

  .kisara-chibi-stage.is-apple-impact .kisara-apple-impact {
    animation: kisara-apple-impact 520ms cubic-bezier(0.12, 0.8, 0.2, 1) both;
  }

  .kisara-chibi-stage[data-apple-playing="true"] .kisara-chibi {
    pointer-events: none;
  }

  .kisara-chibi-stage[data-apple-playing="true"] .kisara-chibi.is-apple-focus {
    z-index: 7;
  }

  .kisara-chibi-stage[data-apple-playing="true"] .kisara-chibi:not(.is-apple-focus) .kisara-chibi-figure {
    opacity: 0.34;
    filter: blur(1.2px) saturate(0.58) brightness(0.66);
    transform: translateY(4px) scale(0.97);
  }

  .kisara-chibi.is-apple-throw .kisara-chibi-figure {
    animation: kisara-chibi-apple-throw 720ms cubic-bezier(0.16, 0.82, 0.24, 1) both;
  }

  .kisara-chibi.is-apple-hit .kisara-chibi-figure {
    animation: kisara-chibi-apple-hit 680ms cubic-bezier(0.12, 0.86, 0.2, 1) both;
  }

  @keyframes kisara-apple-wash {
    0% { opacity: 0; }
    18% { opacity: 1; }
    72% { opacity: 0.88; }
    100% { opacity: 0; }
  }

  @keyframes kisara-apple-speedlines {
    0% { opacity: 0; transform: scaleX(var(--apple-direction)) translateX(-8%); }
    24% { opacity: 0.2; }
    54% { opacity: 0.92; }
    100% { opacity: 0; transform: scaleX(var(--apple-direction)) translateX(13%); }
  }

  @keyframes kisara-apple-media {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) translateX(var(--apple-entry-x)) scale(0.86) skewX(-2deg);
      filter: blur(9px) brightness(1.28) saturate(1.08);
    }
    14% {
      opacity: 1;
      filter: blur(1.5px) brightness(1.06) saturate(1.08);
    }
    62% {
      opacity: 1;
      transform: translate(-50%, -50%) translateX(0) scale(1);
      filter: blur(0) brightness(1.02) saturate(1.08);
    }
    78% {
      opacity: 1;
      filter: blur(0.6px) brightness(1.32) saturate(1.22);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) translateX(var(--apple-exit-x)) scale(1.055);
      filter: blur(3px) brightness(1.5) saturate(1.22);
    }
  }

  @keyframes kisara-apple-impact {
    0% { opacity: 0; transform: scale(0.2) rotate(-14deg); }
    24% { opacity: 1; transform: scale(1.12) rotate(0); }
    54% { opacity: 0.86; transform: scale(1.7) rotate(8deg); }
    100% { opacity: 0; transform: scale(2.5) rotate(13deg); }
  }

  @keyframes kisara-chibi-apple-throw {
    0% { transform: translateY(0) rotate(0) scale(1); }
    26% { transform: translateY(-6px) rotate(var(--apple-throw-wind)) scale(1.035, 0.98); }
    54% { transform: translateY(-2px) rotate(var(--apple-throw-release)) scale(0.98, 1.035); }
    76% { transform: translateY(-4px) rotate(var(--apple-throw-settle)) scale(1.015); }
    100% { transform: translateY(0) rotate(0) scale(1); }
  }

  @keyframes kisara-chibi-apple-hit {
    0% { transform: translate(0, 0) rotate(0) scale(1); }
    18% { transform: translate(var(--apple-hit-far), -3px) rotate(var(--apple-hit-tilt)) scale(0.96, 1.04); }
    42% { transform: translate(var(--apple-hit-return), 1px) rotate(var(--apple-hit-return-tilt)) scale(1.03, 0.97); }
    68% { transform: translate(var(--apple-hit-settle), -2px) rotate(var(--apple-hit-settle-tilt)); }
    100% { transform: translate(0, 0) rotate(0) scale(1); }
  }

  .kisara-chibi-reset {
    position: absolute;
    z-index: 8;
    top: 20px;
    right: 14px;
    display: grid;
    width: 38px;
    height: 38px;
    padding: 0;
    place-items: center;
    color: rgba(224, 230, 255, 0.7);
    border: 0;
    border-radius: 50%;
    background: rgba(20, 25, 55, 0.38);
    box-shadow: inset 0 0 0 1px rgba(162, 181, 255, 0.15), 0 8px 26px rgba(1, 3, 16, 0.2);
    backdrop-filter: blur(12px) saturate(1.25);
    cursor: pointer;
    transition: color 180ms ease, background 180ms ease, transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kisara-chibi-reset :global(svg) {
    width: 17px;
    height: 17px;
    transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kisara-chibi-reset:hover,
  .kisara-chibi-reset:focus-visible {
    color: #fff;
    outline: none;
    background: rgba(255, 73, 105, 0.2);
    transform: translateY(-2px);
  }

  .kisara-chibi-reset:hover :global(svg),
  .kisara-chibi-reset:focus-visible :global(svg) { transform: rotate(-180deg); }

  .kisara-chibi {
    --chibi-x: 0px;
    --chibi-y: 0px;
    --drag-tilt: 0deg;
    --chibi-acrylic: 255, 116, 161;
    position: absolute;
    z-index: 3;
    top: 0;
    left: 0;
    display: block;
    width: clamp(124px, 14.2vw, 176px);
    padding: 0;
    color: inherit;
    border: 0;
    background: transparent;
    transform: translate3d(var(--chibi-x), var(--chibi-y), 0);
    isolation: isolate;
    touch-action: none;
    cursor: grab;
    opacity: 0;
    will-change: transform;
  }

  .kisara-chibi::before,
  .kisara-chibi::after {
    position: absolute;
    content: "";
    pointer-events: none;
