---
import { Icon } from "astro-icon/components";
import {
  KISARA_AUDIO_LEGACY_STORAGE_KEY,
  KISARA_AUDIO_STORAGE_KEY,
  KISARA_AUDIO_VOLUME,
  kisaraAudioTracks
} from "../lib/audio";

const audioConfig = {
  tracks: kisaraAudioTracks,
  storageKey: KISARA_AUDIO_STORAGE_KEY,
  legacyStorageKey: KISARA_AUDIO_LEGACY_STORAGE_KEY,
  volume: KISARA_AUDIO_VOLUME
};
---

<div class="kisara-audio-player" data-kisara-audio-player transition:persist="kisara-audio-player">
  <audio data-kisara-theme-audio preload="auto" playsinline></audio>

  <button
    class="kisara-audio-control"
    type="button"
    data-kisara-audio-control
    data-state="loading"
    aria-label="播放主题音乐《対策完了》"
    aria-pressed="false"
    title="播放主题音乐《対策完了》"
  >
    <span class="kisara-audio-emblem" aria-hidden="true">
      <Icon class="kisara-audio-icon kisara-audio-icon-play" name="tabler:player-play" />
      <Icon class="kisara-audio-icon kisara-audio-icon-pause" name="tabler:player-pause" />
      <span class="kisara-audio-bars"><i></i><i></i><i></i><i></i><i></i></span>
    </span>
    <span class="kisara-audio-copy">
      <strong data-kisara-audio-title>対策完了</strong>
      <small data-kisara-audio-status aria-live="polite">01 / 08 · LINKING</small>
      <span class="kisara-audio-trace" aria-hidden="true"><i></i></span>
    </span>
  </button>

  <div class="kisara-audio-nav" role="group" aria-label="切换歌单曲目">
    <button type="button" data-kisara-audio-prev aria-label="上一首" title="上一首">
      <Icon name="tabler:chevron-left" />
    </button>
    <button type="button" data-kisara-audio-next aria-label="下一首" title="下一首">
      <Icon name="tabler:chevron-right" />
    </button>
  </div>
</div>

<script is:inline define:vars={{ audioConfig }}>
  (() => {
    const player = document.querySelector("[data-kisara-audio-player]");
    const placeholderAudio = player?.querySelector("[data-kisara-theme-audio]");
    const control = player?.querySelector("[data-kisara-audio-control]");
    const title = player?.querySelector("[data-kisara-audio-title]");
    const status = player?.querySelector("[data-kisara-audio-status]");
    const previous = player?.querySelector("[data-kisara-audio-prev]");
    const next = player?.querySelector("[data-kisara-audio-next]");
    if (!(placeholderAudio instanceof HTMLAudioElement) || !(control instanceof HTMLButtonElement)) return;

    const bootstrap = window.__yuimiKisaraAudioBootstrap;
    const canAdoptBootstrap = bootstrap?.audio instanceof HTMLAudioElement && !bootstrap.claimed;
    const audio = canAdoptBootstrap ? bootstrap.audio : placeholderAudio;
    if (canAdoptBootstrap) {
      bootstrap.claimed = true;
      placeholderAudio.replaceWith(audio);
    }

    const tracks = audioConfig.tracks;
    const storageKey = audioConfig.storageKey;
    const legacyStorageKey = audioConfig.legacyStorageKey;
    const stateLabels = {
      loading: "LINKING",
      playing: "PLAYING",
      paused: "PAUSED",
      blocked: "READY / PLAY",
      error: "OFFLINE"
    };
    let enabled = true;
    let trackIndex = 0;
    let restoreTime = 0;
    let lastStoredTime = -1;
    let autoplayBlocked = false;
    let playbackPromise = null;
    let currentUiState = "loading";
    let loadToken = 0;
    let playbackToken = 0;
    let switchingTrack = false;
    let persistedResumeIntent = false;
    let ambientUnlockAvailable = true;

    let restoredFromStorage = false;
    if (canAdoptBootstrap) {
      enabled = bootstrap.enabled !== false;
      persistedResumeIntent = Boolean(bootstrap.persistedResumeIntent);
      const bootstrapIndex = tracks.findIndex((track) => track.id === bootstrap.trackId);
      if (bootstrapIndex >= 0) trackIndex = bootstrapIndex;
      if (Number.isFinite(bootstrap.restoreTime)) restoreTime = Math.max(0, bootstrap.restoreTime);
      restoredFromStorage = Boolean(bootstrap.restoredFromStorage);
    } else {
      try {
        const stored = JSON.parse(localStorage.getItem(storageKey) ?? "null");
        if (stored && typeof stored === "object") {
          if (typeof stored.enabled === "boolean") {
            enabled = stored.enabled;
            persistedResumeIntent = stored.enabled;
          }
          if (typeof stored.trackId === "string") {
            const storedIndex = tracks.findIndex((track) => track.id === stored.trackId);
            if (storedIndex >= 0) trackIndex = storedIndex;
          }
          if (Number.isFinite(stored.currentTime)) restoreTime = Math.max(0, stored.currentTime);
          restoredFromStorage = true;
        }
      } catch {}
    }

    if (!restoredFromStorage) {
      try {
        const legacy = JSON.parse(sessionStorage.getItem(legacyStorageKey) ?? "null");
        if (legacy && typeof legacy === "object") {
          if (typeof legacy.enabled === "boolean") {
            enabled = legacy.enabled;
            persistedResumeIntent = legacy.enabled;
          }
          if (Number.isFinite(legacy.currentTime)) restoreTime = Math.max(0, legacy.currentTime);
        }
      } catch {}
    }

    audio.volume = audioConfig.volume;

    const activeTrack = () => tracks[trackIndex];

    const setUiState = (state) => {
      const playing = state === "playing";
      const track = activeTrack();
      currentUiState = state;
      control.dataset.state = state;
      control.setAttribute("aria-pressed", String(playing));
      control.setAttribute(
        "aria-label",
        playing ? `暂停主题音乐《${track.title}》` : `播放主题音乐《${track.title}》`
      );
      control.title = playing ? `暂停主题音乐《${track.title}》` : `播放主题音乐《${track.title}》`;
      if (status) {
        const position = String(trackIndex + 1).padStart(2, "0");
        const total = String(tracks.length).padStart(2, "0");
        status.textContent = `${position} / ${total} · ${stateLabels[state] ?? stateLabels.paused}`;
      }
    };

    const updateTrackUi = () => {
      const track = activeTrack();
      const previousTrack = tracks[(trackIndex - 1 + tracks.length) % tracks.length];
      const nextTrack = tracks[(trackIndex + 1) % tracks.length];
      if (title) title.textContent = track.title;
      if (previous instanceof HTMLButtonElement) {
        previous.title = `上一首：${previousTrack.title}`;
        previous.setAttribute("aria-label", `上一首：${previousTrack.title}`);
      }
      if (next instanceof HTMLButtonElement) {
        next.title = `下一首：${nextTrack.title}`;
        next.setAttribute("aria-label", `下一首：${nextTrack.title}`);
      }
      setUiState(currentUiState);
    };

    const persistState = () => {
      const currentTime = Number.isFinite(audio.currentTime) ? audio.currentTime : restoreTime;
      persistedResumeIntent = enabled;
      if (bootstrap) {
        bootstrap.enabled = enabled;
        bootstrap.persistedResumeIntent = enabled;
        bootstrap.trackId = activeTrack().id;
        bootstrap.restoreTime = currentTime;
      }
      try {
        localStorage.setItem(storageKey, JSON.stringify({
          enabled,
          trackId: activeTrack().id,
          currentTime
        }));
        sessionStorage.removeItem(legacyStorageKey);
        lastStoredTime = currentTime;
      } catch {}
    };

    const restorePosition = (time) => {
      if (time <= 0) return;
      try {
        if (Number.isFinite(audio.duration) && audio.duration > 0) {
          audio.currentTime = time >= audio.duration - 0.5 ? 0 : Math.min(time, audio.duration - 0.25);
        } else {
          audio.currentTime = time;
        }
      } catch {}
    };

    const requestPlayback = () => {
      if (!enabled) {
        audio.pause();
        setUiState("paused");
        return Promise.resolve(false);
      }
      if (!audio.paused) {
        autoplayBlocked = false;
        setUiState("playing");
        return Promise.resolve(true);
      }
      if (playbackPromise) return playbackPromise;

      const token = ++playbackToken;
      setUiState("loading");
      playbackPromise = Promise.resolve(audio.play())
        .then(() => {
          if (token !== playbackToken) return false;
          autoplayBlocked = false;
          setUiState("playing");
          return true;
        })
        .catch(() => {
          if (token !== playbackToken) return false;
          autoplayBlocked = !audio.error;
          setUiState(audio.error ? "error" : "blocked");
          return false;
        })
        .finally(() => {
          if (token === playbackToken) playbackPromise = null;
        });
      return playbackPromise;
    };

    const adoptBootstrapPlayback = () => {
      if (!bootstrap?.playPromise) return false;
      const token = ++playbackToken;
      setUiState("loading");
      playbackPromise = Promise.resolve(bootstrap.playPromise)
        .then(() => {
          if (token !== playbackToken) return false;
          const playing = !audio.paused && !audio.ended;
          autoplayBlocked = !playing && !audio.error && Boolean(bootstrap.blocked);
          setUiState(playing ? "playing" : audio.error ? "error" : autoplayBlocked ? "blocked" : "loading");
          return playing;
        })
        .catch(() => {
          if (token !== playbackToken) return false;
          autoplayBlocked = !audio.error;
          setUiState(audio.error ? "error" : "blocked");
          return false;
        })
        .finally(() => {
          if (token === playbackToken) playbackPromise = null;
        });
      return true;
    };

    const selectTrack = (nextIndex, options = {}) => {
      const normalizedIndex = (nextIndex + tracks.length) % tracks.length;
      const requestedTime = Number.isFinite(options.time) ? Math.max(0, options.time) : 0;
      const shouldPlay = typeof options.autoplay === "boolean" ? options.autoplay : enabled;
      const shouldPersist = options.persist !== false;
      const token = ++loadToken;

      playbackToken += 1;
      playbackPromise = null;
      switchingTrack = true;
      audio.pause();
      trackIndex = normalizedIndex;
      restoreTime = requestedTime;
      audio.src = activeTrack().src;
      audio.load();
      if (bootstrap) {
        bootstrap.trackId = activeTrack().id;
        bootstrap.restoreTime = requestedTime;
        bootstrap.playPromise = null;
        bootstrap.blocked = false;
        bootstrap.settled = false;
      }
      updateTrackUi();
      setUiState(shouldPlay ? "loading" : "paused");
      if (shouldPersist) persistState();

      const finishLoading = () => {
        if (token !== loadToken) return;
        restorePosition(requestedTime);
        switchingTrack = false;
        if (shouldPlay) requestPlayback();
        else {
          setUiState("paused");
          persistState();
        }
      };

      if (audio.readyState >= 1) queueMicrotask(finishLoading);
      else audio.addEventListener("loadedmetadata", finishLoading, { once: true });
    };

    const stepTrack = (direction) => {
      autoplayBlocked = false;
      selectTrack(trackIndex + direction, { time: 0, autoplay: enabled });
    };

    control.addEventListener("click", () => {
      if (audio.paused) {
        enabled = true;
        persistedResumeIntent = true;
        ambientUnlockAvailable = true;
        autoplayBlocked = false;
        persistState();
        requestPlayback();
        return;
      }

      enabled = false;
      persistedResumeIntent = false;
      autoplayBlocked = false;
      audio.pause();
      setUiState("paused");
      persistState();
    });

    previous?.addEventListener("click", () => stepTrack(-1));
    next?.addEventListener("click", () => stepTrack(1));

    const unlockPlayback = (event) => {
      if (!enabled || !autoplayBlocked || !audio.paused) return;
      const target = event.target instanceof Element ? event.target : null;
      if (target?.closest("[data-kisara-audio-control]")) return;
      const ambientAttempt = event.type === "pointermove" || event.type === "wheel";
      if (ambientAttempt) {
        if (!persistedResumeIntent || !ambientUnlockAvailable) return;
        ambientUnlockAvailable = false;
      }
      requestPlayback();
    };

    window.addEventListener("pointermove", unlockPlayback, { passive: true });
    window.addEventListener("wheel", unlockPlayback, { passive: true });
    window.addEventListener("pointerdown", unlockPlayback, { passive: true });
    window.addEventListener("mousedown", unlockPlayback, { passive: true });
    window.addEventListener("touchend", unlockPlayback, { passive: true });
    window.addEventListener("click", unlockPlayback, { passive: true });
    window.addEventListener("keydown", unlockPlayback);
    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const link = target?.closest("a[href]");
      if (!(link instanceof HTMLAnchorElement) || link.target === "_blank" || link.hasAttribute("download")) return;
      const destination = new URL(link.href, document.baseURI);
      if (destination.origin !== window.location.origin) return;
      persistState();
    }, true);
    window.addEventListener("pageshow", () => {
      if (enabled && audio.paused && !autoplayBlocked) requestPlayback();
    });
    window.addEventListener("pagehide", persistState);

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") persistState();
      else if (enabled && audio.paused && !autoplayBlocked) requestPlayback();
    });

    audio.addEventListener("playing", () => {
      autoplayBlocked = false;
      setUiState("playing");
    });
    audio.addEventListener("pause", () => {
      if (!switchingTrack) setUiState(enabled ? "loading" : "paused");
    });
    audio.addEventListener("waiting", () => {
      if (enabled) setUiState("loading");
    });
    audio.addEventListener("error", () => setUiState("error"));
    audio.addEventListener("ended", () => {
      restoreTime = 0;
      selectTrack(trackIndex + 1, { time: 0, autoplay: true });
    });
    audio.addEventListener("timeupdate", () => {
      restoreTime = audio.currentTime;
      if (Math.abs(audio.currentTime - lastStoredTime) >= 3) persistState();
    });

    updateTrackUi();
    if (canAdoptBootstrap) {
      if (!enabled) {
        setUiState("paused");
      } else if (!bootstrap.settled && adoptBootstrapPlayback()) {
        // The head bootstrap already owns the first play request.
      } else if (!audio.paused && !audio.ended) {
        setUiState("playing");
      } else if (audio.error) {
        setUiState("error");
      } else if (bootstrap.blocked) {
        autoplayBlocked = true;
        setUiState("blocked");
      } else {
        requestPlayback();
      }
    } else {
      selectTrack(trackIndex, { time: restoreTime, autoplay: enabled, persist: false });
    }
  })();
</script>
