  }

  html[data-kisara-route-to="blog"]::view-transition-old(root) {
    animation: kisara-route-old-blog 560ms cubic-bezier(0.3, 0, 0.2, 1) both !important;
  }

  html[data-kisara-route-to="blog"]::view-transition-new(root) {
    animation: kisara-route-new-blog 560ms cubic-bezier(0.16, 0.76, 0.18, 1) both !important;
  }

