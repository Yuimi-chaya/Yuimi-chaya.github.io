<div
  data-kisara-route-relay
  data-from="home"
  data-to="home"
  hidden
  aria-hidden="true"
  transition:persist="kisara-route-relay"
></div>

<script is:inline data-astro-rerun>
  (() => {
    const root = document.querySelector("[data-kisara-route-relay]");
    if (!(root instanceof HTMLElement)) return;

    const previous = window.__yuimiKisaraRouteRelay;
    if (previous?.root === root) return;
    previous?.dispose?.();

    const lifecycle = new AbortController();
    const signal = lifecycle.signal;
    let serial = 0;
    let settledSerial = 0;
    let resetTimer = 0;
    let activeRoute = null;

    const routeKey = (pathname) => {
      const cleanPath = pathname
        .replace(/^\/themes\/kisara(?=\/|$)/, "")
        .replace(/^\/themes\/(?:blank|fuyukawa-kagari)(?=\/|$)/, "");
      const segment = cleanPath.split("/").filter(Boolean)[0] || "home";
      if (["blog", "games", "projects", "about"].includes(segment)) return segment;
      return segment === "home" ? "home" : "other";
    };

    const clearResetTimer = () => {
      if (resetTimer) window.clearTimeout(resetTimer);
      resetTimer = 0;
    };

    const writeState = (documentLike, phase, from, to) => {
      if (!(documentLike instanceof Document)) return;
      documentLike.documentElement.dataset.kisaraRoutePhase = phase;
      documentLike.documentElement.dataset.kisaraRouteFrom = from;
      documentLike.documentElement.dataset.kisaraRouteTo = to;
      if (documentLike.body) {
        documentLike.body.dataset.kisaraRoutePhase = phase;
        documentLike.body.dataset.kisaraRouteFrom = from;
        documentLike.body.dataset.kisaraRouteTo = to;
      }
    };

    const clearState = (documentLike = document) => {
      if (!(documentLike instanceof Document)) return;
      delete documentLike.documentElement.dataset.kisaraRoutePhase;
      delete documentLike.documentElement.dataset.kisaraRouteFrom;
      delete documentLike.documentElement.dataset.kisaraRouteTo;
      if (documentLike.body) {
        delete documentLike.body.dataset.kisaraRoutePhase;
        delete documentLike.body.dataset.kisaraRouteFrom;
        delete documentLike.body.dataset.kisaraRouteTo;
      }
    };

    const reset = () => {
      clearResetTimer();
      activeRoute = null;
      settledSerial = 0;
      clearState();
    };

    document.addEventListener("astro:before-preparation", (event) => {
      if (event.from?.href === event.to?.href) return;
      const from = routeKey(event.from?.pathname || window.location.pathname);
      const to = routeKey(event.to?.pathname || window.location.pathname);
      const navigationKey = `${event.from?.href || window.location.href}>${event.to?.href || window.location.href}`;
      if (activeRoute?.navigationKey === navigationKey) return;
      const route = { from, to, navigationKey, serial: ++serial };
      activeRoute = route;
      clearResetTimer();
      root.dataset.from = from;
      root.dataset.to = to;
      writeState(document, "crossfading", from, to);
      resetTimer = window.setTimeout(() => {
        if (activeRoute === route) reset();
      }, 4500);
    }, { signal });

    document.addEventListener("astro:before-swap", (event) => {
      if (!activeRoute || !(event.newDocument instanceof Document)) return;
      writeState(event.newDocument, "crossfading", activeRoute.from, activeRoute.to);
    }, { signal });

    const settle = () => {
      if (!activeRoute) return;
      const route = activeRoute;
      if (settledSerial === route.serial) return;
      settledSerial = route.serial;
      clearResetTimer();
      writeState(document, "settling", route.from, route.to);
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches
        || document.documentElement.dataset.yuimiPerformance !== "full";
      resetTimer = window.setTimeout(() => {
        if (activeRoute === route) reset();
      }, reduced ? 180 : route.to === "home" ? 760 : 660);
    };

    document.addEventListener("astro:after-swap", settle, { signal });
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) reset();
    }, { signal });

    window.__yuimiKisaraRouteRelay = {
      root,
      reset,
      dispose: () => {
        clearResetTimer();
        lifecycle.abort();
        clearState();
      }
    };
  })();
</script>

<style is:global>
