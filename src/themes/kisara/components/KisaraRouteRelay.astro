    42% { opacity: 0.48; transform: translate3d(-5px, 0, 0) scale(1.008); }
    72% { transform: translate3d(2px, 0, 0) scale(1.002); }
    100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  }

  @keyframes kisara-route-old-projects {
    0% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
    100% { opacity: 0; transform: translate3d(0, -12px, 0) scale(1.01); }
  }

  @keyframes kisara-route-new-projects {
    0% { opacity: 0; transform: translate3d(0, 14px, 0) scale(1.025); }
    38% { opacity: 0.24; }
    100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  }

  @keyframes kisara-route-chrome-old {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes kisara-route-chrome-new {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(root) {
      animation-duration: 140ms !important;
    }

    ::view-transition-old(root) {
      animation: kisara-route-reduced-old 140ms linear both !important;
    }

    ::view-transition-new(root) {
