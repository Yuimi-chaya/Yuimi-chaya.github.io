    28% { transform: translate3d(-3px, 0, 0) scale(1.003); }
    52% { opacity: 0.58; transform: translate3d(6px, 0, 0) scale(1.008); }
    100% { opacity: 0; transform: translate3d(-18px, 0, 0) scale(1.018); }
  }

  @keyframes kisara-route-new-games {
