---
import { Icon } from "astro-icon/components";
import { getThemePath } from "@/core/themes/registry";
---

<section class="kisara-home-video-event" data-kisara-home-stop="003" aria-labelledby="kisara-project-title">
  <kisara-home-event-video class="kisara-home-video-stage" data-state="idle">
    <div class="kisara-home-video-media">
      <video
        data-home-event-video
        poster="/themes/kisara/assets/home-event-003-new-last.webp"
        width="1920"
        height="1080"
        preload="none"
        muted
        playsinline
        aria-label="木更在白板前用刀指出答案的短片"
      >
        <source data-src="/themes/kisara/assets/home-event-003-new.mp4" type="video/mp4" />
      </video>
      <span class="kisara-home-video-grade" aria-hidden="true"></span>
      <span class="kisara-home-video-scan" data-home-event-cue="scan" aria-hidden="true"></span>

      <div class="kisara-home-video-board-cues" aria-hidden="true">
        <div class="kisara-home-video-target-track" data-home-event-cue="target-track">
          <span class="kisara-home-video-target-reticle" data-home-event-cue="reticle"><i></i></span>
          <span class="kisara-home-video-target-leader" data-home-event-cue="leader"></span>
          <span class="kisara-home-video-target-copy" data-home-event-cue="target-copy">
            <span>
              <small>POINT OF INTEREST / 003</small>
              <strong>ANSWER <em>LOCKED</em></strong>
              <b>THE FRAME KNOWS FIRST.</b>
            </span>
          </span>
        </div>

        <ol class="kisara-home-video-board-tags">
          <li data-home-event-cue="tag-question"><span>01</span><b>QUESTION</b></li>
          <li data-home-event-cue="tag-gesture"><span>02</span><b>GESTURE</b></li>
          <li class="is-active" data-home-event-cue="tag-answer"><span>03</span><b>ANSWER</b></li>
        </ol>
      </div>

      <header class="kisara-home-video-heading">
        <p><span>003</span> CLASSROOM FRAGMENT / 01.293 SEC</p>
        <h2 id="kisara-project-title">One second before the answer.</h2>
      </header>

      <a class="kisara-home-video-game-link" href={`${getThemePath("kisara", "/games/")}#kisara-game-investigation`}>
        <span>OPEN GAME FILE</span><Icon name="tabler:external-link" aria-hidden="true" />
      </a>

      <div class="kisara-home-video-caption">
        <div><span data-home-event-status>ARCHIVE READY</span><output data-home-event-time>00.00</output></div>
      </div>

      <button class="kisara-home-video-replay" type="button" data-home-event-replay aria-label="重新播放 003 短片" title="重新播放">
        <Icon name="tabler:refresh" aria-hidden="true" />
      </button>

      <div class="kisara-home-video-progress" aria-hidden="true"><i><b></b></i></div>
    </div>
  </kisara-home-event-video>
</section>

<script>
  if (!customElements.get("kisara-home-event-video")) {
    class KisaraHomeEventVideo extends HTMLElement {
      controller: AbortController | null = null;
      observer: IntersectionObserver | null = null;
      visibilityObserver: IntersectionObserver | null = null;
      cueAnimations: Animation[] = [];
      cueFrame = 0;
      resetScene: (() => void) | null = null;
      refreshScene: (() => void) | null = null;

      resetPresentation() {
        this.resetScene?.();
      }

      refreshPresentationAfterVisibility() {
        this.refreshScene?.();
      }

      connectedCallback() {
        this.controller?.abort();
        this.observer?.disconnect();
        this.visibilityObserver?.disconnect();
        this.cueAnimations.forEach((animation) => animation.cancel());
        this.cueAnimations = [];
        if (this.cueFrame) cancelAnimationFrame(this.cueFrame);
        this.cueFrame = 0;
        const controller = new AbortController();
        this.controller = controller;
        const { signal } = controller;
        const video = this.querySelector<HTMLVideoElement>("[data-home-event-video]");
        const source = video?.querySelector<HTMLSourceElement>("source[data-src]");
        const replay = this.querySelector<HTMLButtonElement>("[data-home-event-replay]");
        const status = this.querySelector<HTMLElement>("[data-home-event-status]");
        const time = this.querySelector<HTMLOutputElement>("[data-home-event-time]");
        if (!video || !source || !replay) return;

        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let hydrated = source.hasAttribute("src");
        let hasStarted = false;
        let completed = false;
        let visible = false;
        let playAttempt = 0;
        const cueDuration = 1292.958;
        const cueEaseOut = "cubic-bezier(0.23, 1, 0.32, 1)";

        const addCue = (name: string, keyframes: Keyframe[]) => {
          const element = this.querySelector<HTMLElement>(`[data-home-event-cue="${name}"]`);
          if (!element) return;
          const frames = reducedMotion
            ? keyframes.map((keyframe) => ({ ...keyframe, transform: "none" }))
            : keyframes;
          const animation = element.animate(frames, {
            duration: cueDuration,
            fill: "both",
            easing: "linear",
          });
          animation.pause();
          animation.currentTime = 0;
          this.cueAnimations.push(animation);
        };

        addCue("scan", [
          { opacity: 0, transform: "translate3d(0, 0, 0) skewX(-12deg)", offset: 0 },
          { opacity: 0.58, transform: "translate3d(190%, 0, 0) skewX(-12deg)", offset: 0.16, easing: cueEaseOut },
          { opacity: 0, transform: "translate3d(690%, 0, 0) skewX(-12deg)", offset: 0.57 },
          { opacity: 0, transform: "translate3d(690%, 0, 0) skewX(-12deg)", offset: 1 },
        ]);
        addCue("target-track", [
          { opacity: 0, transform: "translate3d(2.2vw, 9.5vh, 0) scale(2.08)", offset: 0, easing: cueEaseOut },
          { opacity: 1, transform: "translate3d(1.2vw, 5.2vh, 0) scale(1.58)", offset: 0.08, easing: cueEaseOut },
          { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)", offset: 0.31 },
          { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)", offset: 1 },
        ]);
        addCue("reticle", [
          { opacity: 0, transform: "scale(0.94)", offset: 0 },
          { opacity: 0, transform: "scale(0.94)", offset: 0.035, easing: cueEaseOut },
          { opacity: 1, transform: "scale(1)", offset: 0.13 },
          { opacity: 1, transform: "scale(1)", offset: 1 },
        ]);
        addCue("leader", [
          { opacity: 0, transform: "rotate(-11deg) scaleX(0)", offset: 0 },
          { opacity: 0, transform: "rotate(-11deg) scaleX(0)", offset: 0.17, easing: cueEaseOut },
          { opacity: 1, transform: "rotate(-11deg) scaleX(1)", offset: 0.38 },
          { opacity: 1, transform: "rotate(-11deg) scaleX(1)", offset: 1 },
        ]);
        addCue("target-copy", [
          { opacity: 0, transform: "translate3d(24px, 10px, 0)", offset: 0 },
          { opacity: 0, transform: "translate3d(24px, 10px, 0)", offset: 0.22, easing: cueEaseOut },
          { opacity: 1, transform: "translate3d(0, 0, 0)", offset: 0.45 },
          { opacity: 1, transform: "translate3d(0, 0, 0)", offset: 1 },
        ]);
        addCue("tag-question", [
          { opacity: 0, transform: "translate3d(28px, 16px, 0)", offset: 0 },
          { opacity: 0, transform: "translate3d(28px, 16px, 0)", offset: 0.34, easing: cueEaseOut },
          { opacity: 1, transform: "translate3d(0, 0, 0)", offset: 0.57 },
          { opacity: 1, transform: "translate3d(0, 0, 0)", offset: 1 },
        ]);
        addCue("tag-gesture", [
          { opacity: 0, transform: "translate3d(28px, 16px, 0)", offset: 0 },
          { opacity: 0, transform: "translate3d(28px, 16px, 0)", offset: 0.41, easing: cueEaseOut },
          { opacity: 1, transform: "translate3d(0, 0, 0)", offset: 0.64 },
          { opacity: 1, transform: "translate3d(0, 0, 0)", offset: 1 },
        ]);
        addCue("tag-answer", [
          { opacity: 0, transform: "translate3d(28px, 16px, 0) scale(0.96)", offset: 0 },
          { opacity: 0, transform: "translate3d(28px, 16px, 0) scale(0.96)", offset: 0.48, easing: cueEaseOut },
          { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)", offset: 0.72 },
          { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)", offset: 1 },
        ]);

        const setState = (state: string, label: string) => {
          this.dataset.state = state;
          if (status) status.textContent = label;
        };

        const hydrate = () => {
          if (hydrated) return;
          hydrated = true;
          source.src = source.dataset.src || "";
          video.preload = "auto";
          video.load();
          setState("loading", "LOADING FRAGMENT");
        };

        const playVideo = async (restart: boolean) => {
          const attempt = ++playAttempt;
          hydrate();
          if (restart) {
            completed = false;
            try { video.currentTime = 0; } catch {}
          }
          try {
            await video.play();
            if (signal.aborted || attempt !== playAttempt || !visible) {
              video.pause();
              return;
            }
            hasStarted = true;
          } catch {
            if (!signal.aborted && attempt === playAttempt) setState("ready", "PRESS REPLAY");
          }
        };

        const syncTime = () => {
          const duration = Number.isFinite(video.duration) && video.duration > 0 ? video.duration : 1.292958;
          const progress = Math.min(1, Math.max(0, video.currentTime / duration));
          this.style.setProperty("--home-003-progress", progress.toFixed(4));
          if (time) time.textContent = video.currentTime.toFixed(2).padStart(5, "0");
          const cueTime = Math.min(cueDuration, Math.max(0, video.currentTime * 1000));
          this.cueAnimations.forEach((animation) => { animation.currentTime = cueTime; });
        };

        const stopCueClock = () => {
          if (this.cueFrame) cancelAnimationFrame(this.cueFrame);
          this.cueFrame = 0;
        };

        const startCueClock = () => {
          stopCueClock();
          const tick = () => {
            syncTime();
            if (!video.paused && !video.ended && visible) {
              this.cueFrame = requestAnimationFrame(tick);
            } else {
              this.cueFrame = 0;
            }
          };
          this.cueFrame = requestAnimationFrame(tick);
        };

        video.addEventListener("playing", () => {
          setState("playing", "PLAYING FRAGMENT");
          startCueClock();
        }, { signal });
        video.addEventListener("loadedmetadata", syncTime, { signal });
        video.addEventListener("timeupdate", syncTime, { signal });
        video.addEventListener("pause", () => {
          stopCueClock();
          syncTime();
          if (!completed && video.currentTime > 0) setState("paused", "FRAGMENT HELD");
        }, { signal });
        video.addEventListener("ended", () => {
          stopCueClock();
          completed = true;
          syncTime();
          setState("complete", "ARCHIVE HELD");
        }, { signal });
        video.addEventListener("error", () => {
          stopCueClock();
          setState("error", "POSTER FALLBACK");
        }, { signal });
        replay.addEventListener("click", () => {
          visible = true;
          void playVideo(true);
        }, { signal });

        const refreshVisibility = () => {
          const rect = this.getBoundingClientRect();
          const viewportHeight = Math.max(1, window.innerHeight);
          const visibleHeight = Math.max(0, Math.min(rect.bottom, viewportHeight) - Math.max(rect.top, 0));
          const active = visibleHeight / Math.min(Math.max(1, rect.height), viewportHeight) >= 0.42;
          this.toggleAttribute("data-scene-visible", visibleHeight > 0);
          if (active === visible) return;
          visible = active;
          if (visible) {
            hydrate();
            if (!reducedMotion && !completed) void playVideo(!hasStarted);
          } else {
            playAttempt += 1;
            video.pause();
          }
        };

        const resetVideo = () => {
          playAttempt += 1;
          stopCueClock();
          video.pause();
          hasStarted = false;
          completed = false;
          try { video.currentTime = 0; } catch {}
          syncTime();
          if (time) time.textContent = "00.00";
          setState(reducedMotion ? "ready" : "idle", reducedMotion ? "PRESS REPLAY" : "ARCHIVE READY");
        };

        this.resetScene = resetVideo;
        this.refreshScene = refreshVisibility;
        setState(reducedMotion ? "ready" : "idle", reducedMotion ? "PRESS REPLAY" : "ARCHIVE READY");

        if ("IntersectionObserver" in window) {
          this.observer = new IntersectionObserver((entries) => {
            if (entries.some((entry) => entry.isIntersecting)) hydrate();
          }, { rootMargin: "48% 0px", threshold: 0.01 });
          this.observer.observe(this);

          this.visibilityObserver = new IntersectionObserver((entries) => {
            const entry = entries[entries.length - 1];
            if (!entry) return;
            this.toggleAttribute("data-scene-visible", entry.isIntersecting);
            const nextVisible = entry.isIntersecting && entry.intersectionRatio >= 0.42;
            if (nextVisible === visible) return;
            visible = nextVisible;
            if (visible) {
              hydrate();
              if (!reducedMotion && !completed) void playVideo(!hasStarted);
            } else {
              playAttempt += 1;
              video.pause();
            }
          }, { threshold: [0, 0.42, 0.72] });
          this.visibilityObserver.observe(this);
        } else {
          visible = true;
          this.toggleAttribute("data-scene-visible", true);
          hydrate();
          if (!reducedMotion) void playVideo(true);
        }
      }

      disconnectedCallback() {
        this.controller?.abort();
        this.controller = null;
        if (this.cueFrame) cancelAnimationFrame(this.cueFrame);
        this.cueFrame = 0;
        this.cueAnimations.forEach((animation) => animation.cancel());
        this.cueAnimations = [];
        this.observer?.disconnect();
        this.observer = null;
        this.visibilityObserver?.disconnect();
        this.visibilityObserver = null;
        this.resetScene = null;
        this.refreshScene = null;
        const video = this.querySelector<HTMLVideoElement>("[data-home-event-video]");
        if (video) video.pause();
      }
    }

    customElements.define("kisara-home-event-video", KisaraHomeEventVideo);
  }
</script>
