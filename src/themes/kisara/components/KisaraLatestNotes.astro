---
import { Icon } from "astro-icon/components";
import { getPublishedPosts } from "@/core/content/blog";
import { getThemePath } from "@/core/themes/registry";
import { categoryLabel } from "@/lib/site";
import { getKisaraCoverPresentation } from "../lib/coverPresentation";

const posts = (await getPublishedPosts()).slice(0, 3);
const covers = await getKisaraCoverPresentation(posts);
const dateFormatter = new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<section class="kisara-latest kisara-latest-ledger" data-kisara-home-stop="004" aria-labelledby="kisara-latest-title">
  <div class="kisara-latest-inner">
    <header class="kisara-latest-heading">
      <div><p>004 / RECENT ENTRIES</p><h2 id="kisara-latest-title">最近，写到了这里。</h2></div>
      <a href={getThemePath("kisara", "/blog/")}>全部文章<Icon name="tabler:arrow-right" aria-hidden="true" /></a>
    </header>
    <div class="kisara-latest-entries">
      {posts.map((post, index) => {
        const cover = covers.get(post.id);
        const date = post.data.updatedDate ?? post.data.pubDate;
        return (
          <a class:list={["kisara-latest-entry", { "is-lead": index === 0 }]} href={getThemePath("kisara", `/blog/${post.id}/`)}>
            <figure style={`--cover-position: ${cover?.position ?? "50% 32%"}`}>
              {post.data.cover
                ? <img src={post.data.cover} alt="" width={cover?.width ?? 700} height={cover?.height ?? 990} loading="lazy" decoding="async" fetchpriority="low" />
                : <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>}
            </figure>
            <div class="kisara-latest-copy">
              <div class="kisara-latest-meta"><span>{categoryLabel[post.data.category]}</span><time datetime={date.toISOString()}>{dateFormatter.format(date)}</time></div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="kisara-latest-read">{index === 0 ? "读这一篇" : "继续阅读"}<Icon name="tabler:arrow-right" aria-hidden="true" /></span>
            </div>
          </a>
        );
      })}
      {posts.length === 0 && <p class="kisara-latest-empty">下一页，还在写。</p>}
    </div>
    <div class="kisara-latest-colophon"><span>WRITTEN, REVISED, STILL IN PROGRESS.</span><span>YUIMI LAB</span></div>
  </div>
</section>

<style>
  .kisara-latest.kisara-latest-ledger {
    display: grid;
    align-content: center;
    min-height: 100svh;
    padding: 96px 0 88px;
    color: #24292c;
    background: #edf1f0;
  }
  .kisara-latest-inner { width: min(1280px, calc(100% - 64px)); margin-inline: auto; }
  .kisara-latest-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 32px; }
  .kisara-latest-heading p { margin: 0 0 14px; color: #48685f; font: 700 11px/1.5 "Courier New", monospace; }
  .kisara-latest-heading h2 { margin: 0; font-size: 34px; line-height: 1.4; letter-spacing: 0; }
  .kisara-latest-heading > a { display: inline-flex; align-items: center; gap: 18px; flex-shrink: 0; min-height: 44px; color: #a92f4d; font-size: 13px; text-decoration: none; }
  .kisara-latest-entries { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); column-gap: 40px; border-block: 1px solid #afbdb7; }
  .kisara-latest-entry { display: grid; grid-template-columns: 86px minmax(0, 1fr); align-items: start; gap: 24px; padding: 30px 0; color: inherit; text-decoration: none; }
  .kisara-latest-entry + .kisara-latest-entry + .kisara-latest-entry { border-top: 1px solid #c5ceca; }
  .kisara-latest-entry.is-lead { grid-row: span 2; grid-template-columns: minmax(120px, .75fr) minmax(0, 1fr); align-items: center; padding-right: 36px; border-right: 1px solid #c5ceca; }
  .kisara-latest-entry figure { position: relative; aspect-ratio: 7 / 10; margin: 0; overflow: hidden; background: #dde4e0; }
  .kisara-latest-entry figure img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--cover-position); transition: transform 240ms cubic-bezier(.23, 1, .32, 1); }
  .kisara-latest-entry figure > span { display: grid; place-items: center; height: 100%; color: #a23551; font: 700 44px/1 Georgia, serif; }
  .kisara-latest-copy { min-width: 0; }
  .kisara-latest-meta { display: flex; flex-wrap: wrap; gap: 4px 16px; color: #576b64; font: 600 10px/1.5 "Courier New", monospace; }
  .kisara-latest-meta time { color: #707976; font-variant-numeric: tabular-nums; }
  .kisara-latest-copy h3 { margin: 12px 0; font-size: 19px; line-height: 1.55; letter-spacing: 0; text-wrap: pretty; }
  .kisara-latest-entry.is-lead h3 { font-size: 26px; }
  .kisara-latest-copy p { margin: 0; color: #626b68; font-size: 13px; line-height: 1.8; }
  .kisara-latest-read { display: inline-flex; align-items: center; gap: 14px; margin-top: 20px; color: #a62f4b; font-size: 11px; }
  .kisara-latest-read svg { transition: transform 180ms cubic-bezier(.23, 1, .32, 1); }
  .kisara-latest-ledger svg { flex: 0 0 auto; width: 17px; height: 17px; }
  .kisara-latest-ledger a:focus-visible { outline: 2px solid #af3352; outline-offset: 6px; }
  .kisara-latest-colophon { display: flex; justify-content: space-between; gap: 16px; margin-top: 18px; color: #707976; font: 600 10px/1.6 "Courier New", monospace; }
  .kisara-latest-empty { padding: 48px 0; }
  @media (hover: hover) and (pointer: fine) {
    .kisara-latest-entry:hover img { transform: scale(1.025); }
    .kisara-latest-entry:hover .kisara-latest-read svg { transform: translateX(4px); }
    .kisara-latest-entry:hover h3 { text-decoration: underline; text-decoration-color: #a7354d66; text-underline-offset: 5px; }
  }
  @media (max-width: 1100px) {
    .kisara-latest-entries { gap: 0 26px; }
    .kisara-latest-entry.is-lead { grid-template-columns: minmax(96px, .6fr) minmax(0, 1fr); gap: 24px; padding-right: 26px; }
    .kisara-latest-entry.is-lead h3 { font-size: 22px; }
    .kisara-latest-entry { gap: 18px; grid-template-columns: 68px minmax(0, 1fr); }
  }
  @media (max-width: 760px) {
    .kisara-latest.kisara-latest-ledger { padding: 80px 0 60px; }
    .kisara-latest-inner { width: calc(100% - 40px); }
    .kisara-latest-heading { align-items: flex-start; flex-direction: column; gap: 8px; margin-bottom: 16px; }
    .kisara-latest-heading h2 { font-size: 27px; }
    .kisara-latest-entries { grid-template-columns: minmax(0, 1fr); }
    .kisara-latest-entry.is-lead { grid-row: auto; border-right: 0; padding-right: 0; grid-template-columns: 104px minmax(0, 1fr); }
    .kisara-latest-entry + .kisara-latest-entry { border-top: 1px solid #c5ceca; }
    .kisara-latest-entry { grid-template-columns: 76px minmax(0, 1fr); }
    .kisara-latest-copy h3, .kisara-latest-entry.is-lead h3 { font-size: 18px; }
    .kisara-latest-colophon span:last-child { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kisara-latest-entry img, .kisara-latest-read svg { transition: none; }
  }
</style>
