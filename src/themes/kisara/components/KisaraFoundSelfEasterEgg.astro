---
const letters = [
  { character: "K", delay: "20.75s", rotation: "-3.6deg", lift: "7px", drift: "-10px" },
  { character: "i", delay: "21.22s", rotation: "2.4deg", lift: "-4px", drift: "6px" },
  { character: "s", delay: "20.96s", rotation: "-1.8deg", lift: "4px", drift: "-5px" },
  { character: "a", delay: "21.50s", rotation: "2.8deg", lift: "-2px", drift: "8px" },
  { character: "r", delay: "21.08s", rotation: "-2.2deg", lift: "5px", drift: "-7px" },
  { character: "a", delay: "21.72s", rotation: "1.6deg", lift: "0px", drift: "5px" }
] as const;
---

<div class="kisara-found-self" data-kisara-found-self aria-hidden="true">
  <div class="kisara-found-self-camera" data-kisara-found-self-camera>
    <div class="kisara-found-self-first" aria-hidden="true"></div>
    <video
      class="kisara-found-self-video"
      data-kisara-found-self-video
      data-src="/themes/kisara/assets/found-self-ep12.mp4"
      data-poster="/themes/kisara/assets/found-self-ep12-first.webp"
      playsinline
      preload="none"
      aria-hidden="true"
    ></video>
  </div>

  <div class="kisara-found-self-grade" aria-hidden="true"></div>

  <div class="kisara-found-self-inscription">
    <h1 aria-label="Kisara">
      {letters.map((letter) => (
        <span
          class="kisara-found-self-glyph"
          style={`--found-delay:${letter.delay};--found-rotation:${letter.rotation};--found-lift:${letter.lift};--found-drift:${letter.drift}`}
          aria-hidden="true"
        >
          <i>{letter.character}</i>
          <b>{letter.character}</b>
        </span>
      ))}
    </h1>
  </div>

  <div class="kisara-found-self-playback" aria-hidden="true">
    <span><i></i>AUTO</span>
    <b data-kisara-found-self-status>MEMORY SEARCH</b>
  </div>
  <button class="kisara-found-self-skip" type="button" data-kisara-found-self-skip>SKIP</button>
  <p class="sr-only" data-kisara-found-self-announcer aria-live="polite"></p>
</div>
