    }, { signal });
    audio.addEventListener("pause", updateAudioUi, { signal });
    audio.addEventListener("loadedmetadata", updateAudioUi, { signal });
    audio.addEventListener("durationchange", updateAudioUi, { signal });

    const cleanup = () => {
      if (disposed) return;
      disposed = true;
      lifecycle.abort();
      if (audioFrame) window.cancelAnimationFrame(audioFrame);
      if (fadeFrame) window.cancelAnimationFrame(fadeFrame);
      audioFrame = 0;
      fadeFrame = 0;
