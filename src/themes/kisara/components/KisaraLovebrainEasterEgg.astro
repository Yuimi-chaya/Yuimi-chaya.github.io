---
import { Icon } from "astro-icon/components";
---

<div class="kisara-lovebrain" data-kisara-lovebrain-root data-state="locked" data-stage="route">
  <button
    class="kisara-lovebrain-entry"
    type="button"
    data-lovebrain-entry
    aria-label="Lovebrain ED"
    title="Lovebrain ED"
    hidden
  >
    <Icon name="tabler:heart" aria-hidden="true" />
  </button>

  <section class="kisara-lovebrain-scene" data-lovebrain-scene aria-hidden="true">
    <div class="kisara-lovebrain-grid" aria-hidden="true"></div>
    <div class="kisara-lovebrain-header">
      <span>ED / LOVE BRAIN</span>
      <span data-lovebrain-stage>ROUTE</span>
      <span data-lovebrain-counter>00%</span>
    </div>

    <svg class="kisara-lovebrain-lines" viewBox="0 0 1000 700" preserveAspectRatio="none" aria-hidden="true">
      <path class="kisara-lovebrain-line is-pink" data-lovebrain-line="kisara" d="M-20 558 C128 470 166 172 368 220 S616 510 1020 112" />
      <path class="kisara-lovebrain-line is-green" data-lovebrain-line="shu" d="M-20 160 C158 208 228 598 462 428 S710 166 1020 504" />
      <path class="kisara-lovebrain-line is-cyan" data-lovebrain-line="ayano" d="M-20 356 C130 314 252 78 436 192 S742 636 1020 292" />
    </svg>

    <div class="kisara-lovebrain-frame-stage" aria-hidden="true">
      <img data-lovebrain-frame="route" data-src="/themes/kisara/assets/lovebrain/route.webp" alt="" />
      <img data-lovebrain-frame="messages" data-src="/themes/kisara/assets/lovebrain/messages.webp" alt="" />
      <img data-lovebrain-frame="chase" data-src="/themes/kisara/assets/lovebrain/chase.webp" alt="" />
      <img data-lovebrain-frame="pressure" data-src="/themes/kisara/assets/lovebrain/pressure.webp" alt="" />
      <img data-lovebrain-frame="final" data-src="/themes/kisara/assets/lovebrain/final.webp" alt="" />
    </div>

    <div class="kisara-lovebrain-notifications" data-lovebrain-notifications aria-label="Lovebrain notifications">
      <button type="button" data-lovebrain-notification data-memory="同一条通知，分别叫出了三个人的名字。" aria-label="读取通知 01"><span>01</span><b>seen / again</b></button>
      <button type="button" data-lovebrain-notification data-memory="Kisara 已读。Shu 没有删掉。Ayano 正在旁观。" aria-label="读取通知 02"><span>02</span><b>read receipt</b></button>
      <button type="button" data-lovebrain-notification data-memory="一条线路偏离了约定，另一条线路追了上去。" aria-label="读取通知 03"><span>03</span><b>route drift</b></button>
      <button type="button" data-lovebrain-notification data-memory="别把心跳当作系统噪声。" aria-label="读取通知 04"><span>04</span><b>heart / noise</b></button>
      <button type="button" data-lovebrain-notification data-memory="最后一条消息没有署名，但三个人都看见了。" aria-label="读取通知 05"><span>05</span><b>no sender</b></button>
      <button type="button" data-lovebrain-notification data-memory="他们没有同时回答，只是同时停下。" aria-label="读取通知 06"><span>06</span><b>hold</b></button>
    </div>

    <div class="kisara-lovebrain-fragments" data-lovebrain-fragments>
      <button type="button" data-lovebrain-focus="kisara" aria-label="聚焦 Kisara" aria-pressed="false">
        <img data-src="/themes/kisara/assets/lovebrain/kisara.webp" alt="Kisara" />
        <span>KISARA</span>
      </button>
      <button type="button" data-lovebrain-focus="shu" aria-label="聚焦 Shu" aria-pressed="false">
        <img data-src="/themes/kisara/assets/lovebrain/shu.webp" alt="Shu" />
        <span>SHU</span>
      </button>
      <button type="button" data-lovebrain-focus="ayano" aria-label="聚焦 Ayano" aria-pressed="false">
        <img data-src="/themes/kisara/assets/lovebrain/ayano.webp" alt="Ayano" />
        <span>AYANO</span>
      </button>
    </div>

    <div class="kisara-lovebrain-memory" data-lovebrain-memory aria-live="polite" aria-hidden="true">
      <span data-lovebrain-memory-label>MEMORY SLICE</span>
      <p data-lovebrain-memory-text></p>
    </div>

    <div class="kisara-lovebrain-final-mark" aria-hidden="true">
      <span>END / TOGETHER</span>
    </div>

    <div class="kisara-lovebrain-controls">
      <button
        class="kisara-lovebrain-audio"
        type="button"
        data-lovebrain-audio
        aria-label="暂停 Lovebrain ED"
        title="暂停 Lovebrain ED"
      >
        <Icon name="tabler:heart" aria-hidden="true" />
      </button>
      <button class="kisara-lovebrain-next" type="button" data-lovebrain-next aria-label="进入 001" title="进入 001">
        <Icon name="tabler:arrow-down" aria-hidden="true" />
      </button>
    </div>
    <p class="kisara-lovebrain-sr-status" data-lovebrain-status aria-live="polite"></p>
  </section>
</div>

<script is:inline data-astro-rerun>
  (() => {
    window.__yuimiKisaraLovebrainCleanup?.();
    const root = document.querySelector("[data-kisara-lovebrain-root]");
    if (!(root instanceof HTMLElement)) return;

    const entry = root.querySelector("[data-lovebrain-entry]");
    const scene = root.querySelector("[data-lovebrain-scene]");
    const stageLabel = root.querySelector("[data-lovebrain-stage]");
    const counter = root.querySelector("[data-lovebrain-counter]");
    const status = root.querySelector("[data-lovebrain-status]");
    const audioButton = root.querySelector("[data-lovebrain-audio]");
    const nextButton = root.querySelector("[data-lovebrain-next]");
    const memory = root.querySelector("[data-lovebrain-memory]");
    const memoryText = root.querySelector("[data-lovebrain-memory-text]");
    const progressApi = window.__yuimiKisaraLovebrainProgress;
    const homeApi = () => window.__yuimiKisaraHomeLovebrain;
    const lifecycle = new AbortController();
    const { signal } = lifecycle;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const stages = [
      { name: "ROUTE", key: "route", threshold: 0 },
      { name: "MESSAGES", key: "messages", threshold: 0.17 },
      { name: "FRAGMENTS", key: "fragments", threshold: 0.37 },
      { name: "CHASE", key: "chase", threshold: 0.57 },
      { name: "CONVERGE", key: "converge", threshold: 0.76 },
      { name: "FINAL", key: "final", threshold: 0.91 }
    ];
    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
    let disposed = false;
    let active = false;
    let leaving = false;
    let completed = false;
    let progress = 0;
    let targetProgress = 0;
    let animationFrame = 0;
    let memoryTimer = 0;
    let fadeFrame = 0;
    let touchY = null;
    let touchId = null;
    let audioSuspended = false;
    let mediaHydrated = false;
    const audio = new Audio("/themes/kisara/audio/renai-nou.mp3");
    audio.preload = "none";
    audio.loop = true;
    audio.playsInline = true;
    audio.volume = 0.62;

    const foundSelfBlocking = () => document.documentElement.dataset.kisaraFoundSelfEntry === "pending"
      || document.querySelector("[data-kisara-gate].is-found-self-active, [data-kisara-gate].is-found-self-leaving") !== null;
    const isHomeGate = () => document.body?.dataset.kisaraPage === "home" && window.scrollY <= 2;
    const isEligible = () => Boolean(progressApi?.isEligible?.()) && !foundSelfBlocking();
    const setAudioSuspension = (activeState) => {
      if (audioSuspended === activeState) return;
      audioSuspended = activeState;
      window.dispatchEvent(new CustomEvent("yuimi:kisara-audio-suspension", {
        detail: { id: "lovebrain-ed", active: activeState }
      }));
    };
    const syncAudioButton = () => {
      if (!(audioButton instanceof HTMLButtonElement)) return;
      const paused = audio.paused || audio.ended;
      audioButton.setAttribute("aria-label", paused ? "播放 Lovebrain ED" : "暂停 Lovebrain ED");
      audioButton.title = paused ? "播放 Lovebrain ED" : "暂停 Lovebrain ED";
      root.dataset.audioState = paused ? "paused" : "playing";
    };
    const stopAudioAndRelease = () => {
      if (fadeFrame) window.cancelAnimationFrame(fadeFrame);
      fadeFrame = 0;
      if (!audioSuspended && audio.paused) return;
      const startedAt = performance.now();
      const initialVolume = Math.max(0.05, audio.volume);
      const fade = (timestamp) => {
        if (disposed && timestamp - startedAt >= 220) {
          audio.pause();
          audio.currentTime = 0;
          audio.volume = 0.62;
          setAudioSuspension(false);
          fadeFrame = 0;
          return;
        }
        const ratio = clamp((timestamp - startedAt) / 220, 0, 1);
        audio.volume = initialVolume * (1 - ratio);
        if (ratio >= 1 || audio.paused) {
          audio.pause();
          audio.currentTime = 0;
          audio.volume = 0.62;
          setAudioSuspension(false);
          fadeFrame = 0;
          return;
        }
        fadeFrame = window.requestAnimationFrame(fade);
      };
      fadeFrame = window.requestAnimationFrame(fade);
    };
    const hydrateMedia = () => {
      if (mediaHydrated) return;
      mediaHydrated = true;
      root.querySelectorAll("img[data-src]").forEach((image, index) => {
        if (!(image instanceof HTMLImageElement)) return;
        const source = image.dataset.src;
        if (!source) return;
        image.decoding = "async";
        image.fetchPriority = index < 2 ? "high" : "low";
        image.src = source;
        delete image.dataset.src;
      });
    };
    const startAudio = (restart = false) => {
      setAudioSuspension(true);
      audio.preload = "auto";
      if (restart) {
        audio.load();
        try { audio.currentTime = 0; } catch {}
      } else if (audio.readyState === HTMLMediaElement.HAVE_NOTHING) {
        audio.load();
      }
      audio.volume = 0.62;
      const playPromise = audio.play();
      if (playPromise?.catch) playPromise.catch(() => undefined);
      syncAudioButton();
    };
    const setStatus = (value) => {
      if (status) status.textContent = value;
    };
    const currentStage = (value) => {
      let selected = stages[0];
      stages.forEach((stage) => {
        if (value >= stage.threshold) selected = stage;
      });
      return selected;
    };
    const render = () => {
      const value = clamp(progress, 0, 1);
      const stage = currentStage(value);
      const phase = (start, end) => clamp((value - start) / Math.max(0.001, end - start), 0, 1);
      const routeFade = phase(0.1, 0.28);
      const messageIn = phase(0.1, 0.22);
      const messageOut = phase(0.34, 0.5);
      const fragmentIn = phase(0.29, 0.45);
      const fragmentOut = phase(0.78, 0.95);
      const notificationOut = phase(0.68, 0.94);
      const chaseIn = phase(0.5, 0.64);
      const chaseOut = phase(0.7, 0.82);
      const pressureIn = phase(0.7, 0.81);
      const pressureOut = phase(0.84, 0.93);
      const finalIn = phase(0.84, 0.97);
      root.dataset.stage = stage.key;
      root.style.setProperty("--lovebrain-progress", value.toFixed(4));
      root.style.setProperty("--lovebrain-line-offset", `${((1 - phase(0, 0.92)) * 260).toFixed(2)}px`);
      root.style.setProperty("--lovebrain-route-opacity", (0.84 * (1 - routeFade)).toFixed(4));
      root.style.setProperty("--lovebrain-messages-opacity", (messageIn * (1 - messageOut) * 0.86).toFixed(4));
      root.style.setProperty("--lovebrain-notification-opacity", (1 - notificationOut).toFixed(4));
      root.style.setProperty("--lovebrain-fragment-opacity", (fragmentIn * (1 - fragmentOut)).toFixed(4));
      root.style.setProperty("--lovebrain-chase-opacity", (chaseIn * (1 - chaseOut) * 0.92).toFixed(4));
      root.style.setProperty("--lovebrain-pressure-opacity", (pressureIn * (1 - pressureOut) * 0.9).toFixed(4));
      root.style.setProperty("--lovebrain-final-opacity", finalIn.toFixed(4));
      root.style.setProperty("--lovebrain-final-scale", (1.035 - finalIn * 0.035).toFixed(4));
      if (stageLabel) stageLabel.textContent = stage.name;
      if (counter) counter.textContent = `${String(Math.round(value * 100)).padStart(2, "0")}%`;
      if (stage.key === "final") completed = true;
      if (completed || value >= 0.985) root.dataset.state = "complete";
      else if (active) root.dataset.state = "active";
      if (nextButton instanceof HTMLButtonElement) nextButton.disabled = !completed;
      if (completed) setStatus("LOVE BRAIN / FINAL");
      else if (active) setStatus(`${stage.name} / ${Math.round(value * 100)}%`);
    };
    const animate = (timestamp) => {
      animationFrame = 0;
      if (disposed || !active || leaving) return;
      if (reducedMotion) {
        progress = targetProgress;
        render();
        return;
      }
      const response = 1 - Math.exp(-Math.min(42, Math.max(0, timestamp - (animate.lastTimestamp ?? timestamp))) * 0.012);
      animate.lastTimestamp = timestamp;
      progress += (targetProgress - progress) * response;
      if (Math.abs(targetProgress - progress) < 0.001) progress = targetProgress;
      render();
      if (Math.abs(targetProgress - progress) >= 0.001) animationFrame = window.requestAnimationFrame(animate);
    };
    const scheduleRender = () => {
      if (reducedMotion) {
        progress = targetProgress;
        render();
        return;
      }
      if (!animationFrame) animationFrame = window.requestAnimationFrame(animate);
    };
    const updateEligibility = () => {
      if (!(entry instanceof HTMLButtonElement)) return;
      const visible = isEligible() && isHomeGate() && !active && !leaving;
      entry.hidden = !visible;
      entry.setAttribute("aria-hidden", String(!visible));
      root.dataset.qualified = String(isEligible());
    };
    const pushProgress = (delta, event, inputType) => {
      if (!active || leaving || root.dataset.state === "locked") return;
      event.preventDefault();
      if (completed && delta > 0) {
        homeApi()?.leaveToOpening?.();
        return;
      }
      const gain = inputType === "touch" ? 1150 : inputType === "keyboard" ? 920 : 1280;
      targetProgress = clamp(targetProgress + delta / gain, 0, 1);
      scheduleRender();
    };
    const activate = () => {
      if (disposed || active || leaving || foundSelfBlocking() || !isEligible()) return false;
      if (!homeApi()?.activate?.()) return false;
      active = true;
      completed = false;
      targetProgress = 0;
      progress = 0;
      hydrateMedia();
      root.classList.add("is-active");
      document.body.classList.add("is-lovebrain-scene-visible");
      scene?.setAttribute("aria-hidden", "false");
      setStatus("ROUTE / 00%");
      startAudio(true);
      updateEligibility();
      render();
      return true;
    };
    const leaveToOpening = () => {
      if (!active || leaving || !completed) return false;
      leaving = true;
      root.classList.add("is-transporting");
      setStatus("OPENING / 001");
      stopAudioAndRelease();
      const started = homeApi()?.leaveToOpening?.();
      if (!started) {
        leaving = false;
        root.classList.remove("is-transporting");
        setStatus("FINAL / TOGETHER");
      }
      return Boolean(started);
    };
    const finishOpening = () => {
      if (!leaving) return;
      leaving = false;
      active = false;
      completed = true;
      root.classList.remove("is-active", "is-transporting");
      document.body.classList.remove("is-lovebrain-scene-visible");
      root.dataset.state = "complete";
      scene?.setAttribute("aria-hidden", "true");
      updateEligibility();
    };
    const returnToGate = () => {
      if (!completed || disposed) return;
      active = true;
      leaving = false;
      root.classList.add("is-active");
      root.classList.remove("is-transporting");
      document.body.classList.add("is-lovebrain-scene-visible");
      scene?.setAttribute("aria-hidden", "false");
      render();
      setStatus("FINAL / TOGETHER");
      updateEligibility();
    };
    const startReturnToGate = () => {
      if (!completed || disposed) return;
      active = true;
      leaving = true;
      root.classList.add("is-active", "is-transporting");
      document.body.classList.add("is-lovebrain-scene-visible");
      scene?.setAttribute("aria-hidden", "false");
      setStatus("RETURN / LOVE BRAIN");
      updateEligibility();
    };
    const showMemorySlice = (button) => {
      if (!(memory instanceof HTMLElement) || !(memoryText instanceof HTMLElement)) return;
      const message = button.dataset.memory ?? "";
      memoryText.textContent = message;
      memory.classList.remove("is-visible");
      void memory.offsetWidth;
      memory.classList.add("is-visible");
      memory.setAttribute("aria-hidden", "false");
      if (memoryTimer) window.clearTimeout(memoryTimer);
      memoryTimer = window.setTimeout(() => {
        memoryTimer = 0;
        memory?.classList.remove("is-visible");
        memory?.setAttribute("aria-hidden", "true");
      }, 2200);
    };

    entry?.addEventListener("click", activate, { signal });
    audioButton?.addEventListener("click", () => {
      if (!active || leaving) return;
      if (audio.paused || audio.ended) startAudio(false);
      else {
        audio.pause();
        syncAudioButton();
      }
    }, { signal });
    entry?.addEventListener("pointerenter", hydrateMedia, { passive: true, signal });
    entry?.addEventListener("focus", hydrateMedia, { signal });
    nextButton?.addEventListener("click", leaveToOpening, { signal });
    root.querySelectorAll("[data-lovebrain-notification]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!active || leaving) return;
        button.classList.add("is-read");
        button.setAttribute("aria-pressed", "true");
        showMemorySlice(button);
      }, { signal });
    });
    root.querySelectorAll("[data-lovebrain-focus]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!active || leaving) return;
        const focus = button.dataset.lovebrainFocus ?? "";
        root.dataset.focus = focus;
        root.querySelectorAll("[data-lovebrain-focus]").forEach((candidate) => {
          candidate.setAttribute("aria-pressed", String(candidate === button));
        });
      }, { signal });
    });
    window.addEventListener("wheel", (event) => {
      if (event.ctrlKey || event.metaKey) return;
      pushProgress(event.deltaY, event, "wheel");
    }, { passive: false, signal });
    window.addEventListener("keydown", (event) => {
      if (event.ctrlKey || event.metaKey || event.altKey) return;
      if (event.target instanceof Element && event.target.closest("a, button, input, select, textarea, [contenteditable='true']")) return;
      const amount = ["ArrowDown", "PageDown", "End", " "].includes(event.key)
        ? 130
        : ["ArrowUp", "PageUp", "Home"].includes(event.key)
          ? -130
          : 0;
      if (amount) pushProgress(amount, event, "keyboard");
    }, { signal });
    window.addEventListener("touchstart", (event) => {
      if (event.touches.length !== 1) {
        touchId = null;
        touchY = null;
        return;
      }
      touchId = event.touches[0]?.identifier ?? null;
      touchY = event.touches[0]?.clientY ?? null;
    }, { passive: true, signal });
    window.addEventListener("touchmove", (event) => {
      if (!active || leaving || event.touches.length !== 1 || touchId === null || touchY === null) return;
      const touch = Array.from(event.touches).find((item) => item.identifier === touchId);
      if (!touch) return;
      const delta = touchY - touch.clientY;
      touchY = touch.clientY;
      pushProgress(delta * 2.25, event, "touch");
    }, { passive: false, signal });
    window.addEventListener("touchend", () => {
      touchId = null;
      touchY = null;
    }, { passive: true, signal });
    window.addEventListener("pointermove", (event) => {
      if (!active || leaving || reducedMotion || !scene) return;
      const rect = scene.getBoundingClientRect();
      if (rect.width <= 0 || rect.height <= 0) return;
      const x = clamp((event.clientX - rect.left) / rect.width, 0, 1) - 0.5;
      const y = clamp((event.clientY - rect.top) / rect.height, 0, 1) - 0.5;
      root.style.setProperty("--lovebrain-pointer-x", `${(x * 12).toFixed(2)}px`);
      root.style.setProperty("--lovebrain-pointer-y", `${(y * 8).toFixed(2)}px`);
    }, { passive: true, signal });
    window.addEventListener("yuimi:kisara-lovebrain-progress", updateEligibility, { signal });
    window.addEventListener("yuimi:kisara-found-self-state", updateEligibility, { signal });
    window.addEventListener("scroll", updateEligibility, { passive: true, signal });
    window.addEventListener("yuimi:kisara-lovebrain-opening-covered", finishOpening, { signal });
    window.addEventListener("yuimi:kisara-lovebrain-return-start", startReturnToGate, { signal });
    window.addEventListener("yuimi:kisara-lovebrain-return-gate", returnToGate, { signal });
    audio.addEventListener("play", syncAudioButton, { signal });
    audio.addEventListener("pause", syncAudioButton, { signal });

    const cleanup = () => {
      if (disposed) return;
      disposed = true;
      lifecycle.abort();
      if (animationFrame) window.cancelAnimationFrame(animationFrame);
      if (memoryTimer) window.clearTimeout(memoryTimer);
      animationFrame = 0;
      memoryTimer = 0;
      stopAudioAndRelease();
      root.classList.remove("is-active", "is-transporting");
      document.body.classList.remove("is-lovebrain-scene-visible");
      scene?.setAttribute("aria-hidden", "true");
      if (window.__yuimiKisaraLovebrainCleanup === cleanup) {
        window.__yuimiKisaraLovebrainCleanup = null;
      }
    };
    window.__yuimiKisaraLovebrainCleanup = cleanup;
    updateEligibility();
    syncAudioButton();
  })();
</script>

<style>
  .kisara-lovebrain {
    --lovebrain-pointer-x: 0px;
    --lovebrain-pointer-y: 0px;
    --lovebrain-progress: 0;
    --lovebrain-line-offset: 260px;
    --lovebrain-route-opacity: 0.84;
    --lovebrain-messages-opacity: 0;
    --lovebrain-notification-opacity: 1;
    --lovebrain-fragment-opacity: 0;
    --lovebrain-chase-opacity: 0;
    --lovebrain-pressure-opacity: 0;
    --lovebrain-final-opacity: 0;
    --lovebrain-final-scale: 1.035;
    position: static;
    filter: none !important;
    z-index: 60;
  }

  .kisara-lovebrain-entry,
  .kisara-lovebrain-audio,
  .kisara-lovebrain-next,
  .kisara-lovebrain-notifications button,
  .kisara-lovebrain-fragments button {
    appearance: none;
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  .kisara-lovebrain-entry {
    position: fixed;
    right: 198px;
    bottom: 28px;
    z-index: 75;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    padding: 0;
    color: #db6686;
    background: rgba(244, 247, 245, 0.92);
    box-shadow: 0 7px 22px rgba(50, 68, 64, 0.16), 0 0 0 1px rgba(219, 102, 134, 0.28);
    border-radius: 50%;
    transition: transform 180ms ease, color 180ms ease, box-shadow 180ms ease;
  }

  .kisara-lovebrain-entry:hover,
  .kisara-lovebrain-entry:focus-visible {
    color: #ba3d65;
    transform: translateY(-2px) scale(1.04);
    box-shadow: 0 10px 25px rgba(50, 68, 64, 0.2), 0 0 0 2px rgba(219, 102, 134, 0.28);
  }

  .kisara-lovebrain-entry svg,
  .kisara-lovebrain-audio svg,
  .kisara-lovebrain-next svg {
    width: 19px;
    height: 19px;
  }

  .kisara-lovebrain-scene {
    position: fixed;
    inset: 0;
    z-index: 70;
    overflow: hidden;
    color: #263c39;
    background-color: #e9edeb;
    background-image: radial-gradient(circle, rgba(69, 93, 87, 0.23) 0.8px, transparent 0.9px);
    background-size: 18px 18px;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, 0, 0);
    transition: opacity 240ms ease;
  }

  .kisara-lovebrain.is-active .kisara-lovebrain-scene {
    opacity: 1;
    pointer-events: auto;
  }

  .kisara-lovebrain.is-transporting .kisara-lovebrain-scene {
    opacity: 1;
    pointer-events: none;
  }

  .kisara-lovebrain-grid {
    position: absolute;
    inset: 0;
    opacity: 0.42;
