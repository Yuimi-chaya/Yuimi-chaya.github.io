---
import { Icon } from "astro-icon/components";
---

<div
  class="kisara-lovebrain"
  data-kisara-lovebrain-root
  data-state="locked"
  data-stage="orbit"
  data-player-state="hidden"
>
  <button
    class="kisara-lovebrain-entry"
    type="button"
    data-lovebrain-entry
    aria-label="进入《恋爱脑》隐藏舞台"
    title="进入《恋爱脑》隐藏舞台"
    hidden
  >
    <Icon name="tabler:heart" aria-hidden="true" />
  </button>

  <section class="kisara-lovebrain-scene" data-lovebrain-scene aria-hidden="true">
    <div class="kisara-lovebrain-panel kisara-lovebrain-orbit" data-lovebrain-panel="orbit" aria-hidden="true">
      <video
        data-lovebrain-scrub="orbit"
        data-src="/themes/kisara/assets/lovebrain/stage1-scrub.mp4"
        data-load-at="0"
        preload="none"
        muted
        playsinline
      ></video>
      <div class="kisara-lovebrain-orbit-wash"></div>
      <svg class="kisara-lovebrain-routes" viewBox="0 0 1200 760" preserveAspectRatio="none" aria-hidden="true">
        <path class="is-pink" d="M-80 610 C180 520 162 118 430 184 S758 642 1280 92" />
        <path class="is-green" d="M-70 154 C228 206 194 676 548 462 S890 90 1280 560" />
        <path class="is-cyan" d="M-90 382 C154 246 390 58 564 256 S870 688 1270 302" />
      </svg>
      <p class="kisara-lovebrain-orbit-copy">SCROLL = FRAME / STOP = HOLD</p>
    </div>

    <div class="kisara-lovebrain-panel kisara-lovebrain-portraits" data-lovebrain-panel="portraits">
      <div class="kisara-lovebrain-portrait-field" aria-hidden="true"></div>
      <div class="kisara-lovebrain-portrait-lineup" data-lovebrain-portraits>
        <button
          type="button"
          class="is-kisara"
          data-lovebrain-focus="kisara"
          aria-label="聚焦木更"
          aria-pressed="false"
        >
          <span class="kisara-lovebrain-portrait-frame">
            <img
              data-src="/themes/kisara/assets/lovebrain/kisara-avatar.webp"
              data-load-at="0.14"
              alt="木更"
            />
          </span>
          <span class="kisara-lovebrain-portrait-copy"><b>KISARA</b><small>全部都要</small></span>
        </button>
        <button
          type="button"
          class="is-shu"
          data-lovebrain-focus="shu"
          aria-label="聚焦修"
          aria-pressed="false"
        >
          <span class="kisara-lovebrain-portrait-frame">
            <img
              data-src="/themes/kisara/assets/lovebrain/shu-avatar.webp"
              data-load-at="0.14"
              alt="修"
            />
          </span>
          <span class="kisara-lovebrain-portrait-copy"><b>SHU</b><small>正在被追</small></span>
        </button>
        <button
          type="button"
          class="is-ayano"
          data-lovebrain-focus="ayano"
          aria-label="聚焦绫乃"
          aria-pressed="false"
        >
          <span class="kisara-lovebrain-portrait-frame">
            <img
              data-src="/themes/kisara/assets/lovebrain/ayano-avatar.webp"
              data-load-at="0.14"
              alt="绫乃"
            />
          </span>
          <span class="kisara-lovebrain-portrait-copy"><b>AYANO</b><small>绝不让路</small></span>
        </button>
      </div>
    </div>

    <div class="kisara-lovebrain-panel kisara-lovebrain-race" data-lovebrain-panel="race" aria-hidden="true">
      <video
        data-lovebrain-scrub="race"
        data-src="/themes/kisara/assets/lovebrain/race-scrub.mp4"
        data-load-at="0.31"
        preload="none"
        muted
        playsinline
      ></video>
      <div class="kisara-lovebrain-speed-lines" aria-hidden="true"></div>
      <p>FORWARD / BACKWARD</p>
    </div>

    <div class="kisara-lovebrain-panel kisara-lovebrain-pinch" data-lovebrain-panel="pinch" aria-hidden="true">
      <video
        data-lovebrain-loop="pinch"
        data-src="/themes/kisara/assets/lovebrain/pinch-loop.mp4"
        data-load-at="0.54"
        preload="none"
        muted
        loop
        playsinline
      ></video>
      <div class="kisara-lovebrain-loop-caption">
        <span>NO WINNER</span>
        <b>still arguing</b>
      </div>
    </div>

    <div class="kisara-lovebrain-panel kisara-lovebrain-embrace" data-lovebrain-panel="embrace" aria-hidden="true">
      <video
        data-lovebrain-loop="embrace"
        data-src="/themes/kisara/assets/lovebrain/stage2-loop.mp4"
        data-load-at="0.68"
        preload="none"
        muted
        loop
        playsinline
      ></video>
      <div class="kisara-lovebrain-embrace-ring" aria-hidden="true"></div>
      <p>ONE MORE ROUND</p>
    </div>

    <div class="kisara-lovebrain-panel kisara-lovebrain-final" data-lovebrain-panel="final" aria-hidden="true">
      <img
        data-src="/themes/kisara/assets/lovebrain/final.webp"
        data-load-at="0.76"
        alt=""
      />
      <div class="kisara-lovebrain-final-copy">
        <span>THE ROUTES DID NOT MERGE</span>
        <b>they simply kept walking</b>
      </div>
    </div>

    <header class="kisara-lovebrain-header">
      <span>恋愛脳 / SECRET ED</span>
      <span data-lovebrain-stage>COLOR ROUTE</span>
      <span data-lovebrain-counter>00%</span>
    </header>

    <nav class="kisara-lovebrain-rail" aria-label="隐藏舞台进度">
      <i data-lovebrain-rail-progress></i>
      <span>COLOR</span>
      <span>FACES</span>
      <span>RACE</span>
      <span>PINCH</span>
      <span>ORBIT</span>
      <span>END</span>
    </nav>

    <button
      class="kisara-lovebrain-next"
      type="button"
      data-lovebrain-next
      aria-label="进入 001"
      title="进入 001"
      disabled
    >
      <Icon name="tabler:arrow-down" aria-hidden="true" />
    </button>
    <p class="kisara-lovebrain-sr-status" data-lovebrain-status aria-live="polite"></p>
  </section>

  <aside class="kisara-lovebrain-player" data-lovebrain-player aria-label="恋爱脑播放器" hidden>
    <div class="kisara-lovebrain-player-art" aria-hidden="true">
      <i></i><i></i><i></i>
      <Icon name="tabler:heart" />
    </div>
    <button
      class="kisara-lovebrain-player-toggle"
      type="button"
      data-lovebrain-audio-toggle
      aria-label="暂停《恋爱脑》"
      title="暂停《恋爱脑》"
    >
      <Icon class="is-play" name="tabler:player-play" aria-hidden="true" />
      <Icon class="is-pause" name="tabler:player-pause" aria-hidden="true" />
    </button>
    <div class="kisara-lovebrain-player-copy">
      <span><b>恋愛脳</b><small>Engage Kiss ED</small></span>
      <input
        type="range"
        min="0"
        max="1000"
        step="1"
        value="0"
        data-lovebrain-audio-progress
        aria-label="恋爱脑播放进度"
      />
      <time data-lovebrain-audio-time>00:00 / 00:00</time>
    </div>
    <button
      class="kisara-lovebrain-player-close"
      type="button"
      data-lovebrain-audio-close
      aria-label="关闭《恋爱脑》播放器"
      title="关闭《恋爱脑》播放器"
    >
      <Icon name="tabler:x" aria-hidden="true" />
    </button>
  </aside>
</div>

<script is:inline data-astro-rerun>
  (() => {
    window.__yuimiKisaraLovebrainCleanup?.();
    const root = document.querySelector("[data-kisara-lovebrain-root]");
    if (!(root instanceof HTMLElement)) return;

    const entry = root.querySelector("[data-lovebrain-entry]");
    const scene = root.querySelector("[data-lovebrain-scene]");
    const stageLabel = root.querySelector("[data-lovebrain-stage]");
    const counter = root.querySelector("[data-lovebrain-counter]");
    const status = root.querySelector("[data-lovebrain-status]");
    const nextButton = root.querySelector("[data-lovebrain-next]");
    const railProgress = root.querySelector("[data-lovebrain-rail-progress]");
    const player = root.querySelector("[data-lovebrain-player]");
    const audioToggle = root.querySelector("[data-lovebrain-audio-toggle]");
    const audioClose = root.querySelector("[data-lovebrain-audio-close]");
    const audioProgress = root.querySelector("[data-lovebrain-audio-progress]");
    const audioTime = root.querySelector("[data-lovebrain-audio-time]");
    const orbitVideo = root.querySelector('[data-lovebrain-scrub="orbit"]');
    const raceVideo = root.querySelector('[data-lovebrain-scrub="race"]');
    const pinchVideo = root.querySelector('[data-lovebrain-loop="pinch"]');
    const embraceVideo = root.querySelector('[data-lovebrain-loop="embrace"]');
    const progressApi = window.__yuimiKisaraLovebrainProgress;
    const homeApi = () => window.__yuimiKisaraHomeLovebrain;
    const lifecycle = new AbortController();
    const { signal } = lifecycle;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const coarsePointer = window.matchMedia("(pointer: coarse)").matches;
    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
    const smoothstep = (start, end, value) => {
      const ratio = clamp((value - start) / Math.max(0.0001, end - start), 0, 1);
      return ratio * ratio * (3 - 2 * ratio);
    };
    const stages = [
      { name: "COLOR ROUTE", key: "orbit", threshold: 0 },
      { name: "THREE FACES", key: "portraits", threshold: 0.24 },
      { name: "KEEP RUNNING", key: "race", threshold: 0.43 },
      { name: "NO WINNER", key: "pinch", threshold: 0.67 },
      { name: "ONE MORE ROUND", key: "embrace", threshold: 0.8 },
      { name: "TOGETHER", key: "final", threshold: 0.925 }
    ];

    let disposed = false;
    let active = false;
    let leaving = false;
    let completed = false;
    let progress = 0;
    let sceneConsumed = false;
    let touchY = null;
    let touchId = null;
    let audioSuspended = false;
    let audioSession = false;
    let audioFrame = 0;
    let fadeFrame = 0;
    let mediaSerial = 0;
    const hydratedMedia = new WeakSet();
    const audio = new Audio("/themes/kisara/audio/renai-nou.mp3");
    audio.preload = "none";
    audio.loop = true;
    audio.playsInline = true;
    audio.volume = 0.64;

    const foundSelfBlocking = () => document.documentElement.dataset.kisaraFoundSelfEntry === "pending"
      || document.querySelector("[data-kisara-gate].is-found-self-active, [data-kisara-gate].is-found-self-leaving") !== null;
    const isHomeGate = () => document.body?.dataset.kisaraPage === "home" && window.scrollY <= 2;
    const isEligible = () => Boolean(progressApi?.isEligible?.()) && !foundSelfBlocking();
    const formatTime = (value) => {
      const safe = Number.isFinite(value) && value > 0 ? value : 0;
      const minutes = Math.floor(safe / 60);
      const seconds = Math.floor(safe % 60);
      return String(minutes).padStart(2, "0") + ":" + String(seconds).padStart(2, "0");
    };
    const setStatus = (value) => {
      if (status) status.textContent = value;
    };
    const currentStage = (value) => {
      let selected = stages[0];
      stages.forEach((stage) => {
        if (value >= stage.threshold) selected = stage;
      });
      return selected;
    };
    const setAudioSuspension = (activeState) => {
      if (audioSuspended === activeState) return;
      audioSuspended = activeState;
      window.dispatchEvent(new CustomEvent("yuimi:kisara-audio-suspension", {
        detail: { id: "lovebrain-ed", active: activeState }
      }));
    };
    const updateAudioUi = () => {
      if (!(audioToggle instanceof HTMLButtonElement)) return;
      const paused = audio.paused || audio.ended;
      root.dataset.playerState = paused ? "paused" : "playing";
      audioToggle.setAttribute("aria-label", paused ? "播放《恋爱脑》" : "暂停《恋爱脑》");
      audioToggle.title = paused ? "播放《恋爱脑》" : "暂停《恋爱脑》";
      if (audioProgress instanceof HTMLInputElement) {
        const duration = Number.isFinite(audio.duration) && audio.duration > 0 ? audio.duration : 0;
        const ratio = duration > 0 ? clamp(audio.currentTime / duration, 0, 1) : 0;
        audioProgress.value = String(Math.round(ratio * 1000));
        audioProgress.style.setProperty("--lovebrain-audio-progress", String(ratio));
      }
      if (audioTime instanceof HTMLTimeElement) {
        audioTime.textContent = formatTime(audio.currentTime) + " / " + formatTime(audio.duration);
      }
    };
    const tickAudioUi = () => {
      audioFrame = 0;
      updateAudioUi();
      if (!disposed && audioSession && !audio.paused) {
        audioFrame = window.requestAnimationFrame(tickAudioUi);
      }
    };
    const showPlayer = () => {
      if (!(player instanceof HTMLElement)) return;
      player.hidden = false;
      player.setAttribute("aria-hidden", "false");
      root.dataset.playerState = audio.paused ? "paused" : "playing";
      document.body.classList.add("is-lovebrain-audio-owned");
    };
    const hidePlayer = () => {
      if (!(player instanceof HTMLElement)) return;
      player.hidden = true;
      player.setAttribute("aria-hidden", "true");
      root.dataset.playerState = "hidden";
      document.body.classList.remove("is-lovebrain-audio-owned");
    };
    const startAudio = ({ restart = false } = {}) => {
      const firstSession = !audioSession;
      audioSession = true;
      showPlayer();
      setAudioSuspension(true);
      audio.preload = "auto";
      if (audio.readyState === HTMLMediaElement.HAVE_NOTHING) audio.load();
      if (restart || firstSession || audio.ended) {
        try { audio.currentTime = 0; } catch {}
      }
      audio.volume = 0.64;
      const promise = audio.play();
      if (promise?.catch) promise.catch(() => updateAudioUi());
      if (!audioFrame) audioFrame = window.requestAnimationFrame(tickAudioUi);
      updateAudioUi();
    };
    const stopAudioSession = ({ immediate = false } = {}) => {
      if (fadeFrame) window.cancelAnimationFrame(fadeFrame);
      fadeFrame = 0;
      if (!audioSession && audio.paused) {
        setAudioSuspension(false);
        hidePlayer();
        return;
      }
      const finish = () => {
        audio.pause();
        try { audio.currentTime = 0; } catch {}
        audio.volume = 0.64;
        audioSession = false;
        setAudioSuspension(false);
        hidePlayer();
        updateAudioUi();
      };
      if (immediate || audio.paused) {
        finish();
        return;
      }
      const startedAt = performance.now();
      const initialVolume = Math.max(0.04, audio.volume);
      const fade = (timestamp) => {
        const ratio = clamp((timestamp - startedAt) / 260, 0, 1);
        audio.volume = initialVolume * (1 - ratio);
        if (ratio >= 1 || disposed) {
          fadeFrame = 0;
          finish();
          return;
        }
        fadeFrame = window.requestAnimationFrame(fade);
      };
      fadeFrame = window.requestAnimationFrame(fade);
    };
    const hydrateElement = (element) => {
      if (
        hydratedMedia.has(element)
        || !(element instanceof HTMLImageElement || element instanceof HTMLVideoElement)
      ) return;
      const source = element.dataset.src;
      if (!source) return;
      hydratedMedia.add(element);
      if (element instanceof HTMLImageElement) {
        element.decoding = "async";
        element.src = source;
      } else {
        element.preload = "auto";
        element.src = source;
        element.load();
      }
      delete element.dataset.src;
    };
    const hydrateMediaTo = (value) => {
      const serial = ++mediaSerial;
      root.querySelectorAll("[data-src]").forEach((element) => {
        const loadAt = Number.parseFloat(element.dataset.loadAt ?? "0");
        if (value + 0.001 < loadAt) return;
        if (serial !== mediaSerial) return;
        hydrateElement(element);
      });
    };
    const seekPausedVideo = (video, ratio) => {
      if (!(video instanceof HTMLVideoElement)) return;
      video.pause();
      if (video.readyState < HTMLMediaElement.HAVE_METADATA || !Number.isFinite(video.duration)) return;
      const frameTail = 1 / 30;
      const target = clamp(ratio, 0, 1) * Math.max(0, video.duration - frameTail);
      if (Math.abs(video.currentTime - target) < frameTail * 0.45) return;
      try { video.currentTime = target; } catch {}
    };
    const syncLoopVideo = (video, shouldPlay) => {
      if (!(video instanceof HTMLVideoElement)) return;
      if (shouldPlay && active && !leaving && document.visibilityState === "visible") {
        const promise = video.play();
        if (promise?.catch) promise.catch(() => undefined);
      } else {
        video.pause();
      }
    };
    const render = () => {
      const value = clamp(progress, 0, 1);
      const stage = currentStage(value);
      const orbitOut = smoothstep(0.19, 0.29, value);
      const portraitIn = smoothstep(0.18, 0.28, value);
      const portraitOut = smoothstep(0.38, 0.48, value);
      const raceIn = smoothstep(0.39, 0.48, value);
      const raceOut = smoothstep(0.62, 0.71, value);
      const pinchIn = smoothstep(0.63, 0.71, value);
      const pinchOut = smoothstep(0.75, 0.82, value);
      const embraceIn = smoothstep(0.76, 0.83, value);
      const embraceOut = smoothstep(0.87, 0.94, value);
      const finalIn = smoothstep(0.88, 0.97, value);
      const orbitOpacity = 1 - orbitOut;
      const portraitOpacity = portraitIn * (1 - portraitOut);
      const raceOpacity = raceIn * (1 - raceOut);
      const pinchOpacity = pinchIn * (1 - pinchOut);
      const embraceOpacity = embraceIn * (1 - embraceOut);

      root.dataset.stage = stage.key;
      root.style.setProperty("--lovebrain-progress", value.toFixed(5));
      root.style.setProperty("--lovebrain-orbit-progress", clamp(value / 0.26, 0, 1).toFixed(5));
      root.style.setProperty("--lovebrain-orbit-opacity", orbitOpacity.toFixed(5));
      root.style.setProperty("--lovebrain-portrait-opacity", portraitOpacity.toFixed(5));
      root.style.setProperty("--lovebrain-race-opacity", raceOpacity.toFixed(5));
      root.style.setProperty("--lovebrain-pinch-opacity", pinchOpacity.toFixed(5));
      root.style.setProperty("--lovebrain-embrace-opacity", embraceOpacity.toFixed(5));
      root.style.setProperty("--lovebrain-final-opacity", finalIn.toFixed(5));
      root.style.setProperty("--lovebrain-scene-shift", ((value - 0.5) * 12).toFixed(2) + "px");
      if (railProgress instanceof HTMLElement) railProgress.style.transform = "scaleX(" + value.toFixed(5) + ")";
      if (stageLabel) stageLabel.textContent = stage.name;
      if (counter) counter.textContent = String(Math.round(value * 100)).padStart(2, "0") + "%";

      hydrateMediaTo(value + 0.12);
      seekPausedVideo(orbitVideo, clamp(value / 0.255, 0, 1));
      seekPausedVideo(raceVideo, clamp((value - 0.42) / 0.255, 0, 1));
      syncLoopVideo(pinchVideo, pinchOpacity > 0.12);
      syncLoopVideo(embraceVideo, embraceOpacity > 0.12);

      completed = value >= 0.995;
      if (active) root.dataset.state = completed ? "complete" : "active";
      if (nextButton instanceof HTMLButtonElement) nextButton.disabled = !completed;
      setStatus(completed ? "LOVE BRAIN / COMPLETE" : stage.name + " / " + Math.round(value * 100) + "%");
    };
    const updateEligibility = () => {
      if (!(entry instanceof HTMLButtonElement)) return;
      const visible = isEligible() && isHomeGate() && !active && !leaving;
      entry.hidden = !visible;
      entry.setAttribute("aria-hidden", String(!visible));
      root.dataset.qualified = String(isEligible());
    };
    const pushProgress = (delta, event, inputType) => {
      if (!active || leaving || root.dataset.state === "locked") return;
      event.preventDefault();
      if (completed && delta > 0) {
        leaveToOpening();
        return;
      }
      const gain = inputType === "touch" ? 1350 : inputType === "keyboard" ? 1150 : 2500;
      progress = clamp(progress + delta / gain, 0, 1);
      render();
    };
    const activate = () => {
      if (disposed || active || leaving || foundSelfBlocking() || !isEligible()) return false;
      if (!homeApi()?.activate?.()) return false;
      active = true;
      leaving = false;
      completed = false;
      sceneConsumed = false;
      progress = 0;
      hydrateMediaTo(0.16);
      root.classList.add("is-active");
      root.classList.remove("is-transporting", "is-returning");
      document.body.classList.add("is-lovebrain-scene-visible");
      scene?.setAttribute("aria-hidden", "false");
      startAudio({ restart: !audioSession });
      render();
      updateEligibility();
      return true;
    };
    const leaveToOpening = () => {
      if (!active || leaving || !completed) return false;
      leaving = true;
      root.classList.add("is-transporting");
      setStatus("DISSOLVE / 001");
      syncLoopVideo(pinchVideo, false);
      syncLoopVideo(embraceVideo, false);
      const started = homeApi()?.leaveToOpening?.();
      if (!started) {
        leaving = false;
        root.classList.remove("is-transporting");
        setStatus("LOVE BRAIN / COMPLETE");
      }
      return Boolean(started);
    };
    const finishOpening = () => {
      if (!leaving) return;
      leaving = false;
      active = false;
      completed = false;
      sceneConsumed = true;
      progress = 0;
      root.classList.remove("is-active", "is-transporting", "is-returning");
      document.body.classList.remove("is-lovebrain-scene-visible");
      root.dataset.state = "consumed";
      scene?.setAttribute("aria-hidden", "true");
      render();
      updateEligibility();
    };
    const startReturnToGate = () => {
      if (!active || disposed) return;
      leaving = true;
      root.classList.remove("is-transporting");
      root.classList.add("is-active", "is-returning");
      document.body.classList.add("is-lovebrain-scene-visible");
      scene?.setAttribute("aria-hidden", "false");
      setStatus("RETURN / LOVE BRAIN");
    };
    const returnToGate = () => {
      if (disposed || sceneConsumed) return;
      active = true;
      leaving = false;
      root.classList.add("is-active");
      root.classList.remove("is-transporting", "is-returning");
      document.body.classList.add("is-lovebrain-scene-visible");
      scene?.setAttribute("aria-hidden", "false");
      render();
      updateEligibility();
    };

    entry?.addEventListener("pointerenter", () => hydrateMediaTo(0.02), { passive: true, signal });
    entry?.addEventListener("focus", () => hydrateMediaTo(0.02), { signal });
    entry?.addEventListener("click", activate, { signal });
    nextButton?.addEventListener("click", leaveToOpening, { signal });
    root.querySelectorAll("[data-lovebrain-focus]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!active || leaving) return;
        const focus = button.dataset.lovebrainFocus ?? "";
        root.dataset.focus = root.dataset.focus === focus ? "" : focus;
        root.querySelectorAll("[data-lovebrain-focus]").forEach((candidate) => {
          candidate.setAttribute("aria-pressed", String(root.dataset.focus === candidate.dataset.lovebrainFocus));
        });
      }, { signal });
    });
    audioToggle?.addEventListener("click", () => {
      if (!audioSession) {
        startAudio({ restart: false });
        return;
      }
      if (audio.paused || audio.ended) startAudio({ restart: audio.ended });
      else {
        audio.pause();
        updateAudioUi();
      }
    }, { signal });
    audioClose?.addEventListener("click", () => stopAudioSession(), { signal });
    audioProgress?.addEventListener("input", () => {
      if (!(audioProgress instanceof HTMLInputElement)) return;
      if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
      const ratio = clamp(Number(audioProgress.value) / 1000, 0, 1);
      try { audio.currentTime = ratio * audio.duration; } catch {}
      updateAudioUi();
    }, { signal });
    window.addEventListener("wheel", (event) => {
      if (event.ctrlKey || event.metaKey) return;
      pushProgress(event.deltaY, event, "wheel");
    }, { passive: false, signal });
    window.addEventListener("keydown", (event) => {
      if (event.ctrlKey || event.metaKey || event.altKey) return;
      if (event.target instanceof Element && event.target.closest("a, button, input, select, textarea, [contenteditable='true']")) return;
      const amount = ["ArrowDown", "PageDown", "End", " "].includes(event.key)
        ? 140
        : ["ArrowUp", "PageUp", "Home"].includes(event.key)
          ? -140
          : 0;
      if (amount) pushProgress(amount, event, "keyboard");
    }, { signal });
    window.addEventListener("touchstart", (event) => {
      if (event.touches.length !== 1) {
        touchId = null;
        touchY = null;
        return;
      }
      touchId = event.touches[0]?.identifier ?? null;
      touchY = event.touches[0]?.clientY ?? null;
    }, { passive: true, signal });
    window.addEventListener("touchmove", (event) => {
      if (!active || leaving || event.touches.length !== 1 || touchId === null || touchY === null) return;
      const touch = Array.from(event.touches).find((item) => item.identifier === touchId);
      if (!touch) return;
      const delta = touchY - touch.clientY;
      touchY = touch.clientY;
      pushProgress(delta * 2.15, event, "touch");
    }, { passive: false, signal });
    window.addEventListener("touchend", () => {
      touchId = null;
      touchY = null;
    }, { passive: true, signal });
    window.addEventListener("pointermove", (event) => {
      if (!active || leaving || reducedMotion || coarsePointer || !(scene instanceof HTMLElement)) return;
      const rect = scene.getBoundingClientRect();
      if (rect.width <= 0 || rect.height <= 0) return;
      const x = clamp((event.clientX - rect.left) / rect.width, 0, 1) - 0.5;
      const y = clamp((event.clientY - rect.top) / rect.height, 0, 1) - 0.5;
      root.style.setProperty("--lovebrain-pointer-x", (x * 14).toFixed(2) + "px");
      root.style.setProperty("--lovebrain-pointer-y", (y * 10).toFixed(2) + "px");
    }, { passive: true, signal });
    window.addEventListener("yuimi:kisara-lovebrain-progress", updateEligibility, { signal });
    window.addEventListener("yuimi:kisara-found-self-state", updateEligibility, { signal });
    window.addEventListener("scroll", updateEligibility, { passive: true, signal });
    window.addEventListener("yuimi:kisara-lovebrain-opening-covered", finishOpening, { signal });
    window.addEventListener("yuimi:kisara-lovebrain-return-start", startReturnToGate, { signal });
    window.addEventListener("yuimi:kisara-lovebrain-return-gate", returnToGate, { signal });
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") render();
      else {
        syncLoopVideo(pinchVideo, false);
        syncLoopVideo(embraceVideo, false);
      }
    }, { signal });
    [orbitVideo, raceVideo].forEach((video) => {
      video?.addEventListener("loadedmetadata", render, { signal });
    });
    audio.addEventListener("play", () => {
      root.dataset.playerState = "playing";
      if (!audioFrame) audioFrame = window.requestAnimationFrame(tickAudioUi);
