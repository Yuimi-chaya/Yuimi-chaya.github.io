---
import { Icon } from "astro-icon/components";
---

<section class="kisara-fridge-deck" data-kisara-home-stop="002" aria-labelledby="kisara-fridge-title">
  <kisara-fridge-scene class="kisara-fridge-scene" data-fridge-bound="true">
    <div class="kisara-fridge-media">
      <video
        class="kisara-fridge-video"
        data-fridge-video
        src="/themes/kisara/assets/fridge-opening-002.mp4"
        poster="/themes/kisara/assets/fridge-opening-002-first.webp"
        preload="auto"
        muted
        playsinline
        aria-label="木更打开冰箱并向冰箱内张望"
      ></video>
      <span class="kisara-fridge-grade" aria-hidden="true"></span>
    </div>

    <div class="kisara-content-shell kisara-fridge-content">
      <header class="kisara-fridge-overlay-heading">
        <p class="kisara-section-index">COLD STORAGE / 002</p>
        <div class="kisara-fridge-findings-status">
          <span data-fridge-status>SEALED</span>
          <small>EP.08 / INSIDE VIEW</small>
        </div>
      </header>

      <div class="kisara-fridge-copy">
        <p class="kisara-fridge-copy-kicker">WHEN THE LIGHT COMES IN</p>
        <h2 id="kisara-fridge-title" class="kisara-fridge-copy-title">
          <span>门刚打开，</span>
          <strong>今天在做的东西先掉了下来。</strong>
        </h2>
        <p class="kisara-fridge-copy-body">UE 还没喝完，AstrBot 仍在发酵，Blog 倒是已经膨成了一整袋。没有库存表，最近惦记什么，就先把什么塞进来。</p>
      </div>
    </div>

    <div class="kisara-fridge-physics" data-fridge-physics aria-label="可拖拽的冰箱存货">
      <button class="kisara-fridge-body is-milk" type="button" data-fridge-body data-fridge-kind="milk" aria-label="按住拖拽 UE 牛奶盒">
        <svg viewBox="0 0 180 260" role="img" aria-hidden="true">
          <defs>
            <linearGradient id="kisara-milk-front" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#fbfdff" />
              <stop offset="0.56" stop-color="#dce9ee" />
              <stop offset="1" stop-color="#b9cbd2" />
            </linearGradient>
            <linearGradient id="kisara-milk-side" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#a8bbc4" />
              <stop offset="1" stop-color="#7f98a3" />
            </linearGradient>
            <linearGradient id="kisara-milk-pink" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#ef8fad" />
              <stop offset="1" stop-color="#b84067" />
            </linearGradient>
          </defs>
          <path d="M30 67 69 19h56l28 44-13 20H42Z" fill="#edf5f7" />
          <path d="m69 19 27 43 57 1-28-44Z" fill="#cad9de" />
          <path d="m30 67 13 16v155l92 9 18-17V63l-57-1-27-43Z" fill="url(#kisara-milk-front)" />
          <path d="m135 80 18-17v167l-18 17Z" fill="url(#kisara-milk-side)" />
          <path d="M43 83h92v48H43Z" fill="url(#kisara-milk-pink)" opacity="0.92" />
          <path d="M43 131h92v13H43Z" fill="#5f7481" opacity="0.34" />
          <path d="M52 157h72v66H52Z" fill="#f8fbfc" opacity="0.82" />
          <svg x="64" y="163" width="50" height="50" viewBox="0 0 24 24" fill="#26333a">
            <path d="M12 0a12 12 0 1 0 12 12A12 12 0 0 0 12 0m0 23.52A11.52 11.52 0 1 1 23.52 12A11.52 11.52 0 0 1 12 23.52m7.13-9.791c-.206.997-1.126 3.557-4.06 4.942l-1.179-1.325l-1.988 2a7.34 7.34 0 0 1-5.804-2.978a3 3 0 0 0 .65.123c.326.006.678-.114.678-.66v-5.394a.89.89 0 0 0-1.116-.89c-.92.212-1.656 2.509-1.656 2.509a7.3 7.3 0 0 1 2.528-5.597a7.4 7.4 0 0 1 3.73-1.721c-1.006.573-1.57 1.507-1.57 2.29c0 1.262.76 1.109.984.923v7.28a1.2 1.2 0 0 0 .148.256a1.08 1.08 0 0 0 .88.445c.76 0 1.747-.868 1.747-.868V9.172c0-.6-.452-1.324-.905-1.572c0 0 .838-.149 1.484.346a6 6 0 0 1 .387-.425c1.508-1.48 2.929-1.902 4.112-2.112c0 0-2.151 1.69-2.151 3.96c0 1.687.043 5.801.043 5.801c.799.771 1.986-.342 3.059-1.441Z" />
          </svg>
          <text x="89" y="232" fill="#34444c" font-family="Arial, sans-serif" font-size="10" font-weight="800" text-anchor="middle">ENGINE 5</text>
          <path d="M54 90h70" stroke="#fff" stroke-width="3" opacity="0.38" />
          <path d="m30 67 13 16v155l92 9 18-17V63l-57-1-27-43Z" fill="none" stroke="#627984" stroke-width="2" opacity="0.54" />
        </svg>
      </button>

      <button class="kisara-fridge-body is-can" type="button" data-fridge-body data-fridge-kind="can" aria-label="按住拖拽 AstrBot 小罐子">
        <svg viewBox="0 0 180 220" role="img" aria-hidden="true">
          <defs>
            <linearGradient id="kisara-can-body" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#7e949e" />
              <stop offset="0.17" stop-color="#dce8eb" />
              <stop offset="0.52" stop-color="#f8fbfc" />
              <stop offset="0.82" stop-color="#b9cbd2" />
              <stop offset="1" stop-color="#728994" />
            </linearGradient>
            <linearGradient id="kisara-can-label" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#edfaff" />
              <stop offset="1" stop-color="#caedf7" />
