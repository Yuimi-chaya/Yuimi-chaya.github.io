          </defs>
          <ellipse cx="90" cy="31" rx="59" ry="19" fill="#d9e3e6" />
          <path d="M31 31v155c0 12 26 22 59 22s59-10 59-22V31Z" fill="url(#kisara-can-body)" />
          <ellipse cx="90" cy="31" rx="59" ry="19" fill="#eff5f6" stroke="#72868f" stroke-width="3" />
          <ellipse cx="90" cy="31" rx="44" ry="11" fill="#b4c4ca" />
          <path d="M82 28c9-4 19-3 27 1" fill="none" stroke="#687c85" stroke-width="4" stroke-linecap="round" />
          <path d="M44 69c28-8 64-8 92 0v92c-28 8-64 8-92 0Z" fill="url(#kisara-can-label)" />
          <rect x="61" y="82" width="58" height="58" rx="14" fill="#fff" />
          <path d="m90 91 7 18 19 7-19 7-7 18-7-18-19-7 19-7Z" fill="#59b5d3" />
          <path d="M70 96v10M65 101h10M110 126v10M105 131h10" stroke="#59b5d3" stroke-width="5" stroke-linecap="round" />
          <text x="90" y="154" fill="#315767" font-family="Arial, sans-serif" font-size="12" font-weight="800" text-anchor="middle">ASTRBOT</text>
          <path d="M43 50c25 7 68 7 94 0" fill="none" stroke="#fff" stroke-width="4" opacity="0.48" />
          <ellipse cx="90" cy="186" rx="59" ry="22" fill="#849aa3" opacity="0.5" />
          <ellipse cx="90" cy="185" rx="54" ry="17" fill="#c2d0d4" />
        </svg>
      </button>

      <button class="kisara-fridge-body is-chips" type="button" data-fridge-body data-fridge-kind="chips" aria-label="按住拖拽 Blog 薯片袋">
        <svg viewBox="0 0 220 280" role="img" aria-hidden="true">
          <defs>
            <linearGradient id="kisara-chip-bag" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#8c274f" />
              <stop offset="0.45" stop-color="#df668d" />
              <stop offset="1" stop-color="#6d173a" />
            </linearGradient>
            <radialGradient id="kisara-chip-light" cx="36%" cy="26%" r="72%">
              <stop offset="0" stop-color="#fff" stop-opacity="0.5" />
              <stop offset="1" stop-color="#fff" stop-opacity="0" />
            </radialGradient>
          </defs>
          <path d="m38 19 16 8 18-7 19 7 20-8 20 8 20-7 17 8 18-8-9 27 9 190-18-7-18 9-20-8-20 9-19-9-19 8-18-9-17 8 8-190Z" fill="url(#kisara-chip-bag)" />
          <path d="M45 47c39 8 91 8 130 0M44 232c42-9 92-9 134 0" fill="none" stroke="#f9b5c8" stroke-width="6" stroke-linecap="round" opacity="0.68" />
          <path d="M55 63h111l-8 142H63Z" fill="#9f2d56" opacity="0.72" />
          <path d="M55 63h111l-8 142H63Z" fill="url(#kisara-chip-light)" />
          <path d="M70 90c24-18 62-18 84 1l-7 63c-20 21-58 22-79 2Z" fill="#f6dce5" opacity="0.93" />
          <text x="111" y="128" fill="#7e1d43" font-family="Georgia, serif" font-size="35" font-weight="800" text-anchor="middle">BLOG</text>
          <text x="111" y="151" fill="#9f3b5f" font-family="Arial, sans-serif" font-size="10" font-weight="700" text-anchor="middle">CRUNCHY NOTES</text>
          <path d="M83 173c15-11 39-11 55 0-8 17-47 17-55 0Z" fill="#e9b16e" />
          <path d="M46 61c31 5 82 7 129-1" fill="none" stroke="#fff" stroke-width="3" opacity="0.26" />
          <path d="m38 19 16 8 18-7 19 7 20-8 20 8 20-7 17 8 18-8-9 27 9 190-18-7-18 9-20-8-20 9-19-9-19 8-18-9-17 8 8-190Z" fill="none" stroke="#53122f" stroke-width="3" opacity="0.68" />
        </svg>
      </button>
    </div>

    <button class="kisara-fridge-replay" type="button" data-fridge-replay aria-label="重新播放冰箱开门" title="重新播放冰箱开门">
      <Icon name="tabler:refresh" aria-hidden="true" />
    </button>
  </kisara-fridge-scene>
</section>

<script>
  type FridgeBody = {
    element: HTMLButtonElement;
    kind: string;
    x: number;
    y: number;
    vx: number;
    vy: number;
    angle: number;
    angularVelocity: number;
    width: number;
    height: number;
    mass: number;
    active: boolean;
    dragging: boolean;
    pointerId: number;
    grabOffsetX: number;
    grabOffsetY: number;
    lastPointerX: number;
    lastPointerY: number;
    lastPointerAt: number;
  };

  if (!customElements.get("kisara-fridge-scene")) {
    class KisaraFridgeScene extends HTMLElement {
      controller: AbortController | null = null;
      observer: IntersectionObserver | null = null;
      resizeObserver: ResizeObserver | null = null;
      resetScene: (() => void) | null = null;

      resetPresentation() {
        this.resetScene?.();
      }

      connectedCallback() {
        this.controller?.abort();
        const controller = new AbortController();
        this.controller = controller;
        const { signal } = controller;
        const video = this.querySelector<HTMLVideoElement>("[data-fridge-video]");
        const stage = this.querySelector<HTMLElement>("[data-fridge-physics]");
        const bodyElements = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-fridge-body]"));
        const status = this.querySelector<HTMLElement>("[data-fridge-status]");
        const replay = this.querySelector<HTMLButtonElement>("[data-fridge-replay]");
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!video || !stage || bodyElements.length !== 3) return;

        let sceneVisible = false;
        let openingStarted = false;
        let opened = false;
        let waitingForFreshEntry = false;
        let animationFrame = 0;
        let lastFrameAt = 0;
        let boundsWidth = 1;
        let boundsHeight = 1;
        let floorY = 1;
        let activeDrag: FridgeBody | null = null;
        const launchTimers: number[] = [];
        const spawnRatios = [0.61, 0.75, 0.87];
        const settledAngles = [-0.09, 0.06, -0.045];

        const bodies: FridgeBody[] = bodyElements.map((element, index) => ({
          element,
          kind: element.dataset.fridgeKind ?? String(index),
          x: 0,
          y: 0,
          vx: 0,
          vy: 0,
          angle: settledAngles[index],
          angularVelocity: 0,
          width: 1,
          height: 1,
          mass: 1,
          active: false,
          dragging: false,
          pointerId: -1,
          grabOffsetX: 0,
          grabOffsetY: 0,
          lastPointerX: 0,
          lastPointerY: 0,
          lastPointerAt: 0
        }));

        const clamp = (value: number, minimum: number, maximum: number) => Math.max(minimum, Math.min(maximum, value));
        const stopLoop = () => {
          if (animationFrame) cancelAnimationFrame(animationFrame);
          animationFrame = 0;
          lastFrameAt = 0;
        };
        const clearLaunchTimers = () => {
          while (launchTimers.length) window.clearTimeout(launchTimers.pop());
        };

        const renderBody = (body: FridgeBody) => {
          body.element.style.transform = `translate3d(${(body.x - body.width * 0.5).toFixed(2)}px, ${(body.y - body.height * 0.5).toFixed(2)}px, 0) rotate(${body.angle.toFixed(4)}rad)`;
        };

        const measureBodies = () => {
          const rect = stage.getBoundingClientRect();
          boundsWidth = Math.max(1, rect.width);
          boundsHeight = Math.max(1, rect.height);
          floorY = boundsHeight - clamp(boundsHeight * 0.042, 22, 48);
          bodies.forEach((body) => {
            body.width = Math.max(1, body.element.offsetWidth);
            body.height = Math.max(1, body.element.offsetHeight);
            body.mass = Math.max(1, body.width * body.height);
            if (body.active) {
              body.x = clamp(body.x, body.width * 0.38, boundsWidth - body.width * 0.38);
              body.y = Math.min(body.y, floorY - body.height * 0.42);
              renderBody(body);
            }
          });
        };

        const resetBodies = () => {
          clearLaunchTimers();
          stopLoop();
          measureBodies();
          bodies.forEach((body, index) => {
            body.active = false;
            body.dragging = false;
            body.pointerId = -1;
            body.x = boundsWidth * spawnRatios[index];
            body.y = -body.height * (0.8 + index * 0.52);
            body.vx = 0;
            body.vy = 0;
            body.angle = settledAngles[index];
            body.angularVelocity = 0;
            body.element.classList.remove("is-launched", "is-dragging");
            renderBody(body);
          });
        };

        const placeBodiesForReducedMotion = () => {
          measureBodies();
          bodies.forEach((body, index) => {
            body.active = true;
            body.x = boundsWidth * spawnRatios[index];
            body.y = floorY - body.height * 0.42;
            body.angle = settledAngles[index];
            body.element.classList.add("is-launched");
            renderBody(body);
          });
        };

        const resolveBodyCollision = (first: FridgeBody, second: FridgeBody) => {
          if (!first.active || !second.active) return false;
          const halfWidth = (first.width * 0.72 + second.width * 0.72) * 0.5;
          const halfHeight = (first.height * 0.82 + second.height * 0.82) * 0.5;
          const deltaX = second.x - first.x;
          const deltaY = second.y - first.y;
          const overlapX = halfWidth - Math.abs(deltaX);
          const overlapY = halfHeight - Math.abs(deltaY);
          if (overlapX <= 0 || overlapY <= 0) return false;

          const invFirst = first.dragging ? 0 : 1 / first.mass;
          const invSecond = second.dragging ? 0 : 1 / second.mass;
          const inverseMass = invFirst + invSecond;
          if (inverseMass <= 0) return false;

          let normalX = 0;
          let normalY = 0;
          let overlap = 0;
          if (overlapX < overlapY) {
            normalX = deltaX >= 0 ? 1 : -1;
            overlap = overlapX;
          } else {
            normalY = deltaY >= 0 ? 1 : -1;
            overlap = overlapY;
          }

          const correction = Math.max(0, overlap - 0.4) / inverseMass * 0.86;
          if (!first.dragging) {
            first.x -= normalX * correction * invFirst;
            first.y -= normalY * correction * invFirst;
          }
          if (!second.dragging) {
            second.x += normalX * correction * invSecond;
            second.y += normalY * correction * invSecond;
          }

          const relativeVelocity = (second.vx - first.vx) * normalX + (second.vy - first.vy) * normalY;
          if (relativeVelocity < 0) {
            const impulse = -(1 + 0.28) * relativeVelocity / inverseMass;
            if (!first.dragging) {
              first.vx -= impulse * normalX * invFirst;
              first.vy -= impulse * normalY * invFirst;
              first.angularVelocity -= normalX * relativeVelocity * 0.0007;
            }
            if (!second.dragging) {
              second.vx += impulse * normalX * invSecond;
              second.vy += impulse * normalY * invSecond;
              second.angularVelocity += normalX * relativeVelocity * 0.0007;
            }
          }
          return true;
        };

        const tick = (now: number) => {
          animationFrame = 0;
          if (!sceneVisible || !opened) return;
          if (!lastFrameAt) lastFrameAt = now;
          const deltaTime = Math.min(0.032, Math.max(0.001, (now - lastFrameAt) / 1000));
          lastFrameAt = now;
          let moving = false;

          bodies.forEach((body) => {
            if (!body.active || body.dragging) return;
            body.vy += 1680 * deltaTime;
            body.vx *= Math.pow(0.992, deltaTime * 60);
            body.vy *= Math.pow(0.998, deltaTime * 60);
            body.angularVelocity *= Math.pow(0.986, deltaTime * 60);
            body.x += body.vx * deltaTime;
            body.y += body.vy * deltaTime;
            body.angle += body.angularVelocity * deltaTime;

            const sideInset = body.width * 0.34;
            const ceiling = body.height * 0.28;
            if (body.y < ceiling) {
              body.y = ceiling;
              body.vy = Math.abs(body.vy) * 0.3;
              body.angularVelocity += body.vx * 0.0008;
            }
            if (body.x < sideInset) {
              body.x = sideInset;
              body.vx = Math.abs(body.vx) * 0.42;
              body.angularVelocity += 0.24;
            } else if (body.x > boundsWidth - sideInset) {
              body.x = boundsWidth - sideInset;
              body.vx = -Math.abs(body.vx) * 0.42;
              body.angularVelocity -= 0.24;
            }

            const bottom = floorY - body.height * 0.41;
            if (body.y > bottom) {
              body.y = bottom;
              if (Math.abs(body.vy) > 72) {
                body.vy = -Math.abs(body.vy) * 0.25;
                body.angularVelocity += body.vx * 0.0016;
              } else {
                body.vy = 0;
              }
              body.vx *= 0.88;
              body.angularVelocity *= 0.82;
            }
          });

          for (let pass = 0; pass < 3; pass += 1) {
            for (let firstIndex = 0; firstIndex < bodies.length; firstIndex += 1) {
              for (let secondIndex = firstIndex + 1; secondIndex < bodies.length; secondIndex += 1) {
                resolveBodyCollision(bodies[firstIndex], bodies[secondIndex]);
              }
            }
          }

          bodies.forEach((body) => {
            if (!body.active) return;
            renderBody(body);
            if (body.dragging || Math.abs(body.vx) > 2 || Math.abs(body.vy) > 2 || Math.abs(body.angularVelocity) > 0.008) moving = true;
          });
          if (moving) animationFrame = requestAnimationFrame(tick);
        };

        const ensureLoop = () => {
          if (!animationFrame && sceneVisible && opened && !reducedMotion) {
            lastFrameAt = 0;
            animationFrame = requestAnimationFrame(tick);
          }
        };

        const launchBodies = () => {
          resetBodies();
          bodies.forEach((body, index) => {
            const timer = window.setTimeout(() => {
              if (signal.aborted || !opened) return;
              body.active = true;
              body.x = boundsWidth * spawnRatios[index];
              body.y = -body.height * 0.55;
              body.vx = [-64, 34, -26][index];
              body.vy = 130 + index * 42;
              body.angularVelocity = [-0.72, 0.58, -0.45][index];
              body.element.classList.add("is-launched");
              renderBody(body);
              ensureLoop();
            }, index * 115);
            launchTimers.push(timer);
          });
        };

        const finishOpening = () => {
          if (opened) return;
          openingStarted = false;
          opened = true;
          video.pause();
          this.classList.remove("is-fridge-resetting", "is-fridge-playing");
          this.classList.add("is-fridge-open");
          if (status) status.textContent = "OPEN / 04°C";
          if (reducedMotion) placeBodiesForReducedMotion();
          else launchBodies();
        };

        const startOpening = () => {
          if (!sceneVisible || waitingForFreshEntry || openingStarted || opened) return;
          openingStarted = true;
          this.classList.remove("is-fridge-resetting", "is-fridge-open");
          this.classList.add("is-fridge-playing");
          if (status) status.textContent = "OPENING";

          if (reducedMotion) {
            const seekToEnd = () => {
              if (Number.isFinite(video.duration) && video.duration > 0) video.currentTime = Math.max(0, video.duration - 0.04);
              finishOpening();
            };
            if (video.readyState >= 1) seekToEnd();
            else video.addEventListener("loadedmetadata", seekToEnd, { once: true, signal });
            return;
          }

          video.pause();
          try {
            video.currentTime = 0;
          } catch {
            // Metadata can finish loading between reset and play().
          }
          void video.play().catch(() => {
            openingStarted = false;
            const retry = () => {
              if (!sceneVisible || opened || signal.aborted) return;
              startOpening();
            };
            window.addEventListener("pointerdown", retry, { once: true, signal });
            window.addEventListener("wheel", retry, { once: true, passive: true, signal });
          });
        };

        const armOpening = (waitForExit = false) => {
          clearLaunchTimers();
          stopLoop();
          opened = false;
          openingStarted = false;
          waitingForFreshEntry = waitForExit && sceneVisible;
          video.pause();
          try {
            video.currentTime = 0;
          } catch {
            // currentTime becomes writable after metadata is available.
          }
          this.classList.add("is-fridge-resetting");
          this.classList.remove("is-fridge-playing", "is-fridge-open");
          if (status) status.textContent = "SEALED";
          resetBodies();
          requestAnimationFrame(() => {
            if (!signal.aborted && sceneVisible && !waitingForFreshEntry) startOpening();
          });
        };

        const beginDrag = (body: FridgeBody, event: PointerEvent) => {
          if (!body.active || !opened) return;
          event.preventDefault();
          if (activeDrag && activeDrag !== body) {
            activeDrag.dragging = false;
            activeDrag.pointerId = -1;
            activeDrag.element.classList.remove("is-dragging");
          }
          measureBodies();
          const rect = stage.getBoundingClientRect();
          const pointerX = event.clientX - rect.left;
          const pointerY = event.clientY - rect.top;
          body.dragging = true;
          body.pointerId = event.pointerId;
          body.grabOffsetX = pointerX - body.x;
          body.grabOffsetY = pointerY - body.y;
          body.lastPointerX = pointerX;
          body.lastPointerY = pointerY;
          body.lastPointerAt = performance.now();
          body.vx = 0;
          body.vy = 0;
          body.angularVelocity *= 0.4;
          body.element.classList.add("is-dragging");
          body.element.setPointerCapture(event.pointerId);
          activeDrag = body;
          ensureLoop();
        };

        const moveDrag = (body: FridgeBody, event: PointerEvent) => {
          if (!body.dragging || body.pointerId !== event.pointerId) return;
          event.preventDefault();
          const rect = stage.getBoundingClientRect();
          const pointerX = event.clientX - rect.left;
          const pointerY = event.clientY - rect.top;
          const now = performance.now();
          const elapsed = Math.max(8, now - body.lastPointerAt) / 1000;
          body.vx = clamp((pointerX - body.lastPointerX) / elapsed, -1650, 1650);
          body.vy = clamp((pointerY - body.lastPointerY) / elapsed, -1650, 1650);
          body.x = clamp(pointerX - body.grabOffsetX, body.width * 0.34, boundsWidth - body.width * 0.34);
          body.y = clamp(pointerY - body.grabOffsetY, body.height * 0.28, floorY - body.height * 0.41);
          body.angle = clamp(body.angle + body.vx * elapsed * 0.00022, -0.5, 0.5);
          body.lastPointerX = pointerX;
          body.lastPointerY = pointerY;
          body.lastPointerAt = now;
          renderBody(body);
          ensureLoop();
        };

        const endDrag = (body: FridgeBody, event: PointerEvent) => {
          if (!body.dragging || body.pointerId !== event.pointerId) return;
          body.dragging = false;
          body.pointerId = -1;
          body.angularVelocity = clamp(body.vx * 0.0018, -1.8, 1.8);
          body.element.classList.remove("is-dragging");
          if (body.element.hasPointerCapture(event.pointerId)) body.element.releasePointerCapture(event.pointerId);
          if (activeDrag === body) activeDrag = null;
          ensureLoop();
        };

        const cancelActiveDrag = () => {
          if (!activeDrag) return;
          const body = activeDrag;
          const pointerId = body.pointerId;
          body.dragging = false;
          body.pointerId = -1;
          body.vx *= 0.32;
          body.vy = Math.min(body.vy, 0);
          body.angularVelocity *= 0.42;
          body.element.classList.remove("is-dragging");
          if (pointerId >= 0 && body.element.hasPointerCapture(pointerId)) body.element.releasePointerCapture(pointerId);
          activeDrag = null;
          ensureLoop();
        };

        bodies.forEach((body) => {
          body.element.addEventListener("pointerdown", (event) => beginDrag(body, event), { signal });
          body.element.addEventListener("lostpointercapture", () => {
            if (activeDrag === body && body.dragging) cancelActiveDrag();
          }, { signal });
          body.element.addEventListener("keydown", (event) => {
            if (!body.active || !opened || !["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", " "].includes(event.key)) return;
            event.preventDefault();
            if (event.key === "ArrowLeft") body.vx -= 240;
            if (event.key === "ArrowRight") body.vx += 240;
            if (event.key === "ArrowUp" || event.key === " ") body.vy -= 520;
            if (event.key === "ArrowDown") body.vy += 180;
            ensureLoop();
          }, { signal });
        });

        video.addEventListener("ended", finishOpening, { signal });
        replay?.addEventListener("click", () => armOpening(false), { signal });
        window.addEventListener("pointermove", (event) => {
          if (activeDrag) moveDrag(activeDrag, event);
        }, { signal });
        window.addEventListener("pointerup", (event) => {
          if (activeDrag) endDrag(activeDrag, event);
        }, { signal });
        window.addEventListener("pointercancel", cancelActiveDrag, { signal });
        window.addEventListener("blur", cancelActiveDrag, { signal });
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) cancelActiveDrag();
        }, { signal });
        window.addEventListener("resize", measureBodies, { passive: true, signal });

        if (typeof ResizeObserver === "function") {
          this.resizeObserver = new ResizeObserver(measureBodies);
          this.resizeObserver.observe(stage);
        }

        if ("IntersectionObserver" in window) {
          this.observer = new IntersectionObserver((entries) => {
            const entry = entries[entries.length - 1];
            sceneVisible = Boolean(entry?.isIntersecting && entry.intersectionRatio >= 0.12);
            if (sceneVisible) {
              if (waitingForFreshEntry) return;
              if (opened) ensureLoop();
              else startOpening();
            } else {
              waitingForFreshEntry = false;
              stopLoop();
            }
          }, { threshold: [0, 0.12, 0.42], rootMargin: "5% 0px 5%" });
          this.observer.observe(this);
        } else {
          sceneVisible = true;
        }

        this.resetScene = () => armOpening(true);
        signal.addEventListener("abort", () => {
          clearLaunchTimers();
          stopLoop();
          video.pause();
        }, { once: true });
        resetBodies();
        if (!("IntersectionObserver" in window)) startOpening();
      }

      disconnectedCallback() {
        this.controller?.abort();
        this.controller = null;
        this.observer?.disconnect();
        this.observer = null;
        this.resizeObserver?.disconnect();
        this.resizeObserver = null;
        this.resetScene = null;
      }
    }

    customElements.define("kisara-fridge-scene", KisaraFridgeScene);
  }
</script>
