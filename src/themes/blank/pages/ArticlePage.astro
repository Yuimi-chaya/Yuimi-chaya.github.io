---
import BlankLayout from "../layouts/BlankLayout.astro";
import { categoryLabel } from "@/lib/site";

const { frontmatter } = Astro.props;
const headings = (Astro.props.headings ?? []).filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const title = `${frontmatter.title} | Yuimi Lab Blank`;
const date = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
}).format(frontmatter.updatedDate ?? frontmatter.pubDate);
---

<BlankLayout title={title} description={frontmatter.description} isArticlePage>
  <div class="blank-article-shell">
    <article>
      <header class="blank-article-header">
        <p class="blank-kicker">{categoryLabel[frontmatter.category]} / {date}</p>
        <h1>{frontmatter.title}</h1>
        <p>{frontmatter.description}</p>
        <div class="blank-tag-line">
          {frontmatter.tags.map((tag: string) => <span>#{tag}</span>)}
        </div>
      </header>
      <div class="blank-prose">
        <slot />
      </div>
    </article>

    {headings.length > 0 && (
      <aside class="blank-toc" aria-label="文章目录">
        <strong>ON THIS PAGE</strong>
        {headings.map((heading) => (
          <a class={`depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a>
        ))}
      </aside>
    )}
  </div>
</BlankLayout>
