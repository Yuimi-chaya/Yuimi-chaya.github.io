---
import BaseLayout from "../layouts/BaseLayout.astro";
import { gamePicks as sharedGamePicks } from "@/core/data/games";
import { Icon } from "astro-icon/components";
import GameCover from "../components/GameCover.astro";
import MangaArt from "../components/MangaArt.astro";

const gameIcons = { "2048": "◆", hextris: "⬡", "clumsy-bird": "♪" } as const;
const gamePicks = sharedGamePicks.map((game) => ({ ...game, icon: gameIcons[game.id] }));
---

<BaseLayout title="Game | Yuimi Lab" description="小游戏、互动实验和博客彩蛋入口。">
  <section class="page-title game-hero-card">
    <MangaArt image="playroom-strip" class="playroom-opening-panel" eager />
    <div class="playroom-heading">
      <p class="section-kicker">03 / After school</p>
      <h1>课后游戏室<span class="page-title-en">Game Shelf</span></h1>
      <p>暂停一下待办清单，<br />把这段时间留给一局小游戏。</p>
    </div>
    <MangaArt image="haruto-cat" class="playroom-companions" eager />
  </section>

  <div class="playroom-ticket-line" aria-hidden="true"><span>今日营业</span><i></i><span>ONE MORE ROUND</span><i></i><span>放学后见</span></div>
  <section class="game-room" aria-label="Game collection">
    {
      gamePicks.map((game, index) => (
        <article class="game-cabinet-card" data-game={game.id}>
          <div class="game-machine-label"><span>PLAY / {String(index + 1).padStart(2, "0")}</span><Icon name="tabler:device-gamepad-2" aria-hidden="true" /></div>
          <div class="game-cabinet-screen" aria-hidden="true">
            <GameCover game={game.id} />
          </div>
          <div class="game-cabinet-copy">
            <span class="game-license">{game.license}</span>
            <h2>{game.name}</h2>
            <p class="game-vibe">{game.vibe}</p>
            <p>{game.summary}</p>
            <dl class="game-credit">
              <div>
                <dt>Author</dt>
                <dd>{game.author}</dd>
              </div>
              <div>
                <dt>Thanks</dt>
                <dd>{game.thanks}</dd>
              </div>
            </dl>
            <div class="game-actions">
              <a href={game.play} target="_blank" rel="noreferrer"><Icon name="tabler:player-play" aria-hidden="true" />开始游戏</a>
              <a href={game.repo} target="_blank" rel="noreferrer"><Icon name="tabler:brand-github" aria-hidden="true" />源码</a>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section class="game-note">
    <MangaArt image="haruto-thinking" class="game-note-character" />
    <strong>收藏说明</strong>
    <p>这些小游戏仍属于各自原作者与开源许可证。Yuimi Lab 只做个人兴趣展示、介绍与外链，不对小游戏本体进行商业使用。</p>
  </section>
</BaseLayout>
