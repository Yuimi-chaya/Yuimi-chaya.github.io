---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { kagariAsset, kagariAssets } from "../assets";
import MangaArt from "../components/MangaArt.astro";
import MemoryAlbum from "../components/MemoryAlbum.astro";
import aboutHref from "../styles/about.css?url";
import {
  animeFavorites,
  currentSignals,
  favoriteGames,
  profileIdentity,
  profileStatus,
  profileTech,
  xpFavorites
} from "@/core/data/profile";

const techPresentation = {
  unity: { icon: "simple-icons:unity", tone: "blue" },
  blender: { icon: "simple-icons:blender", tone: "orange" },
  ue5: { icon: "simple-icons:unrealengine", tone: "ink" },
  mmd: { icon: "tabler:sparkles", tone: "pink" },
  astrbot: { icon: "tabler:terminal-2", tone: "mint" }
} as const;
const techStack = profileTech.map((tech) => ({ ...tech, ...techPresentation[tech.key] }));
const animeShelf = animeFavorites.map((item) => ({ ...item, image: kagariAsset(`about/${item.key}.webp`) }));
const xpTags = xpFavorites.map((item) => ({ ...item, image: kagariAsset(`about/xp-${item.key}.webp`) }));
const gameShelf = favoriteGames.map((item) => ({ ...item, image: kagariAsset(`about/${item.key}.webp`) }));
const bookmarks = [
  { href: "#tech-line-title", icon: "tabler:code", label: "技术" },
  { href: "#anime-shelf-title", icon: "tabler:movie", label: "番剧" },
  { href: "#xp-shelf-title", icon: "tabler:heart", label: "偏好" },
  { href: "#game-shelf-title", icon: "tabler:device-gamepad", label: "游戏" },
  { href: "#memory-album-title", icon: "tabler:book-2", label: "片刻" },
  { href: "#now-doing-title", icon: "tabler:flower", label: "近况" }
];
---

<BaseLayout title="About | Yuimi Lab" description="关于喝益胃 / Yuimi-chaya 的技术线、二次元兴趣与个人资料。" stylesheets={[aboutHref]}>
  <div class="me-page">
    <header class="me-opening" aria-labelledby="about-title">
      <div class="me-opening-copy">
        <p class="me-eyebrow"><span>04 / Dear reader</span><span>Yuimi's notebook</span></p>
        <div class="me-identity">
          <div class="me-portrait">
            <img src={kagariAssets.profile} alt="喝益胃 / Yuimi-chaya 的头像" width="640" height="640" decoding="async" fetchpriority="high" />
          </div>
          <div>
            <h1 id="about-title">{profileIdentity.displayName}</h1>
            <p class="me-handle">{profileIdentity.handle}<span aria-hidden="true"> / </span>{profileIdentity.siteName}</p>
          </div>
        </div>
        <p class="me-bio">{profileIdentity.bio}</p>
        <h2 class="me-greeting">很高兴，在这里遇见你。</h2>
        <p class="me-introduction">这里放着我的技术笔记、二次元兴趣、小游戏和看板娘机关，也放着那些想认真记录下来的小事。</p>
        <div class="me-socials" aria-label="我的社交主页">
          <a href={profileIdentity.github} target="_blank" rel="noreferrer">
            <Icon name="simple-icons:github" aria-hidden="true" /><span>GitHub</span><Icon name="tabler:external-link" aria-hidden="true" />
          </a>
          <a href={profileIdentity.bilibili} target="_blank" rel="noreferrer">
            <Icon name="simple-icons:bilibili" aria-hidden="true" /><span>Bilibili</span><Icon name="tabler:external-link" aria-hidden="true" />
          </a>
        </div>
        <ul class="me-status" aria-label="现在的状态">
          {profileStatus.map((item) => <li><Icon name="tabler:pin" aria-hidden="true" /><span>{item}</span></li>)}
        </ul>
      </div>
      <figure class="me-opening-art">
        <MangaArt image="letter-page" class="me-letter-art" alt="葉佐乃绘制的日常漫画书页" eager />
        <figcaption>葉佐乃 · 儚いキミは猛攻をはじめる</figcaption>
      </figure>
      <MangaArt image="kagari-sleeve" class="about-side-character" />
    </header>

    <nav class="me-bookmarks" aria-label="个人手帖章节">
      <span class="me-index-label" aria-hidden="true">INDEX</span>
      {bookmarks.map((item) => <a href={item.href}><Icon name={item.icon} aria-hidden="true" /><span>{item.label}</span></a>)}
    </nav>

    <section class="me-section" aria-labelledby="tech-line-title">
      <header class="me-section-heading">
        <div><p class="me-eyebrow">01 / Work in progress</p><h2 id="tech-line-title">技术线</h2></div>
        <span class="me-section-note">实践、记录，再做点小东西。</span>
      </header>
      <div class="me-workbench">
        <ul class="me-tech-list">
          {techStack.map((tech) => (
            <li class={`me-tech-entry me-tech-entry--${tech.tone}`}>
              <span class="me-tech-icon" aria-hidden="true"><Icon name={tech.icon} /></span>
              <div><h3>{tech.name}</h3><p>{tech.note}</p></div>
            </li>
          ))}
        </ul>
        <aside class="me-signals" aria-labelledby="now-doing-title">
          <h3 id="now-doing-title"><Icon name="tabler:activity-heartbeat" aria-hidden="true" />最近的电波</h3>
          <dl>{currentSignals.map((signal) => <div><dt>{signal.label}</dt><dd>{signal.text}</dd></div>)}</dl>
        </aside>
      </div>
    </section>

    <section class="me-section" aria-labelledby="anime-shelf-title">
      <header class="me-section-heading">
        <div><p class="me-eyebrow">02 / On my shelf</p><h2 id="anime-shelf-title">喜欢的故事</h2></div>
        <span class="me-section-note">{String(animeShelf.length).padStart(2, "0")} 部番剧</span>
      </header>
      <div class="me-anime-shelf">
        {animeShelf.map((anime, i) => (
          <figure class="me-anime-item">
            <div class="me-anime-image"><img src={anime.image} alt={anime.title} loading="lazy" decoding="async" width="900" height="506" /></div>
            <figcaption><span class="me-item-number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span><div><h3>{anime.title}</h3><p>{anime.subtitle}</p></div></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <div class="me-interests">
      <section class="me-section" aria-labelledby="xp-shelf-title">
        <header class="me-section-heading"><div><p class="me-eyebrow">03 / Soft spot</p><h2 id="xp-shelf-title">一点点角色偏好</h2></div><Icon name="tabler:heart" aria-hidden="true" /></header>
        <div class="me-xp-shelf">
          {xpTags.map((tag) => (
            <figure class="me-xp-item">
              <div class="me-xp-image"><img src={tag.image} alt={tag.title} loading="lazy" decoding="async" width="900" height="675" /></div>
              <figcaption><h3>{tag.title}</h3><p>{tag.subtitle}</p></figcaption>
            </figure>
          ))}
        </div>
      </section>
      <section class="me-section" aria-labelledby="game-shelf-title">
        <header class="me-section-heading"><div><p class="me-eyebrow">04 / After hours</p><h2 id="game-shelf-title">课后存档</h2></div><Icon name="tabler:device-gamepad" aria-hidden="true" /></header>
        <ul class="me-game-list">
          {gameShelf.map((game) => (
            <li class="about-game-card"><img src={game.image} alt={game.title} loading="lazy" decoding="async" width="900" height="506" /><div><h3>{game.title}</h3><p>{game.subtitle}</p></div></li>
          ))}
        </ul>
      </section>
    </div>

    <MemoryAlbum />

    <footer class="me-colophon">
      <Icon name="tabler:heart" aria-hidden="true" />
      <p>喜欢的故事，总想与你聊聊。</p>
      <a href="#about-title" aria-label="回到个人资料开篇"><Icon name="tabler:arrow-up" aria-hidden="true" /></a>
    </footer>
  </div>
</BaseLayout>
