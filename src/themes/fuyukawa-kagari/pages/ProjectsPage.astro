---
import BaseLayout from "../layouts/BaseLayout.astro";
import worksStylesheet from "../styles/works.css?url";
import { Icon } from "astro-icon/components";
import { projectEntries } from "@/core/data/projects";

const chapters = [
  {
    id: "01",
    key: "blog",
    label: "站点手记",
    english: "SITE JOURNAL",
    lines: ["blog"],
    cover: "/themes/fuyukawa-kagari/assets/works-index/work-01.webp",
    note: "主题、页面结构与那些小到不值得单独写文章的交互。"
  },
  {
    id: "02",
    key: "astrbot",
    label: "机器人便签",
    english: "BOT NOTES",
    lines: ["astrbot"],
    cover: "/themes/fuyukawa-kagari/assets/works-index/work-02.webp",
    note: "消息合并、回合管理与回复节奏，让机器人更像在和你聊天。"
  },
  {
    id: "03",
    key: "codex",
    label: "工具夹层",
    english: "TOOLING",
    lines: ["codex"],
    cover: "/themes/fuyukawa-kagari/assets/works-index/work-03.webp",
    note: "开发流程、桌面补丁和可以安全撤回的安装方式。"
  },
  {
    id: "04",
    key: "notes",
    label: "经验页",
    english: "FIELD NOTES",
    lines: ["guide", "web"],
    cover: "/themes/fuyukawa-kagari/assets/works-index/work-04.webp",
    note: "踩过的坑、整理过的方法，以及从电脑走到手机的那一步。"
  }
] as const;

const chapterForLine: Record<string, string> = {};
for (const chapter of chapters) {
  for (const line of chapter.lines) chapterForLine[line] = chapter.key;
}

const projects = projectEntries.map((project, index) => ({
  ...project,
  no: String(index + 1).padStart(2, "0"),
  chapter: chapterForLine[project.line] ?? "notes"
}));

const groups = [
  {
    id: "00",
    key: "all",
    label: "全部条目",
    english: "ALL ENTRIES",
    cover: "/themes/fuyukawa-kagari/assets/works-index/work-04.webp",
    note: "从第一页开始翻，也可以直接跳到想看的章节。"
  },
  ...chapters
];
---

<BaseLayout
  title="Works | Yuimi Lab"
  description="Yuimi Lab 的项目手帐：博客、AstrBot 插件、Codex 工具与经验记录。"
  stylesheets={[worksStylesheet]}
>
  <section class="yuimi-works" data-yuimi-works aria-labelledby="works-title">
    <header class="yuimi-works-heading">
      <p class="yuimi-works-kicker">02 / THE NOTEBOOK <span>·</span> PROJECTS</p>
      <h1 id="works-title">作品手帐<span>Works &amp; little systems</span></h1>
      <p class="yuimi-works-lede">
        喜欢让机器人聊得自然，也喜欢把日常的不顺手改成工具。这里记着站点、插件、桌面小改动，以及一路写下来的经验。
      </p>
      <a class="yuimi-works-github" href="https://github.com/Yuimi-chaya" target="_blank" rel="noopener noreferrer">
        <Icon name="simple-icons:github" aria-hidden="true" />
        在 GitHub 看全部仓库
        <Icon name="tabler:external-link" aria-hidden="true" />
      </a>
    </header>

    <div class="yuimi-works-desk">
      <aside class="yuimi-works-photo" aria-hidden="true">
        <span class="yuimi-works-tape"></span>
        <div class="yuimi-works-photo-stack">
          {chapters.map((group) => (
            <img
              src={group.cover}
              alt=""
              width="720"
              height="1017"
              loading={group.key === "notes" ? "eager" : "lazy"}
              decoding="async"
              data-photo={group.key}
              class:list={{ "is-current": group.key === "notes" }}
            />
          ))}
        </div>
        <span class="yuimi-works-photo-caption" data-photo-caption>00 / 整本手帐</span>
        <span class="yuimi-works-photo-note" data-photo-note>从第一页开始翻，也可以直接跳到想看的章节。</span>
      </aside>

      <div class="yuimi-works-body">
        <nav class="yuimi-works-chapters" aria-label="手帐章节">
          {groups.map((group, index) => (
            <button
              type="button"
              data-works-chapter={group.key}
              aria-pressed={index === 0 ? "true" : "false"}
              class:list={{ "is-active": index === 0 }}
            >
              <span>{group.id}</span>
              <strong>{group.label}</strong>
              <small>{group.english}</small>
            </button>
          ))}
        </nav>

        <div class="yuimi-works-ribbon">
          <span data-works-ribbon>ALL ENTRIES</span>
          <i aria-hidden="true"></i>
          <span aria-live="polite" aria-atomic="true">
            <b data-works-total>{projects.length}</b> entries
          </span>
        </div>

        <div class="yuimi-works-list" role="list">
          {projects.map((project) => (
            <article
              class="yuimi-works-entry"
              role="listitem"
              data-project-chapter={project.chapter}
            >
              <details name="fuyukawa-project-notes">
                <summary>
                  <span class="yuimi-works-entry-no">{project.no}</span>
                  <span class="yuimi-works-entry-main">
                    <span class="yuimi-works-entry-type">{project.type}</span>
                    <strong>{project.title}</strong>
                    <span class="yuimi-works-entry-preview">{project.summary}</span>
                  </span>
                  <span class="yuimi-works-entry-status">{project.status}</span>
                  <span class="yuimi-works-entry-more" aria-hidden="true">
                    <Icon name="tabler:chevron-down" />
                  </span>
                </summary>
                <div class="yuimi-works-entry-body">
                  <p>{project.summary}</p>
                  <div class="yuimi-works-entry-grid">
                    <div>
                      <span>我的部分</span>
                      <p>{project.role}</p>
                    </div>
                    <div>
                      <span>留下的东西</span>
                      <ul>
                        {project.details.map((detail) => <li>{detail}</li>)}
                      </ul>
                    </div>
                  </div>
                  <p class="yuimi-works-entry-note">{project.note}</p>
                  <footer>
                    <span>{project.language}</span>
                    <span>{project.stars} stars</span>
                    <a href={project.href} target="_blank" rel="noopener noreferrer">
                      <Icon name="simple-icons:github" aria-hidden="true" />
                      <span>{project.repo}</span>
                      <Icon name="tabler:external-link" aria-hidden="true" />
                    </a>
                  </footer>
                </div>
              </details>
            </article>
          ))}
        </div>

        <nav class="yuimi-works-pagination" data-works-pagination aria-label="项目分页" hidden>
          <button type="button" data-works-page="prev" aria-label="上一页项目" disabled><Icon name="tabler:arrow-left" aria-hidden="true" /></button>
          <output data-works-range aria-live="polite" aria-atomic="true"></output>
          <button type="button" data-works-page="next" aria-label="下一页项目"><Icon name="tabler:arrow-right" aria-hidden="true" /></button>
        </nav>

        <p class="yuimi-works-empty" data-works-empty hidden>这一章还没有写满，先从其他页翻起吧。</p>
      </div>
    </div>

    <footer class="yuimi-works-foot">
      <p>手帐还没有写完。<span>下一批想做的，会把“记录”和“工具”再缝得紧一点。</span></p>
      <a href="https://github.com/Yuimi-chaya?tab=repositories" target="_blank" rel="noopener noreferrer">
        <Icon name="tabler:book-2" aria-hidden="true" />
        All repositories
      </a>
    </footer>
  </section>

  <script>
    document.addEventListener("astro:page-load", () => {
      const root = document.querySelector<HTMLElement>("[data-yuimi-works]");
      if (!root || root.dataset.worksBound === "true") return;
      root.dataset.worksBound = "true";

      const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-works-chapter]"));
      const entries = Array.from(root.querySelectorAll<HTMLElement>("[data-project-chapter]"));
      const photos = Array.from(root.querySelectorAll<HTMLImageElement>("[data-photo]"));
      const caption = root.querySelector<HTMLElement>("[data-photo-caption]");
      const note = root.querySelector<HTMLElement>("[data-photo-note]");
      const ribbon = root.querySelector<HTMLElement>("[data-works-ribbon]");
      const total = root.querySelector<HTMLElement>("[data-works-total]");
      const empty = root.querySelector<HTMLElement>("[data-works-empty]");
      const pager = root.querySelector<HTMLElement>("[data-works-pagination]");
      const range = root.querySelector<HTMLElement>("[data-works-range]");
      const previous = root.querySelector<HTMLButtonElement>('[data-works-page="prev"]');
      const next = root.querySelector<HTMLButtonElement>('[data-works-page="next"]');
      const compact = window.matchMedia("(max-width: 640px)");
      let page = 0;
      let pageSize = compact.matches ? 2 : 4;
      let activeKey = "all";
      const focusFirst = () => entries.find((entry) => !entry.hidden)?.querySelector<HTMLElement>("summary")?.focus();
      const chapterData = new Map(buttons.map((button) => [
        button.dataset.worksChapter ?? "all",
        {
          label: button.querySelector("strong")?.textContent?.trim() ?? "",
          id: button.querySelector("span")?.textContent?.trim() ?? "00",
          english: button.querySelector("small")?.textContent?.trim() ?? ""
        }
      ]));
      const chapterNotes: Record<string, string> = {
        all: "从第一页开始翻，也可以直接跳到想看的章节。",
        blog: "站点不是一次做完的，更多是每次想改一点时留下的痕迹。",
        astrbot: "机器人的问题，很多时候要回到“它到底听到了什么”去找。",
        codex: "工具做得好不好，看它出问题时能不能干净地退回去。",
        notes: "写下来不是总结，是让下一次的自己少绕一圈。"
      };

      const apply = (key: string, targetPage = 0) => {
        activeKey = key;
        const button = buttons.find((item) => item.dataset.worksChapter === key) ?? buttons[0];
        const data = chapterData.get(key) ?? chapterData.get("all")!;
        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-pressed", String(active));
        });

        const matching = entries.filter((entry) => key === "all" || entry.dataset.projectChapter === key);
        const shown = matching.length;
        page = Math.max(0, Math.min(targetPage, Math.ceil(shown / pageSize) - 1));
        const start = page * pageSize;
        const visible = matching.slice(start, start + pageSize);
        entries.forEach((entry) => {
          const matches = visible.includes(entry);
          entry.hidden = !matches;
          if (!matches) entry.querySelector("details")?.removeAttribute("open");
        });

        photos.forEach((photo) => {
          photo.classList.toggle("is-current", photo.dataset.photo === (key === "all" ? "notes" : key));
        });
        if (caption) caption.textContent = `${data.id} / ${data.label}`;
        if (note) note.textContent = chapterNotes[key] ?? chapterNotes.all;
        if (ribbon) ribbon.textContent = data.english;
        if (total) total.textContent = String(shown);
        if (empty) empty.hidden = shown !== 0;
        root.dataset.chapter = key;
        if (pager) pager.hidden = shown <= pageSize;
        if (previous) previous.disabled = page === 0;
        if (next) next.disabled = start + pageSize >= shown;
        if (range) range.textContent = shown ? `${start + 1}–${Math.min(start + pageSize, shown)} / ${shown}` : "0 / 0";
      };

      const onClick = (event: Event) => {
        root.dataset.worksInput = (event as MouseEvent).detail === 0 ? "keyboard" : "pointer";
        const pageButton = event.target instanceof Element ? event.target.closest<HTMLButtonElement>("[data-works-page]") : null;
        if (pageButton && root.contains(pageButton) && !pageButton.disabled) {
          apply(activeKey, page + (pageButton.dataset.worksPage === "next" ? 1 : -1));
          if ((event as MouseEvent).detail === 0) focusFirst();
          return;
        }
        const button = event.target instanceof Element
          ? event.target.closest<HTMLButtonElement>("[data-works-chapter]")
          : null;
        if (!button || !root.contains(button)) return;
        apply(button.dataset.worksChapter ?? "all");
      };

      root.addEventListener("click", onClick);
      const onResize = () => {
        const focusedEntry = document.activeElement ? entries.find((entry) => entry.contains(document.activeElement)) : null;
        const first = page * pageSize;
        pageSize = compact.matches ? 2 : 4;
        apply(activeKey, Math.floor(first / pageSize));
        if (focusedEntry?.hidden) focusFirst();
      };
      compact.addEventListener("change", onResize);
      const cleanup = () => {
        root.removeEventListener("click", onClick);
        compact.removeEventListener("change", onResize);
        document.removeEventListener("astro:before-swap", cleanup);
        delete root.dataset.worksBound;
      };
      document.addEventListener("astro:before-swap", cleanup, { once: true });
      const preset = new URLSearchParams(window.location.search).get("chapter");
      apply(preset && chapterData.has(preset) ? preset : "all");
    });
  </script>
</BaseLayout>
