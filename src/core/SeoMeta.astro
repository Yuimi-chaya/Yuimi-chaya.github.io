---
import { profileIdentity } from "@/core/data/profile";
import type { BlogPost } from "@/core/content/blog";
import { site } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  canonical: URL;
  isArticlePage?: boolean;
  article?: BlogPost["data"];
}

const { title, description, canonical, isArticlePage = false, article } = Astro.props;
const siteRoot = new URL("/", Astro.site ?? canonical);
const canonicalUrl = canonical.toString();
const canonicalPath = canonical.pathname.replace(/\/+$/, "") || "/";
const authorLabel = `${profileIdentity.displayName} / ${profileIdentity.handle}`;
const personUrl = new URL("/about/", siteRoot).toString();
const personId = new URL("/#person", siteRoot).toString();
const websiteId = new URL("/#website", siteRoot).toString();
const pageId = `${canonicalUrl}#webpage`;
const profileImage = new URL("/themes/kisara/assets/profile.webp", siteRoot).toString();
const isHome = canonicalPath === "/";
const isProfile = canonicalPath === "/about";
const openGraphType = isArticlePage ? "article" : isProfile ? "profile" : "website";
const articleId = `${canonicalUrl}#article`;
const articleImage = article?.cover ? new URL(article.cover, siteRoot).toString() : undefined;
const articleKeywords = article
  ? Array.from(new Set([...(article.seoKeywords ?? []), ...article.tags]))
  : [];
const keywords = Array.from(new Set([...site.keywords, ...articleKeywords]));

const personNode = {
  "@type": "Person",
  "@id": personId,
  name: profileIdentity.displayName,
  alternateName: [profileIdentity.handle],
  url: personUrl,
  image: profileImage,
  description: profileIdentity.bio,
  sameAs: [profileIdentity.github, profileIdentity.bilibili]
};

const pageNode = isProfile
  ? {
      "@type": "ProfilePage",
      "@id": pageId,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: "zh-CN",
      isPartOf: { "@id": websiteId },
      mainEntity: { "@id": personId }
    }
  : {
      "@type": "WebPage",
      "@id": pageId,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: "zh-CN",
      isPartOf: { "@id": websiteId },
      author: { "@id": personId },
      ...(isArticlePage && article ? { mainEntity: { "@id": articleId } } : {})
    };

const articleNode = isArticlePage && article
  ? {
      "@type": "BlogPosting",
      "@id": articleId,
      url: canonicalUrl,
      headline: article.seoTitle ?? article.title,
      description: article.seoDescription ?? article.description,
      datePublished: article.pubDate.toISOString(),
      dateModified: (article.updatedDate ?? article.pubDate).toISOString(),
      inLanguage: "zh-CN",
      articleSection: article.category,
      keywords: articleKeywords.join(", "),
      ...(articleImage ? { image: articleImage } : {}),
      mainEntityOfPage: { "@id": pageId },
      isPartOf: { "@id": websiteId },
      author: { "@id": personId },
      publisher: { "@id": personId }
    }
  : undefined;

const graph = [
  personNode,
  ...(isHome
    ? [
        {
          "@type": "WebSite",
          "@id": websiteId,
          url: siteRoot.toString(),
          name: site.name,
          alternateName: [profileIdentity.handle, profileIdentity.displayName],
          description: site.description,
          inLanguage: "zh-CN",
          author: { "@id": personId },
          publisher: { "@id": personId }
        }
      ]
    : []),
  pageNode,
  ...(articleNode ? [articleNode] : [])
];

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph
}).replace(/</g, "\\u003c");
---

<meta name="description" content={description} />
<meta name="author" content={authorLabel} />
<meta name="creator" content={authorLabel} />
<meta name="publisher" content={site.name} />
<meta name="keywords" content={keywords.join(", ")} />
<meta name="application-name" content={site.name} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:type" content={openGraphType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
{articleImage && <meta property="og:image" content={articleImage} />}
{articleImage && <meta property="og:image:alt" content={`${article?.title ?? title} 封面`} />}
<meta name="twitter:card" content={articleImage ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{articleImage && <meta name="twitter:image" content={articleImage} />}
{isArticlePage && article && <meta property="article:author" content={personUrl} />}
{isArticlePage && article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
{isArticlePage && article && <meta property="article:modified_time" content={(article.updatedDate ?? article.pubDate).toISOString()} />}
{isArticlePage && article && <meta property="article:section" content={article.category} />}
{isArticlePage && article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
<link rel="author" href={personUrl} />
<script type="application/ld+json" set:html={structuredData}></script>
