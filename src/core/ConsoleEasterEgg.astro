<script is:inline>
  (() => {
    const renderSignal = () => {
      const heart = [
        "  **   ** ",
        " **** ****",
        "***********",
        " ********* ",
        "  *******  ",
        "   *****   ",
        "    ***    ",
        "     *     "
      ];
      const key = [
        "  .----.    ",
        " /      \\   ",
        "|  ()  |=====>",
        " \\____/     ",
        "    ||      ",
        "====||===   ",
        "    ||      ",
        "    ||      "
      ];
      const art = heart
        .map((line, index) => `${line.padEnd(18, " ")}${key[index]}`)
        .join("\n");

      console.log(
        "%c" + art,
        "color:#ff6b9d;font-family:monospace;font-size:13px;line-height:1.15;font-weight:700;"
      );
      console.log(
        "%cYUIMI LAB  /  HIDDEN SIGNAL 01",
        "color:#8fa7ff;font-family:monospace;font-size:12px;font-weight:700;letter-spacing:1px;"
      );
      console.log(
        "%c♥ 记录心动，⚿ 保存好奇。你已经找到控制台里的小房间。",
        "color:#f3b6ca;font-size:12px;"
      );
      console.log(
        "%c愿每次打开网页，都能捡到一点灵感。输入 yuimiSignal() 可以再次呼出。",
        "color:#aeb8d8;font-size:11px;"
      );
    };

    window.yuimiSignal = renderSignal;
    if (window.__yuimiConsoleEasterEggShown) return;
    window.__yuimiConsoleEasterEggShown = true;
    renderSignal();
  })();
</script>
